<?xml version="1.0"?>
<FindBugsFilter>
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <!-- ContentEncodingRule normalises ASCII-only contentEncoding values
       from JSON Schema 2020-12 (RFC 4648: base64/base64url/base16/binary/
       7bit/8bit/quoted-printable). String.equalsIgnoreCase and Locale.ROOT
       comparisons are both safe for ASCII, but SpotBugs flags any case
       transformation as IMPROPER_UNICODE. -->
  <Match>
    <Class name="io.github.mridang.codegen.rules.ContentEncodingRule"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!-- Media types are ASCII tokens (RFC 9110): lower-casing one with Locale.ROOT
       to match the stream types is safe. -->
  <Match>
    <Class name="io.github.mridang.codegen.generators.AbstractBetterCodegen"/>
    <Method name="baseMediaType"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!-- HTTP header names are ASCII tokens (RFC 9110): lower-casing one with Locale.ROOT
       to compare it with the reserved names is safe. -->
  <Match>
    <Class name="io.github.mridang.codegen.rules.IgnoreReservedHeadersRule"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!-- Pagination option values, style names, the HTTP method and the Link header name are ASCII tokens:
       comparing them without case is safe. -->
  <Match>
    <Class name="io.github.mridang.codegen.generators.AbstractBetterCodegen"/>
    <Or>
      <Method name="processPaginationOptions"/>
      <Method name="populatePaginationDecorators"/>
      <Method name="planPagination"/>
      <Method name="resolvePagination"/>
      <Method name="declaresLink"/>
    </Or>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
</FindBugsFilter>
