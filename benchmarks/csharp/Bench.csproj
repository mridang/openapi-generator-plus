<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated SDK trusts this assembly name with its internal members (ObjectSerializer). -->
    <AssemblyName>PetstoreClient.Test</AssemblyName>
    <RootNamespace>Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PetstoreClient/PetstoreClient.csproj" />
  </ItemGroup>
</Project>
