root = true

# Universal baseline applied to every file in the generated tree, regardless
# of language. Pins the on-disk encoding and line endings so the output is
# byte-stable across platforms and editors.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
dotnet_analyzer_diagnostic.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
# CSharpier handles formatting; suppress Roslyn IDE0055 to avoid conflicts
dotnet_diagnostic.IDE0055.severity = none

# --- Rules disabled for GENERATED code (single documented home) ---
# The shapes below are derived mechanically from the OpenAPI document, so the
# analyzer's hand-written-code assumptions do not hold. These are style/design
# rules only; no correctness rule (nullability, type-safety, real dead code) is
# disabled here.

# CS1591: public surface is generated from the spec; not every member has an
# XML doc comment and the generator does not invent prose.
dotnet_diagnostic.CS1591.severity = none

# CA1054 / CA1055 / CA1056: URI-shaped values (server URLs, OAuth error_uri,
# spec-declared string fields) are kept as `string` to round-trip verbatim what
# the server/spec provides without System.Uri's stricter parsing.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

# CA1724: generated type names come from the spec and may collide with a
# namespace segment; renaming would break the generated public API.
dotnet_diagnostic.CA1724.severity = none

# CA1711: generated identifiers mirror spec names and may carry a reserved
# suffix (e.g. -Error for cross-language naming parity).
dotnet_diagnostic.CA1711.severity = none

# CA1002: DTOs expose List<T> because the JSON binder materializes concrete
# lists and the property type follows the spec's array shape.
dotnet_diagnostic.CA1002.severity = none

# CA1819: array-typed properties mirror spec array fields; copying defensively
# would change the generated DTO contract.
dotnet_diagnostic.CA1819.severity = none

# CA2227: collection properties are settable so the JSON deserializer can
# assign them; read-only collections would break round-tripping.
dotnet_diagnostic.CA2227.severity = none

# CA1062: argument null-validation is intentionally omitted on generated
# request methods; the binder/serializer handle null inputs.
dotnet_diagnostic.CA1062.severity = none

# CA1812: private nested JsonConverter types are instantiated reflectively via
# [JsonConverter(typeof(...))], which the analyzer cannot see.
dotnet_diagnostic.CA1812.severity = none

# CA1710 / CA1032: exception types keep an -Error suffix and a single
# constructor for cross-language parity; extra ctors would be unused.
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1032.severity = none

# CS0618: generated code references spec members marked [Obsolete] (deprecated
# schemas/operations) — emitting them is required for spec fidelity.
dotnet_diagnostic.CS0618.severity = none

# IDE0290: primary-constructor rewrites are declined where the body runs
# validation or where the constructor reads better with explicit XML docs.
dotnet_diagnostic.IDE0290.severity = none

# IDE0045 / IDE0046: ternary-vs-if is a taste preference; the generated
# branches stay as statements for readability.
dotnet_diagnostic.IDE0045.severity = none
dotnet_diagnostic.IDE0046.severity = none

# IDE0028: collection-initializer simplification is style-only.
dotnet_diagnostic.IDE0028.severity = none

# IDE0060: some generated/uniform method signatures carry parameters that are
# unused in one overload but part of the stable shared contract.
dotnet_diagnostic.IDE0060.severity = none

# CA2000: factory-style helpers return a disposable (e.g. a MemoryStream
# response body, an HttpMessageHandler whose ownership transfers to HttpClient);
# ownership passes to the caller, so the analyzer's leak warning is a false
# positive here.
dotnet_diagnostic.CA2000.severity = none
