root = true

# Universal baseline applied to every file in the generated tree, regardless
# of language. Pins the on-disk encoding and line endings so the output is
# byte-stable across platforms and editors.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# File-scoped namespaces are the generated style. This is a code-style
# preference, not an analyzer relaxation. Every generated .cs file carries a
# `// <auto-generated/>` header as its first line, so Roslyn analyzers, IDE
# code-style checks, and CSharpier all skip these files natively — no
# per-rule severity downgrades or NoWarn lists are needed.
csharp_style_namespace_declarations = file_scoped:warning
