root = true

# Universal baseline applied to every file in the generated tree, regardless
# of language. Pins the on-disk encoding and line endings so the output is
# byte-stable across platforms and editors.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# File-scoped namespaces are the generated style.
csharp_style_namespace_declarations = file_scoped:warning

# The generated sources carry no `// <auto-generated/>` header, so every
# Roslyn analyzer, IDE code-style check and CSharpier run applies to them, and
# the build turns each finding into an error. The rules below are the only ones
# generated code cannot satisfy; each is named with the reason. No generated
# file carries a suppression, and no rule set is switched off wholesale.

# Models are transport records: the serializer materialises their collections,
# so those properties are concrete lists and they are settable.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none

# A binary property in the document is a byte[] here, as in every other SDK.
dotnet_diagnostic.CA1819.severity = none

# The document gives server URLs, token endpoints and redirect URIs as strings,
# and all twelve SDKs carry them as strings end to end.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

# The project compiles with nullable reference types, which already say which
# arguments may be null; the guards this rule asks for would be dead code.
dotnet_diagnostic.CA1062.severity = none

# The error contract fixes each exception's constructors. The extra ones this
# rule asks for would let a caller build an API error with no status code.
dotnet_diagnostic.CA1032.severity = none

# Type, member and enum-member names come from the OpenAPI document and from
# the cross-SDK naming contract, so the generator cannot rename them.
dotnet_diagnostic.CA1008.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1724.severity = none

# IApiClient carries the default, no-op Dispose so a transport that owns
# nothing need not write one. C# lets a derived interface implement a base
# interface member only with explicit-interface syntax, and an interface cannot
# be sealed, so this rule's two fixes are both unavailable here.
dotnet_diagnostic.CA1033.severity = none

# The serializer resolves models reflectively, which the trimmer cannot follow.
# ILLink.Descriptors.xml preserves exactly those members, and the SDK's own
# trimmed round-trip spec publishes a consumer with TrimMode=full and proves it.
dotnet_diagnostic.IL2026.severity = none

# Every object this rule flags is handed straight to an owner that disposes it:
# HttpClient owns its handler (disposeHandler: true), MultipartFormDataContent
# owns the parts added to it, and each decompression stream is disposed by the
# using block on the following line.
dotnet_diagnostic.CA2000.severity = none

# A generated model must reference the members the OpenAPI document marks
# deprecated — a deprecated property is still part of the model — and the
# generated tests must still cover the deprecated operations the SDK exposes.
# Both are intentional, not migration debt, so the obsolete-member warning is
# named here for those two trees rather than inside the sources.
[**/Models/*.cs]
dotnet_diagnostic.CS0618.severity = none

[Test/**.cs]
dotnet_diagnostic.CS0618.severity = none
