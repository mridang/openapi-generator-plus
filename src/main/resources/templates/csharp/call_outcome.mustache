namespace {{packageName}};

/// <summary>
/// How one operation call ended, handed to <see cref="ICallObserver.Finish"/>.
/// </summary>
/// <param name="StatusCode">The HTTP status code, or 0 when no response arrived.</param>
/// <param name="Headers">The response headers with lower-cased names, or null when no response arrived.</param>
/// <param name="Error">The very error the caller receives, or null on success.</param>
public sealed record CallOutcome(
    int StatusCode,
    IReadOnlyDictionary<string, string>? Headers,
    Exception? Error
);
