namespace {{packageName}}.Auth;

/// <summary>
/// Authenticator for HTTP Bearer token authentication.
/// </summary>
public class BearerAuthenticator : BaseAuthenticator
{
    private readonly string _host;
    private readonly string _token;
    private readonly Func<CancellationToken, Task<string>>? _tokenProvider;

    /// <summary>
    /// Create a Bearer authenticator. The token is validated eagerly at
    /// construction (matching the 10-SDK majority that validates credentials
    /// up front rather than lazily at first use), so a malformed credential
    /// surfaces at the call site where it is supplied.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="token">The bearer token.</param>
    public BearerAuthenticator(string host, string token)
    {
        ValidateToken(token, nameof(token));
        _host = host;
        _token = token;
    }

    /// <summary>
    /// Create a Bearer authenticator whose token comes from a callback. The
    /// callback runs before every request, so it can hand out a token that was
    /// refreshed elsewhere; each token it returns is validated like a static one.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="tokenProvider">Returns the current bearer token.</param>
    public BearerAuthenticator(string host, Func<CancellationToken, Task<string>> tokenProvider)
    {
        ArgumentNullException.ThrowIfNull(tokenProvider);
        _host = host;
        _token = "";
        _tokenProvider = tokenProvider;
    }

    private static void ValidateToken(string token, string paramName)
    {
        /* Reject an empty/whitespace token: it would otherwise emit a bare
         * "Authorization: Bearer " header, sending the request effectively
         * unauthenticated. Mirrors the api-key authenticator's own empty
         * guard and the harmonised cross-SDK canonical. */
        if (token.All(c => c is ' ' or '\t' or '\n' or '\r' or '\f' or '\v'))
        {
            throw new ArgumentException(
                "Bearer token must not be empty",
                paramName);
        }
        /* RFC 7230 §3.2.6 — field-value is HTAB / SP / VCHAR / obs-text.
         * Reject anything outside printable ASCII + TAB so callers see a
         * clear error rather than HTTP header injection from CR/LF or
         * silently-mangled non-ASCII bytes. */
        if (token.Any(c => c != '\t' && c is < (char)0x20 or >= (char)0x7F))
        {
            throw new ArgumentException(
                "Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                paramName);
        }
    }

    /// <inheritdoc/>
    public override string GetHost()
    {
        return _host;
    }

    /// <inheritdoc/>
    public override Dictionary<string, string> GetAuthHeaders()
    {
        if (_tokenProvider is not null)
        {
            /* The callback is asynchronous; run it off the caller's
             * synchronization context so waiting for it cannot deadlock. */
            return Task.Run(() => GetAuthHeadersAsync(CancellationToken.None)).GetAwaiter().GetResult();
        }
        return HeadersFor(_token);
    }

    /// <inheritdoc/>
    public override async Task<Dictionary<string, string>> GetAuthHeadersAsync(CancellationToken cancellationToken)
    {
        if (_tokenProvider is null)
        {
            return HeadersFor(_token);
        }
        string token = await _tokenProvider(cancellationToken).ConfigureAwait(false);
        ValidateToken(token, nameof(token));
        return HeadersFor(token);
    }

    private static Dictionary<string, string> HeadersFor(string token)
    {
        /* Dedupe "Bearer " prefix (case-insensitive ASCII): tokens read
         * from env files are commonly stored already-prefixed; emitting
         * "Bearer Bearer xyz" would otherwise silently break auth. */
        string value = token;
        if (value.Length >= 7 && value[..7].Equals("Bearer ", StringComparison.OrdinalIgnoreCase))
        {
            value = value[7..];
        }
        return new() { ["Authorization"] = "Bearer " + value };
    }

    /// <summary>
    /// Returns a string representation with the bearer token redacted so the
    /// credential never leaks into logs, stack traces, or debugger output.
    /// </summary>
    public override string ToString()
    {
        return $"{GetType().Name}(Host={_host}, Token=***)";
    }
}
