namespace {{packageName}}.Auth;

/// <summary>
/// Authenticator for API key authentication. Supports sending the key
/// as a header, query parameter, or cookie.
/// </summary>
public class ApiKeyAuthenticator : BaseAuthenticator
{
    private readonly string _host;
    private readonly string _keyParamName;
    private readonly string _apiKey;
    private readonly ApiKeyLocation _location;

    /// <summary>
    /// Create an API-key authenticator. The key is validated eagerly at
    /// construction (matching the 10-SDK majority that validates credentials
    /// up front rather than lazily at first use), so a malformed key surfaces
    /// at the call site where it is supplied.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="keyParamName">The header/query/cookie name carrying the key.</param>
    /// <param name="apiKey">The API key value.</param>
    /// <param name="location">Where the key is sent (header, query, or cookie).</param>
    public ApiKeyAuthenticator(
        string host,
        string keyParamName,
        string apiKey,
        ApiKeyLocation location)
    {
        /* Validation applies to ALL locations: empty/whitespace API keys
         * and CR/LF/NUL are always programmer errors. RFC 7230 §3.2.6
         * printable-ASCII rule still applies to HEADER values. */
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            throw new ArgumentException(
                $"API key value for '{keyParamName}' must not be empty",
                nameof(apiKey));
        }
        if (apiKey.Any(c => c == '\r' || c == '\n' || c == '\0'))
        {
            throw new ArgumentException(
                $"API key value for '{keyParamName}' contains forbidden control characters (CR/LF/NUL)",
                nameof(apiKey));
        }
        if (location == ApiKeyLocation.Header &&
            apiKey.Any(c => c != '\t' && c is < (char)0x20 or >= (char)0x7F))
        {
            throw new ArgumentException(
                $"API key for header '{keyParamName}' must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                nameof(apiKey));
        }
        _host = host;
        _keyParamName = keyParamName;
        _apiKey = apiKey;
        _location = location;
    }

    /// <inheritdoc/>
    public override string GetHost()
    {
        return _host;
    }

    /// <inheritdoc/>
    public override Dictionary<string, string> GetAuthHeaders()
    {
        if (_location != ApiKeyLocation.Header)
        {
            return [];
        }
        return new() { [_keyParamName] = _apiKey };
    }

    /// <inheritdoc/>
    public override Dictionary<string, string> GetQueryParams()
    {
        if (_location != ApiKeyLocation.Query)
        {
            return [];
        }
        return new() { [_keyParamName] = _apiKey };
    }

    /// <inheritdoc/>
    public override Dictionary<string, string> GetCookieParams()
    {
        if (_location != ApiKeyLocation.Cookie)
        {
            return [];
        }
        return new() { [_keyParamName] = _apiKey };
    }

    /// <summary>
    /// Returns a string representation with the API key redacted so the
    /// credential never leaks into logs, stack traces, or debugger output.
    /// </summary>
    public override string ToString()
    {
        return $"{GetType().Name}(Host={_host}, KeyParamName={_keyParamName}, ApiKey=***, Location={_location})";
    }
}
