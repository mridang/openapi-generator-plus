using {{packageName}}.Errors;
using System.Text.Json;
using System.Text.RegularExpressions;

namespace {{packageName}}.Auth.OAuth;

/// <summary>
/// Authenticator for OpenID Connect.
///
/// Fetches the OIDC discovery document to discover the authorization and
/// token endpoints, then delegates to an <see cref="OAuth2AuthorizationCodeAuthenticator"/>.
///
/// Implements <see cref="IHttpAwareAuthenticator"/> so that both the discovery
/// request and subsequent token exchange requests use the shared
/// <see cref="IApiClient"/> with the same transport configuration (proxy, TLS,
/// timeouts) as regular API calls.
/// </summary>
public partial class OpenIdConnectAuthenticator
    : BaseAuthenticator,
        IHttpAwareAuthenticator,
        IInvalidatableAuthenticator
{
    private readonly string _host;
    private readonly Uri _openIdConnectUrl;
    private readonly string _clientId;
    private readonly string _clientSecret;
    private readonly Uri _redirectUri;
    private readonly string[] _scopes;
    private IApiClient? _apiClient;
    private OAuth2AuthorizationCodeAuthenticator? _delegate;
    private DateTimeOffset _discoveryExpiry = DateTimeOffset.MinValue;
    private string? _discoveredEndpoints;
    private readonly object _discoveryLock = new();
    private Task<OAuth2AuthorizationCodeAuthenticator>? _discovery;

    [GeneratedRegex("max-age=(\\d+)", RegexOptions.IgnoreCase)]
    private static partial Regex MaxAgePattern();

    private const long DefaultMaxAgeSeconds = 86400L;

    /// <summary>
    /// Ceiling applied to a server-supplied <c>max-age</c>, in seconds (one
    /// year), so an absurd lifetime cannot overflow the expiry arithmetic.
    /// </summary>
    private const long MaxDiscoveryMaxAgeSeconds = 31_536_000L;

    /// <summary>
    /// Create a new OpenID Connect authenticator.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="openIdConnectUrl">OIDC discovery document URL.</param>
    /// <param name="clientId">OAuth2 client ID.</param>
    /// <param name="clientSecret">OAuth2 client secret.</param>
    /// <param name="redirectUri">Redirect URI registered with the provider.</param>
    /// <param name="scopes">Requested scopes.</param>
    public OpenIdConnectAuthenticator(
        string host,
        Uri openIdConnectUrl,
        string clientId,
        string clientSecret,
        Uri redirectUri,
        string[] scopes
    )
    {
        _host = host;
        _openIdConnectUrl = openIdConnectUrl;
        _clientId = clientId;
        _clientSecret = clientSecret;
        _redirectUri = redirectUri;
        /* OpenID Connect Core 3.1.2.1: the scope parameter must contain "openid". */
        _scopes = ["openid", .. scopes.Where(s => s != "openid")];
    }

    /// <inheritdoc/>
    public void SetApiClient(IApiClient apiClient)
    {
        _apiClient = apiClient;
    }

    private async Task<OAuth2AuthorizationCodeAuthenticator> GetDelegateAsync()
    {
        if (_delegate is not null && DateTimeOffset.UtcNow < _discoveryExpiry)
        {
            return _delegate;
        }

        if (_apiClient is null)
        {
            throw new InvalidOperationException(
                "ApiClient has not been injected. "
                    + "Ensure the {{clientClassName}} constructor calls SetApiClient() "
                    + "on IHttpAwareAuthenticator before making API requests."
            );
        }

        /* Concurrent cold callers share one discovery request: the first caller
           starts it and every other caller awaits the same task. The shared task
           is cleared once it completes, so a later expiry starts a fresh one. */
        Task<OAuth2AuthorizationCodeAuthenticator> pending;
        lock (_discoveryLock)
        {
            /* A caller that arrives after the first discovery finished and cleared
               the shared task must see its result, not start a second request. */
            if (_delegate is not null && DateTimeOffset.UtcNow < _discoveryExpiry)
            {
                return _delegate;
            }

            _discovery ??= DiscoverAsync();
            pending = _discovery;
        }
        try
        {
            return await pending.ConfigureAwait(false);
        }
        finally
        {
            lock (_discoveryLock)
            {
                if (ReferenceEquals(_discovery, pending))
                {
                    _discovery = null;
                }
            }
        }
    }

    private async Task<OAuth2AuthorizationCodeAuthenticator> DiscoverAsync()
    {
        /* Discovery is an HTTP call like any other: a transport failure
           propagates unchanged as NetworkException / NetworkTimeoutException.
           The request goes to the identity provider, not to the API, so it is
           sent as a no-redirect request: the transport default headers (an
           API Authorization or key header) stay off it, like the token POST. */
        IApiClient apiClient = _apiClient ?? throw new InvalidOperationException(
            "ApiClient has not been injected. Call SetApiClient() before discovery.");
        Dictionary<string, string> headers = new() { ["Accept"] = "application/json" };
        ApiHttpResponse response = await apiClient
            .SendRequestAsync("GET", _openIdConnectUrl, headers, null, true)
            .ConfigureAwait(false);

        if (response.StatusCode < 200 || response.StatusCode >= 300)
        {
            throw ApiException.FromResponse(
                response.StatusCode,
                response.Headers,
                response.Body,
                "GET",
                _openIdConnectUrl.AbsolutePath
            );
        }

        using JsonDocument doc = ParseDiscoveryDocument(response.Body);
        JsonElement root = doc.RootElement;
        Uri authorizationEndpoint = RequireEndpoint(root, "authorization_endpoint");
        Uri tokenEndpoint = RequireEndpoint(root, "token_endpoint");
        RequireSecureEndpoint(authorizationEndpoint, "authorization_endpoint");
        RequireSecureEndpoint(tokenEndpoint, "token_endpoint");
        RequireMatchingIssuer(root);

        /* The session (tokens and the exchanged flag) lives in the token manager,
           which outlives discovery: a document that names the same endpoints keeps
           the delegate, and one that names new endpoints gets a delegate built
           around the previous session, so refreshing the discovery cache never
           discards the code exchange. */
        string endpoints = authorizationEndpoint + "\n" + tokenEndpoint;
        if (_delegate is null)
        {
            _delegate = new OAuth2AuthorizationCodeAuthenticator(
                _host,
                _clientId,
                _clientSecret,
                authorizationEndpoint,
                tokenEndpoint,
                _redirectUri,
                _scopes
            );
        }
        else if (endpoints != _discoveredEndpoints)
        {
            _delegate = new OAuth2AuthorizationCodeAuthenticator(
                _host,
                _clientId,
                _clientSecret,
                authorizationEndpoint,
                tokenEndpoint,
                _redirectUri,
                _scopes,
                null,
                _delegate.TokenManager,
                _delegate.TokenExchanged,
                _delegate.PkceVerifier
            );
        }
        _discoveredEndpoints = endpoints;
        _delegate.SetApiClient(_apiClient);
        _discoveryExpiry = DateTimeOffset.UtcNow.AddSeconds(ParseMaxAge(response.Headers));
        return _delegate;
    }

    /// <summary>
    /// Parse the discovery response body. A body that is not a JSON object is
    /// unusable, which is a <see cref="SerializationException"/>.
    /// </summary>
    private static JsonDocument ParseDiscoveryDocument(string body)
    {
        JsonDocument doc;
        try
        {
            doc = JsonDocument.Parse(body);
        }
        catch (JsonException ex)
        {
            throw new SerializationException($"OIDC discovery document is not valid JSON: {ex.Message}", ex);
        }
        if (doc.RootElement.ValueKind != JsonValueKind.Object)
        {
            doc.Dispose();
            throw new SerializationException("OIDC discovery document is not a JSON object");
        }
        return doc;
    }

    /// <summary>
    /// Extract a required endpoint from the discovery document. An absent,
    /// non-string, empty or non-absolute-URL field makes the document unusable,
    /// which is a <see cref="SerializationException"/>.
    /// </summary>
    private static Uri RequireEndpoint(JsonElement root, string field)
    {
        if (!root.TryGetProperty(field, out JsonElement element)
            || element.ValueKind != JsonValueKind.String
            || string.IsNullOrEmpty(element.GetString()))
        {
            throw new SerializationException($"OIDC discovery document is missing '{field}'");
        }
        if (!Uri.TryCreate(element.GetString(), UriKind.Absolute, out Uri? endpoint))
        {
            throw new SerializationException($"Discovery document {field} is not an absolute URL");
        }
        return endpoint;
    }

    /// <summary>
    /// A discovered endpoint receives the client secret, the authorization code
    /// and the refresh token, so it must use https; plain http is accepted only
    /// for a loopback host (RFC 8252 section 8.3).
    /// </summary>
    private static void RequireSecureEndpoint(Uri endpoint, string field)
    {
        bool secure =
            endpoint.Scheme == Uri.UriSchemeHttps
            || (endpoint.Scheme == Uri.UriSchemeHttp && endpoint.IsLoopback);
        if (!secure)
        {
            throw new SerializationException(
                $"OIDC discovery document {field} must use https unless the host is loopback"
            );
        }
    }

    /// <summary>
    /// OpenID Connect Discovery 1.0 section 4.3: when the document names an
    /// issuer it must equal the discovery URL without its well-known suffix,
    /// ignoring one trailing slash; a mismatch is the mix-up attack.
    /// </summary>
    private void RequireMatchingIssuer(JsonElement root)
    {
        const string suffix = "/.well-known/openid-configuration";
        if (
            !root.TryGetProperty("issuer", out JsonElement issuerElement)
            || issuerElement.ValueKind != JsonValueKind.String
        )
        {
            return;
        }
        string discovery = _openIdConnectUrl.OriginalString;
        int at = discovery.IndexOf(suffix, StringComparison.Ordinal);
        if (at < 0)
        {
            return;
        }
        string issuer = issuerElement.GetString() ?? "";
        if (
            !string.Equals(
                issuer.TrimEnd('/'),
                discovery[..at].TrimEnd('/'),
                StringComparison.Ordinal
            )
        )
        {
            throw new SerializationException(
                $"OIDC discovery document issuer '{issuer}' does not match the discovery URL"
            );
        }
    }

    /// <summary>
    /// Parse the <c>Cache-Control</c> header for a numeric <c>max-age</c>
    /// directive (per RFC 7234) from a discovery response.
    /// </summary>
    /// <param name="headers">The response headers.</param>
    /// <returns>
    /// The parsed max-age in seconds, or 86400 (RFC 8414 default) if the header
    /// is absent or does not contain a <c>max-age</c> directive. A larger value
    /// is clamped to one year.
    /// </returns>
    private static long ParseMaxAge(IReadOnlyDictionary<string, string> headers)
    {
        foreach (KeyValuePair<string, string> entry in headers)
        {
            if (string.Equals(entry.Key, "Cache-Control", StringComparison.OrdinalIgnoreCase))
            {
                Match match = MaxAgePattern().Match(entry.Value);
                if (!match.Success)
                {
                    return DefaultMaxAgeSeconds;
                }
                /* The pattern matched only digits, so a failed parse is an
                 * overflow: that value is beyond the ceiling as well. */
                return long.TryParse(
                    match.Groups[1].Value,
                    System.Globalization.NumberStyles.None,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out long seconds
                )
                    ? Math.Min(seconds, MaxDiscoveryMaxAgeSeconds)
                    : MaxDiscoveryMaxAgeSeconds;
            }
        }
        return DefaultMaxAgeSeconds;
    }

    /// <summary>
    /// Builds the authorization URL using the discovered authorization endpoint.
    /// </summary>
    /// <param name="state">Optional CSRF state parameter.</param>
    /// <returns>The authorization URL.</returns>
    public async Task<Uri> BuildAuthorizationUrlAsync(string? state = null)
    {
        OAuth2AuthorizationCodeAuthenticator d = await GetDelegateAsync().ConfigureAwait(false);
        return d.BuildAuthorizationUrl(state);
    }

    /// <summary>
    /// Exchanges an authorization code for an access token.
    /// </summary>
    /// <param name="code">The authorization code from the callback.</param>
    public async Task ExchangeCodeAsync(string code)
    {
        OAuth2AuthorizationCodeAuthenticator d = await GetDelegateAsync().ConfigureAwait(false);
        await d.ExchangeCodeAsync(code).ConfigureAwait(false);
    }

    /// <summary>
    /// Drops the cached access token so that the next request fetches a fresh
    /// one (a refresh grant first when a refresh token is held, which is kept).
    /// A no-op before the first discovery, when no token can be held.
    /// </summary>
    public void InvalidateAccessToken()
    {
        _delegate?.InvalidateAccessToken();
    }

    /// <inheritdoc/>
    public override string GetHost()
    {
        return _host;
    }

    /// <inheritdoc/>
    /// <remarks>
    /// OpenID Connect requires asynchronous discovery and token exchange.
    /// The synchronous path is not safe (it deadlocks under non-default
    /// <see cref="System.Threading.SynchronizationContext"/>); callers
    /// must use <see cref="GetAuthHeadersAsync(CancellationToken)"/> instead.
    /// </remarks>
    public override Dictionary<string, string> GetAuthHeaders()
    {
        throw new InvalidOperationException(
            "OAuth2 authenticators require async token exchange; "
                + "use GetAuthHeadersAsync() instead."
        );
    }

    /// <inheritdoc/>
    public override async Task<Dictionary<string, string>> GetAuthHeadersAsync(CancellationToken cancellationToken)
    {
        OAuth2AuthorizationCodeAuthenticator d = await GetDelegateAsync().ConfigureAwait(false);
        return await d.GetAuthHeadersAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>
    /// Returns a string representation with the client secret redacted so the
    /// credential never leaks into logs, stack traces, or debugger output.
    /// </summary>
    public override string ToString()
    {
        return $"{GetType().Name}(Host={_host}, OpenIdConnectUrl={_openIdConnectUrl}, ClientId={_clientId}, ClientSecret=***)";
    }
}
