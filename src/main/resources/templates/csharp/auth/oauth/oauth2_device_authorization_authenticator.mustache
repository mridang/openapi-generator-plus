using {{packageName}}.Errors;
using System.Text.Json;

namespace {{packageName}}.Auth.OAuth;

/// <summary>
/// The answer of the device authorization endpoint (RFC 8628 section 3.2).
/// </summary>
/// <param name="DeviceCode">The device verification code.</param>
/// <param name="UserCode">The code the user enters at the verification URI.</param>
/// <param name="VerificationUri">The URI the user visits to approve the request.</param>
/// <param name="VerificationUriComplete">The verification URI with the user code included, if sent.</param>
/// <param name="ExpiresIn">The lifetime of the device code, in seconds.</param>
/// <param name="Interval">The seconds to wait between polls (5 when the server sends none).</param>
public sealed record DeviceAuthorization(
    string DeviceCode,
    string UserCode,
    string VerificationUri,
    string? VerificationUriComplete,
    long ExpiresIn,
    long Interval
);

/// <summary>
/// Authenticator for the OAuth2 Device Authorization flow (RFC 8628).
///
/// Implements <see cref="IHttpAwareAuthenticator"/> so that the device authorization
/// and token requests use the shared <see cref="IApiClient"/> with the same transport
/// configuration (proxy, TLS, timeouts) as regular API calls.
///
/// Usage:
/// <list type="number">
///   <item><description>Call <see cref="RequestDeviceAuthorizationAsync"/> to get the user code and the verification URI.</description></item>
///   <item><description>Show both to the user, who approves the request on another device.</description></item>
///   <item><description>Call <see cref="PollForTokenAsync"/>; it completes once the user has approved the request.</description></item>
///   <item><description>Use the authenticator normally -- tokens are managed automatically.</description></item>
/// </list>
/// </summary>
public class OAuth2DeviceAuthorizationAuthenticator
    : BaseAuthenticator,
        IHttpAwareAuthenticator,
        IInvalidatableAuthenticator
{
    /* The grant type of the device access token request (RFC 8628 section 3.4). */
    private const string DeviceCodeGrant = "urn:ietf:params:oauth:grant-type:device_code";

    /* The polling interval when the server names none (RFC 8628 section 3.2). */
    private const long DefaultIntervalSeconds = 5L;

    /* The seconds a slow_down answer adds to the interval (RFC 8628 section 3.5). */
    private const long SlowDownSeconds = 5L;

    private readonly string _host;
    private readonly string _clientId;
    private readonly Uri _deviceAuthorizationUrl;
    private readonly Uri _tokenUrl;
    private readonly Uri _refreshUrl;
    private readonly string[] _scopes;
    private readonly OAuth2TokenManager _tokenManager = new();
    /* Written by PollForTokenAsync and read by request threads, so volatile gives
     * the reader a happens-before. */
    private volatile bool _tokenExchanged;

    /// <summary>
    /// Create a new device authorization authenticator.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="clientId">OAuth2 client ID.</param>
    /// <param name="deviceAuthorizationUrl">Device authorization endpoint URL.</param>
    /// <param name="tokenUrl">Token endpoint URL.</param>
    /// <param name="scopes">Requested scopes.</param>
    /// <param name="refreshUrl">Refresh token endpoint URL. Falls back to tokenUrl if null.</param>
    public OAuth2DeviceAuthorizationAuthenticator(
        string host,
        string clientId,
        Uri deviceAuthorizationUrl,
        Uri tokenUrl,
        string[] scopes,
        Uri? refreshUrl = null
    )
    {
        _host = host;
        _clientId = clientId;
        _deviceAuthorizationUrl = deviceAuthorizationUrl;
        _tokenUrl = tokenUrl;
        _refreshUrl = refreshUrl ?? tokenUrl;
        _scopes = [.. scopes];
    }

    /* Waits between polls; tests replace it so they do not wait. */
    internal Func<TimeSpan, CancellationToken, Task> Delay { get; set; } = Task.Delay;

    /* The monotonic clock, in milliseconds, the expiry of a device code is measured with. */
    internal Func<long> MonotonicMilliseconds { get; set; } = () => Environment.TickCount64;

    /// <inheritdoc/>
    public void SetApiClient(IApiClient apiClient)
    {
        _tokenManager.SetApiClient(apiClient);
    }

    /// <summary>
    /// Asks the device authorization endpoint for a device code and a user code. Show
    /// the user code and the verification URI to the user, then call
    /// <see cref="PollForTokenAsync"/>.
    /// </summary>
    /// <param name="cancellationToken">Cancels the request.</param>
    /// <returns>The device authorization.</returns>
    /// <exception cref="OAuth2ServerException">The endpoint answered non-2xx.</exception>
    /// <exception cref="OAuth2TokenException">The answer is not a usable device authorization.</exception>
    public async Task<DeviceAuthorization> RequestDeviceAuthorizationAsync(CancellationToken cancellationToken = default)
    {
        Dictionary<string, string> parameters = new() { ["client_id"] = _clientId };
        if (_scopes.Length > 0)
        {
            parameters["scope"] = string.Join(" ", _scopes);
        }

        string body = await _tokenManager
            .PostDeviceAuthorizationAsync(_deviceAuthorizationUrl, parameters, cancellationToken)
            .ConfigureAwait(false);
        using JsonDocument doc = ParseDeviceResponse(body);
        JsonElement root = doc.RootElement;
        if (root.ValueKind != JsonValueKind.Object)
        {
            throw new OAuth2TokenException("Device authorization response is not a JSON object");
        }

        string deviceCode = RequiredField(root, "device_code");
        string userCode = RequiredField(root, "user_code");
        string verificationUri = RequiredField(root, "verification_uri");
        string? verificationUriComplete =
            root.TryGetProperty("verification_uri_complete", out JsonElement complete)
            && complete.ValueKind == JsonValueKind.String
            && !string.IsNullOrEmpty(complete.GetString())
                ? complete.GetString()
                : null;
        long expiresIn = root.TryGetProperty("expires_in", out JsonElement expiresElement)
            ? OAuth2TokenManager.ParseExpiresIn(expiresElement)
            : 0L;
        long interval =
            root.TryGetProperty("interval", out JsonElement intervalElement)
            && intervalElement.ValueKind != JsonValueKind.Null
                ? OAuth2TokenManager.ParseExpiresIn(intervalElement)
                : DefaultIntervalSeconds;
        return new DeviceAuthorization(deviceCode, userCode, verificationUri, verificationUriComplete, expiresIn, interval);
    }

    /// <summary>
    /// Polls the token endpoint until the user approves the device authorization.
    /// <c>authorization_pending</c> keeps polling and <c>slow_down</c> adds five seconds
    /// to the interval; a success replaces the session.
    /// </summary>
    /// <param name="authorization">The device authorization to poll for.</param>
    /// <param name="cancellationToken">Cancels the polling.</param>
    /// <exception cref="OAuth2ServerException">The token endpoint answered with any other error.</exception>
    /// <exception cref="OAuth2TokenException">The device code expired before the user approved it.</exception>
    public async Task PollForTokenAsync(DeviceAuthorization authorization, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(authorization);
        long interval = authorization.Interval;
        long started = MonotonicMilliseconds();
        while (true)
        {
            long elapsed = (MonotonicMilliseconds() - started) / 1000L;
            if (elapsed + interval > authorization.ExpiresIn)
            {
                throw new OAuth2TokenException("Device authorization expired before the user approved it");
            }

            await Delay(TimeSpan.FromSeconds(interval), cancellationToken).ConfigureAwait(false);
            Dictionary<string, string> parameters = new()
            {
                ["grant_type"] = DeviceCodeGrant,
                ["client_id"] = _clientId,
                ["device_code"] = authorization.DeviceCode,
            };
            try
            {
                /* RFC 8628 section 3.5: a success replaces the session like a code exchange. */
                _ = await _tokenManager
                    .ExchangeAsync(_tokenUrl, parameters, cancellationToken: cancellationToken)
                    .ConfigureAwait(false);
                _tokenExchanged = true;
                return;
            }
            catch (OAuth2ServerException e) when (e.Code is "authorization_pending" or "slow_down")
            {
                if (e.Code == "slow_down")
                {
                    interval += SlowDownSeconds;
                }
            }
        }
    }

    /// <summary>
    /// Drops the cached access token so that the next request fetches a fresh
    /// one (a refresh grant first when a refresh token is held, which is kept).
    /// The SDK calls this itself when the API answers 401; callers may use it
    /// to force a refresh.
    /// </summary>
    public void InvalidateAccessToken()
    {
        _tokenManager.InvalidateAccessToken();
    }

    /// <inheritdoc/>
    public override string GetHost()
    {
        return _host;
    }

    /// <inheritdoc/>
    /// <remarks>
    /// OAuth2 authenticators require asynchronous token exchange. The
    /// synchronous path is not safe (it deadlocks under non-default
    /// <see cref="System.Threading.SynchronizationContext"/>); callers
    /// must use <see cref="GetAuthHeadersAsync(CancellationToken)"/> instead.
    /// </remarks>
    public override Dictionary<string, string> GetAuthHeaders()
    {
        throw new InvalidOperationException(
            "OAuth2 authenticators require async token exchange; "
                + "use GetAuthHeadersAsync() instead."
        );
    }

    /// <inheritdoc/>
    public override async Task<Dictionary<string, string>> GetAuthHeadersAsync(CancellationToken cancellationToken)
    {
        if (!_tokenExchanged)
        {
            throw new InvalidOperationException(
                "Must call PollForTokenAsync() before making API requests"
            );
        }

        Dictionary<string, string> parameters = new()
        {
            ["grant_type"] = "refresh_token",
            ["refresh_token"] = _tokenManager.RefreshToken ?? "",
            ["client_id"] = _clientId,
        };
        string token = await _tokenManager
            .GetAccessTokenAsync(_refreshUrl, parameters, null, null, cancellationToken)
            .ConfigureAwait(false);
        return new() { ["Authorization"] = "Bearer " + token };
    }

    private static JsonDocument ParseDeviceResponse(string body)
    {
        try
        {
            return JsonDocument.Parse(body);
        }
        catch (JsonException)
        {
            /* No parser detail, which can quote the body. */
            throw new OAuth2TokenException("Device authorization response is not valid JSON");
        }
    }

    private static string RequiredField(JsonElement root, string field)
    {
        string? value =
            root.TryGetProperty(field, out JsonElement element) && element.ValueKind == JsonValueKind.String
                ? element.GetString()
                : null;
        if (string.IsNullOrEmpty(value))
        {
            throw new OAuth2TokenException("Device authorization response missing or empty " + field + " field");
        }

        return value;
    }

    /// <summary>
    /// Returns a string representation of this authenticator (it holds no client
    /// secret; the tokens are never shown).
    /// </summary>
    public override string ToString()
    {
        return $"{GetType().Name}(Host={_host}, ClientId={_clientId}, DeviceAuthorizationUrl={_deviceAuthorizationUrl}, TokenUrl={_tokenUrl}, Scopes=[{string.Join(", ", _scopes)}])";
    }
}
