using {{packageName}}.Errors;
using System.Text.Json;

namespace {{packageName}}.Auth.OAuth;

/// <summary>
/// Manages OAuth2 token lifecycle including fetching, caching, and refreshing tokens.
///
/// Uses the shared <see cref="IApiClient"/> instance so that token exchange requests
/// honour the same transport configuration (proxy, TLS, timeouts) as regular
/// API calls.
/// </summary>
public sealed class OAuth2TokenManager
{
    /// <summary>
    /// Safety margin (in seconds) applied to token expiry checks so that we
    /// refresh slightly before the token actually expires, avoiding a race
    /// against the server clock.
    /// </summary>
    private const int ExpirySafetyMarginSeconds = 60;

    private readonly object _stateLock = new();
    private Task<string>? _inflightRefresh;
    private IApiClient? _apiClient;
    private string? _accessToken;
    private DateTimeOffset? _tokenExpiry;

    /// <summary>
    /// Inject the shared API client for making token requests.
    /// </summary>
    /// <param name="apiClient">The shared API client instance.</param>
    public void SetApiClient(IApiClient apiClient)
    {
        _apiClient = apiClient;
    }

    /// <summary>
    /// Returns a valid access token, fetching or refreshing as necessary.
    /// This method is synchronized to prevent concurrent token requests.
    /// </summary>
    /// <param name="tokenUrl">The OAuth2 token endpoint URL.</param>
    /// <param name="parameters">The token request parameters (grant_type, client_id, etc.).</param>
    /// <param name="extraHeaders">Optional additional headers to send with the token request (e.g. Authorization for HTTP Basic client auth).</param>
    /// <returns>A valid access token.</returns>
    /// <exception cref="InvalidOperationException">If no API client has been injected or token fetch fails.</exception>
    public Task<string> GetAccessTokenAsync(
        Uri tokenUrl,
        Dictionary<string, string> parameters,
        Dictionary<string, string>? extraHeaders = null
    )
    {
        ArgumentNullException.ThrowIfNull(parameters);
        if (
            _accessToken is not null
            && (
                _tokenExpiry is null
                || DateTimeOffset.UtcNow
                    < _tokenExpiry.Value.AddSeconds(-ExpirySafetyMarginSeconds)
            )
        )
        {
            return Task.FromResult(_accessToken);
        }

        Task<string> task;
        lock (_stateLock)
        {
            if (
                _accessToken is not null
                && (
                    _tokenExpiry is null
                    || DateTimeOffset.UtcNow
                        < _tokenExpiry.Value.AddSeconds(-ExpirySafetyMarginSeconds)
                )
            )
            {
                return Task.FromResult(_accessToken);
            }

            task = _inflightRefresh ??= RefreshOrFetchAsync(tokenUrl, parameters, extraHeaders);
        }

        return AwaitAndClearAsync(task);
    }

    private async Task<string> AwaitAndClearAsync(Task<string> task)
    {
        try
        {
            return await task.ConfigureAwait(false);
        }
        finally
        {
            lock (_stateLock)
            {
                if (ReferenceEquals(_inflightRefresh, task))
                {
                    _inflightRefresh = null;
                }
            }
        }
    }

    private async Task<string> RefreshOrFetchAsync(
        Uri tokenUrl,
        Dictionary<string, string> parameters,
        Dictionary<string, string>? extraHeaders
    )
    {
        if (!string.IsNullOrEmpty(RefreshToken))
        {
            Dictionary<string, string> refreshParams = new()
            {
                ["grant_type"] = "refresh_token",
                ["refresh_token"] = RefreshToken!,
            };
            if (parameters.TryGetValue("client_id", out string? clientId))
            {
                refreshParams["client_id"] = clientId;
            }
            if (parameters.TryGetValue("client_secret", out string? clientSecret))
            {
                refreshParams["client_secret"] = clientSecret;
            }
            try
            {
                await FetchTokenAsync(tokenUrl, refreshParams, extraHeaders).ConfigureAwait(false);
                if (_accessToken is not null)
                {
                    return _accessToken;
                }
            }
            catch (Exception ex)
                when (ex is not OutOfMemoryException
                    and not StackOverflowException
                    and not OperationCanceledException)
            {
                /* Refresh failed for ANY recoverable reason — a revoked/expired
                 * refresh token (OAuth2ServerException), a 2xx refresh body missing
                 * access_token (OAuth2TokenException), a transport failure
                 * (HttpRequestException), a malformed JSON body (JsonException),
                 * a timeout (NetworkTimeoutException), etc. Fall back to re-running
                 * the original grant below — matching the other 11 SDKs, which
                 * all catch any refresh failure here (Java catch (RuntimeException),
                 * Python except Exception, Ruby rescue StandardError, ...). The
                 * `when` filter both keeps CA1031 satisfied (no bare catch-all)
                 * and lets genuinely fatal runtime failures and the caller's
                 * cancellation (OperationCanceledException) propagate. Scoped to
                 * the refresh attempt only; the fallback grant below is not
                 * wrapped, so its failures propagate normally. */
            }
        }

        await FetchTokenAsync(tokenUrl, parameters, extraHeaders).ConfigureAwait(false);
        return _accessToken ?? throw new OAuth2TokenException("Failed to obtain access token");
    }

    /// <summary>
    /// Invalidates the cached access token so that the next call to
    /// <see cref="GetAccessTokenAsync"/> fetches a fresh token from the token
    /// endpoint. Intended for tests and recovery flows.
    /// </summary>
    public void InvalidateAccessToken()
    {
        lock (_stateLock)
        {
            _accessToken = null;
            _tokenExpiry = null;
        }
    }

    /// <summary>
    /// Manually sets an access token, bypassing the token endpoint.
    /// </summary>
    /// <param name="token">The access token to use.</param>
    public void SetAccessToken(string token)
    {
        _accessToken = token;
        _tokenExpiry = null;
    }

    private async Task FetchTokenAsync(
        Uri tokenUrl,
        Dictionary<string, string> parameters,
        Dictionary<string, string>? extraHeaders
    )
    {
        if (_apiClient is null)
        {
            throw new InvalidOperationException(
                "ApiClient has not been injected. "
                    + "Ensure the {{clientClassName}} constructor calls SetApiClient() "
                    + "on IHttpAwareAuthenticator before making API requests."
            );
        }

        string body = string.Join(
            "&",
            parameters.Select(p =>
                Uri.EscapeDataString(p.Key)
                + "="
                + Uri.EscapeDataString(p.Value).Replace("%20", "+", StringComparison.Ordinal)
            )
        );

        Dictionary<string, string> headers = new()
        {
            ["Content-Type"] = "application/x-www-form-urlencoded",
            ["Accept"] = "application/json",
        };
        if (extraHeaders is not null)
        {
            foreach (KeyValuePair<string, string> kvp in extraHeaders)
            {
                headers[kvp.Key] = kvp.Value;
            }
        }

        /* Gap 3.2: token POSTs MUST NOT follow ANY 3xx redirect (RFC 6749
         * §3.2 forbids redirects at the token endpoint). A compromised or
         * malicious token endpoint could otherwise issue a redirect that
         * replays the form body (containing the client secret / refresh
         * token) to an attacker-controlled URL. We pass noRedirect: true so
         * the transport surfaces the 3xx verbatim and we refuse to honour it.
         * A transport failure propagates unchanged as NetworkException /
         * NetworkTimeoutException. */
        ApiHttpResponse response = await _apiClient
            .SendRequestAsync("POST", tokenUrl, headers, body, noRedirect: true)
            .ConfigureAwait(false);

        if (response.StatusCode is < 200 or >= 300)
        {
            /* Any non-2xx answer, a refused 3xx included, is an
             * OAuth2ServerException. RFC 6749 §5.2: OAuth2 error responses
             * are JSON bodies with `error` (required), `error_description`,
             * `error_uri`. Parse them into the typed properties so callers
             * can recover. Fall back to the raw body when the response is
             * not a valid error object. */
            throw ParseOAuth2ServerError(response.StatusCode, response.Body);
        }

        using JsonDocument doc = ParseTokenResponse(response.Body);
        JsonElement root = doc.RootElement;
        if (root.ValueKind != JsonValueKind.Object)
        {
            throw new OAuth2TokenException("Token response is not a JSON object");
        }
        string? accessTokenValue =
            root.TryGetProperty("access_token", out JsonElement accessTokenElement)
            && accessTokenElement.ValueKind == JsonValueKind.String
                ? accessTokenElement.GetString()
                : null;
        if (string.IsNullOrEmpty(accessTokenValue))
        {
            throw new OAuth2TokenException("Token response missing or empty access_token field");
        }
        _accessToken = accessTokenValue;
        if (root.TryGetProperty("refresh_token", out JsonElement refreshTokenElement)
            && refreshTokenElement.ValueKind == JsonValueKind.String)
        {
            string? newRefreshToken = refreshTokenElement.GetString();
            if (!string.IsNullOrEmpty(newRefreshToken))
            {
                RefreshToken = newRefreshToken;
            }
        }
        if (
            root.TryGetProperty("expires_in", out JsonElement expiresIn)
            && expiresIn.ValueKind != JsonValueKind.Null
        )
        {
            /* RFC 6749 §5.1 says expires_in is a JSON number, but real-world
             * providers (Salesforce, some Apigee deployments) send a quoted
             * string and others send a JSON float. Accept ints, floor floats,
             * parse digit strings; on anything unparseable or non-positive,
             * mark the token as immediately stale so the next call refetches
             * (preferable to caching a token of unknown lifetime forever). */
            long seconds = ParseExpiresIn(expiresIn);
            if (seconds > 0L)
            {
                long bufferSecs = Math.Min(seconds, 30L);
                _tokenExpiry = DateTimeOffset.UtcNow.AddSeconds(seconds - bufferSecs);
            }
            else
            {
                _tokenExpiry = DateTimeOffset.UtcNow;
            }
        }
    }

    /// <summary>
    /// Parse a 2xx token response body. A body that is not JSON is unusable,
    /// which is an <see cref="OAuth2TokenException"/>.
    /// </summary>
    private static JsonDocument ParseTokenResponse(string body)
    {
        try
        {
            return JsonDocument.Parse(body);
        }
        catch (JsonException ex)
        {
            throw new OAuth2TokenException($"Token response is not valid JSON: {ex.Message}", ex);
        }
    }

    /// <summary>
    /// Parse an RFC 6749 §5.2 OAuth2 error response body into a typed
    /// <see cref="OAuth2ServerException"/>. Falls back to a generic error using
    /// the raw body when the body is not a valid OAuth2 error object.
    /// </summary>
    private static OAuth2ServerException ParseOAuth2ServerError(int statusCode, string body)
    {
        try
        {
            using JsonDocument doc = JsonDocument.Parse(body);
            JsonElement root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("error", out JsonElement errorElement)
                && errorElement.ValueKind == JsonValueKind.String)
            {
                string? code = errorElement.GetString();
                if (!string.IsNullOrEmpty(code))
                {
                    string? description =
                        root.TryGetProperty("error_description", out JsonElement descElement)
                        && descElement.ValueKind == JsonValueKind.String
                            ? descElement.GetString()
                            : null;
                    string? uri =
                        root.TryGetProperty("error_uri", out JsonElement uriElement)
                        && uriElement.ValueKind == JsonValueKind.String
                            ? uriElement.GetString()
                            : null;
                    return new OAuth2ServerException(statusCode, code, description, uri, body);
                }
            }
        }
        catch (JsonException)
        {
            /* Not a JSON body; fall through and report the raw body. */
        }
        return new OAuth2ServerException(statusCode, null, null, null, body);
    }

    /// <summary>
    /// Defensive parse of the <c>expires_in</c> field per RFC 6749 §5.1.
    /// Returns <c>0</c> (caller skips caching) when missing, unparseable, or
    /// non-positive. Accepts integers, floors floats, and parses digit strings
    /// (e.g. <c>"3600"</c> from Salesforce).
    /// </summary>
    private static long ParseExpiresIn(JsonElement element)
    {
        switch (element.ValueKind)
        {
            case JsonValueKind.Number:
                if (element.TryGetInt64(out long asInt))
                {
                    return asInt;
                }
                if (element.TryGetDouble(out double asDouble))
                {
                    if (double.IsNaN(asDouble) || double.IsInfinity(asDouble))
                    {
                        return 0L;
                    }
                    return (long)Math.Floor(asDouble);
                }
                return 0L;
            case JsonValueKind.String:
                string? text = element.GetString()?.Trim();
                if (string.IsNullOrEmpty(text))
                {
                    return 0L;
                }
                if (
                    double.TryParse(
                        text,
                        System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture,
                        out double parsed
                    )
                )
                {
                    if (double.IsNaN(parsed) || double.IsInfinity(parsed))
                    {
                        return 0L;
                    }
                    return (long)Math.Floor(parsed);
                }
                return 0L;
            case JsonValueKind.Undefined:
            case JsonValueKind.Object:
            case JsonValueKind.Array:
            case JsonValueKind.True:
            case JsonValueKind.False:
            case JsonValueKind.Null:
            default:
                return 0L;
        }
    }

    /// <summary>Gets the refresh token returned by the token endpoint, if any.</summary>
    public string? RefreshToken { get; private set; }
}
