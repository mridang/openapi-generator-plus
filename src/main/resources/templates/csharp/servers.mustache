                {{#hasEnumValues}}[{{#varEnumValues}}"{{#lambda.stringLiteral}}{{{.}}}{{/lambda.stringLiteral}}"{{^-last}}, {{/-last}}{{/varEnumValues}}]{{/hasEnumValues}}{{^hasEnumValues}}[]{{/hasEnumValues}}),
{{/serverVariables}}        }{{#serverName}},
