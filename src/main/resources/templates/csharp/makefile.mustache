.PHONY: build test lint format analyze docs clean

build:
	dotnet build

test:
	dotnet test --verbosity normal

lint:
	dotnet csharpier --check .

format:
	dotnet csharpier .

analyze:
	dotnet build --no-restore /warnaserror

docs:
	dotnet build /p:DocumentationFile=docs/api.xml

clean:
	dotnet clean
