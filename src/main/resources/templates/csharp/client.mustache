    /// <summary>
    /// Creates a new client with the given authenticator and default transport settings.
    /// </summary>
    /// <param name="authenticator">Provides host URL and auth headers.</param>
    public {{clientClassName}}(IAuthenticator authenticator)
        : this(authenticator, TransportOptions.Builder().Build()) { }

    /// <summary>
    /// Creates a new client with the given authenticator and transport options.
    ///
    /// The authenticator is the credential for every operation. If it implements
    /// <see cref="IHttpAwareAuthenticator"/>, the shared <see cref="IApiClient"/>
    /// is injected so that token exchange and discovery requests use the same
    /// proxy, TLS, and timeout settings.
    /// </summary>
    /// <param name="authenticator">Provides host URL and auth headers.</param>
    /// <param name="transportOptions">HTTP transport configuration (proxy, TLS, timeouts, etc.).</param>
    public {{clientClassName}}(IAuthenticator authenticator, TransportOptions? transportOptions)
        : this(HostOf(authenticator), authenticator, NoSchemeAuthenticators, transportOptions) { }

    /// <summary>
    /// Creates a new client that holds one optional credential per security scheme the spec
    /// declares, each named after its scheme. An operation uses the credential of the scheme its
    /// spec requires; a call cannot pick another scheme. An operation whose scheme has no
    /// credential here is sent without one.
    /// </summary>
    /// <param name="host">API base URL.</param>
{{#clientSchemes}}
    /// <param name="{{argName}}">Credential for the <c>{{schemeName}}</c> security scheme, or null for none.</param>
{{/clientSchemes}}
    /// <param name="transportOptions">Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).</param>
    public {{clientClassName}}(
        string host,
{{#clientSchemes}}
        {{packageName}}.Auth{{#namespaceSuffix}}.{{namespaceSuffix}}{{/namespaceSuffix}}.{{className}}? {{argName}} = null,
{{/clientSchemes}}
        TransportOptions? transportOptions = null)
        : this(
            host,
            null,
            SchemeAuthenticatorMap(
{{#clientSchemes}}
                ("{{schemeName}}", {{argName}}){{^-last}},{{/-last}}
{{/clientSchemes}}
            ),
            transportOptions) { }

    private {{clientClassName}}(
        string host,
        IAuthenticator? authenticator,
        IReadOnlyDictionary<string, IAuthenticator> schemeAuthenticators,
        TransportOptions? transportOptions)
    {
        ArgumentNullException.ThrowIfNull(host);
        transportOptions ??= TransportOptions.Builder().Build();

        _apiClient = new DefaultApiClient(transportOptions);

        if (authenticator is IHttpAwareAuthenticator httpAware)
        {
            httpAware.SetApiClient(_apiClient);
        }
        foreach (IAuthenticator scheme in schemeAuthenticators.Values)
        {
            if (scheme is IHttpAwareAuthenticator schemeHttpAware)
            {
                schemeHttpAware.SetApiClient(_apiClient);
            }
        }

        Configuration config = Configuration
            .Builder()
            .BaseUrl(host)
            .Build();
{{#apiInfo}}
{{#apis}}
{{#operations}}
        {{clientPropertyName}} = new {{classname}}(_apiClient, config, authenticator, schemeAuthenticators);
{{/operations}}
{{/apis}}
{{/apiInfo}}
    }

    private static readonly IReadOnlyDictionary<string, IAuthenticator> NoSchemeAuthenticators =
        new Dictionary<string, IAuthenticator>();

    private static string HostOf(IAuthenticator authenticator)
    {
        ArgumentNullException.ThrowIfNull(authenticator);
        return authenticator.GetHost();
    }

    private static Dictionary<string, IAuthenticator> SchemeAuthenticatorMap(
        params (string Scheme, IAuthenticator? Authenticator)[] entries)
    {
        var map = new Dictionary<string, IAuthenticator>();
        foreach ((string scheme, IAuthenticator? authenticator) in entries)
        {
            if (authenticator is not null)
            {
                map[scheme] = authenticator;
            }
        }
        return map;
    }

    /// <summary>
    /// Creates a client authenticated with a static Bearer token.
    /// </summary>
    /// <param name="host">API base URL.</param>
    /// <param name="accessToken">Bearer token.</param>
    /// <param name="transportOptions">Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).</param>
    /// <returns>Configured client instance.</returns>
    public static {{clientClassName}} WithToken(string host, string accessToken, TransportOptions? transportOptions = null)
    {
        return new {{clientClassName}}(new BearerAuthenticator(host, accessToken), transportOptions ?? TransportOptions.Builder().Build());
    }

    /// <summary>
    /// Creates a client from explicit options first and the environment second.
    /// The host is the <paramref name="host"/> argument, else the environment
    /// variable <c>{{envVarPrefix}}_HOST</c>; the credential is the
    /// <paramref name="tokenProvider"/> callback, else the <paramref name="token"/>
    /// argument, else <c>{{envVarPrefix}}_TOKEN</c>. The environment is read once, here,
    /// and an empty value counts as unset. A missing host or credential fails the
    /// call that builds the client, not a later request.
    /// </summary>
    /// <param name="host">API base URL, or null to read it from the environment.</param>
    /// <param name="token">Bearer token, or null to read it from the environment.</param>
    /// <param name="tokenProvider">Callback that returns the current bearer token before each request.</param>
    /// <param name="transportOptions">Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).</param>
    /// <returns>Configured client instance.</returns>
    /// <exception cref="InvalidOperationException">Thrown when no host or no credential is available.</exception>
    public static {{clientClassName}} FromEnvironment(
        string? host = null,
        string? token = null,
        Func<CancellationToken, Task<string>>? tokenProvider = null,
        TransportOptions? transportOptions = null)
    {
        string? resolvedHost = FirstSet(host, "{{envVarPrefix}}_HOST");
        if (resolvedHost is null)
        {
            throw new InvalidOperationException(
                "No API host: pass host or set the {{envVarPrefix}}_HOST environment variable");
        }
        if (tokenProvider is not null)
        {
            return new {{clientClassName}}(new BearerAuthenticator(resolvedHost, tokenProvider), transportOptions);
        }
        /* The explicit token is kept as given (an empty one is refused by the
         * authenticator, never replaced by the environment); the environment
         * comes before the provider, which is used only when neither is set. */
        string? resolvedToken = token ?? FirstSet(null, "{{envVarPrefix}}_TOKEN");
        if (resolvedToken is null && tokenProvider is not null)
        {
            return new {{clientClassName}}(new BearerAuthenticator(resolvedHost, tokenProvider), transportOptions);
        }
        if (resolvedToken is null)
        {
            throw new InvalidOperationException(
                "No credential: pass token or tokenProvider, or set the {{envVarPrefix}}_TOKEN environment variable");
        }
        return new {{clientClassName}}(new BearerAuthenticator(resolvedHost, resolvedToken), transportOptions);
    }

    private static string? FirstSet(string? explicitValue, string variable)
    {
        if (!string.IsNullOrEmpty(explicitValue))
        {
            return explicitValue;
        }
        string? fromEnvironment = Environment.GetEnvironmentVariable(variable);
        return string.IsNullOrEmpty(fromEnvironment) ? null : fromEnvironment;
    }

    /// <summary>
    /// Creates a client from a ready-made <see cref="IAuthenticator"/>.
    ///
    /// This is the generic entry point for bespoke authentication strategies such as
    /// OAuth2 client credentials, JWT private-key (service account), or a personal
    /// access token (PAT). Supply any <see cref="IAuthenticator"/> implementation; if
    /// it also implements <see cref="IHttpAwareAuthenticator"/>, the shared
    /// <see cref="IApiClient"/> is injected so its HTTP calls reuse the same transport
    /// configuration.
    /// </summary>
    /// <param name="authenticator">Provides host URL and auth headers.</param>
    /// <param name="transportOptions">Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).</param>
    /// <returns>Configured client instance.</returns>
    public static {{clientClassName}} WithAuthenticator(IAuthenticator authenticator, TransportOptions? transportOptions = null)
    {
        return new {{clientClassName}}(authenticator, transportOptions ?? TransportOptions.Builder().Build());
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        _apiClient.Dispose();
    }
}
