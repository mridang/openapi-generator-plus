namespace {{packageName}};

/// <summary>
/// Reads the <c>Link</c> header of RFC 8288. A value is a comma separated list of links, each an
/// angle-bracketed URI reference followed by <c>;</c> parameters whose values are tokens or
/// quoted strings. Commas and semicolons inside the brackets or inside a quoted string do not
/// split anything.
/// </summary>
internal static class LinkHeader
{
    /// <summary>One link of the header: the URI reference and the relation types of its <c>rel</c> parameter.</summary>
    internal sealed record Link(string Target, IReadOnlyList<string> Relations);

    /// <summary>Returns the URI reference of the first link whose relation type is <c>next</c>.</summary>
    /// <param name="header">The header value, repeated headers joined with a comma.</param>
    /// <returns>The URI reference exactly as written, or null when there is no <c>next</c> link.</returns>
    internal static string? Next(string? header)
    {
        if (header is null)
        {
            return null;
        }
        foreach (Link link in Parse(header))
        {
            if (link.Relations.Any(relation => string.Equals(relation, "next", StringComparison.OrdinalIgnoreCase)))
            {
                return link.Target;
            }
        }
        return null;
    }

    /// <summary>
    /// Parses a header value into its links. A link that is malformed is skipped, and the parse
    /// goes on with the next comma that is outside brackets and quotes.
    /// </summary>
    /// <param name="header">The header value.</param>
    /// <returns>The links in order.</returns>
    internal static List<Link> Parse(string header)
    {
        List<Link> links = [];
        int i = 0;
        int n = header.Length;
        while (i < n)
        {
            while (i < n && (header[i] == ' ' || header[i] == '\t' || header[i] == ','))
            {
                i++;
            }
            if (i >= n)
            {
                break;
            }
            if (header[i] != '<')
            {
                i = SkipToComma(header, i);
                continue;
            }
            int close = header.IndexOf('>', i + 1);
            if (close < 0)
            {
                break;
            }
            string target = header[(i + 1)..close];
            i = close + 1;
            List<string> relations = [];
            while (i < n)
            {
                while (i < n && (header[i] == ' ' || header[i] == '\t'))
                {
                    i++;
                }
                if (i >= n || header[i] == ',')
                {
                    break;
                }
                if (header[i] != ';')
                {
                    i = SkipToComma(header, i);
                    break;
                }
                i++;
                while (i < n && (header[i] == ' ' || header[i] == '\t'))
                {
                    i++;
                }
                int nameStart = i;
                while (i < n && "=;, \t".IndexOf(header[i], StringComparison.Ordinal) < 0)
                {
                    i++;
                }
                string name = header[nameStart..i];
                System.Text.StringBuilder value = new();
                if (i < n && header[i] == '=')
                {
                    i++;
                    if (i < n && header[i] == '"')
                    {
                        i++;
                        while (i < n && header[i] != '"')
                        {
                            if (header[i] == '\\' && i + 1 < n)
                            {
                                i++;
                            }
                            _ = value.Append(header[i]);
                            i++;
                        }
                        i++;
                    }
                    else
                    {
                        while (i < n && ";, \t".IndexOf(header[i], StringComparison.Ordinal) < 0)
                        {
                            _ = value.Append(header[i]);
                            i++;
                        }
                    }
                }
                if (string.Equals(name, "rel", StringComparison.OrdinalIgnoreCase) && relations.Count == 0)
                {
                    foreach (
                        string relation in value.ToString().Split(
                            [' ', '\t'],
                            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
                        )
                    )
                    {
                        relations.Add(relation);
                    }
                }
            }
            links.Add(new Link(target, relations));
        }
        return links;
    }

    /// <summary>Skips to the next comma that is outside brackets and quotes, and returns its index or the end.</summary>
    private static int SkipToComma(string s, int start)
    {
        bool quoted = false;
        bool bracketed = false;
        for (int i = start; i < s.Length; i++)
        {
            char c = s[i];
            if (quoted)
            {
                if (c == '\\')
                {
                    i++;
                }
                else if (c == '"')
                {
                    quoted = false;
                }
            }
            else if (c == '"')
            {
                quoted = true;
            }
            else if (c == '<')
            {
                bracketed = true;
            }
            else if (c == '>')
            {
                bracketed = false;
            }
            else if (c == ',' && !bracketed)
            {
                return i;
            }
        }
        return s.Length;
    }
}
