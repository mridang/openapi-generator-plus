namespace {{packageName}};

/// <summary>
/// What a call hook is told about one operation call.
/// </summary>
/// <param name="OperationId">The operation id exactly as the spec writes it.</param>
/// <param name="Method">The upper-case HTTP method.</param>
/// <param name="UrlTemplate">The spec path template of the operation, without the server base path.</param>
/// <param name="Url">The request URL without its query string and fragment.</param>
/// <param name="ServerAddress">The lower-case host of the request URL, without port and without the brackets of an IPv6 literal.</param>
public sealed record CallInfo(
    string OperationId,
    string Method,
    string UrlTemplate,
    string Url,
    string ServerAddress
);
