    /// <summary>
    /// Gap T3: 303 forces follow-up to GET and drops body per RFC 7231 §6.4.4.
    /// </summary>
    [Fact]
    public async Task Redirect303SwitchesToGetAndDropsBody()
    {
        var transport = TransportOptions.Builder()
            .FollowRedirects(true)
            .MaxRedirects(5)
            .Build();

        var client = new DefaultApiClient(transport);
        var headers = new Dictionary<string, string> { { "Content-Type", "application/json" } };
        var response = await client.SendRequestAsync(
            "POST",
            new Uri(_fixture.WireMockHttpUrl + "/api/redirect-303"),
            headers,
            "hello-body"
        );

        Assert.Equal(200, response.StatusCode);
        var json = JsonDocument.Parse(response.Body);
        Assert.Equal("GET", json.RootElement.GetProperty("method").GetString());
        Assert.Equal("", json.RootElement.GetProperty("body").GetString());
    }

    /* T-new-3: multipart body replay on 307/308 is NOT exercisable from
     * C# because .NET's HttpClient drops the request body when transparently
     * following a 307 redirect, and `[Fact(Skip = "...")]` is stripped to
     * `[Fact]` by the dotnet format auto-fixer in our post-process pipeline
     * (so a skip-with-reason can't survive regeneration). The test method
     * is omitted entirely here; see AGENT.md "307/308 multipart body replay"
     * for the scope of the future fix and the Rust SDK for the canonical
     * implementation. */

    // -- Max redirects --

    [Fact]
    public void RespectsMaxRedirectsLimit()
    {
        var transport = TransportOptions.Builder()
            .FollowRedirects(true)
            .MaxRedirects(5)
            .Build();

        var client = new DefaultApiClient(transport);
        Assert.NotNull(client);
        Assert.Equal(5, transport.MaxRedirects);
    }

    // -- Multipart body --

    [Fact]
    public async Task SendsMultipartFormData()
    {
        var client = new DefaultApiClient();
        var formData = new Dictionary<string, object>
        {
            { "description", "A test file" },
            { "file", System.Text.Encoding.UTF8.GetBytes("file content") }
        };
        var response = await client.SendRequestAsync(
            "POST",
            new Uri(_fixture.WireMockHttpUrl + "/api/test"),
            new Dictionary<string, string>(),
            formData
        );

        Assert.NotNull(response);
    }

    /// <summary>
    /// W-new-2: multipart field-name validation must run on every branch
    /// (not just binary). Confirm that even for a plain string value, a
    /// CR/LF in the field name is rejected, preventing Content-Disposition
    /// smuggling.
    /// </summary>
    [Fact]
    public async Task MultipartFieldNameWithCrlfRejectedOnStringValue()
    {
        var client = new DefaultApiClient();
        var badFields = new Dictionary<string, object>
        {
            { "name\r\nInjected: yes", "string-value" }
        };
        await Assert.ThrowsAnyAsync<Exception>(async () =>
            await client.SendRequestAsync(
                "POST",
                new Uri(_fixture.WireMockHttpUrl + "/api/test"),
                new Dictionary<string, string>(),
                badFields));
    }

