    private sealed class CallOptionsApiClient(int status, string body) : IApiClient
    {
        public int? Timeout { get; private set; }
        public int? MaxRetries { get; private set; }
        public Dictionary<string, string> Headers { get; private set; } = [];
        public Uri? Url { get; private set; }

        public Task<ApiHttpResponse> SendRequestAsync(
            string method, Uri url, Dictionary<string, string> headers, object? requestBody)
        {
            Url = url;
            Headers = new Dictionary<string, string>(headers);
            return Task.FromResult(new ApiHttpResponse(status, body, new Dictionary<string, string>
            {
                { "Content-Type", "application/json" }
            }));
        }

        public Task<ApiHttpResponse> SendRequestAsync(
            string method,
            Uri url,
            Dictionary<string, string> headers,
            object? requestBody,
            bool noRedirect,
            Func<Task<Dictionary<string, string>>>? refreshHeaders,
            int? timeout,
            int? maxRetries,
            CancellationToken cancellationToken)
        {
            Url = url;
            Timeout = timeout;
            MaxRetries = maxRetries;
            return SendRequestAsync(method, url, headers, requestBody);
        }
    }

