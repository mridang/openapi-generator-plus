    [Fact]
    public async Task BhvTracing015ConcurrentOperationsEachSendTheirOwnCallersTraceparent()
    {
        using var listener = RecordAllActivities();
        using var source = new ActivitySource("test.base.api.concurrent");

        async Task<(string Expected, string? Actual)> RunAsync(string name)
        {
            using var activity = source.StartActivity(name);
            Assert.NotNull(activity);
            var headers = await CallCapturingHeadersAsync(new DelayedAuthenticator());
            return (TraceparentOf(activity), headers.GetValueOrDefault("traceparent"));
        }

        var results = await Task.WhenAll(
            Task.Run(() => RunAsync("first")), Task.Run(() => RunAsync("second")));

        Assert.NotEqual(results[0].Expected, results[1].Expected);
        Assert.Equal(results[0].Expected, results[0].Actual);
        Assert.Equal(results[1].Expected, results[1].Actual);
    }

    [Fact]
    public async Task BhvTracing016AnOperationWithNoActiveSpanSendsNoTraceparent()
    {
