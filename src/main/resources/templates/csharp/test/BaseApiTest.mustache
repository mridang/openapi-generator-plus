        using (var activity = source.StartActivity("earlier"))
        {
            Assert.NotNull(activity);
            var traced = await CallCapturingHeadersAsync();
            Assert.True(traced.ContainsKey("traceparent"));
        }
        Activity.Current = null;

        var headers = await CallCapturingHeadersAsync();

        Assert.False(headers.ContainsKey("traceparent"));
    }

