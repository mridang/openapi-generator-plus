    [Fact]
    public async Task BhvMisc079ASuccessBodyIsDecodedByTheStatusThatArrived()
    {
        var decodedStatuses = new List<int>();
        string? Decode(int status, string body)
        {
            decodedStatuses.Add(status);
            return status == 201 ? "created:" + body : "ok:" + body;
        }

        var created = await new TestableApi(new CallOptionsApiClient(201, "{}"), "http://localhost")
            .CallWithCallOptionsAsync<string>("/x", [], null, null, null, Decode);
        var existing = await new TestableApi(new CallOptionsApiClient(200, "{}"), "http://localhost")
            .CallWithCallOptionsAsync<string>("/x", [], null, null, null, Decode);

        Assert.Equal("created:{}", created.Data);
        Assert.Equal("ok:{}", existing.Data);
        int[] expectedStatuses = [201, 200];
        Assert.Equal(expectedStatuses, decodedStatuses);
    }

