    [Theory]
    [InlineData("max-age=0", 2)]
    [InlineData("public, max-age=3600", 1)]
    [InlineData("no-store", 1)]
    [InlineData("max-age=9000000000000000000", 1)]
    [InlineData("max-age=99999999999999999999", 1)]
    public async Task DiscoveryIsReusedOnlyWhileItsMaxAgeHolds(string cacheControl, int expectedFetches)
    {
        /* A max-age of zero expires the cached document at once, so the second
           call fetches it again. A positive max-age, or a header with no
           max-age directive (which falls back to the 24 hour default), reuses
           the cached document. A max-age beyond the one year ceiling, even one
           past the range of a long, is clamped rather than overflowing the
           expiry arithmetic. */
        var client = new CacheControlApiClient(cacheControl);
        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await auth.BuildAuthorizationUrlAsync();
        await auth.BuildAuthorizationUrlAsync();

        Assert.Equal(expectedFetches, client.GetRequestCount);
    }

    [Fact]
    public async Task RediscoveryAfterExpiryKeepsTheExchangedSession()
    {
        /* max-age=0 expires the cached document at once, so the call after the code
           exchange fetches it again; the exchange made before must still count. */
        var auth = CreateAuthenticator();
        auth.SetApiClient(new ExchangingApiClient());

        await auth.ExchangeCodeAsync("the-code");
        Dictionary<string, string> headers = await auth.GetAuthHeadersAsync();

        Assert.Equal("Bearer at-1", headers["Authorization"]);
    }

    [Fact]
    public async Task RediscoveryKeepsThePkceVerifierOfTheBuiltAuthorizationUrl()
    {
        /* Every discovery names a different token endpoint, so the second one
           builds a new delegate around the previous session; the verifier of
           the URL built before must survive into the code exchange. */
        var client = new RotatingDiscoveryApiClient();
        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        Uri url = await auth.BuildAuthorizationUrlAsync("s");
        await auth.ExchangeCodeAsync("the-code");

        var challenge = System.Web.HttpUtility.ParseQueryString(url.Query)["code_challenge"];
        var verifier = System.Web.HttpUtility.ParseQueryString(client.LastTokenBody!)["code_verifier"];
        Assert.Equal(2, client.Discoveries);
        Assert.Equal("S256", System.Web.HttpUtility.ParseQueryString(url.Query)["code_challenge_method"]);
        Assert.Equal(43, verifier!.Length);
        Assert.Equal(
            Convert.ToBase64String(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.ASCII.GetBytes(verifier)))
                .TrimEnd('=').Replace('+', '-').Replace('/', '_'),
            challenge);
    }

    [Fact]
    public async Task InvalidatingTheAccessTokenRefreshesWithTheHeldRefreshToken()
    {
        var client = new RotatingDiscoveryApiClient();
        var auth = CreateAuthenticator();
        auth.SetApiClient(client);
        await auth.ExchangeCodeAsync("the-code");
        Assert.Equal("Bearer at-1", (await auth.GetAuthHeadersAsync())["Authorization"]);

        auth.InvalidateAccessToken();
        var headers = await auth.GetAuthHeadersAsync();

        Assert.Equal("Bearer at-2", headers["Authorization"]);
        Assert.Contains("grant_type=refresh_token", client.LastTokenBody!, StringComparison.Ordinal);
        Assert.Contains("refresh_token=rt-1", client.LastTokenBody!, StringComparison.Ordinal);
    }

    [Fact]
    public void InvalidatingBeforeAnyDiscoveryIsHarmless()
    {
        CreateAuthenticator().InvalidateAccessToken();
    }

    private sealed class RotatingDiscoveryApiClient : IApiClient
    {
        private int _tokens;
        public int Discoveries { get; private set; }
        public string? LastTokenBody { get; private set; }

        public Task<ApiHttpResponse> SendRequestAsync(
            string method,
            Uri url,
            Dictionary<string, string> headers,
            object? body)
        {
            if (method == "GET")
            {
                Discoveries++;
                return Task.FromResult(new ApiHttpResponse(
                    200,
                    "{\"authorization_endpoint\":\"https://auth.example.com/authorize\","
                        + "\"token_endpoint\":\"https://auth.example.com/token" + Discoveries + "\"}",
                    new Dictionary<string, string> { { "Cache-Control", "max-age=0" } }));
            }

            LastTokenBody = body?.ToString();
            _tokens++;
            return Task.FromResult(new ApiHttpResponse(
                200,
                "{\"access_token\":\"at-" + _tokens + "\",\"refresh_token\":\"rt-1\",\"expires_in\":3600}",
                new Dictionary<string, string> { { "Content-Type", "application/json" } }));
        }
    }

    private sealed class ExchangingApiClient : IApiClient
    {
        public Task<ApiHttpResponse> SendRequestAsync(
            string method,
            Uri url,
            Dictionary<string, string> headers,
            object? body)
        {
            if (method == "GET")
            {
                return Task.FromResult(new ApiHttpResponse(
                    200,
                    "{\"authorization_endpoint\":\"https://auth.example.com/authorize\","
                        + "\"token_endpoint\":\"https://auth.example.com/token\"}",
                    new Dictionary<string, string> { { "Cache-Control", "max-age=0" } }));
            }

            return Task.FromResult(new ApiHttpResponse(
                200,
                "{\"access_token\":\"at-1\",\"token_type\":\"Bearer\",\"expires_in\":3600}",
                new Dictionary<string, string> { { "Content-Type", "application/json" } }));
        }
    }

    private sealed class CacheControlApiClient(string cacheControl) : IApiClient
    {
        public int GetRequestCount { get; private set; }

        public Task<ApiHttpResponse> SendRequestAsync(
            string method,
            Uri url,
            Dictionary<string, string> headers,
            object? body)
        {
            GetRequestCount++;
            return Task.FromResult(new ApiHttpResponse(
                200,
                "{\"authorization_endpoint\":\"https://auth.example.com/authorize\","
                    + "\"token_endpoint\":\"https://auth.example.com/token\"}",
                new Dictionary<string, string> { { "Cache-Control", cacheControl } }));
        }
    }

    private sealed class CountingApiClient : IApiClient
    {
        private readonly Queue<ApiHttpResponse> _responses = new();

        public int GetRequestCount { get; private set; }

        public void Enqueue(string body, int statusCode = 200)
        {
            _responses.Enqueue(new ApiHttpResponse(statusCode, body, new Dictionary<string, string>()));
        }

        public Task<ApiHttpResponse> SendRequestAsync(
            string method, Uri url, Dictionary<string, string> headers, object? body)
        {
            if (method == "GET")
            {
                GetRequestCount++;
            }
            return Task.FromResult(_responses.Dequeue());
        }
    }
