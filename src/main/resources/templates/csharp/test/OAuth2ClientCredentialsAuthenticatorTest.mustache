using {{packageName}};
using {{packageName}}.Auth.OAuth;
using Xunit;

namespace Test;

public class OAuth2ClientCredentialsAuthenticatorTest
{
    private sealed class FakeApiClient : IApiClient
    {
        private readonly Queue<ApiHttpResponse> _responses = new();

        public void Enqueue(string body, int statusCode = 200)
        {
            _responses.Enqueue(new ApiHttpResponse(statusCode, body, new Dictionary<string, string>()));
        }

        public string? LastBody { get; private set; }
        public Uri? LastUrl { get; private set; }
        public Dictionary<string, string> LastHeaders { get; private set; } = new();

        public Task<ApiHttpResponse> SendRequestAsync(
            string method, Uri url, Dictionary<string, string> headers, object? body, bool noRedirect = false)
        {
            LastUrl = url;
            LastHeaders = headers;
            LastBody = body?.ToString();
            return Task.FromResult(_responses.Dequeue());
        }
    }

    private static readonly string[] Scopes = new[] { "read", "write" };

    private static OAuth2ClientCredentialsAuthenticator CreateAuthenticator()
    {
        return new OAuth2ClientCredentialsAuthenticator(
            "https://api.example.com",
            "my-client-id",
            "my-client-secret",
            new Uri("https://auth.example.com/token"),
            Scopes);
    }

    [Fact]
    public async Task SendsClientCredentialsGrantType()
    {
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"tok1\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await auth.GetAuthHeadersAsync();

        Assert.NotNull(client.LastBody);
        Assert.Contains("grant_type=client_credentials", client.LastBody!);
    }

    [Fact]
    public async Task SendsClientIdAndSecret()
    {
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"tok1\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await auth.GetAuthHeadersAsync();

        Assert.Contains("client_id=my-client-id", client.LastBody!);
        Assert.Contains("client_secret=my-client-secret", client.LastBody!);
    }

    [Fact]
    public async Task SendsScopes()
    {
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"tok1\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await auth.GetAuthHeadersAsync();

        Assert.Contains("scope=read+write", client.LastBody!);
    }

    [Fact]
    public async Task ReturnsAuthorizationBearerHeader()
    {
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"tok-abc\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        Dictionary<string, string> headers = await auth.GetAuthHeadersAsync();

        Assert.Equal("Bearer tok-abc", headers["Authorization"]);
    }

    [Fact]
    public async Task SendsRequestToTokenUrl()
    {
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"tok1\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await auth.GetAuthHeadersAsync();

        Assert.Equal(new Uri("https://auth.example.com/token"), client.LastUrl);
    }

    [Fact]
    public async Task TokenFetchErrorIsSurfacedNotSwallowed()
    {
        // oauth-cc-authheaders-error-swallow: a failed client-credentials token
        // exchange must surface to the caller as a thrown error — NOT be
        // swallowed into an empty header map that would send the API request
        // unauthenticated and produce a confusing downstream 401.
        var client = new FakeApiClient();
        client.Enqueue("{\"error\":\"invalid_client\"}", 401);

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        await Assert.ThrowsAnyAsync<Exception>(() => auth.GetAuthHeadersAsync());
    }

    [Fact]
    public async Task CachesTokenAcrossCalls()
    {
        // The token manager caches the access token until expiry, so two
        // consecutive header requests must reuse the same token and issue only
        // a single token request. Only one response is enqueued; a second token
        // fetch would dequeue an empty queue and throw, proving single-flight.
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"cached-cc-token\",\"expires_in\":3600}");

        var auth = CreateAuthenticator();
        auth.SetApiClient(client);

        Dictionary<string, string> headers1 = await auth.GetAuthHeadersAsync();
        Dictionary<string, string> headers2 = await auth.GetAuthHeadersAsync();

        Assert.Equal("Bearer cached-cc-token", headers1["Authorization"]);
        Assert.Equal("Bearer cached-cc-token", headers2["Authorization"]);
    }

    [Fact]
    public void GetHostReturnsConfiguredHost()
    {
        var auth = CreateAuthenticator();

        Assert.Equal("https://api.example.com", auth.GetHost());
    }

    [Fact]
    public async Task BasicAuthUrlEncodesClientIdAndSecret()
    {
        // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
        // client_id and client_secret MUST be application/x-www-form-
        // urlencoded BEFORE being joined with ':' and base64-encoded.
        // Verifies a client_id with `+` and a secret with `&` are encoded
        // (not raw) before the colon-join + base64.
        var client = new FakeApiClient();
        client.Enqueue("{\"access_token\":\"at\",\"expires_in\":3600}");

        var auth = new OAuth2ClientCredentialsAuthenticator(
            "https://api.example.com",
            "id+with/special",
            "secret&with=stuff",
            new Uri("https://auth.example.com/token"),
            new[] { "read" },
            ClientAuthMethod.Basic);
        auth.SetApiClient(client);

        await auth.GetAuthHeadersAsync();

        Assert.True(client.LastHeaders.TryGetValue("Authorization", out var authHeader));
        Assert.NotNull(authHeader);
        Assert.StartsWith("Basic ", authHeader);
        string decoded = System.Text.Encoding.UTF8.GetString(
            Convert.FromBase64String(authHeader!.Substring("Basic ".Length)));
        // Expected: form-urlencoded id ':' form-urlencoded secret
        Assert.Equal("id%2Bwith%2Fspecial:secret%26with%3Dstuff", decoded);
    }
}
