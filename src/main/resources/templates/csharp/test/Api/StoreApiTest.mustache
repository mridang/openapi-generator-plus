    [Fact]
    public async Task BhvOperations101TestGetGroupedCategoriesDeserializesNestedContainerLeavesAsTypedModels()
    {
        // getGroupedCategories returns a nested container: an array of maps of
        // Category (List<Dictionary<string, Category>>). The deserialized
        // leaves must be typed Category instances with their fields populated,
        // not raw maps/JsonElement. Canonical across all 12 SDKs.
        var mockApi = NewStoreApiForMock(
            200,
            "application/json",
            "[{\"a\":{\"id\":1,\"name\":\"Dogs\"}},{\"b\":{\"id\":2,\"name\":\"Cats\"}}]");

        var result = await mockApi.GetGroupedCategoriesAsync();

        Assert.NotNull(result);
        Assert.Equal(2, result.Count);

        var first = result[0]["a"];
        Assert.IsType<Category>(first);
        Assert.Equal(1L, first.Id);
        Assert.Equal("Dogs", first.Name);

        var second = result[1]["b"];
        Assert.IsType<Category>(second);
        Assert.Equal(2L, second.Id);
        Assert.Equal("Cats", second.Name);
    }

    [Fact]
    public async Task BhvOperations113TestGetSwatchReturnsValueTypeEnum()
    {
        // getSwatch returns a bare enum (a value type). The convenience wrapper
        // must compile and decode the wire value into the enum — the empty-body
        // guard uses an `is { }` null check rather than `?? throw`, which cannot
        // be applied to a non-nullable value type.
        var mockApi = NewStoreApiForMock(200, "application/json", "\"red\"");

        var result = await mockApi.GetSwatchAsync();

        Assert.Equal(Swatch.Red, result);
    }

    [Fact]
    public async Task BhvOperations122TestGetBySwatchSendsTheEnumWireValueInPathQueryAndHeader()
    {
        // A named-enum ($ref) parameter must go out as its wire value in each
        // location, not as the language name of the enum member.
        var client = new RequestCapturingApiClient();
        var api = new StoreApi(client, Configuration.Builder().BaseUrl("http://localhost").Build());

        await api.GetBySwatchAsync(
            Swatch.Red,
            new GetBySwatchOptions { QuerySwatch = Swatch.Green, PreferredSwatch = Swatch.Blue });

        Assert.EndsWith("/store/by-swatch/red", client.Url!.AbsolutePath, StringComparison.Ordinal);
        Assert.Equal("?querySwatch=green", client.Url.Query);
        Assert.Equal("blue", client.Headers["Preferred-Swatch"]);
    }

