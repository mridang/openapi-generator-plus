        public string Body { get; init; } = "[]";

        public Task<{{packageName}}.ApiHttpResponse> SendRequestAsync(
            string method, Uri url, Dictionary<string, string> headers, object? body)
        {
            Headers = new Dictionary<string, string>(headers);
            return Task.FromResult(new {{packageName}}.ApiHttpResponse(200, Body,
                new Dictionary<string, string> { { "Content-Type", "application/json" } }));
        }

        public Task<{{packageName}}.ApiHttpResponse> SendRequestAsync(
            string method,
            Uri url,
            Dictionary<string, string> headers,
            object? body,
            bool noRedirect,
            Func<Task<Dictionary<string, string>>>? refreshHeaders,
            int? timeout,
            int? maxRetries,
            CancellationToken cancellationToken)
        {
            Timeout = timeout;
            MaxRetries = maxRetries;
            return SendRequestAsync(method, url, headers, body);
        }
    }

