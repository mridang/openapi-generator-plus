using {{packageName}};
using Xunit;

namespace Test;

public class ServerConfigurationTest
{
    [Fact]
    public void GetUrlSubstitutesDefaultValues()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            "Test server",
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
                ["version"] = new ServerVariable("v3", null, ["v2", "v3"]),
            }
        );

        Assert.Equal("https://api.example.com/api/v3", server.GetUrl());
    }

    [Fact]
    public void GetUrlAppliesOverrides()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
                ["version"] = new ServerVariable("v3", null, ["v2", "v3"]),
            }
        );

        var url = server.GetUrl(
            new Dictionary<string, string> { ["env"] = "staging", ["version"] = "v2" }
        );

        Assert.Equal("https://staging.example.com/api/v2", url);
    }

    [Fact]
    public void GetUrlOverridesFallBackToDefaultForUnspecifiedVariables()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
                ["version"] = new ServerVariable("v3", null, ["v2", "v3"]),
            }
        );

        var url = server.GetUrl(new Dictionary<string, string> { ["env"] = "staging" });

        Assert.Equal("https://staging.example.com/api/v3", url);
    }

    [Fact]
    public void GetUrlRejectsValueOutsideEnum()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
            }
        );

        var ex = Assert.Throws<ArgumentException>(
            () => server.GetUrl(new Dictionary<string, string> { ["env"] = "invalid" })
        );
        Assert.Contains("Invalid value 'invalid'", ex.Message);
        Assert.Contains("env", ex.Message);
    }

    [Fact]
    public void GetUrlAcceptsAnyValueWhenEnumIsEmpty()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, []),
            }
        );

        var url = server.GetUrl(new Dictionary<string, string> { ["env"] = "anything" });

        Assert.Equal("https://anything.example.com", url);
    }

    [Fact]
    public void GetUrlNullOverridesThrows()
    {
        var server = new ServerConfiguration(
            "https://api.example.com",
            null,
            new Dictionary<string, ServerVariable>()
        );

        Assert.Throws<ArgumentNullException>(() => server.GetUrl(null!));
    }

    [Fact]
    public void ExposesRawTemplateAndDescription()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com",
            "Primary server",
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api"]),
            }
        );

        Assert.Equal("https://{env}.example.com", server.UrlTemplate);
        Assert.Equal("Primary server", server.Description);
        Assert.Single(server.Variables);
        Assert.True(server.Variables.ContainsKey("env"));
    }
}
