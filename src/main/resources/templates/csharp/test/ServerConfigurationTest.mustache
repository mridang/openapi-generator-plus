    [Fact]
    public void BhvServers008GetUrlRejectsValueOutsideEnum()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
            }
        );

        var ex = Assert.Throws<ArgumentException>(
            () => server.GetUrl(new Dictionary<string, string> { ["env"] = "invalid" })
        );
        Assert.Contains("Invalid value 'invalid'", ex.Message, StringComparison.Ordinal);
        Assert.Contains("env", ex.Message, StringComparison.Ordinal);
        // A server variable outside its enum is a caller mistake, not an SDK error.
        Assert.False(typeof({{errorPrefix}}Exception).IsInstanceOfType(ex));
    }

    [Fact]
    public void BhvServers012GetUrlRejectionMessageNamesTheValueTheVariableAndTheAllowedValues()
    {
        var server = new ServerConfiguration(
            "https://{env}.example.com",
            null,
            new Dictionary<string, ServerVariable>
            {
                ["env"] = new ServerVariable("api", null, ["api", "staging"]),
            });

        var ex = Assert.Throws<ArgumentException>(() =>
            server.GetUrl(new Dictionary<string, string> { ["env"] = "invalid" }));

        Assert.Equal(
            "Invalid value 'invalid' for server variable 'env'. Allowed values: [api, staging]",
            ex.Message);
    }

