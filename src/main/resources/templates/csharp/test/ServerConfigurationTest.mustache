    [Fact]
    public void BhvServers028GeneratedServersAndTheirVariablesCannotBeChanged()
    {
        var servers = Assert.IsAssignableFrom<IList<ServerConfiguration>>(Servers.All);
        Assert.Throws<NotSupportedException>(() => servers.Add(Servers.All[0]));

        foreach (ServerConfiguration server in Servers.All)
        {
            var variables = Assert.IsAssignableFrom<IDictionary<string, ServerVariable>>(server.Variables);
            Assert.Throws<NotSupportedException>(() => variables.Add("unlisted", new ServerVariable("x")));

            foreach (ServerVariable variable in server.Variables.Values)
            {
                var allowed = Assert.IsAssignableFrom<IList<string>>(variable.EnumValues);
                Assert.Throws<NotSupportedException>(() => allowed.Add("unlisted"));
            }
        }
    }
    [Fact]
    public void BhvMisc139ACollectionPassedInIsCopiedAndTheConfigurationCannotChangeIt()
    {
        var source = new Dictionary<string, ServerVariable>
        {
            ["region"] = new ServerVariable("eu", null, []),
        };
        var server = new ServerConfiguration("https://{region}.example.com", null, source);
        source["zone"] = new ServerVariable("us", null, []);
        Assert.False(server.Variables.ContainsKey("zone"));
        Assert.Throws<NotSupportedException>(() => ((IDictionary<string, ServerVariable>)(object)server.Variables)["zone"] = new ServerVariable("us", null, []));
    }

