    [Fact]
    public void BhvConfig014DefaultConfigurationIsStateless()
    {
        // There is no settable process-wide default: every call hands back a
        // fresh instance, so one caller cannot change what another gets.
        var first = Configuration.DefaultConfiguration();
        var second = Configuration.DefaultConfiguration();

        Assert.NotSame(first, second);
        Assert.Equal(first.BaseUrl, second.BaseUrl);
    }

    [Fact]
    public void BhvConfig023EachDefaultConfigurationCallReturnsAFreshInstance()
    {
        var first = Configuration.DefaultConfiguration();
        var second = Configuration.DefaultConfiguration();

        Assert.NotSame(first, second);
        Assert.Equal("{{{basePath}}}", first.BaseUrl);
        Assert.Equal("{{{basePath}}}", second.BaseUrl);
    }

    [Fact]
    public void BhvConfig024ConfigurationHasNoSettableProcessWideDefault()
    {
        var settable = typeof(Configuration)
            .GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static)
            .Where(property => property.CanWrite);

        Assert.Empty(settable);
    }

    [Fact]
    public void BhvConfig022MutatingTheReturnedDefaultHeadersLeavesTheConfigurationUnchanged()
    {
        var config = Configuration.Builder()
            .DefaultHeader("X-Test", "value")
            .Build();
        var headers = config.DefaultHeaders;

        Assert.Throws<NotSupportedException>(
            () => ((IDictionary<string, string>)headers)["X-Mutated"] = "should-not-affect-config"
        );
        Assert.DoesNotContain("X-Mutated", config.DefaultHeaders.Keys);
        Assert.Equal("value", config.DefaultHeaders["X-Test"]);
    }

    [Fact]
    public void BhvConfig017ABuiltConfigurationCannotBeChanged()
    {
        var config = Configuration.Builder()
            .DefaultHeader("X-Key", "value")
            .Build();

        // IReadOnlyDictionary prevents modification; verify the values are frozen
        Assert.Equal("value", config.DefaultHeaders["X-Key"]);
    }

    [Fact]
    public void BhvConfig003EveryBuilderSetterReturnsTheSameBuilder()
    {
        var builder = Configuration.Builder();

        Assert.Same(builder, builder.BaseUrl("https://example.com"));
        Assert.Same(builder, builder.DefaultHeader("X-Key", "value"));
        Assert.Same(
            builder,
            builder.DefaultHeaders(new Dictionary<string, string> { { "X-Other", "val" } })
        );

        var server = new ServerConfiguration(
            "https://example.com",
            null,
            new Dictionary<string, ServerVariable>()
        );
        Assert.Same(builder, builder.Server(server));
    }

