    [Fact]
    public void BhvErrors004ExposesStatusCodeMessageBodyHeadersErrorBody()
    {
        var ex = new ApiException(
            404,
            "not found",
            new Dictionary<string, string> { { "content-type", "application/json" } },
            "{\"id\":7,\"name\":\"missing\"}",
            null
        );

        Assert.Equal(404, ex.StatusCode);
        Assert.Equal("{\"id\":7,\"name\":\"missing\"}", ex.ResponseBody);
        Assert.Equal("application/json", ex.ResponseHeaders!["content-type"]);
        Assert.Null(ex.ErrorBody);
    }

    [Fact]
    public void BhvErrors021NullHeadersAndBodyMarkTransportNoResponse()
    {
        // apierror-responsebody-headers-nullable-split: null is distinct from an
        // empty header map / empty body so a pre-response transport failure can
        // be encoded.
        var ex = new ApiException(0, "connection reset", null, null);

        Assert.Null(ex.ResponseHeaders);
        Assert.Null(ex.ResponseBody);
    }

    [Fact]
    public void BhvErrors019IsAnExceptionWithStatusInItsStringForm()
    {
        // Message stays the detail message the exception was constructed with;
        // the response context is rendered by the string conversion, one
        // labelled field per line.
        var ex = new ApiException(
            500,
            "boom",
            new Dictionary<string, string> { { "x-request-id", "abc" } },
            "the body"
        );

        Assert.IsAssignableFrom<Exception>(ex);
        Assert.Equal("boom", ex.Message);
        Assert.Equal(
            "boom\nHTTP status code: 500\nResponse headers: {\"x-request-id\":\"abc\"}\nResponse body: the body",
            ex.ToString()
        );
    }

    [Fact]
    public void RendersTheHeadersAsCompactSortedJsonWithSlashesUnescaped()
    {
        var ex = new ApiException(
            302,
            "moved",
            new Dictionary<string, string>
            {
                { "x-b", "2" },
                { "location", "https://example.com/a" },
                { "x-a", "1" },
            }
        );

        Assert.Contains(
            "\nResponse headers: {\"location\":\"https://example.com/a\",\"x-a\":\"1\",\"x-b\":\"2\"}",
            ex.ToString(),
            StringComparison.Ordinal
        );
    }

    [Fact]
    public void BhvErrors013GetTypedErrorBodyDeserializesTheBodyIntoTheGivenClass()
    {
        // Built through FromResponse, the way a real response reaches a caller:
        // the typed body must come out of the raw body, not out of whatever the
        // generic parse happened to leave behind.
        var ex = ApiException.FromResponse(
            400,
            new Dictionary<string, string>(),
            "{\"id\":42,\"name\":\"Dogs\"}"
        );

        var typed = ex.GetTypedErrorBody<Category>();
        Assert.NotNull(typed);
        Assert.Equal(42L, typed!.Id);
        Assert.Equal("Dogs", typed.Name);
    }

    [Fact]
    public void BhvErrors007FromResponseNamesTheRequestMethodAndPathInTheMessage()
    {
        var ex = ApiException.FromResponse(
            404, new Dictionary<string, string>(), "{}", "GET", "/items/7");

        Assert.IsType<NotFoundException>(ex);
        Assert.Equal("GET", ex.RequestMethod);
        Assert.Equal("/items/7", ex.RequestPath);
        Assert.Equal("API returned status code 404 for GET /items/7", ex.Message);
        Assert.StartsWith("API returned status code 404 for GET /items/7", ex.ToString(), StringComparison.Ordinal);
    }

