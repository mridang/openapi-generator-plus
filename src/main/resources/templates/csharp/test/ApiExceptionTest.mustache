    [Fact]
    public void NamedErrorWithInnerExceptionKeepsItsStatus()
    {
        // The (message, inner) constructor must pin the leaf's status like
        // every other constructor, instead of leaving StatusCode at 0.
        var inner = new InvalidOperationException("cause");
        var cases = new List<(ApiException Error, int Status)>
        {
            (new BadRequestException("boom", inner), 400),
            (new UnauthorizedException("boom", inner), 401),
            (new ForbiddenException("boom", inner), 403),
            (new NotFoundException("boom", inner), 404),
            (new ConflictException("boom", inner), 409),
            (new UnprocessableEntityException("boom", inner), 422),
            (new TooManyRequestsException("boom", inner), 429),
            (new InternalServerErrorException("boom", inner), 500),
        };

        foreach ((ApiException error, int status) in cases)
        {
            Assert.Equal(status, error.StatusCode);
            Assert.Equal("boom", error.Message);
            Assert.Same(inner, error.InnerException);
        }
    }

    [Fact]
    public void RenderedBodyIsCappedAndNamesTheHiddenLength()
    {
        string body = new string('x', 1030);

        var ex = new ApiException(502, "bad gateway", null, body);

        string rendered = ex.ToString();
        Assert.Contains(new string('x', 1024) + "... (6 more bytes)", rendered, StringComparison.Ordinal);
        Assert.DoesNotContain(new string('x', 1025), rendered, StringComparison.Ordinal);
        Assert.Equal(body, ex.ResponseBody);
    }

    [Fact]
    public void BhvErrors001RenderedBodyEscapesLineBreaksAndControlCharacters()
    {
        var ex = new ApiException(500, "boom", null, "a\r\nforged: line\u0007");

        Assert.EndsWith("Response body: a\\r\\nforged: line\\u0007", ex.ToString(), StringComparison.Ordinal);
    }

    [Fact]
    public void BhvErrors023RenderedHeadersHideCredentialCarryingValues()
    {
        var ex = new ApiException(
            401,
            "denied",
            new Dictionary<string, string>
            {
                { "Set-Cookie", "session=s3cret" },
                { "WWW-Authenticate", "Bearer realm=x" },
                { "x-api-key", "k-123" },
                { "x-request-id", "abc" },
            }
        );

        string rendered = ex.ToString();
        Assert.DoesNotContain("s3cret", rendered, StringComparison.Ordinal);
        Assert.DoesNotContain("Bearer realm", rendered, StringComparison.Ordinal);
        Assert.DoesNotContain("k-123", rendered, StringComparison.Ordinal);
        Assert.Contains("\"Set-Cookie\":\"***\"", rendered, StringComparison.Ordinal);
        Assert.Contains("\"x-request-id\":\"abc\"", rendered, StringComparison.Ordinal);
    }

    [Fact]
    public void BhvErrors003EveryStatusSpecificErrorKeepsAnOptionalCause()
    {
        var cause = new InvalidOperationException("root cause");

        Assert.Same(cause, new BadRequestException("bad", cause).InnerException);
        Assert.Same(cause, new UnauthorizedException("unauthorized", cause).InnerException);
        Assert.Same(cause, new ForbiddenException("forbidden", cause).InnerException);
        Assert.Same(cause, new NotFoundException("missing", cause).InnerException);
        Assert.Same(cause, new ConflictException("conflict", cause).InnerException);
        Assert.Same(cause, new UnprocessableEntityException("invalid", cause).InnerException);
        Assert.Same(cause, new TooManyRequestsException("slow down", cause).InnerException);
        Assert.Same(cause, new InternalServerErrorException("boom", cause).InnerException);
        Assert.Same(cause, new ClientException(418, "teapot", cause).InnerException);
        Assert.Same(cause, new ServerException(503, "unavailable", cause).InnerException);
    }

