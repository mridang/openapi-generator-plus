    [Fact]
    public void BhvErrors018ApiExceptionDerivesFromBrandedRoot()
    {
        // unified-exception-hierarchy: ApiException sits under the single
        // branded root so one catch covers every SDK-originated failure.
        var ex = new ApiException(500, "boom");

        Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        Assert.IsAssignableFrom<Exception>(ex);
    }

    [Fact]
    public void TypedClientErrorWalksTheFullChain()
    {
        // BadRequest → ClientException → ApiException → {{errorPrefix}}Exception.
        var ex = new BadRequestException("bad request");

        Assert.IsAssignableFrom<ClientException>(ex);
        Assert.IsAssignableFrom<ApiException>(ex);
        Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        Assert.IsAssignableFrom<Exception>(ex);
        Assert.Equal(400, ex.StatusCode);
    }

    [Fact]
    public void BhvErrors020NetworkExceptionsDeriveFromApiExceptionWithStatusZero()
    {
        // No HTTP response arrived, so the status is 0 and the transport
        // failure is kept as the inner exception. Both sit under ApiException
        // so an existing catch on ApiException keeps catching them.
        var cause = new HttpRequestException("connection refused");
        var network = new {{packageName}}.Errors.NetworkException("connection refused", cause);
        var timeout = new {{packageName}}.Errors.NetworkTimeoutException("timed out", cause);

        Assert.IsAssignableFrom<ApiException>(network);
        Assert.Equal(0, network.StatusCode);
        Assert.Same(cause, network.InnerException);
        Assert.IsAssignableFrom<{{packageName}}.Errors.NetworkException>(timeout);
        Assert.IsAssignableFrom<ApiException>(timeout);
        Assert.Equal(0, timeout.StatusCode);
        Assert.Same(cause, timeout.InnerException);
    }

