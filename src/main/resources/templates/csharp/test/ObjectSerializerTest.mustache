    {{! Byte-array equality across the three shapes a property can take. C# }}
    {{! compares byte[] by REFERENCE identity (both == and the default }}
    {{! EqualityComparer), and a List<byte[]> bottoms out in reference-equal }}
    {{! elements, so a model holding bytes would report two instances carrying }}
    {{! the same content as unequal and would misbehave as a dictionary key. }}
    {{! The generated members route every container and byte[] field through }}
    {{! ObjectSerializer.StructuralEquals / StructuralHashCode, which recurse }}
    {{! into dictionaries and sequences and compare byte[] by span. }}
    {{! }}
    {{! The MAP case is the one that regressed in the sibling languages: the }}
    {{! template once selected the LIST branch for a map and emitted a }}
    {{! collection call on a map, which did not compile; the fix that restored }}
    {{! compilation then silently fell back to reference identity for the }}
    {{! values. A test covering only the bare array and the list passed }}
    {{! throughout both defects. C# was already correct here via }}
    {{! StructuralEquals, so these cases pin that behaviour down as a }}
    {{! regression guard and keep the three equality-generating languages }}
    {{! asserting the same contract. }}
    {{! }}
    {{! The fixture model carries all three deliberately: a bare byte[], a }}
    {{! list of them, and a map of them. }}
    public class ByteArrayEqualityTests
    {
        // Built fresh on every call, so each invocation hands back a vault
        // whose arrays are distinct objects. That is the whole point:
        // reference-identity comparison cannot pass the first test below.
        private static BinaryVault VaultOf(
            byte[]? seal = null,
            List<byte[]>? shards = null,
            Dictionary<string, byte[]>? labels = null)
        {
            return new BinaryVault
            {
                Seal = seal ?? new byte[] { 1, 2, 3 },
                Shards = shards ?? new List<byte[]> { new byte[] { 4, 5 }, new byte[] { 6 } },
                Labels = labels ?? new Dictionary<string, byte[]> { ["first"] = new byte[] { 7, 8 } },
            };
        }

        // The generated properties are nullable (Dictionary<string, byte[]>?),
        // so reading one back for an assertion needs a null check first.
        // Assert rather than silently default: a null here would mean the
        // fixture stopped populating the property and the test would be
        // vacuous.
        private static Dictionary<string, byte[]> LabelsOf(BinaryVault vault)
        {
            Assert.NotNull(vault.Labels);
            return vault.Labels!;
        }

        [Fact]
        public void ToStringRendersCollectionsAndBytesByContent()
        {
            var text = VaultOf().ToString();

            Assert.Contains("Shards=[BAU=, Bg==]", text, StringComparison.Ordinal);
            Assert.Contains("Labels={first=Bwg=}", text, StringComparison.Ordinal);
            Assert.DoesNotContain("System.Collections", text, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerializationobject090EqualContentDistinctArraysCompareEqual()
        {
            var left = VaultOf();
            var right = VaultOf();

            // Every array in the two models is a separate object, so identity
            // comparison would fail here on all three properties. This is the
            // load-bearing case.
            Assert.NotSame(left.Seal, right.Seal);
            Assert.NotSame(LabelsOf(left)["first"], LabelsOf(right)["first"]);

            Assert.Equal(left, right);
            Assert.Equal(left.GetHashCode(), right.GetHashCode());
        }

        [Fact]
        public void BhvSerializationobject075DifferingBareArrayCompareUnequal()
        {
            var left = VaultOf();
            var right = VaultOf(seal: new byte[] { 1, 2, 4 });

            Assert.NotEqual(left, right);
        }

        [Fact]
        public void BhvSerializationobject009DifferingListElementCompareUnequal()
        {
            var left = VaultOf();
            var right = VaultOf(shards: new List<byte[]> { new byte[] { 4, 5 }, new byte[] { 9 } });

            Assert.NotEqual(left, right);
        }

        [Fact]
        public void BhvSerializationobject005DifferingMapValueCompareUnequal()
        {
            var left = VaultOf();
            var right = VaultOf(labels: new Dictionary<string, byte[]> { ["first"] = new byte[] { 7, 9 } });

            // Reference-identity comparison of the map values would call these
            // EQUAL: the two dictionaries have the same key set, and a
            // comparison that stopped at the byte[] reference never looks at
            // the bytes. Only recursing into each value distinguishes them.
            Assert.NotEqual(left, right);
        }

        [Fact]
        public void BhvSerializationobject206DifferingMapKeyCompareUnequal()
        {
            var left = VaultOf();
            var right = VaultOf(labels: new Dictionary<string, byte[]> { ["second"] = new byte[] { 7, 8 } });

            // The complement of the case above: identical value bytes under a
            // different key. A comparison that walked only the values (or that
            // looked up by the WRONG dictionary's keys) would miss this.
            Assert.NotEqual(left, right);
        }
    }

    // Canonical serde behaviours (cross-SDK): a non-finite float is rejected on
    // encode, a bare JSON null body decodes to null, and the 1000-deep JSON
    // nesting cap rejects an over-deep payload.
    public class CanonicalSerdeBehaviorsTests
    {
        private readonly ObjectSerializer _serializer = new();

        [Fact]
        public void BhvSerializationobject153NonFiniteDoubleThrowsOnSerialize()
        {
            // RFC 8259 §6 has no NaN/Infinity token, so a non-finite float must
            // reject with the SDK's SerializationException rather than leak the
            // native ArgumentException Utf8JsonWriter raises.
            Assert.Throws<SerializationException>(() => _serializer.Serialize(double.NaN));
            Assert.Throws<SerializationException>(() => _serializer.Serialize(double.PositiveInfinity));
            Assert.Throws<SerializationException>(() => _serializer.Serialize(double.NegativeInfinity));
        }

        [Fact]
        public void BhvSerializationobject067LiteralNullBodyDeserializesToNull()
        {
            Assert.Null(_serializer.Deserialize<Category>("null"));
        }

        // A format:byte model field (PetPassport.Thumbnail) carrying a
        // bad-alphabet base64 string is rejected: System.Text.Json's byte[]
        // reader throws rather than silently truncating, surfaced as the SDK's
        // SerializationException.
        [Fact]
        public void BhvSerializationobject094InvalidBase64ByteFieldThrowsSerializationException()
        {
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<PetPassport>("{\"thumbnail\":\"!!!!\"}"));
            Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        }

        [Fact]
        public void BhvSerializationobject051DeepJsonWithinCapDecodesButBeyondIsRejected()
        {
            var within = new string('[', 600) + new string(']', 600);
            Assert.NotNull(_serializer.Deserialize<object>(within));
            var beyond = new string('[', 1500) + new string(']', 1500);
            Assert.Throws<SerializationException>(() => _serializer.Deserialize<object>(beyond));
        }

        [Fact]
        public void BhvSerialization021EqualContentComparesEqualAndHashesAlike()
        {
            var first = new Category { Id = 7, Name = "dogs" };
            var second = new Category { Id = 7, Name = "dogs" };
            var other = new Category { Id = 8, Name = "dogs" };
            Assert.Equal(first, second);
            Assert.Equal(first.GetHashCode(), second.GetHashCode());
            Assert.NotEqual(first, other);
        }
    }

    public class StrictWireFormatTests
    {
