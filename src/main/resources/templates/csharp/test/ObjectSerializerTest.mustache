        public void AllNullPropertiesProduceEmptyJsonObject()
        {
            var category = new Category { Id = null, Name = null };
            var json = _serializer.Serialize(category);
            Assert.Equal("{}", json);
        }

        [Fact]
        public void NonNullValuesArePreservedAlongsideOmittedNulls()
        {
