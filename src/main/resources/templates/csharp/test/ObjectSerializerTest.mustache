    public class DateTimeOffsetPreservationTests
    {
        [Fact]
        public void BhvSerializationobject174UtcDateTimeSerializesContainingDateTimeAndOffset()
        {
            var dt = DateTimeOffset.Parse("2024-01-01T12:30:45+00:00", CultureInfo.InvariantCulture);
            var result = ObjectSerializer.Stringify(dt);
            Assert.Contains("2024-01-01T12:30:45", result, StringComparison.Ordinal);
            Assert.True(result.Contains("+00:00", StringComparison.Ordinal) || result.EndsWith('Z'), $"should contain UTC offset: {result}");
        }

        [Fact]
        public void BhvSerializationobject116PositiveOffsetPreservedInSerializedString()
        {
            var dt = DateTimeOffset.Parse("2024-01-01T12:30:45+05:30", CultureInfo.InvariantCulture);
            var result = ObjectSerializer.Stringify(dt);
            Assert.Contains("+05:30", result, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerializationobject107NegativeOffsetPreservedInSerializedString()
        {
            var dt = DateTimeOffset.Parse("2024-01-01T12:30:45-08:00", CultureInfo.InvariantCulture);
            var result = ObjectSerializer.Stringify(dt);
            Assert.Contains("-08:00", result, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerializationobject199SubsecondsPreservedInSerializedDatetime()
        {
            var dt = DateTimeOffset.Parse("2024-01-01T12:30:45.123+00:00", CultureInfo.InvariantCulture);
            var result = ObjectSerializer.Stringify(dt);
            Assert.Contains(".123", result, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerializationobject044DateOnlySerializesAsIso8601DateWithoutTimeComponent()
        {
            var date = new DateOnly(2024, 1, 1);
            var result = ObjectSerializer.Stringify(date);
            Assert.Equal("2024-01-01", result);
        }

        [Fact]
        public void BhvSerializationobject150SerializedDatetimeStringEndsWithOffset()
        {
            var dt = new DateTimeOffset(2024, 1, 1, 12, 30, 45, TimeSpan.Zero);
            var result = ObjectSerializer.Stringify(dt);
            var hasOffset = result.EndsWith("+00:00", StringComparison.Ordinal) || result.EndsWith('Z');
            if (!hasOffset)
            {
                Assert.Matches(@"[+-]\d{2}:\d{2}$", result);
            }
        }

        [Fact]
        public void BhvSerializationobject144RoundTripDatetimeYieldsEquivalentInstant()
        {
            var original = DateTimeOffset.Parse("2024-01-01T12:30:45+05:30", CultureInfo.InvariantCulture);
            var serialized = ObjectSerializer.Stringify(original);
            var parsed = DateTimeOffset.Parse(serialized, CultureInfo.InvariantCulture);
            Assert.Equal(original.UtcDateTime, parsed.UtcDateTime);
        }

        /* Encoders previously truncated sub-second precision while the reader
         * accepted fractions, making the JSON round-trip lossy. The instant
         * 2020-01-02T03:04:05.123Z (UTC, millisecond precision) must serialize
         * WITH the ".123" fraction and deserialize back to the same instant.
         * Milliseconds (3 digits) are the cross-SDK common denominator every
         * native date-time type supports. */
        [Fact]
        public void BhvSerializationobject046DateTimeSerializationPreservesSubSecondPrecision()
        {
            var serializer = new ObjectSerializer();
            var instant = new DateTimeOffset(2020, 1, 2, 3, 4, 5, 123, TimeSpan.Zero);
            var metadata = new PhotoMetadata { TakenAt = instant };

            string json = serializer.Serialize(metadata);
            Assert.Contains(".123", json, StringComparison.Ordinal);

            var roundTripped = serializer.Deserialize<PhotoMetadata>(json);
            Assert.NotNull(roundTripped);
            Assert.Equal(instant, roundTripped!.TakenAt);
        }
    }

