    // The public (de)serialize entry points must never leak the native
    // System.Text.Json.JsonException to callers — they wrap it in the
    // SDK-owned SerializationException (preserving the native exception as
    // the inner exception), matching the other 11 language SDKs and keeping
    // internal serde types off the public surface.
    public class DeserializationErrorWrappingTests
    {
        private readonly ObjectSerializer _serializer = new();

        [Fact]
        public void BhvSerializationobject004DeserializeFailureCarriesTheCanonicalPrefixAndDetail()
        {
            // D15: `Failed to deserialize JSON: <detail>`, keeping the cause.
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>("{"));
            Assert.StartsWith("Failed to deserialize JSON: ", ex.Message, StringComparison.Ordinal);
            Assert.NotNull(ex.InnerException);
        }

        [Fact]
        public void BhvSerializationobject200SerializeFailureCarriesTheCanonicalPrefixAndDetail()
        {
            // D15: `Failed to serialize object to JSON: <detail>`.
            var ex = Assert.Throws<SerializationException>(() => _serializer.Serialize(double.NaN));
            Assert.StartsWith("Failed to serialize object to JSON: ", ex.Message, StringComparison.Ordinal);
        }

        [Fact]
        public void NestingBeyondTheDepthLimitIsRefusedBeforeParsing()
        {
            // D15: the SDK's own pre-scan reports the first depth over the cap.
            string json = new string('[', 1001) + new string(']', 1001);
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>(json));
            Assert.Equal("JSON nesting depth 1001 exceeds limit 1000", ex.Message);
        }

        [Fact]
        public void BhvSerialization024BracketsInsideStringsDoNotCountTowardsTheDepthLimit()
        {
            string json = "{\"name\":\"" + new string('[', 2000) + "\\\"[\"}";
            var category = _serializer.Deserialize<Category>(json);
            Assert.NotNull(category);
            Assert.Equal(2000, category!.Name!.TakeWhile(c => c == '[').Count());
        }

        [Fact]
        public void BhvSerializationobject170TruncatedJsonThrowsSerializationException()
        {
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>("{"));
            Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        }

        [Fact]
        public void BhvSerializationobject095InvalidJsonStructureThrowsSerializationException()
        {
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>("\"hello\""));
            Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        }

        [Fact]
        public void BhvSerializationobject180WrongPrimitiveTypeThrowsSerializationException()
        {
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Category>("{\"id\":\"not-a-number\",\"name\":\"Dogs\"}"));
            Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        }

        [Fact]
        public void BhvSerializationobject102MalformedDateTimeThrowsSerializationException()
        {
            // Order.shipDate is format: date-time; a value that is not an
            // RFC 3339 timestamp must fail with the SDK's SerializationException.
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Order>("{\"shipDate\":\"not-a-date\"}"));
            Assert.IsAssignableFrom<{{errorPrefix}}Exception>(ex);
        }

        [Fact]
        public void BhvSerializationobject089Int32OverflowThrowsSerializationException()
        {
            Assert.Throws<SerializationException>(() =>
                _serializer.Deserialize<Order>("{\"quantity\":3000000000}")
            );
        }

        [Fact]
        public void BhvSerializationobject120FractionalNumberForAnIntegerThrowsSerializationException()
        {
            Assert.Throws<SerializationException>(() =>
                _serializer.Deserialize<Order>("{\"quantity\":1.5}")
            );
            Assert.Throws<SerializationException>(() =>
                _serializer.Deserialize<Order>("{\"id\":1.5}")
            );
        }

        [Fact]
        public void BhvSerializationobject191Int64AboveTwoToThe53IsKeptExactly()
        {
            var order = _serializer.Deserialize<Order>("{\"id\":9007199254740993}");

            Assert.Equal(9007199254740993L, order!.Id);
            Assert.Contains("9007199254740993", _serializer.Serialize(order), StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerialization031Int32BoundariesRoundTrip()
        {
            var order = _serializer.Deserialize<Order>("{\"quantity\":2147483647}");

            Assert.Equal(int.MaxValue, order!.Quantity);
        }

        [Fact]
        public void BhvSerializationobject049RequiredNullableKeepsAnExplicitNull()
        {
            var model = _serializer.Deserialize<RequiredNullable>("{\"note\":null}");

            Assert.Null(model!.Note);
        }

        [Fact]
        public void BhvSerializationobject126RequiredNullableRejectsAMissingKey()
        {
            Assert.Throws<SerializationException>(() => _serializer.Deserialize<RequiredNullable>("{}"));
        }

        [Fact]
        public void BhvSerializationobject125RequiredNullableAlwaysWritesTheKey()
        {
            Assert.Equal("{\"note\":null}", _serializer.Serialize(new RequiredNullable(null)));
            Assert.Equal("{\"note\":\"x\"}", _serializer.Serialize(new RequiredNullable("x")));
        }

        [Fact]
        public void BhvSerializationobject218RequiredNullableWritesAGivenValueAsIs()
        {
            Assert.Equal("{\"note\":\"x\"}", _serializer.Serialize(new RequiredNullable("x")));
        }

        [Fact]
        public void BhvSerialization066NullIsKeptOnlyWhereTheNullableFieldIsDeclared()
        {
            var present = _serializer.Deserialize<RequiredNullable>("{\"note\":\"kept\"}");
            Assert.Equal("kept", present!.Note);

            Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Pet>("{\"name\":null,\"photoUrls\":[\"u\"]}"));
        }

        [Fact]
        public void BhvSerializationobject029ConstructingAModelWithANullRequiredValueDoesNotThrow()
        {
            // F316: a model checks nothing when it is built in code.
            var viaConstructor = new Account(null!);
            var viaInitializer = new Account { Username = null! };

            Assert.Null(viaConstructor.Username);
            Assert.Null(viaInitializer.Username);
        }

        [Fact]
        public void DecodingANullRequiredValueFailsLoudly()
        {
            // F316: the null is refused at decode, with the property named.
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Account>("{\"username\":null}"));

            Assert.Contains("username", ex.Message, StringComparison.Ordinal);
        }

        [Fact]
        public void ConstructingAModelWithAnUnknownEnumValueDoesNotThrow()
        {
            // F316: an enum value outside the declared set is only refused when decoded.
            var pet = new Pet("Rex", new HashSet<string>()) { Status = (Pet.StatusEnum)999 };

            Assert.Equal((Pet.StatusEnum)999, pet.Status);
        }

        [Fact]
        public void BhvSerializationobject182DecodingAnUnknownEnumStringFailsLoudly()
        {
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Pet>("{\"name\":\"Rex\",\"photoUrls\":[],\"status\":\"nonsense\"}"));

            Assert.Contains("nonsense", ex.Message, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvSerializationobject192AnUnknownEnumStringFailsAtDecode()
        {
            var ex = Assert.Throws<SerializationException>(
                () => _serializer.Deserialize<Order>("{\"id\":1,\"status\":\"nonsense\"}"));

            Assert.Contains("nonsense", ex.Message, StringComparison.Ordinal);
        }

        [Fact]
        public void BhvUnions042BuildingAUnionFromANullVariantDoesNotThrow()
        {
            var union = ReserveStockResponse.FromReservation(null!);

            Assert.Null(union.ActualInstance);
        }

        [Fact]
        public void BhvSerializationobject162ThrownSerializationExceptionHasMessage()
        {
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>("{"));
            Assert.NotNull(ex.Message);
        }

        [Fact]
        public void MalformedJsonDoesNotLeakNativeJsonException()
        {
            // The raw System.Text.Json.JsonException must never escape the
            // public deserialize entry point.
            var ex = Record.Exception(() => _serializer.Deserialize<Category>("{not valid json"));
            Assert.IsNotType<System.Text.Json.JsonException>(ex);
            Assert.IsType<SerializationException>(ex);
        }

        [Fact]
        public void BhvSerializationobject077SerializationExceptionPreservesNativeInnerException()
        {
            // The native JsonException is preserved as the inner exception so
            // callers who need the gory detail can still drill down.
            var ex = Assert.Throws<SerializationException>(() => _serializer.Deserialize<Category>("{"));
            Assert.NotNull(ex.InnerException);
            Assert.IsAssignableFrom<System.Text.Json.JsonException>(ex.InnerException);
        }
    }

