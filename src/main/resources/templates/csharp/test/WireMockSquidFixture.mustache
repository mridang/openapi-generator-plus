using DotNet.Testcontainers.Builders;
using DotNet.Testcontainers.Configurations;
using DotNet.Testcontainers.Containers;
using Xunit;

namespace Tests;

public class WireMockSquidFixture : IAsyncLifetime
{
    private IContainer _wiremock = null!;
    private IContainer _squid = null!;
    public string WireMockHttpsUrl { get; private set; } = string.Empty;
    public string WireMockHttpUrl { get; private set; } = string.Empty;
    public string ProxyUrl { get; private set; } = string.Empty;
    public string CaCertPath { get; private set; } = string.Empty;

    public async Task InitializeAsync()
    {
        var hostAppPath = Environment.GetEnvironmentVariable("HOST_APP_PATH") ?? Directory.GetCurrentDirectory();
        var keystorePath = Path.Combine(hostAppPath, "certs", "server-keystore.p12");
        var mappingsPath = Path.Combine(hostAppPath, "wiremock", "mappings");
        var squidConfPath = Path.Combine(hostAppPath, "proxy", "squid.conf");

        _wiremock = new ContainerBuilder()
            .WithImage("wiremock/wiremock:3.13.0")
            .WithPortBinding(8080, true)
            .WithPortBinding(8443, true)
            .WithBindMount(keystorePath, "/tmp/keystore.p12", AccessMode.ReadOnly)
            .WithBindMount(mappingsPath, "/home/wiremock/mappings", AccessMode.ReadOnly)
            .WithCommand(
                "--port", "8080",
                "--https-port", "8443",
                "--https-keystore", "/tmp/keystore.p12",
                "--keystore-type", "PKCS12",
                "--keystore-password", "changeit",
                "--key-manager-password", "changeit",
                "--verbose")
            .WithWaitStrategy(Wait.ForUnixContainer().UntilMessageIsLogged("port:"))
            .Build();

        _squid = new ContainerBuilder()
            .WithImage("ubuntu/squid:5.2-22.04_beta")
            .WithPortBinding(3128, true)
            .WithBindMount(squidConfPath, "/etc/squid/squid.conf", AccessMode.ReadOnly)
            .Build();

        await Task.WhenAll(_wiremock.StartAsync(), _squid.StartAsync());

        // Give Squid a moment to initialize
        await Task.Delay(3000);

        WireMockHttpsUrl = $"https://{_wiremock.Hostname}:{_wiremock.GetMappedPublicPort(8443)}";
        WireMockHttpUrl = $"http://{_wiremock.Hostname}:{_wiremock.GetMappedPublicPort(8080)}";
        ProxyUrl = $"http://{_squid.Hostname}:{_squid.GetMappedPublicPort(3128)}";
        CaCertPath = "/app/certs/ca.pem";
    }

    public async Task DisposeAsync()
    {
        await Task.WhenAll(_wiremock.DisposeAsync().AsTask(), _squid.DisposeAsync().AsTask());
    }
}

[CollectionDefinition("WireMockSquid")]
public class WireMockSquidTestGroup : ICollectionFixture<WireMockSquidFixture>
{
}
