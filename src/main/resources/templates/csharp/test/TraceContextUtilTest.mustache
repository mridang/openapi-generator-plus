    [Fact]
    public void BhvMisc002ACallerRegisteredPropagatorIsUsedAndExistingHeadersAreKept()
    {
        using var listener = new ActivityListener
        {
            ShouldListenTo = _ => true,
            Sample = (ref ActivityCreationOptions<ActivityContext> _) =>
                ActivitySamplingResult.AllDataAndRecorded,
        };
        ActivitySource.AddActivityListener(listener);

        using var source = new ActivitySource("test.trace");
        using var activity = source.StartActivity("TestOperation");
        Assert.NotNull(activity);

        DistributedContextPropagator previous = DistributedContextPropagator.Current;
        try
        {
            // A propagator that writes nothing: with an active activity, no
            // traceparent appears, which proves the caller's propagator was used.
            DistributedContextPropagator.Current = DistributedContextPropagator.CreateNoOutputPropagator();

            var headers = new Dictionary<string, string> { ["Authorization"] = "Bearer t" };
            TraceContextUtil.InjectTraceContext(headers);

            Assert.False(headers.ContainsKey("traceparent"));
            Assert.Equal("Bearer t", headers["Authorization"]);
        }
        finally
        {
            DistributedContextPropagator.Current = previous;
        }
    }

    [Fact]
    public void BhvTracing007ShouldNotModifyHeadersWhenNoActiveActivity()
    {
        Activity.Current = null;

        var headers = new Dictionary<string, string>();
        TraceContextUtil.InjectTraceContext(headers);

        Assert.Empty(headers);
    }

    [Fact]
    public void BhvTracing006ShouldInjectTraceparentWhenActivityIsActive()
    {
        using var listener = new ActivityListener
        {
            ShouldListenTo = _ => true,
            Sample = (ref ActivityCreationOptions<ActivityContext> _) =>
                ActivitySamplingResult.AllDataAndRecorded,
        };
        ActivitySource.AddActivityListener(listener);

        using var source = new ActivitySource("test.trace");
        using var activity = source.StartActivity("TestOperation");
        Assert.NotNull(activity);

        var headers = new Dictionary<string, string>();
        TraceContextUtil.InjectTraceContext(headers);

        Assert.True(headers.ContainsKey("traceparent"));
        string traceparent = headers["traceparent"];
        string[] parts = traceparent.Split('-');
        Assert.Equal(4, parts.Length);
        Assert.Equal("00", parts[0]);
        Assert.Equal(32, parts[1].Length);
        Assert.Equal(16, parts[2].Length);
        Assert.Equal(2, parts[3].Length);
    }

    [Fact]
    public void BhvTracing005ShouldIncludeTracestateWhenPresent()
    {
        using var listener = new ActivityListener
        {
            ShouldListenTo = _ => true,
            Sample = (ref ActivityCreationOptions<ActivityContext> _) =>
                ActivitySamplingResult.AllDataAndRecorded,
        };
        ActivitySource.AddActivityListener(listener);

        using var source = new ActivitySource("test.tracestate");
        using var activity = source.StartActivity("TestOperation");
        Assert.NotNull(activity);
        activity.TraceStateString = "congo=t61rcWkgMzE";

        var headers = new Dictionary<string, string>();
        TraceContextUtil.InjectTraceContext(headers);

        Assert.True(headers.ContainsKey("tracestate"));
        Assert.Equal("congo=t61rcWkgMzE", headers["tracestate"]);
    }

