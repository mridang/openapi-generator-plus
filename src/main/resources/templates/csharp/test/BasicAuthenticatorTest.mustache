using {{packageName}}.Auth;
using Xunit;

namespace Test;

public class BasicAuthenticatorTest
{
    [Fact]
    public void ValidCredentialsProduceBasicHeader()
    {
        var auth = new BasicAuthenticator("https://api.example.com", "alice", "s3cret");
        var headers = auth.GetAuthHeaders();
        Assert.Equal("Basic YWxpY2U6czNjcmV0", headers["Authorization"]);
    }

    [Fact]
    public void RejectsUsernameWithCrlf()
    {
        var auth = new BasicAuthenticator("https://api.example.com", "alice\r\n", "s3cret");
        Assert.Throws<ArgumentException>(() => auth.GetAuthHeaders());
    }

    [Fact]
    public void RejectsPasswordWithNul()
    {
        var auth = new BasicAuthenticator("https://api.example.com", "alice", "s3c\0ret");
        Assert.Throws<ArgumentException>(() => auth.GetAuthHeaders());
    }

    [Fact]
    public void RejectsUsernameWithColon()
    {
        var auth = new BasicAuthenticator("https://api.example.com", "ali:ce", "s3cret");
        Assert.Throws<ArgumentException>(() => auth.GetAuthHeaders());
    }
}
