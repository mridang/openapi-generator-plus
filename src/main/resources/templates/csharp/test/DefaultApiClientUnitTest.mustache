        var none = new Dictionary<string, string>();
        var now = DateTimeOffset.UtcNow;

        Assert.Equal(TimeSpan.FromSeconds(0.5), DefaultApiClient.RetryDelay(0, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(1), DefaultApiClient.RetryDelay(1, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(4), DefaultApiClient.RetryDelay(3, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(8), DefaultApiClient.RetryDelay(4, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(8), DefaultApiClient.RetryDelay(40, none, now, 0));
    }

    [Fact]
    public void BhvRetries030BackoffJitterTakesOffAtMostAQuarter()
    {
        var none = new Dictionary<string, string>();
        var now = DateTimeOffset.UtcNow;

        Assert.Equal(TimeSpan.FromSeconds(0.375), DefaultApiClient.RetryDelay(0, none, now, 1));
        Assert.Equal(TimeSpan.FromSeconds(6), DefaultApiClient.RetryDelay(9, none, now, 1));
    }

    [Fact]
    public void BhvRetries041BackoffStartsAtHalfASecondDoublesToEightAndTakesUpToAQuarterOff()
    {
        var none = new Dictionary<string, string>();
        var now = DateTimeOffset.UtcNow;

        Assert.Equal(TimeSpan.FromSeconds(0.5), DefaultApiClient.RetryDelay(0, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(1), DefaultApiClient.RetryDelay(1, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(8), DefaultApiClient.RetryDelay(4, none, now, 0));
        Assert.Equal(TimeSpan.FromSeconds(0.375), DefaultApiClient.RetryDelay(0, none, now, 1));
        Assert.Equal(TimeSpan.FromSeconds(6), DefaultApiClient.RetryDelay(4, none, now, 1));
    }

    [Fact]
    public void BhvRetries029AnUnreadableRetryAfterFallsBackToTheBackoff()
    {
        var now = DateTimeOffset.UtcNow;

        Assert.Equal(TimeSpan.FromSeconds(0.5), DefaultApiClient.RetryDelay(0, Header("soon"), now, 0));
        Assert.Equal(TimeSpan.FromSeconds(2), DefaultApiClient.RetryDelay(2, Header("not a date or a number"), now, 0));
    }

    [Fact]
    public void BhvRetries022RetryAfterAsAnHttpDateIsTheTimeUntilThatDate()
    {
        var wall = DateTimeOffset.UtcNow;
        var now = new DateTimeOffset(wall.Ticks - wall.Ticks % TimeSpan.TicksPerSecond, TimeSpan.Zero);
        var inThirtySeconds = now.AddSeconds(30).ToString("R", System.Globalization.CultureInfo.InvariantCulture);

        Assert.Equal(TimeSpan.FromSeconds(30), DefaultApiClient.RetryDelay(0, Header(inThirtySeconds), now, 0.5));
    }

    [Fact]
    public void BhvRetries023RetryAfterInSecondsOrAsADateIsHonouredAndCappedAtSixtySeconds()
    {
        var wall = DateTimeOffset.UtcNow;
        var now = new DateTimeOffset(wall.Ticks - wall.Ticks % TimeSpan.TicksPerSecond, TimeSpan.Zero);
        var inTenSeconds = now.AddSeconds(10).ToString("R", System.Globalization.CultureInfo.InvariantCulture);

        Assert.Equal(TimeSpan.FromSeconds(7), DefaultApiClient.RetryDelay(0, Header("7"), now, 0.5));
        Assert.Equal(TimeSpan.Zero, DefaultApiClient.RetryDelay(0, Header("0"), now, 0.5));
        Assert.Equal(TimeSpan.FromSeconds(60), DefaultApiClient.RetryDelay(0, Header("3600"), now, 0.5));
        Assert.Equal(TimeSpan.FromSeconds(10), DefaultApiClient.RetryDelay(0, Header(inTenSeconds), now, 0.5));
        Assert.Equal(
            TimeSpan.FromSeconds(0.5),
            DefaultApiClient.RetryDelay(0, Header("soon"), now, 0));
    }

    private static Dictionary<string, string> Header(string retryAfter) =>
        new() { ["retry-after"] = retryAfter };

    private sealed class SequenceHandler : HttpMessageHandler
    {
        private readonly Func<int, HttpResponseMessage> _respond;
        public List<string> Requests { get; } = [];
        public List<string?> Authorizations { get; } = [];
        public List<string> Bodies { get; } = [];
        public List<string?> RequestIds { get; } = [];

        public SequenceHandler(Func<int, HttpResponseMessage> respond)
        {
            _respond = respond;
        }

        protected override async Task<HttpResponseMessage> SendAsync(
            HttpRequestMessage request,
            CancellationToken cancellationToken)
        {
            Requests.Add(request.Method + " " + request.RequestUri);
            Authorizations.Add(request.Headers.Authorization?.ToString());
            RequestIds.Add(request.Headers.TryGetValues("X-Request-ID", out var ids) ? ids.FirstOrDefault() : null);
            Bodies.Add(request.Content == null ? "" : await request.Content.ReadAsStringAsync(cancellationToken));
            return _respond(Requests.Count - 1);
        }
    }

    private sealed class CapturingHandler : HttpMessageHandler
    {
        private readonly Func<HttpRequestMessage, Task> _onRequest;
        private readonly HttpStatusCode _statusCode;
        private readonly string _body;

        public CapturingHandler(
            Func<HttpRequestMessage, Task> onRequest,
            HttpStatusCode statusCode = HttpStatusCode.OK,
            string body = "{}"
        )
        {
            _onRequest = onRequest;
            _statusCode = statusCode;
            _body = body;
        }

        protected override async Task<HttpResponseMessage> SendAsync(
            HttpRequestMessage request,
            CancellationToken cancellationToken
        )
        {
            await _onRequest(request);
            return new HttpResponseMessage(_statusCode)
            {
                Content = new StringContent(_body),
            };
        }
    }

    private sealed class MockHandler : HttpMessageHandler
    {
        private readonly HttpStatusCode _statusCode;
        private readonly string _body;
        private readonly Dictionary<string, string> _headers;
        private readonly Dictionary<string, IEnumerable<string>> _multiValueHeaders;

        public MockHandler(
            HttpStatusCode statusCode,
            string body,
            Dictionary<string, string>? headers = null,
            Dictionary<string, IEnumerable<string>>? multiValueHeaders = null
        )
        {
            _statusCode = statusCode;
            _body = body;
            _headers = headers ?? [];
            _multiValueHeaders = multiValueHeaders ?? [];
        }

        protected override Task<HttpResponseMessage> SendAsync(
            HttpRequestMessage request,
            CancellationToken cancellationToken
        )
        {
            var response = new HttpResponseMessage(_statusCode)
            {
                Content = new StringContent(_body),
            };

            foreach (var header in _headers)
            {
                response.Headers.TryAddWithoutValidation(header.Key, header.Value);
            }

            foreach (var header in _multiValueHeaders)
            {
                response.Headers.TryAddWithoutValidation(header.Key, header.Value);
            }

            return Task.FromResult(response);
        }
    }
}

/// <summary>
/// A stand-in model part for the multipart serialization test above. It is
/// declared here rather than taken from the generated models so the test holds
/// for EVERY spec this SDK is generated from — no spec is guaranteed to contain
/// a model with these properties. It mirrors how the generator emits models:
/// the wire name lives in a [JsonPropertyName] attribute while the C# property
/// keeps PascalCase.
/// </summary>
public sealed class MultipartModelPart
{
    [System.Text.Json.Serialization.JsonPropertyName("isEnabled")]
    public bool? IsEnabled { get; set; }

    [System.Text.Json.Serialization.JsonPropertyName("recordedAt")]
    public DateTimeOffset? RecordedAt { get; set; }
}

/// <summary>
