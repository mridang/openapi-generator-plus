    [Fact]
    public async Task BhvMisc097AnArrayFieldIsOnePartPerElementInOrder()
    {
        string? wireText = null;
        var handler = new CapturingHandler(async req =>
        {
            wireText = await req.Content!.ReadAsStringAsync();
        });
        var client = new DefaultApiClient(new HttpClient(handler));
        await client.SendRequestAsync(
            "POST", new Uri("http://example.com/upload"), new Dictionary<string, string>(),
            new Dictionary<string, object> { { "tags", new[] { "a", "b" } }, { "name", "x" } });

        Assert.NotNull(wireText);
        Assert.Equal(2, System.Text.RegularExpressions.Regex.Matches(wireText, "name=\"tags\"").Count);
        Assert.Equal(1, System.Text.RegularExpressions.Regex.Matches(wireText, "name=\"name\"").Count);
        Assert.True(wireText.IndexOf("\r\n\r\na\r\n", StringComparison.Ordinal) < wireText.IndexOf("\r\n\r\nb\r\n", StringComparison.Ordinal));
    }

