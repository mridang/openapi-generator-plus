    [Fact]
    public async Task BhvTransport035ZlibWrappedDeflateBodyIsDecoded()
    {
        /* HTTP deflate is the zlib format (RFC 1950): the body must be decoded
           by the client, and the returned headers describe the decoded body, so
           Content-Encoding and Content-Length are dropped (D92). */
        byte[] compressed = CompressWith(
            sink => new System.IO.Compression.ZLibStream(
                sink, System.IO.Compression.CompressionLevel.Optimal),
            "{\"ok\":true}");
        var handler = new EncodedBodyHandler(
            HttpStatusCode.OK,
            compressed,
            contentEncoding: "deflate",
            contentType: "application/json");
        var client = new DefaultApiClient(new HttpClient(handler));

        var response = await client.SendRequestAsync(
            "GET",
            new Uri("http://example.com/deflate"),
            new Dictionary<string, string>(),
            null
        );

        Assert.Equal(200, response.StatusCode);
        Assert.Equal("{\"ok\":true}", response.Body);
        Assert.False(response.Headers.ContainsKey("content-encoding"));
        Assert.False(response.Headers.ContainsKey("content-length"));
    }

    [Fact]
    public async Task BhvTransport049RawDeflateBodySurfacesApiException()
    {
        /* A headerless RFC 1951 stream is not the HTTP deflate format and must
           raise the SDK's ApiException with the real status, never be decoded
           leniently or passed through still compressed. */
        byte[] raw = CompressWith(
            sink => new System.IO.Compression.DeflateStream(
                sink, System.IO.Compression.CompressionLevel.Optimal),
            "{\"ok\":true}");
        var handler = new EncodedBodyHandler(
            HttpStatusCode.OK,
            raw,
            contentEncoding: "deflate",
            contentType: "application/json");
        var client = new DefaultApiClient(new HttpClient(handler));

        var ex = await Assert.ThrowsAsync<ApiException>(() =>
            client.SendRequestAsync(
                "GET",
                new Uri("http://example.com/raw-deflate"),
                new Dictionary<string, string>(),
                null
            )
        );

        Assert.Contains("decompress", ex.Message, StringComparison.OrdinalIgnoreCase);
        Assert.Equal(200, ex.StatusCode);
        Assert.False(ex is {{packageName}}.Errors.NetworkException, "a corrupt body is not a network failure");
    }

    private static byte[] CompressWith(Func<Stream, Stream> wrap, string text)
    {
        using var sink = new MemoryStream();
        using (Stream encoder = wrap(sink))
        {
            byte[] bytes = Encoding.UTF8.GetBytes(text);
            encoder.Write(bytes, 0, bytes.Length);
        }
        return sink.ToArray();
    }

