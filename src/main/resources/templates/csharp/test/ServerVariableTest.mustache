using {{packageName}};
using Xunit;

namespace Test;

public class ServerVariableTest
{
    private static readonly string[] ExpectedEnumValues = ["v2", "v3"];
    private static readonly string[] ExpectedCopiedValues = ["api", "staging"];

    [Fact]
    public void BhvServers017ExposesDefaultValueDescriptionAndEnum()
    {
        var variable = new ServerVariable("v3", "API version", ["v2", "v3"]);

        Assert.Equal("v3", variable.DefaultValue);
        Assert.Equal("API version", variable.Description);
        Assert.Equal(ExpectedEnumValues, variable.EnumValues);
    }

    [Fact]
    public void BhvServers015AllowsNullDescription()
    {
        var variable = new ServerVariable("api", null, ["api", "staging"]);

        Assert.Null(variable.Description);
        Assert.Equal("api", variable.DefaultValue);
    }

    [Fact]
    public void BhvServers016AllowsEmptyEnum()
    {
        var variable = new ServerVariable("anything", null, []);

        Assert.Empty(variable.EnumValues);
    }

    [Fact]
    public void BhvServers018EnumValuesAreExposedForValidation()
    {
        var variable = new ServerVariable("v3", null, ["v2", "v3"]);

        Assert.Contains("v2", variable.EnumValues);
        Assert.Contains("v3", variable.EnumValues);
    }

    [Fact]
    public void BhvServers019EnumDoesNotContainAValueOutsideTheAllowedSet()
    {
        var variable = new ServerVariable("v3", null, ["v2", "v3"]);

        Assert.DoesNotContain("dev", variable.EnumValues);
    }

    [Fact]
    public void BhvServers024EnumValuesCannotBeMutated()
    {
        var variable = new ServerVariable("v3", null, ["v2", "v3"]);

        var values = Assert.IsAssignableFrom<IList<string>>(variable.EnumValues);
        Assert.Throws<NotSupportedException>(() => values.Add("dev"));
    }

    [Fact]
    public void BhvServers027RecordEqualityComparesByValue()
    {
        var first = new ServerVariable("v3", "API version", ["v2", "v3"]);
        var second = new ServerVariable("v3", "API version", ["v2", "v3"]);

        // Record equality is structural; the EnumValues lists are distinct
        // instances, so equality holds only when the values themselves match.
        Assert.Equal(first.DefaultValue, second.DefaultValue);
        Assert.Equal(first.Description, second.Description);
        Assert.Equal(first.EnumValues, second.EnumValues);
    }

    [Fact]
    public void BhvServers026CopiesTheCallersEnumListAtConstruction()
    {
        var allowed = new List<string> { "api", "staging" };
        var variable = new ServerVariable("api", null, allowed);

        allowed.Add("prod");
        allowed[0] = "changed";

        Assert.Equal(ExpectedCopiedValues, variable.EnumValues);
    }
}
