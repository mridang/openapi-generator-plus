using System.Collections;
using {{packageName}}.Errors;

namespace {{packageName}};

/// <summary>
/// Serializes parameter values for HTTP requests based on their location and format.
/// </summary>
/// <remarks>
/// Converts values into their string representations suitable for HTTP request
/// paths, query strings, and headers. Handles null values, collections with various
/// collection formats, and URL encoding.
/// </remarks>
internal static class ValueSerializer
{
    /// <summary>
    /// Serializes a value for use in an HTTP request parameter based on its location,
    /// schema type, and optional collection format.
    /// </summary>
    /// <param name="value">The value to serialize.</param>
    /// <param name="location">The parameter location (e.g. "query", "path", "header").</param>
    /// <param name="schemaType">The OpenAPI schema type of the parameter.</param>
    /// <param name="collectionFormat">
    /// The collection format for array parameters (e.g. "multi", "csv", "ssv", "tsv", "pipes").
    /// Defaults to <c>null</c>, which is treated as "csv".
    /// </param>
    /// <returns>
    /// The serialized value suitable for the given location, or <c>null</c> for query
    /// parameters with a null input value.
    /// </returns>
    {{! schemaType is part of the shared serializer signature (the style/typed
        overload below uses it); kept here for a uniform call shape even though
        this overload does not branch on it. IDE0060 is silenced in .editorconfig. }}
    public static object? Serialize(
        object? value,
        string location,
        string schemaType,
        string? collectionFormat = null
    )
    {
        if (value == null)
        {
            return location == "query" ? null : "";
        }

        if (AsArray(value) is { } list)
        {
            if (location == "query")
            {
                return collectionFormat switch
                {
                    "multi" => list.Cast<object>().Select(ObjectSerializer.Stringify).ToList(),
                    "ssv" => string.Join(" ", list.Cast<object>().Select(ObjectSerializer.Stringify)),
                    "tsv" => string.Join("\t", list.Cast<object>().Select(ObjectSerializer.Stringify)),
                    "pipes" => string.Join("|", list.Cast<object>().Select(ObjectSerializer.Stringify)),
                    _ => string.Join(",", list.Cast<object>().Select(ObjectSerializer.Stringify)),
                };
            }

            if (location == "header")
            {
                return string.Join(",", list.Cast<object>().Select(ObjectSerializer.Stringify));
            }
        }

        string str = ObjectSerializer.Stringify(value);

        return location == "path" ? EncodePathSegment(str) : str;
    }

    /* Returns the value as a list when it is an array-like parameter (a list
     * or a uniqueItems set), so both expand identically; strings, byte arrays
     * and dictionaries are scalars here. */
    private static IList? AsArray(object? value)
    {
        return value switch
        {
            null or string or byte[] or IDictionary => null,
            IList list => list,
            IEnumerable sequence => sequence.Cast<object>().ToList(),
            _ => null,
        };
    }

    /// <summary>
    /// Percent-encodes a value for use as a URL path segment, preserving
    /// the OAS 3.0 sub-delimiters used by matrix/label/simple styles
    /// (<c>; = , : @ ! $ &#38; ' ( ) * +</c>) and the unreserved characters.
    /// </summary>
    public static string EncodePathSegment(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }
        string encoded = Uri.EscapeDataString(value);
        return encoded
            .Replace("%21", "!", StringComparison.Ordinal)
            .Replace("%24", "$", StringComparison.Ordinal)
            .Replace("%26", "&", StringComparison.Ordinal)
            .Replace("%27", "'", StringComparison.Ordinal)
            .Replace("%28", "(", StringComparison.Ordinal)
            .Replace("%29", ")", StringComparison.Ordinal)
            .Replace("%2A", "*", StringComparison.Ordinal)
            .Replace("%2B", "+", StringComparison.Ordinal)
            .Replace("%2C", ",", StringComparison.Ordinal)
            .Replace("%3B", ";", StringComparison.Ordinal)
            .Replace("%3D", "=", StringComparison.Ordinal)
            .Replace("%40", "@", StringComparison.Ordinal)
            .Replace("%3A", ":", StringComparison.Ordinal);
    }

    /// <summary>
    /// Wraps a query value so the query-string builder preserves RFC 3986
    /// reserved characters (OAS <c>allowReserved: true</c>) instead of
    /// percent-encoding them. Produced by <see cref="MaybeAllowReserved"/> and
    /// unwrapped when the query string is assembled.
    /// </summary>
    /// <param name="Value">
    /// The serialized query value (a string, or a list of strings for exploded
    /// parameters).
    /// </param>
    public sealed record AllowReservedValue(object Value);

    /// <summary>
    /// Wraps <paramref name="value"/> in an <see cref="AllowReservedValue"/> when
    /// the parameter declares <c>allowReserved: true</c>; otherwise returns it
    /// unchanged.
    /// </summary>
    /// <param name="value">The serialized query value.</param>
    /// <param name="allowReserved">Whether the parameter preserves reserved characters.</param>
    /// <returns>The value, wrapped iff <paramref name="allowReserved"/> is true.</returns>
    public static object? MaybeAllowReserved(object? value, bool allowReserved)
    {
        if (value == null || !allowReserved)
        {
            return value;
        }
        return new AllowReservedValue(value);
    }

    /// <summary>
    /// Percent-encodes a query value while leaving RFC 3986 reserved characters
    /// literal (OAS <c>allowReserved: true</c>).
    /// </summary>
    /// <remarks>
    /// Everything that is not RFC 3986 reserved or unreserved — spaces, control
    /// characters, non-ASCII — is still percent-encoded, so the result is always
    /// a valid URL query segment. Only the characters RFC 3986 section 3.4
    /// permits in a query, <c>: / ? @ ! $ &#38; ' ( ) * + , ; =</c>, are restored
    /// after <see cref="Uri.EscapeDataString(string)"/> over-encodes them; <c>#</c>,
    /// <c>[</c> and <c>]</c> stay percent-encoded so a literal <c>#</c> can never
    /// start a fragment and truncate the query.
    /// </remarks>
    public static string EncodeQueryAllowingReserved(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }
        /* Existing %XX escapes are kept exactly as written: only the text between
           them is encoded, so a query that already carries %20 is not encoded
           a second time into %2520. */
        string[] parts = System.Text.RegularExpressions.Regex.Split(value, "(%[0-9A-Fa-f]{2})");
        var builder = new System.Text.StringBuilder(value.Length);
        for (int i = 0; i < parts.Length; i++)
        {
            builder.Append(i % 2 == 1 ? parts[i] : EncodeQueryText(parts[i]));
        }
        return builder.ToString();
    }

    private static string EncodeQueryText(string text)
    {
        string encoded = Uri.EscapeDataString(text);
        return encoded
            .Replace("%3A", ":", StringComparison.Ordinal)
            .Replace("%2F", "/", StringComparison.Ordinal)
            .Replace("%3F", "?", StringComparison.Ordinal)
            .Replace("%40", "@", StringComparison.Ordinal)
            .Replace("%21", "!", StringComparison.Ordinal)
            .Replace("%24", "$", StringComparison.Ordinal)
            .Replace("%26", "&", StringComparison.Ordinal)
            .Replace("%27", "'", StringComparison.Ordinal)
            .Replace("%28", "(", StringComparison.Ordinal)
            .Replace("%29", ")", StringComparison.Ordinal)
            .Replace("%2A", "*", StringComparison.Ordinal)
            .Replace("%2B", "+", StringComparison.Ordinal)
            .Replace("%2C", ",", StringComparison.Ordinal)
            .Replace("%3B", ";", StringComparison.Ordinal)
            .Replace("%3D", "=", StringComparison.Ordinal);;
    }

    /// <summary>
    /// Serializes a value using OAS 3.0 parameter style formatting.
    /// Handles matrix, label, form, simple, spaceDelimited, and pipeDelimited styles.
    /// </summary>
    /// <param name="paramName">The parameter name.</param>
    /// <param name="value">The value to serialize.</param>
    /// <param name="location">The parameter location (e.g. "path", "query", "header", "cookie").</param>
    /// <param name="schemaType">The OpenAPI schema type of the parameter.</param>
    /// <param name="collectionFormat">Legacy collection format (ignored when style is set).</param>
    /// <param name="style">The OAS 3.0 parameter style.</param>
    /// <param name="explode">Whether to use exploded format.</param>
    /// <returns>The styled serialized value, or null for query parameters with null input.</returns>
    public static object? SerializeStyled(
        string paramName,
        object? value,
        string location,
        string schemaType,
        string? collectionFormat,
        string? style,
        bool explode
    )
    {
        /* Path parameters are required components of the URL — accepting an
         * empty string would silently produce a malformed URL like
         * `/resource//details`, which most servers route to 404 instead of
         * surfacing the bug at the call site. The required-non-null check
         * lives in the operation method; here we catch the empty-string
         * case that slips through it. */
        if (location == "path" && value is string strValue && strValue.Length == 0)
        {
            throw new ArgumentException(
                $"Path parameter '{paramName}' must not be empty", nameof(value));
        }

        /* A simple-style path value of exactly '.' or '..' is a dot segment:
         * URL parsers resolve it (RFC 3986 section 5.2.4) and silently route
         * the request to a different endpoint, so it is refused before any
         * request. Matrix and label styles prefix the value and cannot form
         * a dot segment. */
        if (location == "path"
            && value is not null
            && AsArray(value) is null
            && (string.IsNullOrEmpty(style) || style == "simple"))
        {
            string segment = ObjectSerializer.Stringify(value);
            if (segment is "." or "..")
            {
                throw new ArgumentException(
                    $"Path parameter '{paramName}' must not be '.' or '..'", nameof(value));
            }
        }

        if (string.IsNullOrEmpty(style))
        {
            return Serialize(value, location, schemaType, collectionFormat);
        }

        if (value == null)
        {
            return location == "query" ? null : "";
        }

        List<string>? items = null;
        if (AsArray(value) is { } list)
        {
            items = [.. list.Cast<object>().Select(ObjectSerializer.Stringify)];
        }

        /* URL-encoding is applied for path parameters only. */
        string enc(string s) { return location == "path" ? EncodePathSegment(s) : s; }

        if (items == null && (DictionaryFields(paramName, value) ?? ModelFields(value)) is { } fields)
        {
            return SerializeObjectStyled(paramName, fields, style, explode, enc);
        }

        switch (style)
        {
            case "matrix":
                if (items != null)
                {
                    return explode
                        ? string.Join("", items.Select(i => ";" + paramName + "=" + enc(i)))
                        : ";" + paramName + "=" + string.Join(",", items.Select(enc));
                }
                return ";" + paramName + "=" + enc(ObjectSerializer.Stringify(value));

            case "label":
                if (items != null)
                {
                    return explode
                        ? "." + string.Join(".", items.Select(enc))
                        : "." + string.Join(",", items.Select(enc));
                }
                return "." + enc(ObjectSerializer.Stringify(value));

            case "form":
                if (items != null)
                {
                    return explode
                        ? items
                        : string.Join(",", items);
                }
                return ObjectSerializer.Stringify(value);

            case "spaceDelimited":
                if (items != null)
                {
                    return explode
                        ? items
                        : string.Join(" ", items.Select(enc));
                }
                return enc(ObjectSerializer.Stringify(value));

            case "pipeDelimited":
                if (items != null)
                {
                    return explode
                        ? items
                        : string.Join("|", items.Select(enc));
                }
                return enc(ObjectSerializer.Stringify(value));

            case "simple":
                if (items != null)
                {
                    return string.Join(",", items.Select(enc));
                }
                return enc(ObjectSerializer.Stringify(value));

            default:
                return Serialize(value, location, schemaType, collectionFormat);
        }
    }

    /// <summary>
    /// The wire fields of an exploded object-valued query parameter: each pair
    /// is written as its own <c>name=value</c> query entry under the property's
    /// own name, not under the parameter name.
    /// </summary>
    /// <param name="Fields">The property names mapped to their values, in declaration order.</param>
    public sealed record ExplodedFields(IReadOnlyList<KeyValuePair<string, string>> Fields);

    private static readonly ObjectSerializer FieldSerializer = new();

    /* A dictionary is an object-valued parameter like a model: its keys are
     * the wire names, in the dictionary's own order, and a null entry is left
     * out. A nested dictionary or list has no styled form and is refused. */
    private static List<KeyValuePair<string, string>>? DictionaryFields(string paramName, object value)
    {
        if (value is not IDictionary dictionary)
        {
            return null;
        }
        List<KeyValuePair<string, string>> fields = [];
        foreach (DictionaryEntry entry in dictionary)
        {
            if (entry.Value is IDictionary || (entry.Value is IEnumerable && entry.Value is not string && entry.Value is not byte[]))
            {
                throw new SerializationException(
                    "Parameter '" + paramName + "' holds a nested object or array, which a styled parameter cannot carry");
            }
            if (entry.Value is null)
            {
                continue;
            }
            fields.Add(
                new KeyValuePair<string, string>(
                    System.Convert.ToString(entry.Key, System.Globalization.CultureInfo.InvariantCulture) ?? "",
                    ObjectSerializer.Stringify(entry.Value)));
        }
        return fields;
    }

    /* A generated model (never an enum) is an object-valued parameter. Its
     * wire fields are the top-level JSON properties: strings unquoted, other
     * values as their JSON text, null properties omitted. */
    private static List<KeyValuePair<string, string>>? ModelFields(object value)
    {
        System.Type type = value.GetType();
        if (type.IsEnum || type.Namespace != "{{packageName}}.Models")
        {
            return null;
        }
        List<KeyValuePair<string, string>> fields = [];
        using System.Text.Json.JsonDocument document =
            System.Text.Json.JsonDocument.Parse(FieldSerializer.Serialize(value));
        if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return null;
        }
        foreach (System.Text.Json.JsonProperty property in document.RootElement.EnumerateObject())
        {
            if (property.Value.ValueKind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)
            {
                throw new SerializationException(
                    "Property '" + property.Name + "' holds a nested object or array, which a styled parameter cannot carry");
            }
            fields.Add(
                new KeyValuePair<string, string>(
                    property.Name,
                    property.Value.ValueKind == System.Text.Json.JsonValueKind.String
                        ? property.Value.GetString()!
                        : property.Value.GetRawText()));
        }
        return fields;
    }

    /* OAS 3 object serialization: exploded form and the delimited query
     * styles emit one entry per property, the other forms flatten to one
     * string (name,value pairs, or name=value pairs when exploded). */
    private static object SerializeObjectStyled(
        string paramName,
        List<KeyValuePair<string, string>> fields,
        string style,
        bool explode,
        Func<string, string> enc)
    {
        IEnumerable<string> pairs = fields.Select(f => enc(f.Key) + "=" + enc(f.Value));
        IEnumerable<string> flat = fields.SelectMany(f => new[] { enc(f.Key), enc(f.Value) });
        switch (style)
        {
            case "matrix":
                return explode
                    ? string.Concat(pairs.Select(p => ";" + p))
                    : ";" + paramName + "=" + string.Join(",", flat);
            case "label":
                return "." + (explode ? string.Join(".", pairs) : string.Join(",", flat));
            case "form":
                return explode ? new ExplodedFields(fields) : string.Join(",", flat);
            case "spaceDelimited":
                return explode ? new ExplodedFields(fields) : string.Join(" ", flat);
            case "pipeDelimited":
                return explode ? new ExplodedFields(fields) : string.Join("|", flat);
            default:
                return explode ? string.Join(",", pairs) : string.Join(",", flat);
        }
    }

    /// <summary>
    /// Serializes a deepObject-style query parameter.
    /// Produces a dictionary of flattened keys in the form <c>paramName[key]</c> to
    /// stringified values, suitable for inclusion in a query string.
    /// </summary>
    /// <param name="paramName">The parameter name (e.g. "filter").</param>
    /// <param name="value">The dictionary value to serialize.</param>
    /// <returns>A dictionary of expanded keys to serialized values.</returns>
    public static Dictionary<string, string> SerializeDeepObject(
        string paramName,
        IDictionary<string, object?>? value
    )
    {
        Dictionary<string, string> result = [];
        if (value == null)
        {
            return result;
        }

        foreach (KeyValuePair<string, object?> entry in value)
        {
            if (entry.Value == null)
            {
                continue;
            }
            result[$"{paramName}[{entry.Key}]"] = ObjectSerializer.Stringify(entry.Value);
        }

        return result;
    }

}
