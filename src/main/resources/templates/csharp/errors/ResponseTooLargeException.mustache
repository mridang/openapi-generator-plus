using System.Globalization;

namespace {{packageName}}.Errors;

/// <summary>
/// Exception for a buffered response whose body passed
/// <see cref="TransportOptions.MaxResponseBytes"/>, counting either the bytes on
/// the wire or the decompressed bytes. A response came back, so the status code
/// and the lower-cased headers are the real ones; the body is empty because it
/// was not read to the end. Only the SDK's own transport raises it, and it is
/// never retried.
/// </summary>
public class ResponseTooLargeException : ApiException
{
    /// <summary>The limit in bytes that the body passed.</summary>
    public long Limit { get; }

    /// <summary>A buffered response is never retried after it passed the limit.</summary>
    public override bool IsRetryable => false;

    public ResponseTooLargeException() { }

    public ResponseTooLargeException(string message)
        : base(message) { }

    public ResponseTooLargeException(string message, Exception innerException)
        : base(message, innerException) { }

    /// <summary>Creates the exception for a response of the given status that passed the limit.</summary>
    /// <param name="statusCode">The status code of the response.</param>
    /// <param name="limit">The limit in bytes that the body passed.</param>
    /// <param name="responseHeaders">The lower-cased response headers.</param>
    public ResponseTooLargeException(
        int statusCode,
        long limit,
        Dictionary<string, string>? responseHeaders
    )
        : base(
            statusCode,
            string.Create(
                CultureInfo.InvariantCulture,
                $"Response body exceeds the limit of {limit} bytes"),
            responseHeaders,
            string.Empty)
    {
        Limit = limit;
    }
}
