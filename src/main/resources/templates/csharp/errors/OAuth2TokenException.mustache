namespace {{packageName}}.Errors;

/// <summary>
/// Thrown when the OAuth2 token endpoint returns a 2xx response that cannot
/// be used: a body that is not a JSON object, or one whose
/// <c>access_token</c> field is missing or empty. Distinct from
/// <see cref="OAuth2ServerException"/> (which represents any non-2xx answer)
/// so callers can recover differently.
/// </summary>
/* CA1032: the parameterless constructor is unused. */
/* IDE0290: primary-constructor form makes the XML doc less natural. */
/* CA1032/IDE0290 are silenced project-wide in .editorconfig. */
public sealed class OAuth2TokenException : {{errorPrefix}}Exception
{
    /// <summary>Creates a new <see cref="OAuth2TokenException"/> with the given message.</summary>
    public OAuth2TokenException(string message) : base(message) { }

    /// <summary>Creates a new <see cref="OAuth2TokenException"/> with the given message and cause.</summary>
    public OAuth2TokenException(string message, Exception innerException)
        : base(message, innerException) { }
}
