namespace {{packageName}}.Errors;

/// <summary>
/// Exception for HTTP 429 Too Many Requests.
/// </summary>
public class TooManyRequestsException : ClientException
{
    public TooManyRequestsException()
        : this("Too Many Requests") { }

    public TooManyRequestsException(string message)
        : this(message, null, null, null) { }

    public TooManyRequestsException(string message, Exception innerException)
        : base(429, message, innerException) { }

    public TooManyRequestsException(
        string message,
        Dictionary<string, string>? responseHeaders = null,
        string? responseBody = null,
        object? errorBody = null
    )
        : base(429, message, responseHeaders, responseBody, errorBody) { }
}
