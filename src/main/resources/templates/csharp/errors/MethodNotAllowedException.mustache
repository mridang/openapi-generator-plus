namespace {{packageName}}.Errors;

/// <summary>
/// Exception for HTTP 405 Method Not Allowed.
/// </summary>
public class MethodNotAllowedException : ClientException
{
    public MethodNotAllowedException()
        : this("Method Not Allowed") { }

    public MethodNotAllowedException(string message)
        : this(message, null, null, null) { }

    public MethodNotAllowedException(string message, Exception innerException)
        : base(405, message, innerException) { }

    public MethodNotAllowedException(
        string message,
        Dictionary<string, string>? responseHeaders = null,
        string? responseBody = null,
        object? errorBody = null
    )
        : base(405, message, responseHeaders, responseBody, errorBody) { }
}
