{{>api_info}}

namespace {{packageName}}.Errors;

/// <summary>
/// Raised when a paged list cannot be followed safely: the server returned the cursor that was
/// just sent, so asking again would loop forever, or a <c>Link</c> header pointed to another
/// origin, so following it would send the credentials there. It is not a network error and not
/// an API error: it is a direct child of <see cref="{{errorPrefix}}Exception"/>, and the items
/// already delivered are complete and correct. A failed page request raises the SDK error of
/// that failure instead.
/// </summary>
public class PaginationException : {{errorPrefix}}Exception
{
    /// <summary>
    /// Initializes a new instance of the <see cref="PaginationException"/> class.
    /// </summary>
    public PaginationException() { }

    /// <summary>
    /// Initializes a new instance of the <see cref="PaginationException"/> class
    /// with a detail message.
    /// </summary>
    /// <param name="message">What made the list impossible to follow; it never holds a query string.</param>
    public PaginationException(string message)
        : base(message) { }

    /// <summary>
    /// Initializes a new instance of the <see cref="PaginationException"/> class
    /// with a detail message and the underlying cause.
    /// </summary>
    /// <param name="message">What made the list impossible to follow; it never holds a query string.</param>
    /// <param name="innerException">The underlying cause.</param>
    public PaginationException(string message, Exception innerException)
        : base(message, innerException) { }

    /// <summary>
    /// Initializes a new instance of the <see cref="PaginationException"/> class
    /// with a detail message and the path of the request whose response could not be followed.
    /// </summary>
    /// <param name="message">What made the list impossible to follow; it never holds a query string.</param>
    /// <param name="requestPath">The path of the request that returned the page, without its query.</param>
    public PaginationException(string message, string? requestPath)
        : base(message)
    {
        RequestPath = requestPath;
    }

    /// <summary>
    /// The path of the request whose response could not be followed, without its query, or null
    /// when it is not known.
    /// </summary>
    public string? RequestPath { get; }
}
