using System.Collections.ObjectModel;

namespace {{packageName}};

/// <summary>
/// Immutable HTTP transport configuration for <see cref="DefaultApiClient"/>.
///
/// Controls low-level HTTP behavior such as TLS verification, proxy routing,
/// timeouts, redirect handling, and automatic header injection. These settings
/// are independent of API-level concerns (base URL, authentication headers)
/// which belong in <see cref="Configuration"/>.
///
/// This class is immutable and thread-safe. Use <see cref="Builder"/> to create instances:
/// <code>
/// var transport = TransportOptions.Builder()
///     .VerifySsl(false)
///     .Proxy("http://proxy.example.com:8080")
///     .Timeout(5000)
///     .UserAgent("MyApp/1.0")
///     .Build();
/// </code>
/// </summary>
public sealed class TransportOptions
{
    /// <summary>
    /// Whether TLS certificate verification is enabled.
    /// When <c>true</c> (the default), the client verifies server certificates.
    /// When <c>false</c>, any certificate is accepted.
    /// </summary>
    public bool VerifySsl { get; }

    /// <summary>
    /// Path to a custom CA certificate bundle for TLS verification.
    /// When set together with <see cref="VerifySsl"/>=<c>true</c>, the client trusts
    /// certificates signed by this CA instead of the system trust store.
    /// <c>null</c> uses the system default.
    /// </summary>
    public string? CaCertPath { get; }

    /// <summary>
    /// HTTP or HTTPS proxy URL for all outbound requests.
    /// Example: <c>"http://proxy.corp.example.com:3128"</c>.
    /// <c>null</c> means direct connections.
    /// </summary>
    public string? Proxy { get; }

    /// <summary>
    /// End-to-end request timeout in milliseconds.
    /// Covers the entire request lifecycle: connection, TLS handshake,
    /// sending the request body, and reading the response.
    /// Defaults to <c>10000</c> ms (10 seconds). Pass <c>null</c> to disable
    /// the timeout (wait indefinitely).
    /// </summary>
    public int? Timeout { get; }

    /// <summary>
    /// Whether the client follows HTTP 3xx redirects automatically.
    /// <c>true</c> (the default) to follow redirects, <c>false</c> to return the
    /// redirect response as-is.
    /// </summary>
    public bool FollowRedirects { get; }

    /// <summary>
    /// Maximum number of consecutive redirects to follow.
    /// Only meaningful when <see cref="FollowRedirects"/> is <c>true</c>.
    /// <c>null</c> uses the HTTP client's built-in default.
    /// </summary>
    public int? MaxRedirects { get; }

    /// <summary>
    /// Custom <c>User-Agent</c> header value.
    /// When set, this value is sent as the <c>User-Agent</c> header on every request
    /// unless the caller explicitly provides one.
    /// <c>null</c> to omit.
    /// </summary>
    public string? UserAgent { get; }

    /// <summary>
    /// Transport-level default headers included in every request.
    /// These headers have the lowest priority: API-level headers from
    /// <see cref="Configuration.DefaultHeaders"/>, operation-specific headers,
    /// and authentication headers all take precedence.
    /// </summary>
    public IReadOnlyDictionary<string, string> DefaultHeaders { get; }

    /// <summary>
    /// Whether to auto-inject an <c>X-Request-ID</c> header with a unique UUID
    /// on every request. Useful for distributed tracing and log correlation.
    /// The header is only injected if the caller has not already set one.
    /// </summary>
    public bool InjectRequestId { get; }

    /// <summary>
    /// Creates a new <see cref="TransportOptions"/> with the specified values.
    /// </summary>
    internal TransportOptions(
        bool verifySsl,
        string? caCertPath,
        string? proxy,
        int? timeout,
        bool followRedirects,
        int? maxRedirects,
        string? userAgent,
        Dictionary<string, string> defaultHeaders,
        bool injectRequestId
    )
    {
        VerifySsl = verifySsl;
        CaCertPath = caCertPath;
        Proxy = proxy;
        Timeout = timeout;
        FollowRedirects = followRedirects;
        MaxRedirects = maxRedirects;
        UserAgent = userAgent;
        DefaultHeaders = new ReadOnlyDictionary<string, string>(
            new Dictionary<string, string>(defaultHeaders)
        );
        InjectRequestId = injectRequestId;
    }

    /// <summary>
    /// Create a new builder for constructing <see cref="TransportOptions"/> instances.
    /// </summary>
    /// <returns>A new builder with sensible defaults.</returns>
    public static TransportOptionsBuilder Builder()
    {
        return new TransportOptionsBuilder();
    }
}

/// <summary>
/// Builder for creating immutable <see cref="TransportOptions"/> instances.
///
/// All fields have sensible defaults:
/// <list type="bullet">
///   <item><description><c>VerifySsl</c> -- <c>true</c></description></item>
///   <item><description><c>FollowRedirects</c> -- <c>true</c></description></item>
///   <item><description><c>InjectRequestId</c> -- <c>false</c></description></item>
///   <item><description>All other fields -- <c>null</c> or empty</description></item>
/// </list>
/// </summary>
public sealed class TransportOptionsBuilder
{
    private bool _verifySsl = true;
    private string? _caCertPath;
    private string? _proxy;
    private int? _timeout = 10000;
    private bool _followRedirects = true;
    private int? _maxRedirects;
    private string? _userAgent = "{{userAgentDefault}}";
    private readonly Dictionary<string, string> _defaultHeaders = [];
    private bool _injectRequestId;

    /// <summary>Enable or disable TLS certificate verification.</summary>
    /// <param name="verifySsl"><c>true</c> to verify (default), <c>false</c> to skip.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder VerifySsl(bool verifySsl)
    {
        _verifySsl = verifySsl;
        return this;
    }

    /// <summary>Set the path to a custom CA certificate bundle.</summary>
    /// <param name="caCertPath">File path to a PEM-encoded CA certificate, or <c>null</c>.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder CaCertPath(string? caCertPath)
    {
        _caCertPath = caCertPath;
        return this;
    }

    /// <summary>Set the HTTP/HTTPS proxy URL.</summary>
    /// <param name="proxy">Proxy URL (e.g. <c>"http://proxy:3128"</c>), or <c>null</c>.</param>
    /// <returns>This builder.</returns>
    /// <exception cref="UriFormatException">Thrown when the proxy URL is not valid.</exception>
    public TransportOptionsBuilder Proxy(string? proxy)
    {
        if (proxy != null)
        {
            Uri uri = new(proxy);
            if (uri.Scheme is not "http" and not "https")
            {
                throw new UriFormatException(
                    $"Invalid proxy URL (must use http or https scheme): {proxy}");
            }
            if (string.IsNullOrEmpty(uri.Host))
            {
                throw new UriFormatException(
                    $"Invalid proxy URL (missing host): {proxy}");
            }
        }
        _proxy = proxy;
        return this;
    }

    /// <summary>Set the end-to-end request timeout in milliseconds.</summary>
    /// <param name="timeout">Timeout in milliseconds, or <c>null</c> for no timeout.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder Timeout(int? timeout)
    {
        _timeout = timeout;
        return this;
    }

    /// <summary>Enable or disable automatic redirect following.</summary>
    /// <param name="followRedirects"><c>true</c> to follow (default), <c>false</c> to stop.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder FollowRedirects(bool followRedirects)
    {
        _followRedirects = followRedirects;
        return this;
    }

    /// <summary>Set the maximum number of redirects to follow.</summary>
    /// <param name="maxRedirects">Maximum redirect hops, or <c>null</c> for client default.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder MaxRedirects(int? maxRedirects)
    {
        _maxRedirects = maxRedirects;
        return this;
    }

    /// <summary>Set a custom User-Agent header value.</summary>
    /// <param name="userAgent">The user agent string, or <c>null</c> to omit.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder UserAgent(string? userAgent)
    {
        _userAgent = userAgent;
        return this;
    }

    /// <summary>Add a single transport-level default header.</summary>
    /// <param name="name">Header name.</param>
    /// <param name="value">Header value.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder DefaultHeader(string name, string value)
    {
        _defaultHeaders[name] = value;
        return this;
    }

    /// <summary>Add multiple transport-level default headers.</summary>
    /// <param name="headers">Map of header names to values.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder DefaultHeaders(IEnumerable<KeyValuePair<string, string>> headers)
    {
        ArgumentNullException.ThrowIfNull(headers);
        foreach (KeyValuePair<string, string> header in headers)
        {
            _defaultHeaders[header.Key] = header.Value;
        }
        return this;
    }

    /// <summary>Enable or disable automatic <c>X-Request-ID</c> header injection.</summary>
    /// <param name="injectRequestId"><c>true</c> to inject, <c>false</c> to skip (default).</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder InjectRequestId(bool injectRequestId)
    {
        _injectRequestId = injectRequestId;
        return this;
    }

    /// <summary>Build and return an immutable <see cref="TransportOptions"/> instance.</summary>
    /// <returns>The configured transport options.</returns>
    public TransportOptions Build()
    {
        return new TransportOptions(
            verifySsl: _verifySsl,
            caCertPath: _caCertPath,
            proxy: _proxy,
            timeout: _timeout,
            followRedirects: _followRedirects,
            maxRedirects: _maxRedirects,
            userAgent: _userAgent,
            defaultHeaders: new Dictionary<string, string>(_defaultHeaders),
            injectRequestId: _injectRequestId
        );
    }
}
