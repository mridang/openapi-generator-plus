using System.Collections.ObjectModel;

namespace {{packageName}};

/// <summary>
/// Immutable HTTP transport configuration for <see cref="DefaultApiClient"/>.
///
/// Controls low-level HTTP behavior such as TLS verification, proxy routing,
/// timeouts, redirect handling, and automatic header injection. These settings
/// are independent of API-level concerns (base URL, authentication headers)
/// which belong in <see cref="Configuration"/>.
///
/// This class is immutable and thread-safe. Use <see cref="Builder"/> to create instances:
/// <code>
/// var transport = TransportOptions.Builder()
///     .VerifySsl(false)
///     .Proxy("http://proxy.example.com:8080")
///     .Timeout(5000)
///     .UserAgent("MyApp/1.0")
///     .Build();
/// </code>
/// </summary>
public sealed class TransportOptions
{
    /// <summary>
    /// Whether TLS certificate verification is enabled.
    /// When <c>true</c> (the default), the client verifies server certificates.
    /// When <c>false</c>, any certificate is accepted.
    /// </summary>
    public bool VerifySsl { get; }

    /// <summary>
    /// Path to a custom CA certificate bundle for TLS verification.
    /// When set together with <see cref="VerifySsl"/>=<c>true</c>, the client trusts
    /// only certificates that chain to the certificates in this file: it replaces the
    /// system trust store (to trust both, put the system bundle in the file). Host name
    /// verification still applies. <c>null</c> uses the system default.
    /// </summary>
    public string? CaCertPath { get; }

    /// <summary>
    /// HTTP or HTTPS proxy URL for all outbound requests.
    /// Example: <c>"http://proxy.corp.example.com:3128"</c>.
    /// <c>null</c> means direct connections.
    /// </summary>
    public string? Proxy { get; }

    /// <summary>
    /// End-to-end request timeout in milliseconds.
    /// Covers the entire request lifecycle: connection, TLS handshake,
    /// sending the request body, and reading the response.
    /// Defaults to <c>10000</c> ms (10 seconds). Pass <c>null</c> to disable
    /// the timeout (wait indefinitely).
    /// </summary>
    public int? Timeout { get; }

    /// <summary>
    /// Whether the client follows HTTP 3xx redirects automatically.
    /// <c>true</c> (the default) to follow redirects, <c>false</c> to return the
    /// redirect response as-is.
    /// </summary>
    public bool FollowRedirects { get; }

    /// <summary>
    /// Maximum number of consecutive redirects to follow.
    /// Only meaningful when <see cref="FollowRedirects"/> is <c>true</c>.
    /// <c>null</c> uses the HTTP client's built-in default.
    /// </summary>
    public int? MaxRedirects { get; }

    /// <summary>
    /// Custom <c>User-Agent</c> header value.
    /// When set, this value is sent as the <c>User-Agent</c> header on every request
    /// unless the caller explicitly provides one.
    /// <c>null</c> to omit.
    /// </summary>
    public string? UserAgent { get; }

    /// <summary>
    /// Transport-level default headers included in every request.
    /// These headers have the lowest priority: API-level headers from
    /// <see cref="Configuration.DefaultHeaders"/>, operation-specific headers,
    /// and authentication headers all take precedence.
    /// </summary>
    public IReadOnlyDictionary<string, string> DefaultHeaders { get; }

    /// <summary>
    /// Whether to auto-inject an <c>X-Request-ID</c> header with a unique UUID
    /// on every request. Useful for distributed tracing and log correlation.
    /// The header is only injected if the caller has not already set one.
    /// </summary>
    public bool InjectRequestId { get; }

    /// <summary>
    /// Client-level cancellation token. Cancelling it aborts every in-flight
    /// request of the client; it is linked with the per-call token of each
    /// operation, so either one cancels the request. Cancellation surfaces as
    /// <see cref="OperationCanceledException"/>, distinct from the timeout
    /// error. <c>default</c> (the default) never cancels.
    /// </summary>
    public CancellationToken CancellationToken { get; }

    /// <summary>
    /// Caller-supplied <see cref="System.Net.Http.HttpClient"/> that carries
    /// the requests, or <c>null</c> for the SDK's own client. The caller owns
    /// its lifecycle: the SDK never disposes it. SDK defaults (timeout,
    /// <c>User-Agent</c>, default headers, redirect policy) are applied on top.
    /// </summary>
    public HttpClient? HttpClient { get; }

    /// <summary>
    /// Caller-supplied <see cref="System.Net.Http.HttpMessageHandler"/>, or
    /// <c>null</c> for the SDK's own handler. The SDK wraps it in its own
    /// <see cref="System.Net.Http.HttpClient"/> and never disposes the handler:
    /// the caller owns its lifecycle.
    /// </summary>
    public HttpMessageHandler? HttpMessageHandler { get; }

    /// <summary>
    /// Maximum number of automatic retries of a failed request. Defaults to
    /// <c>2</c>; <c>0</c> disables retries. A retry is made on a network error
    /// that happened before a response arrived and on the statuses 408, 409,
    /// 429 and 500-599 (not 501), after an exponential backoff (0.5 s doubling
    /// to 8 s with 25% jitter) or the <c>Retry-After</c> the server sent (capped
    /// at 60 s). The retries never extend <see cref="Timeout"/>, and a stream or
    /// multipart body is never retried.
    /// </summary>
    public int MaxRetries { get; }

    /// <summary>
    /// Creates a new <see cref="TransportOptions"/> with the specified values.
    /// </summary>
    internal TransportOptions(
        bool verifySsl,
        string? caCertPath,
        string? proxy,
        int? timeout,
        bool followRedirects,
        int? maxRedirects,
        string? userAgent,
        Dictionary<string, string> defaultHeaders,
        bool injectRequestId,
        HttpClient? httpClient,
        HttpMessageHandler? httpMessageHandler,
        int maxRetries,
        CancellationToken cancellationToken
    )
    {
        MaxRetries = maxRetries;
        CancellationToken = cancellationToken;
        HttpClient = httpClient;
        HttpMessageHandler = httpMessageHandler;
        VerifySsl = verifySsl;
        CaCertPath = caCertPath;
        Proxy = proxy;
        Timeout = timeout;
        FollowRedirects = followRedirects;
        MaxRedirects = maxRedirects;
        UserAgent = userAgent;
        DefaultHeaders = new ReadOnlyDictionary<string, string>(
            new Dictionary<string, string>(defaultHeaders)
        );
        InjectRequestId = injectRequestId;
    }

    /// <summary>
    /// Create a new builder for constructing <see cref="TransportOptions"/> instances.
    /// </summary>
    /// <returns>A new builder with sensible defaults.</returns>
    public static TransportOptionsBuilder Builder()
    {
        return new TransportOptionsBuilder();
    }
}

/// <summary>
/// Builder for creating immutable <see cref="TransportOptions"/> instances.
///
/// All fields have sensible defaults:
/// <list type="bullet">
///   <item><description><c>VerifySsl</c> -- <c>true</c></description></item>
///   <item><description><c>FollowRedirects</c> -- <c>true</c></description></item>
///   <item><description><c>InjectRequestId</c> -- <c>false</c></description></item>
///   <item><description><c>MaxRetries</c> -- <c>2</c></description></item>
///   <item><description><c>Timeout</c> -- <c>10000</c> (10 seconds)</description></item>
///   <item><description><c>UserAgent</c> -- a package-specific default string</description></item>
///   <item><description>All other fields -- <c>null</c> or empty</description></item>
/// </list>
/// </summary>
public sealed class TransportOptionsBuilder
{
    private bool _verifySsl = true;
    private string? _caCertPath;
    private string? _proxy;
    private int? _timeout = 10000;
    private bool _followRedirects = true;
    private int? _maxRedirects;
    private string? _userAgent = "{{userAgentDefault}}";
    private readonly Dictionary<string, string> _defaultHeaders = [];
    private bool _injectRequestId;
    private int _maxRetries = 2;
    private CancellationToken _cancellationToken;
    private HttpClient? _httpClient;
    private HttpMessageHandler? _httpMessageHandler;

    /// <summary>Enable or disable TLS certificate verification.</summary>
    /// <param name="verifySsl"><c>true</c> to verify (default), <c>false</c> to skip.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder VerifySsl(bool verifySsl)
    {
        _verifySsl = verifySsl;
        return this;
    }

    /// <summary>Set the path to a custom CA certificate bundle.</summary>
    /// <param name="caCertPath">File path to a PEM-encoded CA certificate, or <c>null</c>.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder CaCertPath(string? caCertPath)
    {
        _caCertPath = caCertPath;
        return this;
    }

    /// <summary>Set the HTTP/HTTPS proxy URL.</summary>
    /// <param name="proxy">Proxy URL (e.g. <c>"http://proxy:3128"</c>), or <c>null</c>.</param>
    /// <returns>This builder.</returns>
    /// <remarks>The URL is validated by <see cref="Build"/>, not here.</remarks>
    public TransportOptionsBuilder Proxy(string? proxy)
    {
        _proxy = proxy;
        return this;
    }

    /// <summary>Set the end-to-end request timeout in milliseconds.</summary>
    /// <param name="timeout">Timeout in milliseconds, or <c>null</c> for no timeout.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder Timeout(int? timeout)
    {
        if (timeout is <= 0)
        {
            throw new ArgumentException(
                $"Invalid timeout: must be a positive number of milliseconds (got {timeout})",
                nameof(timeout)
            );
        }
        _timeout = timeout;
        return this;
    }

    /// <summary>Enable or disable automatic redirect following.</summary>
    /// <param name="followRedirects"><c>true</c> to follow (default), <c>false</c> to stop.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder FollowRedirects(bool followRedirects)
    {
        _followRedirects = followRedirects;
        return this;
    }

    /// <summary>Set the maximum number of redirects to follow.</summary>
    /// <param name="maxRedirects">Maximum redirect hops, or <c>null</c> for client default.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder MaxRedirects(int? maxRedirects)
    {
        if (maxRedirects is < 0)
        {
            throw new ArgumentException(
                $"Invalid maxRedirects: must not be negative (got {maxRedirects})",
                nameof(maxRedirects)
            );
        }
        _maxRedirects = maxRedirects;
        return this;
    }

    /// <summary>Set a custom User-Agent header value.</summary>
    /// <param name="userAgent">The user agent string, or <c>null</c> to omit.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder UserAgent(string? userAgent)
    {
        _userAgent = userAgent;
        return this;
    }

    /// <summary>Add a single transport-level default header.</summary>
    /// <param name="name">Header name.</param>
    /// <param name="value">Header value.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder DefaultHeader(string name, string value)
    {
        _defaultHeaders[name] = value;
        return this;
    }

    /// <summary>Add multiple transport-level default headers.</summary>
    /// <param name="headers">Map of header names to values.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder DefaultHeaders(IEnumerable<KeyValuePair<string, string>> headers)
    {
        ArgumentNullException.ThrowIfNull(headers);
        foreach (KeyValuePair<string, string> header in headers)
        {
            _defaultHeaders[header.Key] = header.Value;
        }
        return this;
    }

    /// <summary>Enable or disable automatic <c>X-Request-ID</c> header injection.</summary>
    /// <param name="injectRequestId"><c>true</c> to inject, <c>false</c> to skip (default).</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder InjectRequestId(bool injectRequestId)
    {
        _injectRequestId = injectRequestId;
        return this;
    }

    /// <summary>Set the maximum number of automatic retries.</summary>
    /// <param name="maxRetries">Retries after the first attempt; <c>0</c> disables retrying (default <c>2</c>).</param>
    /// <returns>This builder.</returns>
    /// <exception cref="ArgumentException">When <paramref name="maxRetries"/> is negative.</exception>
    public TransportOptionsBuilder MaxRetries(int maxRetries)
    {
        if (maxRetries < 0)
        {
            throw new ArgumentException(
                $"Invalid maxRetries: must not be negative (got {maxRetries})",
                nameof(maxRetries)
            );
        }
        _maxRetries = maxRetries;
        return this;
    }

    /// <summary>
    /// Set a client-level cancellation token. Cancelling it aborts every
    /// in-flight request of the client; it is linked with each call's own token.
    /// </summary>
    /// <param name="cancellationToken">The token to link with every call.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder CancellationToken(CancellationToken cancellationToken)
    {
        _cancellationToken = cancellationToken;
        return this;
    }

    /// <summary>
    /// Use a caller-supplied <see cref="System.Net.Http.HttpClient"/> as the
    /// transport. The SDK keeps its timeout, <c>User-Agent</c>, default
    /// headers and redirect policy on top, and never disposes the client: the
    /// caller owns its lifecycle. The client owns its proxy, TLS and
    /// connection pool, so combining it with <see cref="Proxy"/>,
    /// <see cref="CaCertPath"/> or <c>VerifySsl(false)</c> fails in
    /// <see cref="Build"/>. Disable automatic redirects on the client's handler
    /// so the SDK's redirect policy can apply.
    /// </summary>
    /// <param name="httpClient">The client, or <c>null</c> for the SDK's own.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder HttpClient(HttpClient? httpClient)
    {
        _httpClient = httpClient;
        return this;
    }

    /// <summary>
    /// Use a caller-supplied <see cref="System.Net.Http.HttpMessageHandler"/>
    /// as the transport. The SDK wraps it in its own client, keeps its timeout,
    /// <c>User-Agent</c>, default headers and redirect policy on top, and never
    /// disposes the handler. The handler owns its proxy, TLS and connection
    /// pool, so combining it with <see cref="Proxy"/>, <see cref="CaCertPath"/>
    /// or <c>VerifySsl(false)</c> fails in <see cref="Build"/>. A stock
    /// <see cref="System.Net.Http.HttpClientHandler"/> or
    /// <see cref="System.Net.Http.SocketsHttpHandler"/> must have
    /// <c>AllowAutoRedirect</c> turned off so the SDK's redirect policy can apply.
    /// </summary>
    /// <param name="httpMessageHandler">The handler, or <c>null</c> for the SDK's own.</param>
    /// <returns>This builder.</returns>
    public TransportOptionsBuilder HttpMessageHandler(HttpMessageHandler? httpMessageHandler)
    {
        _httpMessageHandler = httpMessageHandler;
        return this;
    }

    /// <summary>Build and return an immutable <see cref="TransportOptions"/> instance.</summary>
    /// <returns>The configured transport options.</returns>
    /// <exception cref="ArgumentException">
    /// Thrown when the proxy URL is not valid, or when a supplied client or
    /// handler conflicts with the SDK's own proxy, TLS or redirect settings.
    /// </exception>
    public TransportOptions Build()
    {
        if (_httpClient != null && _httpMessageHandler != null)
        {
            throw new ArgumentException(
                "Supply either an HttpClient or an HttpMessageHandler, not both.");
        }
        if (_httpClient != null || _httpMessageHandler != null)
        {
            string supplied = _httpClient != null ? "HttpClient" : "HttpMessageHandler";
            if (_proxy != null)
            {
                throw new ArgumentException(
                    $"A supplied {supplied} owns its proxy settings and conflicts with Proxy; configure the proxy on the {supplied}.");
            }
            if (_caCertPath != null || !_verifySsl)
            {
                throw new ArgumentException(
                    $"A supplied {supplied} owns its TLS settings and conflicts with CaCertPath/VerifySsl; configure TLS on the {supplied}.");
            }
            bool autoRedirects = _httpMessageHandler switch
            {
                HttpClientHandler h => h.AllowAutoRedirect,
                SocketsHttpHandler h => h.AllowAutoRedirect,
                _ => false,
            };
            if (autoRedirects)
            {
                throw new ArgumentException(
                    "The supplied HttpMessageHandler follows redirects itself, which conflicts with the SDK's redirect policy; set AllowAutoRedirect to false.");
            }
        }
        if (_proxy != null)
        {
            if (!Uri.TryCreate(_proxy, UriKind.Absolute, out Uri? uri))
            {
                throw new ArgumentException($"Invalid proxy URL: {RedactProxyUserInfo(_proxy)}", nameof(_proxy));
            }
            if (uri.Scheme is not "http" and not "https")
            {
                throw new ArgumentException(
                    $"Invalid proxy URL (must use http or https scheme): {RedactProxyUserInfo(_proxy)}", nameof(_proxy));
            }
            if (string.IsNullOrEmpty(uri.Host))
            {
                throw new ArgumentException(
                    $"Invalid proxy URL (missing host): {RedactProxyUserInfo(_proxy)}", nameof(_proxy));
            }
        }
        return new TransportOptions(
            verifySsl: _verifySsl,
            caCertPath: _caCertPath,
            proxy: _proxy,
            timeout: _timeout,
            followRedirects: _followRedirects,
            maxRedirects: _maxRedirects,
            userAgent: _userAgent,
            defaultHeaders: new Dictionary<string, string>(_defaultHeaders),
            injectRequestId: _injectRequestId,
            httpClient: _httpClient,
            httpMessageHandler: _httpMessageHandler,
            maxRetries: _maxRetries,
            cancellationToken: _cancellationToken
        );
    }

    /* The proxy URL may carry user:password, and a configuration error is
     * logged and reported, so the user info is shown as ***@ (F1086). */
    private static string RedactProxyUserInfo(string proxy)
    {
        int schemeEnd = proxy.IndexOf("://", StringComparison.Ordinal);
        int start = schemeEnd < 0 ? 0 : schemeEnd + 3;
        int length = proxy.AsSpan(start).IndexOfAny('/', '?', '#');
        int end = length < 0 ? proxy.Length : start + length;
        int at = proxy.AsSpan(start, end - start).LastIndexOf('@');
        return at < 0 ? proxy : $"{proxy[..start]}***@{proxy[(start + at + 1)..]}";
    }
}
