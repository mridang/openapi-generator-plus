using {{packageName}}.Errors;
using System.IO.Compression;
using System.Net;
using System.Security.Cryptography.X509Certificates;
using System.Text;

namespace {{packageName}};

/// <summary>
/// Default implementation of <see cref="IApiClient"/> using HttpClient.
///
/// Applies transport-level settings from <see cref="TransportOptions"/>: TLS
/// verification, custom CA certificates, proxy routing, timeouts, redirect
/// handling, <c>User-Agent</c> injection, <c>X-Request-ID</c> injection,
/// and transport-level default headers.
///
/// Header merge order (lowest to highest priority):
/// <list type="number">
///   <item><description><see cref="TransportOptions.DefaultHeaders"/> -- transport-level defaults</description></item>
///   <item><description>Caller-provided headers (from <see cref="Api.BaseApi"/> -- includes config defaults, auth, operation headers)</description></item>
///   <item><description><see cref="TransportOptions.UserAgent"/> -- injected if not already set</description></item>
///   <item><description><see cref="TransportOptions.InjectRequestId"/> -- injected if not already set</description></item>
/// </list>
/// </summary>
public sealed class DefaultApiClient : IApiClient, IDisposable
{
    static DefaultApiClient()
    {
        Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
    }

    /// <summary>
    /// Header names that MUST be stripped on every cross-origin redirect hop
    /// (Gap BH / Gap 3.1). The set covers the universal credential headers
    /// (<c>Authorization</c>, <c>Cookie</c>, <c>Proxy-Authorization</c>) and,
    /// in addition, every API-key header name declared in the OpenAPI spec
    /// — so a redirect to attacker-controlled origin cannot replay a custom
    /// header like <c>X-Api-Key</c> that the OAS marks as a security
    /// credential.
    ///
    /// Names are compared case-insensitively (RFC 7230 §3.2 — HTTP header
    /// names are tokens, case-insensitive).
    /// </summary>
    public static readonly IReadOnlySet<string> SensitiveHeaderNames =
        new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Authorization",
            "Cookie",
            "Proxy-Authorization",
            {{#apiKeyHeaderNames}}
            "{{name}}",
            {{/apiKeyHeaderNames}}
        };

    /* A header is dropped on a cross-origin hop when it is in the fixed set or
       its name says it carries a credential (key, token or secret), so a default
       header or a custom authenticator header is not replayed to another
       origin (F1093). */
    private static bool IsCredentialHeader(string name)
    {
        return SensitiveHeaderNames.Contains(name)
            || name.Contains("key", StringComparison.OrdinalIgnoreCase)
            || name.Contains("token", StringComparison.OrdinalIgnoreCase)
            || name.Contains("secret", StringComparison.OrdinalIgnoreCase);
    }

    private readonly HttpClient _httpClient;
    private readonly TransportOptions _transportOptions;

    /// <summary>
    /// The SDK's configured JSON serializer. A multipart JSON model part MUST
    /// be serialized through this — not a bare
    /// <see cref="System.Text.Json.JsonSerializer"/> call — so the part uses
    /// the identical options as the JSON-body path: the millisecond-precision
    /// <c>DateTimeOffset</c> converter, the protobuf-duration converter,
    /// null-property omission, and relaxed escaping. Without it a model part
    /// (e.g. a <c>format:date-time</c> field) would diverge from the body the
    /// same SDK sends on the JSON path, breaking cross-language wire parity.
    /// </summary>
    private readonly ObjectSerializer _serializer = new();

    /// <summary>
    /// Set once <see cref="Dispose"/> has been called. Guards against
    /// use-after-close: a request issued on a disposed client is a wrong call
    /// order, so it surfaces as <see cref="InvalidOperationException"/> rather
    /// than the <see cref="ObjectDisposedException"/> subclass leaked by the
    /// underlying HttpClient.
    /// </summary>
    private bool _closed;

    /// <summary>Guards <c>_closed</c>, <c>_inFlight</c> and <c>_transportReleased</c>.</summary>
    private readonly object _lifecycle = new();

    /// <summary>Requests that have started and not yet finished; closing waits for them.</summary>
    private int _inFlight;

    /// <summary>Set once the transport the SDK created has been released, so it is released once.</summary>
    private bool _transportReleased;

    /// <summary>The streams handed out and not yet ended; closing the client cancels them.</summary>
    private readonly HashSet<HttpBodyStream> _openStreams = [];

    /// <summary>The one error every request issued after the client was closed fails with.</summary>
    private const string ClosedMessage = "ApiClient has been closed and can no longer send requests";

    /// <summary>
    /// Whether this instance owns <c>_httpClient</c> and so disposes it. False
    /// when the caller supplied the client through
    /// <see cref="TransportOptions.HttpClient"/>: the caller owns its lifecycle.
    /// </summary>
    private bool _ownsHttpClient = true;

    /// <summary>
    /// The <c>Basic [base64]</c> Proxy-Authorization value extracted from
    /// userinfo embedded in the proxy URL, or <c>null</c> when no proxy
    /// credentials are configured. Exposed for tests and HTTP-aware
    /// authenticators that need to verify userinfo is propagated and
    /// not silently dropped (Gap AK).
    /// </summary>
    public string? ProxyAuthorizationHeader { get; }

    /// <summary>
    /// Builds a <c>Basic [base64]</c> Proxy-Authorization value from the
    /// userinfo embedded in the proxy URL, or returns <c>null</c> when no
    /// credentials are present. Percent-encoded userinfo is decoded before
    /// encoding.
    /// </summary>
    internal static string? BuildProxyAuthorizationHeader(string? proxyUrl)
    {
        if (string.IsNullOrEmpty(proxyUrl))
        {
            return null;
        }

        Uri proxyUri = new(proxyUrl);
        if (string.IsNullOrEmpty(proxyUri.UserInfo))
        {
            return null;
        }

        string[] parts = proxyUri.UserInfo.Split(':', 2);
        string user = Uri.UnescapeDataString(parts[0]);
        string pass = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
        string raw = $"{user}:{pass}";
        string encoded = Convert.ToBase64String(Encoding.UTF8.GetBytes(raw));
        return $"Basic {encoded}";
    }

    /// <summary>
    /// Create a client with default transport settings.
    /// Equivalent to <c>new DefaultApiClient(TransportOptions.Builder().Build())</c>.
    /// </summary>
    public DefaultApiClient()
        : this(TransportOptions.Builder().Build()) { }

    /// <summary>
    /// Create a client configured from the given <see cref="TransportOptions"/>.
    /// Applies proxy, custom CA certificate, TLS verification, timeout,
    /// redirect, and max-redirect settings to the underlying HttpClient.
    /// </summary>
    /// <param name="transportOptions">Transport configuration to apply.</param>
    /// <exception cref="ArgumentException">
    /// Thrown when the configured CA certificate cannot be read or parsed.
    /// </exception>
    public DefaultApiClient(TransportOptions transportOptions)
    {
        ArgumentNullException.ThrowIfNull(transportOptions);
        _transportOptions = transportOptions;

        if (transportOptions.Timeout is <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(transportOptions), "Timeout must be greater than zero");
        }

        if (transportOptions.HttpClient != null)
        {
            /* A caller-supplied client carries the requests; the caller owns
               its lifecycle, so Dispose never closes it. The SDK's timeout,
               headers, redirect policy and cancellation still apply in
               SendRequestAsync. */
            _httpClient = transportOptions.HttpClient;
            _ownsHttpClient = false;
            ProxyAuthorizationHeader = null;
            return;
        }

        if (transportOptions.HttpMessageHandler != null)
        {
            /* A caller-supplied handler is wrapped in the SDK's own client.
               The wrapper is ours to dispose; the handler stays the caller's
               (disposeHandler: false). */
            _httpClient = new HttpClient(transportOptions.HttpMessageHandler, disposeHandler: false);
            if (transportOptions.Timeout.HasValue)
            {
                _httpClient.Timeout = Timeout.InfiniteTimeSpan;
            }
            ProxyAuthorizationHeader = null;
            return;
        }

        HttpClientHandler handler = new()
        {
            AutomaticDecompression = DecompressionMethods.None,
            CheckCertificateRevocationList = true,
            /* Disable the default per-handler cookie jar so that a
               Set-Cookie returned by one request is not silently
               replayed on the next request. The other 11 SDKs are
               stateless by default; this brings C# into line so
               callers see consistent behavior across languages. */
            UseCookies = false,
        };

        if (transportOptions.CaCertPath != null)
        {
            {{! Gap T4: fail fast on a user-supplied CA cert that cannot be read or parsed rather than silently falling back to the system trust store. If the caller explicitly asked for SSL pinning we must not pretend it succeeded — validate the PEM eagerly. A bad CA file is a configuration mistake, so it surfaces as ArgumentException. }}
            X509Certificate2Collection caCerts = [];
            if (!System.IO.File.Exists(transportOptions.CaCertPath))
            {
                /* A missing file (or missing directory) is reported as a file-not-found
                 * cause naming the path, not as the platform's DirectoryNotFoundException. */
                System.IO.FileNotFoundException notFound = new(
                    $"Could not find CA certificate file \"{transportOptions.CaCertPath}\".",
                    transportOptions.CaCertPath);
                throw new ArgumentException(
                    $"failed to read CA certificate from \"{transportOptions.CaCertPath}\": {notFound.Message}",
                    nameof(transportOptions),
                    notFound);
            }
            try
            {
                /* Read the bundle as text and normalise CRLF to LF before parsing:
                 * a bundle written on Windows (or by keytool) must load the same
                 * as an LF one, and ImportFromPemFile does not accept CRLF. */
                string caPem = System.IO.File.ReadAllText(transportOptions.CaCertPath);
                caCerts.ImportFromPem(caPem.Replace("\r\n", "\n", StringComparison.Ordinal));
            }
            catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException)
            {
                throw new ArgumentException(
                    $"failed to read CA certificate from \"{transportOptions.CaCertPath}\": {ex.Message}",
                    nameof(transportOptions),
                    ex);
            }
            catch (System.Security.Cryptography.CryptographicException ex)
            {
                throw new ArgumentException(
                    $"failed to parse CA certificate from \"{transportOptions.CaCertPath}\": {ex.Message}",
                    nameof(transportOptions),
                    ex);
            }

            if (caCerts.Count == 0)
            {
                throw new ArgumentException(
                    $"failed to parse CA certificate from \"{transportOptions.CaCertPath}\": no PEM blocks found",
                    nameof(transportOptions));
            }
            if (transportOptions.VerifySsl)
            {
            handler.ServerCertificateCustomValidationCallback = (_, cert, serverChain, sslPolicyErrors) =>
            {
                /* The pinned CA replaces the system roots, but host name
                 * verification still applies: a certificate issued by the
                 * pinned CA for another host is rejected. */
                if (cert == null
                    || (sslPolicyErrors & System.Net.Security.SslPolicyErrors.RemoteCertificateNameMismatch) != 0)
                {
                    return false;
                }

                using X509Chain customChain = new();
                customChain.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;
                customChain.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;
                customChain.ChainPolicy.CustomTrustStore.AddRange(caCerts);
                /* The intermediates the server sent in its handshake are
                 * candidates for the path from the leaf to the pinned root. */
                if (serverChain != null)
                {
                    foreach (X509ChainElement element in serverChain.ChainElements)
                    {
                        customChain.ChainPolicy.ExtraStore.Add(element.Certificate);
                    }
                }
                return customChain.Build(cert);
            };
            }
        }
        if (!transportOptions.VerifySsl)
        {
            handler.ServerCertificateCustomValidationCallback =
                HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
        }

        if (transportOptions.Proxy != null)
        {
            {{! Parse user-info ("user:password@") out of the proxy URL so it is surfaced as a Proxy-Authorization basic-auth header rather than being silently dropped — see Gap #29 (proxy authentication propagation). }}
            Uri proxyUri = new(transportOptions.Proxy);
            WebProxy webProxy;
            if (!string.IsNullOrEmpty(proxyUri.UserInfo))
            {
                string[] parts = proxyUri.UserInfo.Split(':', 2);
                string user = Uri.UnescapeDataString(parts[0]);
                string pass = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
                UriBuilder stripped = new(proxyUri) { UserName = "", Password = "" };
                webProxy = new WebProxy(stripped.Uri)
                {
                    Credentials = new NetworkCredential(user, pass),
                };
            }
            else
            {
                webProxy = new WebProxy(proxyUri);
            }
            handler.Proxy = webProxy;
            handler.UseProxy = true;
        }
        else
        {
            /* TransportOptions.Proxy is the only proxy source: with none set
               the client connects directly and ignores HTTP_PROXY, NO_PROXY
               and the system proxy settings. */
            handler.UseProxy = false;
        }

        /* Gap AK: keep a Proxy-Authorization preview value alongside the
         * WebProxy.Credentials so tests (and any HTTP-aware authenticator)
         * can verify userinfo embedded in the proxy URL is propagated and
         * not silently dropped. */
        ProxyAuthorizationHeader = BuildProxyAuthorizationHeader(transportOptions.Proxy);

        /* Gap BH: HttpClient's AllowAutoRedirect re-sends Authorization /
           Cookie / Proxy-Authorization across cross-origin 3xx redirects by
           default, leaking bearer tokens to attacker-controlled hosts via
           malicious 302. Disable auto-redirect entirely; SendRequestAsync
           follows Location: headers manually with a same-origin check. */
        handler.AllowAutoRedirect = false;

        _httpClient = new HttpClient(handler, disposeHandler: true);

        if (transportOptions.Timeout.HasValue)
        {
            /* The timeout is one end-to-end budget enforced per call in
               SendRequestAsync, so HttpClient's own per-send timeout is off. */
            _httpClient.Timeout = Timeout.InfiniteTimeSpan;
        }
    }

    /// <summary>
    /// Create a client with a pre-configured HttpClient.
    /// Uses default <see cref="TransportOptions"/> for header injection settings.
    /// </summary>
    /// <param name="httpClient">The HTTP client to use.</param>
    internal DefaultApiClient(HttpClient httpClient)
    {
        _httpClient = httpClient;
        _ownsHttpClient = false;
        _transportOptions = TransportOptions.Builder().Build();
        ProxyAuthorizationHeader = null;
    }

    /// <summary>
    /// Create a client with a pre-configured HttpClient and explicit transport options.
    /// Use this overload in tests to supply a capturing or mock HttpClient together with
    /// specific <see cref="TransportOptions"/> (e.g. to test header injection behaviour).
    /// </summary>
    /// <param name="httpClient">The HTTP client to use.</param>
    /// <param name="transportOptions">Transport configuration to apply.</param>
    internal DefaultApiClient(HttpClient httpClient, TransportOptions transportOptions)
    {
        ArgumentNullException.ThrowIfNull(transportOptions);
        _httpClient = httpClient;
        _ownsHttpClient = false;
        _transportOptions = transportOptions;
        ProxyAuthorizationHeader = BuildProxyAuthorizationHeader(transportOptions.Proxy);
    }

    /// <inheritdoc/>
    public Task<ApiHttpResponse> SendRequestAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body
    )
    {
        return SendRequestAsync(method, url, headers, body, noRedirect: false);
    }

    /// <inheritdoc/>
    public Task<ApiHttpResponse> SendRequestAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect
    )
    {
        return SendRequestAsync(method, url, headers, body, noRedirect, CancellationToken.None);
    }

    /// <inheritdoc/>
    public Task<ApiHttpResponse> SendRequestAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        CancellationToken cancellationToken
    )
    {
        return SendRequestAsync(method, url, headers, body, noRedirect, null, cancellationToken);
    }

    /// <summary>The first backoff before a retry, doubled for each further retry.</summary>
    private const double InitialRetryDelaySeconds = 0.5;

    /// <summary>The ceiling of the exponential backoff, in seconds.</summary>
    private const double MaxRetryDelaySeconds = 8;

    /// <summary>The ceiling of a server-sent <c>Retry-After</c>, in seconds.</summary>
    private const double MaxRetryAfterSeconds = 60;

    /// <summary>Whether a status is worth another attempt: 408, 409, 429 and 500-599 except 501.</summary>
    internal static bool IsRetryableStatus(int status)
    {
        return status is 408 or 409 or 429 || (status is >= 500 and <= 599 and not 501);
    }

    /// <summary>
    /// The wait before retry number <paramref name="attempt"/> (0 for the first
    /// retry): the server's <c>Retry-After</c> (seconds or an HTTP date, capped
    /// at 60 s) when it sent a usable one, otherwise 0.5 s doubling to 8 s with
    /// up to 25% jitter taken off. <paramref name="jitter"/> is a sample in
    /// [0, 1).
    /// </summary>
    internal static TimeSpan RetryDelay(
        int attempt,
        IReadOnlyDictionary<string, string> responseHeaders,
        DateTimeOffset now,
        double jitter
    )
    {
        foreach (KeyValuePair<string, string> entry in responseHeaders)
        {
            if (!string.Equals(entry.Key, "Retry-After", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            if (ParseRetryAfter(entry.Value, now) is { } waited)
            {
                return waited;
            }
        }
        double backoff = Math.Min(
            InitialRetryDelaySeconds * Math.Pow(2, Math.Min(attempt, 16)),
            MaxRetryDelaySeconds
        );
        return TimeSpan.FromSeconds(backoff * (1 - 0.25 * jitter));
    }

    /// <summary>
    /// A <c>Retry-After</c> value (seconds or an HTTP date, capped at 60 s) as a wait, or null
    /// when it is not usable.
    /// </summary>
    internal static TimeSpan? ParseRetryAfter(string header, DateTimeOffset now)
    {
        string value = header.Trim();
        if (
            double.TryParse(
                value,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out double seconds
            )
            && double.IsFinite(seconds)
            && seconds >= 0
        )
        {
            return TimeSpan.FromSeconds(Math.Min(seconds, MaxRetryAfterSeconds));
        }
        if (
            DateTimeOffset.TryParse(
                value,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal,
                out DateTimeOffset date
            )
        )
        {
            double until = (date - now).TotalSeconds;
            return TimeSpan.FromSeconds(Math.Clamp(until, 0, MaxRetryAfterSeconds));
        }
        return null;
    }

    /// <summary>A random sample in [0, 1) for the backoff jitter.</summary>
    internal static double Jitter()
    {
        return System.Security.Cryptography.RandomNumberGenerator.GetInt32(0, 1000) / 1000d;
    }

    /// <summary>
    /// Whether the body can be sent again: text, bytes and a replayable <see cref="BodySource"/>,
    /// never a stream, a single-use <see cref="BodySource"/> or multipart.
    /// </summary>
    private static bool IsReplayableBody(object? body)
    {
        return body is null or string or byte[] or BodySource { IsReplayable: true };
    }

    /// <summary>Whether a request may be sent again after the connection dropped before any response.</summary>
    private static bool IsIdempotent(string method)
    {
        return method.ToUpperInvariant() is "GET" or "HEAD" or "OPTIONS" or "TRACE" or "PUT" or "DELETE" or "QUERY";
    }

    /// <summary>Whether a transport failure came from TLS or certificate validation, which a retry cannot fix.</summary>
    private static bool IsTlsFailure(Exception ex)
    {
        for (Exception? current = ex; current != null; current = current.InnerException)
        {
            if (current is System.Security.Authentication.AuthenticationException)
            {
                return true;
            }
        }
        return false;
    }

    /// <summary>Tells the retry loop whether a response had started to arrive.</summary>
    private sealed class AttemptState
    {
        public bool ResponseReceived { get; set; }
    }

    /// <inheritdoc/>
    public Task<ApiHttpResponse> SendRequestAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        Func<Task<Dictionary<string, string>>>? refreshHeaders,
        CancellationToken cancellationToken
    )
    {
        return SendRequestAsync(
            method, url, headers, body, noRedirect, refreshHeaders, null, null, cancellationToken);
    }

    /// <inheritdoc/>
    public async Task<ApiHttpResponse> SendRequestAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        Func<Task<Dictionary<string, string>>>? refreshHeaders,
        int? timeout,
        int? maxRetries,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(method);
        ArgumentNullException.ThrowIfNull(url);
        ArgumentNullException.ThrowIfNull(headers);

        /* A request is counted in before it starts, so closing the client lets
           it finish; a request that arrives after closing fails with the one
           closed error and never reaches the transport. */
        EnterCall();
        try
        {
            return await SendCountedAsync(
                    method, url, headers, body, noRedirect, refreshHeaders, timeout, maxRetries, cancellationToken)
                .ConfigureAwait(false);
        }
        finally
        {
            ExitCall();
        }
    }

    /// <summary>Counts a call in, or refuses it with the one closed error when the client was closed.</summary>
    private void EnterCall()
    {
        lock (_lifecycle)
        {
            if (_closed)
            {
                throw new InvalidOperationException(ClosedMessage);
            }
            _inFlight++;
        }
    }

    /// <summary>Counts a call out; the last one out of a closed client releases the transport.</summary>
    private void ExitCall()
    {
        bool release;
        lock (_lifecycle)
        {
            _inFlight--;
            release = _closed && _inFlight == 0 && !_transportReleased;
            _transportReleased |= release;
        }
        if (release && _ownsHttpClient)
        {
            _httpClient.Dispose();
        }
    }

    private Task<ApiHttpResponse> SendCountedAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        Func<Task<Dictionary<string, string>>>? refreshHeaders,
        int? timeout,
        int? maxRetries,
        CancellationToken cancellationToken
    )
    {
        return SendWithRetriesAsync(
            method,
            url,
            headers,
            body,
            refreshHeaders,
            timeout,
            maxRetries,
            (attemptHeaders, timeoutSource, state, timeoutToken) =>
                SendAttemptAsync(
                    method, url, attemptHeaders, body, noRedirect, timeoutSource, state, timeoutToken),
            result => result.StatusCode,
            result => result.Headers,
            _ => { },
            cancellationToken);
    }

    /// <summary>
    /// The one retry loop of a buffered and of a streaming call: the attempts, the
    /// backoff and the single timeout budget are the same, and only what one attempt
    /// returns differs. <paramref name="discard"/> releases a retryable response
    /// that is not returned because another attempt follows.
    /// </summary>
    private async Task<T> SendWithRetriesAsync<T>(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        Func<Task<Dictionary<string, string>>>? refreshHeaders,
        int? timeout,
        int? maxRetries,
        Func<Dictionary<string, string>, CancellationTokenSource?, AttemptState, CancellationToken, Task<T>> send,
        Func<T, int> statusOf,
        Func<T, IReadOnlyDictionary<string, string>> headersOf,
        Action<T> discard,
        CancellationToken cancellationToken
    )
    {
        cancellationToken.ThrowIfCancellationRequested();

        if (!url.IsAbsoluteUri)
        {
            throw new ArgumentException($"Request URL must be absolute: {url}", nameof(url));
        }

        /* One budget for every attempt, hop and the body read: a single token
           created here is shared by each send, so neither a redirect chain nor
           a retry can reset it. */
        int? effectiveTimeout = timeout ?? _transportOptions.Timeout;
        int effectiveMaxRetries = maxRetries ?? _transportOptions.MaxRetries;
        using CancellationTokenSource? timeoutSource = effectiveTimeout.HasValue
            ? new CancellationTokenSource(TimeSpan.FromMilliseconds(effectiveTimeout.Value))
            : null;
        /* The caller's per-call token and the client-level token from
           TransportOptions are linked with the timeout, so any of the three
           aborts the in-flight request. Only the timeout source maps to the
           timeout error; a caller or client cancellation propagates as
           OperationCanceledException. */
        using CancellationTokenSource linkedSource = CancellationTokenSource.CreateLinkedTokenSource(
            timeoutSource?.Token ?? CancellationToken.None,
            _transportOptions.CancellationToken,
            cancellationToken);
        CancellationToken timeoutToken = linkedSource.Token;

        System.Diagnostics.Stopwatch elapsed = System.Diagnostics.Stopwatch.StartNew();
        Dictionary<string, string> attemptHeaders = headers;
        bool canRetry = effectiveMaxRetries > 0 && IsReplayableBody(body);
        int attempt = 0;
        while (true)
        {
            AttemptState state = new();
            TimeSpan delay;
            try
            {
                T result = await send(attemptHeaders, timeoutSource, state, timeoutToken)
                    .ConfigureAwait(false);
                if (
                    !canRetry
                    || attempt >= effectiveMaxRetries
                    || !IsRetryableStatus(statusOf(result))
                )
                {
                    return result;
                }
                delay = RetryDelay(attempt, headersOf(result), DateTimeOffset.UtcNow, Jitter());
                if (!FitsBudget(elapsed, delay, effectiveTimeout))
                {
                    return result;
                }
                discard(result);
            }
            catch (Errors.NetworkException ex) when (
                canRetry
                && attempt < effectiveMaxRetries
                && !state.ResponseReceived
                && ex is not Errors.NetworkTimeoutException
                && IsIdempotent(method)
                && !IsTlsFailure(ex)
            )
            {
                delay = RetryDelay(
                    attempt,
                    new Dictionary<string, string>(),
                    DateTimeOffset.UtcNow,
                    Jitter());
                if (!FitsBudget(elapsed, delay, effectiveTimeout))
                {
                    throw;
                }
            }

            try
            {
                await Task.Delay(delay, timeoutToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException ex) when (timeoutSource?.IsCancellationRequested == true)
            {
                throw new Errors.NetworkTimeoutException("Request timed out", ex);
            }
            attempt++;
            /* Every retry is a fresh request: the headers are rebuilt, so a
               token that went stale while waiting is fetched again. */
            if (refreshHeaders != null)
            {
                attemptHeaders = await refreshHeaders().ConfigureAwait(false);
            }
        }
    }

    /// <summary>Whether waiting <paramref name="delay"/> still leaves time inside the end-to-end timeout.</summary>
    private static bool FitsBudget(
        System.Diagnostics.Stopwatch elapsed,
        TimeSpan delay,
        int? effectiveTimeout
    )
    {
        return !effectiveTimeout.HasValue
            || elapsed.Elapsed + delay < TimeSpan.FromMilliseconds(effectiveTimeout.Value);
    }

    /// <summary>
    /// Sends one attempt, follows its redirects and returns the response as soon as
    /// the final headers are in. With <see cref="HttpCompletionOption.ResponseContentRead"/>
    /// the body has been read as well; with
    /// <see cref="HttpCompletionOption.ResponseHeadersRead"/> it is still open.
    /// </summary>
    private async Task<HttpResponseMessage> OpenResponseAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        HttpCompletionOption completion,
        CancellationTokenSource? timeoutSource,
        AttemptState state,
        CancellationToken timeoutToken
    )
    {
        /* Field names are case-insensitive (RFC 9110 section 5.1), so a caller
         * header replaces a default of the same name whatever its casing and
         * both are never sent as two headers. */
        Dictionary<string, string> mergedHeaders = new(StringComparer.OrdinalIgnoreCase);
        /* A no-redirect request is the OAuth2 token POST, which goes to the
         * authorization server and not to the API: the caller's default
         * headers (an Authorization or API-key header meant for the API) are
         * not sent there. */
        if (!noRedirect)
        {
            foreach (KeyValuePair<string, string> header in _transportOptions.DefaultHeaders)
            {
                mergedHeaders[header.Key] = header.Value;
            }
        }
        foreach (KeyValuePair<string, string> header in headers)
        {
            _ = mergedHeaders.Remove(header.Key);
            mergedHeaders[header.Key] = header.Value;
        }

        /* Field names are case-insensitive (RFC 9110 section 5.1): a caller
         * header in any casing wins and is left exactly as written. */
        if (_transportOptions.UserAgent != null && !HasHeader(mergedHeaders, "User-Agent"))
        {
            mergedHeaders["User-Agent"] = _transportOptions.UserAgent;
        }

        if (_transportOptions.InjectRequestId && !HasHeader(mergedHeaders, "X-Request-ID"))
        {
            mergedHeaders["X-Request-ID"] = Guid.NewGuid().ToString();
        }

        if (!HasHeader(mergedHeaders, "Accept-Encoding"))
        {
            mergedHeaders["Accept-Encoding"] = SupportedEncodings();
        }

        /* A CR or LF in a header value would let the value end the header and
           inject another one, so the request is refused before it is built. */
        foreach (KeyValuePair<string, string> header in mergedHeaders)
        {
            if (header.Value.IndexOfAny(['\r', '\n', '\0']) >= 0)
            {
                throw new ArgumentException($"Header {header.Key} must not contain CR, LF or NUL characters", nameof(headers));
            }
        }

        using HttpRequestMessage request = new(new HttpMethod(method), url);

        string? contentType = null;
        foreach (KeyValuePair<string, string> header in mergedHeaders)
        {
            if (string.Equals(header.Key, "Content-Type", StringComparison.OrdinalIgnoreCase))
            {
                contentType = header.Value;
            }
            else
            {
                _ = request.Headers.TryAddWithoutValidation(header.Key, header.Value);
            }
        }

        /* A malformed Content-Type is a caller mistake: reject it here as an
           ArgumentException instead of letting the content constructors below
           leak a raw FormatException. */
        if (contentType != null && !System.Net.Http.Headers.MediaTypeHeaderValue.TryParse(contentType, out _))
        {
            throw new ArgumentException($"Invalid Content-Type header value: {contentType}", nameof(headers));
        }

        if (body != null)
        {
            request.Content = body switch
            {
                BodySource source => ContentOf(source),
                byte[] bytes => new ByteArrayContent(bytes),
                Stream stream => new StreamContent(new CallerOwnedStream(stream)),
                Dictionary<string, object> formParts => BuildMultipartContent(formParts, _serializer),
                string text => CreateStringContent(text, contentType ?? "application/json"),
                _ => CreateStringContent(body.ToString() ?? "", contentType ?? "application/json"),
            };

            if (
                contentType != null
                && body is not Dictionary<string, object>
                && body is not string
            )
            {
                /* Apply the declared Content-Type to byte[]/Stream bodies. Both
                 * ByteArrayContent and StreamContent default their ContentType to
                 * null, so a format:binary body (e.g. image/jpeg) would otherwise
                 * go on the wire with NO Content-Type header — the declared type
                 * silently discarded. We must NOT gate this on the header being
                 * non-null, and we must NOT JSON-marshal/base64 the bytes: the raw
                 * stream is sent verbatim with the declared Content-Type preserved.
                 * StringContent (text) and multipart (Dictionary) set their own
                 * Content-Type and are excluded above. */
                request.Content.Headers.ContentType =
                    System.Net.Http.Headers.MediaTypeHeaderValue.Parse(contentType);
            }
        }
        else if (
            string.Equals(method, "POST", StringComparison.OrdinalIgnoreCase)
            || string.Equals(method, "PUT", StringComparison.OrdinalIgnoreCase)
            || string.Equals(method, "PATCH", StringComparison.OrdinalIgnoreCase)
        )
        {
            /* Some servers / WAFs treat POST/PUT/PATCH with no body and
             * no Content-Length as malformed (411 Length Required) or
             * behave inconsistently. Attach an empty ByteArrayContent so
             * HttpClient emits an explicit `Content-Length: 0` header,
             * matching Kotlin's `ByteArray(0)` and the other 11 SDKs.
             * Clear the auto-inserted Content-Type since we have no
             * actual body content. */
            ByteArrayContent emptyContent = new([]);
            emptyContent.Headers.ContentType = null;
            request.Content = emptyContent;
        }

        /* A 307/308 redirect replays the body, but a multipart (Dictionary) or
         * Stream body is built lazily and read to the end by the first send, so
         * it cannot be rebuilt for the follow-up hop. When redirects will be
         * followed, buffer such a body once into bytes and keep its
         * Content-Type (multipart carries its boundary there), then send that
         * buffered copy on every hop so each hop carries identical bytes. */
        byte[]? replayBytes = null;
        System.Net.Http.Headers.MediaTypeHeaderValue? replayType = null;
        if (
            request.Content != null
            && (body is Dictionary<string, object> || body is Stream)
            && _transportOptions.FollowRedirects
            && !noRedirect
        )
        {
            replayBytes = await request.Content.ReadAsByteArrayAsync(timeoutToken).ConfigureAwait(false);
            replayType = request.Content.Headers.ContentType;
            request.Content.Dispose();
            request.Content = CreateReplayContent(replayBytes, replayType);
        }

        HttpResponseMessage response;
        try
        {
            response = await _httpClient
                .SendAsync(request, completion, timeoutToken)
                .ConfigureAwait(false);
            state.ResponseReceived = true;

            /* Gap BH: manual redirect loop with cross-origin sensitive-header strip.
               Gap 3.2: when noRedirect is set the loop is skipped entirely so a
               307/308 surfaces verbatim. Used by OAuth2TokenManager so a malicious
               token endpoint cannot redirect-replay client credentials to an
               attacker-controlled host. */
            if (_transportOptions.FollowRedirects && !noRedirect)
            {
                /* Default to 20 hops when caller does not configure an
                   explicit cap — unified across all 12 SDKs. */
                int maxRedirects = _transportOptions.MaxRedirects ?? 20;
                Uri currentUrl = url;
                /* The headers carried from hop to hop. A credential header
                   dropped on a cross-origin hop stays dropped for every later
                   hop, even one that returns to the original origin. */
                Dictionary<string, string> currentHeaders = mergedHeaders;
                /* Transport default headers are configured for the API origin only,
                   so they are withheld from any hop that leaves that origin. */
                HashSet<string> transportHeaderNames = new(_transportOptions.DefaultHeaders.Keys, StringComparer.OrdinalIgnoreCase);
                int hops = 0;
                string currentMethod = method;
                object? currentBody = body;
                while (hops < maxRedirects && IsRedirectStatus((int)response.StatusCode))
                {
                    if (response.Headers.Location == null)
                    {
                        break;
                    }
                    Uri nextUrl = response.Headers.Location.IsAbsoluteUri
                        ? response.Headers.Location
                        : new Uri(currentUrl, response.Headers.Location);
                    if (nextUrl.Scheme != Uri.UriSchemeHttp && nextUrl.Scheme != Uri.UriSchemeHttps)
                    {
                        /* T-D3: a Location pointing at a non-http(s) scheme
                           (file:, javascript:, data:, …) is refused. Surface
                           it as a typed SDK error instead of silently
                           returning the 3xx so the caller can detect the
                           blocked redirect — matching java/kotlin/python and
                           the harmonised cross-SDK canonical. */
                        int refusedStatus = (int)response.StatusCode;
                        Dictionary<string, string> refusedHeaders = CollectHeaders(response);
                        response.Dispose();
                        throw new ApiException(
                            refusedStatus,
                            $"Refusing to follow redirect to non-HTTP(S) URL: {RedactQuery(nextUrl)}",
                            refusedHeaders);
                    }
                    bool crossOrigin = !SameOrigin(currentUrl, nextUrl);

                    /* Gap 3.3: HTTPS -> HTTP downgrade body-replay guard. A
                       307/308 normally preserves the original method and body,
                       but replaying a body that was sent over TLS in
                       cleartext to a downgraded HTTP target leaks whatever
                       was in it (request signatures, form-encoded
                       credentials, PII). Refuse the hop entirely rather
                       than silently downgrade. The original encrypted
                       response is surfaced to the caller. */
                    bool isDowngrade =
                        string.Equals(currentUrl.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(nextUrl.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase);
                    int redirectStatus = (int)response.StatusCode;
                    /* Only 303 leaves the body behind (it coerces to GET). 301,
                       302, 307 and 308 would carry the body to the HTTP target,
                       so a body on any of them is refused. */
                    bool preservesBody = redirectStatus != 303;
                    if (isDowngrade && preservesBody && currentBody != null)
                    {
                        /* T-D2: refuse to replay a body that was sent over TLS
                           in cleartext to a downgraded HTTP target. Raise a
                           typed SDK error instead of silently returning the
                           3xx so the caller observes the refused hop —
                           matching the 8 SDKs that already throw. The body is
                           never leaked in either case; only the error surface
                           is harmonised. */
                        Dictionary<string, string> downgradeHeaders = CollectHeaders(response);
                        response.Dispose();
                        throw new ApiException(
                            redirectStatus,
                            $"Refusing to replay request body across HTTPS->HTTP redirect: {RedactQuery(currentUrl)} -> {RedactQuery(nextUrl)}",
                            downgradeHeaders);
                    }

                    /* Gap T3: pick follow-up method+body per RFC 9110 15.4.
                       307 + 308: preserve original method and body.
                       303:       every method except HEAD becomes GET and the
                                  body is dropped; HEAD stays HEAD.
                       301 + 302: only POST becomes GET (body dropped); every
                                  other method keeps its method and body. */
                    int statusCode = (int)response.StatusCode;
                    string methodUpper = currentMethod.ToUpperInvariant();
                    string nextMethod;
                    object? nextBody;
                    if (statusCode == 303 && methodUpper != "HEAD")
                    {
                        nextMethod = "GET";
                        nextBody = null;
                    }
                    else if ((statusCode == 301 || statusCode == 302) && methodUpper == "POST")
                    {
                        nextMethod = "GET";
                        nextBody = null;
                    }
                    else
                    {
                        nextMethod = currentMethod;
                        nextBody = statusCode == 303 ? null : currentBody;
                    }

                    if (nextBody is BodySource { IsReplayable: false })
                    {
                        /* The one stream was read to its end by the first request, so there is
                           nothing to send again, and it is never buffered to make that possible. */
                        Dictionary<string, string> singleUseHeaders = CollectHeaders(response);
                        response.Dispose();
                        throw new ApiException(
                            statusCode,
                            "Refusing to replay a streamed request body",
                            singleUseHeaders);
                    }

                    HttpRequestMessage next = new(new HttpMethod(nextMethod), nextUrl);
                    Dictionary<string, string> redirectHeaders = new(StringComparer.OrdinalIgnoreCase);
                    foreach (KeyValuePair<string, string> header in currentHeaders)
                    {
                        if (crossOrigin && (IsCredentialHeader(header.Key) || transportHeaderNames.Contains(header.Key)))
                        {
                            continue;
                        }
                        redirectHeaders[header.Key] = header.Value;
                        if (string.Equals(header.Key, "Content-Type", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }
                        if (nextBody == null
                            && string.Equals(header.Key, "Content-Length", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }
                        _ = next.Headers.TryAddWithoutValidation(header.Key, header.Value);
                    }
                    if (nextBody is BodySource nextSource)
                    {
                        next.Content = ContentOf(nextSource);
                        if (contentType != null)
                        {
                            next.Content.Headers.ContentType =
                                System.Net.Http.Headers.MediaTypeHeaderValue.Parse(contentType);
                        }
                    }
                    else if (nextBody is byte[] bytes2)
                    {
                        next.Content = CreateReplayContent(
                            bytes2,
                            contentType == null
                                ? null
                                : System.Net.Http.Headers.MediaTypeHeaderValue.Parse(contentType));
                    }
                    else if (replayBytes != null && (nextBody is Dictionary<string, object> || nextBody is Stream))
                    {
                        /* Multipart and Stream bodies were buffered before the
                           first send, so every hop replays the same bytes with
                           the original Content-Type (and multipart boundary). */
                        next.Content = CreateReplayContent(replayBytes, replayType);
                    }
                    else if (nextBody != null)
                    {
                        next.Content = CreateStringContent(
                            nextBody as string ?? nextBody.ToString() ?? "",
                            contentType ?? "application/json");
                    }
                    response.Dispose();
                    currentUrl = nextUrl;
                    currentHeaders = redirectHeaders;
                    currentMethod = nextMethod;
                    currentBody = nextBody;
                    response = await _httpClient.SendAsync(next, completion, timeoutToken).ConfigureAwait(false);
                    next.Dispose();
                    hops++;
                }

                /* T-D1: the redirect chain was longer than the configured cap.
                   Surface a typed SDK error instead of silently returning the
                   final 3xx as if it were a normal response — matching the
                   harmonised cross-SDK canonical (throw "too many redirects"
                   everywhere). A 3xx without a usable Location is not a hop that
                   could have been followed, so it is returned unchanged (D70). */
                if (
                    hops >= maxRedirects
                    && IsRedirectStatus((int)response.StatusCode)
                    && response.Headers.Location != null)
                {
                    int lastStatus = (int)response.StatusCode;
                    Dictionary<string, string> lastHeaders = CollectHeaders(response);
                    response.Dispose();
                    throw new ApiException(
                        lastStatus,
                        $"Too many redirects (exceeded {maxRedirects})",
                        lastHeaders);
                }
            }
        }
        catch (HttpRequestException ex)
        {
            /* Connection refused, DNS, TLS handshake, reset: no HTTP response. */
            throw new Errors.NetworkException(ex.Message, ex);
        }
        catch (OperationCanceledException ex) when (
            timeoutSource?.IsCancellationRequested == true || ex.InnerException is TimeoutException)
        {
            throw new Errors.NetworkTimeoutException("Request timed out", ex);
        }

        return response;
    }

    private async Task<ApiHttpResponse> SendAttemptAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        bool noRedirect,
        CancellationTokenSource? timeoutSource,
        AttemptState state,
        CancellationToken timeoutToken
    )
    {
        /* D138: with a size limit the body is not buffered by HttpClient but read
           here in chunks, so the read stops as soon as the limit is passed. */
        long? maxResponseBytes = _transportOptions.MaxResponseBytes;
        HttpResponseMessage response = await OpenResponseAsync(
                method,
                url,
                headers,
                body,
                noRedirect,
                maxResponseBytes.HasValue
                    ? HttpCompletionOption.ResponseHeadersRead
                    : HttpCompletionOption.ResponseContentRead,
                timeoutSource,
                state,
                timeoutToken)
            .ConfigureAwait(false);

        /* A post-headers body-read failure (connection reset, read timeout,
           truncated chunked transfer, decompression error) must surface as the
           same NetworkException as a send-phase failure — not as the raw
           HttpRequestException / IOException / TaskCanceledException leaked by
           HttpClient. Wrap the lazy body read in the transport try/catch so
           callers get one error type for the entire transport phase. */
        byte[] responseBytes;
        try
        {
            responseBytes = maxResponseBytes.HasValue
                ? await ReadBoundedAsync(response, maxResponseBytes.Value, timeoutToken).ConfigureAwait(false)
                : await response.Content.ReadAsByteArrayAsync(timeoutToken).ConfigureAwait(false);
        }
        catch (HttpRequestException ex)
        {
            response.Dispose();
            throw new Errors.NetworkException(ex.Message, ex);
        }
        catch (IOException ex)
        {
            response.Dispose();
            throw new Errors.NetworkException(ex.Message, ex);
        }
        catch (InvalidDataException ex)
        {
            /* Gap AL: HttpClientHandler.AutomaticDecompression decodes the body
               lazily during ReadAsByteArrayAsync. A server that lies about the
               Content-Encoding (claims gzip/deflate/br but sends a body that is
               not valid for that encoding) makes the runtime throw
               InvalidDataException — which, unlike a transport read failure, is
               NOT an IOException, so it would otherwise leak out untyped.
               Surface it as the SDK's own ApiException (no crash, no corrupt
               passthrough) so the caller sees one uniform transport error. */
            int decodeStatus = (int)response.StatusCode;
            string decodeEncoding = string.Join(", ", response.Content.Headers.ContentEncoding);
            Dictionary<string, string> decodeHeaders = CollectHeaders(response);
            response.Dispose();
            throw ApiException.ForUnusableResponse(
                decodeStatus,
                $"Failed to decompress {decodeEncoding} response body: {ex.Message}",
                ex,
                decodeHeaders);
        }
        catch (OperationCanceledException ex) when (
            timeoutSource?.IsCancellationRequested == true || ex.InnerException is TimeoutException)
        {
            /* Only our own timeout becomes NetworkTimeoutException. Any other
               cancellation is the caller's and propagates untouched. */
            response.Dispose();
            throw new Errors.NetworkTimeoutException("Request timed out", ex);
        }

        /* Gap AL (cont.): a real HttpClientHandler strips the Content-Encoding
           header once it has auto-decompressed a body it understands, so a
           surviving gzip/deflate/br Content-Encoding here means the runtime did
           NOT decode it (an unsupported encoding, or a test transport that
           bypasses the handler). Rather than pass the still-compressed — or, on
           a Content-Encoding lie, plain — bytes through as if they were the
           decoded body, decode them explicitly and surface any failure as the
           SDK's ApiException. This closes the corrupt-passthrough gap and keeps
           the error type identical to the auto-decompression path above. */
        if (response.Content.Headers.ContentEncoding.Count > 0)
        {
            bool overLimit;
            try
            {
                responseBytes = DecodeContentEncoding(
                    responseBytes, response.Content.Headers.ContentEncoding, maxResponseBytes, out overLimit);
            }
            catch (Exception ex) when (ex is InvalidDataException or NotSupportedException or IOException)
            {
                int decodeStatus = (int)response.StatusCode;
                string decodeEncoding = string.Join(", ", response.Content.Headers.ContentEncoding);
                Dictionary<string, string> decodeHeaders = CollectHeaders(response);
                response.Dispose();
                throw ApiException.ForUnusableResponse(
                    decodeStatus,
                    $"Failed to decompress {decodeEncoding} response body: {ex.Message}",
                    ex,
                    decodeHeaders);
            }
            if (overLimit)
            {
                throw TooLarge(response, maxResponseBytes ?? 0);
            }
            /* D92: a decoded body no longer matches the wire encoding, so the
               headers that describe the encoded bytes are dropped. */
            response.Content.Headers.Remove("Content-Encoding");
            response.Content.Headers.Remove("Content-Length");
        }
        string? contentTypeHeader = response.Content.Headers.ContentType?.ToString();
        string responseBody;
        if (IsTextContentType(response.Content.Headers.ContentType?.MediaType))
        {
            Encoding bodyEncoding = GetEncodingFromContentType(
                contentTypeHeader, responseBytes, out int preambleLength);
            responseBody = bodyEncoding.GetString(
                responseBytes, preambleLength, responseBytes.Length - preambleLength);
        }
        else
        {
            responseBody = Convert.ToBase64String(responseBytes);
        }

        /* Gap BE+BF: response header keys are normalised to lowercase so callers
           can look them up consistently regardless of the casing the server used
           (HTTP header names are case-insensitive per RFC 7230 section 3.2, and
           HTTP/2 mandates lowercase on the wire). Repeated header lines are
           joined with ", " to preserve order per RFC 7230 section 3.2.2. For
           Set-Cookie specifically the joined form is not directly parseable;
           applications that need structured cookie access should use
           System.Net.CookieContainer attached to HttpClientHandler. */
        return new ApiHttpResponse((int)response.StatusCode, responseBody, CollectHeaders(response));
    }

    /// <summary>
    /// Reads a buffered body in chunks and stops as soon as more than
    /// <paramref name="limit"/> bytes have arrived (D138): a declared
    /// <c>Content-Length</c> over the limit fails before anything is read, and a
    /// body that passes it drops the connection instead of draining the rest.
    /// </summary>
    private static async Task<byte[]> ReadBoundedAsync(
        HttpResponseMessage response,
        long limit,
        CancellationToken cancellationToken
    )
    {
        if (response.Content.Headers.ContentLength is long declared && declared > limit)
        {
            throw TooLarge(response, limit);
        }
        Stream raw = await response.Content.ReadAsStreamAsync(cancellationToken).ConfigureAwait(false);
        await using (raw.ConfigureAwait(false))
        {
            using MemoryStream sink = new();
            byte[] chunk = new byte[16384];
            while (true)
            {
                int read = await raw.ReadAsync(chunk.AsMemory(), cancellationToken).ConfigureAwait(false);
                if (read == 0)
                {
                    return sink.ToArray();
                }
                if (sink.Length + read > limit)
                {
                    try
                    {
                        DropUnreadBody(raw);
                    }
                    catch (Exception ex) when (
                        ex is IOException or HttpRequestException or ObjectDisposedException
                            or InvalidOperationException or NotSupportedException or AggregateException)
                    {
                        /* The connection is being dropped either way. */
                    }
                    throw TooLarge(response, limit);
                }
                await sink.WriteAsync(chunk.AsMemory(0, read), cancellationToken).ConfigureAwait(false);
            }
        }
    }

    /// <summary>
    /// The error for a buffered body that passed the limit, with the real status and
    /// the lower-cased headers; the response is released first.
    /// </summary>
    private static Errors.ResponseTooLargeException TooLarge(HttpResponseMessage response, long limit)
    {
        int status = (int)response.StatusCode;
        Dictionary<string, string> responseHeaders = CollectHeaders(response);
        response.Dispose();
        return new Errors.ResponseTooLargeException(status, limit, responseHeaders);
    }

    /// <summary>
    /// Disposing the response of a body that is not read to the end drains up to
    /// 1 MiB, for up to two seconds, before it closes the connection, so an
    /// endless feed would not be dropped at once. A read that is cancelled while
    /// it waits drops the connection immediately, so one is started and cancelled
    /// first; a byte that was already there is read away and the next read waits.
    /// </summary>
    private static void DropUnreadBody(Stream raw)
    {
        byte[] probe = new byte[1];
        for (int tries = 0; tries < 8; tries++)
        {
            using CancellationTokenSource cut = new();
            ValueTask<int> pending = raw.ReadAsync(probe, cut.Token);
            if (pending.IsCompleted)
            {
                if (pending.GetAwaiter().GetResult() == 0)
                {
                    return;
                }
                continue;
            }
            cut.Cancel();
            try
            {
                _ = pending.AsTask().GetAwaiter().GetResult();
            }
            catch (OperationCanceledException) { }
            return;
        }
    }

    /// <inheritdoc/>
    public async Task<ApiStreamResponse> SendStreamingAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        Func<Task<Dictionary<string, string>>>? refreshHeaders,
        int? timeout,
        int? maxRetries,
        int? idleTimeout,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(method);
        ArgumentNullException.ThrowIfNull(url);
        ArgumentNullException.ThrowIfNull(headers);
        if (idleTimeout is < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(idleTimeout), "IdleTimeout must not be negative");
        }

        /* The call is counted in until the stream it returns ends, so the
           transport outlives the body; closing the client cancels the stream
           instead of waiting for it. */
        EnterCall();
        bool kept = false;
        try
        {
            ApiStreamResponse response = await SendWithRetriesAsync(
                    method,
                    url,
                    headers,
                    body,
                    refreshHeaders,
                    timeout,
                    maxRetries,
                    (attemptHeaders, timeoutSource, state, timeoutToken) =>
                        OpenStreamAttemptAsync(
                            method,
                            url,
                            attemptHeaders,
                            body,
                            idleTimeout,
                            timeoutSource,
                            state,
                            timeoutToken),
                    result => result.StatusCode,
                    result => result.Headers,
                    result => result.Dispose(),
                    cancellationToken)
                .ConfigureAwait(false);
            HttpBodyStream stream = (HttpBodyStream)response.Body;
            /* From here the caller's token cancels the open body as well. */
            stream.Bind(cancellationToken);
            bool closedMeanwhile;
            lock (_lifecycle)
            {
                /* A stream that ended while it was being handed over (its call was
                   cancelled) has already counted itself out of the registry. */
                kept = !stream.Ended;
                if (kept)
                {
                    _ = _openStreams.Add(stream);
                }
                closedMeanwhile = kept && _closed;
            }
            if (closedMeanwhile)
            {
                stream.CloseByClient();
            }
            return response;
        }
        finally
        {
            if (!kept)
            {
                ExitCall();
            }
        }
    }

    /// <summary>Counts a stream out of the registry and out of the calls in flight, once.</summary>
    private void StreamEnded(HttpBodyStream stream)
    {
        bool registered;
        lock (_lifecycle)
        {
            registered = _openStreams.Remove(stream);
        }
        if (registered)
        {
            ExitCall();
        }
    }

    /// <summary>
    /// One attempt of a streaming call: everything up to the response headers is the
    /// buffered attempt, and the open body is handed back unread, decoded when the
    /// server compressed it.
    /// </summary>
    private async Task<ApiStreamResponse> OpenStreamAttemptAsync(
        string method,
        Uri url,
        Dictionary<string, string> headers,
        object? body,
        int? idleTimeout,
        CancellationTokenSource? timeoutSource,
        AttemptState state,
        CancellationToken timeoutToken
    )
    {
        HttpResponseMessage response = await OpenResponseAsync(
                method,
                url,
                headers,
                body,
                false,
                HttpCompletionOption.ResponseHeadersRead,
                timeoutSource,
                state,
                timeoutToken)
            .ConfigureAwait(false);
        bool handedOver = false;
        try
        {
            int status = (int)response.StatusCode;
            Dictionary<string, string> responseHeaders = CollectHeaders(response);
            Stream raw = await response.Content.ReadAsStreamAsync(timeoutToken).ConfigureAwait(false);
            Stream decoded = raw;
            long? expected = response.Content.Headers.ContentLength;
            if (
                string.Equals(method, "HEAD", StringComparison.OrdinalIgnoreCase)
                || status is 204 or 304
            )
            {
                expected = null;
            }
            if (response.Content.Headers.ContentEncoding.Count > 0)
            {
                decoded = DecodeContentEncodingStream(raw, response.Content.Headers.ContentEncoding);
                /* D92: the decoded body no longer matches the wire encoding. */
                _ = responseHeaders.Remove("content-encoding");
                _ = responseHeaders.Remove("content-length");
                expected = null;
            }
            int? effectiveIdle = idleTimeout ?? _transportOptions.IdleTimeout;
            HttpBodyStream stream = new(
                StreamEnded,
                response,
                raw,
                decoded,
                status,
                responseHeaders,
                method,
                url.AbsolutePath,
                string.Join(", ", response.Content.Headers.ContentEncoding),
                effectiveIdle is 0 ? null : effectiveIdle,
                expected,
                _transportOptions.CancellationToken);
            handedOver = true;
            return new ApiStreamResponse(status, responseHeaders, stream);
        }
        catch (Exception ex) when (ex is NotSupportedException or InvalidDataException)
        {
            throw ApiException.ForUnusableResponse(
                (int)response.StatusCode,
                $"Failed to decompress {string.Join(", ", response.Content.Headers.ContentEncoding)} response body: {ex.Message}",
                ex,
                CollectHeaders(response));
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            throw new Errors.NetworkException(ex.Message, ex);
        }
        catch (OperationCanceledException ex) when (
            timeoutSource?.IsCancellationRequested == true || ex.InnerException is TimeoutException)
        {
            throw new Errors.NetworkTimeoutException("Request timed out", ex);
        }
        finally
        {
            if (!handedOver)
            {
                response.Dispose();
            }
        }
    }

    /// <summary>
    /// Wraps a response body in the decoder of its <c>Content-Encoding</c>, so a
    /// compressed stream is decoded as it arrives. The decoder leaves the body open:
    /// the stream ends the connection itself, which never waits for the rest of it.
    /// </summary>
    private static Stream DecodeContentEncodingStream(Stream source, IEnumerable<string> encodings)
    {
        List<string> codings = [];
        foreach (string encoding in encodings)
        {
            string coding = encoding.Trim();
            if (coding.Length > 0 && !coding.Equals("identity", StringComparison.OrdinalIgnoreCase))
            {
                codings.Add(coding);
            }
        }
        if (codings.Count > 1)
        {
            throw new NotSupportedException("chained Content-Encoding is not supported");
        }
        if (codings.Count == 0)
        {
            return source;
        }
        return codings[0].ToUpperInvariant() switch
        {
            "GZIP" or "X-GZIP" => new GZipStream(source, CompressionMode.Decompress, leaveOpen: true),
            "DEFLATE" => new ZLibStream(source, CompressionMode.Decompress, leaveOpen: true),
            "BR" => new BrotliStream(source, CompressionMode.Decompress, leaveOpen: true),
            _ => throw new NotSupportedException($"Unsupported Content-Encoding '{codings[0]}'"),
        };
    }

    /// <summary>The response and content headers as a lower-cased map with comma-joined values.</summary>
    private static Dictionary<string, string> CollectHeaders(HttpResponseMessage response)
    {
        Dictionary<string, string> responseHeaders = [];

        foreach (KeyValuePair<string, IEnumerable<string>> header in response.Headers)
        {
            responseHeaders[AsciiLower(header.Key)] = string.Join(", ", header.Value);
        }

        foreach (KeyValuePair<string, IEnumerable<string>> header in response.Content.Headers)
        {
            responseHeaders[AsciiLower(header.Key)] = string.Join(", ", header.Value);
        }

        return responseHeaders;
    }

    private static bool IsRedirectStatus(int code)
    {
        return code is 301 or 302 or 303 or 307 or 308;
    }

    /// <summary>
    /// Renders a URL for an error message with its query replaced by <c>***</c>, so a
    /// credential carried in a query parameter never reaches a log or an exception.
    /// </summary>
    internal static string RedactQuery(Uri url)
    {
        /* GetLeftPart keeps user:password, so the userinfo is cleared before rendering. */
        var bare = new UriBuilder(url) { UserName = string.Empty, Password = string.Empty };
        string text = bare.Uri.GetLeftPart(UriPartial.Path);
        return string.IsNullOrEmpty(url.Query) ? text : text + "?***";
    }

    private static bool SameOrigin(Uri a, Uri b)
    {
        if (!string.Equals(a.Scheme, b.Scheme, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (!string.Equals(a.Host, b.Host, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return a.Port == b.Port;
    }

    /// <summary>
    /// Lowercases an ASCII string (HTTP header names are tokens restricted to
    /// the ASCII range per RFC 7230 section 3.2.6, so a culture-aware
    /// <c>ToLower</c> is unnecessary and would otherwise trip CA1308).
    /// </summary>
    private static string AsciiLower(string value)
    {
        char[] chars = value.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            char c = chars[i];
            if (c >= 'A' && c <= 'Z')
            {
                chars[i] = (char)(c + 32);
            }
        }
        return new string(chars);
    }

    private static MultipartFormDataContent BuildMultipartContent(
        Dictionary<string, object> formParts,
        ObjectSerializer serializer
    )
    {
        MultipartFormDataContent multipart = new();
        foreach (KeyValuePair<string, object> wrappedPart in formParts)
        {
            /* allowReserved has no effect on a multipart body: the value is
               unwrapped and sent unchanged. */
            KeyValuePair<string, object> part =
                wrappedPart.Value is ValueSerializer.AllowReservedValue reserved
                    ? new KeyValuePair<string, object>(wrappedPart.Key, reserved.Value)
                    : wrappedPart;
            if (part.Value is byte[] || part.Value is string || part.Value is Stream)
            {
                AddMultipartField(multipart, part.Key, part.Value, serializer);
            }
            else if (part.Value is System.Collections.IList list)
            {
                foreach (object? item in list)
                {
                    if (item != null)
                    {
                        AddMultipartField(multipart, part.Key, item, serializer);
                    }
                }
            }
            else
            {
                AddMultipartField(multipart, part.Key, part.Value, serializer);
            }
        }
        return multipart;
    }

    private static void AddMultipartField(
        MultipartFormDataContent multipart,
        string name,
        object value,
        ObjectSerializer serializer
    )
    {
        switch (value)
        {
            case byte[] bytes:
                ValidateMultipartFilename(name);
                ByteArrayContent bytesContent = new(bytes);
                bytesContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(GetMimeType(name));
                SetPartDisposition(
                    bytesContent,
                    "form-data; name=\"" + EscapeQuotedString(name) + "\"; "
                        + BuildFilenameDirective(name));
                multipart.Add(bytesContent);
                break;
            case Stream stream:
                ValidateMultipartFilename(name);
                StreamContent streamContent = new(new CallerOwnedStream(stream));
                streamContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(GetMimeType(name));
                SetPartDisposition(
                    streamContent,
                    "form-data; name=\"" + EscapeQuotedString(name) + "\"; "
                        + BuildFilenameDirective(name));
                multipart.Add(streamContent);
                break;
            case string s:
                ValidateMultipartFilename(name);
                StringContent stringContent = BuildTextPart(s);
                _ = stringContent.Headers.Remove("Content-Disposition");
                _ = stringContent.Headers.TryAddWithoutValidation(
                    "Content-Disposition",
                    EncodeHeaderValueUtf8(
                        "form-data; name=\"" + EscapeQuotedString(name) + "\""));
                multipart.Add(stringContent);
                break;
            default:
                if (ObjectSerializer.IsScalar(value))
                {
                    /* Every primitive (number, boolean, date, date-time,
                       duration, uuid, enum) is a plain text part carrying its
                       canonical Stringify form (true, not True; invariant
                       culture; .fff+00:00 date-times; enum wire values). Only
                       models, maps and other objects become JSON parts. */
                    ValidateMultipartFilename(name);
                    StringContent scalarContent = BuildTextPart(ObjectSerializer.Stringify(value));
                    _ = scalarContent.Headers.Remove("Content-Disposition");
                    _ = scalarContent.Headers.TryAddWithoutValidation(
                        "Content-Disposition",
                        EncodeHeaderValueUtf8(
                            "form-data; name=\"" + EscapeQuotedString(name) + "\""));
                    multipart.Add(scalarContent);
                }
                else
                {
                    ValidateMultipartFilename(name);
                    /* Route the model part through the SDK's configured
                       ObjectSerializer rather than a bare
                       JsonSerializer.Serialize(value) call. The bare call would
                       omit the SDK JsonSerializerOptions — the
                       millisecond-precision DateTimeOffset converter, the
                       protobuf-duration converter, null-property omission, and
                       relaxed escaping — so a JSON model part (e.g. one with a
                       format:date-time field) would diverge from the body the
                       same SDK emits on the JSON-body path. Serializing here
                       keeps the multipart part byte-identical to the JSON path
                       and the wire property names (from [JsonPropertyName]) and
                       date-time format consistent across the SDK. */
                    string json = serializer.Serialize(value);
                    StringContent jsonContent = CreateStringContent(json, "application/json");
                    SetPartDisposition(
                        jsonContent,
                        "form-data; name=\"" + EscapeQuotedString(name) + "\"");
                    multipart.Add(jsonContent);
                }
                break;
        }
    }

    /// <summary>
    /// Gives a multipart part its Content-Disposition ahead of its
    /// Content-Type. .NET writes part headers in insertion order and the
    /// content types are set when the part is built, so adding the
    /// disposition afterwards would put Content-Type first; the other 11 SDKs
    /// send Content-Disposition first.
    /// </summary>
    private static void SetPartDisposition(HttpContent part, string disposition)
    {
        System.Net.Http.Headers.MediaTypeHeaderValue? contentType = part.Headers.ContentType;
        part.Headers.ContentType = null;
        _ = part.Headers.Remove("Content-Disposition");
        _ = part.Headers.TryAddWithoutValidation(
            "Content-Disposition",
            EncodeHeaderValueUtf8(disposition));
        part.Headers.ContentType = contentType;
    }

    /// <summary>
    /// Builds a scalar/text multipart part with NO per-part Content-Type
    /// header. .NET's <see cref="StringContent"/> otherwise defaults the part
    /// Content-Type to <c>text/plain; charset=utf-8</c>; the other 11 SDKs
    /// emit text fields with no Content-Type (RFC 7578 does not require one on
    /// text fields), so we strip it here to keep the multipart wire bytes
    /// identical across languages.
    /// </summary>
    private static StringContent BuildTextPart(string value)
    {
        StringContent content = new(value);
        content.Headers.ContentType = null;
        return content;
    }

    /// <summary>
    /// Builds a UTF-8 text body carrying exactly the declared media type.
    /// .NET's <see cref="StringContent"/> otherwise appends
    /// <c>; charset=utf-8</c> to the Content-Type, which the other 11 SDKs
    /// never send, so the header is replaced with the bare declared value.
    /// </summary>
    private static StringContent CreateStringContent(string text, string mediaType)
    {
        StringContent content = new(text, Encoding.UTF8);
        content.Headers.ContentType = System.Net.Http.Headers.MediaTypeHeaderValue.Parse(mediaType);
        return content;
    }

    /// <summary>
    /// Builds a replayable byte body for a redirect hop, with the original
    /// Content-Type when there was one.
    /// </summary>
    private static ByteArrayContent CreateReplayContent(
        byte[] bytes, System.Net.Http.Headers.MediaTypeHeaderValue? mediaType)
    {
        ByteArrayContent content = new(bytes);
        content.Headers.ContentType = mediaType;
        return content;
    }

    /// <summary>
    /// Re-encodes a header value so its UTF-8 bytes survive .NET's Latin-1
    /// header serialization. <see cref="System.Net.Http.Headers"/> writes each
    /// <c>char</c> of a header value as a single Latin-1 byte; a multi-byte
    /// UTF-8 field name (e.g. a non-ASCII Content-Disposition <c>name</c>)
    /// would otherwise be mangled or dropped on the wire. By mapping each UTF-8
    /// byte to one Latin-1 <c>char</c> here, the round-trip reproduces the
    /// original UTF-8 byte sequence — so non-ASCII multipart field names are
    /// preserved verbatim, matching the other 11 SDKs (which build the
    /// multipart body as raw UTF-8 bytes directly). ASCII values are
    /// unaffected.
    /// </summary>
    private static string EncodeHeaderValueUtf8(string value)
    {
        return Encoding.Latin1.GetString(Encoding.UTF8.GetBytes(value));
    }

    /// <summary>
    /// Rejects multipart filenames that would allow Content-Disposition
    /// header injection or smuggling. Throws <see cref="ArgumentException"/>
    /// when the filename contains CR, LF, or NUL characters.
    /// </summary>
    /// <param name="filename">The filename to validate.</param>
    public static void ValidateMultipartFilename(string? filename)
    {
        if (filename is null)
        {
            return;
        }
        foreach (char c in filename)
        {
            if (c == '\r' || c == '\n' || c == '\0')
            {
                throw new ArgumentException(
                    "multipart filename must not contain CR, LF, or NUL characters",
                    nameof(filename));
            }
        }
    }

    /// <summary>
    /// Builds the <c>filename=...</c> directive for a multipart
    /// Content-Disposition part. For ASCII-only filenames emits a
    /// quote/backslash-escaped <c>filename="..."</c>. For non-ASCII filenames
    /// additionally emits an RFC 5987 <c>filename*=UTF-8''(pct-encoded)</c>
    /// parameter alongside an ASCII fallback (non-ASCII bytes replaced
    /// with <c>_</c>).
    /// </summary>
    /// <param name="filename">The (validated) filename.</param>
    /// <returns>The directive string suitable for a Content-Disposition header.</returns>
    public static string BuildFilenameDirective(string filename)
    {
        ArgumentNullException.ThrowIfNull(filename);
        string escaped = EscapeQuotedString(filename);
        bool ascii = true;
        foreach (char c in filename)
        {
            if (c > 0x7F)
            {
                ascii = false;
                break;
            }
        }
        if (ascii)
        {
            return "filename=\"" + escaped + "\"";
        }
        StringBuilder fallback = new();
        foreach (Rune rune in filename.EnumerateRunes())
        {
            /* One underscore per code point, so an astral character (an emoji)
               is replaced once, not once per UTF-16 unit. */
            _ = rune.Value is > 0x7F or < 0x20 or 0x7F
                ? fallback.Append('_')
                : fallback.Append((char)rune.Value);
        }
        string fallbackEscaped = EscapeQuotedString(fallback.ToString());
        string encoded = Rfc5987EncodeValue(filename);
        return "filename=\"" + fallbackEscaped + "\"; filename*=UTF-8''" + encoded;
    }

    private static string EscapeQuotedString(string s)
    {
        return s.Replace("\\", "\\\\", StringComparison.Ordinal)
                .Replace("\"", "\\\"", StringComparison.Ordinal);
    }

    /// <summary>
    /// Percent-encodes every byte that is not an RFC 3986 §2.3 unreserved
    /// character, producing the value-chars production of RFC 5987 §3.2.1.
    /// </summary>
    public static string Rfc5987EncodeValue(string s)
    {
        ArgumentNullException.ThrowIfNull(s);
        const string hex = "0123456789ABCDEF";
        byte[] bytes = Encoding.UTF8.GetBytes(s);
        StringBuilder sb = new(bytes.Length * 3);
        foreach (byte b in bytes)
        {
            bool isUnreserved =
                (b >= (byte)'A' && b <= (byte)'Z') ||
                (b >= (byte)'a' && b <= (byte)'z') ||
                (b >= (byte)'0' && b <= (byte)'9') ||
                b == (byte)'-' || b == (byte)'.' || b == (byte)'_' || b == (byte)'~';
            if (isUnreserved)
            {
                _ = sb.Append((char)b);
                continue;
            }
            _ = sb.Append('%');
            _ = sb.Append(hex[b >> 4]);
            _ = sb.Append(hex[b & 0x0F]);
        }
        return sb.ToString();
    }

    /// <summary>
    /// Maps a filename to a MIME type using a small extension lookup table.
    /// Falls back to <c>application/octet-stream</c> for unknown or absent
    /// extensions.
    /// </summary>
    /// <param name="filename">The filename (or field name treated as filename).</param>
    /// <returns>The inferred MIME type, never null.</returns>
    private static string GetMimeType(string filename)
    {
        if (string.IsNullOrEmpty(filename))
        {
            return "application/octet-stream";
        }
        string ext = System.IO.Path.GetExtension(filename);
        return (ext ?? string.Empty).ToUpperInvariant() switch
        {
            ".PNG" => "image/png",
            ".JPG" or ".JPEG" => "image/jpeg",
            ".GIF" => "image/gif",
            ".WEBP" => "image/webp",
            ".BMP" => "image/bmp",
            ".SVG" => "image/svg+xml",
            ".TIFF" or ".TIF" => "image/tiff",
            ".PDF" => "application/pdf",
            ".ZIP" => "application/zip",
            ".GZ" => "application/gzip",
            ".TAR" => "application/x-tar",
            ".JSON" => "application/json",
            ".XML" => "application/xml",
            ".HTML" or ".HTM" => "text/html",
            ".CSS" => "text/css",
            ".JS" => "application/javascript",
            ".TXT" => "text/plain",
            ".CSV" => "text/csv",
            ".MP3" => "audio/mpeg",
            ".MP4" => "video/mp4",
            ".WEBM" => "video/webm",
            ".WAV" => "audio/wav",
            ".OGG" => "audio/ogg",
            _ => "application/octet-stream",
        };
    }

    /// <summary>
    /// Returns a comma-separated list of supported content encodings for
    /// the Accept-Encoding header.
    ///
    /// Always advertises gzip, deflate, and Brotli ("br"); the project targets
    /// a framework where <see cref="System.IO.Compression.BrotliStream"/> is
    /// always present.
    /// </summary>
    /// <returns>Comma-separated encoding names.</returns>
    private static string SupportedEncodings()
    {
        return "gzip, deflate, br";
    }

    /// <summary>
    /// Decodes a response body whose <c>Content-Encoding</c> header survived the
    /// <see cref="HttpClientHandler.AutomaticDecompression"/> pass — i.e. an
    /// encoding the runtime did not (or could not) decode. Applies the declared
    /// codings outermost-first using the .NET built-in stream decoders.
    ///
    /// A body that lies about its encoding (server sends
    /// <c>Content-Encoding: gzip</c> but the bytes are not valid gzip) makes the
    /// decoder throw <see cref="InvalidDataException"/>; the caller wraps that as
    /// the SDK's <see cref="ApiException"/> rather than passing corrupt bytes
    /// through. An unrecognised coding (e.g. <c>zstd</c>) throws
    /// <see cref="NotSupportedException"/>, surfaced the same way.
    /// </summary>
    /// <param name="data">The raw (still-encoded) body bytes.</param>
    /// <param name="encodings">The Content-Encoding header values, in header order.</param>
    /// <param name="limit">The most decoded bytes to produce (D138), or <c>null</c> for no limit.</param>
    /// <param name="overLimit">Set when decoding stopped because the output passed <paramref name="limit"/>.</param>
    /// <returns>The decoded body bytes, or an empty array when <paramref name="overLimit"/> is set.</returns>
    private static byte[] DecodeContentEncoding(
        byte[] data,
        IEnumerable<string> encodings,
        long? limit,
        out bool overLimit
    )
    {
        overLimit = false;
        /* A chained (multi-coding) Content-Encoding is non-standard for this
         * SDK's responses and is rejected uniformly across the SDKs rather than
         * decoded coding-by-coding here, matching the single-coding switch the
         * other manual decompressors use. It never occurs in practice (the
         * client advertises one codec). Materialise the sequence once to avoid
         * a double enumeration (CA1851). */
        List<string> codings = new(encodings);
        int codingCount = 0;
        foreach (string e in codings)
        {
            string c = e.Trim();
            if (c.Length > 0 && !c.Equals("identity", StringComparison.OrdinalIgnoreCase))
            {
                codingCount++;
            }
        }
        if (codingCount > 1)
        {
            throw new NotSupportedException("chained Content-Encoding is not supported");
        }
        byte[] current = data;
        foreach (string encoding in codings)
        {
            string coding = encoding.Trim().ToUpperInvariant();
            if (coding is "IDENTITY" or "")
            {
                continue;
            }
            /* A non-empty gzip body is at least 18 bytes (a 10-byte header and an
             * 8-byte trailer). A shorter one is a truncated stream, which GZipStream
             * would otherwise read as an empty body without raising an error. An
             * empty body is a valid empty response and passes through unchanged. */
            if (coding is "GZIP" or "X-GZIP" && current.Length is > 0 and < 18)
            {
                throw new InvalidDataException(
                    "truncated gzip stream: a gzip member is at least 18 bytes");
            }
            using MemoryStream source = new(current);
            Stream decoder = coding switch
            {
                "GZIP" or "X-GZIP" => new GZipStream(source, CompressionMode.Decompress),
                "DEFLATE" => new ZLibStream(source, CompressionMode.Decompress),
                "BR" => new BrotliStream(source, CompressionMode.Decompress),
                _ => throw new NotSupportedException(
                    $"Unsupported Content-Encoding '{encoding}'"),
            };
            using (decoder)
            {
                /* Inflate in chunks and stop as soon as the output passes the
                   limit, so a small body that expands hugely is never decoded whole. */
                using MemoryStream sink = new();
                byte[] chunk = new byte[16384];
                int read;
                while ((read = decoder.Read(chunk.AsSpan())) > 0)
                {
                    if (limit.HasValue && sink.Length + read > limit.Value)
                    {
                        overLimit = true;
                        return [];
                    }
                    sink.Write(chunk, 0, read);
                }
                current = sink.ToArray();
            }
        }
        return current;
    }

    /// <summary>
    /// Parses the <c>charset</c> parameter from a Content-Type header value
    /// and returns the corresponding <see cref="Encoding"/>. Falls back to
    /// UTF-8 if the header is missing, the charset is unspecified, or the
    /// named charset is not recognised by the runtime.
    /// </summary>
    /// <param name="contentType">The full Content-Type header value, or null.</param>
    /// <param name="body">The raw body, sniffed for a byte order mark when the charset is a bare utf-16.</param>
    /// <param name="preambleLength">The number of leading body bytes that are a byte order mark to skip.</param>
    /// <returns>The resolved encoding, never null.</returns>
    internal static Encoding GetEncodingFromContentType(
        string? contentType, byte[] body, out int preambleLength)
    {
        preambleLength = 0;
        if (string.IsNullOrEmpty(contentType))
        {
            return Encoding.UTF8;
        }
        try
        {
            System.Net.Mime.ContentType media = new(contentType);
            if (!string.IsNullOrEmpty(media.CharSet))
            {
                string charset = media.CharSet.Trim();
                /* A bare "utf-16" / "utf16" label (no endianness suffix, no BOM)
                   must decode big-endian per RFC 2781: a UTF-16 stream lacking a
                   BOM defaults to big-endian. .NET's Encoding.GetEncoding("utf-16")
                   returns a little-endian UnicodeEncoding, which would disagree
                   with the other SDKs, so resolve bare utf-16 to UTF-16BE here.
                   Explicit "utf-16le" / "utf-16be" labels fall through to
                   Encoding.GetEncoding so their declared byte order is honored.
                   A leading byte order mark wins over that default: FF FE selects
                   little-endian and FE FF big-endian, and the mark itself is not
                   part of the text, so it is skipped. */
                if (string.Equals(charset, "utf-16", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(charset, "utf16", StringComparison.OrdinalIgnoreCase))
                {
                    if (body.Length >= 2 && body[0] == 0xFF && body[1] == 0xFE)
                    {
                        preambleLength = 2;
                        return new UnicodeEncoding(bigEndian: false, byteOrderMark: false);
                    }
                    if (body.Length >= 2 && body[0] == 0xFE && body[1] == 0xFF)
                    {
                        preambleLength = 2;
                    }
                    return new UnicodeEncoding(bigEndian: true, byteOrderMark: false);
                }
                return Encoding.GetEncoding(charset);
            }
        }
        catch (FormatException)
        {
            /* fall through to UTF-8 default */
        }
        catch (ArgumentException)
        {
            /* unknown charset name — fall through to UTF-8 default */
        }
        return Encoding.UTF8;
    }

    /// <summary>
    /// Determines whether the given media type represents text content
    /// that is safe to decode as a UTF-8 string.
    /// </summary>
    /// <param name="mediaType">The Content-Type media type, or null.</param>
    /// <returns><c>true</c> for text-like content types, <c>false</c> otherwise.</returns>
    internal static bool IsTextContentType(string? mediaType)
    {
        return string.IsNullOrEmpty(mediaType)
            || mediaType.StartsWith("text/", StringComparison.OrdinalIgnoreCase)
            || mediaType.Equals("application/json", StringComparison.OrdinalIgnoreCase)
            || mediaType.Equals("application/xml", StringComparison.OrdinalIgnoreCase)
            || mediaType.Equals("application/javascript", StringComparison.OrdinalIgnoreCase)
            || mediaType.EndsWith("+json", StringComparison.OrdinalIgnoreCase)
            || mediaType.EndsWith("+xml", StringComparison.OrdinalIgnoreCase);
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        /* Graceful and idempotent: the first call marks the client closed and
           returns; requests already running finish, and the last one releases
           the transport. Only a transport the SDK created is released, never a
           client the caller supplied. */
        List<HttpBodyStream> open;
        lock (_lifecycle)
        {
            _closed = true;
            open = [.. _openStreams];
        }
        /* An open stream may never end (an endless feed), so closing cancels it
           instead of waiting for it: its next read raises the closed error. Each
           cancelled stream counts itself out, and the last one releases the
           transport. */
        foreach (HttpBodyStream stream in open)
        {
            stream.CloseByClient();
        }
        bool release;
        lock (_lifecycle)
        {
            release = _inFlight == 0 && !_transportReleased;
            _transportReleased |= release;
        }
        if (release && _ownsHttpClient)
        {
            _httpClient.Dispose();
        }
    }

    /// <summary>
    /// Reports whether <paramref name="headers"/> holds <paramref name="name"/>
    /// under ASCII case-insensitive comparison.
    /// </summary>
    private static bool HasHeader(Dictionary<string, string> headers, string name)
    {
        return headers.Keys.Any(k => string.Equals(k, name, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// The open body of a streaming response. A read is bounded by the idle timeout
    /// and by the cancellation of the call, a failure after the headers is raised as
    /// the SDK's own error, and disposing it drops the connection instead of
    /// draining the rest of the body.
    /// </summary>
    private sealed class HttpBodyStream : Stream
    {
        private readonly Action<HttpBodyStream> _onEnded;
        private readonly HttpResponseMessage _response;
        private readonly Stream _raw;
        private readonly Stream _body;
        private readonly int _statusCode;
        private readonly Dictionary<string, string> _headers;
        private readonly string _method;
        private readonly string _path;
        private readonly string _encoding;
        private readonly int? _idleMilliseconds;
        private readonly long? _expectedLength;
        private readonly CancellationTokenSource _cancel;
        private readonly CancellationTokenRegistration _registration;
        private CancellationTokenRegistration _callRegistration;
        private long _delivered;
        private int _disposed;
        private int _aborted;
        private int _ended;
        private volatile bool _clientClosed;

        public HttpBodyStream(
            Action<HttpBodyStream> onEnded,
            HttpResponseMessage response,
            Stream raw,
            Stream body,
            int statusCode,
            Dictionary<string, string> headers,
            string method,
            string path,
            string encoding,
            int? idleMilliseconds,
            long? expectedLength,
            CancellationToken clientToken
        )
        {
            _encoding = encoding;
            _onEnded = onEnded;
            _response = response;
            _raw = raw;
            _body = body;
            _statusCode = statusCode;
            _headers = headers;
            _method = method;
            _path = path;
            _idleMilliseconds = idleMilliseconds;
            _expectedLength = expectedLength;
            _cancel = CancellationTokenSource.CreateLinkedTokenSource(clientToken);
            /* Last, because a token that is cancelled already runs this at once. */
            _registration = _cancel.Token.Register(
                static state => ((HttpBodyStream)state!).AbortConnection(), this);
        }

        /// <summary>Lets the cancellation token of the call cancel the open body too.</summary>
        public void Bind(CancellationToken callToken)
        {
            _callRegistration = callToken.Register(
                static state => ((HttpBodyStream)state!)._cancel.Cancel(), this);
        }

        /// <summary>Whether the stream has ended and counted itself out of its client.</summary>
        public bool Ended => Volatile.Read(ref _ended) != 0;

        public override bool CanRead => true;

        public override bool CanSeek => false;

        public override bool CanWrite => false;

        public override long Length => throw new NotSupportedException();

        public override long Position
        {
            get => throw new NotSupportedException();
            set => throw new NotSupportedException();
        }

        public override void Flush() { }

        public override int Read(byte[] buffer, int offset, int count)
        {
            return ReadAsync(buffer.AsMemory(offset, count), CancellationToken.None)
                .AsTask()
                .GetAwaiter()
                .GetResult();
        }

        public override async ValueTask<int> ReadAsync(
            Memory<byte> buffer,
            CancellationToken cancellationToken = default
        )
        {
            ThrowIfUnusable();
            using CancellationTokenSource linked = CancellationTokenSource.CreateLinkedTokenSource(
                _cancel.Token, cancellationToken);
            if (_idleMilliseconds is int idle)
            {
                linked.CancelAfter(idle);
            }
            try
            {
                int count = await _body.ReadAsync(buffer, linked.Token).ConfigureAwait(false);
                if (count > 0)
                {
                    _delivered += count;
                    return count;
                }
                if (_expectedLength is long expected && ReferenceEquals(_body, _raw) && _delivered < expected)
                {
                    throw Recorded(new Errors.StreamException(
                        $"The response body ended after {_delivered} of {expected} bytes"));
                }
                End();
                return 0;
            }
            catch (Exception ex) when (
                ex is OperationCanceledException or IOException or HttpRequestException
                    or ObjectDisposedException or InvalidDataException)
            {
                throw Translate(ex, cancellationToken);
            }
        }

        public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();

        public override void SetLength(long value) => throw new NotSupportedException();

        public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();

        /// <summary>Cancels the stream because its client was closed: the next read raises the closed error.</summary>
        public void CloseByClient()
        {
            _clientClosed = true;
            AbortConnection();
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing && Interlocked.Exchange(ref _disposed, 1) == 0)
            {
                AbortConnection();
                _registration.Dispose();
                _callRegistration.Dispose();
                _raw.Dispose();
                _cancel.Dispose();
            }
            base.Dispose(disposing);
        }

        private void ThrowIfUnusable()
        {
            if (_clientClosed)
            {
                throw new InvalidOperationException(ClosedMessage);
            }
            ObjectDisposedException.ThrowIf(Volatile.Read(ref _disposed) != 0, this);
        }

        /// <summary>The error a failed read raises: the caller's own cancellation stays one, and nothing else is raw.</summary>
        private Exception Translate(Exception failure, CancellationToken readToken)
        {
            if (_clientClosed)
            {
                return new InvalidOperationException(ClosedMessage);
            }
            if (Volatile.Read(ref _disposed) != 0)
            {
                return new ObjectDisposedException(nameof(HttpBodyStream));
            }
            if (readToken.IsCancellationRequested || _cancel.IsCancellationRequested)
            {
                /* The caller cancelled: never raised as a timeout. */
                return failure as OperationCanceledException
                    ?? new OperationCanceledException(
                        readToken.IsCancellationRequested ? readToken : _cancel.Token);
            }
            if (failure is OperationCanceledException)
            {
                AbortConnection();
                return Recorded(new Errors.NetworkTimeoutException(
                    $"The response body was silent for {_idleMilliseconds} ms", failure));
            }
            AbortConnection();
            if (failure is InvalidDataException)
            {
                return ApiException.ForUnusableResponse(
                    _statusCode,
                    $"Failed to decompress {_encoding} response body: {failure.Message}",
                    failure,
                    _headers);
            }
            return Recorded(new Errors.StreamException(failure.Message, failure));
        }

        private Errors.NetworkException Recorded(Errors.NetworkException failure)
        {
            failure.RecordRequest(_method, _path);
            return failure;
        }

        /// <summary>Counts the stream out of its client once, when it ends or is aborted.</summary>
        private void End()
        {
            if (Interlocked.Exchange(ref _ended, 1) == 0)
            {
                _onEnded(this);
            }
        }

        /// <summary>Drops the connection and ends the stream; later calls do nothing.</summary>
        private void AbortConnection()
        {
            if (Interlocked.Exchange(ref _aborted, 1) != 0)
            {
                return;
            }
            try
            {
                /* A read that waits on the connection is cancelled, which drops it. */
                _cancel.Cancel();
                DropConnection();
            }
            catch (Exception ex) when (
                ex is IOException or HttpRequestException or ObjectDisposedException
                    or InvalidOperationException or NotSupportedException or InvalidDataException
                    or AggregateException)
            {
                /* Aborting: the connection is being dropped either way. */
            }
            finally
            {
                if (!ReferenceEquals(_body, _raw))
                {
                    _body.Dispose();
                }
                _response.Dispose();
                End();
            }
        }

        /// <summary>Drops the connection of the body without draining it (see <see cref="DropUnreadBody"/>).</summary>
        private void DropConnection()
        {
            DropUnreadBody(_raw);
        }
    }

    /// <summary>
    /// The content of a <see cref="BodySource"/>: in-memory bytes are sent as they are; anything
    /// else is read from a freshly opened stream while it is sent, so it is never buffered, and the
    /// length is the <c>Content-Length</c> when it is known and the request is chunked when it is not.
    /// </summary>
    private static HttpContent ContentOf(BodySource source)
    {
        byte[]? inMemory = source.BytesOrNull;
        return inMemory is not null ? new ByteArrayContent(inMemory) : new BodySourceContent(source);
    }

    /// <summary>
    /// Streams a <see cref="BodySource"/> that is not held in memory. Every send opens the source
    /// again and disposes what it opened; a stream the caller handed over is not disposed.
    /// </summary>
    private sealed class BodySourceContent : HttpContent
    {
        private readonly BodySource _source;
        private readonly long? _length;

        public BodySourceContent(BodySource source)
        {
            _source = source;
            _length = source.Length;
        }

        protected override Task SerializeToStreamAsync(Stream stream, TransportContext? context)
        {
            return SerializeToStreamAsync(stream, context, CancellationToken.None);
        }

        protected override async Task SerializeToStreamAsync(
            Stream stream,
            TransportContext? context,
            CancellationToken cancellationToken
        )
        {
            Stream opened = _source.Open();
            await using (opened.ConfigureAwait(false))
            {
                /* Every block is flushed as it is read, so a source that produces its bytes
                   slowly reaches the server as it is produced and is not held back in the
                   connection's write buffer. */
                byte[] buffer = new byte[81920];
                int read;
                while ((read = await opened.ReadAsync(buffer, cancellationToken).ConfigureAwait(false)) > 0)
                {
                    await stream.WriteAsync(buffer.AsMemory(0, read), cancellationToken).ConfigureAwait(false);
                    await stream.FlushAsync(cancellationToken).ConfigureAwait(false);
                }
            }
        }

        protected override bool TryComputeLength(out long length)
        {
            length = _length ?? 0;
            return _length.HasValue;
        }
    }

    /// <summary>
    /// Read-only view over a caller-supplied stream whose disposal never
    /// reaches the inner stream: the caller owns the stream, so the SDK must
    /// not close it when the request content is disposed.
    /// </summary>
    private sealed class CallerOwnedStream(Stream inner) : Stream
    {
        public override bool CanRead => inner.CanRead;
        public override bool CanSeek => inner.CanSeek;
        public override bool CanWrite => false;
        public override long Length => inner.Length;
        public override long Position
        {
            get => inner.Position;
            set => inner.Position = value;
        }
        public override void Flush() { }
        public override int Read(byte[] buffer, int offset, int count) => inner.Read(buffer, offset, count);
        public override int Read(Span<byte> buffer) => inner.Read(buffer);
        public override Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
            => inner.ReadAsync(buffer, offset, count, cancellationToken);
        public override ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
            => inner.ReadAsync(buffer, cancellationToken);
        public override long Seek(long offset, SeekOrigin origin) => inner.Seek(offset, origin);
        public override void SetLength(long value) => throw new NotSupportedException();
        public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();
    }
}
