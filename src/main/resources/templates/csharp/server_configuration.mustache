using System.Collections.ObjectModel;

namespace {{packageName}};

/// <summary>
/// Represents a single server entry from the OpenAPI specification.
///
/// A server URL may contain template variables (e.g.
/// <c>"https://{env}.api.example.com/v{version}"</c>). Use <see cref="GetUrl()"/>
/// to resolve the URL with default variable values, or
/// <see cref="GetUrl(Dictionary{string, string})"/> to override specific variables.
///
/// This class is immutable and thread-safe.
/// </summary>
/// <seealso cref="ServerVariable"/>
/// <param name="urlTemplate">The URL template, possibly containing <c>{variable}</c> placeholders.</param>
/// <param name="description">Human-readable description of this server, or <c>null</c>.</param>
/// <param name="variables">Map of variable names to their definitions.</param>
/// <param name="name">The name the specification gives this server, or <c>null</c>.</param>
public sealed class ServerConfiguration(
    string urlTemplate,
    string? description = null,
    Dictionary<string, ServerVariable>? variables = null,
    string? name = null
)
{
    /// <summary>
    /// The raw URL template before variable substitution.
    /// </summary>
    public string UrlTemplate { get; } = urlTemplate;

    /// <summary>
    /// Human-readable description of this server, or <c>null</c> if not specified.
    /// </summary>
    public string? Description { get; } = description;

    /// <summary>
    /// The name the specification gives this server (OpenAPI 3.2 <c>name</c>), or <c>null</c> if it has none.
    /// </summary>
    public string? Name { get; } = name;

    /// <summary>
    /// The server variables and their definitions.
    /// </summary>
    public IReadOnlyDictionary<string, ServerVariable> Variables { get; } =
        new ReadOnlyDictionary<string, ServerVariable>(
            new Dictionary<string, ServerVariable>(variables ?? [])
        );

    /// <summary>
    /// Resolve the URL template using default variable values.
    /// </summary>
    /// <returns>The fully resolved URL.</returns>
    public string GetUrl()
    {
        return GetUrl([]);
    }

    /// <summary>
    /// Resolve the URL template, substituting the given variable overrides.
    ///
    /// Variables not present in <paramref name="overrides"/> use their default values.
    /// If a variable has an enum constraint, the override value is validated
    /// against the allowed values.
    /// </summary>
    /// <param name="overrides">Variable name to value overrides.</param>
    /// <returns>The fully resolved URL.</returns>
    /// <exception cref="ArgumentException">If an override value is not in the variable's enum.</exception>
    public string GetUrl(Dictionary<string, string> overrides)
    {
        ArgumentNullException.ThrowIfNull(overrides);
        Dictionary<string, string> resolved = [];
        foreach (KeyValuePair<string, ServerVariable> entry in Variables)
        {
            string varName = entry.Key;
            ServerVariable variable = entry.Value;
            string value = overrides.TryGetValue(varName, out string? overrideValue)
                ? overrideValue
                : variable.DefaultValue;

            IReadOnlyList<string> enumValues = variable.EnumValues;
            if (enumValues.Count > 0 && !enumValues.Contains(value))
            {
                throw new ArgumentException(
                    $"Invalid value '{value}' for server variable '{varName}'. "
                        + $"Allowed values: [{string.Join(", ", enumValues)}]"
                );
            }

            resolved[varName] = value;
        }

        /* One left-to-right pass: a value that itself contains a placeholder is
         * copied as written and never expanded again. */
        System.Text.StringBuilder url = new(UrlTemplate.Length);
        int index = 0;
        while (index < UrlTemplate.Length)
        {
            if (UrlTemplate[index] == '{')
            {
                int close = UrlTemplate.IndexOf('}', index + 1);
                if (
                    close > 0
                    && resolved.TryGetValue(UrlTemplate[(index + 1)..close], out string? text)
                )
                {
                    url.Append(text);
                    index = close + 1;
                    continue;
                }
            }
            url.Append(UrlTemplate[index]);
            index++;
        }
        return url.ToString();
    }
}

/// <summary>
/// Represents a server variable from the OpenAPI specification.
///
/// Server variables define substitution parameters in server URL templates.
/// Each variable has a default value and may optionally restrict values to
/// an enumerated set.
///
/// This class is immutable and thread-safe.
/// </summary>
/// <seealso cref="ServerConfiguration"/>
/// <param name="DefaultValue">The default value used when no override is provided.</param>
/// <param name="Description">Human-readable description of the variable, or <c>null</c>.</param>
/// <param name="EnumValues">Allowed values, or an empty list if any value is accepted.</param>
public sealed record ServerVariable(
    string DefaultValue,
    string? Description,
    IReadOnlyList<string> EnumValues
)
{
    /// <summary>
    /// Allowed values, or an empty list if any value is accepted. The list is copied when
    /// the variable is created, so later changes to the caller's list do not reach it.
    /// </summary>
    public IReadOnlyList<string> EnumValues { get; init; } =
        new ReadOnlyCollection<string>([.. EnumValues]);

    /// <summary>
    /// Create a server variable with no description and no restriction on its values.
    /// </summary>
    /// <param name="defaultValue">The default value used when no override is provided.</param>
    public ServerVariable(string defaultValue)
        : this(defaultValue, null, []) { }

    /// <summary>
    /// Create a server variable with a description and no restriction on its values.
    /// </summary>
    /// <param name="defaultValue">The default value used when no override is provided.</param>
    /// <param name="description">Human-readable description of the variable, or <c>null</c>.</param>
    public ServerVariable(string defaultValue, string? description)
        : this(defaultValue, description, []) { }
}
