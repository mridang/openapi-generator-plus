<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>{{packageVersion}}</Version>
{{#appDescription}}
    <Description>{{{appDescription}}}</Description>
{{/appDescription}}
{{^appDescription}}
    <Description>Generated API client{{#appName}} for {{{appName}}}{{/appName}}</Description>
{{/appDescription}}
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- The spec test project is a separate assembly. Expose the SDK's
         `internal` members (the test-only DefaultApiClient(HttpClient[,
         TransportOptions]) seams, the internal serde/transport helpers such as
         ObjectSerializer/ValueSerializer/HeaderSelector/TraceContextUtil) to it
         so existing coverage keeps compiling without those types leaking into
         the public API surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>{{packageName}}.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- StyleCop.Analyzers dropped: hundreds of style-only SA violations
         (SA1200 using outside namespace, SA1513 brace blank-line, SA1633
         missing XML file header) that don't reflect real bugs and would
         require a template-wide restyle to satisfy. -->
  </ItemGroup>
</Project>
