{{>api_info}}

defmodule {{moduleName}}.ApiStreamResponse do
  @moduledoc """
  An HTTP response whose body has not been read yet: the status code, the
  lower-cased headers, the open body and a function that closes it. It is what
  `send_streaming/6` of an `#{inspect({{moduleName}}.ApiClient)}` returns.

  `body` is an `Enumerable` of binaries (decoded when the server compressed
  them); reading it raises `#{inspect({{moduleName}}.Errors.StreamError)}` when the
  connection fails after the headers and
  `#{inspect({{moduleName}}.Errors.NetworkTimeoutError)}` when it stays silent for
  longer than the transport's `idle_timeout`. The caller owns the body and must
  close it with `close/1`; closing aborts the connection instead of draining it.

  A non-2xx response is returned like any other, with its body open; a caller
  that does not want it reads a bounded part with `read_bounded/2`, which
  closes it, or closes it at once.
  """

  @type t :: %__MODULE__{
          status_code: integer(),
          headers: %{optional(String.t()) => String.t()},
          body: Enumerable.t(),
          close: (-> :ok)
        }

  defstruct status_code: nil,
            headers: %{},
            body: [],
            close: &__MODULE__.no_close/0

  @doc false
  @spec no_close() :: :ok
  def no_close, do: :ok

  @doc """
  Reads at most `max_bytes` of the body, closes it and returns the result as a
  buffered `#{inspect({{moduleName}}.ApiHttpResponse)}`, so the same typed error as
  a buffered call can be raised from it. The body is text for a text content
  type and Base64 text otherwise, as in a buffered response. A body that fails
  while it is read leaves an empty one.
  """
  @spec read_bounded(t(), non_neg_integer()) :: {{moduleName}}.ApiHttpResponse.t()
  def read_bounded(%__MODULE__{} = response, max_bytes) do
    bytes =
      try do
        response.body
        |> Enum.reduce_while({[], 0}, fn chunk, {parts, size} -> take(chunk, parts, size, max_bytes) end)
        |> elem(0)
        |> Enum.reverse()
        |> IO.iodata_to_binary()
      rescue
        _error -> ""
      after
        close(response)
      end

    %{{moduleName}}.ApiHttpResponse{
      status_code: response.status_code,
      body: {{moduleName}}.DefaultApiClient.response_text(bytes, response.headers),
      headers: response.headers
    }
  end

  defp take(chunk, parts, size, max_bytes) do
    kept = min(byte_size(chunk), max_bytes - size)
    parts = [binary_part(chunk, 0, kept) | parts]

    if size + kept >= max_bytes, do: {:halt, {parts, size + kept}}, else: {:cont, {parts, size + kept}}
  end

  @doc "Closes the body, which aborts the connection."
  @spec close(t()) :: :ok
  def close(%__MODULE__{close: close}), do: close.()

  # The status only: the headers (cookies, credentials) and the body never show.
  defimpl Inspect do
    def inspect(%{status_code: status_code}, _opts) do
      "#{{moduleName}}.ApiStreamResponse<status_code: #{status_code}>"
    end
  end
end
