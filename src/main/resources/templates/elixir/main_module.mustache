{{>api_info}}

defmodule {{moduleName}} do
  @moduledoc """
  {{moduleName}} API client library.

  ## Configuration

      config = {{moduleName}}.Configuration.new(
        base_url: "https://api.example.com",
        default_headers: %{"Authorization" => "Bearer token"}
      )

  ## Usage

      client = {{moduleName}}.{{clientClassName}}.with_token("https://api.example.com", "my-token")

  ## Errors

  Every error this SDK raises lives under `{{moduleName}}.Errors`:

      {{moduleName}}.Errors.OpenAPIError   # the branded grouping
      {{moduleName}}.Errors.ApiError       # an HTTP response the call could not use
      {{moduleName}}.Errors.ClientError    # 4xx grouping
      {{moduleName}}.Errors.BadRequestError
      {{moduleName}}.Errors.UnauthorizedError
      {{moduleName}}.Errors.ForbiddenError
      {{moduleName}}.Errors.NotFoundError
      {{moduleName}}.Errors.ConflictError
      {{moduleName}}.Errors.UnprocessableEntityError
      {{moduleName}}.Errors.ServerError    # 5xx grouping
      {{moduleName}}.Errors.InternalServerError
      {{moduleName}}.Errors.NetworkError   # no response at all
      {{moduleName}}.Errors.NetworkTimeoutError
      {{moduleName}}.Errors.SerializationError
      {{moduleName}}.Errors.OAuth2ServerError
      {{moduleName}}.Errors.OAuth2TokenError

  `errors/0` and `error?/1` are re-exported here so the whole tree is
  reachable from the package root, as it is in the other SDKs.
  """

  @doc """
  The canonical list of every exception module this SDK can raise. Use it
  in a single `rescue` clause to catch any SDK error.

      rescue
        e in {{moduleName}}.errors() -> handle(e)
  """
  @spec errors() :: [module(), ...]
  defdelegate errors(), to: {{moduleName}}.Errors.OpenAPIError, as: :exceptions

  @doc """
  Whether `term` is an exception raised by this SDK.
  """
  @spec error?(term()) :: boolean()
  defdelegate error?(term), to: {{moduleName}}.Errors.OpenAPIError, as: :open_api_error?
end
