{{>api_info}}

defmodule {{moduleName}}.ApiClient do
  @moduledoc """
  Behaviour for HTTP clients. Implementations must define `send_request/5`
  to perform the actual HTTP call.
  """

  @doc """
  Send an HTTP request.

  ## Parameters

    * `method` - HTTP method atom (e.g. `:get`, `:post`, `:put`, `:delete`).
    * `url` - Fully qualified URL string.
    * `headers` - Map of header names to values.
    * `body` - Request body (string, map, or nil).

  ## Returns

    An `#{inspect({{moduleName}}.ApiResponse)}` struct.
  """
  @callback send_request(
              client :: struct(),
              method :: atom(),
              url :: String.t(),
              headers :: %{optional(String.t()) => String.t()},
              body :: term() | nil
            ) :: {{moduleName}}.ApiResponse.t()

  @doc """
  Gap T6: release any resources held by the client.

  Default implementations may be a no-op when the underlying HTTP library
  uses a globally supervised connection pool (as Req/Finch does).
  Callers should still invoke `close/1` for forwards compatibility with
  implementations that own per-client state.
  """
  @callback close(client :: struct()) :: :ok
  @optional_callbacks close: 1
end
