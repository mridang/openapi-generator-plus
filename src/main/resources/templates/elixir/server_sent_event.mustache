    * `data` - The `data` field: the decoded payload when the operation declares a
      schema for it, else the text.
    * `retry` - The reconnection time in milliseconds the server asked for, or `nil`.
    * `raw` - The `data` field as text, before any decoding.
  """

  @type t :: %__MODULE__{
          id: String.t() | nil,
          event: String.t(),
          data: term(),
          retry: non_neg_integer() | nil,
          raw: String.t()
        }

  defstruct id: nil, event: "message", data: nil, retry: nil, raw: ""
end
