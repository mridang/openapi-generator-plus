defmodule {{moduleName}}.HeaderSelector do
  @moduledoc false
  # Internal: selects Accept and Content-Type headers for API requests based on
  # the MIME types declared in the OpenAPI specification. Not part of the
  # public API.

  @json_mime_pattern ~r/^application\/(json|[\w!\#$&.+\-^_]+\+json)\s*(;|$)/i

  @doc """
  Select headers for an API request.

  ## Parameters

    * `accept` - List of acceptable MIME types for the response.
    * `content_type` - The Content-Type for the request body.
    * `is_multipart` - Whether this is a multipart request.

  ## Returns

    A map of header names to values.
  """
  @spec select_headers([String.t()] | nil, String.t(), boolean()) :: %{optional(String.t()) => String.t()}
  def select_headers(accept, content_type, is_multipart) do
    headers = %{}

    headers =
      case select_accept_header(accept) do
        "" -> headers
        accept_header -> Map.put(headers, "Accept", accept_header)
      end

    headers =
      if is_multipart do
        headers
      else
        ct = if is_nil(content_type) or content_type == "", do: "application/json", else: content_type
        Map.put(headers, "Content-Type", ct)
      end

    headers
  end

  @doc """
  Detects whether a string contains a valid JSON MIME type.
  """
  @spec json_mime?(String.t() | nil) :: boolean()
  def json_mime?(nil), do: false
  def json_mime?(""), do: false

  def json_mime?(search_string) do
    Regex.match?(@json_mime_pattern, search_string)
  end

  @spec select_accept_header([String.t()] | nil) :: String.t()
  defp select_accept_header(nil), do: ""

  defp select_accept_header(accept) do
    filtered = Enum.filter(accept, fn s -> not is_nil(s) and s != "" end)

    case filtered do
      [] -> ""
      _ -> Enum.join(filtered, ", ")
    end
  end
end
