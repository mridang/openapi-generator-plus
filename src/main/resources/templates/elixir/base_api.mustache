{{>api_info}}

defmodule {{moduleName}}.Api.BaseApi do
  @moduledoc """
  Base module for all API modules. Provides the `invoke_api` function that
  handles URL construction, header selection, body serialization, request
  dispatch, and response deserialization.
  """

  @doc """
  Invoke an API operation and return the deserialized data.

  Delegates to `invoke_api_for_result/9` and returns just the data field.
  """
  @spec invoke_api(
          map(),
          atom(),
          String.t(),
          map(),
          map(),
          term(),
          [String.t()] | nil,
          String.t() | nil,
          String.t() | nil,
          map() | nil
        ) :: {:ok, term()} | {:error, term()}
  def invoke_api(state, method, path, query_params, header_params, body, accepts, content_type, return_type, auth \\ nil) do
    case invoke_api_for_result(state, method, path, query_params, header_params, body, accepts, content_type, return_type, auth) do
      {:ok, result} -> {:ok, result.data}
      {:error, _} = error -> error
    end
  end

  @doc """
  Invoke an API operation and return the full ApiResult.
  """
  @spec invoke_api_for_result(
          map(),
          atom(),
          String.t(),
          map(),
          map(),
          term(),
          [String.t()] | nil,
          String.t() | nil,
          String.t() | nil,
          map() | nil
        ) :: {:ok, {{moduleName}}.ApiResult.t()} | {:error, term()}
  def invoke_api_for_result(state, method, path, query_params, header_params, body, accepts, content_type, return_type, auth \\ nil) do
    url =
      if String.starts_with?(path, "http://") or String.starts_with?(path, "https://") do
        path
      else
        state.config.base_url <> path
      end

    effective_auth = auth || Map.get(state, :authenticator)

    query_params =
      if effective_auth && is_map(effective_auth) && Map.has_key?(effective_auth, :query_params) do
        Map.merge(query_params, effective_auth.query_params)
      else
        query_params
      end

    query_string = build_query_string(query_params)
    url = if query_string != "", do: "#{url}?#{query_string}", else: url

    is_multipart = content_type == "multipart/form-data"
    selected = {{moduleName}}.HeaderSelector.select_headers(accepts, content_type || "", is_multipart)

    headers = %{}
    headers = if selected["Accept"], do: Map.put(headers, "Accept", selected["Accept"]), else: headers
    headers = if selected["Content-Type"], do: Map.put(headers, "Content-Type", selected["Content-Type"]), else: headers
    headers = Map.merge(headers, state.config.default_headers)
    headers = Map.merge(headers, header_params)

    headers =
      if effective_auth && is_map(effective_auth) && Map.has_key?(effective_auth, :auth_headers) do
        Map.merge(headers, effective_auth.auth_headers)
      else
        headers
      end

    headers =
      if effective_auth && is_map(effective_auth) && Map.has_key?(effective_auth, :cookie_params) do
        cookies = effective_auth.cookie_params

        if map_size(cookies) > 0 do
          cookie_str = Enum.map_join(cookies, "; ", fn {k, v} -> "#{k}=#{v}" end)

          existing = Map.get(headers, "Cookie")

          cookie_value =
            if existing do
              "#{existing}; #{cookie_str}"
            else
              cookie_str
            end

          Map.put(headers, "Cookie", cookie_value)
        else
          headers
        end
      else
        headers
      end

    headers = {{moduleName}}.TraceContextUtil.inject_trace_context(headers)
    serialized_body = serialize_body(body, content_type)

    response = {{moduleName}}.DefaultApiClient.send_request(state.api_client, method, url, headers, serialized_body)

    if response.status_code < 200 or response.status_code >= 300 do
      {:error, throw_api_error(response)}
    else
      data =
        if return_type && response.body && response.body != "" do
          ct_header =
            Enum.find(response.headers, fn {k, _v} ->
              String.downcase(k) == "content-type"
            end)

          resp_content_type =
            case ct_header do
              {_k, v} -> v |> String.split(";") |> List.first() |> String.trim()
              nil -> nil
            end

          is_json =
            is_nil(resp_content_type) or
              String.starts_with?(resp_content_type, "application/json") or
              String.contains?(resp_content_type, "+json")

          if is_json do
            {{moduleName}}.ObjectSerializer.deserialize(response.body, return_type)
          else
            response.body
          end
        else
          nil
        end

      {:ok,
       %{{moduleName}}.ApiResult{
         status_code: response.status_code,
         data: data,
         raw_body: response.body,
         headers: response.headers
       }}
    end
  end

  @doc """
  Build a collection parameter string.
  """
  @spec build_collection_param([term()], atom()) :: String.t() | [String.t()]
  def build_collection_param(param, format) do
    case format do
      :ssv -> Enum.join(param, " ")
      :tsv -> Enum.join(param, "\t")
      :pipes -> Enum.join(param, "|")
      :multi -> param
      _ -> Enum.join(param, ",")
    end
  end

  defp throw_api_error(response) do
    code = response.status_code
    msg = "API returned status code #{code}"
    body = response.body

    parsed =
      if body && body != "" do
        case Jason.decode(body) do
          {:ok, data} -> data
          _ -> nil
        end
      else
        nil
      end

    err_opts = %{
      message: msg,
      status_code: code,
      response_body: body,
      response_headers: response.headers,
      error_body: parsed
    }

    cond do
      code >= 400 and code < 500 ->
        case code do
          400 -> {{moduleName}}.Errors.BadRequestError.exception(err_opts)
          401 -> {{moduleName}}.Errors.UnauthorizedError.exception(err_opts)
          403 -> {{moduleName}}.Errors.ForbiddenError.exception(err_opts)
          404 -> {{moduleName}}.Errors.NotFoundError.exception(err_opts)
          409 -> {{moduleName}}.Errors.ConflictError.exception(err_opts)
          422 -> {{moduleName}}.Errors.UnprocessableEntityError.exception(err_opts)
          _ -> {{moduleName}}.Errors.ClientError.exception(err_opts)
        end

      code >= 500 ->
        case code do
          500 -> {{moduleName}}.Errors.InternalServerError.exception(err_opts)
          _ -> {{moduleName}}.Errors.ServerError.exception(err_opts)
        end

      true ->
        {{moduleName}}.ApiError.exception(err_opts)
    end
  end

  defp build_query_string(query_params) do
    query_params
    |> Enum.reject(fn {_k, v} -> is_nil(v) end)
    |> Enum.flat_map(fn {k, v} ->
      encoded_key = URI.encode_www_form(to_string(k))

      case v do
        values when is_list(values) ->
          Enum.map(values, fn val ->
            "#{encoded_key}=#{URI.encode_www_form({{moduleName}}.ObjectSerializer.to_query_value(val))}"
          end)

        _ ->
          ["#{encoded_key}=#{URI.encode_www_form({{moduleName}}.ObjectSerializer.to_query_value(v))}"]
      end
    end)
    |> Enum.join("&")
  end

  defp serialize_body(nil, _content_type), do: nil

  defp serialize_body(body, "multipart/form-data"), do: body

  defp serialize_body(body, content_type)
       when content_type in ["application/octet-stream"] or
              (is_binary(content_type) and String.starts_with?(content_type, "image/")) do
    body
  end

  defp serialize_body(body, "text/plain"), do: to_string(body)

  defp serialize_body(body, "application/x-www-form-urlencoded"), do: URI.encode_query(body)

  defp serialize_body(body, _content_type), do: {{moduleName}}.ObjectSerializer.serialize(body)
end
