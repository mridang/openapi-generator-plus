{{>api_info}}

defmodule {{moduleName}}.CallOutcome do
  @moduledoc """
  How a call ended, as a call hook's `finish/2` sees it.

  See `#{inspect({{moduleName}}.CallHook)}`.
  """

  @typedoc """
  * `status_code` - The status of the response, or 0 when no response arrived.
  * `headers` - The response headers with lower-cased names, or `nil` when no
    response arrived.
  * `error` - The very error the caller receives, or `nil` on success. A call
    that ends with an exit or a throw carries `{:exit, reason}` or
    `{:throw, value}`.
  """
  @type t :: %__MODULE__{
          status_code: non_neg_integer(),
          headers: %{optional(String.t()) => String.t()} | nil,
          error: Exception.t() | {:exit, term()} | {:throw, term()} | nil
        }

  defstruct status_code: 0, headers: nil, error: nil
end
