defmodule {{moduleName}}.Errors.ResponseTooLargeError do
  @moduledoc """
  Exception for a buffered response whose body passed the transport's
  `max_response_bytes`, counted as received or once decompressed. The response
  arrived, so `status_code` and the lower-cased `response_headers` are the real
  ones; the body is empty because the client stopped reading it and dropped the
  connection. `limit` is the limit in bytes. It is an `ApiError` (see
  `ApiError.api_error?/1`) and is never retried.
  """

  alias {{moduleName}}.Errors.ApiError

  defexception [
    :message,
    :status_code,
    :response_headers,
    :response_body,
    :error_body,
    :cause,
    :request_method,
    :request_path,
    :limit
  ]

  @type t :: %__MODULE__{
          message: String.t(),
          status_code: integer() | nil,
          response_headers: map() | nil,
          response_body: String.t() | nil,
          error_body: term() | nil,
          cause: Exception.t() | nil,
          request_method: String.t() | nil,
          request_path: String.t() | nil,
          limit: pos_integer() | nil
        }

  @impl true
  def exception(opts) when is_list(opts), do: exception(Map.new(opts))

  def exception(opts) when is_map(opts) do
    limit = Map.get(opts, :limit)

    %__MODULE__{
      message: Map.get(opts, :message, "Response body exceeds the limit of #{limit} bytes"),
      status_code: Map.get(opts, :status_code, 0),
      response_headers: Map.get(opts, :response_headers),
      response_body: Map.get(opts, :response_body, ""),
      error_body: Map.get(opts, :error_body),
      cause: Map.get(opts, :cause),
      request_method: Map.get(opts, :request_method),
      request_path: Map.get(opts, :request_path),
      limit: limit
    }
  end

  @impl true
  def message(%__MODULE__{} = error), do: ApiError.message(struct(ApiError, Map.from_struct(error)))
end
