{{>api_info}}

defmodule {{moduleName}}.Errors.{{className}} do
  @moduledoc """
  Exception for a response whose body is a `{{moduleName}}.Models.{{schemaName}}`, declared under HTTP
  {{#statuses}}{{.}}{{^-last}}, {{/-last}}{{/statuses}}.

  It specialises `{{moduleName}}.Errors.{{parentClassName}}`: the predicates of that error and of every error
  above it accept this one, and `typed_error_body/1` returns the decoded body.
  """

  alias {{moduleName}}.Errors.ApiError

  defexception [
    :message,
    :status_code,
    :response_headers,
    :response_body,
    :error_body,
    :cause,
    :request_method,
    :request_path
  ]

  @type t :: %__MODULE__{
          message: String.t(),
          status_code: integer() | nil,
          response_headers: map() | nil,
          response_body: String.t() | nil,
          error_body: {{moduleName}}.Models.{{schemaName}}.t() | nil,
          cause: Exception.t() | nil,
          request_method: String.t() | nil,
          request_path: String.t() | nil
        }

  @impl true
  def exception(opts) when is_map(opts) do
    %__MODULE__{
      message: Map.get(opts, :message, "API returned status code #{Map.get(opts, :status_code, {{sampleStatus}})}"),
      status_code: Map.get(opts, :status_code, {{sampleStatus}}),
      response_headers: Map.get(opts, :response_headers),
      response_body: Map.get(opts, :response_body),
      error_body: Map.get(opts, :error_body),
      cause: Map.get(opts, :cause),
      request_method: Map.get(opts, :request_method),
      request_path: Map.get(opts, :request_path)
    }
  end

  def exception(opts) when is_list(opts), do: opts |> Map.new() |> exception()

  def exception(msg) when is_binary(msg), do: exception(%{message: msg})

  @impl true
  def message(%__MODULE__{} = error), do: ApiError.message(struct(ApiError, Map.from_struct(error)))

  @doc false
  # The errors this one specialises, nearest first, for the predicates of the status errors.
  @spec __ancestors__() :: [module()]
  def __ancestors__ do
    [{{#ancestorClassNames}}{{moduleName}}.Errors.{{.}}{{^-last}}, {{/-last}}{{/ancestorClassNames}}]
  end

  @doc """
  The response body decoded as `{{moduleName}}.Models.{{schemaName}}`.

  ## Returns

    The decoded error body, or `nil` when it is not available.
  """
  @spec typed_error_body(t()) :: {{moduleName}}.Models.{{schemaName}}.t() | nil
  def typed_error_body(%__MODULE__{error_body: body}), do: body

  @doc """
  Build the error for a response, decoding the body as `{{moduleName}}.Models.{{schemaName}}`.

  A body that does not match the schema never hides the real error: the result is then the error
  `ApiError.from_response/3` gives for the status, with the raw body and the decoding failure as its
  `cause`.

  ## Parameters

    * `status_code` - The HTTP status code of the response.
    * `headers` - The HTTP response headers, if available.
    * `body` - The raw HTTP response body, if available.
  """
  @spec from_error_response(integer(), map() | nil, String.t() | nil) :: Exception.t()
  def from_error_response(status_code, headers, body) do
    status = ApiError.from_response(status_code, headers, body)

    if body in [nil, ""] do
      status
    else
      try do
        case {{moduleName}}.ObjectSerializer.deserialize(body, "{{schemaName}}") do
          nil ->
            %{status | cause: %{{moduleName}}.Errors.SerializationError{message: "Error body is empty"}}

          decoded ->
            exception(%{
              message: status.message,
              status_code: status_code,
              response_headers: headers,
              response_body: body,
              error_body: decoded
            })
        end
      rescue
        error in [{{moduleName}}.Errors.SerializationError] -> %{status | cause: error}
      end
    end
  end
end
