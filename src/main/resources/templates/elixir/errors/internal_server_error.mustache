{{>api_info}}

defmodule {{moduleName}}.Errors.InternalServerError do
  @moduledoc """
  Exception for HTTP 500 Internal Server Error.
  """

  defexception [:message, :code, :response_headers, :response_body, :error_body]

  @type t :: %__MODULE__{
          message: String.t(),
          code: integer(),
          response_headers: map() | nil,
          response_body: String.t() | nil,
          error_body: term() | nil
        }

  @impl true
  def exception(opts) when is_map(opts) do
    %__MODULE__{
      message: Map.get(opts, :message, "Internal Server Error"),
      code: 500,
      response_headers: Map.get(opts, :response_headers),
      response_body: Map.get(opts, :response_body),
      error_body: Map.get(opts, :error_body)
    }
  end

  def exception(msg) when is_binary(msg), do: %__MODULE__{message: msg, code: 500}

  @impl true
  def message(%__MODULE__{} = error), do: {{moduleName}}.ApiError.message(struct({{moduleName}}.ApiError, Map.from_struct(error)))
end
