{{>api_info}}

defmodule {{moduleName}}.EventStream do
  @moduledoc """
  The line splitter and the server-sent events parser behind
  `#{inspect({{moduleName}}.SseStream)}` and `#{inspect({{moduleName}}.JsonLinesStream)}`.

  Both are pure and incremental: bytes go in as they arrive, whole lines and events come out.
  A line ends in LF, CR or CRLF (a CR at the end of one chunk and an LF at the start of the
  next is one line end), a leading byte order mark is dropped, and a line or an event longer
  than the limit raises `#{inspect({{moduleName}}.Errors.SerializationError)}`.

  The event grammar is the WHATWG one: a blank line dispatches, an event with an empty data
  buffer is not delivered but its id is kept, a line that starts with `:` is a comment, one
  space after the colon is removed, an unknown field is ignored, data lines are joined with a
  newline, an `id` that contains NUL is ignored, `retry` takes digits only, and an event that
  the end of the connection cuts off is discarded.
  """

  @type lines :: %{
          buffer: binary(),
          skip_lf: boolean(),
          first: boolean(),
          max: pos_integer()
        }

  @type raw_event :: %{id: String.t() | nil, event: String.t(), data: String.t(), retry: non_neg_integer() | nil}

  @type parser :: %{
          lines: lines(),
          data: [binary()],
          data_size: non_neg_integer(),
          name: String.t(),
          id_buffer: String.t(),
          last_event_id: String.t(),
          retry: non_neg_integer() | nil,
          max: pos_integer()
        }

  @max_reconnect_delay 30_000

  @doc "A line splitter that refuses a line longer than `max` bytes."
  @spec new_lines(pos_integer()) :: lines()
  def new_lines(max), do: %{buffer: "", skip_lf: false, first: true, max: max}

  @doc """
  Feeds one chunk to the splitter and returns the lines it completed, without their line ends.
  A line longer than the limit ends the list with `{:error, exception}`, so the lines before it
  are still delivered.
  """
  @spec split(lines(), binary()) :: {lines(), [binary() | {:error, Exception.t()}]}
  def split(lines, chunk) do
    data = lines.buffer <> chunk
    {data, skip_lf} = drop_line_feed(data, lines.skip_lf)
    scan(%{lines | buffer: "", skip_lf: skip_lf}, data, [])
  end

  @doc "The text after the last line end, or `nil` when there is none (a line the connection cut off)."
  @spec rest(lines()) :: binary() | nil
  def rest(%{buffer: ""}), do: nil
  def rest(%{buffer: buffer, first: first}), do: if(first, do: strip_bom(buffer), else: buffer)

  defp drop_line_feed(<<"\n", rest::binary>>, true), do: {rest, false}
  defp drop_line_feed(<<>>, true), do: {<<>>, true}
  defp drop_line_feed(data, _skip), do: {data, false}

  defp scan(lines, data, acc) do
    case :binary.match(data, ["\n", "\r"]) do
      :nomatch ->
        if byte_size(data) > lines.max do
          {%{lines | buffer: ""}, Enum.reverse([{:error, too_long("A line", lines.max)} | acc])}
        else
          {%{lines | buffer: data}, Enum.reverse(acc)}
        end

      {position, 1} when position > lines.max ->
        {%{lines | buffer: ""}, Enum.reverse([{:error, too_long("A line", lines.max)} | acc])}

      {position, 1} ->
        <<line::binary-size(position), terminator, rest::binary>> = data
        {rest, skip_lf} = after_terminator(terminator, rest)
        line = if lines.first, do: strip_bom(line), else: line
        scan(%{lines | skip_lf: skip_lf, first: false}, rest, [line | acc])
    end
  end

  defp after_terminator(?\r, <<"\n", rest::binary>>), do: {rest, false}
  defp after_terminator(?\r, <<>>), do: {<<>>, true}
  defp after_terminator(_terminator, rest), do: {rest, false}

  defp strip_bom(<<0xEF, 0xBB, 0xBF, rest::binary>>), do: rest
  defp strip_bom(line), do: line

  defp too_long(what, max) do
    {{moduleName}}.Errors.SerializationError.exception(message: "#{what} of the stream is longer than #{max} bytes")
  end

  @doc "A server-sent events parser; `last_event_id` is the id the stream resumes from."
  @spec new_parser(pos_integer(), String.t() | nil) :: parser()
  def new_parser(max, last_event_id \\ nil) do
    id = last_event_id || ""

    %{
      lines: new_lines(max),
      data: [],
      data_size: 0,
      name: "",
      id_buffer: id,
      last_event_id: id,
      retry: nil,
      max: max
    }
  end

  @doc "The last event id the parser has dispatched (`\"\"` for none)."
  @spec last_event_id(parser()) :: String.t()
  def last_event_id(parser), do: parser.last_event_id

  @doc "The last `retry` value the parser has read, or `nil`."
  @spec retry(parser()) :: non_neg_integer() | nil
  def retry(parser), do: parser.retry

  @doc "Feeds one chunk to the parser and returns the events it completed."
  @spec parse(parser(), binary()) :: {parser(), [raw_event() | {:error, Exception.t()}]}
  def parse(parser, chunk) do
    {lines, completed} = split(parser.lines, chunk)

    {parser, events} =
      Enum.reduce_while(completed, {%{parser | lines: lines}, []}, fn line, {state, acc} ->
        case step(state, line) do
          {state, nil} -> {:cont, {state, acc}}
          {state, {:error, _exception} = failure} -> {:halt, {state, [failure | acc]}}
          {state, event} -> {:cont, {state, [event | acc]}}
        end
      end)

    {parser, Enum.reverse(events)}
  end

  defp step(parser, {:error, _exception} = failure), do: {parser, failure}

  defp step(parser, "") do
    parser = %{parser | last_event_id: parser.id_buffer}

    if parser.data == [] do
      {%{parser | name: ""}, nil}
    else
      event = %{
        id: if(parser.last_event_id == "", do: nil, else: parser.last_event_id),
        event: if(parser.name == "", do: "message", else: parser.name),
        data: parser.data |> Enum.reverse() |> Enum.join("\n"),
        retry: parser.retry
      }

      {%{parser | data: [], data_size: 0, name: ""}, event}
    end
  end

  defp step(parser, ":" <> _comment), do: {parser, nil}

  defp step(parser, line) do
    {field, value} =
      case :binary.split(line, ":") do
        [field, value] -> {field, strip_space(value)}
        [field] -> {field, ""}
      end

    field(parser, field, value)
  end

  defp strip_space(" " <> value), do: value
  defp strip_space(value), do: value

  defp field(parser, "data", value) do
    size = parser.data_size + byte_size(value) + 1

    if size > parser.max do
      {parser, {:error, too_long("An event", parser.max)}}
    else
      {%{parser | data: [value | parser.data], data_size: size}, nil}
    end
  end

  defp field(parser, "event", value), do: {%{parser | name: value}, nil}

  defp field(parser, "id", value) do
    if String.contains?(value, <<0>>), do: {parser, nil}, else: {%{parser | id_buffer: value}, nil}
  end

  defp field(parser, "retry", value) do
    if value =~ ~r/\A[0-9]{1,17}\z/, do: {%{parser | retry: String.to_integer(value)}, nil}, else: {parser, nil}
  end

  defp field(parser, _unknown, _value), do: {parser, nil}

  @doc """
  How long to wait before reconnect number `attempt` (1 for the first): the server's `retry`
  value, else `Retry-After`, else `base` milliseconds doubling to 30 seconds, less up to 25%
  for a `jitter` sample between 0 and 1.
  """
  @spec reconnect_wait(pos_integer(), non_neg_integer(), non_neg_integer() | nil, non_neg_integer() | nil, float()) ::
          non_neg_integer()
  def reconnect_wait(_attempt, _base, server_retry, _retry_after, _jitter) when is_integer(server_retry), do: server_retry
  def reconnect_wait(_attempt, _base, _server_retry, retry_after, _jitter) when is_integer(retry_after), do: retry_after

  def reconnect_wait(attempt, base, _server_retry, _retry_after, jitter) do
    doubled = min(@max_reconnect_delay, base * Integer.pow(2, min(attempt - 1, 20)))
    trunc(doubled * (1.0 - 0.25 * jitter))
  end

  @request_keys [:timeout, :headers, :max_retries, :idle_timeout, :server, :content_type]

  @doc """
  The per-call settings of one request of a stream: the keys of `opts` an operation reads, with
  `defaults` added to its headers unless the caller set them (in any casing) and `extra` set
  over them.
  """
  @spec request_options(keyword(), [{String.t(), String.t()}], [{String.t(), String.t()}]) :: keyword()
  def request_options(opts, defaults, extra) do
    headers = opts |> Keyword.get(:headers, %{}) |> Map.new(fn {name, value} -> {to_string(name), to_string(value)} end)

    headers =
      Enum.reduce(defaults, headers, fn {name, value}, acc ->
        if has_header?(acc, name), do: acc, else: Map.put(acc, name, value)
      end)

    headers =
      Enum.reduce(extra, headers, fn {name, value}, acc ->
        acc |> Enum.reject(fn {key, _value} -> String.downcase(key) == String.downcase(name) end) |> Map.new() |> Map.put(name, value)
      end)

    opts |> Keyword.take(@request_keys) |> Keyword.put(:headers, headers)
  end

  defp has_header?(headers, name), do: Enum.any?(Map.keys(headers), &(String.downcase(&1) == String.downcase(name)))
end
