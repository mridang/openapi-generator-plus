defmodule {{moduleName}}.Auth.BaseAuthenticator do
  @moduledoc """
  Base module providing default implementations for optional `Authenticator`
  callbacks. Concrete authenticators should `use` this module.
  """

  defmacro __using__(_opts) do
    quote do
      @behaviour {{moduleName}}.Auth.Authenticator

      @impl true
      def query_params(_self), do: %{}

      @impl true
      def cookie_params(_self), do: %{}

      defoverridable query_params: 1, cookie_params: 1
    end
  end

  @doc """
  Resolve one credential of an authenticator.

  A value that was passed is used as it is. A `nil` is read once, now, from the
  environment variable `{{envPrefix}}_<FIELD>` (for the field `"TOKEN"`,
  `{{envPrefix}}_TOKEN`); an empty variable counts as unset. A credential found
  in neither place raises, so a client that is missing one fails when it is
  built and not on its first request.

  ## Parameters

    * `value` - The credential as passed, or `nil`.
    * `field` - The upper-case field name that ends the variable name.

  ## Returns

    The credential.
  """
  @spec credential(term(), String.t()) :: term()
  def credential(nil, field) do
    name = "{{envPrefix}}_" <> field

    case System.get_env(name) do
      value when value in [nil, ""] ->
        raise ArgumentError,
              "Missing the credential '#{String.downcase(field)}': pass it, or set the environment variable #{name}"

      value ->
        value
    end
  end

  def credential(value, _field), do: value
end
