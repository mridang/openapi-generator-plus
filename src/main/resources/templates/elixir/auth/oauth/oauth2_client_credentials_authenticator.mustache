defmodule {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator do
  @moduledoc """
  Authenticator for OAuth2 client credentials flow.

  Implements `HttpAwareAuthenticator` so that token exchange requests
  use the shared `ApiClient` with the same transport configuration
  (proxy, TLS, timeouts) as regular API calls.
  """

  use {{moduleName}}.Auth.BaseAuthenticator
  @behaviour {{moduleName}}.Auth.HttpAwareAuthenticator

  @type t :: %__MODULE__{
          host: String.t(),
          client_id: String.t(),
          client_secret: String.t(),
          token_url: String.t(),
          scopes: [String.t()],
          token_manager: pid() | nil
        }

  defstruct [:host, :client_id, :client_secret, :token_url, :scopes, :token_manager]

  @doc """
  Create a new client credentials authenticator.

  ## Parameters

    * `host` - API base URL.
    * `client_id` - OAuth2 client ID.
    * `client_secret` - OAuth2 client secret.
    * `token_url` - Token endpoint URL.
    * `scopes` - Requested scopes.

  """
  @spec new(String.t(), String.t(), String.t(), String.t(), [String.t()]) :: t()
  def new(host, client_id, client_secret, token_url, scopes) do
    {:ok, manager} = {{moduleName}}.Auth.OAuth.OAuth2TokenManager.start_link()

    %__MODULE__{
      host: host,
      client_id: client_id,
      client_secret: client_secret,
      token_url: token_url,
      scopes: scopes,
      token_manager: manager
    }
  end

  @impl {{moduleName}}.Auth.HttpAwareAuthenticator
  def set_api_client(%__MODULE__{} = self, client) do
    {{moduleName}}.Auth.OAuth.OAuth2TokenManager.set_api_client(self.token_manager, client)
    self
  end

  @impl {{moduleName}}.Auth.Authenticator
  def host(%__MODULE__{} = self), do: self.host

  @impl {{moduleName}}.Auth.Authenticator
  def auth_headers(%__MODULE__{} = self) do
    params = %{
      "grant_type" => "client_credentials",
      "client_id" => self.client_id,
      "client_secret" => self.client_secret
    }

    params =
      if self.scopes != [] do
        Map.put(params, "scope", Enum.join(self.scopes, " "))
      else
        params
      end

    token = {{moduleName}}.Auth.OAuth.OAuth2TokenManager.get_access_token(self.token_manager, self.token_url, params)
    %{"Authorization" => "Bearer #{token}"}
  end
end
