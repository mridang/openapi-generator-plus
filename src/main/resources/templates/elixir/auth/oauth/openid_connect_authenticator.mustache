defmodule {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator do
  @moduledoc """
  Authenticator for OpenID Connect.

  Fetches the OIDC discovery document to discover the authorization and
  token endpoints, then delegates to an `OAuth2AuthorizationCodeAuthenticator`.

  Implements `HttpAwareAuthenticator` so that both the discovery request
  and subsequent token exchange requests use the shared `ApiClient`
  with the same transport configuration (proxy, TLS, timeouts) as
  regular API calls.
  """

  use {{moduleName}}.Auth.BaseAuthenticator
  @behaviour {{moduleName}}.Auth.HttpAwareAuthenticator

  @type t :: %__MODULE__{
          host: String.t(),
          openid_connect_url: String.t(),
          client_id: String.t(),
          client_secret: String.t(),
          redirect_uri: String.t(),
          scopes: [String.t()],
          api_client: term() | nil,
          delegate: term() | nil
        }

  defstruct [
    :host,
    :openid_connect_url,
    :client_id,
    :client_secret,
    :redirect_uri,
    :scopes,
    :api_client,
    :delegate
  ]

  @doc """
  Create a new OpenID Connect authenticator.

  ## Parameters

    * `host` - API base URL.
    * `openid_connect_url` - OIDC discovery document URL.
    * `client_id` - OAuth2 client ID.
    * `client_secret` - OAuth2 client secret.
    * `redirect_uri` - Redirect URI registered with the provider.
    * `scopes` - Requested scopes.

  """
  @spec new(String.t(), String.t(), String.t(), String.t(), String.t(), [String.t()]) :: t()
  def new(host, openid_connect_url, client_id, client_secret, redirect_uri, scopes) do
    %__MODULE__{
      host: host,
      openid_connect_url: openid_connect_url,
      client_id: client_id,
      client_secret: client_secret,
      redirect_uri: redirect_uri,
      scopes: scopes,
      api_client: nil,
      delegate: nil
    }
  end

  @impl {{moduleName}}.Auth.HttpAwareAuthenticator
  def set_api_client(%__MODULE__{} = self, client) do
    %{self | api_client: client}
  end

  @doc """
  Build the authorization URL using the discovered authorization endpoint.
  """
  @spec build_authorization_url(t(), String.t() | nil) :: String.t()
  def build_authorization_url(%__MODULE__{} = self, state \\ nil) do
    self = resolve_delegate(self)
    {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(self.delegate, state)
  end

  @doc """
  Exchange an authorization code for tokens using the discovered token endpoint.
  """
  @spec exchange_code(t(), String.t()) :: t()
  def exchange_code(%__MODULE__{} = self, code) do
    self = resolve_delegate(self)
    delegate = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(self.delegate, code)
    %{self | delegate: delegate}
  end

  @impl {{moduleName}}.Auth.Authenticator
  def host(%__MODULE__{} = self), do: self.host

  @impl {{moduleName}}.Auth.Authenticator
  def auth_headers(%__MODULE__{} = self) do
    self = resolve_delegate(self)
    {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(self.delegate)
  end

  defp resolve_delegate(%__MODULE__{delegate: delegate} = self) when not is_nil(delegate), do: self

  defp resolve_delegate(%__MODULE__{api_client: nil}) do
    raise "ApiClient has not been injected. " <>
            "Ensure the {{clientClassName}} constructor calls set_api_client " <>
            "on HttpAwareAuthenticator before making API requests."
  end

  defp resolve_delegate(%__MODULE__{} = self) do
    headers = %{"Accept" => "application/json"}

    response =
      {{moduleName}}.DefaultApiClient.send_request(self.api_client, :get, self.openid_connect_url, headers, nil)

    discovery = Jason.decode!(response.body)

    delegate =
      {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.new(
        self.host,
        self.client_id,
        self.client_secret,
        discovery["authorization_endpoint"],
        discovery["token_endpoint"],
        self.redirect_uri,
        self.scopes
      )

    delegate = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(delegate, self.api_client)
    %{self | delegate: delegate}
  end
end
