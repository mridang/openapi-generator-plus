defmodule {{moduleName}}.TransportOptions do
  @moduledoc """
  Immutable HTTP transport configuration for `#{inspect({{moduleName}}.DefaultApiClient)}`.

  Controls low-level HTTP behavior such as TLS verification, proxy routing,
  timeouts, redirect handling, and automatic header injection. These settings
  are independent of API-level concerns (base URL, authentication headers)
  which belong in `#{inspect({{moduleName}}.Configuration)}`.

  This struct is immutable. Use `new/1` to create instances:

      transport = {{moduleName}}.TransportOptions.new(
        verify_ssl: false,
        proxy: "http://proxy.example.com:8080",
        timeout: 5000,
        user_agent: "MyApp/1.0"
      )
  """

  @typedoc """
  * `verify_ssl` - Whether TLS certificate verification is enabled. When `true`
    (the default), the client verifies server certificates. Set to `false` to
    accept any certificate (not recommended for production).
  * `ca_cert_path` - Path to a custom CA certificate bundle for TLS
    verification. When set together with `verify_ssl: true`, the client trusts
    certificates signed by this CA in addition to (or instead of) the system
    trust store.
  * `proxy` - HTTP or HTTPS proxy URL for all outbound requests (e.g.
    `"http://proxy.corp.example.com:3128"`). `nil` means direct connections (no
    proxy).
  * `timeout` - End-to-end request timeout in milliseconds. Covers the entire
    request lifecycle: connection, TLS handshake, sending the request body, and
    reading the response. Defaults to 60 seconds. Set to `nil` to disable the
    timeout (wait indefinitely).
  * `follow_redirects` - Whether the client follows HTTP 3xx redirects
    automatically. When `true` (the default), redirects are followed. Set to
    `false` to return the redirect response as-is.
  * `max_redirects` - Maximum number of consecutive redirects to follow. Only
    meaningful when `follow_redirects` is `true`. `nil` uses the HTTP client's
    built-in default.
  * `user_agent` - Custom `User-Agent` header value. When set, this value is
    sent as the `User-Agent` header on every request unless the caller
    explicitly provides one. `nil` means no custom user agent is injected.
  * `default_headers` - Transport-level default headers included in every
    request. These headers have the lowest priority: API-level headers from
    `#{inspect({{moduleName}}.Configuration)}`, operation-specific headers, and
    authentication headers all take precedence.
  * `inject_request_id` - Whether to auto-inject an `X-Request-ID` header with a
    unique UUID on every request. Useful for distributed tracing and log
    correlation. The header is only injected if the caller has not already set
    one.
  * `max_retries` - How many times a failed call is tried again (default `2`; `0`
    turns retries off). A call is retried after a network error that happened
    before any response, and after a response with status 408, 409, 429 or
    500 to 599 other than 501. The wait starts at 0.5 s and doubles up to 8 s,
    less up to 25% jitter; a `Retry-After` header (seconds or an HTTP date)
    replaces it, capped at 60 s. Every retry is a fresh request with its
    headers (authentication included) rebuilt. Retries never extend the
    end-to-end `timeout` and are skipped for a body that is a stream.
  * `idle_timeout` - The longest a streamed response body may stay silent, in
    milliseconds (default `60_000`; `0` or `nil` turns it off). It applies only
    to a call that returns a stream (a binary operation): `timeout` stops at the
    response headers, and this value bounds the gap between two reads of the
    body. A stalled body raises `NetworkTimeoutError`. A buffered call is
    unaffected.
  * `max_response_bytes` - The most bytes the client reads of a buffered
    response body, or `nil` (the default) for no limit. Both the bytes
    received and the bytes once decompressed (gzip, deflate, br, zstd) are
    counted, on every redirect hop that is read: the client stops as soon as
    either count passes the limit, drops the connection and raises
    `ResponseTooLargeError`. A streamed response is not bounded by it.
  * `req_options` - Extra options handed to `Req.new/1`, for a custom transport
    such as an `:adapter` function (a test double, an instrumented adapter) or
    a `:plug`. The SDK's own settings (timeouts, redirect policy,
    proxy, TLS, user agent) are applied on top and win over the same key here.
    The SDK never owns what you supply: nothing in it is closed or stopped by
    `close/1`, the caller keeps the lifecycle. Supplying `:connect_options` or
    `:finch` together with `proxy`, `ca_cert_path` or `verify_ssl: false`
    raises `ArgumentError`, because both would configure the same connection
    pool.
  """
  @type t :: %__MODULE__{
          verify_ssl: boolean(),
          ca_cert_path: String.t() | nil,
          proxy: String.t() | nil,
          timeout: non_neg_integer() | nil,
          follow_redirects: boolean(),
          max_redirects: non_neg_integer() | nil,
          user_agent: String.t() | nil,
          default_headers: %{optional(String.t()) => String.t()},
          inject_request_id: boolean(),
          max_retries: non_neg_integer(),
          idle_timeout: pos_integer() | nil,
          max_response_bytes: pos_integer() | nil,
          req_options: keyword()
        }

  defstruct verify_ssl: true,
            ca_cert_path: nil,
            proxy: nil,
            timeout: 60_000,
            follow_redirects: true,
            max_redirects: nil,
            user_agent: "{{userAgentDefault}}",
            default_headers: %{},
            inject_request_id: false,
            max_retries: 2,
            idle_timeout: 60_000,
            max_response_bytes: nil,
            req_options: []

  # The proxy URL may carry `user:pass@` credentials, the default headers may
  # carry credentials too, and req_options carry caller hooks (an adapter, a
  # plug, an auth tuple), so the Inspect representation masks all three as
  # `***` (the struct itself keeps the real values).
  defimpl Inspect do
    def inspect(options, opts) do
      masked = %{
        options
        | proxy: {{moduleName}}.TransportOptions.redact_proxy(options.proxy),
          default_headers: {{moduleName}}.TransportOptions.redact_headers(options.default_headers),
          req_options: {{moduleName}}.TransportOptions.redact_req_options(options.req_options)
      }

      Inspect.Any.inspect(masked, opts)
    end
  end

  @doc false
  @spec redact_proxy(String.t() | nil) :: String.t() | nil
  def redact_proxy(proxy) when is_binary(proxy) do
    Regex.replace(~r{\A([a-zA-Z][a-zA-Z0-9+.-]*://[^/@:]*):[^/@]*@}, proxy, "\\1:***@")
  end

  def redact_proxy(proxy), do: proxy

  # An error message names the offending proxy value, so its userinfo
  # (`user:pass@`, with or without a scheme) is replaced by `***@`.
  @spec mask_userinfo(String.t()) :: String.t()
  defp mask_userinfo(proxy) do
    Regex.replace(~r{\A((?:[a-zA-Z][a-zA-Z0-9+.-]*://)?)[^/@]*@}, proxy, "\\1***@")
  end

  @doc false
  @spec redact_headers(term()) :: term()
  def redact_headers(headers) when is_map(headers) do
    Map.new(headers, fn {name, value} ->
      if sensitive_header?(name), do: {name, "***"}, else: {name, value}
    end)
  end

  def redact_headers(headers), do: headers

  @doc false
  # Each req_options key stays visible so the printed form shows what was set;
  # every value is a caller hook and is masked.
  @spec redact_req_options(term()) :: term()
  def redact_req_options(req_options) when is_list(req_options) do
    Enum.map(req_options, fn {key, _value} -> {key, "***"} end)
  end

  def redact_req_options(req_options), do: req_options

  defp sensitive_header?(name) do
    lowered = name |> to_string() |> String.downcase()

    lowered in ["authorization", "proxy-authorization", "cookie"] or
      String.contains?(lowered, ["key", "token", "secret"])
  end

  @doc """
  Creates a new TransportOptions with the given options.

  All fields have sensible defaults:

    * `:verify_ssl` - `true`
    * `:follow_redirects` - `true`
    * `:inject_request_id` - `false`
    * `:timeout` - `60_000` (60 seconds)
    * `:max_retries` - `2`
    * `:idle_timeout` - `60_000` (60 seconds)
    * `:max_response_bytes` - `nil` (no limit)
    * `:user_agent` - a package-specific default string
    * all other fields - `nil` or empty

  ## Options

    * `:verify_ssl` - Whether TLS certificate verification is enabled.
    * `:ca_cert_path` - Path to a custom CA certificate bundle for TLS verification.
    * `:proxy` - HTTP or HTTPS proxy URL for all outbound requests.
    * `:timeout` - End-to-end request timeout in milliseconds, or `nil` for no timeout.
    * `:follow_redirects` - Whether the client follows HTTP 3xx redirects.
    * `:max_redirects` - Maximum number of consecutive redirects to follow, or `nil` for the client default.
    * `:user_agent` - Custom User-Agent header value, or `nil` to omit.
    * `:default_headers` - Transport-level default headers.
    * `:inject_request_id` - Whether to auto-inject an X-Request-ID header.
    * `:max_retries` - How many times a failed call is retried (`2` by default, `0` for none).
    * `:idle_timeout` - The longest a streamed response body may stay silent, in milliseconds (`60_000` by default; `0` or `nil` disables it).
    * `:max_response_bytes` - The most bytes read of a buffered response body, raw or decompressed, or `nil` for no limit; a body that passes it raises `ResponseTooLargeError`.
    * `:req_options` - Extra `Req.new/1` options (a custom `:adapter` or `:plug`); the SDK's own settings win. Redirect following is the SDK's job, so `redirect: true` is refused.

  ## Raises

    `ArgumentError` if `:max_retries` is not a non-negative integer, if `:idle_timeout` is negative or not an integer or `nil`, if the proxy URL is not a valid URL with an http or https scheme and a host,
    if `:timeout` is zero or negative, if `:max_response_bytes` is not a positive integer or `nil`, if `:req_options` is not a keyword list, if it carries `redirect: true`
    (the SDK manages redirects itself), or if it carries `:connect_options` or `:finch` while `proxy`, `ca_cert_path` or `verify_ssl: false` is set.

  """
  @spec new(keyword()) :: t()
  def new(opts \\ []) do
    result = struct!(__MODULE__, opts)

    unless is_integer(result.max_retries) and result.max_retries >= 0 do
      raise ArgumentError,
            "Invalid max_retries: must be a non-negative integer (got #{inspect(result.max_retries)})"
    end

    unless is_nil(result.idle_timeout) or (is_integer(result.idle_timeout) and result.idle_timeout >= 0) do
      raise ArgumentError,
            "Invalid idle_timeout: must be a non-negative number of milliseconds or nil (got #{inspect(result.idle_timeout)})"
    end

    result = if result.idle_timeout == 0, do: %{result | idle_timeout: nil}, else: result

    if is_integer(result.timeout) and result.timeout <= 0 do
      raise ArgumentError,
            "Invalid timeout: must be a positive number of milliseconds (got #{result.timeout})"
    end

    unless is_nil(result.max_response_bytes) or (is_integer(result.max_response_bytes) and result.max_response_bytes > 0) do
      raise ArgumentError,
            "Invalid maxResponseBytes: must be a positive number of bytes (got #{inspect(result.max_response_bytes)})"
    end

    unless is_nil(result.max_redirects) or (is_integer(result.max_redirects) and result.max_redirects >= 0) do
      raise ArgumentError,
            "Invalid max_redirects: must be a non-negative integer (got #{inspect(result.max_redirects)})"
    end

    if result.proxy do
      # URI.parse/1 accepts an IPv6 host with no closing bracket, so it is refused here.
      if String.contains?(result.proxy, "[") and not String.contains?(result.proxy, "]") do
        raise ArgumentError,
              "Invalid proxy URL (unterminated IPv6 literal): #{mask_userinfo(result.proxy)}"
      end

      parsed = URI.parse(result.proxy)

      unless parsed.scheme in ["http", "https"] do
        raise ArgumentError,
              "Invalid proxy URL (must use http or https scheme): #{mask_userinfo(result.proxy)}"
      end

      if is_nil(parsed.host) or parsed.host == "" do
        raise ArgumentError,
              "Invalid proxy URL (missing host): #{mask_userinfo(result.proxy)}"
      end
    end

    validate_req_options!(result)

    result
  end

  defp validate_req_options!(%__MODULE__{req_options: req_options} = result) do
    unless Keyword.keyword?(req_options) do
      raise ArgumentError, "Invalid req_options (must be a keyword list): #{inspect(req_options)}"
    end

    if Keyword.get(req_options, :redirect) == true do
      raise ArgumentError,
            "req_options :redirect conflicts with the SDK's own redirect handling; " <>
              "the SDK follows redirects itself (see follow_redirects and max_redirects)"
    end

    own_pool_settings =
      [
        proxy: result.proxy != nil,
        ca_cert_path: result.ca_cert_path != nil,
        verify_ssl: result.verify_ssl == false
      ]
      |> Enum.filter(fn {_setting, set?} -> set? end)
      |> Keyword.keys()

    if own_pool_settings != [] and (Keyword.has_key?(req_options, :connect_options) or Keyword.has_key?(req_options, :finch)) do
      raise ArgumentError,
            "req_options :connect_options/:finch conflicts with the SDK's own proxy/TLS settings " <>
              "(#{Enum.join(own_pool_settings, ", ")}); configure the connection pool in one place"
    end

    :ok
  end
end
