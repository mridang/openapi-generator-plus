{{>api_info}}

defmodule {{moduleName}}.{{clientClassName}} do
  @moduledoc """
  Unified entry point for all API services.

  Takes an `#{inspect({{moduleName}}.Auth.Authenticator)}` and optionally
  `#{inspect({{moduleName}}.TransportOptions)}`, then exposes each API group
  as a typed field. If the authenticator implements
  `#{inspect({{moduleName}}.Auth.HttpAwareAuthenticator)}`, the shared
  `ApiClient` is injected so that authentication HTTP calls (token exchange,
  discovery) use the same transport configuration as regular API calls.
{{#hasClientSchemes}}

  Each security scheme of the API also has one optional credential, named
  after the scheme: {{#clientSchemes}}`{{#lambda.elixirSnake}}{{paramName}}{{/lambda.elixirSnake}}`{{^-last}}, {{/-last}}{{/clientSchemes}}. An operation uses the
  credential of the first scheme its own security requirement lists that the
  client holds. When it holds none of them, the operation uses the
  authenticator. There is no per-call credential.
{{/hasClientSchemes}}

  ## Examples

      # Default transport
      client = {{moduleName}}.{{clientClassName}}.new(authenticator)

      # Custom transport (proxy, timeouts, etc.)
      transport = {{moduleName}}.TransportOptions.new(
        proxy: "http://proxy:3128",
        timeout: 5000
      )
      client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)
{{#hasClientSchemes}}

      # One credential per security scheme, no default authenticator
      client = {{moduleName}}.{{clientClassName}}.new(nil, nil, {{#clientSchemes}}{{#-first}}{{#lambda.elixirSnake}}{{paramName}}{{/lambda.elixirSnake}}: credential{{/-first}}{{/clientSchemes}})
{{/hasClientSchemes}}
  """

  @type t :: %__MODULE__{
          api_client: {{moduleName}}.DefaultApiClient.t(),
          authenticator: term() | nil,
          schemes: %{optional(String.t()) => term()},
{{#apiInfo}}
{{#apis}}
{{#operations}}
          {{clientPropertyName}}: {{moduleName}}.Api.{{classname}}.t(){{^-last}},{{/-last}}
{{/operations}}
{{/apis}}
{{/apiInfo}}
        }

  defstruct [
    :api_client,
    :authenticator,
{{#apiInfo}}
{{#apis}}
{{#operations}}
    :{{clientPropertyName}},
{{/operations}}
{{/apis}}
{{/apiInfo}}
    schemes: %{}
  ]

  # The security schemes the client takes a credential for: the keyword that
  # names one and the scheme's name in the spec, in the order the spec
  # declares them.
  @schemes [
{{#clientSchemes}}
    {:{{#lambda.elixirSnake}}{{paramName}}{{/lambda.elixirSnake}}, "{{{schemeId}}}"}{{^-last}},{{/-last}}
{{/clientSchemes}}
  ]

  @doc """
  Creates a new client with the given authenticator and transport options.

  If the authenticator implements `HttpAwareAuthenticator`, the shared
  `ApiClient` is injected so that token exchange and discovery requests
  use the same proxy, TLS, and timeout settings.

  ## Parameters

    * `authenticator` - Provides host URL and auth headers. It is the default
      credential: an operation uses it when the client holds no credential of
      the security scheme the operation names. May be `nil` when `schemes`
      gives at least one credential.
    * `transport_options` - HTTP transport configuration (proxy, TLS, timeouts,
      etc.).
    * `schemes` - A keyword list with one optional credential per security
      scheme, named after the scheme{{#hasClientSchemes}} ({{#clientSchemes}}`{{#lambda.elixirSnake}}{{paramName}}{{/lambda.elixirSnake}}`{{^-last}}, {{/-last}}{{/clientSchemes}}){{/hasClientSchemes}}. An operation
      uses the credential of the first scheme its spec lists that is given
      here. A key that is not a scheme of this API raises `ArgumentError`. The
      base URL comes from the first credential given, `authenticator` first.
    * `opts` - Client options. `:call_hook` is a `#{inspect({{moduleName}}.CallHook)}`
      module, or `{module, opts}`, that runs around every operation call of this
      client. Any other key raises `ArgumentError`.

  """
  @spec new(term() | nil, {{moduleName}}.TransportOptions.t() | nil, keyword(), keyword()) :: t()
  def new(authenticator, transport_options \\ nil, schemes \\ [], opts \\ []) do
    schemes = Keyword.validate!(schemes, Keyword.keys(@schemes))
    opts = Keyword.validate!(opts, [:call_hook])

    credentials =
      Enum.flat_map(@schemes, fn {key, scheme_id} ->
        case Keyword.get(schemes, key) do
          nil -> []
          credential -> [{scheme_id, credential}]
        end
      end)

    if is_nil(authenticator) and credentials == [] do
      raise ArgumentError,
            "At least one credential is required: pass an authenticator or the credential of a security scheme"
    end

    transport_options = transport_options || {{moduleName}}.TransportOptions.new()
    api_client = {{moduleName}}.DefaultApiClient.new(transport_options)

    authenticator = authenticator && inject_api_client(authenticator, api_client)
    credentials = Enum.map(credentials, fn {scheme_id, credential} -> {scheme_id, inject_api_client(credential, api_client)} end)

    host_source = authenticator || credentials |> hd() |> elem(1)
    credentials = Map.new(credentials)

    base_url = host_source.__struct__.host(host_source)

    if base_url in [nil, ""] do
      raise ArgumentError,
            "A base URL is required: the authenticator or the first scheme credential must carry a host"
    end

    config = {{moduleName}}.Configuration.new(base_url: base_url, call_hook: Keyword.get(opts, :call_hook))

    %__MODULE__{
      api_client: api_client,
      authenticator: authenticator,
      schemes: credentials,
{{#apiInfo}}
{{#apis}}
{{#operations}}
      {{clientPropertyName}}: {{moduleName}}.Api.{{classname}}.new(api_client, config, authenticator, credentials){{^-last}},{{/-last}}
{{/operations}}
{{/apis}}
{{/apiInfo}}
    }
  end

  defp inject_api_client(authenticator, api_client) do
    if is_map(authenticator) and Map.has_key?(authenticator, :__struct__) and
         function_exported?(authenticator.__struct__, :set_api_client, 2) do
      authenticator.__struct__.set_api_client(authenticator, api_client)
    else
      authenticator
    end
  end

  @doc """
  Creates a client authenticated with a static Bearer token.

  ## Parameters

    * `host` - API base URL.
    * `access_token` - Bearer token.
    * `transport_options` - Optional HTTP transport configuration (proxy, TLS,
      timeouts, etc.).
    * `opts` - Client options, as for `new/4` (`:call_hook`).

  ## Returns

    A configured client instance.
  """
  @spec with_token(String.t(), String.t(), {{moduleName}}.TransportOptions.t() | nil, keyword()) :: t()
  def with_token(host, access_token, transport_options \\ nil, opts \\ []) do
    new({{moduleName}}.Auth.BearerAuthenticator.new(host, access_token), transport_options, [], opts)
  end

  @doc """
  Creates a client from a ready-made authenticator.

  This is the generic entry point for bespoke authentication strategies such as
  OAuth2 client credentials, JWT private-key (service account), or a personal
  access token (PAT). Supply any `#{inspect({{moduleName}}.Auth.Authenticator)}`
  implementation; if it also implements
  `#{inspect({{moduleName}}.Auth.HttpAwareAuthenticator)}`, the shared
  `ApiClient` is injected so its HTTP calls reuse the same transport
  configuration.

  ## Parameters

    * `authenticator` - Provides host URL and auth headers.
    * `transport_options` - Optional HTTP transport configuration (proxy, TLS,
      timeouts, etc.).
    * `opts` - Client options, as for `new/4` (`:call_hook`).

  ## Returns

    A configured client instance.
  """
  @spec with_authenticator(term(), {{moduleName}}.TransportOptions.t() | nil, keyword()) :: t()
  def with_authenticator(authenticator, transport_options \\ nil, opts \\ []) do
    new(authenticator, transport_options, [], opts)
  end

  @doc """
  Closes the client. Idempotent.

  A call that starts after `close/1` raises `RuntimeError` ("ApiClient has been
  closed and can no longer send requests"). A call already in flight finishes
  first. The processes the SDK started for the client (the token managers and
  the discovery cache of the authenticators) are stopped when the last such
  call is over, or at once when none is in flight. The HTTP pool belongs to Req
  and Finch, and a transport supplied through `TransportOptions` `req_options`
  is never closed by the SDK.
  """
  @spec close(t()) :: :ok
  def close(%__MODULE__{api_client: api_client} = client) do
    :ok = {{moduleName}}.DefaultApiClient.close(api_client)

    if {{moduleName}}.DefaultApiClient.claim_release(api_client) do
      {{moduleName}}.Api.BaseApi.release_authenticators([client.authenticator | Map.values(client.schemes)])
    end

    :ok
  end
end
