{{>api_info}}

defmodule {{moduleName}}.Api.ResponseHeaders.{{className}} do
  @moduledoc """
  The headers the success response of the `{{operationId}}` operation declares, in their
  declared types. `from_headers/1` reads them from the `headers` of the `ApiResult` that
  the `_with_http_info` function returns; a header the response does not carry is `nil`.
  """

  @typedoc """
{{#headers}}
  * `{{name}}` - The `{{wireName}}` header.{{#hasDescription}} {{{description}}}{{/hasDescription}}
{{#hasExample}}

    Example:

        {{#lambda.elixirHeredoc}}{{{example}}}{{/lambda.elixirHeredoc}}

{{/hasExample}}
{{/headers}}
  """
  @type t :: %__MODULE__{
{{#headers}}
          {{name}}: {{{typespec}}} | nil,
{{/headers}}
        }

  defstruct [
{{#headers}}
    {{name}}: nil,
{{/headers}}
  ]

  @doc """
  Reads the declared headers from a response header map, matching each name in any letter
  case. Raises `{{moduleName}}.Errors.SerializationError` when a header value does not parse
  as its declared type.
  """
  @spec from_headers(%{optional(String.t()) => String.t()} | nil) :: t()
  def from_headers(headers) do
    lowered = Map.new(headers || %{}, fn {name, value} -> {String.downcase(to_string(name), :ascii), value} end)

    %__MODULE__{
{{#headers}}
{{#plainText}}
      {{name}}: header(lowered, "{{lowerName}}"),
{{/plainText}}
{{#textList}}
      {{name}}: with_value(header(lowered, "{{lowerName}}"), &split/1),
{{/textList}}
{{#parsedScalar}}
      {{name}}: with_value(header(lowered, "{{lowerName}}"), &{{parser}}(&1, "{{wireName}}", "{{kind}}")),
{{/parsedScalar}}
{{#parsedList}}
      {{name}}: with_value(header(lowered, "{{lowerName}}"), fn value -> Enum.map(split(value), &{{parser}}(&1, "{{wireName}}", "{{kind}}")) end),
{{/parsedList}}
{{/headers}}
    }
  end

  defp header(lowered, name), do: Map.get(lowered, name)
{{#usesWithValue}}

  defp with_value(nil, _parse), do: nil
  defp with_value(value, parse), do: parse.(value)
{{/usesWithValue}}
{{#usesSplit}}

  defp split(value), do: value |> String.split(",") |> Enum.map(&String.trim/1)
{{/usesSplit}}
{{#usesInteger}}

  defp parse_integer(value, wire_name, kind) do
    case Integer.parse(value) do
      {number, ""} -> number
      _ -> invalid!(wire_name, kind, value)
    end
  end
{{/usesInteger}}
{{#usesNumber}}

  defp parse_number(value, wire_name, kind) do
    case Float.parse(value) do
      {number, ""} -> number
      _ -> invalid!(wire_name, kind, value)
    end
  end
{{/usesNumber}}
{{#usesBoolean}}

  defp parse_boolean("true", _wire_name, _kind), do: true
  defp parse_boolean("false", _wire_name, _kind), do: false
  defp parse_boolean(value, wire_name, kind), do: invalid!(wire_name, kind, value)
{{/usesBoolean}}
{{#usesParser}}

  @spec invalid!(String.t(), String.t(), String.t()) :: no_return()
  defp invalid!(wire_name, kind, value) do
    raise {{moduleName}}.Errors.SerializationError,
      message: "Response header '#{wire_name}' is not a valid #{kind}: '#{value}'"
  end
{{/usesParser}}
end
