defmodule {{moduleName}}.Auth.Authenticator do
  @moduledoc """
  Behaviour for providing authentication credentials to the API client.
  Implementations supply the API host URL and authorization headers.
  """

  @doc "Returns the base URL of the API."
  @callback host(term()) :: String.t()

  @doc "Returns the authentication headers to include in every request."
  @callback auth_headers(term()) :: %{optional(String.t()) => String.t()}

  @doc "Returns query parameters to include for authentication."
  @callback query_params(term()) :: %{optional(String.t()) => String.t()}

  @doc "Returns cookie parameters to include for authentication."
  @callback cookie_params(term()) :: %{optional(String.t()) => String.t()}
end
