  # ---------------------------------------------------------------------------
  # A 401 on an OAuth2 call: drop the cached token and replay once
  # ---------------------------------------------------------------------------

  defp token_answer(authorized_status) do
    fn url, headers, requests ->
      if String.ends_with?(url, "/token") do
        issued = Enum.count(requests, fn {requested, _} -> String.ends_with?(requested, "/token") end)

        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          headers: %{},
          body: Jason.encode!(%{"access_token" => "tok#{issued}", "expires_in" => 3600})
        }
      else
        %{{moduleName}}.ApiHttpResponse{
          status_code: authorized_status.(headers["Authorization"]),
          headers: %{},
          body: ""
        }
      end
    end
  end

  defp oauth_state(client) do
    auth =
      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "https://api.example.com",
        "my-client-id",
        "my-client-secret",
        "https://auth.example.com/token",
        []
      )

    auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, client)

    %{
      config: {{moduleName}}.Configuration.new(base_url: "https://api.example.com"),
      api_client: client,
      authenticator: auth
    }
  end

  defp api_requests(client) do
    client |> ScriptedApiClient.requests() |> Enum.reject(fn {url, _} -> String.ends_with?(url, "/token") end)
  end

  defp token_requests(client) do
    client |> ScriptedApiClient.requests() |> Enum.filter(fn {url, _} -> String.ends_with?(url, "/token") end)
  end

  defp put_thing(state, body, content_type) do
    {{moduleName}}.Api.BaseApi.invoke_api(
      state, :put, "/things", %{}, %{}, body, ["application/json"], content_type, nil
    )
  end

  test "bhv retries 001 a 401 drops the OAuth2 access token and replays the request once with a fresh one" do
    client =
      ScriptedApiClient.new(
        token_answer(fn
          "Bearer tok1" -> 401
          _ -> 200
        end)
      )

    assert {:ok, _} = put_thing(oauth_state(client), nil, "application/json")

    assert Enum.map(api_requests(client), fn {_, headers} -> headers["Authorization"] end) ==
             ["Bearer tok1", "Bearer tok2"]

    assert length(token_requests(client)) == 2
  end

  test "bhv retries 008 a second 401 is the usual UnauthorizedError and is not replayed again" do
    client = ScriptedApiClient.new(token_answer(fn _ -> 401 end))

    assert {:error, %{{moduleName}}.Errors.UnauthorizedError{status_code: 401}} =
             put_thing(oauth_state(client), nil, "application/json")

    assert length(api_requests(client)) == 2
    assert length(token_requests(client)) == 2
  end

  test "bhv authintegration 001 a failed re-authentication leaves the 401 as it is" do
    client =
      ScriptedApiClient.new(fn url, _headers, requests ->
        if String.ends_with?(url, "/token") do
          issued = Enum.count(requests, fn {requested, _} -> String.ends_with?(requested, "/token") end)

          if issued == 1 do
            %{{moduleName}}.ApiHttpResponse{status_code: 200, headers: %{}, body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})}
          else
            %{{moduleName}}.ApiHttpResponse{status_code: 500, headers: %{}, body: ""}
          end
        else
          %{{moduleName}}.ApiHttpResponse{status_code: 401, headers: %{}, body: ""}
        end
