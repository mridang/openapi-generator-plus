  test "bhv retries 002 a 401 is never replayed for a bearer token or an operation without authentication" do
    client = ScriptedApiClient.new(token_answer(fn _ -> 401 end))

    bearer = {{moduleName}}.Auth.BearerAuthenticator.new("https://api.example.com", "t")
    state = %{oauth_state(client) | authenticator: bearer}

    assert {:error, %{{moduleName}}.Errors.UnauthorizedError{}} = put_thing(state, nil, "application/json")
    assert length(api_requests(client)) == 1

    no_auth = %{oauth_state(client) | authenticator: nil}

    assert {:error, %{{moduleName}}.Errors.UnauthorizedError{}} = put_thing(no_auth, nil, "application/json")
    assert length(api_requests(client)) == 2
