  # R5-1: a config default header wins over the operation-negotiated value.
  # The header selector negotiates Accept: application/json for this operation,
  # but the config default Accept: application/xml must override it because
  # base_api merges config.default_headers OVER the selected headers.
  test "bhv operations 008 config default Accept wins over operation-negotiated Accept", %{chasm_url: chasm_url} do
    config =
      {{moduleName}}.Configuration.new(
        base_url: chasm_url,
        default_headers: %{"Accept" => "application/xml"}
      )

    state = %{config: config, api_client: {{moduleName}}.DefaultApiClient.new()}

    assert {:ok, result} =
             {{moduleName}}.Api.BaseApi.invoke_api(state, :get, "/test/echo", %{}, %{}, nil, ["application/json"], "application/json", "Object")

    assert result["headers"]["accept"] == "application/xml"
  end

  test "bhv options 001 config default Accept overrides operation-negotiated Accept", %{chasm_url: chasm_url} do
    config =
      {{moduleName}}.Configuration.new(
        base_url: chasm_url,
        default_headers: %{"Accept" => "application/xml"}
      )

    state = %{config: config, api_client: {{moduleName}}.DefaultApiClient.new()}

    assert {:ok, result} =
             {{moduleName}}.Api.BaseApi.invoke_api(state, :get, "/test/echo", %{}, %{}, nil, ["application/json"], "application/json", "Object")

    # chasm echoes request headers (lowercased) under .headers; config wins
    assert result["headers"]["accept"] == "application/xml"
  end

  test "bhv operations 004 an explicit Accept header parameter beats the config default and the negotiated Accept", %{chasm_url: chasm_url} do
