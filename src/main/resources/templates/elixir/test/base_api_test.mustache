  # ---------------------------------------------------------------------------
  # Several 2xx responses: the body is decoded by the status that arrived
  # ---------------------------------------------------------------------------

  defmodule TwoSuccessApiClient do
    # A module-style api_client: BaseApi calls send_request/4 on it directly.
    def send_request(_method, _url, _headers, _body) do
      {status, body} = Process.get(:two_success_answer)

      %{{moduleName}}.ApiHttpResponse{
        status_code: status,
        body: body,
        headers: %{"Content-Type" => "application/json"}
      }
    end
  end

  defp decode_as(return_type, status) do
    Process.put(:two_success_answer, {status, ~s({"id":1,"name":"x"})})
    state = %{config: {{moduleName}}.Configuration.new(base_url: "http://localhost"), api_client: TwoSuccessApiClient}

    {{moduleName}}.Api.BaseApi.invoke_api(
      state, :post, "/things", %{}, %{}, nil, ["application/json"], "application/json", return_type
    )
  end

  test "several 2xx responses decode as the type of the status that arrived" do
    return_type = {"Tag", [{"200", "Category"}, {"201", "Tag"}, {"2XX", "Category"}]}

    assert {:ok, %{{moduleName}}.Models.Category{id: 1, name: "x"}} = decode_as(return_type, 200)
    assert {:ok, %{{moduleName}}.Models.Tag{id: 1, name: "x"}} = decode_as(return_type, 201)
    assert {:ok, %{{moduleName}}.Models.Category{id: 1, name: "x"}} = decode_as(return_type, 202)
  end

  test "a 2xx that no row names decodes as the union" do
    return_type = {"Tag", [{"200", "Category"}]}

    assert {:ok, %{{moduleName}}.Models.Category{}} = decode_as(return_type, 200)
    assert {:ok, %{{moduleName}}.Models.Tag{}} = decode_as(return_type, 201)
  end

  test "bhv retries 007 a status outside the retry set is not replayed" do
    for status <- [200, 301, 400, 401, 404, 422, 501, 600] do
      refute {{moduleName}}.Api.BaseApi.retryable_status?(status)
    end
  end

  test "the retryable statuses are 408, 409, 429 and 5xx other than 501" do
    for status <- [408, 409, 429, 500, 502, 503, 599] do
      assert {{moduleName}}.Api.BaseApi.retryable_status?(status)
    end
  end

  test "bhv retries 027 backoff doubles from half a second to eight seconds with quarter jitter" do
    # 0.5 s doubling to 8 s, less up to 25% jitter.
    assert Enum.map(1..6, &{{moduleName}}.Api.BaseApi.backoff_delay(&1, 0.0)) ==
             [500, 1_000, 2_000, 4_000, 8_000, 8_000]

    assert {{moduleName}}.Api.BaseApi.backoff_delay(1, 1.0) == 375
    assert {{moduleName}}.Api.BaseApi.backoff_delay(9, 1.0) == 6_000
  end

  test "retry_after_ms reads a Retry-After given in seconds" do
    now = ~U[1994-11-06 08:49:00Z]
    retry_after = &{{moduleName}}.Api.BaseApi.retry_after_ms(&1, now)

    assert retry_after.(%{"retry-after" => "5"}) == 5_000
    assert retry_after.(%{"Retry-After" => " 0 "}) == 0
    assert retry_after.(%{"retry-after" => "soon"}) == nil
    assert retry_after.(%{"x-other" => "1"}) == nil
    assert retry_after.(nil) == nil
  end

  test "bhv retries 022 Retry-After as an HTTP date is honoured" do
    now = ~U[1994-11-06 08:49:00Z]
    retry_after = &{{moduleName}}.Api.BaseApi.retry_after_ms(&1, now)

    assert retry_after.(%{"retry-after" => "Sun, 06 Nov 1994 08:49:37 GMT"}) == 37_000
    assert retry_after.(%{"retry-after" => "Sun, 06 Nov 1994 08:48:00 GMT"}) == 0
  end

  test "bhv retries 023 Retry-After is capped at 60 seconds" do
    now = ~U[1994-11-06 08:49:00Z]
    retry_after = &{{moduleName}}.Api.BaseApi.retry_after_ms(&1, now)

    assert retry_after.(%{"retry-after" => "120"}) == 60_000
    assert retry_after.(%{"retry-after" => "Sun, 06 Nov 1994 18:49:37 GMT"}) == 60_000
  end
