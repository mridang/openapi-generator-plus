  test "an error without a response names the request too" do
    state = retry_state([{:transport_error, :econnrefused}], max_retries: 0)

    assert {:error, %{{moduleName}}.Errors.NetworkError{} = error} = get_thing(state)
    assert error.request_method == "GET"
    assert error.request_path == "/things"
