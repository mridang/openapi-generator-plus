             {{moduleName}}.Api.BaseApi.invoke_api(state, :get, "/test/echo", %{}, %{"Accept" => "text/plain"}, nil, ["application/json"], "application/json", "Object")

    assert result["headers"]["accept"] == "text/plain"
  end

  # Body serialization

  test "bhv serializationwire 022 serializes JSON body for POST", %{state: state} do
    body = %{"name" => "TestPet", "photoUrls" => []}
    result = {{moduleName}}.Api.BaseApi.invoke_api(state, :post, "/test/echo", %{}, %{}, body, ["application/json"], "application/json", "Object")

    case result do
      {:ok, parsed} ->
        # chasm envelope: .body holds the raw request body as a string
        assert parsed["method"] == "POST"
        assert is_binary(parsed["body"])
        assert String.contains?(parsed["body"], "TestPet")
      {:error, _} ->
        # The echo endpoint may not be reachable; that's OK for this test
        :ok
    end
  end

