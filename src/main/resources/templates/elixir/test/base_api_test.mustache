  # ---------------------------------------------------------------------------
  # Automatic retries
  # ---------------------------------------------------------------------------

  # Builds a state whose client answers from `script` (a status, a
  # `{status, headers}` pair or `{:transport_error, reason}`; the last entry
  # repeats) and sends one `{:attempt, request}` message per attempt.
  defp retry_state(script, transport_options \\ [], authenticator \\ nil) do
    test_pid = self()
    {:ok, steps} = Agent.start_link(fn -> script end)

    adapter = fn request ->
      send(test_pid, {:attempt, request})

      step =
        Agent.get_and_update(steps, fn
          [only] -> {only, [only]}
          [first | rest] -> {first, rest}
        end)

      {request, adapter_answer(step)}
    end

    transport = {{moduleName}}.TransportOptions.new([req_options: [adapter: adapter]] ++ transport_options)

    %{
      config: {{moduleName}}.Configuration.new(base_url: "http://retry.invalid"),
      api_client: {{moduleName}}.DefaultApiClient.new(transport),
      authenticator: authenticator
    }
  end

  defp adapter_answer({:transport_error, reason}), do: %Req.TransportError{reason: reason}
  defp adapter_answer({status, headers}), do: Req.Response.new(status: status, headers: headers, body: "")
  defp adapter_answer(status), do: Req.Response.new(status: status, body: "")

  defp attempts(acc \\ []) do
    receive do
      {:attempt, request} -> attempts(acc ++ [request])
    after
      0 -> acc
    end
  end

  defp get_thing(state) do
    {{moduleName}}.Api.BaseApi.invoke_api(
      state, :get, "/things", %{}, %{}, nil, ["application/json"], "application/json", nil
    )
  end

  test "bhv retries 021 a call is retried on 408, 409, 429 and 5xx other than 501, and then succeeds" do
    for status <- [408, 409, 429, 500, 502, 503, 504] do
      state = retry_state([{status, [{"retry-after", "0"}]}, 200])

      assert {:ok, _} = get_thing(state)
      assert length(attempts()) == 2, "status #{status} must be retried once"
    end
  end

  test "bhv retries 024 a call that keeps failing is tried max_retries + 1 times and reports the last response" do
    state = retry_state([{500, [{"retry-after", "0"}]}])

    assert {:error, %{{moduleName}}.Errors.InternalServerError{status_code: 500}} = get_thing(state)
    assert length(attempts()) == 3

    one_retry = retry_state([{500, [{"retry-after", "0"}]}], max_retries: 1)

    assert {:error, %{{moduleName}}.Errors.InternalServerError{}} = get_thing(one_retry)
    assert length(attempts()) == 2
  end

  test "bhv retries 018 max_retries 0 sends the request once" do
    state = retry_state([{503, [{"retry-after", "0"}]}, 200], max_retries: 0)

    assert {:error, %{{moduleName}}.Errors.ServerError{status_code: 503}} = get_thing(state)
    assert length(attempts()) == 1
  end

  test "400, 401, 403, 404, 422 and 501 are not retried" do
    for status <- [400, 401, 403, 404, 422, 501] do
      state = retry_state([{status, [{"retry-after", "0"}]}, 200])

      assert {:error, _} = get_thing(state)
      assert length(attempts()) == 1, "status #{status} must not be retried"
    end
  end

  test "bhv retries 013 a network error before any response is retried" do
    state = retry_state([{:transport_error, :econnrefused}, 200], max_retries: 1)

    assert {:ok, _} = get_thing(state)
    assert length(attempts()) == 2

    failing = retry_state([{:transport_error, :econnrefused}], max_retries: 1)

    assert {:error, %{{moduleName}}.Errors.NetworkError{}} = get_thing(failing)
    assert length(attempts()) == 2
  end

  test "a request that timed out is not retried" do
    state = retry_state([{:transport_error, :timeout}, 200])

    assert {:error, %{{moduleName}}.Errors.NetworkTimeoutError{}} = get_thing(state)
    assert length(attempts()) == 1
  end

  test "bhv retries 026 Retry-After sets the wait before the retry" do
    state = retry_state([{429, [{"retry-after", "1"}]}, 200])
    started = System.monotonic_time(:millisecond)

    assert {:ok, _} = get_thing(state)
    assert System.monotonic_time(:millisecond) - started >= 1_000
    assert length(attempts()) == 2
  end

  test "bhv retries 025 a retry never waits past the end-to-end timeout" do
    started = System.monotonic_time(:millisecond)

    asked = retry_state([{503, [{"retry-after", "5"}]}, 200], timeout: 300)
    assert {:error, %{{moduleName}}.Errors.ServerError{}} = get_thing(asked)
    assert length(attempts()) == 1

    backoff = retry_state([503, 200], timeout: 100)
    assert {:error, %{{moduleName}}.Errors.ServerError{}} = get_thing(backoff)
    assert length(attempts()) == 1

    assert System.monotonic_time(:millisecond) - started < 1_000
  end

  test "bhv retries 028 cancelling the caller during the wait stops the retrying" do
    state = retry_state([503, 200])
    caller = Task.async(fn -> get_thing(state) end)

    assert_receive {:attempt, _request}, 2_000
    Task.shutdown(caller, :brutal_kill)

    refute_receive {:attempt, _request}, 1_000
  end

  test "bhv retries 005 every retry rebuilds the request, authentication headers included" do
    {:ok, counter} = Agent.start_link(fn -> 0 end)
    auth = %CountingAuthenticator{counter: counter}
    state = retry_state([{503, [{"retry-after", "0"}]}, {503, [{"retry-after", "0"}]}, 200], [], auth)

    assert {:ok, _} = get_thing(state)

    assert Enum.map(attempts(), &Req.Request.get_header(&1, "x-attempt")) == [["n1"], ["n2"], ["n3"]]
  end

  defp get_thing_with(state, call, query_params \\ %{}, header_params \\ %{}) do
    {{moduleName}}.Api.BaseApi.invoke_api(
      state, :get, "/things", query_params, header_params, nil, ["application/json"], "application/json", nil, nil, call
    )
  end

  test "bhv retries 014 a per-call max_retries of 0 disables the retries the transport allows" do
    state = retry_state([{500, [{"retry-after", "0"}]}])

    assert {:error, _} = get_thing_with(state, max_retries: 0)
    assert length(attempts()) == 1
  end

  test "bhv retries 004 a per-call max_retries replaces the transport's for that call only" do
    state = retry_state([{500, [{"retry-after", "0"}]}])

    assert {:error, _} = get_thing_with(state, max_retries: 3)
    assert length(attempts()) == 4

    assert {:error, _} = get_thing(state)
    assert length(attempts()) == 3

    no_retries = retry_state([{503, [{"retry-after", "0"}]}], max_retries: 0)

    assert {:error, _} = get_thing_with(no_retries, max_retries: 1)
    assert length(attempts()) == 2
  end

  test "bhv operations 001 per-call headers are sent, replace a header of the same name in any casing and leave the next call alone" do
    state = retry_state([200])

    assert {:ok, _} = get_thing_with(state, [headers: %{"X-Trace" => "call", "X-Other" => "1"}], %{}, %{"x-trace" => "op"})

    [request] = attempts()
    assert Req.Request.get_header(request, "x-trace") == ["call"]
    assert Req.Request.get_header(request, "x-other") == ["1"]

    assert {:ok, _} = get_thing(state)

    [request] = attempts()
    assert Req.Request.get_header(request, "x-other") == []
  end

  test "a per-call timeout bounds that call and a Retry-After past it is not waited for" do
    state = retry_state([{503, [{"retry-after", "5"}]}, 200])
    started = System.monotonic_time(:millisecond)

    assert {:error, %{{moduleName}}.Errors.ServerError{}} = get_thing_with(state, timeout: 300)
    assert length(attempts()) == 1
    assert System.monotonic_time(:millisecond) - started < 1_000
  end

  test "call_settings reads the options struct, lets opts win and leaves nil out" do
    options = %{timeout: 5, headers: %{"a" => "1"}, max_retries: nil, other: 1}

    assert Enum.sort({{moduleName}}.Api.BaseApi.call_settings(options, timeout: 9)) ==
             [headers: %{"a" => "1"}, timeout: 9]

    assert {{moduleName}}.Api.BaseApi.call_settings(nil, []) == []
    assert {{moduleName}}.Api.BaseApi.call_settings(nil, headers: [{:"x-a", 1}]) == [headers: %{"x-a" => "1"}]
  end

  test "bhv retries 009 call_settings rejects an invalid timeout, max_retries or headers" do
    for {opts, message} <- [
          {[timeout: 0], "Invalid timeout: must be a positive number of milliseconds (got 0)"},
          {[timeout: 1.5], "Invalid timeout: must be a positive number of milliseconds (got 1.5)"},
          {[max_retries: -1], "Invalid max_retries: must be a non-negative integer (got -1)"},
          {[headers: "x"], "Invalid headers: must be a map of header names to values (got \"x\")"},
          {[headers: [:a]], "Invalid headers: must be a map of header names to values (got [:a])"}
        ] do
      err = assert_raise ArgumentError, fn -> {{moduleName}}.Api.BaseApi.call_settings(nil, opts) end
      assert err.message == message
