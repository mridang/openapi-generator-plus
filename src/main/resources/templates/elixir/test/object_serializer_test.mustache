      beyond = String.duplicate("[", 1500) <> String.duplicate("]", 1500)

      err =
        assert_raise {{moduleName}}.Errors.SerializationError, fn ->
          {{moduleName}}.ObjectSerializer.deserialize(beyond, "Object")
        end

      assert err.message ==
