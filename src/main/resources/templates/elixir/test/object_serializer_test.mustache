  describe "serialize/1" do
    test "serializes a model to valid JSON" do
      category = %{{moduleName}}.Models.Category{id: 1, name: "Dogs"}
      json = {{moduleName}}.ObjectSerializer.serialize(category)
      data = Jason.decode!(json)
      assert data["id"] == 1
      assert data["name"] == "Dogs"
