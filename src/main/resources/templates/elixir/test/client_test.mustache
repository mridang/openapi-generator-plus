    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", fn -> "provider-token" end)
    client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)
    state = %{
      api_client: client.api_client,
      authenticator: client.authenticator,
      scheme_authenticators: client.schemes,
      config: {{moduleName}}.Configuration.new(base_url: "http://closing.invalid")
    }

    assert {:ok, _result} = {{moduleName}}.Api.BaseApi.invoke_api_for_result(state, :get, "/slow", %{}, %{}, nil, ["application/json"], "application/json", nil, {{moduleName}}.Api.BaseApi.scheme_auth(state, []))
    assert_received {:authorization, ["Bearer provider-token"]}
  end

  test "bhv misc 067 a token provider that raises fails the request with that same error" do
