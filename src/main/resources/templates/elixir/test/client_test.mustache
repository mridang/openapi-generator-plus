  test "bhv misc 065 scheme credentials are copied when the client is built" do
    credential = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "first-token")

    client =
      {{moduleName}}.{{clientClassName}}.new(nil, nil, {{#clientSchemes}}{{#-first}}{{#lambda.elixirSnake}}{{paramName}}{{/lambda.elixirSnake}}: credential{{/-first}}{{/clientSchemes}})

    credential = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "second-token")

    assert {{moduleName}}.Auth.BearerAuthenticator.auth_headers(client.schemes[{{#clientSchemes}}{{#-first}}"{{{schemeId}}}"{{/-first}}{{/clientSchemes}}])["Authorization"] == "Bearer first-token"
    assert credential != client.schemes[{{#clientSchemes}}{{#-first}}"{{{schemeId}}}"{{/-first}}{{/clientSchemes}}]
  end

