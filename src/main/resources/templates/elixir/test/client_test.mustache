{{#generateTests}}
defmodule {{moduleName}}.ClientTest do
  use ExUnit.Case, async: true

  test "construct with authenticator only" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")

    client = {{moduleName}}.{{clientClassName}}.new(authenticator)

    assert %{{moduleName}}.{{clientClassName}}{} = client
  end

  test "construct with authenticator and nil transport options" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")

    client = {{moduleName}}.{{clientClassName}}.new(authenticator, nil)

    assert %{{moduleName}}.{{clientClassName}}{} = client
  end

  test "construct with authenticator and transport options" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")
    transport = {{moduleName}}.TransportOptions.new()

    client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)

    assert %{{moduleName}}.{{clientClassName}}{} = client
  end

  test "construct with a custom Req adapter in the transport options" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")
    adapter = fn request -> {request, Req.Response.new(status: 200)} end
    transport = {{moduleName}}.TransportOptions.new(req_options: [adapter: adapter])

    client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)

    assert %{{moduleName}}.{{clientClassName}}{} = client
  end

  test "close releases the transport and the authenticator's token manager" do
    authenticator =
      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "{{{basePath}}}",
        "id",
        "secret",
        "https://auth.example.com/token",
        []
      )

    client = {{moduleName}}.{{clientClassName}}.new(authenticator)
    manager = authenticator.token_manager
    assert Process.alive?(manager)

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    refute Process.alive?(manager)
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok

    err =
      assert_raise RuntimeError, fn ->
        {{moduleName}}.DefaultApiClient.send_request(client.api_client, :get, "http://127.0.0.1:1/never", %{}, nil)
      end

    assert err.message == "ApiClient has been closed and can no longer send requests"
  end

  test "close works for an authenticator that starts nothing" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")
    client = {{moduleName}}.{{clientClassName}}.new(authenticator)

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
  end

  # An authenticator that tells the test process each time the client releases it.
  defmodule ClosingAuthenticator do
    use {{moduleName}}.Auth.BaseAuthenticator

    defstruct [:notify, :label]

    @impl true
    def host(%__MODULE__{}), do: "http://closing.invalid"

    @impl true
    def auth_headers(%__MODULE__{}), do: %{}

    def close(%__MODULE__{notify: notify, label: label}), do: send(notify, {:released, label})
  end

  # Answers every request with an empty 200 once the test sends it `:proceed`,
  # and tells the test process when a request is waiting.
  defp blocked_transport do
    test_pid = self()

    adapter = fn request ->
      send(test_pid, {:waiting, self()})

      receive do
        :proceed -> :ok
      end

      {request, Req.Response.new(status: 200, body: "")}
    end

    {adapter, {{moduleName}}.TransportOptions.new(req_options: [adapter: adapter], max_retries: 0)}
  end

  defp call_through(client) do
    state = %{
      api_client: client.api_client,
      authenticator: client.authenticator,
      scheme_authenticators: client.schemes,
      config: {{moduleName}}.Configuration.new(base_url: "http://closing.invalid")
    }

    fn ->
      {{moduleName}}.Api.BaseApi.invoke_api_for_result(
        state,
        :get,
        "/slow",
        %{},
        %{},
        nil,
        ["application/json"],
        "application/json",
        nil,
        {{moduleName}}.Api.BaseApi.no_auth()
      )
    end
  end

  test "close lets an in-flight request finish and releases the authenticator after it" do
    {_adapter, transport} = blocked_transport()
    authenticator = %ClosingAuthenticator{notify: self()}
    client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)
    call = call_through(client)

    task = Task.async(call)
    assert_receive {:waiting, in_flight}, 5_000

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    refute_received {:released, _label}

    send(in_flight, :proceed)
    assert {:ok, %{status_code: 200}} = Task.await(task)
    assert_received {:released, nil}
  end

  test "a request that starts after close fails with the one canonical client closed error" do
    authenticator = %ClosingAuthenticator{notify: self()}
    {_adapter, transport} = blocked_transport()
    client = {{moduleName}}.{{clientClassName}}.new(authenticator, transport)
    call = call_through(client)

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok

    error = assert_raise RuntimeError, call
    assert error.message == "ApiClient has been closed and can no longer send requests"
    refute_received {:waiting, _pid}
  end

  test "a request that starts while another is in flight after close still fails" do
    {_adapter, transport} = blocked_transport()
    client = {{moduleName}}.{{clientClassName}}.new(%ClosingAuthenticator{notify: self()}, transport)
    call = call_through(client)

    task = Task.async(call)
    assert_receive {:waiting, in_flight}, 5_000
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok

    error = assert_raise RuntimeError, call
    assert error.message == "ApiClient has been closed and can no longer send requests"

    send(in_flight, :proceed)
    assert {:ok, _result} = Task.await(task)
  end

  test "close twice releases the authenticator once" do
    client = {{moduleName}}.{{clientClassName}}.new(%ClosingAuthenticator{notify: self()})

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    assert_received {:released, nil}
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    refute_received {:released, _label}
  end

  test "closing after the last in-flight request does not release the authenticator a second time" do
    {_adapter, transport} = blocked_transport()
    client = {{moduleName}}.{{clientClassName}}.new(%ClosingAuthenticator{notify: self()}, transport)
    call = call_through(client)

    task = Task.async(call)
    assert_receive {:waiting, in_flight}, 5_000
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    send(in_flight, :proceed)
    assert {:ok, _result} = Task.await(task)
    assert_received {:released, nil}

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    refute_received {:released, _label}
  end

  test "close never touches a transport the caller supplied" do
    {adapter, transport} = blocked_transport()
    first = {{moduleName}}.{{clientClassName}}.new(%ClosingAuthenticator{notify: self()}, transport)
    second = {{moduleName}}.{{clientClassName}}.new(%ClosingAuthenticator{notify: self()}, transport)

    assert {{moduleName}}.{{clientClassName}}.close(first) == :ok
    refute_received {:waiting, _pid}
    assert first.api_client.transport_options.req_options[:adapter] == adapter

    task = Task.async(call_through(second))
    assert_receive {:waiting, in_flight}, 5_000
    send(in_flight, :proceed)
    assert {:ok, %{status_code: 200}} = Task.await(task)
  end

