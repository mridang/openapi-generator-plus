  test "bhv langelixir 020 close releases the transport and the authenticator's token manager" do
    authenticator =
      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "{{{basePath}}}",
        "id",
        "secret",
        "https://auth.example.com/token",
        []
      )

    client = {{moduleName}}.{{clientClassName}}.new(authenticator)
    manager = authenticator.token_manager
    assert Process.alive?(manager)

    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    refute Process.alive?(manager)
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok

    err =
      assert_raise RuntimeError, fn ->
        {{moduleName}}.DefaultApiClient.send_request(client.api_client, :get, "http://127.0.0.1:1/never", %{}, nil)
      end

    assert err.message == "ApiClient has been closed and can no longer send requests"
  end

  test "bhv streaming 021 closing the client cancels the open streams, the next read of each raises the closed-client error, and new calls are refused" do
    {:ok, listen} = :gen_tcp.listen(0, [:binary, packet: :raw, active: false, reuseaddr: true])
    {:ok, port} = :inet.port(listen)

    spawn_link(fn ->
      {:ok, socket} = :gen_tcp.accept(listen, 10_000)
      {:ok, _head} = :gen_tcp.recv(socket, 0, 5_000)

      :gen_tcp.send(
        socket,
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r\ntick\r\n"
      )

      Process.sleep(20_000)
    end)

    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")
    client = {{moduleName}}.{{clientClassName}}.new(authenticator)
    url = "http://127.0.0.1:#{port}/items/events"
    open = {{moduleName}}.DefaultApiClient.send_streaming(client.api_client, :get, url, %{}, nil)
    assert Enum.take(open.body, 1) == ["tick"]

    started = System.monotonic_time(:millisecond)
    assert {{moduleName}}.{{clientClassName}}.close(client) == :ok
    assert System.monotonic_time(:millisecond) - started < 5_000, "closing did not wait for the endless stream"

    cancelled = assert_raise RuntimeError, fn -> Enum.to_list(open.body) end
    assert cancelled.message == "ApiClient has been closed and can no longer send requests"

    assert_raise RuntimeError, fn ->
      {{moduleName}}.DefaultApiClient.send_streaming(client.api_client, :get, url, %{}, nil)
    end
  end

  test "bhv langelixir 021 close works for an authenticator that starts nothing" do
    authenticator = {{moduleName}}.Auth.BearerAuthenticator.new("{{{basePath}}}", "test-token")
