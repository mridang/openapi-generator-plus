  test "caller headers override transport default headers" do
    {base_url, _port} = start_header_capture_server()
    transport = {{moduleName}}.TransportOptions.new(default_headers: %{"Accept" => "text/plain"})
    client = {{moduleName}}.DefaultApiClient.new(transport)
    {{moduleName}}.DefaultApiClient.send_request(
      client, :get, "#{base_url}/test", %{"Accept" => "application/json"}, nil
