    test "bhv lifecycle 038 close/1 is optional, so a minimal custom transport need not implement it" do
      optional = {{moduleName}}.ApiClient.behaviour_info(:optional_callbacks)

      assert {:close, 1} in optional
      assert {:close, 1} in {{moduleName}}.ApiClient.behaviour_info(:callbacks)
    end

    test "the default transport implements close/1" do
      assert Code.ensure_loaded?({{moduleName}}.DefaultApiClient)
      assert function_exported?({{moduleName}}.DefaultApiClient, :close, 1)
    end
  end
