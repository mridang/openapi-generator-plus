  # network-error: a request that gets no HTTP response (connection refused)
  # raises NetworkError with status 0, keeping the Req exception as `cause`.
  # Req's default transient retry is off, so it fails once and fast.
  test "bhv transport 032 connection refused raises NetworkError" do
    {:ok, socket} = :gen_tcp.listen(0, [:binary, active: false])
    {:ok, port} = :inet.port(socket)
    :ok = :gen_tcp.close(socket)

    client = {{moduleName}}.DefaultApiClient.new()
    started = System.monotonic_time(:millisecond)

    err =
      assert_raise {{moduleName}}.Errors.NetworkError, fn ->
        {{moduleName}}.DefaultApiClient.send_request(
          client,
          :get,
          "http://127.0.0.1:#{port}/refused",
          %{},
          nil
        )
      end

    assert err.status_code == 0
    assert %Req.TransportError{} = err.cause
    assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(err)
    assert {{moduleName}}.Errors.ApiError.api_error?(err)
    assert System.monotonic_time(:millisecond) - started < 2_000, "the request must not be retried"
  end

