    transport = {{moduleName}}.TransportOptions.new(default_headers: %{"X-Custom" => "custom-value"})
    client = {{moduleName}}.DefaultApiClient.new(transport)
    {{moduleName}}.DefaultApiClient.send_request(client, :get, "#{base_url}/test", %{}, nil)
    assert_receive {:captured_headers, headers}, 5000
