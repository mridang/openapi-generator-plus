{{#generateTests}}
defmodule {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticatorTest do
  use ExUnit.Case, async: true

  defmodule FakeApiClient do
    defstruct [:agent]

    def new(responses) do
      {:ok, agent} = Agent.start_link(fn -> %{responses: responses, last_url: nil, last_body: nil, requests: []} end)
      %__MODULE__{agent: agent}
    end

    def send_request(%__MODULE__{agent: agent}, _method, url, _headers, body) do
      Agent.get_and_update(agent, fn state ->
        [response | rest] = state.responses
        new_state = %{state | responses: rest, last_url: url, last_body: body, requests: state.requests ++ [{url, body}]}
        {response, new_state}
      end)
    end

    def last_url(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.last_url)
    def last_body(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.last_body)
    def requests(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.requests)
  end

  defp create_authenticator do
    {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.new(
      "https://api.example.com",
      "my-client-id",
      "my-client-secret",
      "https://auth.example.com/authorize",
      "https://auth.example.com/token",
      "https://app.example.com/callback",
      ["read", "write"]
    )
  end

  describe "OAuth2AuthorizationCodeAuthenticator" do
    # The authenticator generated for the spec's authorization code scheme
    # passes its endpoints to the flow in the right places.
    test "scheme authenticator keeps the declared URLs" do
      auth =
        {{moduleName}}.Auth.OAuth.UserAuthAuthorizationCodeAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret",
          "https://app.example.com/callback"
        )

      assert auth.authorization_url == "https://auth.example.com/authorize"
      assert auth.token_url == "https://auth.example.com/oauth/token"
      assert auth.refresh_url == "https://auth.example.com/oauth/refresh"
      assert auth.redirect_uri == "https://app.example.com/callback"
    end

    test "scheme authenticator keeps the declared scopes in the authorization URL" do
      auth =
        {{moduleName}}.Auth.OAuth.UserAuthAuthorizationCodeAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret",
          "https://app.example.com/callback"
        )

      assert auth.scopes |> Enum.map(&(&1 |> String.split(":") |> List.last())) |> Enum.sort() ==
               ["read", "write"]

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth)

      assert String.contains?(url, "scope=")
    end

    test "builds authorization URL with required params" do
      auth = create_authenticator()

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth)

      assert String.starts_with?(url, "https://auth.example.com/authorize?")
      assert String.contains?(url, "response_type=code")
      assert String.contains?(url, "client_id=my-client-id")
      assert String.contains?(url, "redirect_uri=")
      assert String.contains?(url, "scope=read%20write")
      refute String.contains?(url, "scope=read+write")
    end

    # RFC 3986 unreserved characters (including ~) stay literal; * ! ' ( ) are
    # percent-encoded, and a space is %20 rather than +.
    test "authorization URL percent-encodes * ! ' ( ) and keeps ~ literal" do
      auth =
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.new(
          "https://api.example.com",
          "id~*!'()",
          "my-client-secret",
          "https://auth.example.com/authorize",
          "https://auth.example.com/token",
          "https://app.example.com/callback",
          ["read", "a*b(c)"]
        )

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth, "s t'a!te")

      assert String.contains?(url, "client_id=id~%2A%21%27%28%29")
      assert String.contains?(url, "scope=read%20a%2Ab%28c%29")
      assert String.contains?(url, "state=s%20t%27a%21te")
    end

    test "builds authorization URL with state" do
      auth = create_authenticator()

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth, "csrf-state-123")

      assert String.contains?(url, "state=csrf-state-123")
    end

    test "empty state is omitted" do
      auth = create_authenticator()

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth, "")

      refute String.contains?(url, "state")
      assert url == {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth)
    end

    test "exchanges code with correct grant type" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "grant_type=authorization_code")
      assert String.contains?(last_body, "code=auth-code-xyz")
      assert String.contains?(last_body, "client_id=my-client-id")
      assert String.contains?(last_body, "client_secret=my-client-secret")
    end

    test "includes refresh token on refresh" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 1})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")
      headers = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "refresh_token=ref1")
      assert String.contains?(last_body, "grant_type=refresh_token")
      assert headers["Authorization"] == "Bearer tok2"
    end

    test "refresh sends the client credentials with the refresh token" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 1})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")
      {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)

      assert URI.decode_query(FakeApiClient.last_body(fake_client)) == %{
               "grant_type" => "refresh_token",
               "refresh_token" => "ref1",
               "client_id" => "my-client-id",
               "client_secret" => "my-client-secret"
             }
    end

    test "the code is exchanged at the token URL and the refresh goes to the refresh URL" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 1})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "expires_in" => 3600})
        }
      ])

      auth =
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret",
          "https://auth.example.com/authorize",
          "https://auth.example.com/token",
          "https://app.example.com/callback",
          ["read"],
          refresh_url: "https://auth.example.com/refresh"
        )

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")
      assert FakeApiClient.last_url(fake_client) == "https://auth.example.com/token"

      {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)
      assert FakeApiClient.last_url(fake_client) == "https://auth.example.com/refresh"
    end

    test "a rejected refresh raises OAuth2ServerError after exactly one refresh request" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 1})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 400,
          body: Jason.encode!(%{"error" => "invalid_grant"})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")

      error =
        assert_raise {{moduleName}}.Errors.OAuth2ServerError, fn ->
          {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)
        end

      assert error.code == "invalid_grant"
      assert length(FakeApiClient.requests(fake_client)) == 2
    end

    test "a second exchange_code sends the new code" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "refresh_token" => "ref2", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "a")
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "b")

      second = URI.decode_query(FakeApiClient.last_body(fake_client))
      assert second["grant_type"] == "authorization_code"
      assert second["code"] == "b"

      assert {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)["Authorization"] ==
               "Bearer tok2"
    end

    test "a second exchange without refresh_token drops the old refresh token" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2"})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "a")
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "b")

      assert {{moduleName}}.Auth.OAuth.OAuth2TokenManager.refresh_token(auth.token_manager) == nil
    end

    test "a failed exchange keeps the previous session" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 400,
          body: Jason.encode!(%{"error" => "invalid_grant"})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "a")

      assert_raise {{moduleName}}.Errors.OAuth2ServerError, fn ->
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "bad")
      end

      assert {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)["Authorization"] ==
               "Bearer tok1"
    end

    test "token request bodies and the authorization URL are in the fixed order" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 1})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      assert {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth, "s") ==
               "https://auth.example.com/authorize?response_type=code&client_id=my-client-id" <>
                 "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&scope=read%20write&state=s"

      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "C")
      {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)

      assert [{_, exchange}, {_, refresh}] = FakeApiClient.requests(fake_client)

      assert exchange ==
               "grant_type=authorization_code&code=C&client_id=my-client-id&client_secret=my-client-secret" <>
                 "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback"

      assert refresh ==
               "grant_type=refresh_token&refresh_token=ref1&client_id=my-client-id&client_secret=my-client-secret"
    end

    # The exchange is recorded in the shared token manager, not in the struct, so
    # a copy of the authenticator (such as the one the client holds) is ready as
    # soon as exchange_code ran on any other copy, whatever it returned.
    test "exchange_code readies the authenticator without using its return value" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.set_api_client(auth, fake_client)

      _ = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "auth-code-xyz")
      headers = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)

      assert headers["Authorization"] == "Bearer tok1"
    end

    test "rejects empty authorization code" do
      auth = create_authenticator()

      assert_raise ArgumentError, fn ->
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "")
      end
    end

    test "rejects whitespace-only authorization code" do
      auth = create_authenticator()

      assert_raise ArgumentError, fn ->
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.exchange_code(auth, "   ")
      end
    end

    test "throws before exchange code called" do
      auth = create_authenticator()

      assert_raise RuntimeError, fn ->
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)
      end
    end

    test "get_host returns configured host" do
      auth = create_authenticator()

      assert {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.host(auth) == "https://api.example.com"
    end

    test "auth_headers_before_exchange_returns_recoverable_error" do
      auth = create_authenticator()

      # Calling auth_headers before exchange_code is a precondition
      # violation. It must surface as a catchable exception so callers
      # can recover -- not as a process crash.
      caught =
        try do
          {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.auth_headers(auth)
          nil
        rescue
          e in RuntimeError -> e
        end

      assert caught != nil, "expected auth_headers to raise before exchange_code"

      # Caller continues normally after rescuing -- no process crash.
      assert {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.host(auth) ==
               "https://api.example.com"
    end

    test "authorize URL with existing query string uses amp separator" do
      auth =
        {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret",
          "https://x.auth0.com/authorize?audience=api",
          "https://x.auth0.com/oauth/token",
          "https://app.example.com/callback",
          ["read"]
        )

      url = {{moduleName}}.Auth.OAuth.OAuth2AuthorizationCodeAuthenticator.build_authorization_url(auth)

      assert String.contains?(url, "audience=api")
      assert String.contains?(url, "response_type=code")
      assert length(String.split(url, "?")) - 1 == 1
    end

    test "redacts the secret" do
      auth = create_authenticator()

      refute inspect(auth) =~ "my-client-secret"
      assert inspect(auth) =~ ~s(client_secret: "***")
    end
  end
end
