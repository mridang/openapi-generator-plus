    end

    test "bhv unions 304 an allOf base payload without its discriminator fails" do
      json = ~s({"plate":"AB-12"})

      assert_raise {{moduleName}}.Errors.SerializationError, fn ->
        {{moduleName}}.ObjectSerializer.deserialize(json, "Vehicle")
      end
    end

    test "bhv serializationobject 301 an allOf subtype writes its discriminator value when serialized" do
      json = ~s({"plate":"AB-12","doorCount":4})
      car = {{moduleName}}.ObjectSerializer.deserialize(json, "Car")
      serialized = {{moduleName}}.ObjectSerializer.serialize(car)

      assert serialized =~ ~s("vehicleType":"car")
    end
  end
end
