{{#generateTests}}
defmodule {{moduleName}}.Api.StoreApiTest do
  use ExUnit.Case, async: true

  setup do
    base_url = System.get_env("API_BASE_URL", "http://localhost:4010")

    config = {{moduleName}}.Configuration.new(
      base_url: base_url,
      default_headers: %{"Authorization" => "Bearer test-token"}
    )

    api = {{moduleName}}.Api.StoreApi.new(nil, config)

    %{api: api}
  end

  test "get_inventory returns inventory", %{api: api} do
    assert {:ok, result} = {{moduleName}}.Api.StoreApi.get_inventory(api)
    assert is_map(result)
  end

  test "place_order places an order", %{api: api} do
    order = %{{moduleName}}.Models.Order{
      id: :rand.uniform(1_000_000_000),
      pet_id: :rand.uniform(1_000_000_000),
      quantity: 1,
      ship_date: DateTime.utc_now() |> DateTime.to_iso8601(),
      status: :placed,
      complete: false
    }

    assert {:ok, result} = {{moduleName}}.Api.StoreApi.place_order(api, order)
    assert result != nil
    assert result.id != nil
  end

  test "get_inventory_with_http_info returns status and data", %{api: api} do
    assert {:ok, result} = {{moduleName}}.Api.StoreApi.get_inventory_with_http_info(api)
    assert result.status_code >= 200 and result.status_code < 300
    assert result.data != nil
  end

  test "place_order_with_http_info returns status and data", %{api: api} do
    order = %{{moduleName}}.Models.Order{
      id: :rand.uniform(1_000_000_000),
      pet_id: :rand.uniform(1_000_000_000),
      quantity: 1,
      ship_date: DateTime.utc_now() |> DateTime.to_iso8601(),
