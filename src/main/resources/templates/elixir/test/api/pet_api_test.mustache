  defmodule RecordingApiClient do
    # A module-style api_client that records the whole request, body included,
    # and answers with a Pet JSON document for a tag URL and a Medication JSON
    # document for anything else.
    use Agent

    def start do
      name = :"#{__MODULE__}-#{System.unique_integer([:positive])}"
      {:ok, _pid} = Agent.start_link(fn -> nil end, name: name)
      Process.put(__MODULE__, name)
      {:ok, name}
    end

    def captured(name), do: Agent.get(name, & &1)

    def send_request(method, url, headers, body) do
      name = Process.get(__MODULE__)
      Agent.update(name, fn _ -> %{method: method, url: url, headers: headers, body: body} end)

      body =
        if String.contains?(url, "/tag/"),
          do: ~s({"name":"Rex","photoUrls":[]}),
          else: ~s({"drugName":"Amoxicillin"})

      %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        body: body,
        headers: %{"Content-Type" => "application/json"}
      }
    end
  end

  # D47: an object-valued query or header parameter is written by the
  # property wire names, in each of its styles.
  test "bhv operations 067 get_pet_tag sends object-valued query and header parameters in their styles" do
    {:ok, name} = RecordingApiClient.start()
    config = {{moduleName}}.Configuration.new(base_url: "http://localhost")
    api = {{moduleName}}.Api.PetApi.new(RecordingApiClient, config)

    criteria = %{{moduleName}}.Models.PetCriteria{breed: "lab", min_age: 3}

    options = %{{moduleName}}.Api.Options.GetPetTagOptions{
      criteria: criteria,
      criteria_csv: criteria,
      criteria_deep: criteria,
      x_criteria: criteria
    }

    assert {:ok, %{{moduleName}}.Models.Pet{name: "Rex"}} =
             {{moduleName}}.Api.PetApi.get_pet_tag(api, 5, "cute", options)

    captured = RecordingApiClient.captured(name)
    query = captured.url |> String.split("?") |> List.last()

    assert query =~ "breed=lab&min_age=3"
    assert query =~ "criteriaCsv=breed%2Clab%2Cmin_age%2C3"
    assert query =~ "criteriaDeep%5Bbreed%5D=lab&criteriaDeep%5Bmin_age%5D=3"
    assert captured.headers["X-Criteria"] == "breed,lab,min_age,3"

    Agent.stop(name)
  end

