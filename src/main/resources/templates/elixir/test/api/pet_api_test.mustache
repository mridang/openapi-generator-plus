  test "string path param is percent-encoded exactly once (no double-encoding)" do
    {:ok, name} = PathCapturingApiClient.start()
    config = {{moduleName}}.Configuration.new(base_url: "http://localhost")
    api = {{moduleName}}.Api.PetApi.new(PathCapturingApiClient, config)

    _result =
      {{moduleName}}.Api.PetApi.get_pet_tag(
        api, 5, "a b",
        %{{moduleName}}.Api.Options.GetPetTagOptions{}
      )

    url = PathCapturingApiClient.captured_url(name)
    # get_pet_tag declares tagName with `style: label`, so the segment is
    # rendered as `.a%20b` (leading dot). This test verifies single-encoding
    # of the space, so assert the encoded form appears (a%20b) and is never
    # double-encoded (a%2520b) — style-agnostic.
    assert String.contains?(url, "a%20b"),
      "Expected single-encoded space (%20) in path, got: #{url}"
    refute String.contains?(url, "%2520"),
      "Path must not be double-encoded (%2520), got: #{url}"

    Agent.stop(name)
  end

  # optional-array-param-serialization: get_pet_tag declares two OPTIONAL array
  # query params — `colors` (style pipeDelimited) and `sizes` (style
  # spaceDelimited). When supplied with multiple values they must serialise as
  # the param's declared style on the wire, NEVER a language-debug
  # representation of the list (e.g. Elixir's `inspect` form `["blue",
  # "black"]`, or a percent-encoded `%5Bblue` / `%5B%22blue%22` blob). The
  # ValueSerializer joins each element via the per-item stringify before
  # styling, so `["blue", "black"]` -> `blue|black` and `["S", "M"]` -> `S M`.
  test "bhv operations 068 get_pet_tag serialises optional array query params as styled values, not a debug blob" do
    {:ok, name} = PathCapturingApiClient.start()
    config = {{moduleName}}.Configuration.new(base_url: "http://localhost")
    api = {{moduleName}}.Api.PetApi.new(PathCapturingApiClient, config)

    _result =
      {{moduleName}}.Api.PetApi.get_pet_tag(
        api, 5, "cute",
        %{{moduleName}}.Api.Options.GetPetTagOptions{
          colors: ["blue", "black"],
          sizes: ["S", "M"]
        }
      )

    url = PathCapturingApiClient.captured_url(name)

    # colors is pipeDelimited -> blue|black; the pipe is percent-encoded as
    # %7C by URI.encode_www_form. Both element values must be present, joined
    # by the declared delimiter.
    assert String.contains?(url, "colors=blue%7Cblack"),
      "Expected pipe-delimited colors=blue|black on the wire, got: #{url}"

    # sizes is spaceDelimited -> "S M"; the space is percent-encoded as %20
    # (RFC 3986 query component). Both element values must be present, space-joined.
    assert String.contains?(url, "sizes=S%20M"),
      "Expected space-delimited sizes=S%20M on the wire, got: #{url}"

    # The serialiser must NOT leak an Elixir list/inspect debug form. None of
    # the bracketed / quoted / comma-blob shapes a naive `inspect` or
    # `to_string` of the list would produce may appear.
    refute String.contains?(url, "%5B"),
      "Array param must not serialise as a bracketed debug blob (%5B...), got: #{url}"
    refute String.contains?(url, "%22"),
      "Array param must not serialise quoted list elements (%22), got: #{url}"
    refute url =~ ~r/colors=blue%2C/,
      "colors must use its declared pipeDelimited style, not a comma blob, got: #{url}"

    Agent.stop(name)
  end

  # A non-exploded delimited array serialises to a single (empty) value, so an
  # explicitly empty list is sent as `colors=` / `sizes=` like in the other
  # SDKs, rather than dropping the key.
  test "get_pet_tag sends an empty non-exploded array query param as an empty value" do
    {:ok, name} = PathCapturingApiClient.start()
    config = {{moduleName}}.Configuration.new(base_url: "http://localhost")
    api = {{moduleName}}.Api.PetApi.new(PathCapturingApiClient, config)

    _result =
      {{moduleName}}.Api.PetApi.get_pet_tag(
        api, 5, "cute",
        %{{moduleName}}.Api.Options.GetPetTagOptions{colors: [], sizes: []}
      )

    url = PathCapturingApiClient.captured_url(name)

    assert url =~ ~r/[?&]colors=(&|$)/,
      "Expected an empty colors= on the wire, got: #{url}"
    assert url =~ ~r/[?&]sizes=(&|$)/,
      "Expected an empty sizes= on the wire, got: #{url}"

    Agent.stop(name)
  end

  # RFC 6265 cookie values (F840). deletePet declares an `api_key` cookie
  # parameter that goes into the Cookie header exactly as given when every
  # character is a legal cookie-octet (printable ASCII except space, double
  # quote, comma, semicolon and backslash). Anything else is a caller mistake
  # (the caller pre-encodes) and fails closed with ArgumentError before any
  # request reaches the wire.
  @illegal_cookie_values [
    "a\r\nX-Injected: yes",
    "a\rb",
    "a\nb",
