    test "bhv misc 001 replacing the token while other callers read it is race-free and each read gets one complete token" do
      first = String.duplicate("a", 512)
      second = String.duplicate("b", 512)
      final = String.duplicate("c", 512)
      url = "https://auth.example.com/token"

      {:ok, manager} = {{moduleName}}.Auth.OAuth.OAuth2TokenManager.start_link()
      {{moduleName}}.Auth.OAuth.OAuth2TokenManager.set_access_token(manager, first)

      readers =
        for _ <- 1..20 do
          Task.async(fn ->
            for _ <- 1..50 do
              {{moduleName}}.Auth.OAuth.OAuth2TokenManager.get_access_token(manager, url, %{})
            end
          end)
        end

      writer =
        Task.async(fn ->
          for i <- 1..200 do
            {{moduleName}}.Auth.OAuth.OAuth2TokenManager.set_access_token(manager, Enum.at([first, second], rem(i, 2)))
          end
        end)

      Task.await(writer, 5_000)
      reads = readers |> Enum.flat_map(&Task.await(&1, 5_000))

      assert Enum.all?(reads, &(&1 in [first, second]))

      {{moduleName}}.Auth.OAuth.OAuth2TokenManager.set_access_token(manager, final)
      assert {{moduleName}}.Auth.OAuth.OAuth2TokenManager.get_access_token(manager, url, %{}) == final
    end

