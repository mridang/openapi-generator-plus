    test "bhv authoidc 005 a plain-http endpoint is refused unless it is loopback" do
      refuse = fn doc, pattern ->
        fake_client =
          FakeApiClient.new([
            %{{moduleName}}.ApiHttpResponse{status_code: 200, body: Jason.encode!(doc)}
          ])

        auth =
          {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(create_authenticator(), fake_client)

        assert_raise {{moduleName}}.Errors.SerializationError, pattern, fn ->
          {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)
        end
      end

      good = %{
        "issuer" => "https://auth.example.com",
        "authorization_endpoint" => "https://auth.example.com/authorize",
        "token_endpoint" => "https://auth.example.com/token"
      }

      refuse.(%{good | "token_endpoint" => "http://auth.example.com/token"}, ~r/'token_endpoint' must be an https URL/)

      refuse.(
        %{good | "authorization_endpoint" => "http://auth.example.com/authorize"},
        ~r/'authorization_endpoint' must be an https URL/
      )
    end

