    test "bhv authoidc 015 invalidate_access_token reaches the discovered flow and is a no-op before a code exchange" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new([
        discovery,
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "refresh_token" => "ref1", "expires_in" => 3600})
        },
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok2", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      assert {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.invalidate_access_token(auth) == :ok

      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.exchange_code(auth, "oidc-code")

      assert {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.auth_headers(auth)["Authorization"] ==
               "Bearer tok1"

      assert {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.invalidate_access_token(auth) == :ok

      assert {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.auth_headers(auth)["Authorization"] ==
               "Bearer tok2"

      assert FakeApiClient.last_body(fake_client) =~ "grant_type=refresh_token"
    end

    test "bhv authoidc 019 redacts secret" do
      auth = create_authenticator()

      refute inspect(auth) =~ "my-client-secret"
      assert inspect(auth) =~ ~s(client_secret: "***")
