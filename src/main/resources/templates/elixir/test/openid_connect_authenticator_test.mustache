    # An expired discovery document is fetched again, but the token state lives
    # on across it: a code exchanged before the expiry is still exchanged after.
    test "bhv authoidc 020 rediscovery after expiry keeps the exchanged tokens" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        headers: %{"Cache-Control" => "max-age=0"},
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new([
        discovery,
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "oidc-tok", "expires_in" => 3600})
        },
        discovery
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.exchange_code(auth, "oidc-code")
      headers = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.auth_headers(auth)

      assert FakeApiClient.get_count(fake_client) == 2
      assert headers["Authorization"] == "Bearer oidc-tok"
    end

    # The PKCE verifier lives in the token manager the rediscovery keeps, so a
    # code exchanged after the discovery document expired still proves the
    # challenge of the authorization URL built before it.
    test "bhv authoidc 021 the PKCE verifier survives a rediscovery and the URL has no nonce" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        headers: %{"Cache-Control" => "max-age=0"},
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new([
        discovery,
        discovery,
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "oidc-tok", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      params =
        auth
        |> {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url("s")
        |> URI.parse()
        |> Map.fetch!(:query)
        |> URI.decode_query()

      assert params["code_challenge_method"] == "S256"
      refute Map.has_key?(params, "nonce")

      {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.exchange_code(auth, "oidc-code")

      assert FakeApiClient.get_count(fake_client) == 2
      verifier = FakeApiClient.last_body(fake_client) |> URI.decode_query() |> Map.fetch!("code_verifier")

      assert byte_size(verifier) == 43
      assert params["code_challenge"] == Base.url_encode64(:crypto.hash(:sha256, verifier), padding: false)
    end

    # The discovery document is cached for the max-age of its Cache-Control
    # header, and for the default when the header is absent or has no usable
    # max-age.
    test "bhv authoidc 003 discovery is cached when Cache-Control carries a positive max-age or none" do
      for headers <- [
            %{"Cache-Control" => "max-age=3600"},
            %{"cache-control" => "public, MAX-AGE=3600"},
            %{"Cache-Control" => "no-cache"},
            %{"Cache-Control" => "max-age=soon"},
            %{}
          ] do
        discovery = %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          headers: headers,
          body: Jason.encode!(%{
            "issuer" => "https://auth.example.com",
            "authorization_endpoint" => "https://auth.example.com/authorize",
            "token_endpoint" => "https://auth.example.com/token"
          })
        }

        fake_client = FakeApiClient.new([discovery, discovery])

        auth = create_authenticator()
        auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

        {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)
        {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)

        assert FakeApiClient.get_count(fake_client) == 1, "discovery refetched for #{inspect(headers)}"
      end
    end

    test "bhv authoidc 009 a failed rediscovery keeps using the previous discovery document" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        headers: %{"Cache-Control" => "max-age=0"},
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client =
        FakeApiClient.new([
          discovery,
          %{{moduleName}}.ApiHttpResponse{status_code: 503, body: "unavailable"}
        ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      first = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)
      second = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)

      assert strip_pkce(second) == strip_pkce(first)
      assert FakeApiClient.get_count(fake_client) == 2
    end

    test "bhv authoidc 001 an oversized max-age is clamped to one year" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        headers: %{"Cache-Control" => "max-age=99999999999999"},
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new([discovery])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)
      before = System.monotonic_time(:millisecond)

      {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)

      {_delegate, expiry} = Agent.get(auth.discovery_cache, & &1.discovery)
      assert expiry <= before + 31_536_000 * 1000 + 5_000
      assert expiry > before + 31_536_000 * 1000 - 5_000
    end

    test "max-age=0 makes every use fetch the discovery document again" do
      discovery = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        headers: %{"Cache-Control" => "max-age=0"},
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new([discovery, discovery])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)
      {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth)

      assert FakeApiClient.get_count(fake_client) == 2
    end

    # The discovery document must be cached: a second build should reuse it
    # rather than issue a second GET to the discovery endpoint.
    test "bhv authoidc 029 concurrent callers on a cold authenticator share one discovery request" do
      document = %{{moduleName}}.ApiHttpResponse{
        status_code: 200,
        body: Jason.encode!(%{
          "issuer" => "https://auth.example.com",
          "authorization_endpoint" => "https://auth.example.com/authorize",
          "token_endpoint" => "https://auth.example.com/token"
        })
      }

      fake_client = FakeApiClient.new(List.duplicate(document, 8))
      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.set_api_client(auth, fake_client)

      1..8
      |> Enum.map(fn _ ->
        Task.async(fn -> {{moduleName}}.Auth.OAuth.OpenIdConnectAuthenticator.build_authorization_url(auth) end)
      end)
      |> Enum.each(&Task.await/1)

      assert FakeApiClient.get_count(fake_client) == 1
    end

    test "bhv authoidc 011 fetches discovery document only once" do
      fake_client = FakeApiClient.new([
