defmodule {{moduleName}}.DefaultApiClientIntegrationTest do
  use ExUnit.Case, async: false

  test "makes HTTPS request with verify_ssl=false" do
    wiremock_url = System.fetch_env!("WIREMOCK_HTTPS_URL")

    transport = {{moduleName}}.TransportOptions.new(verify_ssl: false)
    client = {{moduleName}}.DefaultApiClient.new(transport)
    response = {{moduleName}}.DefaultApiClient.send_request(client, :get, "#{wiremock_url}/api/test", %{}, nil)

    assert response.status_code == 200
    assert String.contains?(response.body, "success")
  end

  test "makes HTTPS request with custom CA cert" do
    wiremock_url = System.fetch_env!("WIREMOCK_HTTPS_URL")
    ca_cert_path = System.fetch_env!("CA_CERT_PATH")

    transport = {{moduleName}}.TransportOptions.new(
      verify_ssl: true,
      ca_cert_path: ca_cert_path
    )

    client = {{moduleName}}.DefaultApiClient.new(transport)
    response = {{moduleName}}.DefaultApiClient.send_request(client, :get, "#{wiremock_url}/api/test", %{}, nil)

    assert response.status_code == 200
    assert String.contains?(response.body, "success")
  end

