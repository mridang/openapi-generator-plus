defmodule {{moduleName}}.DefaultApiClientIntegrationTest do
  use ExUnit.Case, async: true

  test "makes HTTPS request with verify_ssl=false" do
    chasm_url = System.fetch_env!("CHASM_HTTPS_URL")

    transport = {{moduleName}}.TransportOptions.new(verify_ssl: false)
    client = {{moduleName}}.DefaultApiClient.new(transport)
    response = {{moduleName}}.DefaultApiClient.send_request(client, :get, "#{chasm_url}/test/echo", %{}, nil)

    assert response.status_code == 200
    # chasm /test/echo returns a JSON envelope; assert the method field is present
    json = Jason.decode!(response.body)
    assert json["method"] == "GET"
  end

