    transport =
      {{moduleName}}.TransportOptions.new(
        proxy: "http://alice:s3cret@127.0.0.1:3128"
      )

    client = {{moduleName}}.DefaultApiClient.new(transport)
    assert client.proxy_auth_header == "Basic YWxpY2U6czNjcmV0"
  end

