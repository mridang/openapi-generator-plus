defmodule {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticatorTest do
  use ExUnit.Case, async: true

  defmodule FakeApiClient do
    defstruct [:agent]

    def new(responses) do
      {:ok, agent} = Agent.start_link(fn -> %{responses: responses, last_url: nil, last_body: nil, last_headers: nil} end)
      %__MODULE__{agent: agent}
    end

    def send_request(%__MODULE__{agent: agent}, _method, url, headers, body) do
      Agent.get_and_update(agent, fn state ->
        [response | rest] = state.responses
        new_state = %{state | responses: rest, last_url: url, last_body: body, last_headers: headers}
        {response, new_state}
      end)
    end

    def last_url(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.last_url)
    def last_body(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.last_body)
    def last_headers(%__MODULE__{agent: agent}), do: Agent.get(agent, & &1.last_headers)
  end

  defp create_authenticator do
    {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
      "https://api.example.com",
      "my-client-id",
      "my-client-secret",
      "https://auth.example.com/token",
      ["read", "write"]
    )
  end

  describe "OAuth2ClientCredentialsAuthenticator" do
    # The authenticator generated for the spec's client credentials scheme
    # carries the scopes the spec declares for that flow.
    test "scheme authenticator keeps the declared scopes" do
      auth =
        {{moduleName}}.Auth.OAuth.MachineAuthClientCredentialsAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret"
        )

      assert auth.scopes |> Enum.map(&(&1 |> String.split(":") |> List.last())) |> Enum.sort() ==
               ["read", "write"]
    end

    test "scheme authenticator sends the declared scopes in the token request" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth =
        {{moduleName}}.Auth.OAuth.MachineAuthClientCredentialsAuthenticator.new(
          "https://api.example.com",
          "my-client-id",
          "my-client-secret"
        )

      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)
      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      assert auth.scopes != []

      assert URI.decode_query(FakeApiClient.last_body(fake_client))["scope"] ==
               Enum.join(auth.scopes, " ")
    end

    test "sends client credentials grant type" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "grant_type=client_credentials")
    end

    test "sends client id and secret" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "client_id=my-client-id")
      assert String.contains?(last_body, "client_secret=my-client-secret")
    end

    test "token request body is in the fixed order" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      assert FakeApiClient.last_body(fake_client) ==
               "grant_type=client_credentials&client_id=my-client-id&client_secret=my-client-secret&scope=read+write"
    end

    test "sends scopes" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "scope=read+write")
    end

    test "returns authorization bearer header" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok-abc", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      headers = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      assert headers["Authorization"] == "Bearer tok-abc"
    end

    test "sends request to token URL" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "tok1", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      assert FakeApiClient.last_url(fake_client) == "https://auth.example.com/token"
    end

    test "get_host returns configured host" do
      auth = create_authenticator()

      assert {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.host(auth) == "https://api.example.com"
    end

    test "token fetch error is surfaced not swallowed" do
      # oauth-cc-authheaders-error-swallow: a failed client-credentials token
      # exchange must surface to the caller as a raised error — NOT be
      # swallowed into an empty header map that would send the API request
      # unauthenticated and produce a confusing downstream 401.
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 401,
          body: Jason.encode!(%{"error" => "invalid_client"})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      assert_raise {{moduleName}}.Errors.OAuth2ServerError, fn ->
        {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)
      end
    end

    test "caches token across calls" do
      # The token manager caches the access token until expiry, so two
      # consecutive header requests reuse the same token and issue only a
      # single token request. Only one response is queued; a second token
      # fetch would fail to match `[response | rest]` on an empty list and
      # raise, proving single-flight.
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "cached-cc-token", "expires_in" => 3600})
        }
      ])

      auth = create_authenticator()
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      headers1 = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)
      headers2 = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      assert headers1["Authorization"] == "Bearer cached-cc-token"
      assert headers2["Authorization"] == "Bearer cached-cc-token"
    end

    test "basic auth URL-encodes client id and secret" do
      # Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
      # client_id and client_secret MUST be application/x-www-form-
      # urlencoded BEFORE being joined with ':' and base64-encoded.
      # Verifies a client_id with `+` and a secret with `&` are encoded
      # (not raw) before the colon-join + base64.
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "at", "expires_in" => 3600})
        }
      ])

      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "https://api.example.com",
        "id+with/special",
        "secret&with=stuff",
        "https://auth.example.com/token",
        ["read"],
        client_auth_method: :basic
      )
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      headers = FakeApiClient.last_headers(fake_client)
      auth_header = headers["Authorization"]
      assert auth_header != nil
      assert String.starts_with?(auth_header, "Basic ")
      encoded = String.slice(auth_header, String.length("Basic ")..-1//1)
      decoded = Base.decode64!(encoded)
      # Expected: form-urlencoded id ':' form-urlencoded secret
      assert decoded == "id%2Bwith%2Fspecial:secret%26with%3Dstuff"
    end

    # RFC 3986 unreserved characters (including ~) stay literal; the others in
    # the sub-delimiter set that URL encoders often miss are percent-encoded.
    test "body credentials percent-encode * ! ' ( ) and keep ~ literal" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "at", "expires_in" => 3600})
        }
      ])

      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "https://api.example.com",
        "id~*!'()",
        "secret~*!'()",
        "https://auth.example.com/token",
        ["read"]
      )
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      last_body = FakeApiClient.last_body(fake_client)
      assert String.contains?(last_body, "client_id=id~%2A%21%27%28%29")
      assert String.contains?(last_body, "client_secret=secret~%2A%21%27%28%29")
    end

    test "basic auth percent-encodes * ! ' ( ) and keeps ~ literal" do
      fake_client = FakeApiClient.new([
        %{{moduleName}}.ApiHttpResponse{
          status_code: 200,
          body: Jason.encode!(%{"access_token" => "at", "expires_in" => 3600})
        }
      ])

      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.new(
        "https://api.example.com",
        "id~*!'()",
        "secret~*!'()",
        "https://auth.example.com/token",
        ["read"],
        client_auth_method: :basic
      )
      auth = {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.set_api_client(auth, fake_client)

      {{moduleName}}.Auth.OAuth.OAuth2ClientCredentialsAuthenticator.auth_headers(auth)

      "Basic " <> encoded = FakeApiClient.last_headers(fake_client)["Authorization"]
      assert Base.decode64!(encoded) == "id~%2A%21%27%28%29:secret~%2A%21%27%28%29"
    end

    test "redacts the secret" do
      auth = create_authenticator()

      refute inspect(auth) =~ "my-client-secret"
      assert inspect(auth) =~ ~s(client_secret: "***")
    end
  end
end
