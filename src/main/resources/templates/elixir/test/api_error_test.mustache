    test "bhv errors 066 a 429 is a TooManyRequestsError and a ClientError" do
      err = {{moduleName}}.Errors.ApiError.from_response(429, %{"retry-after" => "3"}, nil)

      assert %{{moduleName}}.Errors.TooManyRequestsError{status_code: 429} = err
      assert err.message == "API returned status code 429"
      assert {{moduleName}}.Errors.TooManyRequestsError.exception("slow down").status_code == 429
      assert {{moduleName}}.Errors.ClientError.client_error?(err)
      assert {{moduleName}}.Errors.ApiError.api_error?(err)
