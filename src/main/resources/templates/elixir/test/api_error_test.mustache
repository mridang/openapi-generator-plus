  describe "OAuth2ServerError message" do
    test "bhv errors 046 the message has three forms: raw body, code, and code with description" do
      raw = {{moduleName}}.Errors.OAuth2ServerError.exception(status_code: 502, raw_body: "<html>bad gateway</html>")
      code = {{moduleName}}.Errors.OAuth2ServerError.exception(status_code: 400, code: "invalid_grant")

      described =
        {{moduleName}}.Errors.OAuth2ServerError.exception(
