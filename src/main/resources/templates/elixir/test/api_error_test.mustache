  test "bhv errors 202 an error exposes the x-request-id header as its request id" do
    from = fn headers -> {{moduleName}}.Errors.ApiError.from_response(500, headers, nil) end

    assert {{moduleName}}.Errors.ApiError.request_id(from.(%{"X-Request-ID" => "abc"})) == "abc"
    assert {{moduleName}}.Errors.ApiError.request_id(from.(%{"x-request-id" => "abc"})) == "abc"
    assert {{moduleName}}.Errors.ApiError.request_id(from.(%{"other" => "abc"})) == nil
