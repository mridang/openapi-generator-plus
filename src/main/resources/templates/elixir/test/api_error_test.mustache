{{#generateTests}}
defmodule {{moduleName}}.ApiErrorTest do
  use ExUnit.Case, async: true

  test "bhv errors 004 exposes status_code, response_body, response_headers and error_body" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 404,
        message: "not found",
        response_headers: %{"content-type" => "application/json"},
        response_body: ~s({"id":7,"name":"missing"}),
        error_body: nil
      )

    assert err.status_code == 404
    assert err.response_body == ~s({"id":7,"name":"missing"})
    assert err.response_headers["content-type"] == "application/json"
    assert err.error_body == nil
  end

  test "bhv errors 021 nil headers and body mark transport-no-response" do
    # apierror-responsebody-headers-nullable-split: nil is distinct from an
    # empty header map / empty body so a pre-response transport failure can
    # be encoded.
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 0,
        message: "connection reset",
        response_headers: nil,
        response_body: nil
      )

    assert err.response_headers == nil
    assert err.response_body == nil
  end

  test "bhv errors 019 is an exception whose string form names the status" do
    err = {{moduleName}}.Errors.ApiError.exception(status_code: 500, message: "boom")

    assert %{{moduleName}}.Errors.ApiError{} = err
    assert {{moduleName}}.Errors.ApiError.message(err) != ""
    assert Exception.message(err) =~ "500"
  end

  test "an empty message renders the default text, like a missing one" do
    default = "Error message: the server returns an error"

    assert {{moduleName}}.Errors.ApiError.message(
             {{moduleName}}.Errors.ApiError.exception(message: "")
           ) == default

    assert {{moduleName}}.Errors.ApiError.message(
             {{moduleName}}.Errors.ApiError.exception(status_code: 500)
           ) == default <> "\nHTTP status code: 500"
  end

  test "bhv errors 022 bhv errors 024 the message lists the status, headers and body, and leaves out what is empty" do
    full =
      {{moduleName}}.Errors.ApiError.exception(
        message: "boom",
        status_code: 502,
        response_headers: %{"x-id" => "1"},
        response_body: "upstream down"
      )

    assert {{moduleName}}.Errors.ApiError.message(full) ==
             ~s(boom\nHTTP status code: 502\nResponse headers: {"x-id":"1"}\nResponse body: upstream down)

    sorted =
      {{moduleName}}.Errors.ApiError.exception(
        message: "boom",
        response_headers: %{"b" => "2", "a" => "1"}
      )

    assert {{moduleName}}.Errors.ApiError.message(sorted) == ~s(boom\nResponse headers: {"a":"1","b":"2"})

    bare =
      {{moduleName}}.Errors.ApiError.exception(
        message: "boom",
        status_code: 0,
        response_headers: %{},
        response_body: ""
      )

    assert {{moduleName}}.Errors.ApiError.message(bare) == "boom"
  end

  test "the message cuts a long response body at 1 KiB and counts the bytes left out" do
    body = String.duplicate("a", 3_000)

    err =
      {{moduleName}}.Errors.ApiError.exception(
        message: "bad gateway",
        status_code: 502,
        response_body: body
      )

    assert {{moduleName}}.Errors.ApiError.message(err) ==
             "bad gateway\nHTTP status code: 502\nResponse body: " <>
               String.duplicate("a", 1_024) <> "... (1976 more bytes)"

    assert byte_size(err.response_body) == 3_000
  end

  test "the message leaves a body of exactly 1 KiB whole" do
    body = String.duplicate("a", 1_024)
    err = {{moduleName}}.Errors.ApiError.exception(message: "boom", response_body: body)

    assert {{moduleName}}.Errors.ApiError.message(err) == "boom\nResponse body: " <> body
  end

  test "bhv errors 001 the message escapes control characters in the response body" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        message: "boom",
        response_body: "a\r\nb\tc" <> <<1>> <> "d" <> <<127>>
      )

    assert {{moduleName}}.Errors.ApiError.message(err) == "boom\nResponse body: a\\r\\nb\\tc\\x01d\\x7F"
    assert err.response_body == "a\r\nb\tc" <> <<1>> <> "d" <> <<127>>
  end

  test "bhv errors 023 the message masks credential response headers and keeps the real ones on the error" do
    headers = %{
      "authorization" => "Bearer s1",
      "proxy-authorization" => "Basic s2",
      "cookie" => "sid=s3",
      "Set-Cookie" => "sid=s4",
      "www-authenticate" => "Bearer realm=s5",
      "proxy-authenticate" => "Basic realm=s6",
      "x-api-key" => "s7",
      "x-auth-token" => "s8",
      "x-client-secret" => "s9",
      "x-id" => "1"
    }

    err = {{moduleName}}.Errors.ApiError.exception(message: "boom", response_headers: headers)
    rendered = {{moduleName}}.Errors.ApiError.message(err)

    for secret <- ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9"] do
      refute rendered =~ secret
    end

    assert rendered =~ ~s("x-id":"1")
    assert rendered =~ ~s("authorization":"***")
    assert rendered =~ ~s("Set-Cookie":"***")
    assert err.response_headers == headers
  end

  test "bhv errors 011 the message names the request after the status line when both parts are set" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        message: "boom",
        status_code: 502,
        request_method: "GET",
        request_path: "/items/7",
        response_body: "upstream down"
      )

    assert {{moduleName}}.Errors.ApiError.message(err) ==
             "boom\nHTTP status code: 502\nRequest: GET /items/7\nResponse body: upstream down"

    for partial <- [[request_method: "GET"], [request_path: "/items/7"], []] do
      bare = {{moduleName}}.Errors.ApiError.exception([message: "boom", status_code: 502] ++ partial)

      assert {{moduleName}}.Errors.ApiError.message(bare) == "boom\nHTTP status code: 502"
    end
  end

  test "bhv errors 007 with_request records the upper-case method and the path without query or fragment" do
    err = {{moduleName}}.Errors.ApiError.from_response(404, %{}, nil)

    from_url = {{moduleName}}.Errors.ApiError.with_request(err, :get, "https://api.example.com/items/7?key=hunter2#top")
    assert from_url.request_method == "GET"
    assert from_url.request_path == "/items/7"
    refute Exception.message(from_url) =~ "hunter2"

    from_path = {{moduleName}}.Errors.ApiError.with_request(err, "post", "/items?page=2")
    assert from_path.request_method == "POST"
    assert from_path.request_path == "/items"

    assert {{moduleName}}.Errors.ApiError.with_request(err, :get, "https://api.example.com").request_path == "/"
    assert {{moduleName}}.Errors.ApiError.with_request(from_url, :delete, "/other") == from_url
    assert {{moduleName}}.Errors.ApiError.with_request(:not_an_error, :get, "/items") == :not_an_error
  end

  test "bhv errors 002 every error that specialises ApiError carries the request" do
    modules = [
      {{moduleName}}.Errors.ApiError,
      {{moduleName}}.Errors.ClientError,
      {{moduleName}}.Errors.BadRequestError,
      {{moduleName}}.Errors.UnauthorizedError,
      {{moduleName}}.Errors.ForbiddenError,
      {{moduleName}}.Errors.NotFoundError,
      {{moduleName}}.Errors.ConflictError,
      {{moduleName}}.Errors.UnprocessableEntityError,
      {{moduleName}}.Errors.TooManyRequestsError,
      {{moduleName}}.Errors.ServerError,
      {{moduleName}}.Errors.InternalServerError,
      {{moduleName}}.Errors.NetworkError,
      {{moduleName}}.Errors.NetworkTimeoutError
    ]

    for module <- modules do
      err = {{moduleName}}.Errors.ApiError.with_request(module.exception(%{message: "boom"}), :put, "https://h.example/a/b?k=v")

      assert err.__struct__ == module
      assert err.request_method == "PUT"
      assert err.request_path == "/a/b"
      assert Exception.message(err) =~ "\nRequest: PUT /a/b"
    end
  end

  test "bhv errors 010 from_response keeps a scalar JSON body as the error body" do
    err = {{moduleName}}.Errors.ApiError.from_response(500, %{}, ~s("overloaded"))

    assert err.error_body == "overloaded"
    assert err.response_body == ~s("overloaded")
  end

  test "bhv errors 005 from_response leaves the error body nil when the body is not JSON" do
    err = {{moduleName}}.Errors.ApiError.from_response(500, %{}, "<html>oops</html>")

    assert err.error_body == nil
    assert err.response_body == "<html>oops</html>"
  end

  test "bhv errors 012 from_response without a request keeps the plain message" do
    err = {{moduleName}}.Errors.ApiError.from_response(500, %{}, ~s({"k":"v"}))

    assert err.request_method == nil
    refute Exception.message(err) =~ "Request:"
  end

  test "bhv errors 008 from_response parses an error body that starts with a UTF-8 BOM" do
    body = <<0xEF, 0xBB, 0xBF>> <> ~s({"code":1})
    err = {{moduleName}}.Errors.ApiError.from_response(404, %{}, body)

    assert err.error_body == %{"code" => 1}
    assert err.response_body == body
  end

  test "bhv errors 009 from_response refuses a deeply nested error body but keeps the raw one" do
    body = String.duplicate("[", 1_500) <> String.duplicate("]", 1_500)
    err = {{moduleName}}.Errors.ApiError.from_response(500, %{}, body)

    assert %{{moduleName}}.Errors.InternalServerError{} = err
    assert err.error_body == nil
    assert err.response_body == body
  end

  test "bhv errors 017 typed_error_body raises a SerializationError for a body that is not JSON" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 500,
        response_body: "<html>oops</html>",
        response_headers: %{}
      )

    assert_raise {{moduleName}}.Errors.SerializationError, fn ->
      {{moduleName}}.Errors.ApiError.typed_error_body(err, "Category")
    end
  end

  describe "OAuth2ServerError message" do
    test "names the raw body when the response is not an OAuth2 error object" do
      err = {{moduleName}}.Errors.OAuth2ServerError.exception(status_code: 502, raw_body: "Bad Gateway")

      assert Exception.message(err) == "Token request failed with status 502: Bad Gateway"
    end

    test "names the error code" do
      err = {{moduleName}}.Errors.OAuth2ServerError.exception(status_code: 400, code: "invalid_grant")

      assert Exception.message(err) == "Token request failed with status 400: invalid_grant"
    end

    test "names the error code and description" do
      err =
        {{moduleName}}.Errors.OAuth2ServerError.exception(
          status_code: 400,
          code: "invalid_grant",
          description: "refresh token expired"
        )

      assert Exception.message(err) ==
               "Token request failed with status 400: invalid_grant -- refresh token expired"
    end
  end

  test "bhv errors 013 typed_error_body deserializes the body into the typed model" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 400,
        response_body: ~s({"id":42,"name":"Dogs"}),
        response_headers: %{}
      )

    body = {{moduleName}}.Errors.ApiError.typed_error_body(err, "Category")
    assert %{{moduleName}}.Models.Category{} = body
    assert body.id == 42
    assert body.name == "Dogs"
  end

  test "bhv errors 016 bhv errors 030 bhv errors 015 typed_error_body returns nil when there is no response body" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 500,
        response_body: "",
        response_headers: %{}
      )

    assert {{moduleName}}.Errors.ApiError.typed_error_body(err, "Category") == nil
    no_body = %{err | response_body: nil}
    assert {{moduleName}}.Errors.ApiError.typed_error_body(no_body, "Category") == nil
  end

  test "bhv errors 014 typed_error_body ignores extraneous fields not on the model" do
    err =
      {{moduleName}}.Errors.ApiError.exception(
        status_code: 422,
        response_body: ~s({"id":1,"name":"Cat","extra":"drop-me"}),
        response_headers: %{}
      )

    body = {{moduleName}}.Errors.ApiError.typed_error_body(err, "Category")
    assert %{{moduleName}}.Models.Category{} = body
    assert body.id == 1
    assert body.name == "Cat"
  end

  describe "SDK error grouping" do
    test "bhv errors 025 ApiError, a typed error and the Serialization error are all recognised" do
      api_error = {{moduleName}}.Errors.ApiError.exception(status_code: 500, message: "boom")
      typed_error = {{moduleName}}.Errors.BadRequestError.exception(%{message: "nope"})
      serialization_error = %{{moduleName}}.Errors.SerializationError{message: "bad json"}

      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(api_error)
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(typed_error)
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(serialization_error)
    end

    test "bhv errors 018 every SDK exception module is listed in exceptions/0" do
      modules = {{moduleName}}.Errors.{{errorPrefix}}Error.exceptions()

      assert {{moduleName}}.Errors.ApiError in modules
      assert {{moduleName}}.Errors.BadRequestError in modules
      assert {{moduleName}}.Errors.SerializationError in modules
    end

    test "a rescued SDK error is recognised via exceptions/0" do
      # Elixir's `rescue e in [...]` clause needs a compile-time literal list
      # of exception modules, so a runtime list cannot be spliced in. The
      # idiomatic equivalent is to rescue the error and assert membership in
      # the canonical `exceptions/0` list, which is the single source of truth.
      caught =
        try do
          raise {{moduleName}}.Errors.BadRequestError, %{message: "nope"}
        rescue
          e -> e
        end

      assert caught.__struct__ in {{moduleName}}.Errors.{{errorPrefix}}Error.exceptions()
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(caught)
    end

    test "network and OAuth errors are recognised" do
      for err <- [
            {{moduleName}}.Errors.NetworkError.exception(message: "refused"),
            {{moduleName}}.Errors.NetworkTimeoutError.exception(message: "timed out"),
            %{{moduleName}}.Errors.OAuth2TokenError{message: "no access_token"},
            %{{moduleName}}.Errors.OAuth2ServerError{status_code: 400, message: "invalid_grant"}
          ] do
        assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(err)
      end
    end

    test "bhv errors 003 every status-specific error accepts an optional cause" do
      cause = %RuntimeError{message: "root cause"}

      for module <- [
            {{moduleName}}.Errors.BadRequestError,
            {{moduleName}}.Errors.UnauthorizedError,
            {{moduleName}}.Errors.ForbiddenError,
            {{moduleName}}.Errors.NotFoundError,
            {{moduleName}}.Errors.ConflictError,
            {{moduleName}}.Errors.UnprocessableEntityError,
            {{moduleName}}.Errors.TooManyRequestsError,
            {{moduleName}}.Errors.InternalServerError,
            {{moduleName}}.Errors.ClientError,
            {{moduleName}}.Errors.ServerError
          ] do
        assert module.exception(%{message: "boom", cause: cause}).cause == cause
        assert module.exception(%{message: "boom"}).cause == nil
      end
    end

    # Elixir exceptions have no inheritance, so the family predicates express
    # the hierarchy: a 404 is a NotFoundError, a ClientError and an ApiError; a
    # 500 is an InternalServerError, a ServerError and an ApiError; a
    # NetworkTimeoutError is a NetworkError and an ApiError.
    test "family predicates express the error hierarchy" do
      not_found = {{moduleName}}.Errors.NotFoundError.exception(%{message: "missing", status_code: 404})
      assert {{moduleName}}.Errors.ClientError.client_error?(not_found)
      refute {{moduleName}}.Errors.ServerError.server_error?(not_found)
      refute {{moduleName}}.Errors.NetworkError.network_error?(not_found)
      assert {{moduleName}}.Errors.ApiError.api_error?(not_found)
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(not_found)

      internal = {{moduleName}}.Errors.InternalServerError.exception(%{message: "boom", status_code: 500})
      assert {{moduleName}}.Errors.ServerError.server_error?(internal)
      refute {{moduleName}}.Errors.ClientError.client_error?(internal)
      assert {{moduleName}}.Errors.ApiError.api_error?(internal)
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(internal)

      timeout = {{moduleName}}.Errors.NetworkTimeoutError.exception(message: "timed out")
      assert {{moduleName}}.Errors.NetworkError.network_error?(timeout)
      assert {{moduleName}}.Errors.ApiError.api_error?(timeout)
      refute {{moduleName}}.Errors.NetworkError.network_error?({{moduleName}}.Errors.ApiError.exception(message: "x"))

      serialization = %{{moduleName}}.Errors.SerializationError{message: "bad"}
      refute {{moduleName}}.Errors.ApiError.api_error?(serialization)
      refute {{moduleName}}.Errors.ApiError.api_error?(%ArgumentError{message: "unrelated"})
    end

    test "bhv errors 033 NotFoundError is a ClientError and an ApiError" do
      err = {{moduleName}}.Errors.ApiError.from_response(404, %{}, nil)

      assert %{{moduleName}}.Errors.NotFoundError{} = err
      assert {{moduleName}}.Errors.ClientError.client_error?(err)
      assert {{moduleName}}.Errors.ApiError.api_error?(err)
    end

    test "a 429 is a TooManyRequestsError and a ClientError" do
      err = {{moduleName}}.Errors.ApiError.from_response(429, %{"retry-after" => "3"}, nil)

      assert %{{moduleName}}.Errors.TooManyRequestsError{status_code: 429} = err
      assert err.message == "API returned status code 429"
      assert {{moduleName}}.Errors.TooManyRequestsError.exception("slow down").status_code == 429
      assert {{moduleName}}.Errors.ClientError.client_error?(err)
      assert {{moduleName}}.Errors.ApiError.api_error?(err)
    end

    # The public status factory every generated operation and the OpenID
    # Connect discovery request use: the most specific error for each status,
    # with the status, headers and body kept and a JSON body parsed.
    test "bhv errors 006 from_response maps every status to its error" do
      headers = %{"x-request-id" => "abc"}

      for {status, module} <- [
            {400, {{moduleName}}.Errors.BadRequestError},
            {401, {{moduleName}}.Errors.UnauthorizedError},
            {403, {{moduleName}}.Errors.ForbiddenError},
            {404, {{moduleName}}.Errors.NotFoundError},
            {409, {{moduleName}}.Errors.ConflictError},
            {422, {{moduleName}}.Errors.UnprocessableEntityError},
            {429, {{moduleName}}.Errors.TooManyRequestsError},
            {418, {{moduleName}}.Errors.ClientError},
            {500, {{moduleName}}.Errors.InternalServerError},
            {503, {{moduleName}}.Errors.ServerError},
            {302, {{moduleName}}.Errors.ApiError},
            # A status outside 400-599 is neither a ClientError nor a
            # ServerError: the 5xx arm stops at 599, so 600 is an ApiError.
            {600, {{moduleName}}.Errors.ApiError}
          ] do
        err = {{moduleName}}.Errors.ApiError.from_response(status, headers, ~s({"k":"v"}))

        assert err.__struct__ == module
        assert err.status_code == status
        assert err.response_headers == headers
        assert err.response_body == ~s({"k":"v"})
        assert err.error_body == %{"k" => "v"}
        assert {{moduleName}}.Errors.ApiError.api_error?(err)
        assert {{moduleName}}.Errors.ClientError.client_error?(err) == (status in 400..499)
        assert {{moduleName}}.Errors.ServerError.server_error?(err) == (status in 500..599)
      end
    end

    test "bhv errors 020 network errors carry status 0" do
      assert {{moduleName}}.Errors.NetworkError.exception(message: "refused").status_code == 0
      assert {{moduleName}}.Errors.NetworkTimeoutError.exception(message: "timed out").status_code == 0
    end

    test "non-SDK exceptions are not recognised" do
      refute {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(%RuntimeError{message: "unrelated"})
      refute {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(%ArgumentError{message: "unrelated"})
      refute {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(:not_an_exception)
      refute {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(%{message: "plain map"})
    end
  end
end
{{/generateTests}}
