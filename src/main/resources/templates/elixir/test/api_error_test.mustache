        rescue
          error -> error
        end

      assert %{{moduleName}}.Errors.NotFoundError{} = caught
      assert caught.status_code == 404
      assert {{moduleName}}.Errors.{{errorPrefix}}Error.{{errorPrefixSnake}}_error?(caught)
