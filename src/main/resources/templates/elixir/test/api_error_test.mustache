  defmodule ExactFactory do
    def from_error_response(status, headers, body),
      do: {{moduleName}}.Errors.ApiError.exception(message: "exact", status_code: status, response_headers: headers, response_body: body)
  end

  defmodule RangeFactory do
    def from_error_response(status, headers, body),
      do: {{moduleName}}.Errors.ApiError.exception(message: "range", status_code: status, response_headers: headers, response_body: body)
  end

  defmodule DefaultFactory do
    def from_error_response(status, headers, body),
      do: {{moduleName}}.Errors.ApiError.exception(message: "default", status_code: status, response_headers: headers, response_body: body)
  end

  test "bhv errors 203 the error factory of an operation is chosen by exact status, then range, then default" do
    errors = %{"404" => ExactFactory, "4XX" => RangeFactory, "default" => DefaultFactory}
    from = fn status, map -> {{moduleName}}.Errors.ApiError.from_response(status, %{}, "{}", map) end

    assert from.(404, errors).message == "exact"
    assert from.(418, errors).message == "range"
    assert from.(502, errors).message == "default"
    assert %{{moduleName}}.Errors.BadGatewayError{} = from.(502, %{})
    assert %{{moduleName}}.Errors.NotFoundError{} = from.(404, %{"5XX" => RangeFactory})
  end
