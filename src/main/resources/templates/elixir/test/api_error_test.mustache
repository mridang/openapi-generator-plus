    test "bhv errors 053 each named error pins its own HTTP status code" do
      assert {{moduleName}}.Errors.NotFoundError.exception(%{status_code: 500}).status_code == 404

      assert {{moduleName}}.Errors.TooManyRequestsError.exception(%{status_code: 500}).status_code ==
