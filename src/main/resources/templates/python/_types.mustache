import base64
import datetime
import math
import re
import secrets
from decimal import Decimal
from typing import Annotated, Any

from pydantic import (
    AfterValidator,
    AwareDatetime,
    BeforeValidator,
    Field,
    PlainSerializer,
    PlainValidator,
    SecretStr,
    SerializationInfo,
    Strict,
)


# An absolute RFC 3986 URI: a scheme, then ':', then no whitespace or control
# characters. Any scheme is valid (http, ftp, mailto, urn); a relative
# reference, an empty string or text with spaces is not.
_ABSOLUTE_URI_PATTERN = re.compile(r'^[A-Za-z][A-Za-z0-9+.-]*:[^\s\x00-\x1f\x7f]*$')


# An RFC 3339 date-time: a full date, 'T' (or 't'), a time with optional
# fractional seconds, and an explicit offset ('Z' or +hh:mm). Free text and
# offset-less strings are not valid wire values.
RFC3339_DATE_TIME_PATTERN = re.compile(
    r'^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$'
)


def _coerce_int_to_float(value: Any) -> Any:
    """Coerce an integral wire value to ``float`` for a strict-float field.

    JSON has a single number type, so a server is free to emit ``5`` (no
    decimal point) for a field declared ``format: double``/``float``. Bare
    pydantic ``StrictFloat`` rejects that integral value because the parsed
    Python type is ``int``, not ``float`` — even though ``5`` is a perfectly
    valid double on the wire. Widen ONLY the lossless ``int -> float`` case
    here; every other type (``str``, ``bool``, ...) is passed through
    untouched so the downstream strict ``float`` validator still rejects it.
    ``bool`` is an ``int`` subclass, so it is excluded explicitly to keep the
    StrictFloat guarantee that ``True``/``False`` are not silently accepted
    as ``1.0``/``0.0``.
    """
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        return float(value)
    if isinstance(value, float):
        return float(value)
    return value


class PreciseFloat(float):
    """A ``float`` that remembers the JSON text it was parsed from.

    ``json.loads`` is given this class as ``parse_float`` so a ``type: number``
    field can rebuild its ``Decimal`` from the original digits instead of from
    the already-rounded binary float. Everywhere else it is an ordinary float.
    """

    text: str

    def __new__(cls, text: str) -> 'PreciseFloat':
        instance = super().__new__(cls, text)
        instance.text = text
        return instance


# Serialization context key that asks a `type: number` field to write its exact
# decimal text. `ObjectSerializer.serialize` sets it, then swaps the marker
# strings below for bare JSON numbers. A plain `model_dump_json()` does not set
# it and keeps writing a float.
EXACT_NUMBER_CONTEXT: dict[str, Any] = {'exact_numbers': True}

# A per-process random marker, so no payload can collide with it.
_EXACT_NUMBER_PREFIX = f'~exact-number-{secrets.token_hex(8)}:'
_EXACT_NUMBER_PATTERN = re.compile(
    '"' + re.escape(_EXACT_NUMBER_PREFIX) + r'(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)"'
)


def resolve_exact_numbers(text: str) -> str:
    """Replace every exact-number marker in serialized JSON by its bare number."""
    return _EXACT_NUMBER_PATTERN.sub(r'\1', text)


def _validate_json_number(value: Any) -> Any:
    """Build the ``Decimal`` of a ``type: number`` field without any float rounding.

    A JSON number is accepted (an ``int``, a ``Decimal``, or a float parsed by
    ``PreciseFloat`` which keeps its source digits). A string or a boolean is
    rejected: a quoted number is not a JSON number.
    """
    if isinstance(value, bool) or isinstance(value, str):
        raise ValueError(f'a number must be a JSON number, not {type(value).__name__}')
    if isinstance(value, Decimal):
        number = value
    elif isinstance(value, PreciseFloat):
        number = Decimal(value.text)
    elif isinstance(value, int):
        number = Decimal(value)
    elif isinstance(value, float):
        number = Decimal(repr(value))
    else:
        raise ValueError(f'a number must be a JSON number, not {type(value).__name__}')
    if not number.is_finite():
        raise ValueError(f'{value} is not a finite JSON number')
    return number


def _decimal_to_json_number(value: Decimal, info: SerializationInfo) -> Any:
    """Write a ``Decimal`` as a JSON number.

    With the exact-number context the full decimal text is written, so nothing
    is rounded. Without it the value is widened to a ``float``. A value that is
    not finite (or does not fit a double in that second form) is rejected so a
    non-finite number never reaches the wire.
    """
    if not value.is_finite():
        raise ValueError(f'{value} is not representable as a finite JSON number')
    context = info.context
    if isinstance(context, dict) and context.get('exact_numbers') is True:
        return _EXACT_NUMBER_PREFIX + str(value)
    number = float(value)
    if not math.isfinite(number):
        raise ValueError(f'{value} is not representable as a finite JSON number')
    return number


def format_time_of_day(value: datetime.time) -> str:
    """Write a ``format: time`` value as an RFC 3339 partial-time.

    Whole seconds are written as ``HH:MM:SS``; a non-zero millisecond part adds
    ``.SSS`` (truncated, never rounded). It is never a full date-time.
    """
    if value.microsecond // 1000:
        return value.isoformat(timespec='milliseconds')
    return value.isoformat(timespec='seconds')


def _validate_url_preserving(value: Any) -> Any:
    """Validate an absolute URI without mutating it.

    Any scheme is accepted (``urn:``, ``mailto:`` and ``ftp:`` are valid); a
    relative reference or a string with whitespace is not. The ORIGINAL string
    is returned so the wire value round-trips byte-identical, which a
    normalizing parser such as ``pydantic.HttpUrl`` would break.
    """
    if value is None:
        return value
    if not isinstance(value, str) or not _ABSOLUTE_URI_PATTERN.match(value):
        raise ValueError(f'{value!r} is not an absolute URI')
    return value


def _reject_non_string_date_time(value: Any) -> Any:
    """Reject a JSON number or boolean offered for a ``date-time`` field.

    Lax ``AwareDatetime`` reads an ``int``/``float`` as epoch seconds (or
    milliseconds), and ``bool`` is an ``int``, so ``{"timestamp": 1700000000}``
    would decode to a real instant. The date-time wire form is an RFC 3339
    string, and the other SDKs refuse any other JSON type, so only ``str`` and
    ``datetime`` objects reach the downstream validator.
    """
    if isinstance(value, (bool, int, float)):
        raise ValueError(
            f'a date-time must be an RFC 3339 string, not {type(value).__name__}'
        )
    if isinstance(value, str) and not RFC3339_DATE_TIME_PATTERN.match(value):
        raise ValueError(f'{value!r} is not an RFC 3339 date-time')
    return value


def _decode_base64(value: Any) -> bytes:
    """Validate a ``format: byte`` field.

    A ``str`` is the wire form: strict base64 (alphabet and padding are
    checked, so ``'!!!!'`` or an embedded space is rejected rather than
    silently dropped). ``bytes`` are the in-memory form and pass through
    untouched: pydantic's own ``Base64Bytes`` would try to base64-DECODE them
    again on construction and assignment.
    """
    if isinstance(value, str):
        return base64.b64decode(value, validate=True)
    if isinstance(value, (bytes, bytearray)):
        return bytes(value)
    raise ValueError(
        f'expected bytes or a base64 string, got {type(value).__name__}'
    )


def _encode_base64(value: bytes) -> str:
    return base64.b64encode(value).decode('ascii')


# `format: float` / `format: double` fields. StrictFloat semantics (reject
# str/bool, no lax string coercion) are preserved via `Strict()`; the
# BeforeValidator only widens the legitimate integral-JSON case to float.
#
# `allow_inf_nan=False` rejects NaN/Infinity on construction, assignment and
# decode: pydantic would otherwise write them into a JSON body as `null`.
LaxFloat = Annotated[
    float,
    BeforeValidator(_coerce_int_to_float),
    Strict(),
    Field(allow_inf_nan=False),
]


# `format: uri` fields. A plain `str` carrying an AfterValidator that asserts
# the value is an absolute RFC 3986 URI (any scheme) but never rewrites it, so the wire
# value round-trips byte-identical (unlike `pydantic.HttpUrl`, which normalizes).
UrlStr = Annotated[str, AfterValidator(_validate_url_preserving)]


# Bare `type: number` (no `format`) fields. The OpenAPI spec types these as a
# JSON NUMBER, so they must travel on the wire UNQUOTED (`1.5`, not `"1.5"`).
# Decode keeps `decimal.Decimal` for arbitrary-precision fidelity (matching
# BigDecimal in Java/Kotlin and the branded Decimal in Node), but pydantic's
# default Decimal serializer emits a JSON STRING, which violates `type: number`
# and diverges from the SDKs that emit a bare number. The validator rebuilds the
# Decimal from the source digits (no float rounding) and rejects a quoted string;
# the PlainSerializer writes an unquoted number on the JSON encode path
# (`when_used='json'`): the exact decimal text when ObjectSerializer asks for it,
# a float for a plain model_dump_json().
JsonNumber = Annotated[
    Decimal,
    BeforeValidator(_validate_json_number),
    PlainSerializer(_decimal_to_json_number, return_type=Any, when_used='json'),
]


# `format: time` model fields: a `datetime.time` written as an RFC 3339
# partial-time (`HH:MM:SS`, plus `.SSS` only when the millisecond part is
# non-zero) instead of pydantic's microsecond form.
TimeOfDay = Annotated[
    datetime.time,
    PlainSerializer(format_time_of_day, return_type=str, when_used='json'),
]


# `format: date-time` model fields. Bare pydantic `AwareDatetime` serializes via
# model_dump_json with a trailing `Z` and a variable-width fractional part
# (e.g. `2024-01-01T12:30:45Z`, `2020-01-02T03:04:05.123000Z`), which diverges
# from the other SDKs that pin EXACTLY a fixed 3-digit millisecond fraction and
# a numeric UTC offset, never `Z` (`2024-01-01T12:30:45.000+00:00`).
# OffsetDateTime keeps AwareDatetime's validator (naive datetimes are still
# rejected) and adds a JSON-only PlainSerializer that emits
# `isoformat(timespec='milliseconds')`: an aware UTC datetime renders `+00:00`
# (never `Z`) with exactly three fractional digits, matching the wire form every
# other SDK produces. The parameter (`stringify`) and dict
# (`_sanitize_for_serialization`) paths already pin this `.SSS+00:00` form; this
# alias closes the one remaining leak on the model_dump_json body path.
OffsetDateTime = Annotated[
    AwareDatetime,
    BeforeValidator(_reject_non_string_date_time),
    PlainSerializer(
        lambda value: value.isoformat(timespec='milliseconds'),
        return_type=str,
        when_used='json',
    ),
]


# `format: byte` (and OAS 3.1 `contentEncoding: base64`) fields. The model holds
# RAW bytes in memory and base64 only exists on the wire, as in the other SDKs:
# a str is strictly base64-decoded on validation, bytes pass through, and the
# JSON-only PlainSerializer base64-encodes on encode. Bare pydantic
# `Base64Bytes` decodes whatever it is given, so constructing or assigning raw
# bytes failed or silently corrupted them, and it decodes leniently.
Base64Bytes = Annotated[
    bytes,
    PlainValidator(_decode_base64),
    PlainSerializer(_encode_base64, return_type=str, when_used='json'),
]


# `format: password` model fields. The value stays a pydantic `SecretStr` in
# memory, so repr/str keep masking it, but bare `SecretStr` serializes via
# model_dump_json as the literal `"**********"`, which would send the mask
# instead of the password. This JSON-only PlainSerializer writes the real value,
# as every other SDK does.
PasswordStr = Annotated[
    SecretStr,
    PlainSerializer(
        lambda value: value.get_secret_value(),
        return_type=str,
        when_used='json',
    ),
]
