from dataclasses import dataclass, field
from typing import Callable, Dict, Optional

from .base_authenticator import BaseAuthenticator

# Only ASCII whitespace counts as blank; a Unicode space is not stripped.
_ASCII_WHITESPACE = " \t\n\r\f\v"


def _check_token(token: str) -> None:
    """Reject a token that is blank or that cannot be sent as a header value."""
    # Reject an empty / whitespace-only token so the SDK never emits a
    # bare ``Authorization: Bearer `` header, matching the api-key
    # authenticator's own empty guard.
    if not token or not token.strip(_ASCII_WHITESPACE):
        raise ValueError('Bearer token must not be empty')
    # RFC 7230 §3.2.6 — field-value is HTAB / SP / VCHAR / obs-text.
    # Reject anything outside printable ASCII + TAB so callers see a
    # clear error rather than HTTP header injection from CR/LF or
    # silently-mangled non-ASCII bytes.
    if any(c != '\t' and (ord(c) < 0x20 or ord(c) >= 0x7F) for c in token):
        raise ValueError(
            'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
        )


@dataclass(frozen=True, eq=False)
class BearerAuthenticator(BaseAuthenticator):
    """Authenticator for HTTP Bearer token authentication.

    Give it a static ``token``, or a ``token_provider`` callable that returns
    the current token. The provider runs for every request, so a token that
    rotates is always the fresh one; give one of the two, never both.
    """

    host: str
    # repr=False so the bearer token is never leaked through the dataclass's
    # auto-generated repr/str (e.g. logging, f-strings, %r). The default
    # representation shows the host only.
    token: str = field(default='', repr=False)
    token_provider: Optional[Callable[[], str]] = field(default=None, repr=False)

    def __post_init__(self) -> None:
        if self.token_provider is not None:
            if self.token:
                raise ValueError('Give a bearer token or a token provider, not both')
            return
        _check_token(self.token)

    def get_host(self) -> str:
        return self.host

    def get_auth_headers(self) -> Dict[str, str]:
        # Dedupe "Bearer " prefix (case-insensitive ASCII): tokens read
        # from env files are commonly stored already-prefixed; emitting
        # "Bearer Bearer xyz" would otherwise silently break auth.
        value = self.token_provider() if self.token_provider is not None else self.token
        if self.token_provider is not None:
            _check_token(value)
        if len(value) >= 7 and value[:7].lower() == 'bearer ':
            value = value[7:]
        return {'Authorization': f'Bearer {value}'}

    def __repr__(self) -> str:
        """Redacts the bearer token so it never leaks into logs or tracebacks.

        The token is shown as the literal ``***`` while non-sensitive fields
        remain visible to keep the representation useful for debugging.
        """
        return f"{type(self).__name__}(host={self.host!r}, token='***')"
