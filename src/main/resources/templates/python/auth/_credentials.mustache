import os
from typing import Optional


def resolve_credential(passed: Optional[str], env_name: str, what: str) -> str:
    """Resolves one credential of a per-scheme authenticator.

    The value you pass wins, even an empty one (the authenticator's own check
    then rejects it). Otherwise the environment variable ``env_name`` is read,
    once, here; an empty variable counts as unset.

    Args:
        passed: The value the caller passed, or ``None`` when it passed none.
        env_name: The environment variable to fall back to.
        what: The name of the credential, for the error message.

    Returns:
        The credential.

    Raises:
        ValueError: If the caller passed none and the variable is unset or
            empty.
    """
    if passed is not None:
        return passed
    from_environment = os.environ.get(env_name)
    if from_environment:
        return from_environment
    raise ValueError(
        f"Missing the credential '{what}': pass it, or set the environment variable {env_name}"
    )
