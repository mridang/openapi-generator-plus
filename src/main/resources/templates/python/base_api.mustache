T = TypeVar('T')
_P = ParamSpec('_P')
_R = TypeVar('_R')


class CallOptions(Protocol):
    """The per-call settings every operation's Options object carries.

    ``timeout`` (milliseconds, one end-to-end budget), ``headers`` (replace a
    default header of the same name) and ``max_retries`` override the client's
    settings for one call; ``None`` keeps the client's.
    """

    @property
    def timeout(self) -> Optional[int]: ...

    @property
    def headers(self) -> Optional[Mapping[str, str]]: ...

    @property
    def max_retries(self) -> Optional[int]: ...


# Methods that may be sent again after a connection drops with no response (RFC 9110 9.2.2).
# A POST or PATCH is sent once, because the server may already have acted on it.
_IDEMPOTENT_METHODS = frozenset({'GET', 'HEAD', 'OPTIONS', 'TRACE', 'PUT', 'DELETE', 'QUERY'})


def _is_replayable(body: Any) -> bool:
    """A body can be sent again only if no part of it is a one-shot stream."""
    if hasattr(body, 'read'):
        return False
    if isinstance(body, dict):
        return all(_is_replayable(v) for v in body.values())
    if isinstance(body, (list, tuple)):
        return all(_is_replayable(v) for v in body)
    return True


def _is_tls_failure(error: NetworkException) -> bool:
    """A certificate or handshake failure will fail the same way again."""
    cause = error.__cause__
    return isinstance(cause, (ssl.SSLError, urllib3.exceptions.SSLError))


class _NoAuth:
    """Internal no-auth sentinel type.

    An operation declared with ``security: []`` in the spec is explicitly
    unauthenticated. To distinguish "this operation suppresses auth" from
    "no scheme credential applies" (both of which were previously
    represented by ``None``), the generated api methods pass the singleton
    :data:`NO_AUTH` instance of this type as the ``auth`` argument.

    The auth argument therefore has three states:

    * ``NO_AUTH``                  -> no auth applied; do NOT fall back to the
      client-level authenticator (``security: []`` operation).
    * ``None``                     -> no scheme credential applies; fall back to
      the client-level authenticator (secured operation).
    * a real :class:`Authenticator` -> the credential of the security scheme
      the operation names; use it.

    The sentinel is identity-comparable (``auth is NO_AUTH``) and never leaves
    the generated client; callers never see it.
    """

    __slots__ = ()


# Module-level singleton no-auth sentinel. Identity-compared in
# _invoke_api_for_result; see _NoAuth for the three-state contract.
NO_AUTH = _NoAuth()


_COOKIE_NAME_CHARS = frozenset(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'*+-.^_`|~"
)


def _is_valid_cookie_name(name: str) -> bool:
    """RFC 6265 cookie-name validation (RFC 7230 token)."""
    if not name:
        return False
    return all(c in _COOKIE_NAME_CHARS for c in name)


def _is_valid_cookie_value(value: str) -> bool:
    """RFC 6265 cookie-value validation (cookie-octet*)."""
    for c in value:
        code = ord(c)
        if not (
            code == 0x21
            or 0x23 <= code <= 0x2B
            or 0x2D <= code <= 0x3A
            or 0x3C <= code <= 0x5B
            or 0x5D <= code <= 0x7E
        ):
            return False
    return True


def _tracked(
    method: Callable[Concatenate['BaseApi', _P], Awaitable[_R]],
) -> Callable[Concatenate['BaseApi', _P], Coroutine[Any, Any, _R]]:
    """Counts the call as in flight on the API's :class:`DefaultApiClient`.

    A call that has started when the client is closed finishes (its retries and
    its token requests included) and the transport is released when the last
    one ends; a call that starts afterwards raises :class:`RuntimeError`.
    """

    @functools.wraps(method)
    async def wrapper(self: 'BaseApi', *args: _P.args, **kwargs: _P.kwargs) -> _R:
        client = self._api_client
        if isinstance(client, DefaultApiClient):
            with client._in_flight():
                return await method(self, *args, **kwargs)
        return await method(self, *args, **kwargs)

    return wrapper


class BaseApi:
    """Base class for all API classes.

    Provides the invoke_api method that handles URL construction, header
    selection, body serialization, request dispatch, and response
    deserialization.
    """

    def __init__(
        self,
        api_client: Optional[ApiClient] = None,
        config: Optional[Configuration] = None,
        authenticator: Optional[Authenticator] = None,
        scheme_authenticators: Optional[Mapping[str, Authenticator]] = None,
    ):
        """Create an API instance.

        When called with no arguments, uses the default configuration and
        a default-constructed :class:`DefaultApiClient` (with default
        transport settings).

        When called with a configuration only, creates a
        :class:`DefaultApiClient` with default transport settings.

        When called with both an api_client and config, uses the provided
        instances directly (this is the path used by :class:`Client`).

        Args:
            api_client: The HTTP transport client. If ``None``, a
                :class:`DefaultApiClient` with default transport is created.
            config: API-level configuration (base URL and default headers).
                If ``None``, the default configuration is used.
            authenticator: Default authenticator, used by an operation none of
                whose security schemes has a credential in
                ``scheme_authenticators``.
            scheme_authenticators: The credential of each security scheme, by
                the scheme id in the spec. An operation uses the credential of
                the first scheme it lists that is in here.
        """
        self._config = config or Configuration.default_configuration()
        self._api_client = api_client or DefaultApiClient()
        self._authenticator = authenticator
        self._scheme_authenticators: Mapping[str, Authenticator] = scheme_authenticators or {}
        self._object_serializer = ObjectSerializer()
        self._header_selector = HeaderSelector()

    def _scheme_authenticator(self, *scheme_ids: str) -> Optional[Authenticator]:
        """The credential of the first of ``scheme_ids`` the client holds one for.

        A generated operation passes the schemes its spec lists, in the order it
        lists them, so it always uses the scheme the spec names and a caller
        cannot pick another per call. ``None`` when the client holds none of
        them, which leaves the call to the client-level authenticator (and sends
        no credential when there is none).
        """
        for scheme_id in scheme_ids:
            found = self._scheme_authenticators.get(scheme_id)
            if found is not None:
                return found
        return None

    @_tracked
    async def _invoke_api_for_result(
        self,
        method: str,
        path: str,
        query_params: Dict[str, Any],
        header_params: Dict[str, str],
        body: Any,
        accepts: List[str],
        content_type: Optional[str],
        return_type: Optional[str],
        auth: Union[Authenticator, '_NoAuth', None] = None,
        raw_body: bool = False,
        operation_name: str = '',
        request_options: Optional[CallOptions] = None,
        decode_success: Optional[Callable[[int, str], Any]] = None,
        error_schemas: Optional[Mapping[str, ErrorFactory]] = None,
        operation_id: str = '',
        url_template: str = '',
    ) -> 'ApiResult[Any]':
        """Invoke an API operation and return the full result including status
        code, headers, and raw body alongside the deserialized data.

        Args:
            method: HTTP method (GET, POST, PUT, DELETE, etc.).
            path: URL path (with path params already substituted).
            query_params: Query parameters.
            header_params: Custom header parameters.
            body: Request body (model object or None).
            accepts: Acceptable response content types.
            content_type: Request content type.
            return_type: Return type for deserialization (None for void).
            auth: Operation-specific auth resolution. Three states:
                ``NO_AUTH`` suppresses auth (``security: []`` operation),
                ``None`` falls back to the client-level authenticator, and a
                real :class:`Authenticator` is the credential of the security
                scheme the operation names (:meth:`_scheme_authenticator`).
            raw_body: Send the body as raw bytes.
            operation_name: The operation id, named in the error text for an
                unexpected response Content-Type.
            request_options: The operation's Options object: its ``timeout``,
                ``headers`` and ``max_retries`` apply to this call only.
            decode_success: Decodes a 2xx body by the status code it came with,
                for an operation that answers different schemas per status.
            error_schemas: The factories of the error schemas this operation
                declares, by declared status (``'404'``, ``'4XX'``,
                ``'default'``), or ``None`` when it declares none.
            operation_id: The operation id exactly as written in the spec,
                handed to the call hook.
            url_template: The spec path template of the operation, handed to
                the call hook.

        Returns:
            ApiResult containing deserialized data, status code, raw body,
            and headers.

        Raises:
            ApiException: If the API call fails.
        """
        if path.startswith('http://') or path.startswith('https://'):
            url = path
        else:
            # Strip trailing slash from baseUrl when path starts with `/`
            # so baseUrl='https://x/' + path='/y' produces 'https://x/y',
            # not 'https://x//y' which most servers route to 404. Matches
            # Java/C#/Go/Swift/Dart/Kotlin which collapse via URI parsers.
            url = self._config.base_url.rstrip('/') + path if path.startswith('/') else self._config.base_url + path

        # The path of the request without its query, named on every error.
        request_path = urlsplit(url).path
        # The URL the call hook sees: no query string, fragment or credentials.
        split_url = urlsplit(url)
        hook_url = urlunsplit(
            (split_url.scheme, split_url.netloc.rpartition('@')[2], split_url.path, '', '')
        )

        # Resolve auth into three states (see _NoAuth):
        #   - auth is NO_AUTH         -> suppress auth; do NOT fall back to the
        #                                client authenticator (security: [] op).
        #   - auth is None            -> no scheme credential applies; fall back
        #                                to the client-level authenticator.
        #   - auth is an Authenticator -> the operation's scheme credential.
        effective_auth: Optional[Authenticator]
        if isinstance(auth, _NoAuth):
            effective_auth = None
        elif auth is not None:
            effective_auth = auth
        else:
            effective_auth = self._authenticator

        # The client injects its transport into every credential it was built
        # with. A scheme credential handed straight to an API class (no client)
        # was never given one, so hand it this API's own client before it
        # fetches a token.
        if (
            auth is not None
            and effective_auth is auth
            and isinstance(auth, HttpAwareAuthenticator)
        ):
            auth.set_api_client(self._api_client)

        if effective_auth is not None:
            query_params.update(effective_auth.get_query_params())

        if query_params:
            filtered = {k: v for k, v in query_params.items() if v is not None}
            if filtered:
                # OAS allowReserved: a value wrapped in AllowReservedValue keeps
                # RFC 3986 reserved characters literal instead of percent-encoding
                # them. Each parameter is encoded by its own rule, in the order
                # the parameters were declared (the dict keeps insertion order),
                # so a reserved-preserving parameter never moves after the rest.
                parts: list[str] = []
                for k, v in filtered.items():
                    allow_reserved = isinstance(v, AllowReservedValue)
                    if isinstance(v, AllowReservedValue):
                        v = v.value
                    items = (
                        [self._object_serializer.stringify(item) for item in v]
                        if isinstance(v, list)
                        else [self._object_serializer.stringify(v)]
                    )
                    if allow_reserved:
                        encoded_key = quote(k, safe='')
                        for item in items:
                            parts.append(
                                encoded_key
                                + '='
                                + ValueSerializer.encode_query_allowing_reserved(item)
                            )
                    else:
                        # quote_via=quote emits %20 for a space (not '+'); RFC 3986
                        # requires %20 in a query component, and the other SDKs
                        # encode query spaces as %20 too. The form-urlencoded body
                        # path below keeps the default '+' via quote_plus.
                        encoded = urlencode({k: items}, doseq=True, quote_via=quote)
                        if encoded:
                            parts.append(encoded)
                query_string = '&'.join(parts)
                if query_string:
                    url += '?' + query_string

        call_headers = request_options.headers if request_options is not None else None
        call_timeout = request_options.timeout if request_options is not None else None
        call_max_retries = request_options.max_retries if request_options is not None else None

        is_multipart = content_type is not None and content_type.lower().startswith('multipart/')

        # What the call hook changed in the header set: the headers it set and
        # the names it removed. Every send rebuilds the headers, so the edits
        # are applied again to each rebuilt set.
        hook_set: Dict[str, str] = {}
        hook_removed: List[str] = []

        async def build_headers(replay: bool = False) -> Dict[str, str]:
            """Build the request headers from scratch, authentication included.

            Every send, a retry and the replay after a 401 alike, is a fresh
            request, so the headers (the token, the trace context) are built
            again rather than reused. The edits of the call hook are applied
            again, except that the fresh authentication headers of a replay
            replace a hook header of the same name.
            """
            auth_names: set[str] = set()
            headers = self._header_selector.select_headers(accepts, content_type or '', is_multipart)
            _merge_headers(headers, self._config.default_headers)
            if header_params:
                _merge_headers(headers, header_params)
            if call_headers:
                _merge_headers(headers, call_headers)
            if effective_auth is not None:
                # Offload auth-header acquisition to a worker thread. For OAuth this
                # call acquires a threading.Lock and may perform a blocking HTTP
                # token exchange; running it inline on the event-loop thread would
                # freeze every other coroutine for the duration of the token fetch.
                # The request send below is already offloaded via asyncio.to_thread,
                # so offloading the auth step keeps the whole auth+send path off the
                # loop thread and lets concurrent requests make progress.
                auth_headers = await asyncio.to_thread(effective_auth.get_auth_headers)
                auth_names = {name.lower() for name in auth_headers}
                _merge_headers(headers, auth_headers)
                cookies = effective_auth.get_cookie_params()
                if cookies:
                    # RFC 6265 — don't URL-encode cookie name/value; most cookie
                    # parsers don't URL-decode, so `=` (base64 padding) would
                    # arrive as literal `%3D` and break JWT/session cookies.
                    # Validate and pass through raw instead.
                    cookie_parts = []
                    for k, v in cookies.items():
                        name = str(k)
                        value = str(v)
                        if not _is_valid_cookie_name(name):
                            raise ValueError(
                                f"Cookie name '{name}' contains characters forbidden by RFC 6265"
                            )
                        if not _is_valid_cookie_value(value):
                            raise ValueError(
                                f"Cookie value for '{name}' contains characters outside the "
                                'RFC 6265 cookie-octet set; percent-encode the value before passing it'
                            )
                        cookie_parts.append(f'{name}={value}')
                    cookie_str = '; '.join(cookie_parts)
                    existing = headers.get('Cookie', '')
                    if existing:
                        headers['Cookie'] = existing + '; ' + cookie_str
                    else:
                        headers['Cookie'] = cookie_str
            inject_trace_context(headers)
            if hook_set or hook_removed:
                for name in hook_removed:
                    _remove_header(headers, name)
                _merge_headers(
                    headers,
                    {
                        name: value
                        for name, value in hook_set.items()
                        if not (replay and name.lower() in auth_names)
                    },
                )

            # Remove Content-Type when there is no body (semantically wrong to send it)
            if body is None:
                _remove_header(headers, 'Content-Type')
            return headers

        headers = await build_headers()

        observer: Optional[CallObserver] = None
        hook = self._config.call_hook
        if hook is not None:
            before = dict(headers)
            observer = hook.start(
                CallInfo(
                    operation_id=operation_id or operation_name,
                    method=method.upper(),
                    url_template=url_template,
                    url=hook_url,
                    server_address=(split_url.hostname or '').lower(),
                ),
                headers,
            )
            hook_set.update({name: value for name, value in headers.items() if before.get(name) != value})
            hook_removed.extend(name for name in before if name not in headers)

        response: Optional[ApiHttpResponse] = None
        try:
            serialized_body = None
            if body is not None:
                if is_multipart:
                    serialized_body = body
                elif raw_body:
                    # The operation's body is format: binary. Whatever declared
                    # Content-Type the caller selected (application/json included),
                    # the caller's bytes / stream go out verbatim; the selector only
                    # changes the header, it never re-encodes the payload.
                    serialized_body = body
                elif content_type is not None and (
                    content_type.startswith('image/') or content_type == 'application/octet-stream'
                ):
                    # Raw-binary selection. When the operation also declares a
                    # multipart content type the body was assembled as a dict of
                    # form parts (file + optional metadata). A raw binary request
                    # has no envelope, so we must NOT hand that dict to the
                    # transport -- it would dispatch on `isinstance(body, dict)`
                    # and emit a multipart/form-data body, contradicting the
                    # caller's explicit octet-stream selection. Instead, send the
                    # single file part's raw bytes; the text metadata parts have
                    # no place on the wire for a raw stream and are dropped. A
                    # body that is already bytes / a file-like object is passed
                    # through unchanged.
                    if isinstance(body, dict):
                        binary_part = None
                        for _part_value in body.values():
                            if isinstance(_part_value, (bytes, bytearray)) or hasattr(_part_value, 'read'):
                                binary_part = _part_value
                                break
                        serialized_body = binary_part if binary_part is not None else body
                    else:
                        serialized_body = body
                elif content_type == 'text/plain':
                    serialized_body = str(body)
                elif content_type == 'application/x-www-form-urlencoded':
                    # Build a (key, value) pair list so array values become
                    # repeated keys (`tags=a&tags=b`) rather than a single
                    # `tags=['a', 'b']` Python-repr. Each scalar is stringified
                    # through ObjectSerializer so bools render as `true`/`false`
                    # and enums/dates use their wire form, matching the other
                    # SDKs. None-valued fields are omitted, and None elements
                    # inside an array are skipped. urlencode(..., doseq=True)
                    # then percent-encodes with `quote_plus`, so a space becomes
                    # `+` (HTML form encoding), not `%20`.
                    # A model, map or array of objects has no defined form encoding
                    # (no OAS encoding style is emitted), so it is rejected rather
                    # than sent as its Python repr.
                    form_pairs: List[tuple[str, str]] = []
                    for form_key, form_value in body.items():
                        if form_value is None:
                            continue
                        if isinstance(form_value, (BaseModel, dict)) or (
                            isinstance(form_value, list)
                            and any(isinstance(item, (BaseModel, dict, list)) for item in form_value)
                        ):
                            raise SerializationException(
                                f'form-urlencoded field {form_key} must be a scalar or array of scalars'
                            )
                        if isinstance(form_value, list):
                            for form_item in form_value:
                                if form_item is None:
                                    continue
                                form_pairs.append((form_key, self._object_serializer.stringify(form_item)))
                        else:
                            form_pairs.append((form_key, self._object_serializer.stringify(form_value)))
                    serialized_body = urlencode(form_pairs, doseq=True)
                else:
                    serialized_body = self._object_serializer.serialize(body)

            try:
                response = await self._send_with_policy(
                    method,
                    url,
                    headers,
                    serialized_body,
                    build_headers,
                    effective_auth,
                    call_timeout,
                    call_max_retries,
                )
            except NetworkException as error:
                error._with_request(method, request_path)
                raise

            is_terminal_3xx = (
                300 <= response.status_code < 400
                and not any(k.lower() == 'location' for k in response.headers)
            )
            if (response.status_code < 200 or response.status_code >= 300) and not is_terminal_3xx:
                self._throw_api_exception(response, method, request_path, error_schemas)

            data: Any = None
            try:
                if return_type is not None and response.body:
                    resp_content_type = ''
                    for k, v in response.headers.items():
                        if k.lower() == 'content-type':
                            resp_content_type = v.split(';')[0].strip()
                            break
                    if resp_content_type and not self._header_selector.is_json_mime(resp_content_type):
                        if return_type == 'bytes':
                            import base64
                            data = base64.b64decode(response.body) if response.body else b''
                        elif return_type in ('str', 'StrictStr') and self._is_text_media_type(resp_content_type):
                            data = response.body
                        elif return_type in ('str', 'StrictStr'):
                            # A binary content type reaches the transport as base64 text; a
                            # string result is the decoded body, never that carrier text.
                            import base64
                            import binascii
                            try:
                                data = base64.b64decode(response.body, validate=True).decode('utf-8', errors='replace')
                            except (binascii.Error, ValueError) as decode_error:
                                raise SerializationException(
                                    f"Unexpected response Content-Type '{resp_content_type}' "
                                    f'for {self._operation_label(operation_name)}: the body is not base64'
                                ) from decode_error
                        else:
                            raise SerializationException(
                                f"Unexpected response Content-Type '{resp_content_type}' "
                                f'for {self._operation_label(operation_name)}: expected a JSON body'
                            )
                    elif return_type == 'bytes' and not isinstance(
                        ObjectSerializer.parse_json(response.body), str
                    ):
                        # A binary operation that may also answer application/json (content
                        # negotiation) gets a JSON document that is not a base64 string:
                        # hand back the raw body bytes, the same as every SDK that returns
                        # the bytes of whatever body arrived.
                        data = response.body.encode('utf-8') if isinstance(response.body, str) else response.body
                    elif decode_success is not None:
                        data = decode_success(response.status_code, response.body)
                    else:
                        data = self._object_serializer.deserialize(response.body, return_type)
            except SerializationException as error:
                # The response itself is what could not be decoded: keep what came
                # back so the caller can see the status, the headers and the body.
                error._with_response(
                    response.status_code,
                    response.headers,
                    response.body,
                    method,
                    request_path,
                )
                raise

            result = ApiResult(
                status_code=response.status_code,
                data=data,
                raw_body=response.body,
                headers=response.headers,
            )
        except BaseException as error:
            self._finish_call(observer, response, error)
            raise
        self._finish_call(observer, response, None)
        return result

    @staticmethod
    def _finish_call(
        observer: Optional[CallObserver],
        response: Optional[ApiHttpResponse],
        error: Optional[BaseException],
    ) -> None:
        """Tell the call hook's observer how the call ended; its own errors are swallowed."""
        if observer is None:
            return
        try:
            observer.finish(
                CallOutcome(
                    status_code=response.status_code if response is not None else 0,
                    headers=response.headers if response is not None else None,
                    error=error,
                )
            )
        except Exception:
            pass

    async def _send_with_policy(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any,
        rebuild_headers: Callable[..., Awaitable[Dict[str, str]]],
        auth: Optional[Authenticator],
        call_timeout: Optional[int] = None,
        call_max_retries: Optional[int] = None,
    ) -> ApiHttpResponse:
        """Send the request, retrying and re-authenticating as the policy says.

        Retries follow ``TransportOptions.max_retries``, or the call's own
        ``max_retries`` and ``timeout`` when the Options object sets them. A ``401`` on a call
        authenticated by an OAuth2 or OpenID Connect authenticator drops the
        cached access token (the refresh token is kept) and replays the request
        once with fresh headers; a second ``401`` is returned as it is. A body
        that cannot be sent twice (a stream or a multipart upload) is never
        retried or replayed. The retries and the replay share the one
        end-to-end ``TransportOptions.timeout``.
        """
        client = self._api_client
        replayable = body is None or isinstance(body, (str, bytes, bytearray, memoryview))
        max_retries = 0
        timeout = call_timeout
        deadline: Optional[float] = None
        if isinstance(client, DefaultApiClient):
            options = client.transport_options
            if replayable:
                max_retries = options.max_retries
            if timeout is None:
                timeout = options.timeout
        if replayable and call_max_retries is not None:
            max_retries = call_max_retries
        if timeout is not None:
            deadline = time.monotonic() + timeout / 1000.0
        response = await self._send_with_retries(
            method, url, headers, body, rebuild_headers, max_retries, deadline
        )
        invalidate = getattr(auth, 'invalidate_access_token', None)
        if (
            response.status_code == 401
            and replayable
            and callable(invalidate)
            and (deadline is None or time.monotonic() < deadline)
        ):
            # A revoked or rotated token keeps failing while it is cached: drop
            # it, obtain a new one (a refresh grant first) and send once more.
            # A failed re-authentication leaves the 401 as it is.
            invalidate()
            try:
                fresh_headers = await rebuild_headers(True)
            except {{errorPrefix}}Exception:
                return response
            return await self._send_with_retries(
                method, url, fresh_headers, body, rebuild_headers, max_retries, deadline
            )
        return response

    async def _send_with_retries(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any,
        rebuild_headers: Callable[..., Awaitable[Dict[str, str]]],
        max_retries: int,
        deadline: Optional[float],
    ) -> ApiHttpResponse:
        """Send the request, sending it again after a retryable failure.

        A retry follows a network error that happened before any response, for an
        idempotent method only, and a
        ``408``, ``409``, ``429`` or ``5xx`` (not ``501``) response. It waits
        for the ``Retry-After`` header or the exponential backoff, and every
        retry rebuilds the headers. The wait must fit in what is left of the
        end-to-end ``deadline``; otherwise the last outcome stands. A timeout
        is the budget running out, so it is not retried.
        """
        attempt = 0
        current = headers
        while True:
            response: Optional[ApiHttpResponse] = None
            failure: Optional[NetworkException] = None
            try:
                response = await self._send(method, url, current, body, deadline)
            except NetworkException as error:
                if (
                    isinstance(error, NetworkTimeoutException)
                    or _is_tls_failure(error)
                    or attempt >= max_retries
                    or method.upper() not in _IDEMPOTENT_METHODS
                    or not _is_replayable(body)
                ):
                    raise
                failure = error
            if response is not None:
                if (
                    attempt >= max_retries
                    or not _is_retryable_status(response.status_code)
                    or not _is_replayable(body)
                ):
                    return response
                retry_after = next(
                    (v for k, v in response.headers.items() if k.lower() == 'retry-after'),
                    None,
                )
                delay = _retry_delay(attempt, retry_after)
            else:
                delay = _retry_delay(attempt)
            if deadline is not None and time.monotonic() + delay >= deadline:
                if response is not None:
                    return response
                assert failure is not None
                raise failure
            await asyncio.sleep(delay)
            attempt += 1
            current = await rebuild_headers()

    async def _send(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any,
        deadline: Optional[float] = None,
    ) -> ApiHttpResponse:
        """Send the request on a worker thread without stranding it.

        Cancelling the awaiting task aborts the request itself: the socket the
        worker thread is using is shut down, so the thread ends and its
        connection is dropped instead of the call running on in the background.
        ``deadline`` is the ``time.monotonic()`` instant the call must end by.
        """
        client = self._api_client
        if not isinstance(client, DefaultApiClient):
            return await asyncio.to_thread(client.send_request, method, url, headers, body)
        handle = RequestHandle()
        pending = asyncio.ensure_future(
            asyncio.to_thread(
                client.send_request, method, url, headers, body, False, handle, deadline
            )
        )
        try:
            return await pending
        except asyncio.CancelledError:
            handle.cancel()
            raise

    async def _invoke_api(
        self,
        method: str,
        path: str,
        query_params: Dict[str, Any],
        header_params: Dict[str, str],
        body: Any,
        accepts: List[str],
        content_type: Optional[str],
        return_type: Optional[str],
        auth: Union[Authenticator, '_NoAuth', None] = None,
        operation_name: str = '',
    ) -> Any:
        """Invoke an API operation.

        Args:
            method: HTTP method (GET, POST, PUT, DELETE, etc.).
            path: URL path (with path params already substituted).
            query_params: Query parameters.
            header_params: Custom header parameters.
            body: Request body (model object or None).
            accepts: Acceptable response content types.
            content_type: Request content type.
            return_type: Return type for deserialization (None for void).
            auth: Operation-specific auth resolution. Three states:
                ``NO_AUTH`` suppresses auth (``security: []`` operation),
                ``None`` falls back to the client-level authenticator, and a
                real :class:`Authenticator` is the credential of the security
                scheme the operation names (:meth:`_scheme_authenticator`).

        Returns:
            Deserialized response or None.

        Raises:
            ApiException: If the API call fails.
        """
        result = await self._invoke_api_for_result(
            method,
            path,
            query_params,
            header_params,
            body,
            accepts,
            content_type,
            return_type,
            auth,
            operation_name=operation_name,
        )
        return result.data

    def _operation_label(self, operation_name: str) -> str:
        """Names the operation as Class.operationId for error text."""
        class_name = type(self).__name__
        return f'{class_name}.{operation_name}' if operation_name else class_name

    @staticmethod
    def _is_text_media_type(media_type: str) -> bool:
        """Return ``True`` for a text-class media type (text/*, XML, JavaScript)."""
        media_type = media_type.lower()
        return (
            media_type.startswith('text/')
            or media_type in ('application/xml', 'application/javascript')
            or media_type.endswith('+xml')
        )

    @staticmethod
    def _throw_api_exception(
        response: 'ApiHttpResponse',
        request_method: Optional[str] = None,
        request_path: Optional[str] = None,
        error_schemas: Optional[Mapping[str, ErrorFactory]] = None,
    ) -> None:
        """Raise the exception :meth:`ApiException.from_response` maps the
        error response to. The body is parsed as JSON where possible so that
        structured error data (e.g. from a ``default`` response schema) is
        available via :attr:`ApiException.error_body`.
        """
        raise ApiException.from_response(
            response.status_code,
            response.headers,
            response.body,
            request_method,
            request_path,
            error_schemas,
        )
