class _BodyTooLarge(Exception):
    """Raised inside the body read when ``max_response_bytes`` is passed; the caller turns it
    into :class:`ResponseTooLargeException` with the response's status and headers."""


def _too_large(response: Any, limit: int) -> ResponseTooLargeException:
    """The error for a buffered body that passed ``limit``, after the connection was dropped."""
    DefaultApiClient._abort_response(response)
    return ResponseTooLargeException(
        limit=limit,
        status_code=response.status,
        response_headers=_lower_headers(response.headers),
    )


class RequestHandle:
    """Lets another thread abort one in-flight request.

    :meth:`DefaultApiClient.send_request` accepts one. Calling :meth:`cancel`
    shuts the request's socket down, so a worker thread blocked in connect,
    send or receive fails at once, its connection is discarded rather than
    returned to the pool, and the call raises :class:`RuntimeError`.
    """

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._cancelled = False
        self._connection: Optional[Any] = None
        self._sock: Optional[Any] = None

    @property
    def cancelled(self) -> bool:
        """Whether :meth:`cancel` has been called."""
        return self._cancelled

    def attach(self, connection: Any) -> None:
        """Record the connection the request is using; raise if already cancelled."""
        with self._lock:
            self._connection = connection
            self._sock = None
            cancelled = self._cancelled
        if cancelled:
            raise RuntimeError('The request was cancelled')

    def attach_socket(self, sock: Any) -> None:
        """Record the socket the connection just opened.

        A response that ends with the connection (``Connection: close``) leaves the
        connection object without its socket, so the handle keeps its own reference
        to be able to abort the request and to set a timeout on it.
        """
        with self._lock:
            self._sock = sock

    def socket(self) -> Optional[Any]:
        """The socket of the connection the request is using, when there is one."""
        with self._lock:
            connection = self._connection
            sock = self._sock
        return sock if sock is not None else getattr(connection, 'sock', None)

    def detach(self) -> None:
        """Forget the connection once the request is finished."""
        with self._lock:
            self._connection = None
            self._sock = None

    def cancel(self) -> None:
        """Abort the request; safe to call from any thread, any number of times."""
        with self._lock:
            self._cancelled = True
            connection = self._connection
            sock = self._sock
        if sock is None and connection is not None:
            sock = getattr(connection, 'sock', None)
        if sock is not None:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def _attach_to_active_request(connection: Any) -> None:
    handle: Optional[RequestHandle] = getattr(_ACTIVE, 'handle', None)
    if handle is not None:
        handle.attach(connection)


def _remember_socket(connection: Any) -> None:
    handle: Optional[RequestHandle] = getattr(_ACTIVE, 'handle', None)
    if handle is not None:
        handle.attach_socket(getattr(connection, 'sock', None))


def _abort_if_cancelled(connection: Any) -> None:
    handle: Optional[RequestHandle] = getattr(_ACTIVE, 'handle', None)
    if handle is not None and handle.cancelled:
        connection.close()
        raise RuntimeError('The request was cancelled')


class _CancellableHTTPConnection(urllib3.connection.HTTPConnection):
    """Plain connection that registers itself with the active request handle."""

    def request(self, *args: Any, **kwargs: Any) -> None:
        _attach_to_active_request(self)
        super().request(*args, **kwargs)

    def connect(self) -> None:
        super().connect()
        _remember_socket(self)
        _abort_if_cancelled(self)


class _CancellableHTTPSConnection(urllib3.connection.HTTPSConnection):
    """TLS connection that registers itself with the active request handle."""

    def request(self, *args: Any, **kwargs: Any) -> None:
        _attach_to_active_request(self)
        super().request(*args, **kwargs)

    def connect(self) -> None:
        super().connect()
        _remember_socket(self)
        _abort_if_cancelled(self)


class _CancellableHTTPConnectionPool(urllib3.connectionpool.HTTPConnectionPool):
    ConnectionCls = _CancellableHTTPConnection


class _CancellableHTTPSConnectionPool(urllib3.connectionpool.HTTPSConnectionPool):
    ConnectionCls = _CancellableHTTPSConnection


def _network_exception(error: urllib3.exceptions.HTTPError) -> NetworkException:
    """Classify a urllib3 transport failure as a network error or a timeout.

    Retries are disabled (``Retry(total=0)``), so a failure before the
    response arrives surfaces as ``MaxRetryError`` wrapping the real cause in
    ``reason``. ``NewConnectionError`` subclasses ``ConnectTimeoutError`` in
    urllib3 2.x, so it is checked first: a refused connection or a failed DNS
    lookup is a network error, not a timeout.
    """
    cause: BaseException = error
    if isinstance(error, urllib3.exceptions.MaxRetryError) and error.reason is not None:
        cause = error.reason
    # The message comes from the underlying cause, never from the
    # ``MaxRetryError`` wrapper: that one renders the request path and query
    # ("Max retries exceeded with url: /items?api_key=..."), which would copy a
    # query-parameter API key into logs and error trackers.
    message = str(cause)
    if isinstance(cause, urllib3.exceptions.NewConnectionError):
        return NetworkException(message=message)
    if isinstance(cause, (urllib3.exceptions.TimeoutError, TimeoutError)):
        return NetworkTimeoutException(message=message)
    return NetworkException(message=message)


_RETRY_BASE_DELAY_S = 0.5
_RETRY_MAX_DELAY_S = 8.0
_RETRY_AFTER_CAP_S = 60.0
_RETRY_AFTER_SECONDS = re.compile(r'[0-9]+(?:\.[0-9]+)?')


def _is_retryable_status(status: int) -> bool:
    """Statuses worth retrying: 408, 409, 429 and 500 to 599 except 501."""
    return status in (408, 409, 429) or (500 <= status <= 599 and status != 501)


def _retry_after_seconds(retry_after: Optional[str], now: Optional[float] = None) -> Optional[float]:
    """Seconds a ``Retry-After`` header asks to wait (delta seconds or an HTTP date, capped at 60 s).

    ``None`` when the header is absent or unusable.
    """
    header = (retry_after or '').strip()
    if not header:
        return None
    if _RETRY_AFTER_SECONDS.fullmatch(header):
        return min(float(header), _RETRY_AFTER_CAP_S)
    when: Optional[float]
    try:
        when = parsedate_to_datetime(header).timestamp()
    except (TypeError, ValueError, IndexError):
        when = None
    if when is None:
        return None
    current = time.time() if now is None else now
    return min(max(when - current, 0.0), _RETRY_AFTER_CAP_S)


def _retry_delay(
    attempt: int,
    retry_after: Optional[str] = None,
    now: Optional[float] = None,
    jitter: Optional[float] = None,
) -> float:
    """Seconds to wait before retry number ``attempt + 1``.

    The ``Retry-After`` value (delta seconds or an HTTP date, capped at 60 s)
    when the server sent a usable one, otherwise 0.5 s doubling up to 8 s with
    up to 25% jitter taken off.

    Args:
        attempt: Zero-based number of the attempt that just failed.
        retry_after: The ``Retry-After`` response header, if any.
        now: Current wall-clock time in epoch seconds (for tests).
        jitter: A value in ``[0, 1)`` scaling the jitter (for tests).
    """
    hinted = _retry_after_seconds(retry_after, now)
    if hinted is not None:
        return hinted
    base = min(_RETRY_BASE_DELAY_S * 2 ** min(attempt, 10), _RETRY_MAX_DELAY_S)
    return base * (1.0 - 0.25 * (random.random() if jitter is None else jitter))


def _has_header(headers: Dict[str, str], name: str) -> bool:
    """Whether ``headers`` holds ``name`` under ASCII case-folding."""
    wanted = name.lower()
    return any(key.lower() == wanted for key in headers)


def _pool_manager_follows_redirects(pool_manager: Any) -> bool:
    """Whether a caller-supplied pool manager has redirect retries switched on.

    urllib3 keeps the retry policy of a pool manager in its ``retries`` pool
    keyword. A ``Retry`` whose ``redirect`` is ``False`` or ``0`` does not
    follow redirects; any other ``Retry`` does.
    """
    pool_kwargs = getattr(pool_manager, 'connection_pool_kw', None)
    if not isinstance(pool_kwargs, dict):
        return False
    retries = pool_kwargs.get('retries')
    return isinstance(retries, urllib3.Retry) and retries.redirect not in (False, 0)


def _redact_query(url: str) -> str:
    """Replace a URL's query string with ``***`` before it goes into a message.

    A query-parameter API key is appended to the URL before the transport sees
    it, so any message that quotes the URL would copy the key into logs and
    error trackers.
    """
    path, separator, _ = url.partition('?')
    return path + separator + '***' if separator else url


def _remove_header(headers: Dict[str, str], name: str) -> None:
    """Drop every spelling of ``name`` from ``headers`` (ASCII case-folding)."""
    wanted = name.lower()
    for key in [key for key in headers if key.lower() == wanted]:
        del headers[key]


def _merge_headers(headers: Dict[str, str], overrides: Mapping[str, str]) -> None:
    """Merge ``overrides`` into ``headers``, replacing a name written in any case.

    Header names are case-insensitive (RFC 9110 section 5.1), so a default
    ``accept`` replaces the selector's ``Accept`` instead of both going on the
    wire. The override's own spelling is kept.
    """
    for name, value in overrides.items():
        _remove_header(headers, name)
        headers[name] = value


def _lower_headers(headers: Any) -> Dict[str, str]:
    """Lower-case the keys of a urllib3 header collection (D13).

    Repeated lines are joined with ``", "``, the same form
    ``ApiHttpResponse.headers`` carries.
    """
    lowered: Dict[str, str] = {}
    if headers:
        for name in set(headers.keys()):
            values = headers.getlist(name) if hasattr(headers, 'getlist') else [headers[name]]
            lowered[name.lower()] = ', '.join(values)
    return lowered


def _supported_encodings() -> str:
    """Return a comma-separated string of supported content encodings.

    Includes gzip and deflate unconditionally. Brotli and zstd are
    included when their respective packages are installed.

    Returns:
        Supported encoding names for the Accept-Encoding header.
    """
    encodings = ['gzip', 'deflate']
    if _brotli is not None:
        encodings.append('br')
    if _zstandard is not None:
        encodings.append('zstd')
    return ', '.join(encodings)


def _charset_from_content_type(content_type: str) -> Optional[str]:
    """Extract the charset parameter from a Content-Type header value.

    The parameter is matched by its whole name, ignoring letter case and the
    spaces around it, so ``Charset = utf-8`` is the charset while ``xcharset=``
    or ``foo.charset=`` is some other parameter. Returns ``None`` when the
    header is empty or has no ``charset`` parameter.
    """
    if not content_type:
        return None
    for parameter in content_type.split(';')[1:]:
        name, separator, value = parameter.partition('=')
        if separator and name.strip().lower() == 'charset':
            return value.strip().strip('"').strip() or None
    return None


def _resolve_utf16_charset(charset: str, data: bytes) -> str:
    """Resolve a bare ``utf-16`` label to an explicit byte order.

    Python's ``utf-16`` codec defaults to the platform-native byte order
    (little-endian on common hardware) when the body carries no BOM. That
    disagrees with other SDKs and with RFC 2781, which specifies that a
    UTF-16 stream without a BOM defaults to BIG-ENDIAN. This normalizes a
    bare ``utf-16`` / ``utf16`` label so that:

    * a leading little-endian BOM (``FF FE``) decodes as little-endian;
    * a leading big-endian BOM (``FE FF``) decodes as big-endian;
    * no BOM decodes as big-endian (UTF-16BE) per RFC 2781.

    Labels that already pin an explicit byte order (``utf-16le`` /
    ``utf-16be``) are returned unchanged so an explicit choice always wins.
    When a BOM is present the bare ``utf-16`` label is kept so Python's
    codec auto-detects the byte order and strips the mark; only the BOM-less
    case is rewritten to ``utf-16-be``.
    """
    normalized = charset.lower().replace('_', '-')
    if normalized not in ('utf-16', 'utf16'):
        return charset
    if data[:2] in (b'\xff\xfe', b'\xfe\xff'):
        return charset
    return 'utf-16-be'


def _decode_with_charset(data: bytes, content_type: str) -> str:
    """Decode bytes using the charset from a Content-Type header.

    Falls back to UTF-8 when the charset is missing or unknown. Uses
    ``errors='replace'`` so malformed bytes never raise. A BOM-less
    ``utf-16`` body is decoded as big-endian per RFC 2781.
    """
    charset = _charset_from_content_type(content_type) or 'utf-8'
    charset = _resolve_utf16_charset(charset, data)
    try:
        return data.decode(charset, errors='replace')
    except LookupError:
        return data.decode('utf-8', errors='replace')


def _sanitize_multipart_filename(filename: str) -> Tuple[str, Optional[str]]:
    """Sanitize a multipart filename for use in a Content-Disposition header.

    Returns a tuple of ``(ascii_fallback, rfc5987_value_or_None)``. The first
    element is suitable for ``filename="..."`` after backslash-escaping ``"``
    and ``\\``. The second is suitable for ``filename*=UTF-8''<encoded>`` when
    the original filename contained non-ASCII characters.

    Raises ``ValueError`` if the filename contains CR, LF, or NUL.
    """
    if any(ch in filename for ch in ('\r', '\n', '\x00')):
        raise ValueError('Multipart filename must not contain CR, LF, or NUL characters')
    try:
        filename.encode('ascii')
        is_ascii = True
    except UnicodeEncodeError:
        is_ascii = False
    if is_ascii:
        escaped = filename.replace('\\', '\\\\').replace('"', '\\"')
        return escaped, None
    # One '_' per code point that is non-ASCII or a control character, so the
    # fallback matches the other SDKs ('r_sum_.pdf', never 'r?sum?.pdf').
    ascii_fallback = ''.join(
        '_' if ord(ch) > 0x7E or ord(ch) < 0x20 or ord(ch) == 0x7F else ch for ch in filename
    )
    ascii_fallback = ascii_fallback.replace('\\', '\\\\').replace('"', '\\"')
    rfc5987 = "UTF-8''" + _url_quote(filename, safe='')
    return ascii_fallback, rfc5987


def _sanitize_multipart_field_name(name: str) -> str:
    """Sanitize a multipart field name for a Content-Disposition header.

    Unlike :func:`_sanitize_multipart_filename`, a non-ASCII field name is
    NOT transliterated to ``?`` -- per RFC 7578 section 5.1.1 field names are
    carried verbatim and most servers decode the part headers as UTF-8. The
    name is emitted raw (UTF-8 on the wire) after backslash-escaping ``"`` and
    ``\\`` so it cannot terminate the quoted ``name="..."`` value early. CR,
    LF, and NUL are rejected to prevent header injection.

    Raises ``ValueError`` if the name contains CR, LF, or NUL.
    """
    if any(ch in name for ch in ('\r', '\n', '\x00')):
        raise ValueError('Multipart field name must not contain CR, LF, or NUL characters')
    return name.replace('\\', '\\\\').replace('"', '\\"')


def _guess_content_type(filename: Optional[str]) -> str:
    """Guess a Content-Type from a filename, defaulting to octet-stream."""
    if not filename:
        return 'application/octet-stream'
    guessed, _ = mimetypes.guess_type(filename)
    return guessed or 'application/octet-stream'


def _is_text_content_type(content_type: str) -> bool:
    """Return True if the content type represents text that can be decoded as UTF-8."""
    media_type = content_type.split(';')[0].strip().lower()
    if not media_type:
        return True
    if media_type.startswith('text/'):
        return True
    return media_type in (
        'application/json',
        'application/xml',
        'application/javascript',
    ) or media_type.endswith('+json') or media_type.endswith('+xml')


class _StreamBody:
    """An open streamed response body, tracked by the client so ``close()`` can cancel it.

    A read returns the next bytes as soon as some are available (decoded when
    the server compressed the body). A failure of the connection, or a body that
    ends before its declared length, is a :class:`StreamException`; a silence longer
    than the idle timeout is a :class:`NetworkTimeoutException`, because the socket
    timeout is set to it once the headers have arrived. :meth:`close` aborts the
    connection instead of draining it.
    """

    def __init__(
        self,
        client: 'DefaultApiClient',
        response: Any,
        handle: RequestHandle,
        idle_seconds: Optional[float],
    ) -> None:
        self._client = client
        self._response = response
        self._handle = handle
        self._cancelled = False
        self._aborted = False
        sock = handle.socket()
        if sock is not None:
            # The call timeout stopped at the headers; from here a recv that stays
            # silent for ``idle_seconds`` raises the read timeout (None: no limit).
            sock.settimeout(idle_seconds)

    def read(self, size: int = -1) -> bytes:
        """Return at most ``size`` bytes (the rest of the body when negative); ``b''`` at the end."""
        if self._cancelled:
            raise RuntimeError(_CLOSED_MESSAGE)
        if self._aborted:
            raise ValueError('I/O operation on a closed stream')
        try:
            if size < 0:
                chunks = []
                while True:
                    part = self._response.read1(65536, decode_content=True)
                    if not part:
                        break
                    chunks.append(part)
                data = b''.join(chunks)
            else:
                data = self._response.read1(size, decode_content=True) or b''
        except Exception as error:
            if self._cancelled:
                raise RuntimeError(_CLOSED_MESSAGE) from error
            if self._aborted:
                raise ValueError('I/O operation on a closed stream') from error
            self._abort()
            if isinstance(error, urllib3.exceptions.DecodeError):
                # The body arrived but its Content-Encoding is corrupt: a response problem with
                # the real status, as for a buffered call, never a lost connection.
                encoding = (self._response.headers.get('content-encoding') or '').lower()
                raise ApiException(
                    status_code=self._response.status,
                    message=f'Failed to decompress {encoding} response body: {error}',
                    response_headers=_lower_headers(self._response.headers),
                ) from error
            if isinstance(error, (urllib3.exceptions.TimeoutError, TimeoutError)):
                raise NetworkTimeoutException(message=str(error)) from error
            raise StreamException(message=str(error)) from error
        if not data and size != 0:
            self._finish()
        return data

    def _finish(self) -> None:
        """The body ended: its connection has gone back to the pool, so nothing may touch it."""
        self._handle.detach()
        self._client._forget(self)

    def _abort(self) -> None:
        """Drop the connection without draining the rest of the body."""
        self._aborted = True
        if getattr(self._response, 'connection', None) is not None:
            self._handle.cancel()
        else:
            self._handle.detach()
        try:
            self._response.close()
        except Exception:
            pass
        try:
            self._response.release_conn()
        except Exception:
            pass
        self._client._forget(self)

    def close(self) -> None:
        """Abort the connection; calling it again does nothing."""
        if not self._aborted:
            self._abort()

    def cancel(self) -> None:
        """Called by the client's ``close()``: abort, and make the next read raise the closed-client error."""
        self._cancelled = True
        self.close()


class DefaultApiClient:
    """Default implementation of :class:`ApiClient` using urllib3.

    Applies transport-level settings from :class:`TransportOptions`: TLS
    verification, custom CA certificates, proxy routing, timeouts, redirect
    handling, ``User-Agent`` injection, ``X-Request-ID`` injection, and
    transport-level default headers.

    Header merge order (lowest to highest priority):

    1. :attr:`TransportOptions.default_headers` -- transport-level defaults
       (left out of a ``no_redirect`` request, the OAuth2 token POST)
    2. Caller-provided headers (from :class:`BaseApi` -- includes config
       defaults, auth, operation headers)
    3. :attr:`TransportOptions.user_agent` -- injected if not already set
    4. :attr:`TransportOptions.inject_request_id` -- injected if not already set
    """

    def __init__(
        self,
        transport_options: Optional[TransportOptions] = None,
        pool_manager: Optional[Any] = None,
    ) -> None:
        """Create a new DefaultApiClient.

        Args:
            transport_options: Transport configuration to apply. If ``None``,
                default transport options are used.
            pool_manager: A urllib3 pool manager the caller owns. The SDK
                defaults (timeout, redirect policy, user agent, request id,
                default headers) still apply on top of it. The client never
                closes it, so the caller manages its lifecycle.

        Raises:
            ValueError: If ``pool_manager`` is combined with a proxy, a custom
                CA bundle or disabled TLS verification in ``transport_options``:
                those belong to the pool manager the caller built.
        """
        if transport_options is None:
            transport_options = TransportOptions.builder().build()
        self._transport_options = transport_options
        self._closed = False
        self._released = False
        self._active = 0
        self._lock = threading.Lock()
        self._inflight: set[RequestHandle] = set()
        self._streams: set[_StreamBody] = set()
        self._owns_pool = pool_manager is None

        if pool_manager is not None:
            if _pool_manager_follows_redirects(pool_manager):
                raise ValueError(
                    'A caller-supplied pool_manager follows redirects on its own, but the SDK '
                    'manages redirects itself; set follow_redirects and max_redirects on '
                    'TransportOptions and remove the redirect retries from the pool manager'
                )
            conflicts = [
                name
                for name, in_use in (
                    ('proxy', transport_options.proxy is not None),
                    ('ca_cert_path', transport_options.ca_cert_path is not None),
                    ('verify_ssl=False', not transport_options.verify_ssl),
                )
                if in_use
            ]
            if conflicts:
                raise ValueError(
                    'A caller-supplied pool_manager owns the proxy and TLS settings; '
                    f'remove {", ".join(conflicts)} from the transport options '
                    'or configure it on the pool manager instead'
                )
            self._pool_manager = pool_manager
        else:
            # urllib3's default `maxsize=1` keeps a single connection per host,
            # but the async facade runs requests concurrently through
            # `asyncio.to_thread`, so every request past the first would open a
            # connection and discard it on return.
            kwargs: Dict[str, Any] = {'maxsize': 10}

            # --- TLS / SSL ---
            if transport_options.ca_cert_path:
                # Gap T4: fail fast on a user-supplied CA cert that cannot be
                # read or parsed rather than silently falling back to the
                # system trust store. If the caller explicitly asked for SSL
                # pinning we must not pretend it succeeded -- validate the
                # PEM eagerly at construction, even when verify_ssl is False.
                try:
                    ctx = ssl.create_default_context()
                    ctx.load_verify_locations(cafile=transport_options.ca_cert_path)
                except ssl.SSLError as e:
                    raise ValueError(
                        f'failed to parse CA certificate from "{transport_options.ca_cert_path}": {e}'
                    ) from e
                except OSError as e:
                    raise ValueError(
                        f'failed to read CA certificate from "{transport_options.ca_cert_path}": {e}'
                    ) from e
            if not transport_options.verify_ssl:
                kwargs['cert_reqs'] = 'CERT_NONE'
                urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
            elif transport_options.ca_cert_path:
                kwargs['ca_certs'] = transport_options.ca_cert_path
                kwargs['cert_reqs'] = 'CERT_REQUIRED'

            # --- Proxy ---
            if transport_options.proxy:
                # urllib3 2.x does NOT auto-extract userinfo embedded in the
                # proxy URL (``ProxyManager('http://user:pass@host').proxy_headers``
                # is ``{}``), so an authenticated proxy would 407 and the SDK
                # would be non-functional. Parse the userinfo here and emit an
                # explicit ``Proxy-Authorization: Basic base64(user:pass)``
                # header, matching the other 11 SDKs. The userinfo is
                # percent-decoded before base64 (mirroring Java/Kotlin which
                # URLDecode first) so credentials containing reserved
                # characters round-trip correctly.
                parsed_proxy = urlsplit(transport_options.proxy)
                if parsed_proxy.username is not None:
                    user = _url_unquote(parsed_proxy.username)
                    pwd = _url_unquote(parsed_proxy.password or '')
                    # Build the header manually rather than via
                    # ``urllib3.util.make_headers`` (which is untyped and trips
                    # mypy's no-untyped-call in strict mode). Same wire result:
                    # ``Proxy-Authorization: Basic base64(user:pass)``.
                    _proxy_token = base64.b64encode(
                        f'{user}:{pwd}'.encode('utf-8')
                    ).decode('ascii')
                    kwargs['proxy_headers'] = {
                        'proxy-authorization': f'Basic {_proxy_token}'
                    }
                self._pool_manager = urllib3.ProxyManager(transport_options.proxy, **kwargs)
            else:
                self._pool_manager = urllib3.PoolManager(**kwargs)
            self._pool_manager.pool_classes_by_scheme = {
                'http': _CancellableHTTPConnectionPool,
                'https': _CancellableHTTPSConnectionPool,
            }

    @property
    def transport_options(self) -> TransportOptions:
        """The transport options this client applies."""
        return self._transport_options

    def close(self) -> None:
        """Close the client gracefully; calling it again does nothing.

        The client is marked closed at once, so a request started afterwards
        raises :class:`RuntimeError`. A request already in flight finishes, and
        the pool the client created is released when the last of them
        completes (at once when none is running). A pool manager the caller
        supplied is never closed: the caller owns its lifecycle. To abandon one
        request, cancel the asyncio task awaiting it or call ``cancel()`` on
        its :class:`RequestHandle`.
        """
        with self._lock:
            self._closed = True
            release = self._active == 0
            streams = list(self._streams)
            self._streams.clear()
        for stream in streams:
            stream.cancel()
        if release:
            self._release()

    def _forget(self, stream: '_StreamBody') -> None:
        """Stop tracking a stream that ended or was aborted."""
        with self._lock:
            self._streams.discard(stream)

    def _release(self) -> None:
        """Release the transport once; a caller-supplied pool manager stays open."""
        with self._lock:
            if self._released:
                return
            self._released = True
        if self._owns_pool:
            self._pool_manager.clear()

    @contextlib.contextmanager
    def _in_flight(self) -> Iterator[None]:
        """Count one call as in flight, so :meth:`close` waits for it.

        A call already counted by an enclosing scope (the operation that is
        sending its retries, or fetching a token) runs on without a second
        count, and so is allowed to finish after the client was closed. A call
        that starts on a closed client raises :class:`RuntimeError`.
        """
        if _ADMITTED.get() is self:
            yield
            return
        with self._lock:
            if self._closed:
                raise RuntimeError(_CLOSED_MESSAGE)
            self._active += 1
        token = _ADMITTED.set(self)
        try:
            yield
        finally:
            _ADMITTED.reset(token)
            with self._lock:
                self._active -= 1
                release = self._closed and self._active == 0
            if release:
                self._release()

    def __enter__(self) -> 'DefaultApiClient':
        return self

    def __exit__(
        self,
        exc_type: Any,
        exc_val: Any,
        exc_tb: Any,
    ) -> None:
        self.close()

    def send_request(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        no_redirect: bool = False,
        handle: Optional[RequestHandle] = None,
        deadline: Optional[float] = None,
    ) -> ApiHttpResponse:
        """Send an HTTP request and return the response.

        The request is counted as in flight, so :meth:`close` lets it finish,
        and ``handle.cancel()`` from another thread aborts it.

        Args:
            method: HTTP method.
            url: Fully qualified URL.
            headers: HTTP headers from the caller.
            body: Request body.
            no_redirect: When ``True``, a 3xx response is returned verbatim.
            handle: Optional handle another thread can cancel.
            deadline: Optional ``time.monotonic()`` instant the whole call must
                end by. It replaces the timeout of the transport options, so a
                caller that retries keeps one end-to-end budget.

        Returns:
            :class:`ApiHttpResponse` containing status code, body, and headers.

        Raises:
            RuntimeError: If the client is closed, or the request was cancelled.
        """
        with self._in_flight():
            if handle is None:
                handle = RequestHandle()
            with self._lock:
                self._inflight.add(handle)
            _ACTIVE.handle = handle
            try:
                response = self._send(method, url, headers, body, no_redirect, deadline)
            except Exception as error:
                if handle.cancelled:
                    raise RuntimeError('The request was cancelled') from error
                raise
            finally:
                _ACTIVE.handle = None
                handle.detach()
                with self._lock:
                    self._inflight.discard(handle)
            if handle.cancelled:
                raise RuntimeError('The request was cancelled')
            return response

    def send_streaming(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        idle_timeout: Optional[int] = None,
        handle: Optional[RequestHandle] = None,
        deadline: Optional[float] = None,
    ) -> ApiStreamResponse:
        """Send an HTTP request and return as soon as the response headers are accepted.

        The header phase is the buffered call's (header injection, redirects, the
        ``timeout`` or ``deadline`` as one budget that stops at the headers); the
        body is not read. The retries belong to the caller, which sends the request
        again before the first body byte only. The call is counted as in flight until
        the headers are in; a stream that is still open when :meth:`close` is called
        is cancelled.

        Args:
            method: HTTP method.
            url: Fully qualified URL.
            headers: HTTP headers from the caller.
            body: Request body.
            idle_timeout: The longest silence in the body in milliseconds, ``0``
                to disable it, or ``None`` for ``TransportOptions.idle_timeout``.
            handle: Optional handle another thread can cancel.
            deadline: Optional ``time.monotonic()`` instant the header phase must end by.

        Returns:
            :class:`ApiStreamResponse` with the status code, the lower-cased headers and
            the open body, which the caller must close.

        Raises:
            RuntimeError: If the client is closed, or the request was cancelled.
        """
        idle_ms = self._transport_options.idle_timeout if idle_timeout is None else idle_timeout
        idle_seconds = idle_ms / 1000.0 if idle_ms else None
        with self._in_flight():
            if handle is None:
                handle = RequestHandle()
            with self._lock:
                self._inflight.add(handle)
            _ACTIVE.handle = handle
            opened: Optional[_StreamBody] = None
            response: Any = None
            try:
                response = self._open(method, url, headers, body, False, deadline)
                content_encoding = (response.headers.get('content-encoding') or '').lower()
                self._require_decoder(response, content_encoding)
                opened = _StreamBody(self, response, handle, idle_seconds)
                with self._lock:
                    if self._closed:
                        raise RuntimeError(_CLOSED_MESSAGE)
                    self._streams.add(opened)
                if handle.cancelled:
                    raise RuntimeError('The request was cancelled')
                response_headers = _lower_headers(response.headers)
                if content_encoding not in ('', 'identity'):
                    # The body is decoded as it is read, so the headers describe the body the
                    # caller receives, not the encoded bytes on the wire (D92).
                    response_headers.pop('content-encoding', None)
                    response_headers.pop('content-length', None)
                return ApiStreamResponse(
                    status_code=response.status, headers=response_headers, body=opened
                )
            except Exception as error:
                was_cancelled = handle.cancelled
                if opened is not None:
                    opened.close()
                elif response is not None:
                    self._abort_response(response)
                if was_cancelled:
                    raise RuntimeError('The request was cancelled') from error
                raise
            finally:
                _ACTIVE.handle = None
                with self._lock:
                    self._inflight.discard(handle)
                if opened is None:
                    handle.detach()

    @staticmethod
    def _abort_response(response: Any) -> None:
        """Drop a response that was opened but is not going to be streamed."""
        try:
            response.close()
        except Exception:
            pass
        try:
            response.release_conn()
        except Exception:
            pass

    @staticmethod
    def _require_decoder(response: Any, encoding: str) -> None:
        """Refuse a Content-Encoding this client cannot decode, as a buffered call does."""
        if encoding in ('', 'identity', 'gzip', 'x-gzip', 'deflate'):
            return
        if encoding not in ('br', 'zstd'):
            raise ApiException(
                status_code=response.status,
                message=f"Unsupported Content-Encoding '{encoding}'",
                response_headers=_lower_headers(response.headers),
            )
        if (encoding == 'br' and _brotli is None) or (encoding == 'zstd' and _zstandard is None):
            raise ApiException(
                status_code=response.status,
                message=(
                    f'Failed to decompress {encoding} response body: '
                    f"Unsupported Content-Encoding '{encoding}'"
                ),
                response_headers=_lower_headers(response.headers),
            )

    def _open(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        no_redirect: bool = False,
        deadline_at: Optional[float] = None,
    ) -> Any:
        """Run the header phase of one request and return the response with its body unread.

        Applies transport-level header injection (default headers, User-Agent,
        X-Request-ID) before sending. The merge order ensures transport
        defaults have lowest priority.

        Args:
            method: HTTP method (GET, POST, PUT, DELETE, etc.).
            url: Fully qualified URL.
            headers: HTTP headers from the caller.
            body: Request body (serialized JSON string, bytes, dict for
                multipart, or None).
            no_redirect: When ``True``, redirects are not followed for this
                request; the first 3xx response is returned to the caller
                verbatim (status, body, headers). Used by the OAuth2 token
                manager so a credential-bearing POST is never silently
                replayed against a redirect target -- the token manager
                inspects and rejects the 3xx itself.
            deadline_at: Optional ``time.monotonic()`` instant the call must
                end by, replacing the configured timeout.

        Returns:
            The urllib3 response: the headers have arrived and the body is not read.
        """
        # --- Merge headers: transport defaults < caller headers < injected ---
        # A no_redirect request is a credential-bearing auth call (the OAuth2
        # token POST): the caller's default headers meant for the API, such as
        # an Authorization or API-key header, must never reach the token endpoint.
        # A caller-supplied pool manager's own default headers are sent too:
        # urllib3 replaces them when a request passes headers of its own.
        merged_headers: Dict[str, str] = {}
        if not no_redirect:
            merged_headers.update(dict(self._pool_manager.headers or {}))
            merged_headers.update(self._transport_options.default_headers)
        _merge_headers(merged_headers, headers)

        # Header names are case-insensitive (RFC 9110 section 5.1): any case
        # variant the caller set, even with an empty value, wins and nothing
        # is injected next to it.
        if self._transport_options.user_agent is not None and not _has_header(
            merged_headers, 'User-Agent'
        ):
            merged_headers['User-Agent'] = self._transport_options.user_agent
        elif self._transport_options.user_agent is None and not _has_header(merged_headers, 'User-Agent'):
            # urllib3 adds its own User-Agent to a request that carries none; the
            # skip marker is how a cleared user agent is left off the wire.
            merged_headers['User-Agent'] = str(getattr(urllib3.util, 'SKIP_HEADER'))

        if self._transport_options.inject_request_id and not _has_header(
            merged_headers, 'X-Request-ID'
        ):
            merged_headers['X-Request-ID'] = str(uuid.uuid4())

        if not _has_header(merged_headers, 'Accept-Encoding'):
            merged_headers['Accept-Encoding'] = _supported_encodings()

        encoded_body: Any
        if isinstance(body, dict):
            boundary = str(uuid.uuid4())
            multipart_type = 'multipart/form-data'
            for header_name, header_value in merged_headers.items():
                if header_name.lower() == 'content-type':
                    declared = header_value.split(';', 1)[0].strip().lower()
                    if re.fullmatch(r'multipart/[a-z0-9!#$&^_.+-]+', declared):
                        multipart_type = declared
            _remove_header(merged_headers, 'Content-Type')
            merged_headers['Content-Type'] = f'{multipart_type}; boundary={boundary}'
            encoded_body = self._build_multipart_body(body, boundary)
        elif isinstance(body, (bytes, bytearray, memoryview)):
            # Every byte-like binary body goes out verbatim; anything else
            # would fall through to the empty-body branch and upload nothing.
            encoded_body = bytes(body)
        elif isinstance(body, str):
            encoded_body = body.encode('utf-8')
        elif isinstance(body, BodySource):
            # Sent as it is read, never buffered: a known length is a Content-Length and an
            # unknown one is chunked. The framing headers are the source's, not the caller's.
            _remove_header(merged_headers, 'Content-Length')
            _remove_header(merged_headers, 'Transfer-Encoding')
            source_length = body.length
            if source_length is not None:
                merged_headers['Content-Length'] = str(source_length)
            encoded_body = body
        else:
            encoded_body = None
            _remove_header(merged_headers, 'Content-Type')

        # Some servers / WAFs treat POST/PUT/PATCH with no body and
        # no Content-Length as malformed (411 Length Required) or
        # behave inconsistently. Emit an explicit `Content-Length: 0`
        # on body-bearing verbs when the body is None, matching
        # Kotlin's `ByteArray(0)` and the other 11 SDKs.
        if encoded_body is None and method.upper() in ('POST', 'PUT', 'PATCH'):
            if not _has_header(merged_headers, 'Content-Length'):
                merged_headers['Content-Length'] = '0'

        # --- Timeout ---
        # The timeout is one end-to-end budget: every redirect hop draws from
        # the same deadline, measured from the start of the call.
        request_kwargs: Dict[str, Any] = {}
        deadline: Optional[float] = None
        if deadline_at is not None:
            remaining_seconds = deadline_at - time.monotonic()
            if remaining_seconds <= 0:
                raise NetworkTimeoutException(
                    message='Request timed out: the timeout budget was used up'
                )
            request_kwargs['timeout'] = urllib3.Timeout(total=remaining_seconds)
            deadline = deadline_at
        elif self._transport_options.timeout is not None:
            timeout_seconds = self._transport_options.timeout / 1000.0
            request_kwargs['timeout'] = urllib3.Timeout(total=timeout_seconds)
            deadline = time.monotonic() + timeout_seconds

        # --- Redirects ---
        # Gap BH / Bucket 4.1: urllib3's built-in redirect handling (via
        # Retry.remove_headers_on_redirect) does not give us the three
        # security guards we need:
        #   1. Scheme allowlist -- a malicious Location: file:/// or
        #      data:... must NOT be followed. urllib3 will happily try
        #      anything that looks like a URL.
        #   2. Authorization strip on HTTPS->HTTP downgrade -- urllib3
        #      only compares scheme+host+port for same-origin, and treats
        #      a scheme change as origin change today, but we want the
        #      guard explicit and matching the other 11 SDKs' behaviour.
        #   3. The ProxyManager's own proxy_headers bag is left alone: it
        #      holds the credentials for the proxy itself and is shared by
        #      every concurrent request, so a per-redirect mutation would
        #      strip them from unrelated requests.
        # We disable urllib3's redirect handling entirely and run the
        # loop manually, mirroring the canonical Rust / Java / Kotlin
        # implementations.
        request_kwargs['redirect'] = False
        request_kwargs['retries'] = urllib3.Retry(
            total=0,
            redirect=0,
            status=0,
            read=0,
            other=0,
            connect=0,
        )

        opened: List[OpenedBody] = []
        try:
            response = self._pool_manager.request(
                method,
                url,
                headers=merged_headers,
                body=self._wire_body(encoded_body, opened),
                preload_content=False,
                decode_content=False,
                **request_kwargs,
            )

            # no_redirect means "do not follow redirects; return the 3xx
            # response as-is" -- not "throw on redirect". When redirects are
            # disabled (either no_redirect or follow_redirects=False) the loop
            # is skipped and the first 3xx surfaces to the caller verbatim,
            # matching java/csharp/go/php/node/dart/elixir.
            if self._transport_options.follow_redirects and not no_redirect:
                response = self._follow_redirects(
                    response=response,
                    initial_url=url,
                    initial_method=method,
                    initial_body=encoded_body,
                    initial_headers=merged_headers,
                    request_kwargs=request_kwargs,
                    deadline=deadline,
                    opened=opened,
                )
        except urllib3.exceptions.LocationValueError as e:
            # An unparseable request URL is a caller mistake, not a network
            # failure: urllib3 reports it as an HTTPError subclass, so it is
            # caught before the network handler below.
            raise ValueError(f'Invalid request URL: {url}: {e}') from e
        except urllib3.exceptions.HTTPError as e:
            raise _network_exception(e) from e
        finally:
            # What the SDK opened for a body source is closed when the send is over; a stream the
            # caller passed to BodySource.once is never one of them.
            for stream in opened:
                stream.close()

        return response

    @staticmethod
    def _live_socket(sock: Optional[Any]) -> Optional[Any]:
        """Return ``sock`` when it is still open, else None."""
        if sock is None:
            return None
        try:
            return sock if sock.fileno() >= 0 else None
        except (OSError, AttributeError):
            return None

    @staticmethod
    def _read_within(response: Any, deadline: Optional[float], limit: Optional[int] = None) -> bytes:
        """Read the whole body before ``deadline``, the instant the call must end by.

        The socket timeout is reset to what remains of the budget before every read, so
        the budget holds for the body as a whole and not for each read on its own.

        With a ``limit`` (``max_response_bytes``) the bytes on the wire are counted as they
        arrive and the read stops as soon as the count passes it: at most ``limit + 1`` bytes
        are read. The connection is dropped, not drained.

        Raises:
            ResponseTooLargeException: If the body passes ``limit``.
        """
        read1 = getattr(response, 'read1', None)
        if read1 is None and limit is not None:
            # A response from a supplied pool manager without read1 still reads in bounded pieces.
            read1 = response.read
        if (deadline is None and limit is None) or read1 is None:
            # No budget and no limit, or a response from a supplied pool manager that reads only as a whole.
            return bytes(response.read())
        handle = getattr(_ACTIVE, 'handle', None)
        sock = DefaultApiClient._live_socket(getattr(getattr(response, 'connection', None), 'sock', None))
        if sock is None and handle is not None:
            # A response that ended the connection leaves only the handle holding its socket; a
            # socket kept from an earlier attempt of a retried call is closed and is skipped.
            sock = DefaultApiClient._live_socket(handle.socket())
        chunks: List[bytes] = []
        total = 0
        while True:
            if deadline is not None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    DefaultApiClient._abort_response(response)
                    raise NetworkTimeoutException(
                        message='Request timed out: the timeout budget was used up while the response body was read'
                    )
                # The read that ends a closed connection closes its socket, so the next
                # pass finds it gone; there is nothing left to bound then.
                sock = DefaultApiClient._live_socket(sock)
                if sock is not None:
                    sock.settimeout(remaining)
            chunk = read1(65536 if limit is None else min(65536, limit + 1 - total))
            if not chunk:
                return b''.join(chunks)
            total += len(chunk)
            if limit is not None and total > limit:
                raise _too_large(response, limit)
            chunks.append(chunk)

    @staticmethod
    def _wire_body(body: Any, opened: List[OpenedBody]) -> Any:
        """The body of one send as the HTTP layer takes it: a body source is opened afresh."""
        if isinstance(body, BodySource):
            return body._wire(opened)
        return body

    def _send(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        no_redirect: bool = False,
        deadline_at: Optional[float] = None,
    ) -> ApiHttpResponse:
        """Send an HTTP request and read the whole response.

        The header phase is :meth:`_open`; the body is read here, inside the
        transport try/catch, so a connection-reset / read-timeout /
        truncated-chunked failure that occurs AFTER the response headers are
        received is wrapped in the SDK's uniform ApiException (with the
        underlying error preserved as the cause) rather than leaking a raw
        urllib3 exception.

        Returns:
            :class:`ApiHttpResponse` containing status code, body, and headers.
        """
        # One deadline covers the header phase and the whole body read, so a server that
        # trickles the body cannot hold the call past the budget one socket read at a time.
        deadline = deadline_at
        if deadline is None and self._transport_options.timeout is not None:
            deadline = time.monotonic() + self._transport_options.timeout / 1000.0
        response = self._open(method, url, headers, body, no_redirect, deadline)
        try:
            # The body read happens INSIDE the transport try/catch so a
            # connection-reset / read-timeout / truncated-chunked failure
            # that occurs AFTER the response headers are received is wrapped
            # in the SDK's uniform ApiException (with the underlying error
            # preserved as the cause) rather than leaking a raw urllib3
            # exception. This gives callers one error type for the whole
            # transport phase, matching Java/Swift/Ruby/PHP/Elixir.
            limit = self._transport_options.max_response_bytes
            raw_data = self._read_within(response, deadline, limit)

            # A malformed Content-Encoding body (e.g. a server that
            # advertises `gzip` but sends truncated / non-gzip bytes) arrived
            # with a real response, so it surfaces as an ApiException
            # carrying that response's status -- never a NetworkException and
            # never a raw gzip.BadGzipFile / zlib.error / OSError.
            content_encoding = (response.headers.get('content-encoding') or '').lower()
            # Refused before any decode, so an empty body with an unknown
            # encoding is not passed through as if it were identity.
            if content_encoding not in ('', 'identity', 'gzip', 'x-gzip', 'deflate', 'br', 'zstd'):
                raise ApiException(
                    status_code=response.status,
                    message=f"Unsupported Content-Encoding '{content_encoding}'",
                    response_headers=_lower_headers(response.headers),
                )
            try:
                decompressed = self._decompress_body(raw_data, content_encoding, limit)
            except _BodyTooLarge:
                assert limit is not None
                raise _too_large(response, limit) from None
            except ApiException:
                raise
            except Exception as e:
                # gzip.BadGzipFile (OSError), zlib.error, brotli.error, and
                # zstandard.ZstdError are all direct/indirect subclasses of
                # Exception with no shared codec base, so they are caught here
                # as a group and re-raised as the SDK's uniform ApiException.
                raise ApiException(
                    status_code=response.status,
                    message=f'Failed to decompress {content_encoding} response body: {e}',
                    response_headers=_lower_headers(response.headers),
                ) from e
        except urllib3.exceptions.HTTPError as e:
            raise _network_exception(e) from e

        content_type = response.headers.get('content-type') or ''
        # Empty bodies flow through the same content-type decode path as the
        # other 11 SDKs rather than short-circuiting to ''. For an empty body
        # _decode_with_charset returns '' and base64-encoding empty bytes also
        # returns '', so the observable output is identical -- this keeps the
        # decode path structurally uniform across all transports.
        response_body = (
            _decode_with_charset(decompressed, content_type)
            if _is_text_content_type(content_type)
            else base64.b64encode(decompressed).decode('ascii')
        )
        # Gap BE+BF: response header keys are normalised to lowercase so
        # callers can look them up consistently regardless of the casing the
        # server used (HTTP header names are case-insensitive per RFC 7230
        # section 3.2, and HTTP/2 mandates lowercase on the wire). Repeated
        # header lines (for example multiple Link or Set-Cookie headers) are
        # joined with ", " to preserve order per RFC 7230 section 3.2.2.
        # The joined form is not directly parseable for Set-Cookie; callers
        # needing structured cookie access should use http.cookies.SimpleCookie
        # or read response.headers.getlist('set-cookie') on the raw urllib3
        # HTTPHeaderDict.
        response_headers = _lower_headers(response.headers)
        if raw_data and content_encoding not in ('', 'identity'):
            # D92: the body above was decoded, so the headers must describe the
            # body the caller receives, not the encoded bytes on the wire.
            response_headers.pop('content-encoding', None)
            response_headers.pop('content-length', None)

        return ApiHttpResponse(status_code=response.status, body=response_body, headers=response_headers)

    # Sensitive headers that MUST be stripped on a cross-origin redirect
    # to avoid leaking bearer tokens / cookies / proxy credentials to an
    # attacker-controlled host. Names are compared case-insensitively.
    #
    # The spec-declared API-key header names ({{#hasApiKeyHeaderNames}}{{#apiKeyHeaderNames}}{{{name}}}{{^-last}}, {{/-last}}{{/apiKeyHeaderNames}}{{/hasApiKeyHeaderNames}}{{^hasApiKeyHeaderNames}}none declared in this spec{{/hasApiKeyHeaderNames}})
    # are merged in at codegen time so an API key sent in a custom header
    # (e.g. ``X-API-Key``) is also treated as a credential and stripped on
    # a cross-origin hop, matching the canonical SDKs.
    _SENSITIVE_HEADERS: FrozenSet[str] = frozenset([
        'authorization',
        'cookie',
        'proxy-authorization',
        {{#apiKeyHeaderNames}}
        {{#nameLower}}
        {{#lambda.quotedLiteral}}{{{nameLower}}}{{/lambda.quotedLiteral}},
        {{/nameLower}}
        {{/apiKeyHeaderNames}}
    ])

    # Body-related headers that must be cleared when the follow-up has
    # no body (303 coercion, or 301/302 demotion of POST -> GET).
    _BODY_HEADERS: FrozenSet[str] = frozenset(
        ['content-type', 'content-length']
    )

    _REDIRECT_STATUSES: FrozenSet[int] = frozenset([301, 302, 303, 307, 308])

    def _follow_redirects(
        self,
        response: Any,
        initial_url: str,
        initial_method: str,
        initial_body: Any,
        initial_headers: Dict[str, str],
        request_kwargs: Dict[str, Any],
        deadline: Optional[float] = None,
        opened: Optional[List[OpenedBody]] = None,
    ) -> Any:
        """Drive the redirect loop manually with security guards.

        urllib3's built-in redirect handling is disabled by the caller;
        this method walks ``Location`` headers up to the configured
        ``max_redirects`` budget, applying:

        1. Scheme allowlist -- only ``http`` / ``https`` targets are
           followed. Anything else (``file:``, ``data:``, ``javascript:``)
           raises :class:`ApiException`.
        2. Authorization / Cookie / Proxy-Authorization strip on every
           cross-origin hop, where origin is scheme + host + effective
           port. An HTTPS -> HTTP downgrade is by definition cross-origin
           because the scheme differs.
        3. The pool manager's ``proxy_headers`` are never touched. They
           authenticate this client to its proxy, not to the redirect
           target, and the pool manager is shared by every request on the
           client, so mutating them mid-redirect would strip the proxy
           credentials from concurrent requests.

        Method rewriting follows RFC 9110 section 15.4: 301 and 302 turn only
        POST into GET, 303 turns every method except HEAD into GET, and 307
        and 308 never change the method.

        A body source is opened again for every hop that keeps its body; a single-use one has
        been read to its end by the first request, so such a hop is refused.
        """
        opened = opened if opened is not None else []
        max_redirects = (
            self._transport_options.max_redirects
            if self._transport_options.max_redirects is not None
            else 20
        )
        redirects_remaining = max_redirects
        current_url = initial_url
        current_method = initial_method
        current_body = initial_body
        current_headers: Dict[str, str] = dict(initial_headers)
        unusable_location = False
        while response.status in self._REDIRECT_STATUSES and redirects_remaining > 0:
            location = response.headers.get('location') if response.headers else None
            if not location:
                break

            next_url = self._resolve_url(current_url, location)
            if next_url is None:
                # An unusable Location behaves like a missing one: stop and
                # return the 3xx untouched, body included.
                unusable_location = True
                break

            # Guard 1: scheme allowlist.
            parsed_next = urlsplit(next_url)
            scheme = (parsed_next.scheme or '').lower()
            if scheme not in ('http', 'https'):
                self._release_response(response, self._transport_options.max_response_bytes)
                raise ApiException(
                    status_code=response.status,
                    message=f'Refusing to follow redirect to non-HTTP(S) URL: {_redact_query(next_url)}',
                    response_headers=_lower_headers(response.headers),
                )

            same_origin = self._same_origin(current_url, next_url)

            # Guard 1c (3.3): HTTPS -> HTTP downgrade with a request
            # body must not silently replay the body over plaintext.
            # The Authorization strip below handles credential leakage,
            # but body content can itself be sensitive (form fields,
            # JSON payloads), so refuse outright when a body would be
            # carried across the downgrade. 303 still coerces to GET
            # and drops the body below, so the guard triggers on 301 / 302
            # (a body-bearing POST that would otherwise be demoted and the
            # body replayed) and on 307 / 308 (body preserved).
            if (
                current_body is not None
                and self._is_https_to_http_downgrade(current_url, next_url)
                and response.status in (301, 302, 307, 308)
            ):
                self._release_response(response, self._transport_options.max_response_bytes)
                raise ApiException(
                    status_code=response.status,
                    message=(
                        f'Refusing to replay request body across HTTPS->HTTP '
                        f'redirect: {_redact_query(current_url)} -> {_redact_query(next_url)}'
                    ),
                    response_headers=_lower_headers(response.headers),
                )

            # Pick follow-up method/body per RFC 9110 section 15.4: 307 and 308
            # never change the method; 303 turns every method except HEAD into
            # GET; 301 and 302 turn only POST into GET.
            status_code = response.status
            upper_method = current_method.upper()
            if status_code == 303:
                rewrite = upper_method != 'HEAD'
            elif status_code in (301, 302):
                rewrite = upper_method == 'POST'
            else:
                rewrite = False
            if rewrite:
                next_method = 'GET'
                next_body = None
            else:
                next_method = current_method
                next_body = current_body
                if isinstance(current_body, BodySource) and not current_body.replayable:
                    # The one stream was read to its end by the request that was just sent, so
                    # there is nothing to send again, and it is never buffered to make that
                    # possible.
                    self._release_response(response, self._transport_options.max_response_bytes)
                    raise ApiException(
                        status_code=response.status,
                        message='Refusing to replay a streamed request body',
                        response_headers=_lower_headers(response.headers),
                    )

            next_headers: Dict[str, str] = dict(current_headers)
            if not same_origin:
                # Guard 2: strip Authorization / Cookie /
                # Proxy-Authorization on cross-origin hops, including
                # the HTTPS -> HTTP downgrade case.
                for key in list(next_headers.keys()):
                    # Besides the fixed list, any header whose name looks like a
                    # credential (key, token, secret: the S15 rule) is dropped, so
                    # a default header or a custom authenticator header cannot leak.
                    if key.lower() in self._SENSITIVE_HEADERS or _is_sensitive_header(key):
                        del next_headers[key]

            # Drop body-bearing headers when the follow-up carries no body
            # (303 coercion, or 301/302 method demotion). A demoted body-less
            # POST still carries the `Content-Length: 0` workaround, which a GET
            # must not send. A body-less 307/308 replay keeps its own headers.
            drop_body_headers = next_body is None and (
                current_body is not None or next_method != current_method
            )
            if drop_body_headers:
                for key in list(next_headers.keys()):
                    if key.lower() in self._BODY_HEADERS:
                        del next_headers[key]

            # Read and release the prior response before issuing the
            # follow-up so urllib3 returns the connection to the pool.
            self._release_response(response, self._transport_options.max_response_bytes)

            hop_kwargs = dict(request_kwargs)
            if deadline is not None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise NetworkTimeoutException(
                        message='Request timed out: the timeout budget was used up before the redirect was followed'
                    )
                hop_kwargs['timeout'] = urllib3.Timeout(total=remaining)

            response = self._pool_manager.request(
                next_method,
                next_url,
                headers=next_headers,
                body=self._wire_body(next_body, opened),
                preload_content=False,
                decode_content=False,
                **hop_kwargs,
            )

            current_url = next_url
            current_method = next_method
            current_body = next_body
            current_headers = next_headers
            redirects_remaining -= 1

        # Redirect-budget exhaustion must surface as a typed SDK error rather
        # than silently handing back the final 3xx as if it were a normal
        # response. We only got here with a redirect status still set (and a
        # Location to follow) when the loop ran out of budget -- the
        # no-Location case breaks out and is a legitimate terminal 3xx.
        if (
            not unusable_location
            and response.status in self._REDIRECT_STATUSES
            and response.headers
            and response.headers.get('location')
        ):
            self._release_response(response, self._transport_options.max_response_bytes)
            raise ApiException(
                status_code=response.status,
                message=f'Too many redirects (exceeded {max_redirects})',
                response_headers=_lower_headers(response.headers),
            )

        return response

    @staticmethod
    def _release_response(response: Any, limit: Optional[int] = None) -> None:
        """Drain a redirect response and hand its connection back to the pool.

        The follow-up requests are made with ``preload_content=False``, so a
        3xx response keeps its connection checked out until the body is read
        and the connection released. This runs for every hop that is followed
        and for every redirect that is refused, so no refusal leaks one.

        With a ``limit`` (``max_response_bytes``) the redirect body is read like
        any buffered body: one past the limit is not read on, its connection is
        dropped instead of being returned to the pool, and the call fails.

        Raises:
            ResponseTooLargeException: If the redirect body passes ``limit``.
        """
        if limit is None:
            try:
                response.read()
            finally:
                response.release_conn()
            return
        try:
            drained = 0
            while True:
                chunk = response.read(min(65536, limit + 1 - drained))
                if not chunk:
                    break
                drained += len(chunk)
                if drained > limit:
                    raise _too_large(response, limit)
        finally:
            response.release_conn()

    @staticmethod
    def _resolve_url(base_url: str, location: str) -> Optional[str]:
        """Resolve a ``Location`` header against the request URL (RFC 3986).

        Returns ``None`` when the value cannot be parsed (for example
        ``http://[bad``), so the caller treats it like a missing ``Location``.

        An absolute URL is returned verbatim so the scheme-allowlist guard sees
        its raw scheme rather than one inherited from ``base_url``. Anything
        else goes through :func:`urllib.parse.urljoin`, which resolves
        query-only references (``?page=2`` keeps the base path), protocol- and
        path-relative references, and removes ``.``/``..`` segments.
        """
        try:
            if urlsplit(location).scheme:
                return location
            return urljoin(base_url, location)
        except ValueError:
            return None

    @staticmethod
    def _is_https_to_http_downgrade(original_url: str, redirect_url: str) -> bool:
        """Return ``True`` when ``original_url`` is HTTPS and ``redirect_url``
        is HTTP. Used by the body-replay guard so we only refuse on the
        TLS-removed direction; HTTP -> HTTPS and same-scheme hops are fine.
        """
        original = urlsplit(original_url)
        redirect = urlsplit(redirect_url)
        return (
            (original.scheme or '').lower() == 'https'
            and (redirect.scheme or '').lower() == 'http'
        )

    @staticmethod
    def _effective_port(scheme: str, port: Optional[int]) -> int:
        """Return the effective port for an origin comparison.

        Falls back to the scheme default (443 for ``https``, 80 for
        ``http``) when the URL omits an explicit port, so
        ``https://host/x`` and ``https://host:443/x`` compare equal.
        """
        if port is not None:
            return port
        return 443 if scheme.lower() == 'https' else 80

    @classmethod
    def _same_origin(cls, original_url: str, redirect_url: str) -> bool:
        """Return ``True`` when two URLs share the same origin.

        Same-origin requires identical scheme (case-insensitive),
        identical host (case-insensitive per RFC 3986 section 3.2.2),
        and identical effective port. The scheme MUST match so a
        redirect from ``https://host/x`` to ``http://host/x`` is
        treated as cross-origin -- this is the TLS downgrade guard
        that triggers Authorization stripping.
        """
        original = urlsplit(original_url)
        redirect = urlsplit(redirect_url)
        if not original.scheme or not redirect.scheme:
            return False
        if not original.hostname or not redirect.hostname:
            return False
        if original.scheme.lower() != redirect.scheme.lower():
            return False
        if original.hostname.lower() != redirect.hostname.lower():
            return False
        return (
            cls._effective_port(original.scheme, original.port)
            == cls._effective_port(redirect.scheme, redirect.port)
        )

    def _build_multipart_body(self, form_parts: Dict[str, Any], boundary: str) -> bytes:
        """Build a multipart/form-data body from a dict of form parts.

        Args:
            form_parts: Dict mapping field names to values.
            boundary: The multipart boundary string.

        Returns:
            Encoded multipart body as bytes.
        """
        parts: list[bytes] = []
        for name, value in form_parts.items():
            if value is None:
                continue
            if isinstance(value, list):
                for item in value:
                    if item is None:
                        continue
                    parts.append(self._multipart_part(name, item, boundary))
            else:
                parts.append(self._multipart_part(name, value, boundary))
        parts.append(f'--{boundary}--\r\n'.encode('utf-8'))
        return b''.join(parts)

    @staticmethod
    def _build_disposition(name: str, filename: Optional[str]) -> str:
        """Build a sanitized Content-Disposition header value for a multipart part."""
        # The field NAME is preserved as raw UTF-8 (only quote/backslash
        # escaped) -- it must NOT be ASCII-folded to '?', which is what
        # _sanitize_multipart_filename does for the filename fallback.
        safe_name = _sanitize_multipart_field_name(name)
        disposition = f'form-data; name="{safe_name}"'
        if filename is not None:
            ascii_fallback, rfc5987 = _sanitize_multipart_filename(filename)
            disposition += f'; filename="{ascii_fallback}"'
            if rfc5987 is not None:
                disposition += f"; filename*={rfc5987}"
        return disposition

    @classmethod
    def _multipart_part(cls, name: str, value: Any, boundary: str) -> bytes:
        """Build a single MIME part for multipart encoding.

        Accepts strings, bytes, file-like objects, ``(filename, content)`` tuples,
        and pydantic model instances. The per-part ``Content-Type`` is derived
        from the filename extension via :mod:`mimetypes`, falling back to
        ``application/octet-stream``.

        Args:
            name: The field name.
            value: The field value (str, bytes, file-like, tuple, or model object).
            boundary: The multipart boundary string.

        Returns:
            Encoded MIME part as bytes.

        Raises:
            ValueError: If the filename contains CR, LF, or NUL characters.
            TypeError: If a ``str`` is supplied where binary content is expected.
        """
        # (filename, content) tuples explicitly carry a filename
        if isinstance(value, tuple) and len(value) == 2:
            filename, content = value
            if isinstance(content, str):
                raise TypeError(
                    f'multipart part {name!r}: str content with explicit filename is not supported; '
                    f'pass bytes for binary data'
                )
            if hasattr(content, 'read'):
                # The caller owns the handle: it is read, never closed.
                read_data = content.read()
                if isinstance(read_data, str):
                    raise TypeError(
                        f'multipart part {name!r}: file opened in text mode; open with mode="rb"'
                    )
                if not isinstance(read_data, bytes):
                    raise TypeError(
                        f'multipart part {name!r}: file-like object did not return bytes from read()'
                    )
                file_data: bytes = read_data
            elif isinstance(content, bytes):
                file_data = content
            else:
                raise TypeError(
                    f'multipart part {name!r}: tuple content must be bytes or a binary file-like object'
                )
            disposition = cls._build_disposition(name, filename)
            content_type = _guess_content_type(filename)
            header = (
                f'--{boundary}\r\n'
                f'Content-Disposition: {disposition}\r\n'
                f'Content-Type: {content_type}\r\n\r\n'
            )
            return header.encode('utf-8') + file_data + b'\r\n'

        if hasattr(value, 'read'):
            filename = getattr(value, 'name', None)
            # The caller owns the handle: it is read, never closed.
            raw_data = value.read()
            if isinstance(raw_data, str):
                # File was opened in text mode; refuse rather than silently
                # round-tripping arbitrary bytes through UTF-8.
                raise TypeError(
                    f'multipart part {name!r}: file opened in text mode; open with mode="rb"'
                )
            if not isinstance(raw_data, bytes):
                raise TypeError(
                    f'multipart part {name!r}: file-like object did not return bytes from read()'
                )
            raw_bytes: bytes = raw_data
            disposition = cls._build_disposition(name, filename)
            content_type = _guess_content_type(filename)
            header = (
                f'--{boundary}\r\n'
                f'Content-Disposition: {disposition}\r\n'
                f'Content-Type: {content_type}\r\n\r\n'
            )
            return header.encode('utf-8') + raw_bytes + b'\r\n'
        elif isinstance(value, bytes):
            # Raw bytes carry no explicit filename, so reuse the field name as
            # the filename and guess the Content-Type from its extension,
            # falling back to application/octet-stream. This matches the
            # cross-language contract shared with go/node/java.
            disposition = cls._build_disposition(name, name)
            content_type = _guess_content_type(name)
            header = (
                f'--{boundary}\r\n'
                f'Content-Disposition: {disposition}\r\n'
                f'Content-Type: {content_type}\r\n\r\n'
            )
            return header.encode('utf-8') + value + b'\r\n'
        elif hasattr(value, 'model_dump_json'):
            # Route the model part through the SDK's configured ObjectSerializer
            # rather than pydantic's model_dump_json directly. ObjectSerializer
            # applies the SDK's canonical wire form: WIRE property names (field
            # aliases, e.g. `isEnabled`/`recordedAt`, NOT snake_case) AND the SDK
            # date-time format (millisecond precision, `...123Z`, NOT pydantic's
            # native microsecond `...123000Z`). This keeps the JSON model part
            # byte-identical to a JSON request body and matches the other 11
            # SDKs, whose ObjectSerializer.serialize is the single source of
            # truth for the model part of a multipart body. Imported lazily to
            # avoid a module-load cycle (object_serializer imports models).
            from {{packageName}}.object_serializer import ObjectSerializer
            json_str: str = ObjectSerializer().serialize(value)
            disposition = cls._build_disposition(name, None)
            header = (
                f'--{boundary}\r\n'
                f'Content-Disposition: {disposition}\r\n'
                f'Content-Type: application/json\r\n\r\n'
            )
            return header.encode('utf-8') + json_str.encode('utf-8') + b'\r\n'
        else:
            disposition = cls._build_disposition(name, None)
            # Imported lazily for the same cycle as the model branch above.
            from {{packageName}}.object_serializer import ObjectSerializer
            text = ObjectSerializer.stringify(value)
            part = f'--{boundary}\r\nContent-Disposition: {disposition}\r\n\r\n{text}\r\n'
            return part.encode('utf-8')

    @staticmethod
    def _decompress_body(data: bytes, encoding: str, limit: Optional[int] = None) -> bytes:
        """Decompress response body based on Content-Encoding header.

        Supports gzip and deflate natively. Brotli and zstd are supported
        when their respective packages (brotli, zstandard) are installed.

        Args:
            data: Raw response bytes.
            encoding: Content-Encoding header value.
            limit: The most decompressed bytes allowed (``max_response_bytes``), or ``None``.

        Returns:
            Decompressed bytes.

        Raises:
            _BodyTooLarge: If the decompressed body passes ``limit``; decoding stops there.
        """
        if not data:
            return data
        if limit is not None and encoding not in ('', 'identity'):
            return DefaultApiClient._decompress_capped(data, encoding, limit)
        if encoding in ('gzip', 'x-gzip'):
            return gzip.decompress(data)
        if encoding == 'deflate':
            return zlib.decompress(data)
        if encoding == 'br' and _brotli is not None:
            br_result: bytes = _brotli.decompress(data)
            return br_result
        if encoding == 'zstd' and _zstandard is not None:
            # Stream-decode rather than one-shot decompress: a streaming
            # encoder omits the frame content size, so there is no output size
            # to allocate and any cap would reject a legitimate high-ratio body.
            zstd_stream = _zstandard.ZstdDecompressor().decompressobj()
            zstd_result: bytes = zstd_stream.decompress(data)
            if not zstd_stream.eof:
                raise ValueError('Truncated zstd frame')
            return zstd_result
        if encoding in ('', 'identity'):
            return data
        # An unrecognised (or multi-value) Content-Encoding is a response the
        # client cannot honour. Raise — the caller re-raises it as an
        # ApiException carrying the response status (matching csharp/elixir and
        # the documented contract) rather than returning still-encoded bytes.
        raise ValueError(f"Unsupported Content-Encoding '{encoding}'")

    @staticmethod
    def _decompress_capped(data: bytes, encoding: str, limit: int) -> bytes:
        """Decode ``data`` incrementally, stopping as soon as the output passes ``limit``.

        gzip and deflate ask zlib for at most the bytes still allowed; brotli uses its output
        limit where the installed version has one; otherwise the input is fed in small pieces
        and the output is counted after each, so a body that inflates past the limit is never
        decoded in full.

        Raises:
            _BodyTooLarge: If the decompressed body passes ``limit``.
            ValueError: If the body is truncated or the encoding is not supported.
        """
        chunks: List[bytes] = []
        total = 0

        def take(chunk: bytes) -> None:
            nonlocal total
            total += len(chunk)
            if total > limit:
                raise _BodyTooLarge()
            chunks.append(chunk)

        if encoding in ('gzip', 'x-gzip', 'deflate'):
            # wbits 31 reads a gzip member, 15 a zlib stream; gzip members may follow each other.
            wbits = 15 if encoding == 'deflate' else 31
            pending = data
            while pending:
                decoder = zlib.decompressobj(wbits)
                while pending and not decoder.eof:
                    take(decoder.decompress(pending, limit + 1 - total))
                    pending = decoder.unconsumed_tail
                while not decoder.eof:
                    # The input is all in; what remains is output zlib still holds back.
                    out = decoder.decompress(b'', limit + 1 - total)
                    if not out:
                        break
                    take(out)
                if not decoder.eof:
                    raise ValueError(
                        'Compressed file ended before the end-of-stream marker was reached'
                    )
                pending = decoder.unused_data if encoding != 'deflate' else b''
                if pending and not pending.strip(b'\x00'):
                    pending = b''
            return b''.join(chunks)
        if encoding == 'br' and _brotli is not None:
            br_decoder = _brotli.Decompressor()
            try:
                take(br_decoder.process(data, output_buffer_limit=limit + 1 - total))
                while not br_decoder.is_finished():
                    out = br_decoder.process(b'', output_buffer_limit=limit + 1 - total)
                    if not out:
                        break
                    take(out)
            except TypeError:
                # A brotli without an output limit: feed the input in small pieces instead.
                chunks.clear()
                total = 0
                br_decoder = _brotli.Decompressor()
                for start in range(0, len(data), _DECODE_INPUT_CHUNK):
                    take(br_decoder.process(data[start:start + _DECODE_INPUT_CHUNK]))
            if not br_decoder.is_finished():
                raise ValueError('Truncated brotli stream')
            return b''.join(chunks)
        if encoding == 'zstd' and _zstandard is not None:
            zstd_stream = _zstandard.ZstdDecompressor().decompressobj()
            for start in range(0, len(data), _DECODE_INPUT_CHUNK):
                take(zstd_stream.decompress(data[start:start + _DECODE_INPUT_CHUNK]))
                if zstd_stream.eof:
                    break
            if not zstd_stream.eof:
                raise ValueError('Truncated zstd frame')
            return b''.join(chunks)
        raise ValueError(f"Unsupported Content-Encoding '{encoding}'")
