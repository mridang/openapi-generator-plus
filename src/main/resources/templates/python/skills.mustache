{{#binaryStreamOperation}}async def save_to(client: {{clientClassName}}, {{#binaryStreamExample}}{{#hasParameters}}{{{parameters}}}, {{/hasParameters}}{{/binaryStreamExample}}target: Path) -> None:
    stream = await client.{{#binaryStreamGroup}}{{clientPropertyName}}{{/binaryStreamGroup}}.{{operationId}}({{#binaryStreamExample}}{{{arguments}}}{{/binaryStreamExample}})
    async with stream:
        print(stream.status_code)
