import asyncio
from types import MappingProxyType, TracebackType
from typing import Mapping, Optional, Type

from {{packageName}}.api_stream_response import StreamBody

_CHUNK_SIZE = 65536
"""The most bytes one step of ``async for`` hands out."""


class ByteStream:
    """The body of a binary response, read as it arrives.

    An operation whose success response is binary returns one instead of
    buffering the bytes, so a large download never has to fit in memory.

    Read it with ``await stream.read(n)``, iterate it with ``async for chunk in
    stream``, or take every byte with :meth:`read_all`. It also carries the
    :attr:`status_code` and the lower-cased :attr:`headers`.

    :meth:`close` is idempotent and aborts the connection instead of draining
    the rest of the body, so use ``async with`` (or close the stream) when you
    stop early. A failure after the headers surfaces from a read as a
    :class:`StreamException`; a stall longer than the transport's
    ``idle_timeout`` is a :class:`NetworkTimeoutException`. Closing the client
    cancels the streams still open: their next read raises :class:`RuntimeError`.

    ``repr`` shows the status code and the number of bytes delivered, never the
    headers, the URL or the content.
    """

    def __init__(self, status_code: int, headers: Mapping[str, str], source: StreamBody) -> None:
        """Wrap an open response body.

        Args:
            status_code: The HTTP status code.
            headers: The response headers, lower-cased.
            source: The open body; this stream closes it.
        """
        self._status_code = status_code
        self._headers: Mapping[str, str] = MappingProxyType(dict(headers))
        self._source = source
        self._delivered = 0
        self._closed = False

    @property
    def status_code(self) -> int:
        """The HTTP status code of the response."""
        return self._status_code

    @property
    def headers(self) -> Mapping[str, str]:
        """The response headers, with lower-cased names and repeated values joined by ``', '``."""
        return self._headers

    async def read(self, size: int = -1) -> bytes:
        """Read up to ``size`` bytes, as soon as some are available.

        Args:
            size: The most bytes to return; a negative value reads everything that is left.

        Returns:
            The bytes read, and ``b''`` once the body has ended.

        Raises:
            ValueError: If the stream was closed.
            RuntimeError: If the client was closed, which cancels the stream.
            NetworkTimeoutException: If the body stayed silent longer than the idle timeout.
            StreamException: If the connection broke, or the body ended before its declared length.
        """
        if self._closed:
            raise ValueError('I/O operation on a closed ByteStream')
        if size == 0:
            return b''
        try:
            data = await asyncio.to_thread(self._source.read, size)
        except asyncio.CancelledError:
            self.close()
            raise
        except Exception:
            if self._closed:
                raise ValueError('I/O operation on a closed ByteStream') from None
            raise
        self._delivered += len(data)
        return data

    async def read_all(self) -> bytes:
        """Read every remaining byte and close the stream, so the call leaves nothing open.

        Returns:
            The remaining bytes, in order.
        """
        try:
            return await self.read(-1)
        finally:
            self.close()

    def close(self) -> None:
        """Close the stream and abort the connection; later calls do nothing."""
        if self._closed:
            return
        self._closed = True
        self._source.close()

    def __aiter__(self) -> 'ByteStream':
        return self

    async def __anext__(self) -> bytes:
        data = await self.read(_CHUNK_SIZE)
        if not data:
            raise StopAsyncIteration
        return data

    async def __aenter__(self) -> 'ByteStream':
        return self

    async def __aexit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_val: Optional[BaseException],
        exc_tb: Optional[TracebackType],
    ) -> None:
        self.close()

    def __repr__(self) -> str:
        """Shows the status code and the bytes delivered so far."""
        return f'ByteStream(status_code={self._status_code}, bytes_delivered={self._delivered})'
