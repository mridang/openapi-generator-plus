import asyncio
import os
import threading
from types import TracebackType
from typing import Any, AsyncIterable, BinaryIO, Callable, Iterable, Iterator, List, Optional, Type, Union

_CHUNK_SIZE = 64 * 1024

BodyContent = Union[bytes, bytearray, memoryview, BinaryIO, Iterable[bytes], AsyncIterable[bytes]]
"""What a body can be made of: bytes, a binary file object, an iterable of bytes or an async iterable of bytes."""


class OpenedBody:
    """One send of a :class:`BodySource`: an iterator over its chunks.

    The transport that reads a body calls :meth:`close` when the send is over. Closing releases
    what the SDK opened itself (a file, the stream a factory made) and never a stream the caller
    passed to :meth:`BodySource.once`.
    """

    def __init__(self, chunks: Iterator[bytes], on_close: Optional[Callable[[], None]] = None) -> None:
        self._chunks = chunks
        self._on_close = on_close
        self._closed = False

    def __iter__(self) -> 'OpenedBody':
        return self

    def __next__(self) -> bytes:
        return next(self._chunks)

    def close(self) -> None:
        """Release what the SDK opened for this send; calling it again does nothing."""
        if self._closed:
            return
        self._closed = True
        if self._on_close is not None:
            try:
                self._on_close()
            except Exception:
                pass

    def __enter__(self) -> 'OpenedBody':
        return self

    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[TracebackType],
    ) -> None:
        self.close()


def _slices(data: Union[bytes, bytearray, memoryview]) -> Iterator[bytes]:
    view = memoryview(data)
    for start in range(0, len(view), _CHUNK_SIZE):
        yield bytes(view[start : start + _CHUNK_SIZE])


def _reads(read: Callable[[int], Any]) -> Iterator[bytes]:
    while True:
        chunk = read(_CHUNK_SIZE)
        if not chunk:
            return
        if not isinstance(chunk, (bytes, bytearray, memoryview)):
            raise TypeError('A request body stream must be opened in binary mode and yield bytes')
        yield bytes(chunk)


def _items(chunks: Iterable[Any]) -> Iterator[bytes]:
    for chunk in chunks:
        if not isinstance(chunk, (bytes, bytearray, memoryview)):
            raise TypeError('A request body iterable must yield bytes')
        if chunk:
            yield bytes(chunk)


async def _next_chunk(iterator: Any) -> Optional[bytes]:
    try:
        chunk: bytes = await iterator.__anext__()
    except StopAsyncIteration:
        return None
    return chunk


def _async_items(iterable: Any, loop: Optional[asyncio.AbstractEventLoop]) -> Iterator[bytes]:
    """Pull an async iterable from a worker thread, one chunk at a time, on the loop of the call."""
    if loop is None:
        raise RuntimeError('An async request body can only be sent by an async operation')
    iterator = iterable.__aiter__()

    def pull() -> Iterator[bytes]:
        while True:
            chunk = asyncio.run_coroutine_threadsafe(_next_chunk(iterator), loop).result()
            if chunk is None:
                return
            if not isinstance(chunk, (bytes, bytearray, memoryview)):
                raise TypeError('A request body iterable must yield bytes')
            if chunk:
                yield bytes(chunk)

    return pull()


def _exact(chunks: Iterator[bytes], length: int) -> Iterator[bytes]:
    """Yield the chunks and refuse a body that is not exactly ``length`` bytes long."""
    sent = 0
    for chunk in chunks:
        sent += len(chunk)
        if sent > length:
            raise ValueError(f'The request body is longer than its declared length of {length} bytes')
        yield chunk
    if sent != length:
        raise ValueError(f'The request body is {sent} bytes long, not its declared length of {length} bytes')


class BodySource:
    """The body of a request that is sent as it is read, never buffered. An operation whose
    request body is raw binary takes one.

    A body is either *replayable* or *single use*:

    * :meth:`of`, :meth:`of_file` and :meth:`from_factory` can be read again, so the SDK retries the
      request after a ``5xx``, a ``429`` or a network error and follows a ``307`` or ``308`` redirect.
    * :meth:`once` wraps a stream that can be read once. It is never retried (the original error is
      raised unchanged) and a redirect that would need it again is refused with
      ``Refusing to replay a streamed request body``.

    A known length is sent as ``Content-Length``; an unknown length is sent chunked. The SDK never
    closes a stream you pass to :meth:`once`; it does close what it opened itself from a file or a
    factory. A stream is a binary file object, an iterable of bytes or an async iterable of bytes.

    ``repr`` shows the kind and the length, never the content or the path.
    """

    def __init__(
        self,
        kind: str,
        *,
        data: Optional[bytes] = None,
        path: Optional[str] = None,
        factory: Optional[Callable[[], BodyContent]] = None,
        stream: Optional[BodyContent] = None,
        length: Optional[int] = None,
    ) -> None:
        self._kind = kind
        self._data = data
        self._path = path
        self._factory = factory
        self._stream = stream
        self._length = length
        self._lock = threading.Lock()
        self._taken = False
        self._loop: Optional[asyncio.AbstractEventLoop] = None

    @staticmethod
    def of(data: Union[bytes, bytearray, memoryview]) -> 'BodySource':
        """A replayable body of bytes held in memory; its length is known.

        Args:
            data: The content, which is copied.
        """
        copy = bytes(data)
        return BodySource('bytes', data=copy, length=len(copy))

    @staticmethod
    def of_file(path: Union[str, 'os.PathLike[str]']) -> 'BodySource':
        """A replayable body read from a file, opened again for every send.

        Its length is the size of the file and the SDK closes what it opens.

        Args:
            path: The file.
        """
        return BodySource('file', path=os.fspath(path))

    @staticmethod
    def from_factory(factory: Callable[[], BodyContent], length: Optional[int] = None) -> 'BodySource':
        """A replayable body made by a factory that opens a fresh stream every time it is called.

        The SDK closes each stream it opens.

        Args:
            factory: Opens a fresh binary file object, iterable of bytes or async iterable of bytes
                for every send.
            length: The number of bytes every stream holds, sent as ``Content-Length``; omit it to
                send the body chunked.

        Raises:
            ValueError: If ``length`` is negative.
        """
        return BodySource('factory', factory=factory, length=_checked_length(length))

    @staticmethod
    def once(stream: BodyContent, length: Optional[int] = None) -> 'BodySource':
        """A single-use body. The stream is read once, never buffered and never closed by the SDK.

        Args:
            stream: A binary file object, an iterable of bytes or an async iterable of bytes.
            length: The number of bytes the stream holds, sent as ``Content-Length``; omit it to
                send the body chunked.

        Raises:
            ValueError: If ``length`` is negative.
        """
        return BodySource('single use', stream=stream, length=_checked_length(length))

    @property
    def replayable(self) -> bool:
        """Whether the body can be sent again, which is what a retry or a redirect needs."""
        return self._kind != 'single use'

    @property
    def length(self) -> Optional[int]:
        """The number of bytes when it is known, else ``None`` and the body is sent chunked.

        Raises:
            OSError: If the size of a file cannot be read.
        """
        if self._kind == 'file':
            assert self._path is not None
            return os.path.getsize(self._path)
        return self._length

    def _bytes_or_none(self) -> Optional[bytes]:
        """The bytes of an in-memory body, shared with the transport, or ``None``."""
        return self._data

    def _bind_loop(self, loop: asyncio.AbstractEventLoop) -> None:
        """Let a worker thread read an async stream on the loop of the call that sends it."""
        self._loop = loop

    def open(self) -> OpenedBody:
        """Open the content for one send; the caller closes what it gets.

        A transport that is not the default one reads a body with this method. A replayable body
        opens a fresh stream every time. A single-use body opens once (a second call raises
        :class:`RuntimeError`) and closing what it returns leaves the stream open, because the
        stream belongs to whoever passed it to :meth:`once`.

        Raises:
            OSError: If a file cannot be opened.
            RuntimeError: If a single-use body is opened a second time.
            ValueError: If a factory returned ``None``.
        """
        if self._kind == 'bytes':
            assert self._data is not None
            return OpenedBody(_slices(self._data))
        if self._kind == 'file':
            assert self._path is not None
            handle = open(self._path, 'rb')
            return OpenedBody(_reads(handle.read), handle.close)
        if self._kind == 'factory':
            assert self._factory is not None
            made = self._factory()
            if made is None:
                raise ValueError('The stream factory of a request body returned None')
            return self._adapt(made, owned=True)
        with self._lock:
            if self._taken:
                raise RuntimeError('A single use request body can be sent only once')
            self._taken = True
        assert self._stream is not None
        return self._adapt(self._stream, owned=False)

    def _adapt(self, content: Any, owned: bool) -> OpenedBody:
        closers: List[Callable[[], Any]] = []
        chunks: Iterator[bytes]
        if isinstance(content, (bytes, bytearray, memoryview)):
            chunks = _slices(content)
        elif hasattr(content, 'read'):
            chunks = _reads(content.read)
            if owned and hasattr(content, 'close'):
                closers.append(content.close)
        elif hasattr(content, '__aiter__'):
            chunks = _async_items(content, self._loop)
            if owned and hasattr(content, 'aclose') and self._loop is not None:
                loop = self._loop
                closers.append(lambda: asyncio.run_coroutine_threadsafe(content.aclose(), loop).result())
        elif hasattr(content, '__iter__'):
            chunks = _items(content)
            if owned and hasattr(content, 'close'):
                closers.append(content.close)
        else:
            raise TypeError(f'A request body cannot be made of {type(content).__name__}')

        def close() -> None:
            for closer in closers:
                closer()

        return OpenedBody(chunks, close if closers else None)

    def _wire(self, opened: List[OpenedBody]) -> Union[bytes, Iterator[bytes]]:
        """What the transport hands to the HTTP layer for one send.

        An in-memory body and an empty one go as bytes; anything else is read as it is sent and
        checked against its declared length. A stream opened here is added to ``opened``, which the
        transport closes when the call is over.
        """
        if self._data is not None:
            return self._data
        known = self.length
        if known == 0:
            return b''
        stream = self.open()
        opened.append(stream)
        return stream if known is None else _exact(iter(stream), known)

    def __repr__(self) -> str:
        try:
            known = self.length
            size = f'{known} bytes' if known is not None else 'length unknown'
        except OSError:
            size = 'length unknown'
        return f'BodySource[{self._kind}, {size}]'

    __str__ = __repr__


def _checked_length(length: Optional[int]) -> Optional[int]:
    if length is not None and length < 0:
        raise ValueError('The length of a body cannot be negative')
    return length
