[project]
name = "{{projectName}}"
version = "{{packageVersion}}"
description = "{{#appDescription}}{{appDescription}}{{/appDescription}}{{^appDescription}}{{projectName}} - OpenAPI client{{/appDescription}}"
license = "{{licenseId}}"
requires-python = ">=3.13"
dependencies = [
    "urllib3>=2.1.0,<3.0.0",
    "python_dateutil>=2.8.2",
    "pydantic[email]>=2,<3",
    "typing-extensions>=4.7.1",
    "brotli>=1.0.0",
    "zstandard>=0.19.0",
]

[dependency-groups]
dev = [
    "pytest>=7.0.0",
    "pytest-asyncio>=0.21.0",
    "mypy>=1,<3",
    "ruff>=0.15,<0.16",
    "types-python-dateutil>=2.8.0",
    "types-requests>=2.28.0",
    "types-urllib3>=1.26.0",
{{#generateTests}}
    "testcontainers>=4.0.0",
{{/generateTests}}
    "pytest-cov>=4.0.0",
    "opentelemetry-sdk>=1.20.0",
    "sphinx>=7,<10",
    "furo>=2024.1.29",
]

[build-system]
requires = ["setuptools>=69"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
include = ["{{packageName}}*"]

[tool.setuptools.package-data]
{{packageName}} = ["py.typed"]

# Ruff and mypy run with their industry-default configuration; no custom or
# relaxed rules, line length or rule selection are declared here. No generated
# module carries a suppression of any kind: every rule applies to every file,
# and the only exceptions are the two named below.

[tool.ruff.lint.per-file-ignores]
# Two schemas that reference each other (A has a B, B has an A) generate two
# modules that import each other, so the model imports have to follow the
# class definition or the cycle fails at import time.
"{{packageName}}/models/*.py" = ["E402"]
# The typed subclasses import the root exception from this module, so their
# re-export can only follow the class definition.
"{{packageName}}/errors/__init__.py" = ["E402"]

[[tool.mypy.overrides]]
# brotli ships neither stubs nor a py.typed marker, and the SDK imports it
# behind a try/except. Declaring that here keeps the check on the SDK's own
# code strict rather than silencing the import inline.
module = ["brotli"]
ignore_missing_imports = true

[tool.pytest.ini_options]
cache_dir = ".pytest"
testpaths = ["test", "spec"]
python_files = "test_*.py *_spec.py"
asyncio_mode = "auto"
addopts = "--cov={{packageName}} --cov-report=xml:.out/coverage.xml --cov-report=term-missing --junitxml=.out/reports/junit.xml"
