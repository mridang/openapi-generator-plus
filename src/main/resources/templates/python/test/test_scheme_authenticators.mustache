"""Unit tests for the per-scheme authenticators: each reads its own environment variables."""

import importlib
from typing import Any, List, Tuple

import pytest

# (module, class name, [(parameter, environment variable)], bearer, basic, api key)
SCHEMES: List[Tuple[str, str, List[Tuple[str, str]], bool, bool, bool]] = [
{{#perSchemeAuthEntries}}
    (
        '{{module}}',
        '{{className}}',
        [{{#envParams}}('{{name}}', '{{envName}}'){{^-last}}, {{/-last}}{{/envParams}}],
        {{#isBearer}}True{{/isBearer}}{{^isBearer}}False{{/isBearer}},
        {{#isBasic}}True{{/isBasic}}{{^isBasic}}False{{/isBasic}},
        {{#isApiKey}}True{{/isApiKey}}{{^isApiKey}}False{{/isApiKey}},
    ),
{{/perSchemeAuthEntries}}
]
HOST = 'https://api.example.com'


def _scheme_class(module: str, name: str) -> Any:
    return getattr(importlib.import_module(module), name)


def _clear(monkeypatch: pytest.MonkeyPatch, variables: List[Tuple[str, str]]) -> None:
    for _, variable in variables:
        monkeypatch.delenv(variable, raising=False)


def _set_all(monkeypatch: pytest.MonkeyPatch, variables: List[Tuple[str, str]]) -> None:
    for _, variable in variables:
        monkeypatch.setenv(variable, 'value-' + variable)


def _explicit(variables: List[Tuple[str, str]]) -> dict[str, str]:
    return {parameter: 'explicit-' + parameter for parameter, _ in variables}


@pytest.mark.parametrize('module,name,variables,bearer,basic,api_key', SCHEMES)
class TestSchemeAuthenticatorEnvironment:

    def test_it_builds_from_its_environment_variables_alone(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str,
        variables: List[Tuple[str, str]], bearer: bool, basic: bool, api_key: bool,
    ) -> None:
        _set_all(monkeypatch, variables)

        assert _scheme_class(module, name)(HOST) is not None

    def test_bhv_authscheme_002_explicit_arguments_need_no_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str,
        variables: List[Tuple[str, str]], bearer: bool, basic: bool, api_key: bool,
    ) -> None:
        _clear(monkeypatch, variables)

        assert _scheme_class(module, name)(HOST, **_explicit(variables)) is not None

    def test_a_missing_credential_names_its_variable(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str,
        variables: List[Tuple[str, str]], bearer: bool, basic: bool, api_key: bool,
    ) -> None:
        _clear(monkeypatch, variables)

        with pytest.raises(ValueError, match=variables[0][1]):
            _scheme_class(module, name)(HOST)

    def test_bhv_authbasic_012_an_empty_variable_counts_as_unset(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str,
        variables: List[Tuple[str, str]], bearer: bool, basic: bool, api_key: bool,
    ) -> None:
        _clear(monkeypatch, variables)
        monkeypatch.setenv(variables[0][1], '')

        with pytest.raises(ValueError, match=variables[0][1]):
            _scheme_class(module, name)(HOST)

    def test_bhv_authscheme_001_each_variable_is_required_on_its_own(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str,
        variables: List[Tuple[str, str]], bearer: bool, basic: bool, api_key: bool,
    ) -> None:
        for _, missing in variables:
            _set_all(monkeypatch, variables)
            monkeypatch.delenv(missing)

            with pytest.raises(ValueError, match=missing):
                _scheme_class(module, name)(HOST)


BEARER_SCHEMES = [(module, name, variables) for module, name, variables, bearer, _, _ in SCHEMES if bearer]
BASIC_SCHEMES = [(module, name, variables) for module, name, variables, _, basic, _ in SCHEMES if basic]
API_KEY_SCHEMES = [(module, name, variables) for module, name, variables, _, _, api_key in SCHEMES if api_key]


@pytest.mark.parametrize('module,name,variables', BEARER_SCHEMES)
class TestBearerSchemeAuthenticator:

    def test_bhv_authbearer_018_an_explicit_token_wins_over_the_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        authenticator = _scheme_class(module, name)(HOST, 'explicit')

        assert authenticator.get_auth_headers()['Authorization'] == 'Bearer explicit'

    def test_the_environment_supplies_the_token(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        authenticator = _scheme_class(module, name)(HOST)

        assert authenticator.get_auth_headers()['Authorization'] == 'Bearer from-environment'

    def test_bhv_lifecycle_025_the_environment_is_read_once_when_it_is_built(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'first')
        authenticator = _scheme_class(module, name)(HOST)

        monkeypatch.setenv(variables[0][1], 'second')

        assert authenticator.get_auth_headers()['Authorization'] == 'Bearer first'

    def test_a_token_provider_wins_over_the_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        authenticator = _scheme_class(module, name)(HOST, token_provider=lambda: 'live')

        assert authenticator.get_auth_headers()['Authorization'] == 'Bearer live'

    def test_a_token_provider_needs_no_environment_token(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.delenv(variables[0][1], raising=False)

        authenticator = _scheme_class(module, name)(HOST, token_provider=lambda: 'live')

        assert authenticator.get_auth_headers()['Authorization'] == 'Bearer live'

    def test_a_token_and_a_token_provider_together_are_rejected(
        self, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        with pytest.raises(ValueError, match='not both'):
            _scheme_class(module, name)(HOST, 'explicit', token_provider=lambda: 'live')

    def test_an_explicit_empty_token_is_rejected_not_replaced_by_the_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        with pytest.raises(ValueError, match='must not be empty'):
            _scheme_class(module, name)(HOST, '')


@pytest.mark.parametrize('module,name,variables', BASIC_SCHEMES)
class TestBasicSchemeAuthenticator:

    def test_bhv_authbasic_013_an_explicit_credential_wins_over_the_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        _set_all(monkeypatch, variables)

        authenticator = _scheme_class(module, name)(HOST, 'explicit-user', 'explicit-pass')

        assert authenticator.username == 'explicit-user'
        assert authenticator.password == 'explicit-pass'

    def test_the_environment_supplies_the_username_and_password(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        _set_all(monkeypatch, variables)

        authenticator = _scheme_class(module, name)(HOST)

        assert authenticator.username == 'value-' + variables[0][1]
        assert authenticator.password == 'value-' + variables[1][1]


@pytest.mark.parametrize('module,name,variables', API_KEY_SCHEMES)
class TestApiKeySchemeAuthenticator:

    def test_bhv_serializationobject_187_an_explicit_key_wins_over_the_environment(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        authenticator = _scheme_class(module, name)(HOST, 'explicit')

        assert authenticator.api_key == 'explicit'

    def test_the_environment_supplies_the_key(
        self, monkeypatch: pytest.MonkeyPatch, module: str, name: str, variables: List[Tuple[str, str]]
    ) -> None:
        monkeypatch.setenv(variables[0][1], 'from-environment')

        authenticator = _scheme_class(module, name)(HOST)

        assert authenticator.api_key == 'from-environment'
