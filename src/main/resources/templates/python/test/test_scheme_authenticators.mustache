# (module, class name, [(parameter, environment variable)]) for each OAuth flow wrapper, by flow
FLOW_SCHEMES: List[Tuple[str, str, str, List[Tuple[str, str]]]] = [
{{#perSchemeAuthEntries}}
    (
        '{{flow}}',
        '{{module}}',
        '{{className}}',
