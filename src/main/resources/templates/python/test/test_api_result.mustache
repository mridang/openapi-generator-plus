from typing import Any, cast
import pytest

from {{packageName}}.api_result import ApiResult


class TestApiResult:
    def test_bhv_results_003_carries_data_status_code_headers_and_raw_body(self) -> None:
        result = ApiResult(
            status_code=200,
            data={'id': 1},
            raw_body='{"id": 1}',
            headers={'Content-Type': 'application/json'},
        )

        assert result.status_code == 200
        assert result.data == {'id': 1}
        assert result.raw_body == '{"id": 1}'
        assert result.headers == {'Content-Type': 'application/json'}

    def test_bhv_results_007_data_raw_body_and_headers_are_returned_exactly_as_supplied(self) -> None:
        result = ApiResult(
            status_code=200,
            data={'id': 1},
            raw_body='{"id": 1}',
            headers={'Content-Type': 'application/json'},
        )

        assert (result.data, result.raw_body, result.headers) == (
            {'id': 1}, '{"id": 1}', {'Content-Type': 'application/json'}
        )

    def test_bhv_results_004_an_api_result_exposes_the_deserialized_data(self) -> None:
        result = ApiResult(status_code=200, data={'id': 2}, raw_body='', headers={})

        assert result.data == {'id': 2}

    def test_bhv_results_005_a_result_exposes_the_raw_response_body(self) -> None:
        result: ApiResult[None] = ApiResult(status_code=200, data=None, raw_body='{"id": 2}', headers={})

        assert result.raw_body == '{"id": 2}'

    def test_bhv_results_001_data_may_be_none_for_empty_response(self) -> None:
        # A 204 No Content carries no deserialized payload, but raw_body is
        # always populated (an empty string when the server sent no body).
        result: ApiResult[None] = ApiResult(
            status_code=204, data=None, raw_body='', headers={}
        )

        assert result.status_code == 204
        assert result.data is None
        assert result.raw_body == ''
        assert result.headers == {}

    def test_bhv_results_002_headers_are_a_read_only_copy(self) -> None:
        source = {'Content-Type': 'application/json'}
        result: ApiResult[None] = ApiResult(
            status_code=200, data=None, raw_body='', headers=source
        )
        source['X-Late'] = '1'

        assert 'X-Late' not in result.headers
        with pytest.raises(TypeError):
            cast(Any, result.headers)['X-New'] = '1'

    def test_is_frozen(self) -> None:
        # ApiResult is an immutable @dataclass(frozen=True); attribute
        # assignment must raise.
        result: ApiResult[None] = ApiResult(
            status_code=200, data=None, raw_body='', headers={}
        )

        with pytest.raises(Exception):
            cast(Any, result).status_code = 500


class TestApiResultHeadersAreACopy:
    def test_bhv_results_006_the_headers_are_a_read_only_copy_taken_when_the_result_is_built(self) -> None:
        source = {'Content-Type': 'application/json'}
        result: ApiResult[None] = ApiResult(status_code=200, data=None, raw_body='', headers=source)

        source['X-Late'] = 'added-after-build'

        assert result.headers == {'Content-Type': 'application/json'}
        with pytest.raises(TypeError):
            result.headers['X-Other'] = 'x'  # type: ignore[index]
