class _Reply:
    """The response a urllib3 pool manager hands back."""

    status = 200
    headers = HTTPHeaderDict({'content-type': 'application/json'})

    def read(self) -> bytes:
        return b'{}'

    def release_conn(self) -> None:
        pass


class _SlowPool:
    """A pool manager double whose request waits until the test lets it finish."""

    def __init__(self) -> None:
        self.started = threading.Event()
        self.finish = threading.Event()
        self.requests = 0
        self.clears = 0

    def request(self, method: str, url: str, **kwargs: Any) -> _Reply:
        self.requests += 1
        self.started.set()
        self.finish.wait(10)
        return _Reply()

    def clear(self) -> None:
        self.clears += 1


def _owning(pool: Any) -> {{clientClassName}}:
    """A client that owns ``pool`` as the transport it built itself."""
    client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'))
    client._api_client._pool_manager = pool
    client._api_client._owns_pool = True
    return client


async def _send(client: {{clientClassName}}) -> Any:
    return await asyncio.to_thread(client._api_client.send_request, 'GET', '{{{basePath}}}/x', {}, None)


class TestClientClose:
    """F1078: closing is graceful and idempotent; requests in flight finish."""

    async def test_bhv_lifecycle_037_a_request_in_flight_finishes_and_the_transport_is_released_after_it(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()

        assert pool.clears == 0
        pool.finish.set()
        assert (await request).status_code == 200
        assert pool.clears == 1

    async def test_the_transport_is_released_when_the_last_of_several_requests_ends(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        first = asyncio.ensure_future(_send(client))
        second = asyncio.ensure_future(_send(client))
        while pool.requests < 2:
            await asyncio.sleep(0.01)

        client.close()
        pool.finish.set()
        await asyncio.gather(first, second)

        assert pool.clears == 1

    def test_closing_with_nothing_in_flight_releases_the_transport_at_once(self) -> None:
        pool = _SlowPool()

        _owning(pool).close()

        assert pool.clears == 1

    async def test_bhv_lifecycle_036_a_second_close_does_nothing(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()
        client.close()
        pool.finish.set()
        await request
        client.close()

        assert pool.clears == 1

    async def test_bhv_lifecycle_035_a_closed_client_rejects_a_new_request_with_the_client_closed_error(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        client.close()

        with pytest.raises(RuntimeError) as error:
            await _send(client)

        assert str(error.value) == 'ApiClient has been closed and can no longer send requests'
        assert pool.requests == 0

    async def test_bhv_lifecycle_009_a_pool_manager_the_caller_supplied_is_never_cleared(self) -> None:
        pool = _SlowPool()
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'), pool_manager=pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()
        client.close()
        pool.finish.set()
        await request

        assert pool.clears == 0

    def test_bhv_lifecycle_040_leaving_the_with_block_closes_the_client(self) -> None:
        pool = _SlowPool()

        with _owning(pool):
            assert pool.clears == 0

        assert pool.clears == 1


class _OwnedPool(urllib3.PoolManager):
    cleared = False

    def clear(self) -> None:
        self.cleared = True
        super().clear()


