    def test_bhv_lifecycle_043_a_request_after_close_fails_and_never_reaches_the_pool(self) -> None:
        class _CountingPool(urllib3.PoolManager):
            requests = 0

            def request(self, *args: Any, **kwargs: Any) -> Any:
                self.requests += 1
                return super().request(*args, **kwargs)

        pool = _CountingPool()
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'), pool_manager=pool)
        client.close()

        with pytest.raises(RuntimeError, match='closed'):
