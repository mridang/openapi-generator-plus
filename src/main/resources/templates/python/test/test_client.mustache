class TestClientClose:
    """F1078: closing is graceful and idempotent; requests in flight finish."""

    async def test_bhv_lifecycle_037_a_request_in_flight_finishes_and_the_transport_is_released_after_it(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()

        assert pool.clears == 0
        pool.finish.set()
        assert (await request).status_code == 200
        assert pool.clears == 1

    async def test_bhv_lang_python_050_the_transport_is_released_when_the_last_of_several_requests_ends(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        first = asyncio.ensure_future(_send(client))
        second = asyncio.ensure_future(_send(client))
        while pool.requests < 2:
            await asyncio.sleep(0.01)

        client.close()
        pool.finish.set()
        await asyncio.gather(first, second)

        assert pool.clears == 1

    def test_bhv_lang_python_051_closing_with_nothing_in_flight_releases_the_transport_at_once(self) -> None:
        pool = _SlowPool()

        _owning(pool).close()

        assert pool.clears == 1

    async def test_bhv_lifecycle_036_a_second_close_does_nothing(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()
        client.close()
        pool.finish.set()
        await request
        client.close()

        assert pool.clears == 1

    async def test_bhv_lifecycle_035_a_closed_client_rejects_a_new_request_with_the_client_closed_error(self) -> None:
        pool = _SlowPool()
        client = _owning(pool)
        client.close()

        with pytest.raises(RuntimeError) as error:
            await _send(client)

        assert str(error.value) == 'ApiClient has been closed and can no longer send requests'
        assert pool.requests == 0

    async def test_bhv_lifecycle_009_a_pool_manager_the_caller_supplied_is_never_cleared(self) -> None:
        pool = _SlowPool()
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'), pool_manager=pool)
        request = asyncio.ensure_future(_send(client))
        await asyncio.to_thread(pool.started.wait, 5)

        client.close()
        client.close()
        pool.finish.set()
        await request

        assert pool.clears == 0

    def test_bhv_lifecycle_040_leaving_the_with_block_closes_the_client(self) -> None:
        pool = _SlowPool()

        with _owning(pool):
            assert pool.clears == 0

        assert pool.clears == 1


