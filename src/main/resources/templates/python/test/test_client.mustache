class _OwnedPool(urllib3.PoolManager):
    cleared = False

    def clear(self) -> None:
        self.cleared = True
        super().clear()


class TestClientPoolManager:
    def test_client_never_closes_a_supplied_pool_manager(self) -> None:
        pool = _OwnedPool()
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'), pool_manager=pool)

        client.close()

        assert pool.cleared is False

    def test_closed_client_rejects_further_requests(self) -> None:
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'))

        client.close()

        with pytest.raises(RuntimeError, match='closed'):
            client._api_client.send_request('GET', '{{{basePath}}}/x', {}, None)

    def test_supplied_pool_manager_stays_usable_after_close(self) -> None:
        pool = _OwnedPool()
        client = {{clientClassName}}(BearerAuthenticator('{{{basePath}}}', 'test-token'), pool_manager=pool)

        client.close()

        assert pool.cleared is False

    def test_with_token_accepts_a_pool_manager(self) -> None:
        pool = _OwnedPool()

        with {{clientClassName}}.with_token('{{{basePath}}}', 'test-token', pool_manager=pool):
            pass

        assert pool.cleared is False

    def test_supplied_pool_manager_conflicts_with_a_proxy(self) -> None:
        transport = TransportOptions.builder().proxy('http://proxy.example.com:3128').build()

        with pytest.raises(ValueError, match='pool_manager'):
            {{clientClassName}}(
                BearerAuthenticator('{{{basePath}}}', 'test-token'), transport, _OwnedPool()
            )
