def _authorization(client: {{clientClassName}}) -> str:
    api = client.{{#apiInfo}}{{#apis}}{{#-first}}{{#operations}}{{clientPropertyName}}{{/operations}}{{/-first}}{{/apis}}{{/apiInfo}}
    assert api._authenticator is not None
    return api._authenticator.get_auth_headers()['Authorization']


def _schemes(client: {{clientClassName}}) -> dict[str, Any]:
    api = client.{{#apiInfo}}{{#apis}}{{#-first}}{{#operations}}{{clientPropertyName}}{{/operations}}{{/-first}}{{/apis}}{{/apiInfo}}
    return dict(api._scheme_authenticators)


def _host(client: {{clientClassName}}) -> str:
    api = client.{{#apiInfo}}{{#apis}}{{#-first}}{{#operations}}{{clientPropertyName}}{{/operations}}{{/-first}}{{/apis}}{{/apiInfo}}
    return api._config.base_url


class TestClientCredentials:
    """F862: an argument wins, then the environment variable read once at construction."""

    def test_bhv_lifecycle_028_an_explicit_host_and_token_win_over_the_environment(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv('{{envPrefix}}_BASE_URL', 'https://env.example.com')
        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', 'env-token')

        client = {{clientClassName}}.with_token('https://arg.example.com', 'arg-token')

        assert _host(client) == 'https://arg.example.com'
        assert _authorization(client) == 'Bearer arg-token'

    def test_bhv_lifecycle_032_a_token_passed_to_the_client_is_preferred_to_the_environment(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', 'env-token')

        client = {{clientClassName}}.with_token('https://arg.example.com', 'arg-token')

        assert _authorization(client) == 'Bearer arg-token'

    def test_bhv_auth_024_the_environment_fills_what_was_not_passed(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv('{{envPrefix}}_BASE_URL', 'https://env.example.com')
        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', 'env-token')

        client = {{clientClassName}}.with_token()

        assert _host(client) == 'https://env.example.com'
        assert _authorization(client) == 'Bearer env-token'

    def test_bhv_lifecycle_014_the_environment_is_read_once_at_construction(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', 'first')
        client = {{clientClassName}}.with_token('https://arg.example.com')

        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', 'second')

        assert _authorization(client) == 'Bearer first'

    def test_bhv_authbearer_019_an_empty_environment_value_counts_as_unset(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv('{{envPrefix}}_ACCESS_TOKEN', '')

        with pytest.raises(ValueError, match='{{envPrefix}}_ACCESS_TOKEN'):
            {{clientClassName}}.with_token('https://arg.example.com')

    def test_bhv_lifecycle_013_a_missing_host_fails_when_the_client_is_built(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.delenv('{{envPrefix}}_BASE_URL', raising=False)

        with pytest.raises(ValueError, match='{{envPrefix}}_BASE_URL'):
            {{clientClassName}}.with_token(access_token='arg-token')

    def test_bhv_lifecycle_017_a_token_provider_runs_for_every_request(self) -> None:
        tokens = iter(['one', 'two'])
        client = {{clientClassName}}.with_token('https://arg.example.com', token_provider=lambda: next(tokens))

        assert _authorization(client) == 'Bearer one'
        assert _authorization(client) == 'Bearer two'

    def test_bhv_lifecycle_016_a_token_provider_needs_no_environment_token(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.delenv('{{envPrefix}}_ACCESS_TOKEN', raising=False)

        client = {{clientClassName}}.with_token('https://arg.example.com', token_provider=lambda: 'live')

        assert _authorization(client) == 'Bearer live'

    def test_a_token_and_a_token_provider_together_are_rejected(self) -> None:
        with pytest.raises(ValueError, match='not both'):
            {{clientClassName}}.with_token('https://arg.example.com', 'arg-token', token_provider=lambda: 'live')


