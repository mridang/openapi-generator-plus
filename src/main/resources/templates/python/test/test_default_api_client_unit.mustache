class _RecordingPool(urllib3.PoolManager):
    """A caller-owned pool manager that records what it is asked to do."""

    def __init__(self) -> None:
        super().__init__()
        self.requests: list[str] = []
        self.cleared = False

    def request(self, method: str, url: str, *args: Any, **kwargs: Any) -> Any:
        self.requests.append(url)
        return super().request(method, url, *args, **kwargs)

    def clear(self) -> None:
        self.cleared = True
        super().clear()


class TestInjectedPoolManager:
    """A caller-supplied urllib3 pool manager carries the requests, keeps every
    SDK default on top, is never closed by the SDK, and may not be combined
    with the SDK's own proxy or TLS settings."""

    server: HTTPServer
    base_url: str

    @classmethod
    def setup_class(cls) -> None:
        cls.server = HTTPServer(("127.0.0.1", 0), _EchoHandler)
        cls.base_url = f"http://127.0.0.1:{cls.server.server_address[1]}"
        Thread(target=cls.server.serve_forever, daemon=True).start()

    @classmethod
    def teardown_class(cls) -> None:
        cls.server.shutdown()

    def test_bhv_transport_092_the_supplied_pool_manager_receives_the_request(self) -> None:
        pool = _RecordingPool()
        client = DefaultApiClient(pool_manager=pool)

        response = client.send_request("GET", f"{self.base_url}/echo", {}, None)

        assert response.status_code == 200
        assert pool.requests == [f"{self.base_url}/echo"]

    def test_bhv_transport_040_sdk_defaults_still_apply_on_top_of_the_supplied_pool_manager(self) -> None:
        transport = TransportOptions.builder().user_agent("Injected/1.0").default_header("X-Default", "d").build()
        client = DefaultApiClient(transport, pool_manager=_RecordingPool())

        response = client.send_request("GET", f"{self.base_url}/echo", {}, None)

        headers = json.loads(response.body)["headers"]
        assert headers["user-agent"] == "Injected/1.0"
        assert headers["x-default"] == "d"

    def test_bhv_lifecycle_020_close_leaves_the_supplied_pool_manager_open(self) -> None:
        pool = _RecordingPool()
        client = DefaultApiClient(pool_manager=pool)

        client.close()

        assert pool.cleared is False

    def test_bhv_lang_python_080_close_clears_the_pool_manager_the_client_created(self) -> None:
        client = DefaultApiClient()
        pool = _RecordingPool()
        client._pool_manager = pool
        client._owns_pool = True

        client.close()

        assert pool.cleared is True

    @pytest.mark.parametrize(
        "transport",
        [
            TransportOptions.builder().proxy("http://proxy.example.com:3128").build(),
            TransportOptions.builder().verify_ssl(False).build(),
            TransportOptions.builder().ca_cert_path("/tmp/ca.pem").build(),
        ],
    )
    def test_bhv_lifecycle_024_a_supplied_pool_manager_conflicts_with_proxy_and_tls_settings(
        self, transport: TransportOptions
    ) -> None:
        with pytest.raises(ValueError, match="pool_manager"):
            DefaultApiClient(transport, pool_manager=_RecordingPool())


class TestRetryPolicy:
    """Which responses are retried and how long the wait before a retry is."""

    @pytest.mark.parametrize("status", [408, 409, 429, 500, 502, 503, 504, 599])
    def test_bhv_retries_021_these_statuses_are_retried(self, status: int) -> None:
        assert _is_retryable_status(status) is True

    @pytest.mark.parametrize("status", [200, 301, 400, 401, 403, 404, 422, 501, 600])
    def test_bhv_lang_python_081_these_statuses_are_not_retried(self, status: int) -> None:
        assert _is_retryable_status(status) is False

    @pytest.mark.parametrize(
        ("attempt", "expected"),
        [(0, 0.5), (1, 1.0), (2, 2.0), (3, 4.0), (4, 8.0), (5, 8.0), (40, 8.0)],
    )
    def test_bhv_retries_027_the_backoff_doubles_from_half_a_second_up_to_eight(
        self, attempt: int, expected: float
    ) -> None:
        assert _retry_delay(attempt, jitter=0.0) == expected

    def test_bhv_retries_030_the_jitter_takes_at_most_a_quarter_off_the_delay(self) -> None:
        assert _retry_delay(2, jitter=1.0) == 1.5
        assert 1.5 <= _retry_delay(2) <= 2.0

    def test_bhv_retries_041_the_backoff_starts_at_half_a_second_and_takes_up_to_a_quarter_off(self) -> None:
        assert [_retry_delay(attempt, jitter=0.0) for attempt in range(6)] == [0.5, 1.0, 2.0, 4.0, 8.0, 8.0]
        assert _retry_delay(0, jitter=1.0) == 0.375
        assert 0.375 <= _retry_delay(0) <= 0.5

    @pytest.mark.parametrize(
        ("header", "expected"),
        [("0", 0.0), ("3", 3.0), ("1.5", 1.5), (" 7 ", 7.0), ("120", 60.0)],
    )
    def test_bhv_retries_023_retry_after_seconds_replaces_the_backoff_and_is_capped_at_a_minute(
        self, header: str, expected: float
    ) -> None:
        assert _retry_delay(0, header, jitter=0.0) == expected

    def test_bhv_retries_022_retry_after_as_an_http_date_is_the_time_until_then(self) -> None:
        assert _retry_delay(0, formatdate(1005, usegmt=True), now=1000.0) == 5.0
        assert _retry_delay(0, formatdate(1000 + 3600, usegmt=True), now=1000.0) == 60.0

    def test_bhv_lang_python_082_retry_after_in_the_past_means_no_wait(self) -> None:
        assert _retry_delay(0, formatdate(900, usegmt=True), now=1000.0) == 0.0

    @pytest.mark.parametrize("header", ["", "soon", "-5", "nan", "inf"])
    def test_bhv_retries_029_an_unusable_retry_after_falls_back_to_the_backoff(self, header: str) -> None:
        assert _retry_delay(1, header, jitter=0.0) == 1.0

    def test_bhv_lang_python_083_an_exhausted_deadline_times_out_without_sending(self) -> None:
        class _Pool:
            def request(self, *args: Any, **kwargs: Any) -> Any:
                raise AssertionError("no request may be sent")

        client = DefaultApiClient(pool_manager=_Pool())

        from {{packageName}}.errors import NetworkTimeoutException

        with pytest.raises(NetworkTimeoutException):
            client.send_request(
                "GET", "https://example.com/x", {}, None, deadline=time.monotonic() - 1
            )

    def test_bhv_transport_028_a_per_call_deadline_replaces_the_configured_timeout(self) -> None:
        class _Pool:
            def __init__(self) -> None:
                self.timeout: Any = None

            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.timeout = kwargs["timeout"]
                return _FakeResp(200, {})

        pool = _Pool()
        client = DefaultApiClient(
            TransportOptions.builder().timeout(600000).build(), pool_manager=pool
        )

        client.send_request(
            "GET", "https://example.com/x", {}, None, deadline=time.monotonic() + 5
        )

        assert 0 < pool.timeout.total <= 5


