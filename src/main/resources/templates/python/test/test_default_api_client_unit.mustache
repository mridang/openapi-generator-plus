class TestZstdDecompression:
    """A zstd frame written by a streaming encoder carries no content size, so
    the decoder must not derive an output cap from the compressed length."""

    @staticmethod
    def _stream_compress(payload: bytes) -> bytes:
        import zstandard

        compressor = zstandard.ZstdCompressor().compressobj()
        return compressor.compress(payload) + compressor.flush()

