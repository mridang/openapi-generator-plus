class TestDeadlineAndCancellationClassification:
    def test_bhv_transport_071_one_configured_timeout_is_the_budget_for_connect_and_read_alike(self) -> None:
        class _Pool:
            def __init__(self) -> None:
                self.timeout: Any = None

            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.timeout = kwargs["timeout"]
                return _FakeResp(200, {})

        pool = _Pool()
        client = DefaultApiClient(
            TransportOptions.builder().timeout(2000).build(), pool_manager=pool
        )

        client.send_request("GET", "https://example.com/x", {}, None)

        # One urllib3 Timeout carries the configured budget as its overall
        # total and as the connect phase, so neither phase outlives it.
        assert pool.timeout.total == 2.0
        assert pool.timeout.connect_timeout == 2.0

    def test_bhv_transport_068_a_call_with_an_already_cancelled_handle_sends_nothing(self) -> None:
        from {{packageName}}.default_api_client import RequestHandle

        class _Pool:
            def request(self, *args: Any, **kwargs: Any) -> Any:
                raise AssertionError("no request may be sent")

        handle = RequestHandle()
        handle.cancel()
        client = DefaultApiClient(pool_manager=_Pool())

        with pytest.raises(RuntimeError, match='cancelled'):
            client.send_request('GET', 'https://example.com/x', {}, None, handle=handle)

    def test_bhv_transport_072_a_connect_timeout_raises_the_timeout_error(self) -> None:
        from {{packageName}}.errors import NetworkTimeoutException

        class _Pool:
            def request(self, *args: Any, **kwargs: Any) -> Any:
                raise urllib3.exceptions.ConnectTimeoutError(None, 'connect timed out')

        with pytest.raises(NetworkTimeoutException):
            DefaultApiClient(pool_manager=_Pool()).send_request('GET', 'https://example.com/x', {}, None)

    def test_bhv_lang_python_084_an_unrelated_connection_failure_is_not_a_timeout(self) -> None:
        from {{packageName}}.errors import NetworkException, NetworkTimeoutException

        class _Pool:
            def request(self, *args: Any, **kwargs: Any) -> Any:
                raise urllib3.exceptions.NewConnectionError(None, 'connection refused')

        with pytest.raises(NetworkException) as excinfo:
            DefaultApiClient(pool_manager=_Pool()).send_request('GET', 'https://example.com/x', {}, None)

        assert not isinstance(excinfo.value, NetworkTimeoutException)
