class _EncodingHandler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        import zlib

        payload = b'{"ok":true}'
        if self.path == "/deflate":
            body = zlib.compress(payload)
            encoding = "deflate"
        elif self.path == "/raw-deflate":
            compressor = zlib.compressobj(wbits=-15)
            body = compressor.compress(payload) + compressor.flush()
            encoding = "deflate"
        elif self.path == "/truncated-gzip":
            body = gzip.compress(payload)[:-8]
            encoding = "gzip"
        elif self.path == "/brotli":
            body = payload
            encoding = "br"
        else:
            body = self.headers.get("Accept-Encoding", "").encode()
            encoding = "identity"
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Encoding", encoding)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: Any) -> None:
        pass


