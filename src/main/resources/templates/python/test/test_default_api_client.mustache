class TestRedirectSecurityGuards:
    """Bucket 4.1: the three guards the urllib3.Retry path missed.

    These exercise the manual redirect loop in DefaultApiClient.
    """

    def test_bhv_redirects_053_strips_authorization_on_https_to_http_downgrade(self) -> None:
        """Guard 2: an HTTPS -> HTTP redirect is a TLS downgrade and
        MUST strip Authorization / Cookie before re-issuing. Same host
        is not enough: the scheme change is the threat."""

        class _FakeResp:
            def __init__(self, status: int, headers: dict[str, Any]) -> None:
                self.status = status
                self.headers = headers
            def read(self) -> bytes:
                return b''
            def release_conn(self) -> None:
                return None

        class _FakePool:

            headers = HTTPHeaderDict()

            def __init__(self) -> None:
                self.calls: list[Any] = []
            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.calls.append((method, url, dict(kwargs.get('headers') or {})))
                if len(self.calls) == 1:
                    return _FakeResp(302, {'location': 'http://example.com/insecure'})
                return _FakeResp(200, {})

        transport = TransportOptions.builder().follow_redirects(True).build()
        pool = _FakePool()
        client = DefaultApiClient(transport, pool_manager=pool)
        headers = {'Authorization': 'Bearer secret', 'Cookie': 'sid=abc'}
        client.send_request('GET', 'https://example.com/start', headers, None)
        assert len(pool.calls) == 2
        followup_headers = pool.calls[1][2]
        # Sensitive headers must be gone on the downgraded follow-up.
        assert not any(k.lower() == 'authorization' for k in followup_headers)
        assert not any(k.lower() == 'cookie' for k in followup_headers)

    def test_bhv_redirects_052_a_cross_origin_redirect_removes_the_credential_headers(self) -> None:
        class _FakeResp:
            def __init__(self, status: int, headers: dict[str, Any]) -> None:
                self.status = status
                self.headers = headers
            def read(self) -> bytes:
                return b''
            def release_conn(self) -> None:
                return None

        class _FakePool:

            headers = HTTPHeaderDict()

            def __init__(self) -> None:
                self.calls: list[Any] = []
            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.calls.append((method, url, dict(kwargs.get('headers') or {})))
                if len(self.calls) == 1:
                    return _FakeResp(302, {'location': 'https://other.example.org/next'})
                return _FakeResp(200, {})

        transport = TransportOptions.builder().follow_redirects(True).build()
        pool = _FakePool()
        client = DefaultApiClient(transport, pool_manager=pool)
        headers = {'Authorization': 'Bearer secret', 'Cookie': 'sid=abc', 'X-Custom-Auth-Key': 'k'}
        client.send_request('GET', 'https://example.com/start', headers, None)
        assert len(pool.calls) == 2
        followup = {k.lower() for k in pool.calls[1][2]}
        assert 'authorization' not in followup
        assert 'cookie' not in followup
        assert 'x-custom-auth-key' not in followup

    def test_bhv_lang_python_060_strips_credential_named_headers_on_a_cross_origin_hop(self) -> None:
        """A default or authenticator header named like a credential
        (X-Tenant-Token, X-Custom-Auth-Key) is not forwarded to another origin."""

        class _FakeResp:
            def __init__(self, status: int, headers: dict[str, Any]) -> None:
                self.status = status
                self.headers = headers
            def read(self) -> bytes:
                return b''
            def release_conn(self) -> None:
                return None

        class _FakePool:

            headers = HTTPHeaderDict()

            def __init__(self) -> None:
                self.calls: list[Any] = []
            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.calls.append((method, url, dict(kwargs.get('headers') or {})))
                if len(self.calls) == 1:
                    return _FakeResp(302, {'location': 'https://other.example.org/next'})
                return _FakeResp(200, {})

        transport = TransportOptions.builder().follow_redirects(True).build()
        pool = _FakePool()
        client = DefaultApiClient(transport, pool_manager=pool)
        headers = {'X-Tenant-Token': 't', 'X-Custom-Auth-Key': 'k', 'X-Trace': 'keep'}
        client.send_request('GET', 'https://example.com/start', headers, None)
        followup = {k.lower(): v for k, v in pool.calls[1][2].items()}
        assert 'x-tenant-token' not in followup
        assert 'x-custom-auth-key' not in followup
        assert followup['x-trace'] == 'keep'

    def test_bhv_redirects_044_cross_origin_redirect_leaves_proxy_authorization_on_the_pool_manager(self) -> None:
        """The pool manager's proxy_headers authenticate the client to its
        proxy and are shared by every concurrent request, so a cross-origin
        redirect must never remove them, not even for the duration of the
        follow-up."""

        class _FakeResp:
            def __init__(self, status: int, headers: dict[str, Any]) -> None:
                self.status = status
                self.headers = headers
            def read(self) -> bytes:
                return b''
            def release_conn(self) -> None:
                return None

        observed_proxy_headers_on_followup: dict[str, str] = {}

        class _FakePool:

            headers = HTTPHeaderDict()

            def __init__(self) -> None:
                self.proxy_headers: dict[str, str] = {'Proxy-Authorization': 'Basic dXNlcjpwYXNz'}
                self.calls: list[Any] = []
            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.calls.append((method, url))
                if len(self.calls) == 1:
                    return _FakeResp(302, {'location': 'https://other.example.com/dest'})
                observed_proxy_headers_on_followup.update(self.proxy_headers)
                return _FakeResp(200, {})

        transport = TransportOptions.builder().follow_redirects(True).build()
        pool = _FakePool()
        client = DefaultApiClient(transport, pool_manager=pool)
        client.send_request('GET', 'https://example.com/start', {}, None)
        assert len(pool.calls) == 2
        # During the cross-origin follow-up, Proxy-Authorization is still present.
        assert observed_proxy_headers_on_followup == {'Proxy-Authorization': 'Basic dXNlcjpwYXNz'}
        assert pool.proxy_headers == {'Proxy-Authorization': 'Basic dXNlcjpwYXNz'}


class TestN1RedirectBodyReplayMatrix:
    """N1 (canonical scenario, AUDIT.md): on an HTTPS -> HTTP downgrade the
    body-replay guard must key on the redirect status, not refuse every
    status. A 302 carrying a body PROCEEDS (the request becomes GET and the
    body is dropped per RFC 7231 section 6.4), while a 307/308 carrying a
    body THROWS (those statuses preserve method+body, so replaying over
    plaintext would leak it). Node guarded every status and threw on 302
    too; 11 SDKs guard only 307/308. This locks the 307/308-only behaviour.
    """

    class _FakeResp:
        def __init__(self, status: int, headers: dict[str, Any]) -> None:
            self.status = status
            self.headers = headers
        def read(self) -> bytes:
            return b''
        def release_conn(self) -> None:
            return None

    def _pool(self, first_status: int) -> Any:
        outer = self

        class _Pool:

            headers = HTTPHeaderDict()

            def __init__(self) -> None:
                self.calls: list[Any] = []
            def request(self, method: str, url: str, **kwargs: Any) -> Any:
                self.calls.append((method, url, kwargs.get('body')))
                if len(self.calls) == 1:
                    return outer._FakeResp(
                        first_status, {'location': 'http://example.com/insecure'}
                    )
                return outer._FakeResp(200, {})

        return _Pool()

    def test_bhv_redirects_001_https_to_http_302_with_body_is_refused(self) -> None:
        # A body must never be replayed in plain text: a 302 HTTPS -> HTTP hop
        # that would carry the body is refused, and the call fails.
        transport = TransportOptions.builder().follow_redirects(True).build()
        pool = self._pool(302)
        client = DefaultApiClient(transport, pool_manager=pool)
        with pytest.raises(ApiException, match='Refusing to replay request body across HTTPS->HTTP redirect'):
            client.send_request(
                'POST',
                'https://example.com/secure',
                {'Content-Type': 'application/json'},
                '{"secret":"value"}',
            )
        assert len(pool.calls) == 1

    def test_bhv_redirects_029_a_301_or_302_keeps_the_method_and_body_of_put_patch_and_delete(self) -> None:
        for status in (301, 302):
            for method in ('PUT', 'PATCH', 'DELETE'):
                transport = TransportOptions.builder().follow_redirects(True).build()
                pool = self._pool(status)
                client = DefaultApiClient(transport, pool_manager=pool)
                client.send_request(method, 'http://example.com/start', {}, '{"a":1}')
                assert pool.calls[1][0] == method
                assert pool.calls[1][2] in ('{"a":1}', b'{"a":1}')

    def test_bhv_redirects_048_status_301_and_302_turn_post_into_get(self) -> None:
        for status in (301, 302):
            transport = TransportOptions.builder().follow_redirects(True).build()
            pool = self._pool(status)
            client = DefaultApiClient(transport, pool_manager=pool)
            client.send_request('POST', 'http://example.com/start', {}, '{"a":1}')
            assert pool.calls[1][0] == 'GET'
            assert pool.calls[1][2] is None

    def test_bhv_redirects_049_a_307_or_308_repeats_the_method_and_body_and_is_followed_by_default(self) -> None:
        for status in (307, 308):
            transport = TransportOptions.builder().build()
            pool = self._pool(status)
            client = DefaultApiClient(transport, pool_manager=pool)
            client.send_request('POST', 'http://example.com/start', {}, '{"a":1}')
            assert pool.calls[1][0] == 'POST'
            assert pool.calls[1][2] in ('{"a":1}', b'{"a":1}')

    def test_bhv_redirects_050_each_redirect_status_gives_the_rfc_9110_follow_up_method_and_body(self) -> None:
        rows = [(301, 'GET', None), (302, 'GET', None), (303, 'GET', None),
                (307, 'POST', '{"a":1}'), (308, 'POST', '{"a":1}')]
        for status, method, body in rows:
            transport = TransportOptions.builder().follow_redirects(True).build()
            pool = self._pool(status)
            client = DefaultApiClient(transport, pool_manager=pool)
            client.send_request('POST', 'http://example.com/start', {}, '{"a":1}')
            assert pool.calls[1][0] == method
            if body is None:
                assert pool.calls[1][2] is None
            else:
                assert pool.calls[1][2] in (body, body.encode())

    def test_bhv_redirects_055_a_redirect_to_a_non_http_scheme_is_refused_with_an_error(self) -> None:
        from {{packageName}}.errors import ApiException

        resp_cls = self._FakeResp

        class _Pool:

