class TestCancellation:
    """Cancelling an in-flight request really aborts it: the connection is
    dropped instead of the call running on in a worker thread."""

    async def test_bhv_transport_060_cancelling_the_task_aborts_the_request(self, chasm_http_url: Any) -> None:
        client = DefaultApiClient(TransportOptions.builder().timeout(20000).build())
        api = BaseApi(api_client=client, config=Configuration(base_url=chasm_http_url))
        task = asyncio.ensure_future(
            api._invoke_api('GET', '/test/slow', {}, {}, None, ['application/json'], 'application/json', None)
        )
        await asyncio.sleep(0.5)
        assert len(client._inflight) == 1

        task.cancel()
        with pytest.raises(asyncio.CancelledError):
            await task

        # The slow endpoint answers after 5 seconds; the worker is gone long before.
        deadline = time.monotonic() + 2
        while client._inflight and time.monotonic() < deadline:
            await asyncio.sleep(0.05)
        assert client._inflight == set()

    async def test_bhv_transport_084_a_request_cancelled_through_its_handle_ends_at_once(self, chasm_http_url: Any) -> None:
        from {{packageName}}.default_api_client import RequestHandle

        client = DefaultApiClient(TransportOptions.builder().timeout(20000).build())
        handle = RequestHandle()
        task = asyncio.ensure_future(
            asyncio.to_thread(
                client.send_request, 'GET', chasm_http_url + '/test/slow', {}, None, False, handle
            )
        )
        await asyncio.sleep(0.5)

        started = time.monotonic()
        handle.cancel()
        with pytest.raises(RuntimeError, match='cancelled'):
            await task

        assert time.monotonic() - started < 2


    async def test_bhv_misc_035_a_call_whose_handle_is_already_cancelled_is_rejected_as_cancelled_not_a_timeout(
        self, chasm_http_url: Any
    ) -> None:
        from {{packageName}}.default_api_client import RequestHandle
        from {{packageName}}.errors import NetworkTimeoutException

        client = DefaultApiClient(TransportOptions.builder().timeout(20000).build())
        handle = RequestHandle()
        handle.cancel()

        with pytest.raises(RuntimeError, match='cancelled') as excinfo:
            client.send_request('GET', chasm_http_url + '/test/echo', {}, None, False, handle)

        assert not isinstance(excinfo.value, NetworkTimeoutException)

class TestSuppliedPoolManager:
    def test_bhv_options_058_a_supplied_pool_manager_is_kept_as_the_same_instance(self) -> None:
        import urllib3

        pool = urllib3.PoolManager()
        assert DefaultApiClient()._pool_manager is not pool
        assert DefaultApiClient(pool_manager=pool)._pool_manager is pool

    def test_bhv_misc_186_a_ca_bundle_beside_a_supplied_pool_manager_is_rejected(self) -> None:
        import urllib3

        with pytest.raises(ValueError, match='ca_cert_path'):
            DefaultApiClient(
                TransportOptions.builder().ca_cert_path('/does/not/matter.pem').build(),
                pool_manager=urllib3.PoolManager(),
            )

