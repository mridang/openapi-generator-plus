from typing import Any, cast
import base64
import dataclasses
import json
from unittest.mock import MagicMock

import pytest

from {{packageName}}.auth.oauth.client_auth_method import ClientAuthMethod
from {{packageName}}.auth.oauth.oauth2_password_authenticator import OAuth2PasswordAuthenticator
from {{packageName}}.api_http_response import ApiHttpResponse


def _create_authenticator() -> OAuth2PasswordAuthenticator:
    return OAuth2PasswordAuthenticator(
        host='https://api.example.com',
        client_id='my_client_id',
        client_secret='my_client_secret',
        token_url='https://auth.example.com/token',
        username='testuser',
        password='testpass',
        scopes=['read', 'write'],
    )


def _create_authenticator_with_mock() -> tuple[OAuth2PasswordAuthenticator, MagicMock]:
    auth = _create_authenticator()
    mock_client = MagicMock()
    mock_client.send_request.return_value = ApiHttpResponse(
        status_code=200,
        body=json.dumps({
            'access_token': 'pw_token',
            'expires_in': 3600,
        }),
        headers={'content-type': 'application/json'},
    )
    auth.set_api_client(mock_client)
    return auth, mock_client


class TestOAuth2PasswordAuthenticator:

    def test_sends_password_grant_type(self) -> None:
        auth, mock_client = _create_authenticator_with_mock()

        auth.get_auth_headers()

        call_args = mock_client.send_request.call_args
        body = call_args[0][3]
        assert 'grant_type=password' in body

    def test_sends_username_and_password(self) -> None:
        auth, mock_client = _create_authenticator_with_mock()

        auth.get_auth_headers()

        call_args = mock_client.send_request.call_args
        body = call_args[0][3]
        assert 'username=testuser' in body
        assert 'password=testpass' in body

    def test_sends_client_id_and_secret(self) -> None:
        auth, mock_client = _create_authenticator_with_mock()

        auth.get_auth_headers()

        call_args = mock_client.send_request.call_args
        body = call_args[0][3]
        assert 'client_id=my_client_id' in body
        assert 'client_secret=my_client_secret' in body

    def test_returns_authorization_bearer_header(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.return_value = ApiHttpResponse(
            status_code=200,
            body=json.dumps({
                'access_token': 'tok-pwd',
                'expires_in': 3600,
            }),
            headers={'content-type': 'application/json'},
        )
        auth.set_api_client(mock_client)

        headers = auth.get_auth_headers()

        assert headers['Authorization'] == 'Bearer tok-pwd'

    def test_uses_refresh_token_on_subsequent_calls(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            ApiHttpResponse(
                status_code=200,
                body=json.dumps({
                    'access_token': 'tok1',
                    'refresh_token': 'ref1',
                    'expires_in': 0,
                }),
                headers={'content-type': 'application/json'},
            ),
            ApiHttpResponse(
                status_code=200,
                body=json.dumps({
                    'access_token': 'tok2',
                    'expires_in': 3600,
                }),
                headers={'content-type': 'application/json'},
            ),
        ]
        auth.set_api_client(mock_client)

        # First call uses password grant
        auth.get_auth_headers()
        # Second call should use refresh_token grant since token is expired
        auth.get_auth_headers()

        second_call = mock_client.send_request.call_args
        body = second_call[0][3]
        assert 'grant_type=refresh_token' in body
        assert 'refresh_token=ref1' in body

    def test_get_host_returns_configured_host(self) -> None:
        auth = _create_authenticator()

        assert auth.get_host() == 'https://api.example.com'

    def test_basic_auth_url_encodes_client_id_and_secret(self) -> None:
        # Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
        # client_id and client_secret MUST be application/x-www-form-
        # urlencoded BEFORE being joined with ':' and base64-encoded.
        auth = OAuth2PasswordAuthenticator(
            host='https://api.example.com',
            client_id='id+with/special',
            client_secret='secret&with=stuff',
            token_url='https://auth.example.com/token',
            username='testuser',
            password='testpass',
            scopes=['read'],
            client_auth_method=ClientAuthMethod.BASIC,
        )
        mock_client = MagicMock()
        mock_client.send_request.return_value = ApiHttpResponse(
            status_code=200,
            body=json.dumps({'access_token': 'at', 'expires_in': 3600}),
            headers={'content-type': 'application/json'},
        )
        auth.set_api_client(mock_client)

        auth.get_auth_headers()

        call_args = mock_client.send_request.call_args
        headers = call_args[0][2]
        auth_header = headers['Authorization']
        assert auth_header.startswith('Basic ')
        decoded = base64.b64decode(auth_header[len('Basic '):]).decode('utf-8')
        assert decoded == 'id%2Bwith%2Fspecial:secret%26with%3Dstuff'


    def test_redacts_secret(self) -> None:
        """The repr masks both client_secret and password and leaks neither."""
        auth = _create_authenticator()
        rendered = repr(auth)
        assert 'my_client_secret' not in rendered
        assert 'testpass' not in rendered
        assert '***' in rendered


class TestOAuth2PasswordRequiredConfiguration:
    def test_omitting_the_token_url_username_and_password_raises(self) -> None:
        with pytest.raises(TypeError) as exc_info:
            cast(Any, OAuth2PasswordAuthenticator)(
                'https://api.example.com', 'my_client_id', 'my_client_secret'
            )
        assert str(exc_info.value).endswith(
            "missing 3 required positional arguments: 'token_url', 'username', and 'password'"
        )

    def test_omitting_only_the_password_raises(self) -> None:
        with pytest.raises(TypeError) as exc_info:
            cast(Any, OAuth2PasswordAuthenticator)(
                'https://api.example.com',
                'my_client_id',
                'my_client_secret',
                'https://auth.example.com/token',
                'testuser',
            )
        assert str(exc_info.value).endswith(
            "missing 1 required positional argument: 'password'"
        )


class TestOAuth2PasswordImmutability:
    def test_credentials_cannot_be_reassigned(self) -> None:
        auth = _create_authenticator()

        with pytest.raises(dataclasses.FrozenInstanceError):
            cast(Any, auth).password = 'rotated'
        with pytest.raises(dataclasses.FrozenInstanceError):
            cast(Any, auth).username = 'mallory'
        with pytest.raises(dataclasses.FrozenInstanceError):
            cast(Any, auth).client_secret = 'rotated'

    def test_equal_credentials_are_not_equal_by_value(self) -> None:
        first = _create_authenticator()
        second = _create_authenticator()

        assert first != second
        assert first == first
        assert len({first, second}) == 2


def _token_reply(**fields: object) -> ApiHttpResponse:
    return ApiHttpResponse(
        status_code=200,
        body=json.dumps(fields),
        headers={"content-type": "application/json"},
    )


class TestPasswordRefreshUrlRouting:
    @staticmethod
    def _urls_of_two_calls(refresh_url: Any) -> list[str]:
        auth = OAuth2PasswordAuthenticator(
            host="https://api.example.com",
            client_id="my_client_id",
            client_secret="my_client_secret",
            token_url="https://auth.example.com/token",
            username="testuser",
            password="testpass",
            scopes=["read"],
            refresh_url=refresh_url,
        )
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _token_reply(access_token="t1", refresh_token="r1", expires_in=0),
            _token_reply(access_token="t2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)

        auth.get_auth_headers()
        auth.get_auth_headers()

        return [call[0][1] for call in mock_client.send_request.call_args_list]

    def test_first_grant_goes_to_the_token_url_and_the_refresh_to_the_refresh_url(
        self,
    ) -> None:
        assert self._urls_of_two_calls("https://auth.example.com/oauth/refresh") == [
            "https://auth.example.com/token",
            "https://auth.example.com/oauth/refresh",
        ]

    def test_refresh_falls_back_to_the_token_url_without_a_refresh_url(self) -> None:
        assert self._urls_of_two_calls(None) == [
            "https://auth.example.com/token",
            "https://auth.example.com/token",
        ]


class TestPasswordWireEncoding:
    def test_body_keeps_unreserved_marks_and_encodes_the_sub_delimiters(self) -> None:
        auth = OAuth2PasswordAuthenticator(
            host="https://api.example.com",
            client_id="id~*",
            client_secret="s!'()",
            token_url="https://auth.example.com/token",
            username="u~*",
            password="p(w)",
            scopes=["read", "a*b"],
        )
        mock_client = MagicMock()
        mock_client.send_request.return_value = _token_reply(
            access_token="at", expires_in=3600
        )
        auth.set_api_client(mock_client)

        auth.get_auth_headers()

        assert mock_client.send_request.call_args[0][3] == (
            "grant_type=password&username=u~%2A&password=p%28w%29"
            "&client_id=id~%2A&client_secret=s%21%27%28%29&scope=read+a%2Ab"
        )

    def test_basic_header_keeps_unreserved_marks_and_encodes_the_sub_delimiters(
        self,
    ) -> None:
        auth = OAuth2PasswordAuthenticator(
            host="https://api.example.com",
            client_id="id~*!'()",
            client_secret="s-._~(x)",
            token_url="https://auth.example.com/token",
            username="testuser",
            password="testpass",
            client_auth_method=ClientAuthMethod.BASIC,
        )
        mock_client = MagicMock()
        mock_client.send_request.return_value = _token_reply(
            access_token="at", expires_in=3600
        )
        auth.set_api_client(mock_client)

        auth.get_auth_headers()

        header = mock_client.send_request.call_args[0][2]["Authorization"]
        assert base64.b64decode(header[len("Basic ") :]).decode("utf-8") == (
            "id~%2A%21%27%28%29:s-._~%28x%29"
        )


class TestLegacyAuthWrapper:
    def test_routes_the_grants_to_the_spec_urls_and_requests_the_spec_scope(
        self,
    ) -> None:
        from {{packageName}}.auth.oauth.legacy_auth_password_authenticator import (
            LegacyAuthPasswordAuthenticator,
        )

        auth = LegacyAuthPasswordAuthenticator(
            "https://api.example.com", "cid", "sec", "alice", "pw"
        )
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _token_reply(access_token="t1", refresh_token="r1", expires_in=0),
            _token_reply(access_token="t2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)

        auth.get_auth_headers()
        auth.get_auth_headers()

        first, second = mock_client.send_request.call_args_list
        assert first[0][1] == "https://auth.example.com/oauth/token"
        assert first[0][3] == (
            "grant_type=password&username=alice&password=pw"
            "&client_id=cid&client_secret=sec&scope=read"
        )
        assert second[0][1] == "https://auth.example.com/oauth/refresh"
        assert second[0][3].startswith("grant_type=refresh_token&refresh_token=r1")


class TestPasswordRedactedRepr:
    def test_repr_lists_the_non_secret_fields_and_masks_both_secrets(self) -> None:
        assert repr(_create_authenticator()) == (
            "OAuth2PasswordAuthenticator(host='https://api.example.com', "
            "client_id='my_client_id', client_secret='***', "
            "token_url='https://auth.example.com/token', username='testuser', "
            "password='***', scopes=('read', 'write'), refresh_url=None, "
            f"client_auth_method={ClientAuthMethod.BODY!r})"
        )
