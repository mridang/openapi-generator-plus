class TestMetadataTypedAdditionalProperties:

    def test_bhv_models_008_serialize_empty_metadata(self) -> None:
        from {{packageName}}.models import Metadata
        metadata = Metadata()
        result = ObjectSerializer().serialize(metadata)
        assert result is not None

    def test_bhv_models_003_an_empty_object_deserializes_into_a_model_with_no_values(self) -> None:
        metadata = ObjectSerializer().deserialize('{}', 'Metadata')
        assert metadata is not None

    def test_bhv_models_004_deserializes_known_properties(self) -> None:
        json_str = '{"createdAt":"2024-01-01T00:00:00Z"}'
        metadata = ObjectSerializer().deserialize(json_str, 'Metadata')
        assert metadata is not None
        assert metadata.created_at is not None

    def test_bhv_models_011_round_trip_preserves_known_properties(self) -> None:
        json_str = '{"createdAt":"2024-01-15T10:30:00Z"}'
        metadata = ObjectSerializer().deserialize(json_str, 'Metadata')
        assert metadata is not None
        serialized = ObjectSerializer().serialize(metadata)
        data = json.loads(serialized)
        assert data.get('createdAt') is not None

    def test_bhv_misc_093_numeric_additional_property_names_are_written_as_object_members(self) -> None:
        metadata = ObjectSerializer().deserialize('{"404":"missing","7":"seven"}', 'Metadata')
        assert metadata is not None
        data = json.loads(ObjectSerializer().serialize(metadata))
        assert data['404'] == 'missing'
        assert data['7'] == 'seven'

    def test_bhv_models_009_additional_properties_are_a_string_keyed_map_of_the_value_type(self) -> None:
        metadata = ObjectSerializer().deserialize('{"customField":"hello"}', 'Metadata')
        assert metadata is not None
        assert isinstance(metadata.additional_properties, dict)
        assert isinstance(metadata.additional_properties['customField'], str)

    def test_bhv_models_025_an_additional_property_of_the_wrong_json_type_fails_the_decode(self) -> None:
        for body in ('{"a":2.5}', '{"a":"2"}'):
            with pytest.raises(SerializationException):
                ObjectSerializer().deserialize(body, 'Counters')
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":3}', 'Metadata')

    def test_bhv_models_026_additional_properties_decode_to_their_model_and_undeclared_keys_survive(self) -> None:
        import json

        from {{packageName}}.models import Category
        roster = ObjectSerializer().deserialize('{"label":"l","a":{"id":1,"name":"x"}}', 'Roster')
        assert roster is not None
        assert isinstance(roster.additional_properties['a'], Category)
        assert roster.additional_properties['a'].id == 1
        assert roster.additional_properties['a'].name == 'x'
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":{"id":"x"}}', 'Roster')

        metadata = ObjectSerializer().deserialize('{"createdAt":"2024-01-01T00:00:00Z","region":"eu"}', 'Metadata')
        wire = json.loads(ObjectSerializer().serialize(metadata))
        assert wire['region'] == 'eu'

    def test_bhv_models_027_a_null_additional_property_is_rejected_unless_the_value_schema_is_nullable(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":null}', 'Counters')
        sparse = ObjectSerializer().deserialize('{"a":null}', 'Sparse')
        assert sparse is not None
        assert sparse.additional_properties == {'a': None}

    def test_bhv_models_028_a_typed_additional_property_is_written_flat_in_its_wire_form(self) -> None:
        from {{packageName}}.models import Blobs, Moments
        moments = ObjectSerializer().deserialize('{"label":"l","at":"2024-01-01T00:00:00Z"}', 'Moments')
        assert moments is not None
        assert isinstance(moments.additional_properties['at'], datetime.datetime)
        data = json.loads(ObjectSerializer().serialize(moments))
        assert list(data) == ['label', 'at']
        assert data['at'].startswith('2024-01-01T00:00:00')
        assert ObjectSerializer().deserialize(json.dumps(data), 'Moments') == moments
        blobs = ObjectSerializer().deserialize('{"b":"aGk="}', 'Blobs')
        assert blobs is not None
        assert blobs.additional_properties['b'] == b'hi'
        assert json.loads(ObjectSerializer().serialize(Blobs(additional_properties={'b': b'hi'}))) == {'b': 'aGk='}

    def test_bhv_models_029_a_free_form_additional_properties_keeps_every_json_value_as_it_arrives(self) -> None:
        freeform = ObjectSerializer().deserialize('{"a":1,"b":"x","c":[true],"d":null}', 'Freeform')
        assert freeform is not None
        assert freeform.additional_properties == {'a': 1, 'b': 'x', 'c': [True], 'd': None}

    def test_bhv_models_023_wire_key_named_additional_properties_with_dict_value_preserved(self) -> None:
        # M11 — a real wire property literally named `additional_properties`
        # whose value is itself a dict must NOT be mistaken for the internal
        # capture bucket and dropped. The internal bucket is distinguished by
        # the call PATH (declared field / field-name kwargs), not by the value
        # being a dict. A wire payload addresses `createdAt` by its alias, so
        # the `additional_properties` entry here is a genuine wire property and
        # survives the round trip under its real name.
        from {{packageName}}.models import Metadata
        wire = {
            'createdAt': '2024-01-01T00:00:00Z',
            'additional_properties': 'bar',
        }
        metadata = Metadata.model_validate(wire)
        assert metadata.additional_properties == {
            'additional_properties': 'bar',
        }

    def test_bhv_misc_287_wire_key_named_additional_properties_alongside_other_extras(self) -> None:
        # The string-valued `additional_properties` wire key coexists with other
        # genuine extras; none are lost.
        from {{packageName}}.models import Metadata
        wire = {
            'createdAt': '2024-01-01T00:00:00Z',
            'additional_properties': 'bar',
            'region': 'eu',
        }
        metadata = Metadata.model_validate(wire)
        assert metadata.additional_properties['additional_properties'] == 'bar'
        assert metadata.additional_properties['region'] == 'eu'

    def test_bhv_lang_python_086_field_name_kwargs_bucket_is_spread_not_nested(self) -> None:
        # The internal bucket on the field-name path (direct kwargs) is spread
        # into `additional_properties`, never re-nested under itself.
        from {{packageName}}.models import Metadata
        metadata = Metadata(additional_properties={'k': 'v'})
        assert metadata.additional_properties == {'k': 'v'}

    def test_bhv_misc_290_dict_valued_wire_key_survives_full_round_trip(self) -> None:
        # End-to-end: deserialize -> serialize -> deserialize keeps the
        # string-valued `additional_properties` wire property intact. The
        # deserializing convenience method is wrapped so an unexpected
        # SerializationException surfaces as a clear test failure.
        try:
            wire = (
                '{"createdAt":"2024-01-01T00:00:00Z",'
                '"additional_properties":"bar"}'
            )
            metadata = ObjectSerializer().deserialize(wire, 'Metadata')
            assert metadata is not None
            restored = ObjectSerializer().deserialize(
                ObjectSerializer().serialize(metadata), 'Metadata'
            )
        except Exception as exc:  # pragma: no cover - defensive surface
            pytest.fail(f'round-trip raised unexpectedly: {exc}')
        assert restored.additional_properties['additional_properties'] == 'bar'

    def test_bhv_models_001_undeclared_wire_keys_are_captured_into_additional_properties(self) -> None:
        from {{packageName}}.models import Metadata

        metadata = Metadata.model_validate({'createdAt': '2024-01-01T00:00:00Z', 'region': 'eu'})

        assert metadata.additional_properties == {'region': 'eu'}

    def test_bhv_models_010_a_declared_property_wins_over_a_colliding_additional_property(self) -> None:
        from datetime import datetime, timezone

        from {{packageName}}.models import Metadata

        stamp = datetime(2024, 1, 15, 10, 30, tzinfo=timezone.utc)
        declared_only = json.loads(ObjectSerializer().serialize(Metadata(createdAt=stamp)))
        # Field-name keys select the internal bucket path, so the colliding extras
        # are spread into additional_properties; a wire-alias keyword would make
        # that dict a real wire property. mypy checks the alias keyword only.
        colliding = Metadata.model_validate(
            {'created_at': stamp, 'additional_properties': {'createdAt': 'x', 'extra': 'y'}}
        )

        data = json.loads(ObjectSerializer().serialize(colliding))

        assert data['createdAt'] == declared_only['createdAt']
        assert data['extra'] == 'y'


class TestModelDocstringNoExampleNull:

    def test_bhv_models_007_generated_model_has_no_example_null_doc_line(self) -> None:
        # L1 parity — a generated model file must not carry a literal
        # "Example: null" / "@example null" documentation line (a JS/Java-style
        # null-example doc artefact). Python is not affected, but assert it so a
        # regression in the shared codegen surfaces in this SDK too.
        import {{packageName}}.models.metadata as metadata_module

        source_path = metadata_module.__file__
        assert source_path is not None
        with open(source_path, 'r', encoding='utf-8') as handle:
            source = handle.read()
        assert 'Example: null' not in source
        assert '@example null' not in source


    def test_bhv_models_006_the_file_header_prints_the_description_without_backslash_escapes(self) -> None:
        import {{packageName}}.models.metadata as metadata_module

        source_path = metadata_module.__file__
        assert source_path is not None
        with open(source_path, 'r', encoding='utf-8') as handle:
            header = handle.read().split('\n\n', 1)[0]
        assert '"quoted"' in header
        assert '\\"' not in header


