        assert not names & {'auth', 'authenticator'}


class TestMetadataEquality:
    @staticmethod
    def _decode(raw: str) -> Any:
        return ObjectSerializer().deserialize(raw, "Metadata")

    def test_bhv_models_005_equal_known_and_extra_properties_are_equal(self) -> None:
        raw = '{"createdAt":"2024-01-01T00:00:00Z","origin":"a"}'

        assert self._decode(raw) == self._decode(raw)

    def test_bhv_models_012_to_string_dumps_the_fields_and_the_additional_properties_map(self) -> None:
        from {{packageName}}.models import Metadata

        metadata = Metadata(additional_properties={'customField': 'hello'})

        assert 'created_at=None' in repr(metadata)
        assert "additional_properties={'customField': 'hello'}" in repr(metadata)

    def test_bhv_models_018_models_whose_decimal_fields_differ_only_in_trailing_zeros_compare_equal(self) -> None:
        from decimal import Decimal

        from {{packageName}}.models.defaults import Defaults

        assert Defaults(ratio=Decimal('1.5')) == Defaults(ratio=Decimal('1.50'))

    def test_bhv_lang_python_102_instances_differing_only_in_additional_properties_are_not_equal(
        self,
    ) -> None:
        first = self._decode('{"createdAt":"2024-01-01T00:00:00Z","origin":"a"}')
        second = self._decode('{"createdAt":"2024-01-01T00:00:00Z","origin":"b"}')

        assert first.created_at == second.created_at
        assert first != second


class TestMetadataBehaviours:
    def test_bhv_models_013_a_newly_built_model_has_an_empty_additional_properties_collection(self) -> None:
        from {{packageName}}.models import Metadata

        assert Metadata().additional_properties == {}

    def test_bhv_models_015_a_changed_copy_keeps_the_additional_properties(self) -> None:
        from {{packageName}}.models import Metadata

        original = ObjectSerializer().deserialize('{"origin":"a","extra":"x"}', Metadata)
        assert original is not None
        changed = original.model_copy(update={'origin': 'b'})

        assert changed.additional_properties == original.additional_properties
        assert changed.additional_properties != {}

    def test_bhv_models_016_a_copy_clears_an_optional_field_only_when_none_is_passed(self) -> None:
        from {{packageName}}.models import Metadata

        original = ObjectSerializer().deserialize('{"createdAt":"2024-01-01T00:00:00Z"}', Metadata)
        assert original is not None
        kept = original.model_copy()
        cleared = original.model_copy(update={'created_at': None})

        assert kept.created_at == original.created_at
        assert cleared.created_at is None

    def test_bhv_models_017_a_copy_can_set_or_clear_an_optional_field_and_the_original_keeps_its_value(self) -> None:
        from {{packageName}}.models import Metadata

        original = ObjectSerializer().deserialize('{"createdAt":"2024-01-01T00:00:00Z"}', Metadata)
        assert original is not None
        cleared = original.model_copy(update={'created_at': None})
        filled = Metadata().model_copy(update={'created_at': original.created_at})

        assert cleared.created_at is None
        assert original.created_at is not None
        assert filled.created_at == original.created_at

    def test_bhv_models_021_each_member_of_an_integer_backed_enum_carries_its_declared_number(self) -> None:
        from {{packageName}}.models.priority import Priority

        assert [member.value for member in Priority if member is not Priority.UNKNOWN_DEFAULT_OPEN_API] == [1, 2, 3]
        assert Priority.NUMBER_3.value == 3

    def test_bhv_models_022_a_model_whose_schema_allows_undeclared_properties_reports_it(self) -> None:
        from {{packageName}}.models import Metadata
        from {{packageName}}.models.category import Category

        assert 'additional_properties' in Metadata.model_fields
        assert 'additional_properties' not in Category.model_fields

    def test_bhv_models_019_two_models_with_a_different_field_value_compare_unequal(self) -> None:
        from {{packageName}}.models import Metadata

        first = ObjectSerializer().deserialize('{"origin":"a"}', Metadata)
        second = ObjectSerializer().deserialize('{"origin":"b"}', Metadata)

        assert first != second

    def test_bhv_models_020_models_with_the_same_fields_compare_equal_and_hash_alike(self) -> None:
        from {{packageName}}.models import Metadata

        first = ObjectSerializer().deserialize('{"origin":"a"}', Metadata)
        second = ObjectSerializer().deserialize('{"origin":"a"}', Metadata)

        assert first == second
        assert hash(first) == hash(second)

    def test_bhv_options_056_a_per_call_timeout_of_zero_is_refused_before_any_request(self) -> None:
        from {{packageName}}.api.options.find_pets_by_status_options import (
            FindPetsByStatusOptions,
        )

        with pytest.raises(ValueError, match='timeout'):
            FindPetsByStatusOptions(timeout=0)
