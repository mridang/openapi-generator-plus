        client = _Capturing()
        api = PetApi(api_client=client, config=Configuration(base_url='http://localhost'))

        with pytest.raises(ValueError, match="Missing the required parameter 'category'"):
            await api.get_pet_by_name('Fido', GetPetByNameOptions(category=cast(Any, None), x_correlation_id='r'))
        assert client.captured_url == ''

