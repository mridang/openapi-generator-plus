class TestValueSerializerPath:
    def test_bhv_serialization_109_a_path_value_is_percent_encoded_exactly_once(self) -> None:
        assert ValueSerializer.serialize('a%b', 'path', 'string') == 'a%25b'

    def test_bhv_serialization_110_an_absent_path_value_is_empty_and_an_absent_query_value_is_none(self) -> None:
        assert ValueSerializer.serialize(None, 'path', 'string') == ''
        assert ValueSerializer.serialize(None, 'query', 'string') is None

    def test_bhv_serialization_111_only_unreserved_characters_stay_literal_and_others_are_utf8_encoded(self) -> None:
        assert ValueSerializer.serialize('a~b-._z \u00e9', 'path', 'string') == 'a~b-._z%20%C3%A9'

