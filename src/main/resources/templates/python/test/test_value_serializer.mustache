        assert ValueSerializer.encode_content('filter', '{"a":1}', 'path') == '%7B%22a%22%3A1%7D'
        assert ValueSerializer.encode_content('filter', '{"a":1}', 'query') == '{"a":1}'

    def test_bhv_serialization_013_an_array_in_a_header_is_written_as_its_items(self) -> None:
