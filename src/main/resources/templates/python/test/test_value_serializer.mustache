class TestAllowReserved:
    """OAS ``allowReserved: true`` query encoding.

    Cross-language parity with the Java ``AllowReservedTests``.
    """

    def test_bhv_serializationparam_002_reserved_chars_preserved_other_chars_still_encoded(self) -> None:
        assert ValueSerializer.encode_query_allowing_reserved('v1.0/beta:rc1') == 'v1.0/beta:rc1'
        # Space is illegal in a URL and must still be percent-encoded even
        # when reserved characters are preserved.
        assert ValueSerializer.encode_query_allowing_reserved('a b:c') == 'a%20b:c'

    def test_bhv_serializationparam_068_only_query_legal_reserved_chars_stay_literal(self) -> None:
        assert (
            ValueSerializer.encode_query_allowing_reserved("a:b/c?d[e]f@g!h$i&j'k(l)m*n+o,p;q=r~s#t u")
            == "a:b/c?d%5Be%5Df@g!h$i&j'k(l)m*n+o,p;q=r~s%23t%20u"
        )

    @pytest.mark.parametrize('value', ['.', '..'])
    def test_bhv_serializationparam_029_path_dot_segment_is_rejected(self, value: str) -> None:
        with pytest.raises(ValueError) as exc_info:
            ValueSerializer.serialize_styled('name', value, 'path', 'str', None, 'simple', False)
        assert str(exc_info.value) == "Path parameter 'name' must not be '.' or '..'"

    def test_bhv_serializationparam_072_path_value_with_inner_dots_is_kept(self) -> None:
        assert ValueSerializer.serialize_styled('name', 'a..b', 'path', 'str', None, 'simple', False) == 'a..b'

    def test_bhv_serializationparam_060_maybe_allow_reserved_wraps_only_when_allow_reserved_true(self) -> None:
        assert ValueSerializer.maybe_allow_reserved('plain', False) == 'plain'
        wrapped = ValueSerializer.maybe_allow_reserved('v1/beta', True)
        assert isinstance(wrapped, AllowReservedValue)
        assert wrapped.value == 'v1/beta'
        assert ValueSerializer.maybe_allow_reserved(None, True) is None


class TestPathEncodingParity:
    """Cross-language parity tests for path-segment percent-encoding.

    Every SDK must produce identical encoded strings for these inputs.
    """

    def test_bhv_serializationparam_016_ascii_safe_pass_through(self) -> None:
        assert ValueSerializer.serialize('abc123', 'path', 'string') == 'abc123'

    def test_bhv_serializationparam_092_space_encoded(self) -> None:
        assert ValueSerializer.serialize('a b', 'path', 'string') == 'a%20b'

    def test_bhv_serializationparam_091_slash_encoded(self) -> None:
        assert ValueSerializer.serialize('a/b', 'path', 'string') == 'a%2Fb'

    def test_bhv_serializationparam_079_question_mark_encoded(self) -> None:
        assert ValueSerializer.serialize('a?b', 'path', 'string') == 'a%3Fb'

    def test_bhv_serializationparam_043_hash_encoded(self) -> None:
        assert ValueSerializer.serialize('a#b', 'path', 'string') == 'a%23b'

    def test_bhv_serializationparam_026_comma_preserved(self) -> None:
        assert ValueSerializer.serialize('a,b', 'path', 'string') == 'a,b'

    def test_bhv_serializationparam_025_colon_preserved(self) -> None:
        assert ValueSerializer.serialize('a:b', 'path', 'string') == 'a:b'

    def test_bhv_serializationparam_077_plus_preserved(self) -> None:
        assert ValueSerializer.serialize('a+b', 'path', 'string') == 'a+b'

    def test_bhv_serializationparam_103_unicode_encoded(self) -> None:
        assert ValueSerializer.serialize('日本', 'path', 'string') == '%E6%97%A5%E6%9C%AC'

    def test_bhv_serializationparam_034_empty_string_preserved(self) -> None:
        assert ValueSerializer.serialize('', 'path', 'string') == ''

    def test_bhv_serializationparam_070_null_returns_empty(self) -> None:
        assert ValueSerializer.serialize(None, 'path', 'string') == ''

    def test_bhv_serializationparam_089_simple_style_encodes_value(self) -> None:
        assert ValueSerializer.serialize_styled('color', 'a b', 'path', 'string', None, 'simple', False) == 'a%20b'

    def test_bhv_serializationparam_088_simple_style_array_encodes_each_item(self) -> None:
        assert ValueSerializer.serialize_styled('color', ['a b', 'c?d'], 'path', 'array', None, 'simple', False) == 'a%20b,c%3Fd'

    def test_bhv_serializationparam_069_path_array_item_with_reserved_char_is_percent_encoded(self) -> None:
        # Gap W1 regression: every per-item path value in a styled array
        # must be percent-encoded BEFORE being joined with the structural
        # separator. Otherwise '/', '?', '#', space leak into the URL.
        items = ['a/b', 'c']
        assert ValueSerializer.serialize_styled('name', items, 'path', 'array', None, 'simple', False) == 'a%2Fb,c'
        assert ValueSerializer.serialize_styled('name', items, 'path', 'array', None, 'label', True) == '.a%2Fb.c'
        assert ValueSerializer.serialize_styled('name', items, 'path', 'array', None, 'matrix', False) == ';name=a%2Fb,c'

    def test_bhv_serializationparam_059_matrix_style_encodes_value(self) -> None:
        assert ValueSerializer.serialize_styled('color', 'a b', 'path', 'string', None, 'matrix', False) == ';color=a%20b'

    def test_bhv_serializationparam_053_label_style_encodes_value(self) -> None:
        assert ValueSerializer.serialize_styled('color', 'a b', 'path', 'string', None, 'label', False) == '.a%20b'

    def test_bhv_serializationparam_078_query_location_not_path_encoded(self) -> None:
        assert ValueSerializer.serialize_styled('color', 'a b', 'query', 'string', None, 'form', False) == 'a b'

    def test_bhv_serializationparam_033_empty_string_path_param_raises(self) -> None:
        # Gap W — empty-string path values silently produce malformed
        # URLs like `/resource//details`; reject at serialization time so
        # callers see the real error rather than a downstream 404.
        with pytest.raises(ValueError):
            ValueSerializer.serialize_styled('id', '', 'path', 'string', None, 'simple', False)


class TestValueSerializerFormatDatePath:
    """N3/W3 parity: ``format: date`` path parameters must emit a date-only
    string (YYYY-MM-DD), not a full ISO datetime. Python models
    ``format: date`` as ``datetime.date``, which the value serializer
    formats via ``isoformat()``.
    """

    @pytest.mark.parametrize('location', ['path', 'query', 'header'])
    def test_bhv_serialization_044_a_datetime_for_a_date_parameter_sends_only_the_date(self, location: str) -> None:
        moment = datetime.datetime(2024, 1, 15, 13, 45, 30, tzinfo=datetime.timezone.utc)
        assert ValueSerializer.serialize(moment, location, 'date') == '2024-01-15'

    def test_bhv_lang_python_197_a_datetime_for_a_styled_date_parameter_sends_only_the_date(self) -> None:
        moment = datetime.datetime(2024, 1, 15, 13, 45, 30, tzinfo=datetime.timezone.utc)
        assert (
            ValueSerializer.serialize_styled('asOf', moment, 'path', 'date', None, 'matrix', False)
            == ';asOf=2024-01-15'
        )

    def test_bhv_serializationparam_048_a_datetime_for_a_date_time_parameter_keeps_the_time(self) -> None:
        moment = datetime.datetime(2024, 1, 15, 13, 45, 30, tzinfo=datetime.timezone.utc)
        rendered = ValueSerializer.serialize(moment, 'query', 'string')
        assert isinstance(rendered, str)
        assert rendered.startswith('2024-01-15T13:45:30')

    def test_bhv_lang_python_206_a_date_value_is_written_as_yyyy_mm_dd(self) -> None:
        moment = datetime.datetime(2024, 1, 1, 10, 30, 45, tzinfo=datetime.timezone.utc)
        assert ValueSerializer.serialize(moment, 'query', 'date') == '2024-01-01'
        assert ValueSerializer.serialize_styled('d', moment, 'query', 'date', None, 'form', True) == '2024-01-01'

    def test_bhv_serializationparam_120_an_array_of_dates_writes_each_as_yyyy_mm_dd(self) -> None:
        moments = [
            datetime.datetime(2024, 1, 1, 10, 30, tzinfo=datetime.timezone.utc),
            datetime.datetime(2024, 2, 3, 23, 59, tzinfo=datetime.timezone.utc),
        ]
        assert ValueSerializer.serialize(moments, 'header', 'date') == '2024-01-01,2024-02-03'

    def test_bhv_serializationparam_028_date_in_path_returns_yyyy_mm_dd(self) -> None:
        date = datetime.date(2024, 1, 15)
        assert ValueSerializer.serialize(date, 'path', 'string') == '2024-01-15'

    def test_bhv_serializationparam_054_date_via_serialize_styled_simple_returns_yyyy_mm_dd(self) -> None:
        date = datetime.date(2024, 1, 15)
        assert ValueSerializer.serialize_styled(
            'since', date, 'path', 'string', None, 'simple', False
        ) == '2024-01-15'

    def test_bhv_serializationparam_027_date_at_year_boundary_emits_date_only(self) -> None:
        # UTC/midnight edge: a date on the year boundary must serialize as a
        # bare YYYY-MM-DD with no time/offset suffix, matching the
        # stringifyDate UTC behaviour of Go/Node/Swift/Dart.
        date = datetime.date(2024, 12, 31)
        assert ValueSerializer.serialize(date, 'path', 'string') == '2024-12-31'


class TestPathSegmentCharacterSet:
    def test_bhv_serializationparam_071_path_is_segment_encoded_once(self) -> None:
        assert ValueSerializer.encode_path_segment('a/b%20c') == 'a%2Fb%2520c'

    def test_bhv_serializationparam_080_reserved_characters_left_literal_other_characters_still_encoded(self) -> None:
        assert ValueSerializer.encode_path_segment("a;=,:@!$&'()*+ b/c?d#e") == "a;=,:@!$&'()*+%20b%2Fc%3Fd%23e"

    def test_bhv_serializationparam_119_a_tilde_is_kept_literal_in_a_path_value(self) -> None:
        assert ValueSerializer.serialize('~', 'path', 'string') == '~'
        assert ValueSerializer.serialize_styled('id', 'a~b', 'path', 'string', None, 'simple', False) == 'a~b'

    @pytest.mark.parametrize("char", list(";=,:@!$&'()*+~"))
    def test_bhv_serializationparam_081_sub_delimiters_and_tilde_stay_literal(self, char: str) -> None:
        assert (
            ValueSerializer.serialize(f"a{char}b", "path", "string") == f"a{char}b"
        )

    @pytest.mark.parametrize(
        ("raw", "encoded"),
        [
            ("a b", "a%20b"),
            ("a/b", "a%2Fb"),
            ("a?b", "a%3Fb"),
            ("a#b", "a%23b"),
            ("a%b", "a%25b"),
            ("a%20b", "a%2520b"),
            ('a"b', "a%22b"),
            ("a<b>", "a%3Cb%3E"),
            ("a[b]", "a%5Bb%5D"),
            ("a|b", "a%7Cb"),
            ("a\\b", "a%5Cb"),
            ("a^b", "a%5Eb"),
            ("a`b", "a%60b"),
            ("a{b}", "a%7Bb%7D"),
        ],
    )
    def test_bhv_serialization_005_everything_else_is_percent_encoded(self, raw: str, encoded: str) -> None:
        assert ValueSerializer.serialize(raw, "path", "string") == encoded


class TestEncodeContent:
    """A `content` parameter's JSON text is encoded once, by its location."""

    def test_bhv_lang_python_198_path_value_is_fully_percent_encoded(self) -> None:
        assert ValueSerializer.encode_content('p', '{"a":"b/c"}', 'path') == '%7B%22a%22%3A%22b%2Fc%22%7D'

    def test_bhv_lang_python_209_cookie_value_is_fully_percent_encoded(self) -> None:
        assert ValueSerializer.encode_content('c', '{"a":1}', 'cookie') == '%7B%22a%22%3A1%7D'

    def test_bhv_serializationparam_104_cookie_value_keeps_only_the_unreserved_set_literal(self) -> None:
        assert (
            ValueSerializer.encode_content('c', '{"k":"a b~*\u00e9"}', 'cookie')
            == '%7B%22k%22%3A%22a%20b~%2A%C3%A9%22%7D'
        )

    def test_bhv_lang_python_199_header_value_is_sent_verbatim(self) -> None:
        assert ValueSerializer.encode_content('h', '{"a":1}', 'header') == '{"a":1}'

    def test_bhv_headers_031_header_value_with_a_line_break_is_rejected(self) -> None:
        with pytest.raises(ValueError):
            ValueSerializer.encode_content('h', '{"a":"x\ny"}', 'header')

    def test_bhv_lang_python_200_query_value_is_left_for_the_query_builder(self) -> None:
        assert ValueSerializer.encode_content('q', '{"a":1}', 'query') == '{"a":1}'


class TestObjectValuedParameters:
    _FIELDS = {'breed': 'lab', 'min_age': 3}

    def test_bhv_serializationparam_036_exploded_form_query_is_one_entry_per_property(self) -> None:
        result = ValueSerializer.serialize_styled('c', self._FIELDS, 'query', 'Obj', None, 'form', True)
        assert result == {'breed': 'lab', 'min_age': '3'}

    def test_bhv_serializationparam_039_unexploded_form_query_is_a_comma_list(self) -> None:
        result = ValueSerializer.serialize_styled('c', self._FIELDS, 'query', 'Obj', None, 'form', False)
        assert result == 'breed,lab,min_age,3'

    def test_bhv_serialization_016_an_object_in_a_delimited_style_is_alternating_keys_and_values(self) -> None:
        space = ValueSerializer.serialize_styled('c', self._FIELDS, 'query', 'Obj', None, 'spaceDelimited', False)
        pipe = ValueSerializer.serialize_styled('c', self._FIELDS, 'query', 'Obj', None, 'pipeDelimited', False)
        assert space == 'breed lab min_age 3'
        assert pipe == 'breed|lab|min_age|3'

    def test_bhv_serializationparam_082_simple_header_unexploded_is_a_comma_list(self) -> None:
        result = ValueSerializer.serialize_styled('c', self._FIELDS, 'header', 'Obj', None, 'simple', False)
        assert result == 'breed,lab,min_age,3'

    def test_bhv_lang_python_201_simple_exploded_assigns_each_property(self) -> None:
        result = ValueSerializer.serialize_styled('c', self._FIELDS, 'header', 'Obj', None, 'simple', True)
        assert result == 'breed=lab,min_age=3'

    def test_bhv_serialization_015_matrix_and_label_path_styles(self) -> None:
        matrix = ValueSerializer.serialize_styled('c', self._FIELDS, 'path', 'Obj', None, 'matrix', True)
        label = ValueSerializer.serialize_styled('c', self._FIELDS, 'path', 'Obj', None, 'label', False)
        assert matrix == ';breed=lab;min_age=3'
        assert label == '.breed,lab,min_age,3'

    def test_bhv_serializationparam_004_path_properties_are_percent_encoded(self) -> None:
        result = ValueSerializer.serialize_styled('c', {'a b': 'x/y'}, 'path', 'Obj', None, 'simple', False)
        assert result == 'a%20b,x%2Fy'

    def test_bhv_serialization_014_an_empty_object_query_is_omitted(self) -> None:
        assert ValueSerializer.serialize_styled('c', {}, 'query', 'Obj', None, 'form', True) is None

    def test_bhv_lang_python_202_query_entries_expand_an_exploded_object(self) -> None:
        assert ValueSerializer.query_entries('c', {'a': '1'}) == {'a': '1'}
        assert ValueSerializer.query_entries('c', 'v') == {'c': 'v'}
        assert ValueSerializer.query_entries('c', None) == {}

