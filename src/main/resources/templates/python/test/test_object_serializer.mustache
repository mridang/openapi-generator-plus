        from {{packageName}}.models.order import Order
        assert Order.model_validate({'pet_id': 5}).pet_id == 5

    def test_attribute_name_is_captured_as_an_additional_property(self) -> None:
        from {{packageName}}.models.metadata import Metadata
        result = ObjectSerializer().deserialize(
            '{"created_at":"2024-01-01T00:00:00Z","region":"eu"}', 'Metadata'
        )
        assert isinstance(result, Metadata)
        assert result.created_at is None
        assert result.additional_properties == {
            'created_at': '2024-01-01T00:00:00Z',
            'region': 'eu',
        }

    def test_bhv_serializationobject_052_declared_property_name_still_populates_the_field(self) -> None:
        result = ObjectSerializer().deserialize(
            '{"createdAt":"2024-01-01T00:00:00Z","region":"eu"}', 'Metadata'
        )
        assert result.created_at == datetime.datetime(2024, 1, 1, tzinfo=datetime.timezone.utc)
        assert result.additional_properties == {'region': 'eu'}

    def test_attribute_name_is_captured_for_list_elements(self) -> None:
        result = ObjectSerializer().deserialize('[{"created_at":"x"}]', 'List[Metadata]')
        assert result[0].created_at is None
        assert result[0].additional_properties == {'created_at': 'x'}

    def test_direct_validation_still_accepts_the_attribute_name_for_an_extras_model(self) -> None:
        from {{packageName}}.models.metadata import Metadata
        instant = datetime.datetime(2024, 1, 1, tzinfo=datetime.timezone.utc)
        built = Metadata.model_validate({'created_at': instant})
        assert built.created_at == instant
        assert built.additional_properties == {}


