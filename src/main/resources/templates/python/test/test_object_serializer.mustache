class TestByteFormatBase64RoundTrip:
    """Scenario 3 — a `format: byte` field round-trips through base64, both a
    scalar byte field (PetPassport.thumbnail) and an array-of-byte field
    (PetPassport.scans). `_sanitize_for_serialization` base64-encodes bytes;
    `_deserialize` base64-decodes them back to raw bytes."""

    def test_scalar_byte_serializes_to_base64(self) -> None:
        import base64
        raw = b'\x89PNG\r\n\x1a\n'
        out = ObjectSerializer().serialize(raw)
        # serialize wraps the base64 text in JSON quotes.
        assert out.strip('"') == base64.b64encode(raw).decode('ascii')

    def test_bhv_serializationobject_079_scalar_byte_round_trips(self) -> None:
        raw = b'test-thumbnail-bytes'
        wire = ObjectSerializer().serialize(raw)
        restored = ObjectSerializer().deserialize(wire, bytes)
        assert restored == raw

    def test_array_of_byte_serializes_each_element_to_base64(self) -> None:
        import base64
        import json
        # PhotoMetadata-style array-of-byte (PetPassport.scans): every element
        # must be base64-encoded on the wire, not emitted as a raw/latin1 blob.
        scans = [b'page-one', b'page-two', b'\x00\x01\x02']
        out = ObjectSerializer().serialize(scans)
        decoded = [base64.b64decode(s) for s in json.loads(out)]
        assert decoded == scans

    def test_scalar_byte_decodes_from_base64_string(self) -> None:
        # The deserialize side of the scalar byte path: a base64 wire string
        # decodes back to the original raw bytes.
        import base64
        raw = b'\x89PNG\r\n\x1a\n'
        wire = '"' + base64.b64encode(raw).decode('ascii') + '"'
        assert ObjectSerializer().deserialize(wire, bytes) == raw

    def test_bhv_serializationobject_094_invalid_base64_is_rejected(self) -> None:
        # A `format: byte` wire string containing characters outside the base64
        # alphabet must be REJECTED (b64decode validate=True), not silently
        # truncated, matching the strict decoders in ruby/php/elixir/go/rust.
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('"!!!!"', bytes)


class TestByteModelFieldHoldsRawBytes:
    """A `format: byte` MODEL field holds RAW bytes in memory and is base64 only
    on the wire, as in the other SDKs: constructing or copying with bytes never
    decodes them, and a malformed base64 wire string is rejected."""

    RAW = bytes([0x00, 0xFF, 0x10, 0x42])

    def _vault(self):
        from {{packageName}}.models.binary_vault import BinaryVault

        return BinaryVault

    def test_bhv_serializationobject_009_constructing_with_raw_bytes_keeps_them(self) -> None:
        assert self._vault()(seal=self.RAW).seal == self.RAW

    def test_constructing_with_bytes_that_look_like_base64_keeps_them(self) -> None:
        assert self._vault()(seal=b'test').seal == b'test'

    def test_copying_with_raw_bytes_keeps_them(self) -> None:
        vault = self._vault()().model_copy(update={'seal': b'hello world'})
        assert vault.seal == b'hello world'

    def test_copying_the_decoded_value_is_stable(self) -> None:
        vault = ObjectSerializer().deserialize('{"seal":"dGVzdA=="}', 'BinaryVault')
        assert vault.model_copy(update={'seal': vault.seal}).seal == b'test'

    def test_serializing_base64_encodes_the_raw_bytes(self) -> None:
        assert ObjectSerializer().serialize(self._vault()(seal=self.RAW)) == '{"seal":"AP8QQg=="}'

    def test_bhv_serializationobject_026_scalar_array_and_map_round_trip_through_base64(self) -> None:
        vault = self._vault()(seal=self.RAW, shards=[b'a', self.RAW], labels={'k': b'test'})
        wire = ObjectSerializer().serialize(vault)
        assert wire == '{"seal":"AP8QQg==","shards":["YQ==","AP8QQg=="],"labels":{"k":"dGVzdA=="}}'
        restored = ObjectSerializer().deserialize(wire, 'BinaryVault')
        assert restored.seal == self.RAW
        assert restored.shards == [b'a', self.RAW]
        assert restored.labels == {'k': b'test'}

    def test_bhv_serializationobject_075_equality_compares_byte_contents_bare_listed_and_mapped(self) -> None:
        vault = self._vault()
        first = vault(seal=bytes(self.RAW), shards=[bytes(self.RAW)], labels={'k': bytes(self.RAW)})
        second = vault(seal=bytes(self.RAW), shards=[bytes(self.RAW)], labels={'k': bytes(self.RAW)})
        assert first == second
        assert first != vault(seal=b'other', shards=[bytes(self.RAW)], labels={'k': bytes(self.RAW)})
        assert first != vault(seal=bytes(self.RAW), shards=[b'other'], labels={'k': bytes(self.RAW)})
        assert first != vault(seal=bytes(self.RAW), shards=[bytes(self.RAW)], labels={'k': b'other'})

    def test_pet_passport_thumbnail_and_scans_round_trip(self) -> None:
        wire = '{"thumbnail":"dGVzdA==","scans":["AQID"]}'
        passport = ObjectSerializer().deserialize(wire, 'PetPassport')
        assert passport.thumbnail == b'test'
        assert passport.scans == [b'\x01\x02\x03']
        assert ObjectSerializer().serialize(passport) == wire

    @pytest.mark.parametrize('malformed', ['!!!!', 'dG!VzdA==', 'dGVz dA=='])
    def test_bhv_serializationobject_102_malformed_base64_is_rejected_for_a_scalar(self, malformed: str) -> None:
        with pytest.raises(SerializationException):
