class TestCanonicalSerdeBehaviours:
    """Cross-SDK canonical serde behaviours: a bare JSON null body decodes to
    None, and the 1000-deep JSON nesting cap rejects an over-deep payload.

    NaN/Infinity rejection on encode is covered by TestNanInfinityRejection
    above. format:byte decoding for Python happens through pydantic model-field
    validation, not a base64 branch in ObjectSerializer, so the
    invalid-base64-throws case does not apply here.
    """

    def test_bhv_serializationobject_067_literal_null_body_deserializes_to_none(self) -> None:
        assert ObjectSerializer().deserialize('null', 'Category') is None

    def test_bhv_serializationobject_051_deep_json_within_cap_decodes(self) -> None:
        within = '[' * 600 + ']' * 600
        assert ObjectSerializer().deserialize(within, 'object') is not None

    def test_deep_json_beyond_cap_is_rejected(self) -> None:
        beyond = '[' * 1500 + ']' * 1500
        with pytest.raises(SerializationException) as exc_info:
            ObjectSerializer().deserialize(beyond, 'object')
        assert str(exc_info.value) == 'JSON nesting depth 1500 exceeds limit 1000'

    def test_bhv_serializationobject_004_malformed_json_message_has_the_canonical_prefix(self) -> None:
        with pytest.raises(SerializationException) as exc_info:
            ObjectSerializer().deserialize('{', 'Category')
        assert str(exc_info.value).startswith('Failed to deserialize JSON: ')


class TestWireDecodeIgnoresAttributeNames:
