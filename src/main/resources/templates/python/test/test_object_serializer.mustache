class TestDeserializationErrorWrapping:
    @pytest.mark.parametrize(
        ('payload', 'type_name'),
        [
            pytest.param('{', 'Category', id='malformed JSON'),
            pytest.param('{"id":"abc","name":"doggie","photoUrls":[]}', 'Pet', id='wrong primitive type'),
            pytest.param('{"name":"doggie","photoUrls":[],"status":"banana"}', 'Pet', id='unknown enum value'),
            pytest.param('{"photoUrls":[]}', 'Pet', id='missing required field'),
            pytest.param('{"retryAfter":"soon"}', 'EdgeCases', id='malformed duration'),
            pytest.param('{"expiresAt":"not-a-date"}', 'EdgeCases', id='malformed date-time'),
        ],
    )
    def test_bhv_serializationobject_077_wire_shape_failure_raises_exactly_serialization_exception(self, payload: str, type_name: str) -> None:
        """The error contract: every wire-shape failure raises exactly
        SerializationException (no subclass, no library error), and that is an
        instance of the SDK root so one except catches it."""
        with pytest.raises(SerializationException) as exc_info:
            ObjectSerializer().deserialize(payload, type_name)
        assert type(exc_info.value) is SerializationException
        assert isinstance(exc_info.value, {{errorPrefix}}Exception)

    def test_bhv_serializationobject_170_truncated_json_raises_serialization_error(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{', 'Category')

    def test_bhv_serializationobject_066_invalid_json_raises_serialization_error(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('not json', 'Category')

    def test_bhv_serializationobject_095_invalid_json_structure_raises_serialization_error(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('"hello"', 'int')

    def test_bhv_serializationobject_162_thrown_serialization_error_has_cause(self) -> None:
        with pytest.raises(SerializationException) as exc_info:
            ObjectSerializer().deserialize('{', 'Category')
        assert exc_info.value.cause is not None


class TestStrictFloatAcceptsIntegralWireValue:
    """A `format: double`/`float` field decodes an integral JSON number.

    JSON has a single number type, so a server may emit `5` (no decimal point)
    for a field declared `format: double`. Bare pydantic StrictFloat rejects
    that because the parsed Python type is `int`; the SDK's LaxFloat alias
    widens the lossless `int -> float` case while keeping the rest of the
    StrictFloat strictness (str/bool still rejected). DryFood.weight_kg
    (format: double → StrictFloat → LaxFloat) is the fixture shape.
    """

    def test_integral_json_decodes_to_float(self) -> None:
        try:
            restored = ObjectSerializer().deserialize(
                '{"foodType": "dry", "weightKg": 5}', 'DryFood'
            )
        except SerializationException as exc:  # pragma: no cover - failure path
            pytest.fail(f'integral double value was rejected: {exc}')
        assert restored is not None
        assert restored.weight_kg == 5.0
        assert isinstance(restored.weight_kg, float)

    def test_fractional_json_still_decodes(self) -> None:
        try:
            restored = ObjectSerializer().deserialize(
                '{"foodType": "dry", "weightKg": 1.5}', 'DryFood'
            )
        except SerializationException as exc:  # pragma: no cover - failure path
            pytest.fail(f'fractional double value was rejected: {exc}')
        assert restored is not None
        assert restored.weight_kg == 1.5

    def test_string_value_still_rejected(self) -> None:
        # LaxFloat only widens int -> float; a string is still a wire-type bug.
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(
                '{"foodType": "dry", "weightKg": "5"}', 'DryFood'
            )


class TestUriRoundTripsByteIdentical:
    """A `format: uri` field round-trips its wire value byte-identical.

    pydantic.HttpUrl validates AND normalizes (appends a trailing slash to a
    host-only URL, strips a default port, lowercases the host), which makes the
    JSON round-trip lossy. The SDK maps `format: uri` to UrlStr — a validated
    `str` that returns the value verbatim — so the URL survives unchanged.
    Pet.homepage_url (format: uri) is the fixture shape.
    """

    def test_host_only_url_keeps_no_trailing_slash(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "homepageUrl": "https://example.com"}'
        try:
            restored = ObjectSerializer().deserialize(wire, 'Pet')
        except SerializationException as exc:  # pragma: no cover - failure path
            pytest.fail(f'absolute URL was rejected: {exc}')
        assert restored is not None
        # HttpUrl would have mutated this to 'https://example.com/'.
        assert restored.homepage_url == 'https://example.com'
        reserialized = ObjectSerializer().serialize(restored)
        assert '"https://example.com"' in reserialized
        assert 'https://example.com/' not in reserialized

    def test_default_port_and_host_case_preserved(self) -> None:
        url = 'http://Example.COM:80/Path'
        wire = (
            '{"name": "Fido", "photoUrls": [], "homepageUrl": "' + url + '"}'
        )
        try:
            restored = ObjectSerializer().deserialize(wire, 'Pet')
        except SerializationException as exc:  # pragma: no cover - failure path
            pytest.fail(f'absolute URL was rejected: {exc}')
        assert restored is not None
        # HttpUrl would lowercase the host and strip the :80 default port.
        assert restored.homepage_url == url

    @pytest.mark.parametrize('uri', ['urn:isbn:0451450523', 'mailto:a@b.com', 'ftp://x.org/f'])
    def test_bhv_serializationobject_021_absolute_uri_of_any_scheme_accepted(self, uri: str) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "homepageUrl": "%s"}' % uri
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        assert restored.homepage_url == uri

    def test_bhv_serializationobject_173_uri_reference_field_still_accepts_a_relative_reference(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "thumbnailRef": "/assets/thumb-fido.png"}'
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        assert restored.thumbnail_ref == '/assets/thumb-fido.png'

    def test_bhv_serializationobject_008_relative_reference_rejected(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "homepageUrl": "/relative"}'
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(wire, 'Pet')

    def test_non_url_string_rejected(self) -> None:
        # UrlStr still validates: a non-URL value is a real error.
        wire = '{"name": "Fido", "photoUrls": [], "homepageUrl": "not a url"}'
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(wire, 'Pet')


class TestDecimalNumberSerializesUnquoted:
    """A bare `type: number` field serializes as an UNQUOTED JSON number.

    The OpenAPI spec types `Pet.weightKg` as `type: number` (no `format`), so
    on the wire it MUST be a JSON number (`1.5`), never a JSON string (`"1.5"`).
    The SDK decodes it to a full-precision `decimal.Decimal` for fidelity, but a
    plain pydantic `Decimal` serializes as a quoted string — which violates the
    spec and diverges from the SDKs that emit a bare number. The `type: number`
    mapping is the branded `JsonNumber` alias whose json-only PlainSerializer
    widens the value to a float on encode so `model_dump_json` renders an
    unquoted number. This is the cross-SDK DECIMAL-AS-NUMBER parity check.
    """

    def test_bhv_serializationobject_171_weight_serializes_as_unquoted_number(self) -> None:
        pet = Pet(name='Fido', photoUrls=set(), weightKg=Decimal('1.5'))
        serialized = ObjectSerializer().serialize(pet)
        # Unquoted number on the wire, NOT a quoted string.
        assert '"weightKg":1.5' in serialized
        assert '"weightKg":"1.5"' not in serialized

    def test_bhv_serializationobject_177_weight_round_trips_as_number(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "weightKg": 1.5}'
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        # Decode keeps full-precision Decimal semantics.
        assert restored.weight_kg == Decimal('1.5')
        # Re-encode still emits an unquoted JSON number, not a string.
        reserialized = ObjectSerializer().serialize(restored)
        assert '"weightKg":1.5' in reserialized
        assert '"weightKg":"1.5"' not in reserialized


class TestNumberIsLossless:
    """A `type: number` field decodes and encodes without float rounding and
    rejects a quoted string."""

    def test_decode_keeps_every_digit(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "weightKg": 0.1234567890123456789}'
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        assert restored.weight_kg == Decimal('0.1234567890123456789')

    def test_decode_keeps_a_large_magnitude_with_a_fraction(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "weightKg": 12345678901234567890.5}'
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        assert restored.weight_kg == Decimal('12345678901234567890.5')

    def test_encode_writes_every_digit_unquoted(self) -> None:
        pet = Pet(name='Fido', photoUrls=set(), weightKg=Decimal('0.1234567890123456789'))
        assert '"weightKg":0.1234567890123456789' in ObjectSerializer().serialize(pet)

    def test_bhv_serializationobject_111_round_trip_is_exact(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "weightKg": 12345678901234567890.5}'
        restored = ObjectSerializer().deserialize(wire, 'Pet')
        assert restored is not None
        assert '"weightKg":12345678901234567890.5' in ObjectSerializer().serialize(restored)

    def test_a_list_of_models_keeps_the_exact_digits(self) -> None:
        pet = Pet(name='Fido', photoUrls=set(), weightKg=Decimal('0.1234567890123456789'))
        assert '"weightKg":0.1234567890123456789' in ObjectSerializer().serialize([pet])

    def test_decode_rejects_a_quoted_number(self) -> None:
        wire = '{"name": "Fido", "photoUrls": [], "weightKg": "12.345"}'
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(wire, 'Pet')

    def test_constructor_rejects_a_string(self) -> None:
        with pytest.raises(ValidationError):
            Pet.model_validate({'name': 'Fido', 'photoUrls': [], 'weightKg': '12.345'})


class TestSetSanitization:
    """`_sanitize_for_serialization` emits a set/frozenset as a JSON array.

    JSON has no set type; a set must serialize as a JSON ARRAY, not the Python
    repr string ('{1, 2, 3}') the bare `str(obj)` fallback used to produce.
    """

    def test_set_serializes_as_json_array(self) -> None:
        result = ObjectSerializer().serialize({'values': {3, 1, 2}})
        # Sorted for determinism, emitted as a JSON array (not '{1, 2, 3}').
        assert '"values":[1,2,3]' in result
        assert '{1, 2, 3}' not in result

    def test_frozenset_serializes_as_json_array(self) -> None:
        result = ObjectSerializer().serialize({'values': frozenset({'b', 'a'})})
        assert '"values":["a","b"]' in result

    def test_top_level_set_serializes_as_json_array(self) -> None:
        result = ObjectSerializer().serialize({2, 1, 3})
        assert result == '[1,2,3]'

    def test_sanitize_set_returns_list(self) -> None:
        sanitized = ObjectSerializer._sanitize_for_serialization({1, 2, 3})
        assert isinstance(sanitized, list)
        assert sorted(sanitized) == [1, 2, 3]


class TestCollectionsOfModelsUseTheModelWireForm:
    """A list or dict of models serializes each model exactly as a lone model.

    The collection path used to flatten each model with a Python-mode dump, so
    date-times and bytes reached `json.dumps(default=str)` as raw objects and
    were written as `str()` text instead of the model's wire form.
    """

    @staticmethod
    def _order() -> Any:
        from {{packageName}}.models.order import Order
        return Order(
            id=1,
            shipDate=datetime.datetime(2020, 1, 2, 3, 4, 5, tzinfo=datetime.timezone.utc),
        )

    def test_bhv_serializationobject_151_list_of_models_emits_canonical_date_time(self) -> None:
        import json
        order = self._order()
        wire = json.loads(ObjectSerializer().serialize([order]))
        assert wire[0]['shipDate'] == '2020-01-02T03:04:05.000+00:00'
        assert wire == [json.loads(ObjectSerializer().serialize(order))]

    def test_bhv_serializationobject_045_dict_of_models_emits_canonical_date_time(self) -> None:
        import json
        order = self._order()
        wire = json.loads(ObjectSerializer().serialize({'first': order}))
        assert wire['first']['shipDate'] == '2020-01-02T03:04:05.000+00:00'
        assert wire == {'first': json.loads(ObjectSerializer().serialize(order))}

    def test_list_of_models_emits_bytes_as_base64(self) -> None:
        import json
        from {{packageName}}.models.binary_vault import BinaryVault
        vault = BinaryVault(seal=b'\x00\xff')
        assert json.loads(ObjectSerializer().serialize([vault])) == [{'seal': 'AP8='}]


