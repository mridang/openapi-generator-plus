class TestResponseLeavesAreStrict:
    """The leaves of a container response (getInventory is `map<string,int32>`,
    getMatrix `array<array<int32>>`) are as strict as the same leaves on a model
    field: a quoted number, a fractional number or a boolean is a wire-type bug,
    not a value to coerce."""

    @pytest.mark.parametrize('leaf', ['"5"', '7.0', 'true'])
    def test_bhv_serializationobject_089_map_of_integers_rejects_a_non_integer_leaf(self, leaf: str) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":%s}' % leaf, 'Dict[str, StrictInt]')

    @pytest.mark.parametrize('leaf', ['"5"', '7.0', 'true'])
    def test_array_of_integers_rejects_a_non_integer_leaf(self, leaf: str) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('[1,%s]' % leaf, 'List[StrictInt]')

    def test_nested_array_of_integers_rejects_a_quoted_leaf(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('[[1,2],["3"]]', 'List[List[StrictInt]]')

    @pytest.mark.parametrize('payload', ['[[1],null]', '[null]'])
    def test_bhv_serializationobject_121_nested_array_rejects_a_null_element(self, payload: str) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(payload, 'List[List[StrictInt]]')

    def test_bhv_serializationobject_122_map_of_integers_rejects_a_null_element(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":null}', 'Dict[str, StrictInt]')

    def test_integers_are_still_accepted(self) -> None:
        assert ObjectSerializer().deserialize('{"a":5,"b":0}', 'Dict[str, StrictInt]') == {'a': 5, 'b': 0}
        assert ObjectSerializer().deserialize('[[1,2],[3]]', 'List[List[StrictInt]]') == [[1, 2], [3]]

    def test_bhv_serializationobject_123_map_of_strings_rejects_a_number(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('{"a":5}', 'Dict[str, StrictStr]')

    def test_bhv_serializationobject_155_array_of_booleans_rejects_a_number(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('[true,1]', 'List[StrictBool]')

    def test_bhv_serializationobject_071_array_of_doubles_rejects_a_quoted_number_but_widens_an_integral_one(self) -> None:
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize('[1.5,"2.5"]', 'List[LaxFloat]')
        assert ObjectSerializer().deserialize('[1.5,2]', 'List[LaxFloat]') == [1.5, 2.0]

    @pytest.mark.parametrize('klass', ['StrictInt', 'StrictBool', 'StrictStr'])
    def test_scalar_response_rejects_a_value_of_another_type(self, klass: str) -> None:
        wrong = {'StrictInt': '"5"', 'StrictBool': '"false"', 'StrictStr': '5'}[klass]
        with pytest.raises(SerializationException):
            ObjectSerializer().deserialize(wrong, klass)

    def test_scalar_response_accepts_a_value_of_its_own_type(self) -> None:
        assert ObjectSerializer().deserialize('5', 'StrictInt') == 5
        assert ObjectSerializer().deserialize('false', 'StrictBool') is False
        assert ObjectSerializer().deserialize('"x"', 'StrictStr') == 'x'


