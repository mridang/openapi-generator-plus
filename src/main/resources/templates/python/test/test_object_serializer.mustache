        from {{packageName}}.models.order import Order
        result = ObjectSerializer().deserialize('{"pet_id":5,"petId":7}', 'Order')
        assert isinstance(result, Order)
        assert result.pet_id == 7

    def test_list_elements_ignore_the_attribute_name(self) -> None:
        result = ObjectSerializer().deserialize('[{"pet_id":5},{"petId":6}]', 'List[Order]')
        assert [order.pet_id for order in result] == [None, 6]

    def test_dict_values_ignore_the_attribute_name(self) -> None:
        result = ObjectSerializer().deserialize('{"a":{"pet_id":5},"b":{"petId":6}}', 'Dict[str, Order]')
        assert {key: order.pet_id for key, order in result.items()} == {'a': None, 'b': 6}

