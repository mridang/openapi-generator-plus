import json
from typing import Any
import pytest
from unittest.mock import MagicMock
from urllib.parse import urlparse, parse_qs

from {{packageName}}.auth.oauth.oauth2_authorization_code_authenticator import OAuth2AuthorizationCodeAuthenticator
from {{packageName}}.api_http_response import ApiHttpResponse
from {{packageName}}.errors import {{errorPrefix}}Exception


def _create_authenticator() -> OAuth2AuthorizationCodeAuthenticator:
    return OAuth2AuthorizationCodeAuthenticator(
        host='https://api.example.com',
        client_id='my_client_id',
        client_secret='my_secret',
        authorization_url='https://auth.example.com/authorize',
        token_url='https://auth.example.com/token',
        redirect_uri='https://app.example.com/callback',
        scopes=['read', 'write'],
    )


class TestOAuth2AuthorizationCodeAuthenticator:

    def test_builds_authorization_url_with_required_params(self) -> None:
        auth = _create_authenticator()

        url = auth.build_authorization_url()
        parsed = urlparse(url)
        params = parse_qs(parsed.query)

        assert parsed.scheme == 'https'
        assert parsed.netloc == 'auth.example.com'
        assert parsed.path == '/authorize'
        assert params['client_id'] == ['my_client_id']
        assert params['redirect_uri'] == ['https://app.example.com/callback']
        assert params['scope'] == ['read write']
        assert params['response_type'] == ['code']

    def test_exchange_code_rejects_empty_code(self) -> None:
        auth = _create_authenticator()
        auth.set_api_client(MagicMock())
        with pytest.raises(ValueError):
            auth.exchange_code('')

    def test_exchange_code_rejects_whitespace_code(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        auth.set_api_client(mock_client)
        with pytest.raises(ValueError):
            auth.exchange_code('   ')
        # The token POST must never have been issued for an empty code.
        mock_client.send_request.assert_not_called()

    def test_builds_authorization_url_with_state(self) -> None:
        auth = _create_authenticator()

        url = auth.build_authorization_url(state='csrf-state-123')
        parsed = urlparse(url)
        params = parse_qs(parsed.query)

        assert params['state'] == ['csrf-state-123']

    def test_exchanges_code_with_correct_grant_type(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.return_value = ApiHttpResponse(
            status_code=200,
            body=json.dumps({
                'access_token': 'access_abc',
                'refresh_token': 'refresh_xyz',
                'expires_in': 3600,
            }),
            headers={'content-type': 'application/json'},
        )
        auth.set_api_client(mock_client)

        auth.exchange_code('auth_code_123')

        mock_client.send_request.assert_called_once()
        call_args = mock_client.send_request.call_args
        assert call_args[0][0] == 'POST'
        assert call_args[0][1] == 'https://auth.example.com/token'
        body = call_args[0][3]
        assert 'grant_type=authorization_code' in body
        assert 'code=auth_code_123' in body
        assert 'client_id=my_client_id' in body
        assert 'client_secret=my_secret' in body

    def test_includes_refresh_token_on_refresh(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        # First call: exchange_code returns a refresh token with immediate expiry
        mock_client.send_request.return_value = ApiHttpResponse(
            status_code=200,
            body=json.dumps({
                'access_token': 'access_1',
                'refresh_token': 'refresh_token_value',
                'expires_in': 0,
            }),
            headers={'content-type': 'application/json'},
        )
        auth.set_api_client(mock_client)
        auth.exchange_code('code')

        # Second call: get_auth_headers triggers refresh
        mock_client.send_request.return_value = ApiHttpResponse(
            status_code=200,
            body=json.dumps({
                'access_token': 'access_2',
                'expires_in': 3600,
            }),
            headers={'content-type': 'application/json'},
        )
        headers = auth.get_auth_headers()

        second_call = mock_client.send_request.call_args
        body = second_call[0][3]
        assert 'refresh_token=refresh_token_value' in body
        assert 'grant_type=refresh_token' in body
        assert headers['Authorization'] == 'Bearer access_2'

    def test_throws_before_exchange_code_called(self) -> None:
        # Requesting a token before the code exchange is a wrong call order:
        # the invalid-state RuntimeError, not an SDK error.
        auth = _create_authenticator()

        with pytest.raises(RuntimeError) as exc_info:
            auth.get_auth_headers()
        assert type(exc_info.value) is RuntimeError
        assert not isinstance(exc_info.value, {{errorPrefix}}Exception)

    def test_get_host_returns_configured_host(self) -> None:
        auth = _create_authenticator()

        assert auth.get_host() == 'https://api.example.com'

    def test_redacts_secret(self) -> None:
        """The repr masks the client_secret as ``***`` and never leaks it."""
        auth = _create_authenticator()
        rendered = repr(auth)
        assert 'my_secret' not in rendered
        assert '***' in rendered

    def test_auth_headers_before_exchange_returns_recoverable_error(self) -> None:
        auth = _create_authenticator()

        # Calling get_auth_headers before exchange_code is a precondition
        # violation. It must surface as a catchable exception so callers
        # can recover -- not as a process crash.
        caught: RuntimeError | None = None
        try:
            auth.get_auth_headers()
        except RuntimeError as e:
            caught = e
        assert caught is not None, 'expected get_auth_headers to raise before exchange_code'

        # Caller continues normally after catching -- no process crash.
        assert auth.get_host() == 'https://api.example.com'

    def test_authorize_url_with_existing_query_string_uses_amp_separator(self) -> None:
        # RFC 6749 §3.1: the authorization endpoint URI MAY already include
        # a query component (e.g. tenant-scoped Auth0 URLs). The builder
        # must preserve existing query items alongside the OAuth2 ones
        # using '&' as the separator, not '?'.
        auth = OAuth2AuthorizationCodeAuthenticator(
            host='https://api.example.com',
            client_id='my_client_id',
            client_secret='my_secret',
            authorization_url='https://x.auth0.com/authorize?audience=api',
            token_url='https://x.auth0.com/oauth/token',
            redirect_uri='https://app.example.com/callback',
            scopes=['read'],
        )

        url = auth.build_authorization_url()

        assert 'audience=api' in url, f'existing query param must be preserved: {url}'
        assert 'response_type=code' in url, f'response_type must be appended: {url}'
        assert url.count('?') == 1, f"result must contain exactly one '?': {url}"


def _code_reply(**fields: object) -> ApiHttpResponse:
    return ApiHttpResponse(
        status_code=200,
        body=json.dumps(fields),
        headers={"content-type": "application/json"},
    )


class TestAuthorizationUrlEncoding:
    def test_authorize_url_separates_scopes_with_percent_20(self) -> None:
        url = _create_authenticator().build_authorization_url()

        assert url == (
            "https://auth.example.com/authorize?response_type=code"
            "&client_id=my_client_id"
            "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback"
            "&scope=read%20write"
        )

    def test_authorize_url_keeps_unreserved_marks_and_encodes_the_sub_delimiters(
        self,
    ) -> None:
        auth = OAuth2AuthorizationCodeAuthenticator(
            host="https://api.example.com",
            client_id="id~*!'()",
            client_secret="my_secret",
            authorization_url="https://auth.example.com/authorize",
            token_url="https://auth.example.com/token",
            redirect_uri="https://app.example.com/callback",
            scopes=["a*b", "c!d"],
        )

        url = auth.build_authorization_url(state="s t~(1)")

        assert url == (
            "https://auth.example.com/authorize?response_type=code"
            "&client_id=id~%2A%21%27%28%29"
            "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback"
            "&scope=a%2Ab%20c%21d&state=s%20t~%281%29"
        )

    def test_code_exchange_body_keeps_unreserved_marks_and_encodes_the_sub_delimiters(
        self,
    ) -> None:
        auth = OAuth2AuthorizationCodeAuthenticator(
            host="https://api.example.com",
            client_id="id~*",
            client_secret="s!'()",
            authorization_url="https://auth.example.com/authorize",
            token_url="https://auth.example.com/token",
            redirect_uri="https://app.example.com/callback",
            scopes=["read"],
        )
        mock_client = MagicMock()
        mock_client.send_request.return_value = _code_reply(
            access_token="at", expires_in=3600
        )
        auth.set_api_client(mock_client)

        auth.exchange_code("c~*(1)")

        assert mock_client.send_request.call_args[0][3] == (
            "grant_type=authorization_code&code=c~%2A%281%29&client_id=id~%2A"
            "&client_secret=s%21%27%28%29"
            "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback"
        )


class TestAuthorizationCodeRefreshUrlRouting:
    @staticmethod
    def _urls_of_exchange_then_refresh(refresh_url: Any) -> list[str]:
        auth = OAuth2AuthorizationCodeAuthenticator(
            host="https://api.example.com",
            client_id="my_client_id",
            client_secret="my_secret",
            authorization_url="https://auth.example.com/authorize",
            token_url="https://auth.example.com/token",
            redirect_uri="https://app.example.com/callback",
            scopes=["read"],
            refresh_url=refresh_url,
        )
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=0),
            _code_reply(access_token="t2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)

        auth.exchange_code("code")
        auth.get_auth_headers()

        return [call[0][1] for call in mock_client.send_request.call_args_list]

    def test_code_goes_to_the_token_url_and_the_refresh_to_the_refresh_url(
        self,
    ) -> None:
        assert self._urls_of_exchange_then_refresh(
            "https://auth.example.com/oauth/refresh"
        ) == [
            "https://auth.example.com/token",
            "https://auth.example.com/oauth/refresh",
        ]

    def test_refresh_falls_back_to_the_token_url_without_a_refresh_url(self) -> None:
        assert self._urls_of_exchange_then_refresh(None) == [
            "https://auth.example.com/token",
            "https://auth.example.com/token",
        ]


def _code_error(error: str) -> ApiHttpResponse:
    return ApiHttpResponse(
        status_code=400,
        body=json.dumps({"error": error}),
        headers={"content-type": "application/json"},
    )


def _form_of(call: Any) -> dict[str, list[str]]:
    return parse_qs(call[0][3], keep_blank_values=True)


class TestAuthorizationCodeSession:
    def test_the_refresh_carries_the_client_credentials(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=1),
            _code_reply(access_token="t2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)
        auth.exchange_code("a")

        auth.get_auth_headers()

        assert _form_of(mock_client.send_request.call_args_list[1]) == {
            "grant_type": ["refresh_token"],
            "refresh_token": ["r1"],
            "client_id": ["my_client_id"],
            "client_secret": ["my_secret"],
        }

    def test_a_rejected_refresh_surfaces_after_exactly_one_refresh_post(self) -> None:
        from {{packageName}}.errors import OAuth2ServerException

        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=1),
            _code_error("invalid_grant"),
            _code_reply(access_token="unexpected", expires_in=3600),
        ]
        auth.set_api_client(mock_client)
        auth.exchange_code("a")

        with pytest.raises(OAuth2ServerException) as excinfo:
            auth.get_auth_headers()

        assert excinfo.value.code == "invalid_grant"
        assert mock_client.send_request.call_count == 2

    def test_a_second_exchange_sends_the_new_code(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=3600),
            _code_reply(access_token="t2", refresh_token="r2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)
        auth.exchange_code("a")

        auth.exchange_code("b")

        second = _form_of(mock_client.send_request.call_args_list[1])
        assert second["grant_type"] == ["authorization_code"]
        assert second["code"] == ["b"]
        assert auth.get_auth_headers() == {"Authorization": "Bearer t2"}

    def test_a_second_exchange_without_a_refresh_token_drops_the_old_one(self) -> None:
        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=3600),
            _code_reply(access_token="t2", expires_in=1),
            _code_reply(access_token="t3", expires_in=3600),
        ]
        auth.set_api_client(mock_client)
        auth.exchange_code("a")
        auth.exchange_code("b")

        auth.get_auth_headers()

        third = _form_of(mock_client.send_request.call_args_list[2])
        assert third["refresh_token"] == [""]

    def test_a_failed_exchange_keeps_the_previous_session(self) -> None:
        from {{packageName}}.errors import OAuth2ServerException

        auth = _create_authenticator()
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=3600),
            _code_error("invalid_grant"),
        ]
        auth.set_api_client(mock_client)
        auth.exchange_code("a")

        with pytest.raises(OAuth2ServerException):
            auth.exchange_code("bad")

        assert auth.get_auth_headers() == {"Authorization": "Bearer t1"}
        assert mock_client.send_request.call_count == 2


class TestUserAuthWrapper:
    def test_uses_the_spec_urls_and_scopes(self) -> None:
        from {{packageName}}.auth.oauth.user_auth_authorization_code_authenticator import (
            UserAuthAuthorizationCodeAuthenticator,
        )

        auth = UserAuthAuthorizationCodeAuthenticator(
            "https://api.example.com", "cid", "sec", "https://app.example.com/cb"
        )
        mock_client = MagicMock()
        mock_client.send_request.side_effect = [
            _code_reply(access_token="t1", refresh_token="r1", expires_in=0),
            _code_reply(access_token="t2", expires_in=3600),
        ]
        auth.set_api_client(mock_client)

        assert auth.build_authorization_url() == (
            "https://auth.example.com/authorize?response_type=code&client_id=cid"
            "&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcb"
            "&scope=pets%3Awrite%20pets%3Aread"
        )
        auth.exchange_code("code")
        auth.get_auth_headers()

        first, second = mock_client.send_request.call_args_list
        assert first[0][1] == "https://auth.example.com/oauth/token"
        assert second[0][1] == "https://auth.example.com/oauth/refresh"


class TestAuthorizationCodeRedactedRepr:
    def test_repr_lists_the_non_secret_fields_and_masks_the_secret(self) -> None:
        assert repr(_create_authenticator()) == (
            "OAuth2AuthorizationCodeAuthenticator(host='https://api.example.com', "
            "client_id='my_client_id', client_secret='***', "
            "authorization_url='https://auth.example.com/authorize', "
            "token_url='https://auth.example.com/token', "
            "redirect_uri='https://app.example.com/callback', "
            "scopes=('read', 'write'))"
        )
