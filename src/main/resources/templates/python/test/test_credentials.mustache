"""Unit tests for resolve_credential: the order every per-scheme credential follows."""

import pytest

from {{packageName}}.auth._credentials import resolve_credential

VARIABLE = 'SDK_TEST_CREDENTIAL'


class TestResolveCredential:

    def test_bhv_authscheme_009_a_passed_value_wins_over_the_environment(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv(VARIABLE, 'from-environment')

        assert resolve_credential('passed', VARIABLE, 'token') == 'passed'

    def test_the_environment_fills_a_value_that_was_not_passed(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv(VARIABLE, 'from-environment')

        assert resolve_credential(None, VARIABLE, 'token') == 'from-environment'

    def test_an_empty_environment_value_counts_as_unset(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.setenv(VARIABLE, '')

        with pytest.raises(ValueError, match=VARIABLE):
            resolve_credential(None, VARIABLE, 'token')

    def test_a_credential_found_nowhere_names_the_variable(self, monkeypatch: pytest.MonkeyPatch) -> None:
        monkeypatch.delenv(VARIABLE, raising=False)

        with pytest.raises(ValueError, match="'token'.*" + VARIABLE):
            resolve_credential(None, VARIABLE, 'token')

    def test_an_empty_passed_value_is_kept_for_the_authenticator_to_reject(
        self, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        monkeypatch.setenv(VARIABLE, 'from-environment')

        assert resolve_credential('', VARIABLE, 'token') == ''
