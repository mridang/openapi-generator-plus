class TestBasicRedactedRepr:
    def test_bhv_authbasic_010_repr_lists_the_non_secret_fields_and_masks_the_password(self) -> None:
        auth = BasicAuthenticator(
            host="https://api.example.com", username="alice", password="s3cret"
        )

        assert repr(auth) == (
            "BasicAuthenticator(host='https://api.example.com', "
            "username='alice', password='***')"
        )

    def test_bhv_authbasic_020_password_is_masked_in_debug_output(self) -> None:
        auth = BasicAuthenticator(host="https://api.example.com", username="alice", password="s3cret")

        assert "s3cret" not in repr(auth)
        assert "s3cret" not in str(auth)
        assert "password='***'" in str(auth)


class TestBasicSchemeWrappers:
    def test_bhv_authbasic_001_reads_credentials_from_the_environment_when_none_passed(
        self, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        import importlib

        monkeypatch.setenv('SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_USERNAME', 'alice')
        monkeypatch.setenv('SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_PASSWORD', 's3cret')
        cls = getattr(importlib.import_module('{{packageName}}.auth.pet_store_basic_authenticator'), 'PetStoreBasicAuthenticator')

        auth = cls('https://api.example.com')

        assert auth.get_auth_headers() == {'Authorization': 'Basic YWxpY2U6czNjcmV0'}

    @pytest.mark.parametrize('username_value', [None, ''])
    def test_bhv_authbasic_003_missing_or_empty_credentials_fail_at_construction(
        self, monkeypatch: pytest.MonkeyPatch, username_value: str | None
    ) -> None:
        import importlib

        monkeypatch.delenv('SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_USERNAME', raising=False)
        if username_value is not None:
            monkeypatch.setenv('SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_USERNAME', username_value)
        monkeypatch.setenv('SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_PASSWORD', 's3cret')
        cls = getattr(importlib.import_module('{{packageName}}.auth.pet_store_basic_authenticator'), 'PetStoreBasicAuthenticator')

        with pytest.raises(ValueError, match='Missing the credential'):
            cls('https://api.example.com')

    @pytest.mark.parametrize(
        ("module", "name"),
        [
            ("admin_basic_authenticator", "AdminBasicAuthenticator"),
            ("pet_store_basic_authenticator", "PetStoreBasicAuthenticator"),
        ],
    )
    def test_bhv_authbasic_002_wrapper_sends_basic_credentials_and_still_validates(
        self, module: str, name: str
    ) -> None:
        import importlib

        cls = getattr(importlib.import_module(f"{{packageName}}.auth.{module}"), name)

        auth = cls("https://api.example.com", "alice", "s3cret")

        assert auth.get_auth_headers() == {"Authorization": "Basic YWxpY2U6czNjcmV0"}
        assert "s3cret" not in repr(auth)
        with pytest.raises(ValueError):
            cls("https://api.example.com", "ali:ce", "s3cret")


class TestBasicBehaviours:
    def test_bhv_auth_018_a_password_never_appears_in_a_refusal_or_in_the_printable_form(self) -> None:
        with pytest.raises(ValueError) as excinfo:
            BasicAuthenticator(host='https://api.example.com', username='ali:ce', password='s3cr3t')
        auth = BasicAuthenticator(host='https://api.example.com', username='alice', password='s3cr3t')

        assert 's3cr3t' not in str(excinfo.value)
        assert 's3cr3t' not in repr(auth)

    def test_bhv_errors_081_a_refused_username_is_named_as_the_fault(self) -> None:
        with pytest.raises(ValueError, match='username'):
            BasicAuthenticator(host='https://api.example.com', username='alice\r\n', password='s3cret')

    def test_bhv_lang_python_037_a_refused_password_is_named_as_the_fault(self) -> None:
        with pytest.raises(ValueError, match='password'):
            BasicAuthenticator(host='https://api.example.com', username='alice', password='s3c\x00ret')
