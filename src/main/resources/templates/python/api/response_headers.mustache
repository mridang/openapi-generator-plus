from __future__ import annotations

import re
from dataclasses import dataclass
from typing import Callable, List, Mapping, Optional, TypeVar

from {{packageName}}.errors.serialization_exception import SerializationException

_T = TypeVar('_T')

_INTEGER = re.compile(r'[+-]?[0-9]+')
_NUMBER = re.compile(r'[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?')


@dataclass(frozen=True)
class {{className}}:
    """The headers the {{operationId}} operation declares on its success response.

    Each field holds its header read in the declared type, or ``None`` when the
    response did not carry it. Build one from the raw response headers with
    :meth:`from_headers`.
    """

{{#responseHeaders}}
{{#hasDescription}}
    #: {{{description}}}
{{/hasDescription}}
{{#hasExample}}
    #: Example: >>> {{{example}}}
{{/hasExample}}
    {{varName}}: Optional[{{#isArray}}List[{{/isArray}}{{#isString}}str{{/isString}}{{#isInteger}}int{{/isInteger}}{{#isLong}}int{{/isLong}}{{#isNumber}}float{{/isNumber}}{{#isBoolean}}bool{{/isBoolean}}{{#isArray}}]{{/isArray}}] = None
{{/responseHeaders}}

    @classmethod
    def from_headers(cls, headers: Mapping[str, str]) -> {{className}}:
        """Read the declared headers from ``headers``, matching each name in any case.

        Raises:
            SerializationException: If a header value does not parse as its
                declared type.
        """
        lowered = {name.lower(): value for name, value in headers.items()}
        return cls(
{{#responseHeaders}}
            {{varName}}=_read{{#isArray}}_list{{/isArray}}(lowered, '{{{wireName}}}', '{{kind}}', {{#isString}}_to_str{{/isString}}{{#isInteger}}_to_int{{/isInteger}}{{#isLong}}_to_int{{/isLong}}{{#isNumber}}_to_float{{/isNumber}}{{#isBoolean}}_to_bool{{/isBoolean}}),
{{/responseHeaders}}
        )


def _to_str(value: str) -> str:
    return value


def _to_int(value: str) -> int:
    if _INTEGER.fullmatch(value) is None:
        raise ValueError(value)
    return int(value)


def _to_float(value: str) -> float:
    if _NUMBER.fullmatch(value) is None:
        raise ValueError(value)
    return float(value)


def _to_bool(value: str) -> bool:
    if value == 'true':
        return True
    if value == 'false':
        return False
    raise ValueError(value)


def _parse(name: str, kind: str, value: str, parse: Callable[[str], _T]) -> _T:
    try:
        return parse(value)
    except ValueError as exc:
        raise SerializationException(
            f"Response header '{name}' is not a valid {kind}: '{value}'", exc
        ) from exc


def _read(
    headers: Mapping[str, str], name: str, kind: str, parse: Callable[[str], _T]
) -> Optional[_T]:
    value = headers.get(name.lower())
    return None if value is None else _parse(name, kind, value, parse)


def _read_list(
    headers: Mapping[str, str], name: str, kind: str, parse: Callable[[str], _T]
) -> Optional[List[_T]]:
    value = headers.get(name.lower())
    if value is None:
        return None
    return [_parse(name, kind, item.strip(), parse) for item in value.split(',')]
