_PATTERNS: Dict[str, Optional[Pattern[str]]] = {}


def validate_request_body(body: Any) -> None:
    """Check a request body before it is serialized.

    A body that is not one of the models with a check, or a list of them,
    passes unchecked.

    Args:
        body: The request body as the operation was given it.

    Raises:
        ValueError: Naming the path and the rule of the first violation.
    """
    if isinstance(body, (list, tuple)):
        for index, item in enumerate(body):
            _check_model(item, f'[{index}]')
        return
    _check_model(body, '')


def _check_model(value: Any, prefix: str) -> None:
    """Check a value that may be one of the models with a check, by its class or a base class."""
    for klass in type(value).__mro__:
        check = _CHECKS.get(klass)
        if check is not None:
            check(value, prefix)
            return


def _refuse(path: str, rule: str) -> NoReturn:
    """Raise the argument error for a violation."""
    raise ValueError(f'Invalid request body: {path} {rule}')


def _join(prefix: str, name: str) -> str:
    """The path of a property below a prefix."""
    return f'{prefix}.{name}' if prefix else name


def _is_number(value: Any) -> bool:
    """Whether a value is a number the numeric keywords apply to."""
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _size(value: Any) -> int:
    """The number of items of a list or set, or of keys of a map; -1 for anything else."""
    return len(value) if isinstance(value, (list, tuple, set, frozenset, dict)) else -1


def _is_multiple_of(value: Any, limit: float) -> bool:
    """Whether a number is a multiple of a limit, within 1e-9 of a whole quotient."""
    quotient = value / limit
    return bool(abs(quotient - round(quotient)) < 1e-9)


def _matches(value: str, pattern: str) -> bool:
    """Whether a string contains a match of a pattern; a pattern ``re`` cannot compile always matches."""
    if pattern not in _PATTERNS:
        try:
            _PATTERNS[pattern] = re.compile(pattern)
        except re.error:
            _PATTERNS[pattern] = None
    compiled = _PATTERNS[pattern]
    return compiled is None or compiled.search(value) is not None
