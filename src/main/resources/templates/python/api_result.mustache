from dataclasses import dataclass
from types import MappingProxyType
from typing import Generic, Mapping, Optional, TypeVar

T = TypeVar('T')


@dataclass(frozen=True)
class ApiResult(Generic[T]):
    """Represents a typed API response with deserialized data, status code,
    raw body, and headers. Returned by ``with_http_info`` methods.
    """

    status_code: int
    data: Optional[T]
    # The raw response body is always populated by the transport (an empty
    # string when the server sent no body), so it is never null.
    raw_body: str
    headers: Mapping[str, str]

    def __post_init__(self) -> None:
        # Take a read-only copy so the result never aliases (or lets a caller
        # mutate) the transport's own header map.
        object.__setattr__(self, 'headers', MappingProxyType(dict(self.headers)))
