{{#clientSchemes}}
        {{paramName}}: Optional[Authenticator] = None,
{{/clientSchemes}}
{{/hasClientSchemes}}
    ) -> None:
        """Creates a new client from its credentials and transport options.

        Each security scheme of the API has one optional credential, named
        after the scheme. An operation uses the credential of the first scheme
        its spec lists that you configured, and there is no per-call override.
        When none of its schemes is configured it uses ``authenticator`` if you
        give one, and otherwise sends no credential. The base URL comes from the
        first credential given, ``authenticator`` first.

        If a credential implements :class:`HttpAwareAuthenticator`, the shared
        :class:`ApiClient` is injected so that token exchange and discovery
        requests use the same proxy, TLS, and timeout settings.

        Args:
            authenticator: The default credential, used by an operation that
                no scheme credential matches.
            transport_options: HTTP transport configuration (proxy, TLS,
                timeouts, etc.).
            pool_manager: A ``urllib3.PoolManager`` you own. The SDK defaults
                (timeout, redirects, user agent, default headers) are applied
                on top of it and the SDK never closes it. It cannot be
                combined with a proxy or TLS setting in ``transport_options``;
                a conflict raises :class:`ValueError`.
            call_hook: A :class:`CallHook` that runs around every operation
                call: it can edit the request headers and observe the outcome.
{{#clientSchemes}}
            {{paramName}}: The credential of the ``{{{schemeId}}}`` security scheme.
{{/clientSchemes}}

        Raises:
            ValueError: If no credential is given at all.
        """
        schemes: Dict[str, Authenticator] = {}
{{#clientSchemes}}
        if {{paramName}} is not None:
            schemes["{{{schemeLiteral}}}"] = {{paramName}}
{{/clientSchemes}}
        credentials = ([authenticator] if authenticator is not None else []) + list(schemes.values())
        if not credentials:
            raise ValueError('At least one credential is required')

        if transport_options is None:
            transport_options = TransportOptions.builder().build()

        api_client = DefaultApiClient(transport_options, pool_manager)
        self._api_client = api_client

        for credential in credentials:
            if isinstance(credential, HttpAwareAuthenticator):
                credential.set_api_client(api_client)

        config = (
            Configuration.builder()
            .base_url(credentials[0].get_host())
            .call_hook(call_hook)
            .build()
        )
{{#apiInfo}}
