    @classmethod
    def with_token(
        cls,
        host: Optional[str] = None,
        access_token: Optional[str] = None,
        transport_options: Optional[TransportOptions] = None,
        pool_manager: Optional[Any] = None,
        token_provider: Optional[Callable[[], str]] = None,
        call_hook: Optional[CallHook] = None,
    ) -> '{{clientClassName}}':
        """Creates a client authenticated with a Bearer token.

        Each credential is resolved once, here, in this order: the argument
        you pass, then the environment variable (an empty value counts as
        unset). ``host`` falls back to ``{{envPrefix}}_BASE_URL`` and
        ``access_token`` to ``{{envPrefix}}_ACCESS_TOKEN``. Instead of a
        static token you can pass ``token_provider``, a callable that returns
        the current token and runs for every request.

        Args:
            host: API base URL.
            access_token: Bearer token.
            transport_options: Optional HTTP transport configuration (proxy,
                TLS, timeouts, etc.).
            pool_manager: Optional caller-owned ``urllib3.PoolManager``.
            token_provider: Optional callable returning the current token.
                It replaces ``access_token`` and the environment variable.
            call_hook: Optional :class:`CallHook` around every operation call.

        Returns:
            Configured client instance.

        Raises:
            ValueError: If the host or the token cannot be resolved, or both
                ``access_token`` and ``token_provider`` are given.
        """
        resolved_host = host if host is not None else _from_environment('BASE_URL')
        if resolved_host is None:
            raise ValueError(
                'The API host is required: pass host or set {{envPrefix}}_BASE_URL'
            )
        if token_provider is not None:
            if access_token is not None:
                raise ValueError('Give an access token or a token provider, not both')
            authenticator = BearerAuthenticator(resolved_host, token_provider=token_provider)
        else:
            resolved_token = (
                access_token if access_token is not None else _from_environment('ACCESS_TOKEN')
            )
            if resolved_token is None:
                raise ValueError(
                    'The access token is required: pass access_token or token_provider, '
                    'or set {{envPrefix}}_ACCESS_TOKEN'
                )
            authenticator = BearerAuthenticator(resolved_host, resolved_token)
        return cls(authenticator, transport_options, pool_manager, call_hook)

    @classmethod
    def with_authenticator(
        cls,
        authenticator: Authenticator,
        transport_options: Optional[TransportOptions] = None,
        pool_manager: Optional[Any] = None,
        call_hook: Optional[CallHook] = None,
    ) -> '{{clientClassName}}':
        """Creates a client from a ready-made authenticator.

        This is the generic entry point for bespoke authentication strategies
        such as OAuth2 client credentials, JWT private-key (service account),
        or a personal access token (PAT). Supply any :class:`Authenticator`
        implementation; if it also implements :class:`HttpAwareAuthenticator`,
        the shared :class:`ApiClient` is injected so its HTTP calls reuse the
        same transport configuration.

        Args:
            authenticator: Provides host URL and auth headers.
            transport_options: Optional HTTP transport configuration (proxy,
                TLS, timeouts, etc.).
            pool_manager: Optional caller-owned ``urllib3.PoolManager``.
            call_hook: Optional :class:`CallHook` around every operation call.

        Returns:
            Configured client instance.
        """
        return cls(authenticator, transport_options, pool_manager, call_hook)

    def close(self) -> None:
        """Closes the client gracefully; calling it again does nothing.

        Requests already in flight finish, and the pool this client created is
        released when the last of them completes. A request started afterwards
        raises :class:`RuntimeError`. A ``pool_manager`` you supplied is never
        closed. To abandon one request, cancel the asyncio task awaiting it.
        """
        self._api_client.close()

    def __enter__(self) -> '{{clientClassName}}':
        return self

    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
        self.close()
