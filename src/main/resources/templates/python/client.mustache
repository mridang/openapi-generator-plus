def _from_environment(field: str) -> Optional[str]:
    """The value of ``{{envPrefix}}_<field>``, or ``None`` when it is unset or empty."""
    return os.environ.get('{{envPrefix}}_' + field) or None


class {{clientClassName}}:
    """Unified entry point for all API services.

    Takes an :class:`Authenticator` and optionally :class:`TransportOptions`,
    then exposes each API group as a typed property. If the authenticator
    implements :class:`HttpAwareAuthenticator`, the shared :class:`ApiClient`
    is injected so that authentication HTTP calls (token exchange, discovery)
    use the same transport configuration as regular API calls.

    Usage::

        # Default transport
        client = {{clientClassName}}(authenticator)

        # Custom transport (proxy, timeouts, etc.)
        transport = TransportOptions.builder() \\
            .proxy('http://proxy:3128') \\
            .timeout(5000) \\
            .build()
        client = {{clientClassName}}(authenticator, transport)

        # Your own urllib3 pool manager (you keep ownership and close it)
        client = {{clientClassName}}(authenticator, pool_manager=urllib3.PoolManager())
    """

    def __init__(
        self,
        authenticator: Authenticator,
        transport_options: Optional[TransportOptions] = None,
        pool_manager: Optional[Any] = None,
    ) -> None:
        """Creates a new client with the given authenticator and transport options.

        If the authenticator implements :class:`HttpAwareAuthenticator`, the
        shared :class:`ApiClient` is injected so that token exchange and
        discovery requests use the same proxy, TLS, and timeout settings.

        Args:
            authenticator: Provides host URL and auth headers.
            transport_options: HTTP transport configuration (proxy, TLS,
                timeouts, etc.).
            pool_manager: A ``urllib3.PoolManager`` you own. The SDK defaults
                (timeout, redirects, user agent, default headers) are applied
                on top of it and the SDK never closes it. It cannot be
                combined with a proxy or TLS setting in ``transport_options``;
                a conflict raises :class:`ValueError`.
        """
        if transport_options is None:
            transport_options = TransportOptions.builder().build()

        api_client = DefaultApiClient(transport_options, pool_manager)
        self._api_client = api_client

        if isinstance(authenticator, HttpAwareAuthenticator):
            authenticator.set_api_client(api_client)

        config = (
            Configuration.builder()
            .base_url(authenticator.get_host())
            .build()
        )
