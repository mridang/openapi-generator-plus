class Client:
    """Unified entry point for all API services.

    Takes an :class:`Authenticator` and exposes each API group as a typed
    property.
    """

    def __init__(self, authenticator: Authenticator) -> None:
        """Creates a new client with the given authenticator.

        Args:
            authenticator: Provides host URL and auth headers.
        """
        config = Configuration()
        config.base_url = authenticator.get_host()
        config.default_headers.update(authenticator.get_auth_headers())
        api_client = DefaultApiClient(config)
{{#apiInfo}}
