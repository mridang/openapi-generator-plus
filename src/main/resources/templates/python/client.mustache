def _from_environment(field: str) -> Optional[str]:
    """The value of ``{{envPrefix}}_<field>``, or ``None`` when it is unset or empty."""
    return os.environ.get('{{envPrefix}}_' + field) or None


class {{clientClassName}}:
    """Unified entry point for all API services.

    Takes credentials and optionally :class:`TransportOptions`, then exposes
    each API group as a typed property. Each security scheme of the API has one
    optional credential, a keyword argument named after the scheme{{#clientSchemes}}{{#-first}} (``{{/-first}}{{paramName}}{{^-last}}``, ``{{/-last}}{{#-last}}``){{/-last}}{{/clientSchemes}}.
    An operation uses the credential of the first scheme its spec lists that
    you configured; there is no per-call override. A single ``authenticator``
    is the default for an operation none of whose schemes you configured. If a
    credential implements :class:`HttpAwareAuthenticator`, the shared
    :class:`ApiClient` is injected so that authentication HTTP calls (token
    exchange, discovery) use the same transport configuration as regular API
    calls.

    Usage::

        # One default authenticator, default transport
        client = {{clientClassName}}(authenticator)
{{#clientSchemes}}
{{#-first}}

        # One credential per security scheme
        client = {{clientClassName}}({{paramName}}={{className}}(...))
{{/-first}}
{{/clientSchemes}}

        # Custom transport (proxy, timeouts, etc.)
        transport = TransportOptions.builder() \\
            .proxy('http://proxy:3128') \\
            .timeout(5000) \\
            .build()
        client = {{clientClassName}}(authenticator, transport)

        # Your own urllib3 pool manager (you keep ownership and close it)
        client = {{clientClassName}}(authenticator, pool_manager=urllib3.PoolManager())
    """

    def __init__(
        self,
        authenticator: Optional[Authenticator] = None,
        transport_options: Optional[TransportOptions] = None,
        pool_manager: Optional[Any] = None,
        call_hook: Optional[CallHook] = None,
{{#hasClientSchemes}}
