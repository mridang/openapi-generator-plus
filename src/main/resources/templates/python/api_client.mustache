from typing import Any, Dict, Optional, Protocol, runtime_checkable

from {{packageName}}.api_http_response import ApiHttpResponse
from {{packageName}}.api_stream_response import ApiStreamResponse


@runtime_checkable
class ApiClient(Protocol):
    """Interface for API HTTP transport.

    Implementations handle the actual HTTP request/response cycle.
    The default implementation uses urllib3. Implementations that own a
    connection pool should additionally provide ``close()`` and the
    context-manager protocol (``__enter__``/``__exit__``) so callers can
    release sockets deterministically via ``with``; this Protocol does
    not require those methods so test fixtures and lightweight stubs
    don't have to implement them.
    """

    def send_request(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        no_redirect: bool = False,
    ) -> ApiHttpResponse:
        """Send an HTTP request and return the response.

        :param method: HTTP method (GET, POST, PUT, DELETE, etc.)
        :param url: Fully qualified URL
        :param headers: HTTP headers
        :param body: Request body (serialized JSON string, bytes, dict for multipart, a :class:`BodySource`, or None).
            A body source is read with ``body.open()`` as it is sent, never buffered; ``body.replayable`` says
            whether a redirect may send it again
        :param no_redirect: When ``True``, the implementation must NOT follow
            any redirect on this request and must return the first 3xx
            response verbatim so the caller can inspect and reject it itself;
            the implementation must not raise on its own for a 3xx. Used by
            OAuth2 token requests so that a malicious 307/308 cannot replay
            the credential-bearing token POST against an attacker-controlled
            endpoint — the token manager checks the returned status code and
            refuses to follow it. When ``False`` (the default), the
            implementation follows redirects per its usual security guards.
            A ``no_redirect`` request also carries no transport-level default
            headers, so credentials meant for the API never reach the token
            endpoint.
        :return: ApiHttpResponse containing status code, body, and headers
        """
        ...


@runtime_checkable
class StreamingApiClient(Protocol):
    """The optional second interface of a transport that can return a response
    whose body is not read yet.

    A transport that was written before streaming implements :class:`ApiClient`
    only and keeps working for every buffered call. The SDK checks for this
    interface at call time: a call that needs a stream and finds a transport
    without ``send_streaming`` fails with :class:`NotImplementedError` naming the
    transport, and never falls back to buffering (a buffered fallback would never
    end on an endless feed). A Protocol cannot hand a default method to a class
    that only matches it structurally, so the default is that check.
    """

    def send_streaming(
        self,
        method: str,
        url: str,
        headers: Dict[str, str],
        body: Any = None,
        idle_timeout: Optional[int] = None,
    ) -> ApiStreamResponse:
        """Send an HTTP request and return as soon as the response headers are accepted,
        with the body not read yet.

        The redirect, authentication and header rules are those of
        :meth:`ApiClient.send_request`, up to the headers. The retries are the SDK's,
        which sends the request again before the first body byte only. A non-2xx
        response is returned like any other, with its body open. The call blocks
        until the headers arrive and runs on a worker thread.

        :param method: HTTP method (GET, POST, PUT, DELETE, etc.)
        :param url: Fully qualified URL
        :param headers: HTTP headers
        :param body: Request body (serialized JSON string, bytes, dict for multipart, a :class:`BodySource`, or None).
            A body source is read with ``body.open()`` as it is sent, never buffered; ``body.replayable`` says
            whether a redirect may send it again
        :param idle_timeout: The longest silence in the body in milliseconds, ``0`` to
            disable it, or ``None`` for the transport's setting
        :return: ApiStreamResponse with the status code, the lower-cased headers and the open body
        """
        ...
