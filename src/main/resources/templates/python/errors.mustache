import json
import re
from typing import Any, Callable, Dict, Mapping, Optional, Type, TypeVar

from {{packageName}}.transport_options import _is_sensitive_header

T = TypeVar('T')

# Builds the exception for one error schema an operation declares: it takes
# the status code, the response headers, the raw body, the request method and
# the request path. An operation hands the factories of its own declared error
# responses to ``ApiException.from_response``, which picks the one for the
# status that arrived.
ErrorFactory = Callable[
    [int, Optional[Mapping[str, str]], Optional[str], Optional[str], Optional[str]],
    'ApiException',
]

# Most bytes of the response body that ``str(error)`` renders; the full body
# stays on ``response_body``.
_MAX_RENDERED_BODY_BYTES = 1024
_CONTROL_CHARACTERS = re.compile(r'[\x00-\x1f\x7f]')
_NAMED_ESCAPES = {'\n': '\\n', '\r': '\\r', '\t': '\\t'}
_MASKED_RESPONSE_HEADERS = frozenset(
    ('set-cookie', 'www-authenticate', 'proxy-authenticate')
)


def _escape_control_character(match: 're.Match[str]') -> str:
    char = match.group(0)
    return _NAMED_ESCAPES.get(char) or f'\\x{ord(char):02X}'


def _rendered_headers(headers: Mapping[str, str]) -> Dict[str, str]:
    """The response headers with every credential value replaced by ``***``."""
    return {
        name: '***'
        if name.lower() in _MASKED_RESPONSE_HEADERS or _is_sensitive_header(name)
        else value
        for name, value in headers.items()
    }


def _rendered_body(body: str) -> str:
    """The body cut at 1 KiB, control characters escaped, and the bytes left out counted."""
    data = body.encode('utf-8', errors='replace')
    excess = len(data) - _MAX_RENDERED_BODY_BYTES
    text = (
        data[:_MAX_RENDERED_BODY_BYTES].decode('utf-8', errors='ignore')
        if excess > 0
        else body
    )
    text = _CONTROL_CHARACTERS.sub(_escape_control_character, text)
    return f'{text}... ({excess} more bytes)' if excess > 0 else text


class {{errorPrefix}}Exception(Exception):
    """The branded root exception for every error raised by this SDK.

    All SDK exceptions -- transport/HTTP errors (:class:`ApiException` and
    its typed subclasses), serde failures (:class:`SerializationException`)
    and OAuth2 token failures (:class:`OAuth2ServerException`,
    :class:`OAuth2TokenException`) -- inherit from this single root, so callers can catch everything with
    one ``except {{errorPrefix}}Exception``.
    """


class ApiException({{errorPrefix}}Exception):
    """Exception thrown when an API call fails."""

    def __init__(
        self,
        status_code: int = 0,
        message: Optional[str] = None,
        response_headers: Optional[Any] = None,
        response_body: Optional[str] = None,
        error_body: Optional[Any] = None,
        cause: Optional[BaseException] = None,
        request_method: Optional[str] = None,
        request_path: Optional[str] = None,
    ) -> None:
        # Forward the message to the base Exception so `args`, `str()` and
        # standard logging/pickling behave like every other SDK's exceptions.
        super().__init__(message)
        # Stored privately and exposed through read-only @property getters so
        # that a caught exception's fields cannot be mutated after the fact
        # (e.g. rewriting status_code on a re-raised error). The typed
        # subclasses (ClientException, ServerException, ...) inherit these.
        self._status_code = status_code
        self._message = message
        self._response_headers = response_headers
        self._response_body = response_body
        self._error_body = error_body
        self._request_method = request_method
        self._request_path = request_path
        # Same chaining a `raise ... from cause` produces, so the cause is
        # reachable as `__cause__` however the error was constructed.
        if cause is not None:
            self.__cause__ = cause

    @property
    def status_code(self) -> int:
        return self._status_code

    @property
    def message(self) -> Optional[str]:
        return self._message

    @property
    def response_headers(self) -> Optional[Any]:
        return self._response_headers

    @property
    def response_body(self) -> Optional[str]:
        return self._response_body

    @property
    def error_body(self) -> Optional[Any]:
        return self._error_body

    @property
    def request_method(self) -> Optional[str]:
        """The HTTP method of the request that failed (``GET``, ``POST``, ...)."""
        return self._request_method

    @property
    def request_path(self) -> Optional[str]:
        """The path of the request that failed, without its query string."""
        return self._request_path

    def _with_request(self, method: str, path: str) -> 'ApiException':
        """Record the request this error answers; the SDK calls it where it builds the error.

        The first complete attachment wins: a later one, or one missing its method or path, is ignored.
        """
        if self._request_method and self._request_path:
            return self
        if not method or not path:
            return self
        self._request_method = method
        self._request_path = path.split('?', 1)[0]
        return self

    @staticmethod
    def from_response(
        status_code: int,
        headers: Optional[Mapping[str, str]],
        body: Optional[str],
        request_method: Optional[str] = None,
        request_path: Optional[str] = None,
        error_schemas: Optional[Mapping[str, ErrorFactory]] = None,
    ) -> 'ApiException':
        """Build the exception that a non-2xx response with this status raises.

        This is the one status-to-exception mapping in the SDK: the API
        classes and the OpenID Connect discovery both use it.

        When ``error_schemas`` has a factory for the status (an exact status
        first, then a ``4XX`` or ``5XX`` range, then ``default``), the factory
        builds the exception of that error schema. A body that does not match
        the schema never hides the real error: the factory then returns the
        status exception with the raw body and the decoding failure as its
        cause. Without a factory the result is the status exception.

        Args:
            status_code: The HTTP status code of the response.
            headers: The response headers.
            body: The raw response body, if any.
            request_method: The HTTP method of the request, if known.
            request_path: The path of the request, query string stripped,
                if known.
            error_schemas: The operation's error factories by declared status
                (``'404'``, ``'4XX'``, ``'default'``), or ``None`` when it
                declares none.

        Returns:
            The status-specific subclass where there is one (for example
            :class:`NotFoundException` for 404), else :class:`ClientException`
            for any other 4xx, :class:`ServerException` for any other 5xx, and
            :class:`ApiException` for everything else.
        """
        if error_schemas is not None:
            factory = error_schemas.get(str(status_code))
            if factory is None and 400 <= status_code < 500:
                factory = error_schemas.get('4XX')
            if factory is None and 500 <= status_code < 600:
                factory = error_schemas.get('5XX')
            if factory is None:
                factory = error_schemas.get('default')
            if factory is not None:
                return factory(status_code, headers, body, request_method, request_path)
        message = f'API returned status code {status_code}'
        # An empty header map is a real (if unusual) error response and is
        # passed through as an empty dict; ``None`` means no response arrived
        # at all and stays ``None``, as in every other SDK.
        response_headers: Optional[Dict[str, str]] = (
            dict(headers) if headers is not None else None
        )
        error_body: Any = None
        if body:
            # Imported lazily so this module stays the foundational one in the
            # import graph: object_serializer imports SerializationException
            # from this package, so importing it at module top would form a
            # cycle.
            from {{packageName}}.object_serializer import ObjectSerializer

            try:
                # F5: route through parse_json so the depth-cap rejects
                # malicious 100k-deep error payloads before they exhaust the
                # interpreter's recursion limit.
                error_body = ObjectSerializer.parse_json(body)
            except SerializationException:
                error_body = None
        by_status: Dict[int, Type[ClientException] | Type[ServerException]] = {
            400: BadRequestException,
            401: UnauthorizedException,
            403: ForbiddenException,
            404: NotFoundException,
            409: ConflictException,
            422: UnprocessableEntityException,
            429: TooManyRequestsException,
            402: PaymentRequiredException,
            405: MethodNotAllowedException,
            408: RequestTimeoutException,
            410: GoneException,
            413: PayloadTooLargeException,
            415: UnsupportedMediaTypeException,
            423: LockedException,
            501: NotImplementedException,
            502: BadGatewayException,
            503: ServiceUnavailableException,
            504: GatewayTimeoutException,
            500: InternalServerErrorException,
        }
        specific = by_status.get(status_code)
        if specific is not None:
            return specific(
                message=message,
                response_headers=response_headers,
                response_body=body,
                error_body=error_body,
                request_method=request_method,
                request_path=request_path,
            )
        if 400 <= status_code < 500:
            return ClientException(
                status_code=status_code,
                message=message,
                response_headers=response_headers,
                response_body=body,
                error_body=error_body,
                request_method=request_method,
                request_path=request_path,
            )
        if 500 <= status_code < 600:
            return ServerException(
                status_code=status_code,
                message=message,
                response_headers=response_headers,
                response_body=body,
                error_body=error_body,
                request_method=request_method,
                request_path=request_path,
            )
        return ApiException(
            status_code=status_code,
            message=message,
            response_headers=response_headers,
            response_body=body,
            error_body=error_body,
            request_method=request_method,
            request_path=request_path,
        )

    @staticmethod
    def _decode_error_body(body: str, clazz: Type[T]) -> T:
        """Decode a response body as the schema an operation declares for an
        error status.

        Raises:
            SerializationException: If the body does not match the schema.
        """
        # Imported lazily: see :meth:`from_response`.
        from {{packageName}}.object_serializer import ObjectSerializer

        decoded = ObjectSerializer().deserialize(body, clazz)
        if decoded is None:
            raise SerializationException('Error body is empty')
        return decoded

    @staticmethod
    def _status_fallback(
        status_code: int,
        headers: Optional[Mapping[str, str]],
        body: Optional[str],
        request_method: Optional[str],
        request_path: Optional[str],
        cause: BaseException,
    ) -> 'ApiException':
        """The status exception for a response whose body did not match its
        declared schema: the one :meth:`from_response` gives, with the raw body
        and the decoding failure as its cause."""
        fallback = ApiException.from_response(
            status_code, headers, body, request_method, request_path
        )
        if fallback.__cause__ is None:
            fallback.__cause__ = cause
        return fallback

    @property
    def is_retryable(self) -> bool:
        """Whether repeating the request can succeed: the status is 408, 409,
        429 or a 5xx other than 501, the statuses the client itself retries."""
        status = self._status_code
        return status in (408, 409, 429) or (500 <= status <= 599 and status != 501)

    @property
    def request_id(self) -> Optional[str]:
        """The request id the server sent in the ``x-request-id`` response
        header, or ``None`` when the header is absent."""
        if not self._response_headers:
            return None
        for name, value in self._response_headers.items():
            if name.lower() == 'x-request-id':
                return str(value)
        return None

    def get_typed_error_body(self, clazz: Type[T]) -> Optional[T]:
        """Deserialize the response body into a typed object.

        Uses :class:`ObjectSerializer` to parse the raw response body
        into an instance of the given class.

        Args:
            clazz: The target type to deserialize to.

        Returns:
            The deserialized object, or ``None`` if the body is empty.
        """
        if not self.response_body:
            return None
        # Imported lazily so this module stays the foundational one in the
        # import graph: object_serializer imports SerializationException from
        # this package, so importing it at module top would form a cycle.
        from {{packageName}}.object_serializer import ObjectSerializer

        return ObjectSerializer().deserialize(self.response_body, clazz)

    def __str__(self) -> str:
        """Build a human-readable error message from the stored attributes.

        The headers have their credential values masked and the body is cut at
        1 KiB with control characters escaped, so one error never floods or
        forges a log line. The full values stay on ``response_headers`` and
        ``response_body``.
        """
        msg = self.message or 'Error message: the server returns an error'

        if self.request_method and self.request_path:
            msg += f'\nRequest: {self.request_method} {self.request_path}'
        if self.status_code:
            msg += f'\nHTTP status code: {self.status_code}'
        if self.response_headers:
            # Compact JSON with sorted keys and literal non-ASCII (D17), so the
            # line reads the same in all twelve SDKs.
            rendered = json.dumps(
                _rendered_headers(self.response_headers),
                sort_keys=True,
                separators=(',', ':'),
                ensure_ascii=False,
                default=str,
            )
            msg += f'\nResponse headers: {rendered}'
        if self.response_body:
            msg += f'\nResponse body: {_rendered_body(self.response_body)}'

        return msg


