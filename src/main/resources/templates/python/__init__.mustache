{{>api_info}}
__version__ = '{{packageVersion}}'

# Define package exports
__all__ = [
    {{#apiInfo}}{{#apis}}'{{classname}}',
    {{/apis}}{{/apiInfo}}'Authenticator',
    '{{clientClassName}}',
    'ApiClient',
    'Configuration',
    'TransportOptions',
    'ServerConfiguration',
    'ServerVariable',
    '{{errorPrefix}}Exception',
    'ApiException',
    'ClientException',
    'ServerException',
    'BadRequestException',
    'UnauthorizedException',
    'ForbiddenException',
    'NotFoundException',
    'ConflictException',
    'UnprocessableEntityException',
    'InternalServerErrorException',
    'NetworkException',
    'NetworkTimeoutException',
    'SerializationException',
    'OAuth2ServerException',
    'OAuth2TokenException',
    {{#hasHttpSignatureMethods}}'HttpSigningConfiguration',
    {{/hasHttpSignatureMethods}}{{#models}}{{#model}}'{{classname}}'{{^-last}},
    {{/-last}}{{#-last}},{{/-last}}{{/model}}{{/models}}
]

# import apis into sdk package
{{#apiInfo}}{{#apis}}from {{apiPackage}}.{{classFilename}} import {{classname}} as {{classname}}
{{/apis}}{{/apiInfo}}
# import ApiClient
from {{packageName}}.api_client import ApiClient as ApiClient
from {{packageName}}.auth.authenticator import Authenticator as Authenticator
from {{packageName}}.{{clientClassFile}} import {{clientClassName}} as {{clientClassName}}
from {{packageName}}.configuration import Configuration as Configuration
from {{packageName}}.transport_options import TransportOptions as TransportOptions
from {{packageName}}.server_configuration import ServerConfiguration as ServerConfiguration
from {{packageName}}.server_configuration import ServerVariable as ServerVariable
from {{packageName}}.errors import {{errorPrefix}}Exception as {{errorPrefix}}Exception
from {{packageName}}.errors import ApiException as ApiException
from {{packageName}}.errors import ClientException as ClientException
from {{packageName}}.errors import ServerException as ServerException
from {{packageName}}.errors import BadRequestException as BadRequestException
from {{packageName}}.errors import UnauthorizedException as UnauthorizedException
from {{packageName}}.errors import ForbiddenException as ForbiddenException
from {{packageName}}.errors import NotFoundException as NotFoundException
from {{packageName}}.errors import ConflictException as ConflictException
from {{packageName}}.errors import UnprocessableEntityException as UnprocessableEntityException
from {{packageName}}.errors import InternalServerErrorException as InternalServerErrorException
from {{packageName}}.errors import NetworkException as NetworkException
from {{packageName}}.errors import NetworkTimeoutException as NetworkTimeoutException
from {{packageName}}.errors import SerializationException as SerializationException
from {{packageName}}.errors import OAuth2ServerException as OAuth2ServerException
from {{packageName}}.errors import OAuth2TokenException as OAuth2TokenException
{{#hasHttpSignatureMethods}}
from {{packageName}}.signing import HttpSigningConfiguration as HttpSigningConfiguration
{{/hasHttpSignatureMethods}}

# import models into sdk package
{{#models}}
{{#model}}
from {{modelPackage}}.{{classFilename}} import (
    {{classname}} as {{classname}},
)
{{/model}}
{{/models}}
{{#recursionLimit}}

__import__('sys').setrecursionlimit({{{.}}})
{{/recursionLimit}}
