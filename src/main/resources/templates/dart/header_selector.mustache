/// HeaderSelector selects Accept and Content-Type headers for API requests
/// based on the MIME types declared in the OpenAPI specification.
class HeaderSelector {
  static final _jsonMIMEPattern = RegExp(r'^application/(json|[\w!#$&.+\-^_]+\+json)\s*(;|$)', caseSensitive: false);

  /// Selects the Accept and Content-Type headers for an API request.
  ///
  /// Parameters:
  ///   - [accept]: acceptable MIME types for the response
  ///   - [contentType]: the Content-Type for the request body
  ///   - [isMultipart]: whether this is a multipart request
  ///
  /// Returns a map of header names to values.
  Map<String, String> selectHeaders(
    List<String> accept,
    String contentType,
    bool isMultipart,
  ) {
    final headers = <String, String>{};

    final acceptHeader = _selectAcceptHeader(accept);
    if (acceptHeader.isNotEmpty) {
      headers['Accept'] = acceptHeader;
    }

    if (!isMultipart) {
      headers['Content-Type'] = contentType.isEmpty ? 'application/json' : contentType;
    }

    return headers;
  }

  /// Detects whether a string contains a valid JSON MIME type.
  bool isJsonMime(String searchString) {
    if (searchString.isEmpty) return false;
    return _jsonMIMEPattern.hasMatch(searchString);
  }

  String _selectAcceptHeader(List<String> accept) {
    final filtered = accept.where((s) => s.isNotEmpty).toList();

    if (filtered.isEmpty) return '';

    return filtered.join(', ');
  }
}
