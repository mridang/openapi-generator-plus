import '../../errors/serialization_exception.dart';

/// The headers the success response of the {{operationId}} operation declares,
/// read in their declared types from the raw response headers that a
/// `...WithHttpInfo` call returns in `ApiResult.headers`.
class {{className}} {
{{#rows}}
{{#hasDescription}}
  /// {{#lambda.dartDocLines}}{{#lambda.unescapeDocComment}}{{{description}}}{{/lambda.unescapeDocComment}}{{/lambda.dartDocLines}}
{{/hasDescription}}
{{^hasDescription}}
  /// The `{{wireName}}` response header, or null when the response did not
  /// carry it.
{{/hasDescription}}
  final {{{dartType}}}? {{varName}};

{{/rows}}
  /// Creates the headers from values already parsed.
  const {{className}}({
{{#rows}}
    this.{{varName}},
{{/rows}}
  });

  /// Reads each declared header from [headers] by name, in any case. An absent
  /// header leaves its field null; a value that does not parse as the declared
  /// type raises [SerializationException].
  factory {{className}}.from(Map<String, String> headers) => {{className}}(
{{#rows}}
{{#isArray}}
{{#hasParser}}
        {{varName}}: _read(
          headers,
          '{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}',
          (value) => _split(value)
              .map((item) => {{parser}}('{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}', item{{#isLong}}, 'long'{{/isLong}}))
              .toList(),
        ),
{{/hasParser}}
{{^hasParser}}
        {{varName}}: _read(headers, '{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}', _split),
{{/hasParser}}
{{/isArray}}
{{^isArray}}
{{#hasParser}}
        {{varName}}: _read(
          headers,
          '{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}',
          (value) => {{parser}}('{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}', value{{#isLong}}, 'long'{{/isLong}}),
        ),
{{/hasParser}}
{{^hasParser}}
        {{varName}}: _read(headers, '{{#lambda.dartString}}{{wireName}}{{/lambda.dartString}}', (value) => value),
{{/hasParser}}
{{/isArray}}
{{/rows}}
      );

  /// The value of the header [name] in [headers], compared without case, run
  /// through [parse]; null when the header is absent.
  static T? _read<T>(
    Map<String, String> headers,
    String name,
    T Function(String value) parse,
  ) {
    final wanted = name.toLowerCase();
    for (final entry in headers.entries) {
      if (entry.key.toLowerCase() == wanted) {
        return parse(entry.value);
      }
    }
    return null;
  }
{{#usesSplit}}

  /// The items of a list header: the value split on commas, each item trimmed.
  static List<String> _split(String value) =>
      value.split(',').map((item) => item.trim()).toList();
{{/usesSplit}}
{{#usesInteger}}

  /// [value] read as a base-10 integer with an optional sign; [kind] names the
  /// declared type in the error.
  static int _integer(String name, String value, [String kind = 'integer']) {
    final parsed = RegExp(r'^[+-]?[0-9]+$').hasMatch(value)
        ? int.tryParse(value, radix: 10)
        : null;
    if (parsed == null) {
      throw SerializationException(
          "Response header '$name' is not a valid $kind: '$value'");
    }
    return parsed;
  }
{{/usesInteger}}
{{#usesNumber}}

  /// [value] read as a decimal number.
  static double _number(String name, String value) {
    final parsed =
        RegExp(r'^[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$')
                .hasMatch(value)
            ? double.tryParse(value)
            : null;
    if (parsed == null) {
      throw SerializationException(
          "Response header '$name' is not a valid number: '$value'");
    }
    return parsed;
  }
{{/usesNumber}}
{{#usesBoolean}}

  /// [value] read as a boolean: exactly `true` or `false`.
  static bool _boolean(String name, String value) {
    if (value == 'true') {
      return true;
    }
    if (value == 'false') {
      return false;
    }
    throw SerializationException(
        "Response header '$name' is not a valid boolean: '$value'");
  }
{{/usesBoolean}}
}
