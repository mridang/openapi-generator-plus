import 'dart:async';

import 'byte_stream.dart';
import 'errors/serialization_exception.dart';
import 'event_stream.dart';

/// The items of a JSON Lines response, decoded one per line as they arrive.
/// Blank lines are skipped, and a last line without a newline counts. A line
/// that does not decode raises a [SerializationException] that names its
/// 1-based line number and ends the stream, as does a line over
/// `maxEventBytes`.
///
/// It is a single-subscription `Stream<T>`: iterate it with `await for`, and
/// call [close] (`try`/`finally`) when you stop early; cancelling the
/// subscription closes it too. [close] is idempotent and aborts the connection
/// instead of draining it. Closing the client cancels the streams still open.
/// [toString] shows the status code and the lines read, never the content.
final class JsonLinesStream<T> extends Stream<T> {
  /// Wraps an open response body. This stream owns `source` and closes it.
  JsonLinesStream(
    this._source,
    this._decoder,
    int maxLineBytes,
    this._method,
    this._path,
  ) : _lines = LineReader(_source, maxLineBytes);

  final ByteStream _source;
  final LineReader _lines;
  final T Function(String line) _decoder;
  final String _method;
  final String _path;
  int _lineNumber = 0;
  bool _listened = false;

  /// The HTTP status code of the response.
  int get statusCode => _source.statusCode;

  /// The lower-cased response headers.
  Map<String, String> get headers => _source.headers;

  @override
  StreamSubscription<T> listen(
    void Function(T event)? onData, {
    Function? onError,
    void Function()? onDone,
    bool? cancelOnError,
  }) {
    if (_listened) {
      throw StateError('A JsonLinesStream can be listened to only once');
    }
    _listened = true;
    late final StreamController<T> controller;
    StreamSubscription<T>? inner;
    controller = StreamController<T>(
      onListen: () {
        inner = _items().listen(
          controller.add,
          onError: controller.addError,
          onDone: controller.close,
        );
      },
      onPause: () => inner?.pause(),
      onResume: () => inner?.resume(),
      onCancel: () {
        unawaited(close());
        unawaited(inner?.cancel());
      },
    );
    return controller.stream.listen(
      onData,
      onError: onError,
      onDone: onDone,
      cancelOnError: cancelOnError,
    );
  }

  Stream<T> _items() async* {
    try {
      while (true) {
        final String? line;
        try {
          line = await _lines.readLine();
        } on OverLimit catch (tooLong) {
          throw _failure(
            'Line ${_lineNumber + 1} of the JSON Lines response is too long: '
            '${tooLong.message}',
            tooLong,
          );
        }
        if (line == null) {
          return;
        }
        _lineNumber++;
        if (line.trim().isEmpty) {
          continue;
        }
        final T item;
        try {
          item = _decoder(line);
        } on SerializationException catch (failure) {
          throw _failure(
            'Line $_lineNumber of the JSON Lines response does not decode: '
            '${failure.message}',
            failure,
          );
        }
        yield item;
      }
    } finally {
      await _source.close();
    }
  }

  SerializationException _failure(String message, Object cause) =>
      SerializationException(message, cause).withResponse(
        statusCode: _source.statusCode,
        responseHeaders: _source.headers,
        responseBody: '',
        requestMethod: _method,
        requestPath: _path,
      );

  /// Closes the stream and aborts the connection; later calls do nothing. A
  /// listener that is still reading sees the stream end.
  Future<void> close() => _source.close();

  /// Describes the stream by its status code and the lines read; the headers
  /// and the content are never shown.
  @override
  String toString() =>
      'JsonLinesStream(statusCode: ${_source.statusCode}, linesRead: $_lineNumber)';
}
