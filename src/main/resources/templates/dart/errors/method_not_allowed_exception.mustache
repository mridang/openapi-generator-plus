import 'client_exception.dart';

/// Exception for HTTP 405 Method Not Allowed.
class MethodNotAllowedException extends ClientException {
  const MethodNotAllowedException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 405);
}
