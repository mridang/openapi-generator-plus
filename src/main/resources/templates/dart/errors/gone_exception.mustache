import 'client_exception.dart';

/// Exception for HTTP 410 Gone.
class GoneException extends ClientException {
  const GoneException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 410);
}
