import 'client_exception.dart';

/// Exception for HTTP 415 Unsupported Media Type.
class UnsupportedMediaTypeException extends ClientException {
  const UnsupportedMediaTypeException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 415);
}
