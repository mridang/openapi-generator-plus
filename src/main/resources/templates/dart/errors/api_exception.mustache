import '../object_serializer.dart';
import 'bad_request_exception.dart';
import 'client_exception.dart';
import 'conflict_exception.dart';
import 'forbidden_exception.dart';
import 'internal_server_error_exception.dart';
import 'not_found_exception.dart';
import '{{errorPrefixSnake}}_exception.dart';
import 'server_exception.dart';
import 'unauthorized_exception.dart';
import 'unprocessable_entity_exception.dart';

/// Exception thrown when an API call fails.
///
/// Carries the HTTP status code, response headers, and response body. Extends
/// [{{errorPrefix}}Exception], the branded root of the exception hierarchy, so
/// that `apiError is {{errorPrefix}}Exception` holds. The typed subclasses
/// ([ClientException], [ServerException] and their leaves) extend
/// [ApiException] and are therefore [{{errorPrefix}}Exception]s as well.
class ApiException extends {{errorPrefix}}Exception {
  /// The HTTP status code.
  final int statusCode;

  /// The detail message.
  @override
  final String message;

  /// The raw HTTP response body, if available.
  ///
  /// Null when the transport failed before a body was produced. A null value
  /// is distinct from an empty body.
  final String? responseBody;

  /// The HTTP response headers, if available.
  ///
  /// Null when the transport failed before any headers were received. A null
  /// value is distinct from an empty header map.
  final Map<String, String>? responseHeaders;

  /// The deserialized error body, or null if not available.
  final Object? errorBody;

  /// The underlying transport error, if any.
  ///
  /// Set when wrapping a SocketException or other lower-level failure so
  /// callers can inspect the root error rather than only a stringified
  /// message.
  final Object? underlyingError;

  /// Creates an exception with full response context.
  const ApiException({
    required this.statusCode,
    required this.message,
    this.responseBody,
    this.responseHeaders,
    this.errorBody,
    this.underlyingError,
  });

  /// Build the exception that a non-2xx response with this status raises.
  ///
  /// This is the one status-to-exception mapping in the SDK: the API classes
  /// and the OpenID Connect discovery both use it.
  ///
  /// A JSON body is decoded and exposed through [errorBody]; a body that is not
  /// JSON leaves the error body null.
  ///
  /// Returns the status-specific subclass where there is one (for example
  /// [NotFoundException] for 404), else [ClientException] for any other 4xx,
  /// [ServerException] for any other 5xx, and [ApiException] for everything
  /// else. The caller throws it.
  static ApiException fromResponse(
    int statusCode,
    Map<String, String>? responseHeaders,
    String? responseBody,
  ) {
    final message = 'API returned status code $statusCode';
    Object? errorBody;
    if (responseBody != null && responseBody.isNotEmpty) {
      try {
        /* Route through parseJson so the nesting-depth cap refuses a
         * deeply-nested error payload before it can recurse through the call
         * stack. */
        errorBody = parseJson(responseBody);
      } catch (_) {}
    }
    switch (statusCode) {
      case 400:
        return BadRequestException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 401:
        return UnauthorizedException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 403:
        return ForbiddenException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 404:
        return NotFoundException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 409:
        return ConflictException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 422:
        return UnprocessableEntityException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
      case 500:
        return InternalServerErrorException(
          statusCode: statusCode,
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
        );
    }
    if (statusCode >= 400 && statusCode < 500) {
      return ClientException(
        statusCode: statusCode,
        message: message,
        responseBody: responseBody,
        responseHeaders: responseHeaders,
        errorBody: errorBody,
      );
    }
    if (statusCode >= 500 && statusCode < 600) {
      return ServerException(
        statusCode: statusCode,
        message: message,
        responseBody: responseBody,
        responseHeaders: responseHeaders,
        errorBody: errorBody,
      );
    }
    return ApiException(
      statusCode: statusCode,
      message: message,
      responseBody: responseBody,
      responseHeaders: responseHeaders,
      errorBody: errorBody,
    );
  }

  /// Deserialize the raw response body into the given type.
  ///
  /// Useful when the API returns a structured error body that you want to
  /// access in a strongly-typed way. Dart has no runtime generic
  /// deserialization, so the target model's `fromJson` constructor is passed
  /// in rather than the class itself.
  ///
  /// Returns the deserialized error body, or null if the body is empty or
  /// deserialization fails.
  T? getTypedErrorBody<T>(T Function(Map<String, dynamic>) fromJson) {
    final body = responseBody;
    if (body == null || body.isEmpty) {
      return null;
    }
    try {
      /* Route through parseJson so the nesting-depth cap refuses a
       * deeply-nested error payload before it can recurse through the call
       * stack. */
      final decoded = parseJson(body);
      return fromJson(decoded as Map<String, dynamic>);
    } catch (_) {
      return null;
    }
  }

  /// Render the error as the message followed by whatever response context was
  /// captured, one labelled field per line.
  @override
  String toString() {
    final buf = StringBuffer(message.isEmpty
        ? 'Error message: the server returns an error'
        : message);
    if (statusCode != 0) {
      buf.write('\nHTTP status code: $statusCode');
    }
    final headers = responseHeaders;
    if (headers != null && headers.isNotEmpty) {
      buf.write('\nResponse headers: $headers');
    }
    final body = responseBody;
    if (body != null && body.isNotEmpty) {
      buf.write('\nResponse body: $body');
    }
    return buf.toString();
  }
}
