/// Builds the exception for one error schema an operation declares. An
/// operation hands the factories of its own declared error responses to
/// [ApiException.fromResponse], which picks the one for the status that
/// arrived.
typedef ErrorFactory = ApiException Function({
  required int statusCode,
  Map<String, String>? responseHeaders,
  String? responseBody,
  String? requestMethod,
  String? requestPath,
});

/// Exception thrown when an API call fails.
///
/// Carries the HTTP status code, response headers, and response body. Extends
/// [{{errorPrefix}}Exception], the branded root of the exception hierarchy, so
/// that `apiError is {{errorPrefix}}Exception` holds. The typed subclasses
/// ([ClientException], [ServerException] and their leaves) extend
/// [ApiException] and are therefore [{{errorPrefix}}Exception]s as well.
class ApiException extends {{errorPrefix}}Exception {
  /// The HTTP status code.
  final int statusCode;

  /// The detail message.
  @override
  final String message;

  /// The raw HTTP response body, if available.
  ///
  /// Null when the transport failed before a body was produced. A null value
  /// is distinct from an empty body.
  final String? responseBody;

  /// The HTTP response headers, if available.
  ///
  /// Null when the transport failed before any headers were received. A null
  /// value is distinct from an empty header map.
  final Map<String, String>? responseHeaders;

  /// The deserialized error body, or null if not available.
  final Object? errorBody;

  /// The underlying transport error, if any.
  ///
  /// Set when wrapping a SocketException or other lower-level failure so
  /// callers can inspect the root error rather than only a stringified
  /// message.
  final Object? cause;

  /// The HTTP method of the request that failed (for example `GET`), or null
  /// when the error was not raised for an operation.
  final String? requestMethod;

  /// The path of the request that failed, with the query string stripped, or
  /// null when the error was not raised for an operation.
  final String? requestPath;

  /// Creates an exception with full response context.
  const ApiException({
    required this.statusCode,
    required this.message,
    this.responseBody,
    this.responseHeaders,
    this.errorBody,
    this.cause,
    this.requestMethod,
    this.requestPath,
  });

  /// Build the exception that a non-2xx response with this status raises.
  ///
  /// This is the one status-to-exception mapping in the SDK: the API classes
  /// and the OpenID Connect discovery both use it.
  ///
  /// A JSON body is decoded and exposed through [errorBody]; a body that is not
  /// JSON leaves the error body null.
  ///
  /// Returns the status-specific subclass where there is one (for example
  /// [NotFoundException] for 404), else [ClientException] for any other 4xx,
  /// [ServerException] for any other 5xx, and [ApiException] for everything
  /// else. The caller throws it.
  ///
  /// When [errorSchemas] has a factory for the status (an exact status first,
  /// then a `4XX` or `5XX` range, then `default`), that factory builds the
  /// exception of the error schema the operation declares. A body that does
  /// not match the schema never hides the real error: the factory then
  /// returns the status exception of this method with the raw body, and the
  /// decoding failure as its [cause].
  ///
  /// [requestMethod] and [requestPath] name the request that failed; when both
  /// are given the message is `<METHOD> <path> returned status code <n>`,
  /// otherwise `API returned status code <n>`. [requestPath] is cut at the
  /// first `?` or `#`, so a query string never reaches the message.
  static ApiException fromResponse(
    int statusCode,
    Map<String, String>? responseHeaders,
    String? responseBody, {
    String? requestMethod,
    String? requestPath,
    Map<String, ErrorFactory>? errorSchemas,
    Object? cause,
  }) {
    final factory = _factoryFor(errorSchemas, statusCode);
    if (factory != null) {
      return factory(
        statusCode: statusCode,
        responseHeaders: responseHeaders,
        responseBody: responseBody,
        requestMethod: requestMethod,
        requestPath: requestPath,
      );
    }
    final path = requestPath == null ? null : stripQuery(requestPath);
    final message = requestMethod != null && path != null
        ? '$requestMethod $path returned status code $statusCode'
        : 'API returned status code $statusCode';
    Object? errorBody;
    if (responseBody != null && responseBody.isNotEmpty) {
      try {
        /* Route through parseJson so the nesting-depth cap refuses a
         * deeply-nested error payload before it can recurse through the call
         * stack. */
        errorBody = parseJson(responseBody);
      } catch (_) {}
    }
    switch (statusCode) {
      case 400:
        return BadRequestException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 401:
        return UnauthorizedException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 403:
        return ForbiddenException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 404:
        return NotFoundException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 409:
        return ConflictException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 422:
        return UnprocessableEntityException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 429:
        return TooManyRequestsException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 402:
        return PaymentRequiredException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 405:
        return MethodNotAllowedException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 408:
        return RequestTimeoutException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 410:
        return GoneException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 413:
        return PayloadTooLargeException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 415:
        return UnsupportedMediaTypeException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 423:
        return LockedException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 500:
        return InternalServerErrorException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 501:
        return NotImplementedException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 502:
        return BadGatewayException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 503:
        return ServiceUnavailableException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
      case 504:
        return GatewayTimeoutException(
          message: message,
          responseBody: responseBody,
          responseHeaders: responseHeaders,
          errorBody: errorBody,
          cause: cause,
          requestMethod: requestMethod,
          requestPath: path,
        );
    }
    if (statusCode >= 400 && statusCode < 500) {
      return ClientException(
        statusCode: statusCode,
        message: message,
        responseBody: responseBody,
        responseHeaders: responseHeaders,
        errorBody: errorBody,
        cause: cause,
        requestMethod: requestMethod,
        requestPath: path,
      );
    }
    if (statusCode >= 500 && statusCode < 600) {
      return ServerException(
        statusCode: statusCode,
        message: message,
        responseBody: responseBody,
        responseHeaders: responseHeaders,
        errorBody: errorBody,
        cause: cause,
        requestMethod: requestMethod,
        requestPath: path,
      );
    }
    return ApiException(
      statusCode: statusCode,
      message: message,
      responseBody: responseBody,
      responseHeaders: responseHeaders,
      errorBody: errorBody,
      cause: cause,
      requestMethod: requestMethod,
      requestPath: path,
    );
  }

  /// The factory of [errorSchemas] for [statusCode]: the exact status, then
  /// the `4XX` or `5XX` range, then `default`; null when there is none.
  static ErrorFactory? _factoryFor(
      Map<String, ErrorFactory>? errorSchemas, int statusCode) {
    if (errorSchemas == null) {
      return null;
    }
    var factory = errorSchemas['$statusCode'];
    if (factory == null && statusCode >= 400 && statusCode < 500) {
      factory = errorSchemas['4XX'];
    }
    if (factory == null && statusCode >= 500 && statusCode < 600) {
      factory = errorSchemas['5XX'];
    }
    return factory ?? errorSchemas['default'];
  }

  /// Whether repeating the request can succeed: the status is 408, 409, 429 or
  /// a 5xx other than 501, the statuses the client itself retries.
  bool get isRetryable =>
      statusCode == 408 ||
      statusCode == 409 ||
      statusCode == 429 ||
      (statusCode >= 500 && statusCode <= 599 && statusCode != 501);

  /// The request id the server sent in the `x-request-id` response header, or
  /// null when the header is absent.
  String? get requestId {
    final headers = responseHeaders;
    if (headers == null) {
      return null;
    }
    for (final entry in headers.entries) {
      if (entry.key.toLowerCase() == 'x-request-id') {
        return entry.value;
      }
    }
    return null;
  }

  /// This error with the request that raised it recorded.
  ///
  /// The transport knows nothing of the operation, so the API layer calls this
  /// for a failure that arrived without a response: a [NetworkTimeoutException]
  /// stays one, a [NetworkException] stays one and anything else becomes an
  /// [ApiException] with the same fields; a `ResponseTooLargeException` stays
  /// one too. An error that already names its
  /// request, or whose type is a status-specific subclass, is returned
  /// unchanged. [path] is cut at the first `?` or `#`.
  ApiException withRequest(String method, String path) {
    if (requestMethod != null) {
      return this;
    }
    final stripped = stripQuery(path);
    if (this is NetworkTimeoutException) {
      return NetworkTimeoutException(
        message: message,
        cause: cause,
        requestMethod: method,
        requestPath: stripped,
      );
    }
    if (this is StreamException) {
      return StreamException(
        message: message,
        cause: cause,
        requestMethod: method,
        requestPath: stripped,
      );
    }
    final self = this;
    if (self is ResponseTooLargeException) {
      return ResponseTooLargeException(
        limit: self.limit,
        statusCode: statusCode,
        responseHeaders: responseHeaders,
        cause: cause,
        requestMethod: method,
        requestPath: stripped,
      );
    }
    if (this is NetworkException) {
      return NetworkException(
        message: message,
        cause: cause,
        requestMethod: method,
        requestPath: stripped,
      );
    }
    if (runtimeType != ApiException) {
      return this;
    }
    return ApiException(
      statusCode: statusCode,
      message: message,
      responseBody: responseBody,
      responseHeaders: responseHeaders,
      errorBody: errorBody,
      cause: cause,
      requestMethod: method,
      requestPath: stripped,
    );
  }

  /// [path] without its query string or fragment.
  static String stripQuery(String path) {
    final end = path.indexOf(RegExp(r'[?#]'));
    return end < 0 ? path : path.substring(0, end);
  }

  /// Deserialize the raw response body into the given type.
  ///
  /// Useful when the API returns a structured error body that you want to
  /// access in a strongly-typed way. Dart has no runtime generic
  /// deserialization, so the target model's `fromJson` constructor is passed
  /// in rather than the class itself.
  ///
  /// Returns the deserialized error body, or null if the body is absent, empty
  /// or a bare JSON `null`. Throws `SerializationException` if the body is not
  /// valid JSON or does not match the target model, so a malformed body is not
  /// mistaken for a missing one.
  T? getTypedErrorBody<T>(T Function(Map<String, dynamic>) fromJson) {
    final body = responseBody;
    if (body == null) {
      return null;
    }
    return deserialize(body, fromJson);
  }

  /// Render the error as the message followed by whatever response context was
  /// captured, one labelled field per line.
  @override
  String toString() {
    final buf = StringBuffer(message.isEmpty
        ? 'Error message: the server returns an error'
        : message);
    if (statusCode != 0) {
      buf.write('\nHTTP status code: $statusCode');
    }
    final headers = responseHeaders;
    if (headers != null && headers.isNotEmpty) {
      final sorted = Map<String, String>.fromEntries(headers.entries
          .map((e) => MapEntry(e.key, _isSecretHeader(e.key) ? '***' : e.value))
          .toList()
        ..sort((a, b) => a.key.compareTo(b.key)));
      buf.write('\nResponse headers: ${jsonEncode(sorted)}');
    }
    final body = responseBody;
    if (body != null && body.isNotEmpty) {
      buf.write('\nResponse body: ${_renderBody(body)}');
    }
    return buf.toString();
  }

  /// Most response-body bytes shown by [toString]; the whole body stays on
  /// [responseBody].
  static const int _maxRenderedBodyBytes = 1024;

  /// Header names whose value is a credential, shown as `***` by [toString].
  static const Set<String> _secretHeaderNames = {
    'authorization',
    'proxy-authorization',
    'cookie',
    'set-cookie',
    'www-authenticate',
    'proxy-authenticate',
  };

  /// Whether the value of the header [name] is a credential: one of the fixed
  /// names, or any name containing `key`, `token` or `secret`.
  static bool _isSecretHeader(String name) {
    final lower = name.toLowerCase();
    return _secretHeaderNames.contains(lower) ||
        lower.contains('key') ||
        lower.contains('token') ||
        lower.contains('secret');
  }

  /// The body as shown by [toString]: at most [_maxRenderedBodyBytes] bytes
  /// followed by `... (N more bytes)`, with control characters shown as
  /// `\xNN`, so a hostile server can neither fill a log nor forge a line in
  /// it.
  static String _renderBody(String body) {
    final bytes = utf8.encode(body);
    var end = bytes.length;
    if (end > _maxRenderedBodyBytes) {
      end = _maxRenderedBodyBytes;
      /* Back up to a character boundary so no code point is cut in half. */
      while (end > 0 && (bytes[end] & 0xC0) == 0x80) {
        end--;
      }
    }
    final shown = end == bytes.length ? body : utf8.decode(bytes.sublist(0, end));
    final out = StringBuffer();
    for (final unit in shown.runes) {
      if (unit < 0x20 || unit == 0x7F) {
        out.write('\\x${unit.toRadixString(16).toUpperCase().padLeft(2, '0')}');
      } else {
        out.writeCharCode(unit);
      }
    }
    if (end < bytes.length) {
      out.write('... (${bytes.length - end} more bytes)');
    }
    return out.toString();
  }
}
