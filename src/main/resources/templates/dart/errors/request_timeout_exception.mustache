import 'client_exception.dart';

/// Exception for HTTP 408 Request Timeout.
class RequestTimeoutException extends ClientException {
  const RequestTimeoutException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 408);
}
