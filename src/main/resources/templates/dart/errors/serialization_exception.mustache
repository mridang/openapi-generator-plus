import '{{errorPrefixSnake}}_exception.dart';

/// Exception raised when serialization or deserialization fails.
///
/// Extends [{{errorPrefix}}Exception], the branded root of the exception
/// hierarchy, so that `serializationError is {{errorPrefix}}Exception` holds
/// alongside the API errors.
class SerializationException extends {{errorPrefix}}Exception {
  /// The detail message.
  @override
  final String message;

  /// The underlying cause, if any.
  final Object? cause;

  /// Creates an exception with a detail message and an optional cause.
  const SerializationException(this.message, [this.cause]);

  @override
  String toString() {
    if (cause != null) {
      return 'SerializationException: $message: $cause';
    }
    return 'SerializationException: $message';
  }
}
