import 'client_exception.dart';

/// Exception for HTTP 409 Conflict.
class ConflictException extends ClientException {
  const ConflictException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 409);
}
