import 'client_exception.dart';

/// Exception for HTTP 413 Payload Too Large.
class PayloadTooLargeException extends ClientException {
  const PayloadTooLargeException({
    super.message = '',
    super.responseBody,
    super.responseHeaders,
    super.errorBody,
    super.cause,
    super.requestMethod,
    super.requestPath,
  }) : super(statusCode: 413);
}
