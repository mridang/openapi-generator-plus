/// Unified entry point for all API services.
///
/// Takes an [Authenticator] and optionally [TransportOptions], then exposes
/// each API group as a typed property. If the authenticator implements
/// [HttpAwareAuthenticator], the shared `ApiClient` is injected so that
/// authentication HTTP calls (token exchange, discovery) use the same
/// transport configuration as regular API calls.
///
/// Usage:
///
/// ```dart
/// // Default transport
/// final client = {{clientClassName}}(authenticator: authenticator);
///
/// // Custom transport (proxy, timeouts, etc.)
/// final transport = TransportOptions.builder()
///   .proxy('http://proxy:3128')
///   .timeout(5000)
///   .build();
/// final customClient = {{clientClassName}}(
///   authenticator: authenticator,
///   transportOptions: transport,
/// );
/// ```
class {{clientClassName}} {
{{#apiInfo}}
{{#apis}}
{{#operations}}
  /// API operations for the {{classname}} group.
  final {{classname}} {{clientPropertyName}};
{{/operations}}
{{/apis}}
{{/apiInfo}}

  final DefaultApiClient _apiClient;

  {{clientClassName}}._({
    required Authenticator authenticator,
    required DefaultApiClient apiClient,
  }) : _apiClient = apiClient,
       {{#apiInfo}}{{#apis}}{{#operations}}{{clientPropertyName}} = _create{{classname}}(authenticator, apiClient){{^-last}},
       {{/-last}}{{#-last}};{{/-last}}{{/operations}}{{/apis}}{{/apiInfo}}

  /// Creates a new client with the given authenticator and transport options.
  ///
  /// If the authenticator implements [HttpAwareAuthenticator], the shared
  /// `ApiClient` is injected so that token exchange and discovery requests
  /// use the same proxy, TLS, and timeout settings.
  ///
  /// Parameters:
  ///   - [authenticator]: provides host URL and auth headers
  ///   - [transportOptions]: HTTP transport configuration (proxy, TLS,
  ///     timeouts, etc.)
  factory {{clientClassName}}({
    required Authenticator authenticator,
    TransportOptions? transportOptions,
  }) {
    final apiClient = DefaultApiClient(transportOptions: transportOptions);
    if (authenticator is HttpAwareAuthenticator) {
      authenticator.setApiClient(apiClient);
    }
    return {{clientClassName}}._(authenticator: authenticator, apiClient: apiClient);
  }

{{#apiInfo}}
{{#apis}}
{{#operations}}
  static {{classname}} _create{{classname}}(Authenticator authenticator, DefaultApiClient apiClient) {
    final config = ConfigurationBuilder()
        .baseUrl(authenticator.host())
        .build();
    return {{classname}}(apiClient: apiClient, config: config, authenticator: authenticator);
  }
{{/operations}}
{{/apis}}
{{/apiInfo}}

  /// Releases the HTTP transport this client built for itself.
  ///
  /// A transport supplied by the caller through
  /// [TransportOptions.httpClient] is never closed: the caller owns it. After
  /// this call any further request raises a [StateError]. Idempotent.
  void close() {
    _apiClient.close();
  }

  /// Creates a client authenticated with a Bearer token.
  ///
  /// The token is [accessToken], or what [tokenProvider] returns on every
  /// request (use it for a token that rotates or expires), or, when neither is
  /// given, the value of the `{{#lambda.uppercase}}{{packageName}}{{/lambda.uppercase}}_TOKEN` environment variable read
  /// now. When no token is found the client is not built: an [ArgumentError] is
  /// thrown.
  ///
  /// Parameters:
  ///   - [host]: API base URL
  ///   - [accessToken]: Bearer token
  ///   - [tokenProvider]: returns the current Bearer token; may be asynchronous
  ///   - [transportOptions]: optional HTTP transport configuration (proxy,
  ///     TLS, timeouts, etc.)
  factory {{clientClassName}}.withToken({
    required String host,
    String? accessToken,
    FutureOr<String> Function()? tokenProvider,
    TransportOptions? transportOptions,
  }) {
    return {{clientClassName}}(
      authenticator: BearerAuthenticator(
        host: host,
        token: accessToken,
        tokenProvider: tokenProvider,
      ),
      transportOptions: transportOptions,
    );
  }

  /// Creates a client from any [Authenticator] implementation.
  ///
  /// This is the generic entry point for bespoke authentication strategies such
  /// as OAuth2 client credentials, JWT private-key (service account), or a
  /// personal access token (PAT). Supply any [Authenticator] implementation; if
  /// it also implements [HttpAwareAuthenticator], the shared `ApiClient` is
  /// injected so its HTTP calls reuse the same transport configuration.
  ///
  /// Parameters:
  ///   - [authenticator]: provides host URL and auth headers
  ///   - [transportOptions]: optional HTTP transport configuration (proxy,
  ///     TLS, timeouts, etc.)
  static {{clientClassName}} withAuthenticator(
    Authenticator authenticator, [
    TransportOptions? transportOptions,
  ]) {
    return {{clientClassName}}(
      authenticator: authenticator,
      transportOptions: transportOptions,
    );
  }
}
