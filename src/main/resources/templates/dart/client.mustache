/// {{clientClassName}} is the unified entry point for all API services.
///
/// Takes an [Authenticator] and optionally [TransportOptions], then exposes
/// each API group as a typed field. If the authenticator implements
/// [HttpAwareAuthenticator], the shared HTTP client is injected so that
/// authentication HTTP calls (token exchange, discovery) use the same
/// transport configuration as regular API calls.
///
/// Example with default transport:
///
/// ```dart
/// final client = {{clientClassName}}(authenticator: authenticator);
/// ```
///
/// Example with custom transport (proxy, timeouts, etc.):
///
/// ```dart
/// final transport = TransportOptionsBuilder()
///   .proxy('http://proxy:3128')
///   .timeout(Duration(seconds: 5))
///   .build();
/// final client = {{clientClassName}}(
///   authenticator: authenticator,
///   transportOptions: transport,
/// );
/// ```
class {{clientClassName}} {
{{#apiInfo}}
{{#apis}}
{{#operations}}
  /// Provides methods for the {{baseName}} API group.
  final {{classname}} {{#lambda.camelcase}}{{classname}}{{/lambda.camelcase}};
{{/operations}}
{{/apis}}
{{/apiInfo}}

  /// Creates a new client with the given authenticator and optional transport
  /// options.
  ///
  /// If the authenticator implements [HttpAwareAuthenticator], the shared HTTP
  /// client is injected so that token exchange and discovery requests use the
  /// same proxy, TLS, and timeout settings.
  {{clientClassName}}({
    required Authenticator authenticator,
    TransportOptions? transportOptions,
  }) : {{#apiInfo}}{{#apis}}{{#operations}}{{#lambda.camelcase}}{{classname}}{{/lambda.camelcase}} = _create{{classname}}(authenticator, transportOptions){{^-last}},
       {{/-last}}{{#-last}} {
    final apiClient = DefaultApiClient(transportOptions);
    if (authenticator is HttpAwareAuthenticator) {
      authenticator.setHttpClient(apiClient.httpClient);
    }
  }{{/-last}}{{/operations}}{{/apis}}{{/apiInfo}}

{{#apiInfo}}
{{#apis}}
{{#operations}}
  static {{classname}} _create{{classname}}(Authenticator authenticator, TransportOptions? transportOptions) {
    final apiClient = DefaultApiClient(transportOptions);
    final config = ConfigurationBuilder()
        .baseUrl(authenticator.host())
        .defaultHeaders(authenticator.authHeaders())
        .build();
    return {{classname}}(apiClient: apiClient, config: config);
  }
{{/operations}}
{{/apis}}
{{/apiInfo}}

  /// Creates a client authenticated with a static Bearer token.
  factory {{clientClassName}}.withToken({
    required String host,
    required String accessToken,
    TransportOptions? transportOptions,
  }) {
    return {{clientClassName}}(
      authenticator: BearerAuthenticator(host: host, token: accessToken),
      transportOptions: transportOptions,
    );
  }
}
