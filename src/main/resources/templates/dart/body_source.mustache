import 'dart:async';
import 'dart:typed_data';

import 'body_source_files_io.dart'
    if (dart.library.js_interop) 'body_source_files_web.dart';

/// The body of a request that is sent as it is read, never buffered. An
/// operation whose request body is raw binary takes one.
///
/// A body is either replayable or single use:
///
/// * [BodySource.of], [BodySource.ofFile] and [BodySource.fromFactory] can be
///   read again, so the SDK retries the request after a 5xx, a 429 or a network
///   error and follows a 307 or 308 redirect.
/// * [BodySource.once] wraps a stream that can be read once. It is never
///   retried (the original error is raised unchanged) and a redirect that would
///   need it again is refused with `Refusing to replay a streamed request
///   body`.
///
/// A known length is sent as `Content-Length`; an unknown length is sent
/// chunked. A Dart stream has no `close`: the SDK reads a stream you pass to
/// [BodySource.once] to its end and cancels its subscription only when the
/// request is abandoned, and it opens and releases the streams of a file or a
/// factory itself. In the browser the transport collects the body before it
/// sends it, because `fetch` cannot stream a request body, and a file path is
/// not available.
///
/// [toString] shows the kind and the length, never the content or the path.
final class BodySource {
  BodySource._(
    this._kind, {
    Uint8List? bytes,
    String? path,
    Stream<List<int>> Function()? factory,
    Stream<List<int>>? stream,
    int? length,
  })  : _bytes = bytes,
        _path = path,
        _factory = factory,
        _stream = stream,
        _length = length;

  /// A replayable body of bytes held in memory; its length is known. The
  /// bytes are copied.
  factory BodySource.of(List<int> bytes) {
    final copy = Uint8List.fromList(bytes);
    return BodySource._(_Kind.bytes, bytes: copy, length: copy.length);
  }

  /// A replayable body read from the file at [path], opened again for every
  /// send; its length is the size of the file and the SDK releases what it
  /// opens. Not available in the browser.
  factory BodySource.ofFile(String path) =>
      BodySource._(_Kind.file, path: path);

  /// A replayable body made by [factory], which returns a fresh stream every
  /// time it is called; the SDK cancels the stream it did not read to the end.
  /// Pass [length], the number of bytes every stream holds, to send
  /// `Content-Length`; without it the body is sent chunked.
  factory BodySource.fromFactory(
    Stream<List<int>> Function() factory, {
    int? length,
  }) =>
      BodySource._(_Kind.factory,
          factory: factory, length: _checked(length));

  /// A single-use body made of [stream], which is read once, never buffered
  /// and never closed by the SDK. Pass [length], the number of bytes the stream
  /// holds, to send `Content-Length`; without it the body is sent chunked.
  factory BodySource.once(Stream<List<int>> stream, {int? length}) =>
      BodySource._(_Kind.once, stream: stream, length: _checked(length));

  static int? _checked(int? length) {
    if (length != null && length < 0) {
      throw ArgumentError('The length of a body cannot be negative');
    }
    return length;
  }

  final _Kind _kind;
  final Uint8List? _bytes;
  final String? _path;
  final Stream<List<int>> Function()? _factory;
  final Stream<List<int>>? _stream;
  final int? _length;
  bool _taken = false;

  /// Whether the body can be sent again, which is what a retry or a redirect
  /// needs; false only for [BodySource.once].
  bool get isReplayable => _kind != _Kind.once;

  /// The number of bytes when it is known, else null and the body is sent
  /// chunked. Throws an [ArgumentError] when the size of a file cannot be
  /// read.
  int? get length {
    if (_kind == _Kind.file) {
      try {
        return fileLength(_path!);
      } on Exception {
        throw ArgumentError('Failed to read the request body file');
      }
    }
    return _length;
  }

  /// Opens the content for one send. A replayable body returns a fresh stream
  /// every time. A single-use body opens once; a second call throws a
  /// [StateError].
  Stream<List<int>> open() {
    switch (_kind) {
      case _Kind.bytes:
        return Stream<List<int>>.value(_bytes!);
      case _Kind.file:
        return openFileStream(_path!);
      case _Kind.factory:
        return _factory!();
      case _Kind.once:
        if (_taken) {
          throw StateError('A single use request body can be sent only once');
        }
        _taken = true;
        return _stream!;
    }
  }

  /// Shows the kind and the length, never the content or the path.
  @override
  String toString() {
    String size;
    try {
      final known = length;
      size = known != null ? '$known bytes' : 'length unknown';
    } on Object {
      size = 'length unknown';
    }
    return 'BodySource[${_kind.label}, $size]';
  }
}

enum _Kind {
  bytes('bytes'),
  file('file'),
  factory('factory'),
  once('single use');

  const _Kind(this.label);

  final String label;
}
