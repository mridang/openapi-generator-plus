import 'dart:io';

/// Opens the file at [path] for reading; the stream releases the file when it
/// ends or is cancelled.
Stream<List<int>> openFileStream(String path) => File(path).openRead();

/// The size of the file at [path]; throws a [FileSystemException] when it
/// cannot be read.
int fileLength(String path) => File(path).lengthSync();
