/// ISO-8601 duration helpers.
///
/// Dart's stdlib `Duration` does not round-trip through JSON as
/// ISO-8601 — its `toString()` emits `HH:MM:SS.mmmmmm` rather than
/// the `PnYnMnDTnHnMnS` form that OpenAPI `format: duration` (and
/// RFC 3339 appendix A) require. These helpers bridge between the
/// two without pulling in a 3rd-party parser.
///
/// Coverage scope:
///   * Years and months are accepted on parse and folded into days
///     (1Y → 365d, 1M → 30d) as a pragmatic approximation. The
///     formatter never emits Y or M components, since `Duration`
///     stores only microseconds and the back-conversion would be
///     ambiguous.
///   * Weeks (`PnW`) are accepted on parse (1W → 7d). The formatter
///     never emits W.
///   * Fractional seconds are preserved to microsecond resolution
///     on both parse and format (Dart's `Duration` precision).
///   * Negative durations parse and format with a leading `-`
///     (e.g. `-PT1H`), matching ISO-8601 §4.4.5 sign convention.

/// Format for [parseIso8601Duration] errors. The message names the
/// offending input so call sites can surface useful diagnostics.
class Iso8601DurationFormatException implements FormatException {
  @override
  final String message;
  @override
  final String? source;
  @override
  final int? offset;

  const Iso8601DurationFormatException(this.message, [this.source])
      : offset = null;

  @override
  String toString() {
    if (source != null) {
      return 'Iso8601DurationFormatException: $message (input: $source)';
    }
    return 'Iso8601DurationFormatException: $message';
  }
}

/// Regex matching the ISO-8601 duration grammar we accept.
///
/// Groups: 1=sign, 2=years, 3=months, 4=weeks, 5=days,
///         6=hours, 7=minutes, 8=seconds (incl. fraction).
final RegExp _iso8601DurationPattern = RegExp(
  r'^(-)?P'
  r'(?:(\d+)Y)?'
  r'(?:(\d+)M)?'
  r'(?:(\d+)W)?'
  r'(?:(\d+)D)?'
  r'(?:T'
  r'(?:(\d+)H)?'
  r'(?:(\d+)M)?'
  r'(?:(\d+(?:\.\d+)?)S)?'
  r')?$',
);

/// Parses an ISO-8601 duration string into a [Duration].
///
/// Throws [Iso8601DurationFormatException] for malformed input or
/// for the degenerate `P` / `PT` strings that match the grammar but
/// carry no components.
Duration parseIso8601Duration(String input) {
  if (input.isEmpty) {
    throw Iso8601DurationFormatException('empty duration string', input);
  }
  final match = _iso8601DurationPattern.firstMatch(input);
  if (match == null) {
    throw Iso8601DurationFormatException('not an ISO-8601 duration', input);
  }
  // Reject "P" and "PT" — grammar matches them, but they carry no
  // components and are not valid representable durations.
  final hasAnyComponent = List<int>.generate(7, (i) => i + 2)
      .any((g) => match.group(g) != null);
  if (!hasAnyComponent) {
    throw Iso8601DurationFormatException(
      'duration has no components',
      input,
    );
  }

  final negative = match.group(1) == '-';
  final years = int.parse(match.group(2) ?? '0');
  final months = int.parse(match.group(3) ?? '0');
  final weeks = int.parse(match.group(4) ?? '0');
  final days = int.parse(match.group(5) ?? '0');
  final hours = int.parse(match.group(6) ?? '0');
  final minutes = int.parse(match.group(7) ?? '0');
  final secondsStr = match.group(8);

  int wholeSeconds = 0;
  int microseconds = 0;
  if (secondsStr != null) {
    final dot = secondsStr.indexOf('.');
    if (dot < 0) {
      wholeSeconds = int.parse(secondsStr);
    } else {
      wholeSeconds = int.parse(secondsStr.substring(0, dot));
      final fracStr = secondsStr.substring(dot + 1);
      // Normalise to exactly 6 digits, truncating sub-microsecond precision.
      final normalised = fracStr.length >= 6
          ? fracStr.substring(0, 6)
          : fracStr.padRight(6, '0');
      microseconds = int.parse(normalised);
    }
  }

  // Years/months approximated; calendar-aware conversion would
  // require an anchor date we don't have.
  final totalDays = years * 365 + months * 30 + weeks * 7 + days;
  var duration = Duration(
    days: totalDays,
    hours: hours,
    minutes: minutes,
    seconds: wholeSeconds,
    microseconds: microseconds,
  );
  if (negative) {
    duration = -duration;
  }
  return duration;
}

/// Formats a [Duration] as an ISO-8601 duration string.
///
/// Always uses days/hours/minutes/seconds (no Y/M/W); produces
/// `PT0S` for [Duration.zero] rather than the ambiguous bare `P`.
/// Negative durations are emitted with a leading `-`.
String formatIso8601Duration(Duration duration) {
  if (duration == Duration.zero) return 'PT0S';

  final negative = duration.isNegative;
  final abs = negative ? -duration : duration;

  final totalMicros = abs.inMicroseconds;
  final days = totalMicros ~/ Duration.microsecondsPerDay;
  var rem = totalMicros - days * Duration.microsecondsPerDay;
  final hours = rem ~/ Duration.microsecondsPerHour;
  rem -= hours * Duration.microsecondsPerHour;
  final minutes = rem ~/ Duration.microsecondsPerMinute;
  rem -= minutes * Duration.microsecondsPerMinute;
  final seconds = rem ~/ Duration.microsecondsPerSecond;
  final micros = rem - seconds * Duration.microsecondsPerSecond;

  final buf = StringBuffer();
  if (negative) buf.write('-');
  buf.write('P');
  if (days != 0) buf..write(days)..write('D');

  final hasTime = hours != 0 || minutes != 0 || seconds != 0 || micros != 0;
  if (hasTime) {
    buf.write('T');
    if (hours != 0) buf..write(hours)..write('H');
    if (minutes != 0) buf..write(minutes)..write('M');
    if (seconds != 0 || micros != 0) {
      buf.write(seconds);
      if (micros != 0) {
        final frac = micros.toString().padLeft(6, '0').replaceFirst(
              RegExp(r'0+$'),
              '',
            );
        buf..write('.')..write(frac);
      }
      buf.write('S');
    }
  } else if (days == 0) {
    // Should not be reachable (zero short-circuited above) but keep
    // a safety net so we never emit a bare `P`.
    buf.write('T0S');
  }
  return buf.toString();
}

/// Validates an RFC 3339 partial-time string (`HH:MM:SS` with
/// optional fractional seconds). Returns the input unchanged on
/// success; throws [FormatException] on malformed input.
///
/// Provided as a convenience for call sites that want construction-
/// time validation of `format: time` string values without lifting
/// in a full civil-time type.
final RegExp _partialTimePattern = RegExp(r'^\d{2}:\d{2}:\d{2}(\.\d+)?$');

String validatePartialTime(String input) {
  if (!_partialTimePattern.hasMatch(input)) {
    throw FormatException('not an RFC 3339 partial-time', input);
  }
  return input;
}
