/// protobuf-JSON duration helpers.
///
/// OpenAPI `format: duration` fields are carried on the wire as
/// `google.protobuf.Duration` JSON: a decimal second count suffixed
/// with `s` (e.g. `3600s`, `1.5s`, `3600.000000001s`). Dart's stdlib
/// `Duration` does not round-trip through that form — its `toString()`
/// emits `HH:MM:SS.mmmmmm` — so these helpers bridge between the two
/// without pulling in a 3rd-party parser.
///
/// Coverage scope:
///   * Fractional seconds are accepted to nanosecond resolution on
///     parse but stored at `Duration`'s microsecond precision; digits
///     below 1µs are truncated.
///   * The formatter emits 3, 6, or 9 fractional digits, the smallest
///     grouping that preserves every non-zero microsecond digit.
///   * Negative durations parse and format with a leading `-`.
library;

/// Format for [parseProtobufDuration] errors. The message names the
/// offending input so call sites can surface useful diagnostics.
class ProtobufDurationFormatException implements FormatException {
  @override
  final String message;
  @override
  final String? source;
  @override
  final int? offset;

  const ProtobufDurationFormatException(this.message, [this.source])
      : offset = null;

  @override
  String toString() {
    if (source != null) {
      return 'ProtobufDurationFormatException: $message (input: $source)';
    }
    return 'ProtobufDurationFormatException: $message';
  }
}

/// Regex matching the `google.protobuf.Duration` JSON grammar.
///
/// Groups: 1=sign, 2=whole seconds, 3=fractional digits.
final RegExp _protobufDurationPattern = RegExp(
  r'^(-)?(\d+)(?:\.(\d{1,9}))?s$',
);

/// Parses a protobuf-JSON duration string into a [Duration].
///
/// Accepts the `google.protobuf.Duration` JSON form
/// `-?\d+(\.\d{1,9})?s`. The fractional part is right-padded to nine
/// digits to recover nanoseconds; sub-microsecond digits are truncated
/// to fit [Duration]'s resolution. Throws
/// [ProtobufDurationFormatException] for malformed input.
Duration parseProtobufDuration(String input) {
  if (input.isEmpty) {
    throw ProtobufDurationFormatException('empty duration string', input);
  }
  final match = _protobufDurationPattern.firstMatch(input);
  if (match == null) {
    throw ProtobufDurationFormatException(
      'not a protobuf-JSON duration',
      input,
    );
  }

  final negative = match.group(1) == '-';
  final wholeSeconds = int.parse(match.group(2)!);
  final fracStr = match.group(3);

  int microseconds = 0;
  if (fracStr != null) {
    final nanosStr = fracStr.padRight(9, '0');
    final nanos = int.parse(nanosStr);
    microseconds = nanos ~/ 1000;
  }

  var duration = Duration(
    seconds: wholeSeconds,
    microseconds: microseconds,
  );
  if (negative) {
    duration = -duration;
  }
  return duration;
}

/// Formats a [Duration] as a protobuf-JSON duration string.
///
/// Emits a decimal second count suffixed with `s`. Fractional seconds,
/// when present, use 3, 6, or 9 digits — the smallest grouping that
/// preserves every non-zero microsecond digit (e.g. `3600s`,
/// `1.500s`). Negative durations are emitted with a leading `-`.
String formatProtobufDuration(Duration duration) {
  final negative = duration.isNegative;
  final abs = negative ? -duration : duration;

  final totalMicros = abs.inMicroseconds;
  final seconds = totalMicros ~/ Duration.microsecondsPerSecond;
  final micros = totalMicros - seconds * Duration.microsecondsPerSecond;

  final buf = StringBuffer();
  if (negative) {
    buf.write('-');
  }
  buf.write(seconds);
  if (micros != 0) {
    var frac = (micros * 1000).toString().padLeft(9, '0');
    var len = 9;
    while (len > 3 && frac[len - 1] == '0') {
      len--;
    }
    if (len <= 3) {
      len = 3;
    } else if (len <= 6) {
      len = 6;
    } else {
      len = 9;
    }
    buf..write('.')..write(frac.substring(0, len));
  }
  buf.write('s');
  return buf.toString();
}

/// Validates an RFC 3339 partial-time string (`HH:MM:SS` with
/// optional fractional seconds). Returns the input unchanged on
/// success; throws [FormatException] on malformed input.
///
/// Provided as a convenience for call sites that want construction-
/// time validation of `format: time` string values without lifting
/// in a full civil-time type.
final RegExp _partialTimePattern = RegExp(r'^\d{2}:\d{2}:\d{2}(\.\d+)?$');

String validatePartialTime(String input) {
  if (!_partialTimePattern.hasMatch(input)) {
    throw FormatException('not an RFC 3339 partial-time', input);
  }
  return input;
}
