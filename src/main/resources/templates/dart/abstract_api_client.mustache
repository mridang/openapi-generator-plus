import 'dart:async';
import 'dart:convert';
import 'dart:typed_data';

import 'package:http/http.dart' as http;
import 'package:http_parser/http_parser.dart';
import 'package:mime/mime.dart';
import 'dart:math';

import 'api_client.dart';
import 'api_response.dart';
import 'errors/api_error.dart';
import 'transport_options.dart';

/// Transport-agnostic base for [ApiClient] implementations.
///
/// Owns every piece of HTTP behaviour that must be identical regardless of the
/// platform: transport-level default-header merging, User-Agent and
/// X-Request-ID injection, Accept-Encoding negotiation, multipart encoding, the
/// manual redirect loop (with cross-origin sensitive-header stripping,
/// HTTPS->HTTP body-replay refusal, and non-http(s) scheme rejection), and
/// charset decoding -- all expressed against `package:http`'s [http.Client]
/// abstraction only, with no `dart:io` dependency. Concrete subclasses supply
/// the [http.Client] (built in their factory) and the platform [decompressBytes]
/// implementation, so this security-critical logic lives in exactly one place
/// across both the native (dart:io / undici-equivalent) transport and the
/// portable web (BrowserClient) transport.
///
/// Header merge order (lowest to highest priority):
///  1. [TransportOptions.defaultHeaders] -- transport-level defaults
///  2. Caller-provided headers (from BaseApi -- includes config defaults,
///     auth, operation headers)
///  3. [TransportOptions.userAgent] -- injected if not already set
///  4. [TransportOptions.injectRequestId] -- injected if not already set
abstract class AbstractApiClient implements ApiClient {
  final TransportOptions _transportOptions;
  final http.Client _httpClient;
  /* Gap AK: dart:io's HttpClient has no API for proxy basic-auth
   * credentials, so userinfo embedded in the proxy URL
   * (`http://user:pass@host:port`) is silently dropped. Extract it
   * once at construction and inject as a Proxy-Authorization header
   * on every outbound request below, matching the Java/C# SDKs. */
  final String? _proxyAuthHeader;

  /* Cross-cutting `close-lifecycle-three-way`: track a closed flag so that
   * a request issued after [close] surfaces a uniform SDK error (ApiError)
   * instead of leaking the underlying `http` package's "Client is already
   * closed" ClientException. */
  bool _closed = false;

  /// Creates the base from the resolved transport settings, the platform
  /// [http.Client] built by the subclass, and the proxy-auth header derived
  /// from the proxy URL's userinfo.
  AbstractApiClient(this._transportOptions, this._httpClient, this._proxyAuthHeader);

  /// Returns the Proxy-Authorization header value extracted from the proxy
  /// URL's userinfo, or null when no credentials are configured. Exposed
  /// for tests that need to verify userinfo is propagated rather than dropped.
  String? get proxyAuthHeader => _proxyAuthHeader;

  /// Platform seam: decompress [bytes] according to [contentEncoding].
  ///
  /// The native transport decodes `gzip`/`deflate` with dart:io codecs and
  /// raises an [ApiError] on a Content-Encoding lie; the web transport relies
  /// on the browser having already decoded the response and returns [bytes]
  /// unchanged. An empty encoding passes bytes through on both.
  Uint8List decompressBytes(Uint8List bytes, String contentEncoding);

  /// Builds a `Basic <base64>` Proxy-Authorization value from the userinfo
  /// embedded in the proxy URL, or returns null when no credentials are
  /// present. Percent-encoded userinfo is decoded before encoding.
  static String? buildProxyAuthHeader(Uri? proxy) {
    if (proxy == null) return null;
    if (proxy.userInfo.isEmpty) return null;
    final parts = proxy.userInfo.split(':');
    final user = Uri.decodeComponent(parts[0]);
    final pass = parts.length > 1
        ? Uri.decodeComponent(parts.sublist(1).join(':'))
        : '';
    final encoded = base64Encode(utf8.encode('$user:$pass'));
    return 'Basic $encoded';
  }

  @override
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
  }) async {
    if (_closed) {
      throw ApiError(
        statusCode: 0,
        message: 'Cannot send request: the API client has been closed',
      );
    }
    final merged = <String, String>{};

    merged.addAll(_transportOptions.defaultHeaders);
    merged.addAll(headers);

    final userAgent = _transportOptions.userAgent;
    if (!merged.containsKey('User-Agent') &&
        userAgent != null &&
        userAgent.isNotEmpty) {
      merged['User-Agent'] = userAgent;
    }

    if (!merged.containsKey('X-Request-ID') && _transportOptions.injectRequestId) {
      merged['X-Request-ID'] = _generateUuid();
    }

    if (!merged.containsKey('Accept-Encoding')) {
      merged['Accept-Encoding'] = _supportedEncodings();
    }

    final proxyAuth = _proxyAuthHeader;
    if (proxyAuth != null) {
      merged['Proxy-Authorization'] = proxyAuth;
    }

    final uri = Uri.parse(url);
    http.BaseRequest request;

    /* Gap BH: package:http's auto-redirect re-sends Authorization /
     * Cookie / Proxy-Authorization across cross-origin 3xx redirects
     * by default, leaking bearer tokens to attacker-controlled hosts.
     * We disable auto-redirect on the underlying request and follow
     * Location headers manually below, stripping sensitive headers
     * when the next URL's origin differs from the original. */
    if (body is Map<String, Object?>) {
      final multipartRequest = http.MultipartRequest(method, uri);
      multipartRequest.headers.addAll(merged);
      for (final entry in body.entries) {
        final name = entry.key;
        final value = entry.value;
        if (value == null) continue;
        /* A binary part (`Uint8List`/`List<int>`) must be handled as a single
         * file part — NOT iterated as a repeated field. `Uint8List` satisfies
         * `value is List`, so the `List<int>` check has to come first;
         * otherwise each individual byte is stringified into its own numeric
         * form field and the file content is destroyed (multipart-file-content-type). */
        if (value is List<int>) {
          _addMultipartField(multipartRequest, name, value);
        } else if (value is List) {
          /* A non-binary array form field expands into one part per element
           * (form-array-repeated-keys, multipart variant). */
          for (final item in value) {
            if (item == null) continue;
            _addMultipartField(multipartRequest, name, item as Object);
          }
        } else {
          _addMultipartField(multipartRequest, name, value);
        }
      }
      multipartRequest.followRedirects = false;
      request = multipartRequest;
    } else {
      final standardRequest = http.Request(method, uri);
      if (body == null) {
        merged.remove('Content-Type');
        merged.remove('content-type');
      }
      standardRequest.headers.addAll(merged);
      standardRequest.followRedirects = false;
      if (body is Uint8List) {
        standardRequest.bodyBytes = body;
      } else if (body is String) {
        /* String bodies (e.g. pre-serialised multipart payloads handed
         * in directly by tests or callers that build their own
         * envelope) need to flow to the wire as UTF-8 bytes. Previously
         * we silently dropped them, which made the multipart-replay
         * test pass for the wrong reason. */
        standardRequest.bodyBytes = Uint8List.fromList(utf8.encode(body));
      } else if (body == null) {
        /* Some servers / WAFs treat POST/PUT/PATCH with no body and no
           Content-Length as malformed (411 Length Required). Setting
           bodyBytes to an empty list forces dart:http to emit an
           explicit `Content-Length: 0`, matching Kotlin's
           `ByteArray(0)` and the other 11 SDKs. */
        final upper = method.toUpperCase();
        if (upper == 'POST' || upper == 'PUT' || upper == 'PATCH') {
          standardRequest.bodyBytes = Uint8List(0);
        }
      }
      request = standardRequest;
    }

    http.StreamedResponse streamedResponse;
    Uri currentUri = uri;
    Uint8List rawBytes;
    try {
      final Future<http.StreamedResponse> pendingResponse = _httpClient.send(request);
      streamedResponse = _transportOptions.timeout != null
          ? await pendingResponse.timeout(Duration(milliseconds: _transportOptions.timeout!))
          : await pendingResponse;
      if (_transportOptions.followRedirects && !noRedirect) {
        final maxRedirects = _transportOptions.maxRedirects ?? 20;
        /* Gap 3.1: extend the cross-origin strip set with API-key header
         * names declared in the spec. The standard `Authorization` /
         * `Cookie` / `Proxy-Authorization` allowlist does not cover
         * bespoke credentials carried in custom headers like
         * `X-API-Key` or `X-Internal-Key`, so we add every spec-declared
         * apiKey-in-header name (lowercased) here. */
        const sensitive = <String>{
          'authorization',
          'cookie',
          'proxy-authorization',
{{#apiKeyHeaderNames}}
{{#nameLower}}
          '{{nameLower}}',
{{/nameLower}}
{{/apiKeyHeaderNames}}
        };
        var hops = 0;
        var currentMethod = method;
        Object? currentBody = body;
        var currentHeaders = Map<String, String>.from(merged);
        while (hops < maxRedirects && _isRedirectStatus(streamedResponse.statusCode)) {
          /* Drain any unread body to release the connection. */
          await streamedResponse.stream.drain<void>();
          final location = streamedResponse.headers['location'];
          if (location == null || location.isEmpty) break;
          final nextUri = currentUri.resolve(location);
          if (nextUri.scheme != 'http' && nextUri.scheme != 'https') {
            /* Gap T-D3: a `Location:` pointing at a non-http(s) scheme
             * (`file:`, `javascript:`, `data:`, ...) is a redirect-target
             * smuggling vector. Refuse it loudly with a typed SDK error
             * instead of silently returning the 3xx, matching the other
             * SDKs that surface the offending URL. */
            throw ApiError(
              statusCode: 0,
              message:
                  'Refusing to follow redirect to non-http(s) URL: $nextUri',
            );
          }
          final downgrade = uri.scheme.toLowerCase() == 'https'
              && nextUri.scheme.toLowerCase() == 'http';
          final crossOrigin = !_sameOrigin(uri, nextUri);

          /* Gap T3: pick follow-up method+body per RFC 7231 §6.4.4 / RFC 7538.
           *   307 + 308: preserve original method and body.
           *   303:       force GET, drop the body (and Content-Type/Length).
           *   301 + 302: historical browser behaviour — switch to GET for
           *              non-GET/HEAD requests, drop the body. */
          final statusCode = streamedResponse.statusCode;
          final methodUpper = currentMethod.toUpperCase();
          String nextMethod;
          Object? nextBody;
          if (statusCode == 307 || statusCode == 308) {
            nextMethod = currentMethod;
            nextBody = currentBody;
          } else if (statusCode == 303) {
            nextMethod = 'GET';
            nextBody = null;
          } else if (methodUpper == 'GET' || methodUpper == 'HEAD') {
            nextMethod = currentMethod;
            nextBody = currentBody;
          } else {
            nextMethod = 'GET';
            nextBody = null;
          }

          /* Gap 3.3 / Gap N1: refuse to replay a request body across an
           * HTTPS→HTTP downgrade. A 307/308 from an HTTPS origin to plain
           * HTTP preserves the original body (which may contain
           * credentials, PII, or signed payloads), so re-emitting it over
           * an unencrypted hop is a leak — raise a typed SDK error instead
           * (T-D2). 301/302/303 coerce to GET and DROP the body above, so
           * nothing is replayed and the redirect must proceed (the canonical
           * N1 behaviour: guard 307/308 only). Checking the COERCED
           * [nextBody] — not the original [currentBody] — is what
           * distinguishes the two: it is null after a 301/302/303 body-drop
           * and non-null only when the body would actually cross the wire. */
          if (downgrade && nextBody != null) {
            throw ApiError(
              statusCode: 0,
              message:
                  'Refusing to replay request body across HTTPS->HTTP '
                  'downgrade redirect to: $nextUri',
            );
          }

          final redirectHeaders = <String, String>{};
          currentHeaders.forEach((k, v) {
            if (crossOrigin && sensitive.contains(k.toLowerCase())) return;
            if (nextBody == null
                && (k.toLowerCase() == 'content-type'
                    || k.toLowerCase() == 'content-length')) {
              return;
            }
            redirectHeaders[k] = v;
          });
          final next = http.Request(nextMethod, nextUri);
          next.headers.addAll(redirectHeaders);
          next.followRedirects = false;
          if (nextBody is Uint8List) {
            next.bodyBytes = nextBody;
          } else if (nextBody is String) {
            /* RFC 7231 §6.4.7 / RFC 7538: 307/308 must replay the
             * original method and body. A String body (e.g. a
             * pre-built multipart envelope) is re-encoded as UTF-8
             * bytes on each hop so the form parts arrive intact. */
            next.bodyBytes = Uint8List.fromList(utf8.encode(nextBody));
          }
          currentUri = nextUri;
          currentMethod = nextMethod;
          currentBody = nextBody;
          currentHeaders = redirectHeaders;
          final p = _httpClient.send(next);
          streamedResponse = _transportOptions.timeout != null
              ? await p.timeout(Duration(milliseconds: _transportOptions.timeout!))
              : await p;
          hops++;
        }
        /* Gap T-D1: the redirect chain was followed up to `maxRedirects`
         * hops but the final response is still a 3xx with a Location we
         * could keep following. Surface this as a typed SDK error instead
         * of silently returning the last 3xx as if it were the result. */
        if (hops >= maxRedirects && _isRedirectStatus(streamedResponse.statusCode)) {
          await streamedResponse.stream.drain<void>();
          throw ApiError(
            statusCode: 0,
            message: 'Exceeded maximum number of redirects ($maxRedirects)',
          );
        }
      }
      /* Cross-cutting `response-body-read-error-not-wrapped`: read the
       * response body INSIDE the transport try/catch so a connection
       * reset, read timeout, or truncated-chunked failure that occurs
       * AFTER the response headers arrive is wrapped in the uniform
       * ApiError (statusCode 0, underlying preserved) — the same error
       * type a send-phase failure produces. */
      rawBytes = await streamedResponse.stream.toBytes();
    } on ApiError {
      /* SDK-typed errors raised inside the redirect loop (unsupported
       * scheme, refused downgrade, too many redirects) already carry the
       * right type — surface them unchanged rather than re-wrapping. */
      rethrow;
    } on http.ClientException catch (e) {
      /* package:http surfaces send-phase failures and post-header body-read
       * failures (truncated/malformed chunked body, connection reset
       * mid-stream) — and wraps native socket/TLS errors from its IOClient —
       * as ClientException. Wrap it in the uniform ApiError so callers
       * guarding with `on ApiError` see transport failures consistently. */
      throw ApiError(statusCode: 0, message: e.message, underlyingError: e);
    } on TimeoutException catch (e) {
      throw ApiError(
        statusCode: 0,
        message: e.message ?? 'Request timed out',
        underlyingError: e,
      );
    } catch (e) {
      /* Any other transport-layer error (e.g. a raw dart:io
       * SocketException / HandshakeException that surfaces from the
       * body-read stream on the native transport) is wrapped uniformly so
       * no foreign exception type escapes the SDK surface. */
      throw ApiError(statusCode: 0, message: e.toString(), underlyingError: e);
    }
    final contentEncoding = (streamedResponse.headers['content-encoding'] ?? '').toLowerCase().trim();
    final responseBytes = decompressBytes(rawBytes, contentEncoding);
    final contentType = streamedResponse.headers['content-type'] ?? '';
    final responseBody = _isTextContentType(contentType)
        ? _decodeText(responseBytes, contentType)
        : base64Encode(responseBytes);

    /* Gap BE+BF: response header keys are normalised to lowercase so callers
       can look them up consistently regardless of the casing the server used
       (HTTP header names are case-insensitive per RFC 7230 section 3.2, and
       HTTP/2 mandates lowercase on the wire). Repeated header lines are
       joined with ", " to preserve order per RFC 7230 section 3.2.2.
       package:http already joins multi-value headers with ", " in
       `headers`, but Set-Cookie is collapsed to the first occurrence;
       we recover the full list via `headersSplitValues` when available. */
    final responseHeaders = <String, String>{};
    final dynamic dynResp = streamedResponse;
    try {
      final Map<String, List<String>> split =
          (dynResp.headersSplitValues as Map<String, List<String>>);
      split.forEach((key, values) {
        responseHeaders[key.toLowerCase()] = values.join(', ');
      });
    } catch (_) {
      streamedResponse.headers.forEach((key, value) {
        responseHeaders[key.toLowerCase()] = value;
      });
    }

    return ApiHttpResponse(
      statusCode: streamedResponse.statusCode,
      body: responseBody,
      headers: responseHeaders,
    );
  }

  /// Adds a single field to a multipart request, handling bytes, strings, and
  /// other types (JSON-serialized).
  static void _addMultipartField(
    http.MultipartRequest request,
    String name,
    Object value,
  ) {
    /* W-new-2: validate the field name on every branch (string, number,
     * boolean, JSON, binary) before it lands in Content-Disposition. The
     * http.MultipartRequest builds the header from `name` directly, so
     * CR/LF/NUL must be rejected even when the value is not Uint8List.
     */
    validateMultipartFieldName(name);
    if (value is Uint8List) {
      validateMultipartFilename(name);
      final mimeType = lookupMimeType(name) ?? 'application/octet-stream';
      final parts = mimeType.split('/');
      final contentType = parts.length == 2
          ? MediaType(parts[0], parts[1])
          : MediaType('application', 'octet-stream');
      request.files.add(http.MultipartFile.fromBytes(
        name,
        value,
        filename: name,
        contentType: contentType,
      ));
    } else if (value is String) {
      request.fields[name] = value;
    } else if (value is num || value is bool) {
      request.fields[name] = value.toString();
    } else {
      final json = jsonEncode(value);
      request.files.add(http.MultipartFile.fromString(
        name,
        json,
        contentType: MediaType('application', 'json'),
      ));
    }
  }

  /// Closes the underlying HTTP client. After this call any further
  /// [sendRequest] raises a typed [ApiError] rather than the underlying
  /// `http` package's closed-client exception. Idempotent.
  void close() {
    _closed = true;
    _httpClient.close();
  }

  /// Decodes response [bytes] into a string honouring the `charset=`
  /// parameter in [contentType].
  ///
  /// Servers can declare non-UTF-8 response encodings (e.g.
  /// `text/plain; charset=ISO-8859-1` or `charset=utf-16`); hard-coding
  /// UTF-8 would mangle those bytes or, for UTF-16, throw a FormatException.
  /// Dart's core library has no built-in UTF-16 codec, so UTF-16 is decoded
  /// via a BOM-aware, surrogate-pair-aware routine ([_decodeUtf16]) to reach
  /// parity with the other 11 SDKs. Unknown charsets and malformed UTF-8 fall
  /// back to a lenient UTF-8 decode (`allowMalformed: true`) so an unfamiliar
  /// or mismatched server header can never break decoding — matching the
  /// documented 'fall back, never throw' contract.
  static String _decodeText(Uint8List bytes, String contentType) {
    final cs = _charsetOf(contentType);
    switch (cs) {
      case 'iso-8859-1':
      case 'latin1':
      case 'latin-1':
        return latin1.decode(bytes, allowInvalid: true);
      case 'us-ascii':
      case 'ascii':
        return ascii.decode(bytes, allowInvalid: true);
      case 'utf-16':
        return _decodeUtf16(bytes, null);
      case 'utf-16le':
        return _decodeUtf16(bytes, Endian.little);
      case 'utf-16be':
        return _decodeUtf16(bytes, Endian.big);
      case 'utf-8':
      case 'utf8':
      case '':
      default:
        return utf8.decode(bytes, allowMalformed: true);
    }
  }

  /// Extracts and lowercases the `charset=` parameter from a Content-Type,
  /// or returns the empty string when absent.
  static String _charsetOf(String contentType) {
    if (contentType.isEmpty) return '';
    final match =
        RegExp(r'charset=([^;]+)', caseSensitive: false).firstMatch(contentType);
    return match?.group(1)?.trim().toLowerCase() ?? '';
  }

  /// Decodes UTF-16 [bytes] into a Dart string, mirroring Go's
  /// `decodeUtf16`. When [endian] is null a leading byte-order mark
  /// (FE FF / FF FE) selects the endianness, defaulting to big-endian per
  /// the Unicode standard when no BOM is present. Surrogate pairs are
  /// combined; an unpaired surrogate is emitted as U+FFFD so the decode can
  /// never throw.
  static String _decodeUtf16(Uint8List bytes, Endian? endian) {
    var data = bytes;
    var order = endian;
    if (order == null) {
      if (data.length >= 2 && data[0] == 0xFE && data[1] == 0xFF) {
        order = Endian.big;
        data = Uint8List.sublistView(data, 2);
      } else if (data.length >= 2 && data[0] == 0xFF && data[1] == 0xFE) {
        order = Endian.little;
        data = Uint8List.sublistView(data, 2);
      } else {
        order = Endian.big;
      }
    }
    final units = <int>[];
    final usableLength = data.length - (data.length % 2);
    for (var i = 0; i < usableLength; i += 2) {
      final unit = order == Endian.big
          ? (data[i] << 8) | data[i + 1]
          : data[i] | (data[i + 1] << 8);
      units.add(unit);
    }
    final codePoints = <int>[];
    for (var i = 0; i < units.length; i++) {
      final unit = units[i];
      if (unit >= 0xD800 && unit <= 0xDBFF && i + 1 < units.length) {
        final low = units[i + 1];
        if (low >= 0xDC00 && low <= 0xDFFF) {
          codePoints.add(
              0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00));
          i++;
          continue;
        }
        codePoints.add(0xFFFD);
      } else if (unit >= 0xD800 && unit <= 0xDFFF) {
        codePoints.add(0xFFFD);
      } else {
        codePoints.add(unit);
      }
    }
    return String.fromCharCodes(codePoints);
  }

  /// Determines whether the given content type represents text content
  /// that is safe to decode as a UTF-8 string.
  static bool _isTextContentType(String contentType) {
    final mediaType = contentType.split(';').first.trim().toLowerCase();
    if (mediaType.isEmpty) return true;
    if (mediaType.startsWith('text/')) return true;
    return mediaType == 'application/json' ||
        mediaType == 'application/xml' ||
        mediaType == 'application/javascript' ||
        mediaType.endsWith('+json') ||
        mediaType.endsWith('+xml');
  }

  /// Returns true for HTTP 3xx redirect status codes that carry a Location header.
  static bool _isRedirectStatus(int code) {
    return code == 301 || code == 302 || code == 303 || code == 307 || code == 308;
  }

  /// Compares two URLs by scheme + host + effective port.
  static bool _sameOrigin(Uri a, Uri b) {
    if (a.scheme.toLowerCase() != b.scheme.toLowerCase()) return false;
    if (a.host.toLowerCase() != b.host.toLowerCase()) return false;
    final int portA = a.hasPort ? a.port : (a.scheme == 'https' ? 443 : 80);
    final int portB = b.hasPort ? b.port : (b.scheme == 'https' ? 443 : 80);
    return portA == portB;
  }

  /// Returns a comma-separated list of supported content encodings for the
  /// Accept-Encoding header. gzip and deflate are decoded by the native
  /// transport and by the browser's fetch layer on web.
  static String _supportedEncodings() {
    final encodings = ['gzip', 'deflate'];
    return encodings.join(', ');
  }

  static String _generateUuid() {
    final random = Random.secure();
    final bytes = List<int>.generate(16, (_) => random.nextInt(256));
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    final hex = bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join();
    return '${hex.substring(0, 8)}-${hex.substring(8, 12)}-'
        '${hex.substring(12, 16)}-${hex.substring(16, 20)}-'
        '${hex.substring(20, 32)}';
  }
}

/// Rejects multipart filenames that would allow Content-Disposition header
/// injection or smuggling. Throws [ArgumentError] when the filename contains
/// CR, LF, or NUL.
void validateMultipartFilename(String? filename) {
  if (filename == null) return;
  for (final c in filename.codeUnits) {
    if (c == 0x0D || c == 0x0A || c == 0x00) {
      throw ArgumentError(
          'multipart filename must not contain CR, LF, or NUL characters');
    }
  }
}

/// Rejects multipart form field names that would allow Content-Disposition
/// header injection or smuggling. Throws [ArgumentError] when the field name
/// contains CR, LF, or NUL. Must be invoked on every branch of the multipart
/// builder (string, number, boolean, JSON, binary), not just the binary path,
/// because the name is interpolated directly into the
/// `Content-Disposition: form-data; name="..."` header.
void validateMultipartFieldName(String? name) {
  if (name == null) return;
  for (final c in name.codeUnits) {
    if (c == 0x0D || c == 0x0A || c == 0x00) {
      throw ArgumentError(
          'multipart field name must not contain CR, LF, or NUL characters');
    }
  }
}

/// Backslash-escapes embedded `"` and `\` in a multipart field name so a
/// malicious name cannot break out of the `name="..."` parameter. Caller must
/// have already validated CR/LF/NUL via [validateMultipartFieldName].
String escapeMultipartFieldName(String name) {
  return name.replaceAll('\\', '\\\\').replaceAll('"', '\\"');
}

/// Builds the `filename=...` directive for a multipart Content-Disposition
/// header. For ASCII-only filenames emits a quote/backslash-escaped
/// `filename="..."`. For non-ASCII filenames additionally emits an RFC 5987
/// `filename*=UTF-8''<percent-encoded>` parameter alongside an ASCII fallback
/// (non-ASCII bytes replaced with `_`).
String buildFilenameDirective(String filename) {
  final escaped = filename.replaceAll('\\', '\\\\').replaceAll('"', '\\"');
  final ascii = filename.codeUnits.every((c) => c <= 0x7F);
  if (ascii) {
    return 'filename="$escaped"';
  }
  final fallbackBuf = StringBuffer();
  for (final c in filename.codeUnits) {
    if (c > 0x7F || c < 0x20 || c == 0x7F) {
      fallbackBuf.writeCharCode(0x5F);
    } else {
      fallbackBuf.writeCharCode(c);
    }
  }
  final fallbackEscaped =
      fallbackBuf.toString().replaceAll('\\', '\\\\').replaceAll('"', '\\"');
  final encoded = rfc5987EncodeValue(filename);
  return 'filename="$fallbackEscaped"; filename*=UTF-8\'\'$encoded';
}

/// Percent-encodes every byte that is not an RFC 3986 §2.3 unreserved
/// character, producing the value-chars production of RFC 5987 §3.2.1.
String rfc5987EncodeValue(String s) {
  const hex = '0123456789ABCDEF';
  final bytes = utf8.encode(s);
  final out = StringBuffer();
  for (final b in bytes) {
    final isUnreserved = (b >= 0x41 && b <= 0x5A) ||
        (b >= 0x61 && b <= 0x7A) ||
        (b >= 0x30 && b <= 0x39) ||
        b == 0x2D ||
        b == 0x2E ||
        b == 0x5F ||
        b == 0x7E;
    if (isUnreserved) {
      out.writeCharCode(b);
    } else {
      out.write('%');
      out.write(hex[b >> 4]);
      out.write(hex[b & 0x0F]);
    }
  }
  return out.toString();
}
