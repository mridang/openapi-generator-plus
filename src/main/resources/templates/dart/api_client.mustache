import 'dart:typed_data';

import 'api_http_response.dart';
import 'api_stream_response.dart';

/// Interface for API HTTP transport.
///
/// Implementations handle the actual HTTP request/response cycle. The default
/// implementation uses `package:http`.
abstract class ApiClient {
  /// Send an HTTP request and return the response.
  ///
  /// Parameters:
  ///   - [method]: HTTP method (GET, POST, PUT, DELETE, etc.)
  ///   - [url]: fully qualified URL
  ///   - [headers]: HTTP headers
  ///   - [body]: request body (serialized JSON string, [Uint8List] for
  ///     binary, a `BodySource` for a binary body that is sent as it is read,
  ///     or [Map<String, Object>] for multipart form data; may be null)
  ///   - [noRedirect]: when true, any 3xx response (including 307/308) is
  ///     returned to the caller as-is rather than being replayed to the
  ///     `Location` target. OAuth2 token/revoke/authorize endpoint POSTs use
  ///     this guard so a malicious or misconfigured server cannot replay the
  ///     credentialed body to an attacker-controlled URL.
  ///   - [timeout]: end-to-end timeout in milliseconds for this request only;
  ///     null keeps the transport's own timeout
  ///   - [noDefaultHeaders]: when true, the default headers configured on the
  ///     transport are not added. Requests to an identity provider (token and
  ///     discovery) use this so an `Authorization` or API-key default header
  ///     meant for the API never reaches another host.
  ///
  /// Returns an [ApiHttpResponse] containing status code, body, and headers.
  /// Throws on transport errors.
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
  });
}

/// Optional capability of an [ApiClient]: sending a request and returning as
/// soon as the response headers are accepted, with the body not read yet.
///
/// An [ApiClient] that does not implement it keeps working for every buffered
/// call; a call that needs a stream (an operation whose success response is
/// binary) fails with an [UnsupportedError] naming the transport, instead of
/// falling back to buffering, which would never end on an endless body.
/// [DefaultApiClient] implements it.
abstract class StreamingApiClient implements ApiClient {
  /// Sends a request and returns the status, the lower-cased headers and the
  /// open body.
  ///
  /// The redirect, header and authentication rules are those of
  /// [ApiClient.sendRequest], up to the headers. [timeout] (milliseconds)
  /// stops at the headers; [idleTimeout] bounds the gap between two reads of
  /// the body in milliseconds (0 disables it, null keeps the transport's own
  /// setting). A non-2xx response is returned like any other, with its body
  /// open, and is never thrown. A failure after the headers surfaces from the
  /// body as a `StreamException`.
  ///
  /// Throws an [UnsupportedError] when the transport cannot stream.
  Future<ApiStreamResponse> sendStreaming(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
    int? idleTimeout,
  });
}

/// Optional capability of a [StreamingApiClient] that is also an
/// [AdmittingApiClient]: [sendAdmittedStreaming] sends a stream request
/// admitted by [AdmittingApiClient.beginRequest].
abstract class AdmittingStreamingApiClient
    implements AdmittingApiClient, StreamingApiClient {
  /// Sends a stream request admitted by [beginRequest]. Takes the same
  /// parameters as [sendStreaming] and does not check whether the client is
  /// closed.
  Future<ApiStreamResponse> sendAdmittedStreaming(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
    int? idleTimeout,
  });
}

/// Optional capability of an [ApiClient]: a request is admitted when its API
/// method is called, before any await (such as an OAuth token fetch), so a
/// close made while the request waits for its credential still lets the
/// request finish. An [ApiClient] without it is sent to through [sendRequest].
abstract class AdmittingApiClient implements ApiClient {
  /// Admits one request now and returns the function that marks it finished.
  /// Throws a [StateError] when the client is already closed.
  void Function() beginRequest();

  /// Sends a request admitted by [beginRequest]. Takes the same parameters as
  /// [ApiClient.sendRequest] and does not check whether the client is closed.
  Future<ApiHttpResponse> sendAdmittedRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
  });
}

/// Optional capability of an [ApiClient]: the retry policy the API classes
/// apply around [ApiClient.sendRequest].
///
/// [DefaultApiClient] implements it from its [TransportOptions]. An
/// [ApiClient] that does not implement it is never retried.
abstract class RetryingApiClient implements ApiClient {
  /// How many times a failed request is sent again; 0 disables retries.
  int get maxRetries;

  /// The end-to-end request timeout in milliseconds that retries must stay
  /// within, or null when there is none.
  int? get timeoutMillis;
}
