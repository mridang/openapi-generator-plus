import 'dart:typed_data';

import 'api_response.dart';

/// ApiClient is the interface for HTTP clients. Implementations must provide
/// [sendRequest] to perform the actual HTTP call.
abstract class ApiClient {
  /// Sends an HTTP request and returns the response.
  ///
  /// Parameters:
  ///   - [method]: HTTP method (GET, POST, PUT, DELETE, etc.)
  ///   - [url]: fully qualified URL
  ///   - [headers]: caller-provided headers
  ///   - [body]: request body as [Uint8List], [Map<String, Object>] for
  ///     multipart form data, or null
  ///   - [noRedirect]: when true, the client must not follow any 3xx
  ///     redirect and must return the raw redirect response to the caller.
  ///     Used by the OAuth2 token manager to refuse 307/308 redirects on
  ///     token endpoints (Gap 3.2), where silently replaying client
  ///     credentials to a different host would be a credential leak.
  ///
  /// Returns an [ApiHttpResponse] and throws on transport errors.
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
  });
}
