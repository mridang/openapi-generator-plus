/// Resolves [DefaultApiClient] to the right transport for the current platform
/// via a conditional export: the native (`dart:io`) implementation by default,
/// and the portable web ([BrowserClient]) implementation when compiling for the
/// web (`dart.library.js_interop` is present on `dart2js`/`dartdevc`/`wasm`).
/// Both expose the same `DefaultApiClient` API and re-export the shared
/// multipart helpers, so importers need not know which transport they got.
export 'default_api_client_io.dart'
    if (dart.library.js_interop) 'default_api_client_web.dart';
