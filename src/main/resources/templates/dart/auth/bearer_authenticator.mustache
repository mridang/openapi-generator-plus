import 'base_authenticator.dart';

/// BearerAuthenticator provides HTTP Bearer token authentication.
class BearerAuthenticator extends BaseAuthenticator {
  final String _host;
  final String _token;

  /// Creates a new Bearer authenticator.
  BearerAuthenticator({
    required String host,
    required String token,
  })  : _host = host,
        _token = token {
    /* RFC 7230 §3.2.6 — field-value is HTAB / SP / VCHAR / obs-text.
     * Reject anything outside printable ASCII + TAB so callers see a
     * clear error rather than HTTP header injection from CR/LF or
     * silently-mangled non-ASCII bytes. */
    if (token.codeUnits.any((c) => c != 0x09 && (c < 0x20 || c >= 0x7F))) {
      throw ArgumentError(
        'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)',
      );
    }
  }

  @override
  String host() => _host;

  @override
  Map<String, String> authHeaders() => {
        'Authorization': 'Bearer $_token',
      };
}
