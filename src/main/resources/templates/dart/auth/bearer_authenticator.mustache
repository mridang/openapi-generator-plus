import 'dart:async';

import '../environment.dart';
import 'base_authenticator.dart';

/* True when [value] is empty or holds only ASCII whitespace (space, tab, LF,
 * VT, FF, CR). Unicode spaces such as U+00A0 do not count as blank. */
bool _isAsciiBlank(String value) =>
    value.codeUnits.every((c) => c == 0x20 || (c >= 0x09 && c <= 0x0D));

/// Authenticator for HTTP Bearer token authentication.
///
/// The token comes from, in order: the explicit [token] argument or the
/// [tokenProvider] callback (never both), then the environment variable named
/// by [environmentVariable]. A token that is found nowhere fails the
/// constructor, so a client is never built without its credential.
class BearerAuthenticator extends BaseAuthenticator {
  /// The environment variable read when neither [token] nor [tokenProvider] is
  /// given and no [environmentVariable] names another one.
  static const String defaultEnvironmentVariable = '{{envVarPrefix}}_TOKEN';

  final String _host;
  final String? _token;
  final FutureOr<String> Function()? _tokenProvider;

  /// Creates an HTTP Bearer token authenticator.
  ///
  /// [host] is the base URL of the API. [token] is the bearer token.
  /// [tokenProvider] is called on every request and returns the current token,
  /// so a rotating or short-lived token never needs a new client; it may be
  /// asynchronous. [environmentVariable] names the variable that supplies the
  /// token when neither is given (default [defaultEnvironmentVariable]); it is
  /// read once, here, and an empty value counts as unset. [environment]
  /// replaces the process environment, for the browser or for tests.
  BearerAuthenticator({
    required String host,
    String? token,
    FutureOr<String> Function()? tokenProvider,
    String? environmentVariable,
    Map<String, String>? environment,
  })  : _host = host,
        _tokenProvider = tokenProvider,
        _token = _resolve(
          token,
          tokenProvider,
          environmentVariable ?? defaultEnvironmentVariable,
          environment,
        ) {
    final fixed = _token;
    if (fixed != null) {
      _validate(fixed);
    }
  }

  static String? _resolve(
    String? token,
    FutureOr<String> Function()? tokenProvider,
    String environmentVariable,
    Map<String, String>? environment,
  ) {
    if (token != null && tokenProvider != null) {
      throw ArgumentError('Pass either token or tokenProvider, not both');
    }
    if (token != null) {
      return token;
    }
    if (tokenProvider != null) {
      return null;
    }
    final fromEnvironment = readEnvironmentVariable(environmentVariable, environment);
    if (fromEnvironment == null) {
      throw ArgumentError(
        'A bearer token is required: pass token or tokenProvider, or set the '
        '$environmentVariable environment variable',
      );
    }
    return fromEnvironment;
  }

  static void _validate(String token) {
    /* Reject an empty or whitespace-only token up front so the SDK never
     * emits a bare `Authorization: Bearer ` header, matching the api-key
     * authenticator's own empty guard. */
    if (_isAsciiBlank(token)) {
      throw ArgumentError('Bearer token must not be empty');
    }
    /* RFC 7230 §3.2.6 — field-value is HTAB / SP / VCHAR / obs-text.
     * Reject anything outside printable ASCII + TAB so callers see a
     * clear error rather than HTTP header injection from CR/LF or
     * silently-mangled non-ASCII bytes. */
    if (token.codeUnits.any((c) => c != 0x09 && (c < 0x20 || c >= 0x7F))) {
      throw ArgumentError(
        'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)',
      );
    }
  }

  @override
  String host() => _host;

  Map<String, String> _header(String token) {
    /* Dedupe "Bearer " prefix (case-insensitive ASCII): tokens read
     * from env files are commonly stored already-prefixed; emitting
     * "Bearer Bearer xyz" would otherwise silently break auth. */
    var value = token;
    if (value.length >= 7 && value.substring(0, 7).toLowerCase() == 'bearer ') {
      value = value.substring(7);
    }
    return {'Authorization': 'Bearer $value'};
  }

  @override
  Map<String, String> authHeaders() {
    final provider = _tokenProvider;
    if (provider == null) {
      return _header(_token!);
    }
    final provided = provider();
    if (provided is Future<String>) {
      throw StateError(
          'The token provider is asynchronous; use authHeadersAsync() instead.');
    }
    _validate(provided);
    return _header(provided);
  }

  @override
  Future<Map<String, String>> authHeadersAsync() async {
    final provider = _tokenProvider;
    if (provider == null) {
      return _header(_token!);
    }
    final provided = await provider();
    _validate(provided);
    return _header(provided);
  }

  /// Redacts the bearer token so it never leaks through logging, string
  /// interpolation, or `toString()`. Non-secret fields stay visible.
  @override
  String toString() => '$runtimeType(host: $_host, token: ***)';
}
