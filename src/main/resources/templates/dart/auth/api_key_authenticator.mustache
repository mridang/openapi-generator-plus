import 'api_key_location.dart';
import 'base_authenticator.dart';

/// ApiKeyAuthenticator provides API key authentication.
///
/// The API key can be sent as a header, query parameter, or cookie,
/// depending on the location specified at construction.
class ApiKeyAuthenticator extends BaseAuthenticator {
  final String _host;
  final String _keyParamName;
  final String _apiKey;
  final ApiKeyLocation _location;

  /// Creates a new API key authenticator.
  ///
  /// Parameters:
  ///   - [host]: API base URL
  ///   - [keyParamName]: name of the key parameter
  ///   - [apiKey]: the API key value
  ///   - [location]: where to send the key (header, query, or cookie)
  ApiKeyAuthenticator({
    required String host,
    required String keyParamName,
    required String apiKey,
    required ApiKeyLocation location,
  })  : _host = host,
        _keyParamName = keyParamName,
        _apiKey = apiKey,
        _location = location {
    /* RFC 7230 §3.2.6 — field-value is HTAB / SP / VCHAR / obs-text.
     * Reject anything outside printable ASCII + TAB so callers see a
     * clear error rather than (a) HTTP header injection from CR/LF,
     * or (b) silently-mangled non-ASCII bytes that different HTTP
     * libs encode differently per language. */
    if (location == ApiKeyLocation.header &&
        apiKey.codeUnits.any((c) => c != 0x09 && (c < 0x20 || c >= 0x7F))) {
      throw ArgumentError(
        "API key for header '$keyParamName' must contain only printable ASCII characters (RFC 7230 §3.2.6)",
      );
    }
  }

  @override
  String host() => _host;

  /// Returns the API key as a header if the location is [ApiKeyLocation.header].
  @override
  Map<String, String> authHeaders() {
    if (_location == ApiKeyLocation.header) {
      return {_keyParamName: _apiKey};
    }
    return {};
  }

  /// Returns the API key as a query parameter if the location is
  /// [ApiKeyLocation.query].
  @override
  Map<String, String> queryParams() {
    if (_location == ApiKeyLocation.query) {
      return {_keyParamName: _apiKey};
    }
    return {};
  }

  /// Returns the API key as a cookie if the location is
  /// [ApiKeyLocation.cookie].
  @override
  Map<String, String> cookieParams() {
    if (_location == ApiKeyLocation.cookie) {
      return {_keyParamName: _apiKey};
    }
    return {};
  }
}
