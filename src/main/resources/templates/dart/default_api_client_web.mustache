import 'dart:typed_data';

import 'package:http/browser_client.dart';

import 'abstract_api_client.dart';
import 'errors/api_error.dart';
import 'transport_options.dart';

export 'abstract_api_client.dart';

/// Portable web [DefaultApiClient]: the transport selected on Flutter Web and
/// any `dart2js`/`wasm` target, chosen automatically by the conditional export
/// in `default_api_client.dart`. It is backed by `package:http`'s
/// [BrowserClient] (the browser `fetch`/`XMLHttpRequest` layer) and imports no
/// `dart:io`, so it compiles and runs where `dart:io` is unavailable.
///
/// All redirect handling, multipart encoding, charset decoding, and header
/// injection are inherited from [AbstractApiClient]. The only capabilities it
/// cannot provide are the ones that require a `dart:io` [HttpClient]: proxy
/// routing, a custom CA certificate, and disabling TLS verification. Requesting
/// any of those throws a typed [ApiError] at construction rather than silently
/// ignoring the setting; configure them on a native deployment (or your
/// platform's own egress controls) instead.
class DefaultApiClient extends AbstractApiClient {
  /// Creates a browser-backed client with the given transport settings.
  ///
  /// Throws a typed [ApiError] when a transport feature that the browser
  /// cannot express -- proxy, custom CA certificate, or TLS-verification-off --
  /// is requested, so the misconfiguration fails fast rather than being
  /// silently dropped.
  factory DefaultApiClient({TransportOptions? transportOptions}) {
    final options = transportOptions ?? TransportOptionsBuilder().build();
    if (options.proxy != null ||
        options.caCertPath != null ||
        !options.verifySsl) {
      throw ApiError(
        statusCode: 0,
        message:
            'proxy routing, a custom CA certificate, and disabling TLS '
            'verification require a native (dart:io) runtime; this build is '
            'running on the web (BrowserClient). Configure these on a native '
            'deployment or via your platform instead.',
      );
    }
    return DefaultApiClient._(
      options,
      BrowserClient(),
      AbstractApiClient.buildProxyAuthHeader(options.proxy),
    );
  }

  DefaultApiClient._(super.options, super.client, super.proxyAuth);

  /// On the web the browser's fetch layer has already decoded any declared
  /// `Content-Encoding`, so the bytes here are plaintext and are returned
  /// unchanged. The native transport's gzip-lie hardening is not available in
  /// the browser (no dart:io codec) -- a documented platform exception.
  @override
  Uint8List decompressBytes(Uint8List bytes, String contentEncoding) {
    return bytes;
  }
}
