{{>api_info}}
/// Settings of one JSON Lines or server-sent events call, passed last to its
/// `...Stream` method. A setting left null keeps its default. They live here
/// and not in the per-call options, which carry only `timeout`, `maxRetries`
/// and `headers`.
class StreamOptions {
  /// Creates options that keep every default that is not named.
  const StreamOptions({
    this.idleTimeout,
    this.maxReconnects,
    this.reconnectDelay,
    this.lastEventId,
    this.maxEventBytes,
  });

  /// The longest the body may stay silent, in milliseconds, for this call; 0
  /// disables it. The default is the transport's `idleTimeout`.
  final int? idleTimeout;

  /// How many times a lost server-sent events connection is re-established
  /// without an event in between; -1 is unlimited and 0 turns reconnecting off.
  /// The default is 5 for a request without a body and 0 for a request that has
  /// a body.
  final int? maxReconnects;

  /// The first wait before a reconnect, in milliseconds; it doubles up to 30
  /// seconds and is reduced by up to 25% of jitter. A `retry` value from the
  /// server replaces it. The default is 1000.
  final int? reconnectDelay;

  /// The event id the first request resumes from, sent as `Last-Event-ID`.
  final String? lastEventId;

  /// The longest a JSON Lines line or an event may be, in bytes. The default is
  /// 1 MiB.
  final int? maxEventBytes;

  @override
  String toString() =>
      'StreamOptions(idleTimeout: $idleTimeout, maxReconnects: $maxReconnects, '
      'reconnectDelay: $reconnectDelay, maxEventBytes: $maxEventBytes)';
}
