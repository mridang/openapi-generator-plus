/// Represents a server variable from the OpenAPI specification.
///
/// Server variables define substitution parameters in server URL templates.
/// Each variable has a default value and may optionally restrict values to
/// an enumerated set.
///
/// This class is immutable.
class ServerVariable {
  /// The default value used when no override is provided.
  final String defaultValue;

  /// Human-readable description of the variable, or an empty string if not
  /// specified.
  final String description;

  /// Allowed values for this variable.
  ///
  /// An empty list means any value is accepted.
  final List<String> enumValues;

  /// Create a new server variable.
  const ServerVariable({
    required this.defaultValue,
    this.description = '',
    this.enumValues = const [],
  });
}

/// Represents a single server entry from the OpenAPI specification.
///
/// A server URL may contain template variables (e.g.
/// `https://{env}.api.example.com/v{version}`). Use [url] to resolve the URL
/// with default variable values, or pass overrides to substitute specific
/// variables.
///
/// This class is immutable.
class ServerConfiguration {
  /// The raw URL template before variable substitution.
  final String urlTemplate;

  /// Human-readable description of this server, or an empty string if not
  /// specified.
  final String description;

  /// The server variables and their definitions.
  ///
  /// Maps variable names to their [ServerVariable] definitions.
  final Map<String, ServerVariable> variables;

  /// Create a new server configuration.
  const ServerConfiguration({
    required this.urlTemplate,
    this.description = '',
    this.variables = const {},
  });

  /// Resolve the URL template, substituting variable values.
  ///
  /// Variables not present in [overrides] use their default values. If a
  /// variable has an enum constraint, the override value is validated against
  /// the allowed values.
  ///
  /// Returns the fully resolved URL. Throws [ArgumentError] if an override
  /// value is not in the variable's enumValues.
  String url([Map<String, String>? overrides]) {
    var result = urlTemplate;
    for (final entry in variables.entries) {
      final varName = entry.key;
      final variable = entry.value;
      var value = variable.defaultValue;

      if (overrides != null && overrides.containsKey(varName)) {
        value = overrides[varName]!;
      }

      if (variable.enumValues.isNotEmpty) {
        if (!variable.enumValues.contains(value)) {
          throw ArgumentError(
            "Invalid value '$value' for server variable '$varName'. "
            "Allowed values: ${variable.enumValues}",
          );
        }
      }

      result = result.replaceAll('{$varName}', value);
    }
    return result;
  }
}
