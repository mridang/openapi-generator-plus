import 'dart:io';
import 'dart:typed_data';

import 'package:http/http.dart' as http;
import 'package:http/io_client.dart';

import 'abstract_api_client.dart';
import 'errors/api_error.dart';
import 'transport_options.dart';

export 'abstract_api_client.dart';

/// Native [DefaultApiClient]: the transport selected on the Dart VM, Flutter
/// mobile/desktop, and server runtimes (anywhere `dart:io` is available). It is
/// chosen automatically by the conditional export in `default_api_client.dart`.
///
/// Backed by `dart:io`'s [HttpClient] via [IOClient], so it supports full
/// transport configuration from [TransportOptions]: TLS verification, custom CA
/// certificates, proxy routing (incl. basic-auth), and timeouts. All
/// redirect handling, multipart encoding, charset decoding, and header
/// injection are inherited from [AbstractApiClient]; this class supplies only
/// the dart:io client and the gzip/deflate decompression.
class DefaultApiClient extends AbstractApiClient {
  /// Creates a client with the given transport settings.
  ///
  /// If [transportOptions] is null, default transport settings are used.
  ///
  /// A factory body (rather than an initializer list) is used so that a
  /// failure to read/load/parse a caller-supplied custom CA certificate
  /// is caught and rethrown as the SDK's typed [ApiError] (statusCode 0,
  /// original error preserved as [ApiError.underlyingError]) instead of
  /// leaking a raw `dart:io` FileSystemException / TlsException.
  factory DefaultApiClient({TransportOptions? transportOptions}) {
    final options = transportOptions ?? TransportOptionsBuilder().build();
    return DefaultApiClient._(
      options,
      _createClient(options),
      AbstractApiClient.buildProxyAuthHeader(options.proxy),
    );
  }

  DefaultApiClient._(super.options, super.client, super.proxyAuth);

  /// Creates an [IOClient] configured from the given [TransportOptions].
  ///
  /// Configures TLS certificate verification, custom CA certificates,
  /// and proxy routing based on transport option settings.
  static http.Client _createClient(TransportOptions options) {
    final context = SecurityContext(withTrustedRoots: true);
    if (options.caCertPath != null) {
      /* A caller-supplied custom CA certificate (TLS pinning) that is
       * missing, unreadable, or unparseable must fail fast — but as the
       * SDK's typed ApiError, not the raw dart:io FileSystemException /
       * TlsException that setTrustedCertificates throws. A caller guarding
       * construction with `on ApiError` would otherwise MISS this
       * security-relevant TLS-pinning misconfiguration. statusCode 0 marks
       * a pre-flight (no HTTP exchange) failure; the original error is
       * preserved as underlyingError. */
      try {
        context.setTrustedCertificates(options.caCertPath!);
      } catch (e) {
        throw ApiError(
          statusCode: 0,
          message:
              'failed to read or parse CA certificate from ${options.caCertPath}: $e',
          underlyingError: e,
        );
      }
    }

    final ioClient = HttpClient(context: context);
    ioClient.autoUncompress = false;

    if (!options.verifySsl) {
      ioClient.badCertificateCallback = (_, __, ___) => true;
    }

    if (options.proxy != null) {
      final proxy = options.proxy!;
      ioClient.findProxy = (_) => 'PROXY ${proxy.host}:${proxy.port}';
      /* Wire basic-auth into dart:io's per-proxy auth store so the
       * underlying HttpClient sends Proxy-Authorization on the CONNECT
       * tunnel (needed for HTTPS through an authenticating proxy).
       * sendRequest also sets the header on plain HTTP requests via
       * proxyAuthHeader for parity with Java/C#. */
      if (proxy.userInfo.isNotEmpty) {
        final parts = proxy.userInfo.split(':');
        final user = Uri.decodeComponent(parts[0]);
        final pass = parts.length > 1
            ? Uri.decodeComponent(parts.sublist(1).join(':'))
            : '';
        ioClient.addProxyCredentials(
          proxy.host,
          proxy.port,
          '',
          HttpClientBasicCredentials(user, pass),
        );
      }
    }

    if (options.timeout != null) {
      ioClient.connectionTimeout = Duration(milliseconds: options.timeout!);
    }

    return IOClient(ioClient);
  }

  /// Decompresses [bytes] according to [contentEncoding] using dart:io's
  /// [GZipCodec] and [ZLibDecoder]. An empty encoding passes bytes through;
  /// an unknown encoding (`identity`, `br`, `zstd`) is passed through unchanged
  /// to match the canonical Java/Go/Ruby/PHP decompressors. A body advertised
  /// as gzip/deflate that fails to decode surfaces a typed [ApiError] (Gap AL).
  @override
  Uint8List decompressBytes(Uint8List bytes, String contentEncoding) {
    if (bytes.isEmpty) return bytes;
    switch (contentEncoding) {
      case '':
        return bytes;
      case 'gzip':
        try {
          return Uint8List.fromList(GZipCodec().decode(bytes));
        } catch (e) {
          throw ApiError(
            statusCode: 0,
            message:
                'Server claimed Content-Encoding: gzip but body is not valid gzip: $e',
            underlyingError: e,
          );
        }
      case 'deflate':
        try {
          return Uint8List.fromList(ZLibDecoder().convert(bytes));
        } catch (e) {
          throw ApiError(
            statusCode: 0,
            message:
                'Server claimed Content-Encoding: deflate but body is not valid deflate: $e',
            underlyingError: e,
          );
        }
      default:
        return bytes;
    }
  }
}
