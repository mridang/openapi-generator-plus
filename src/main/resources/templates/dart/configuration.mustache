import 'call_hook.dart';
import 'server_configuration.dart';

/// API-level configuration for generated client classes.
///
/// Holds the base URL and default headers that are applied to every API
/// request. Transport-level settings (TLS, proxy, timeouts) belong in
/// [TransportOptions] and are configured on the [DefaultApiClient].
///
/// This class is immutable. Use [Configuration.builder] to create instances:
///
/// ```dart
/// final config = Configuration.builder()
///   .baseUrl('https://api.example.com')
///   .defaultHeader('Authorization', 'Bearer token')
///   .build();
/// ```
class Configuration {
  /// The base URL for all API requests.
  ///
  /// Defaults to the first server URL from the OpenAPI specification.
  final String baseUrl;

  /// Default headers included in every API request.
  ///
  /// These headers are merged after transport-level headers from
  /// [TransportOptions] but before operation-specific headers and
  /// authentication headers.
  final Map<String, String> _defaultHeaders;

  /// The hook called around every operation call, or null for none.
  ///
  /// It runs above the transport, so it also fires when you supply your own
  /// `http.Client`. It is not part of [toString], which would print it.
  final CallHook? callHook;

  /// Whether every request body is checked against the validation keywords
  /// of its schema (minLength, pattern, minimum, ...) before it is sent.
  ///
  /// Off by default. When on, a body that breaks one throws an
  /// [ArgumentError] and nothing is sent.
  final bool validateConstraints;

  Configuration._({
    required this.baseUrl,
    required Map<String, String> defaultHeaders,
    this.callHook,
    this.validateConstraints = false,
  }) : _defaultHeaders = Map.unmodifiable(defaultHeaders);

  /// Default headers included in every API request.
  ///
  /// Returns a copy of the headers, so modifying it does not affect this
  /// configuration.
  Map<String, String> get defaultHeaders => Map<String, String>.from(_defaultHeaders);

  /// Shows the base URL and the default headers, with credential headers masked.
  @override
  String toString() {
    final shown = _defaultHeaders.map(
      (name, value) => MapEntry(name, _isSecretHeader(name) ? '***' : value),
    );
    return 'Configuration(baseUrl: $baseUrl, defaultHeaders: $shown)';
  }

  static bool _isSecretHeader(String name) {
    final lower = name.toLowerCase();
    return lower == 'authorization' ||
        lower == 'proxy-authorization' ||
        lower == 'cookie' ||
        lower.contains('key') ||
        lower.contains('token') ||
        lower.contains('secret');
  }

  /// Create a new builder for constructing [Configuration] instances.
  static ConfigurationBuilder builder() => ConfigurationBuilder();

  /// Return a [Configuration] with default values.
  ///
  /// A fresh instance every call: the SDK keeps no process-wide default a
  /// caller could swap out from under another caller.
  factory Configuration.defaultConfiguration() {
    return ConfigurationBuilder().build();
  }
}

/// Builder for creating immutable [Configuration] instances.
class ConfigurationBuilder {
  String _baseUrl = '{{{basePath}}}';
  final Map<String, String> _defaultHeaders = {};
  CallHook? _callHook;
  bool _validateConstraints = false;

  /// Set the base URL for all API requests.
  ConfigurationBuilder baseUrl(String val) {
    _baseUrl = val;
    return this;
  }

  /// Add a single default header to include in every API request.
  ConfigurationBuilder defaultHeader(String name, String value) {
    _defaultHeaders[name] = value;
    return this;
  }

  /// Add multiple default headers to include in every API request.
  ConfigurationBuilder defaultHeaders(Map<String, String> headers) {
    _defaultHeaders.addAll(headers);
    return this;
  }

  /// Set the [CallHook] called around every operation call.
  ///
  /// Use [chainCallHooks] to set several. Passing null removes the hook.
  ConfigurationBuilder callHook(CallHook? val) {
    _callHook = val;
    return this;
  }

  /// Turn the check of every request body against the validation keywords
  /// of its schema on or off.
  ///
  /// Off by default. When on, a body that breaks one throws an
  /// [ArgumentError] before anything is sent.
  ConfigurationBuilder validateConstraints(bool val) {
    _validateConstraints = val;
    return this;
  }

  /// Set the base URL by resolving a server configuration with optional
  /// variable overrides.
  ///
  /// This is a convenience method that calls [ServerConfiguration.url] with
  /// the given [variables] and stores the result as the base URL. If the user
  /// also calls [baseUrl] after this method, the explicit base URL wins.
  /// Variables not present in [variables] use their default values.
  ConfigurationBuilder server(ServerConfiguration server, [Map<String, String>? variables]) {
    _baseUrl = server.url(variables);
    return this;
  }

  /// Build and return an immutable [Configuration] instance.
  Configuration build() {
    return Configuration._(
      baseUrl: _baseUrl,
      defaultHeaders: Map<String, String>.from(_defaultHeaders),
      callHook: _callHook,
      validateConstraints: _validateConstraints,
    );
  }
}
