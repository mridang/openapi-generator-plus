import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';

import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('DefaultApiClient', () {
    test('GET request', () async {
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        expect(request.method, equals('GET'));
        request.response
          ..statusCode = 200
          ..headers.contentType = ContentType.json
          ..write('{"message":"success"}')
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final resp = await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(resp.statusCode, equals(200));
        expect(resp.body, contains('success'));
      } finally {
        await server.close();
      }
    });

    test('POST with JSON body', () async {
      String? receivedBody;
      String? receivedContentType;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) async {
        expect(request.method, equals('POST'));
        receivedContentType = request.headers.contentType?.mimeType;
        receivedBody = await utf8.decodeStream(request);
        request.response
          ..statusCode = 201
          ..write('{"id":1}')
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final body = utf8.encode(jsonEncode({'name': 'test'}));
        final headers = {'Content-Type': 'application/json'};

        final resp = await client.sendRequest(
          'POST',
          'http://localhost:${server.port}/items',
          headers,
          Uint8List.fromList(body),
        );
        expect(resp.statusCode, equals(201));
        expect(receivedBody, contains('test'));
      } finally {
        await server.close();
      }
    });

    test('response headers', () async {
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        request.response
          ..statusCode = 200
          ..headers.add('X-Custom-Header', 'custom-value')
          ..headers.contentType = ContentType.json
          ..write('{}')
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final resp = await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(resp.headers['x-custom-header'], equals('custom-value'));
      } finally {
        await server.close();
      }
    });

    test('non-2xx status', () async {
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        request.response
          ..statusCode = 500
          ..headers.contentType = ContentType.json
          ..write('{"error":"internal"}')
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final resp = await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/fail',
          {},
          null,
        );
        // DefaultApiClient returns the response as-is; error dispatch is done by BaseApi
        expect(resp.statusCode, equals(500));
      } finally {
        await server.close();
      }
    });

    test('PUT request', () async {
      String? receivedMethod;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedMethod = request.method;
        request.response
          ..statusCode = 200
          ..write('{}')
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final body = utf8.encode(jsonEncode({'name': 'updated'}));
        await client.sendRequest(
          'PUT',
          'http://localhost:${server.port}/items/1',
          {'Content-Type': 'application/json'},
          Uint8List.fromList(body),
        );
        expect(receivedMethod, equals('PUT'));
      } finally {
        await server.close();
      }
    });

    test('DELETE request', () async {
      String? receivedMethod;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedMethod = request.method;
        request.response
          ..statusCode = 204
          ..close();
      });

      try {
        final client = DefaultApiClient();
        final resp = await client.sendRequest(
          'DELETE',
          'http://localhost:${server.port}/items/1',
          {},
          null,
        );
        expect(receivedMethod, equals('DELETE'));
        expect(resp.statusCode, equals(204));
      } finally {
        await server.close();
      }
    });
  });
}
{{/generateTests}}
