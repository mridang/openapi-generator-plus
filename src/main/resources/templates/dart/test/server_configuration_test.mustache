import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('ServerConfiguration', () {
    test('resolves URL template using default variable values', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com/v{version}',
        description: 'primary server',
        variables: {
          'env': ServerVariable(
            defaultValue: 'prod',
            enumValues: ['prod', 'staging'],
          ),
          'version': ServerVariable(defaultValue: '1'),
        },
      );

      expect(config.url(), equals('https://prod.api.example.com/v1'));
    });

    test('applies overrides and falls back to defaults for unset variables', () {
      // "env" is overridden, "version" is left to its default — the resolved
      // URL must mix both.
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com/v{version}',
        variables: {
          'env': ServerVariable(
            defaultValue: 'prod',
            enumValues: ['prod', 'staging'],
          ),
          'version': ServerVariable(defaultValue: '1'),
        },
      );

      expect(
        config.url({'env': 'staging'}),
        equals('https://staging.api.example.com/v1'),
      );
    });

    test('exposes raw URL template and description', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com',
        description: 'primary server',
        variables: {
          'env': ServerVariable(defaultValue: 'prod'),
        },
      );

      expect(config.urlTemplate, equals('https://{env}.api.example.com'));
      expect(config.description, equals('primary server'));
    });

    test('rejects override value outside the variable enum', () {
      // server-variable-enum-validation: an override that is not in the
      // variable's enum is rejected at resolution time.
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com',
        variables: {
          'env': ServerVariable(
            defaultValue: 'prod',
            enumValues: ['prod', 'staging'],
          ),
        },
      );

      expect(
        () => config.url({'env': 'dev'}),
        throwsA(isA<ArgumentError>()
            .having((e) => e, 'not an SDK exception', isNot(isA<{{errorPrefix}}Exception>()))),
      );
    });
  });

  group('ServerConfiguration variable validation', () {
    test('the rejection names the value, the variable and the allowed values', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com',
        variables: {
          'env': ServerVariable(
            defaultValue: 'prod',
            enumValues: ['prod', 'staging'],
          ),
        },
      );

      expect(
        () => config.url({'env': 'dev'}),
        throwsA(
          isA<ArgumentError>().having(
            (e) => e.message,
            'message',
            equals(
              "Invalid value 'dev' for server variable 'env'. Allowed values: [prod, staging]",
            ),
          ),
        ),
      );
    });

    test('a default outside the enum is rejected as well', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com',
        variables: {
          'env': ServerVariable(
            defaultValue: 'dev',
            enumValues: ['prod', 'staging'],
          ),
        },
      );

      expect(
        () => config.url(),
        throwsA(
          isA<ArgumentError>().having(
            (e) => e.message,
            'message',
            startsWith("Invalid value 'dev' for server variable 'env'."),
          ),
        ),
      );
    });

    test('a variable without an enum accepts any override', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com',
        variables: {'env': ServerVariable(defaultValue: 'prod')},
      );

      expect(
        config.url({'env': 'anything'}),
        equals('https://anything.api.example.com'),
      );
    });

    test('a template without variables is returned unchanged', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://api.example.com/v1',
      );

      expect(config.url(), equals('https://api.example.com/v1'));
    });

    test('a variable that appears twice is substituted everywhere', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{region}.example.com/{region}',
        variables: {'region': ServerVariable(defaultValue: 'eu')},
      );

      expect(config.url(), equals('https://eu.example.com/eu'));
      expect(
        config.url({'region': 'us'}),
        equals('https://us.example.com/us'),
      );
    });

    test('the third global server round-trips every text field unchanged', () {
      final server = allServers[2];

      expect(server.urlTemplate, equals('https://{tenant}.example.com/api'));
      expect(server.description,
          equals('Bob\'s "sandbox" & co: \$5 #{x} a*/b'));
      final tenant = server.variables['tenant']!;
      expect(tenant.defaultValue, equals('o\'neil'));
      expect(tenant.description, equals('Tenant\'s "id"'));
      expect(tenant.enumValues, equals(['o\'neil', 'a&b']));
    });

    test('the third global server resolves to the raw characters', () {
      final server = allServers[2];

      expect(server.url(), equals('https://o\'neil.example.com/api'));
      expect(server.url({'tenant': 'a&b'}), equals('https://a&b.example.com/api'));
    });

    test('does not expand a placeholder that a substituted value introduces', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.api.example.com/{version}',
        variables: {
          'env': ServerVariable(defaultValue: '{version}'),
          'version': ServerVariable(defaultValue: 'v2'),
        },
      );

      expect(config.url(), equals('https://{version}.api.example.com/v2'));
    });

    test('does not expand a placeholder an override introduces, in either order', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{a}.example.com/{b}',
        variables: {
          'a': ServerVariable(defaultValue: 'x'),
          'b': ServerVariable(defaultValue: 'y'),
        },
      );

      expect(config.url({'b': '{a}'}), equals('https://x.example.com/{a}'));
      expect(config.url({'a': '{b}'}), equals('https://{b}.example.com/y'));
    });

    test('a placeholder without a variable is left in place', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{host}/{unknown}',
        variables: {'host': ServerVariable(defaultValue: 'h')},
      );

      expect(config.url(), equals('https://h/{unknown}'));
    });

    test('a constant configuration cannot be modified through its variables', () {
      const config = ServerConfiguration(
        urlTemplate: 'https://{env}.example.com',
        variables: {
          'env': ServerVariable(
              defaultValue: 'prod', enumValues: ['prod', 'staging']),
        },
      );

      expect(() => config.variables['other'] = const ServerVariable(defaultValue: 'x'),
          throwsUnsupportedError);
      expect(() => config.variables['env']!.enumValues.add('dev'),
          throwsUnsupportedError);
      expect(() => allServers.add(config), throwsUnsupportedError);
    });
  });
}
