import 'dart:convert';
import 'dart:typed_data';

import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

class _FakeApiClient implements ApiClient {
  final List<ApiHttpResponse> _responses = [];
  String? lastBody;
  String? lastUrl;
  final List<String> urls = [];
  final List<String> bodies = [];
  Map<String, String> lastHeaders = const {};

  void enqueue(String body, {int statusCode = 200}) {
    _responses.add(ApiHttpResponse(statusCode: statusCode, body: body, headers: {}));
  }

  @override
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
  }) async {
    lastUrl = url;
    urls.add(url);
    lastHeaders = headers;
    if (body != null) {
      final text = utf8.decode(body as List<int>);
      lastBody = text;
      bodies.add(text);
    }
    return _responses.removeAt(0);
  }
}

OAuth2PasswordAuthenticator _createAuthenticator() {
  return OAuth2PasswordAuthenticator(
    host: 'https://api.example.com',
    clientId: 'my-client-id',
    clientSecret: 'my-client-secret',
    tokenUrl: 'https://auth.example.com/token',
    username: 'testuser',
    password: 'testpass',
    scopes: ['read', 'write'],
  );
}

void main() {
  group('OAuth2PasswordAuthenticator', () {
    test('the synchronous authHeaders raises instead of returning no credentials', () {
      expect(
        () => _createAuthenticator().authHeaders(),
        throwsA(isA<StateError>().having((e) => e.message, 'message',
            'OAuth2 authenticators require async token exchange; use authHeadersAsync() instead.')),
      );
    });

    test('sends password grant type', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');

      final auth = _createAuthenticator();
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      expect(client.lastBody, isNotNull);
      expect(client.lastBody!, contains('grant_type=password'));
    });

    test('sends username and password', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');

      final auth = _createAuthenticator();
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      expect(client.lastBody!, contains('username=testuser'));
      expect(client.lastBody!, contains('password=testpass'));
    });

    test('sends client id and secret', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');

      final auth = _createAuthenticator();
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      expect(client.lastBody!, contains('client_id=my-client-id'));
      expect(client.lastBody!, contains('client_secret=my-client-secret'));
    });

    test('returns authorization bearer header', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok-pwd","expires_in":3600}');

      final auth = _createAuthenticator();
      auth.setApiClient(client);

      final headers = await auth.authHeadersAsync();

      expect(headers['Authorization'], equals('Bearer tok-pwd'));
    });

    test('uses refresh token on subsequent calls', () async {
      final client = _FakeApiClient();
      client.enqueue(
          '{"access_token":"tok1","refresh_token":"ref1","expires_in":1}');
      client.enqueue('{"access_token":"tok2","expires_in":3600}');

      final auth = _createAuthenticator();
      auth.setApiClient(client);

      await auth.authHeadersAsync();
      await auth.authHeadersAsync();

      expect(client.lastBody!, contains('grant_type=refresh_token'));
      expect(client.lastBody!, contains('refresh_token=ref1'));
    });

    test('getHost returns configured host', () {
      final auth = _createAuthenticator();

      expect(auth.host(), equals('https://api.example.com'));
    });

    test('basic auth url-encodes client id and secret', () async {
      // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
      // client_id and client_secret MUST be application/x-www-form-
      // urlencoded BEFORE being joined with ':' and base64-encoded.
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"at","expires_in":3600}');

      final auth = OAuth2PasswordAuthenticator(
        host: 'https://api.example.com',
        clientId: 'id+with/special',
        clientSecret: 'secret&with=stuff',
        tokenUrl: 'https://auth.example.com/token',
        username: 'testuser',
        password: 'testpass',
        scopes: ['read'],
        clientAuthMethod: ClientAuthMethod.basic,
      );
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      final authHeader = client.lastHeaders['Authorization'];
      expect(authHeader, isNotNull);
      expect(authHeader!, startsWith('Basic '));
      final b64 = authHeader.substring('Basic '.length);
      final decoded = utf8.decode(base64.decode(b64));
      // Expected: form-urlencoded id ':' form-urlencoded secret
      expect(decoded, equals('id%2Bwith%2Fspecial:secret%26with%3Dstuff'));
    });

    test('redacts the secret in toString', () {
      final auth = OAuth2PasswordAuthenticator(
        host: 'https://api.example.com',
        clientId: 'my-client-id',
        clientSecret: 'my-client-secret',
        tokenUrl: 'https://auth.example.com/token',
        username: 'testuser',
        password: 'testpass',
        scopes: ['read', 'write'],
      );
      expect(auth.toString(), isNot(contains('my-client-secret')));
      expect(auth.toString(), isNot(contains('testpass')));
      expect(auth.toString(), contains('***'));
    });
  });

  group('OAuth2PasswordAuthenticator wire format', () {
    OAuth2PasswordAuthenticator build({String refreshUrl = ''}) =>
        OAuth2PasswordAuthenticator(
          host: 'https://api.example.com',
          clientId: 'my-client-id',
          clientSecret: 'my-client-secret',
          tokenUrl: 'https://auth.example.com/token',
          refreshUrl: refreshUrl,
          username: 'testuser',
          password: 'testpass',
          scopes: ['read', 'write'],
        );

    test('the first grant goes to tokenUrl and the refresh grant to refreshUrl', () async {
      final client = _FakeApiClient();
      client.enqueue(
        '{"access_token":"tok1","refresh_token":"ref1","expires_in":1}',
      );
      client.enqueue('{"access_token":"tok2","expires_in":3600}');
      final auth = build(refreshUrl: 'https://auth.example.com/oauth/refresh');
      auth.setApiClient(client);

      await auth.authHeadersAsync();
      await auth.authHeadersAsync();

      expect(
        client.urls,
        equals([
          'https://auth.example.com/token',
          'https://auth.example.com/oauth/refresh',
        ]),
      );
      expect(client.bodies[0], startsWith('grant_type=password&'));
      expect(client.bodies[1], startsWith('grant_type=refresh_token&'));
    });

    test('without a refreshUrl the refresh grant also goes to tokenUrl', () async {
      final client = _FakeApiClient();
      client.enqueue(
        '{"access_token":"tok1","refresh_token":"ref1","expires_in":1}',
      );
      client.enqueue('{"access_token":"tok2","expires_in":3600}');
      final auth = build();
      auth.setApiClient(client);

      await auth.authHeadersAsync();
      await auth.authHeadersAsync();

      expect(
        client.urls,
        equals([
          'https://auth.example.com/token',
          'https://auth.example.com/token',
        ]),
      );
    });

    test('the token body carries the scopes joined with a plus', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');
      final auth = build();
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      expect(
        client.lastBody,
        equals(
          'grant_type=password&username=testuser&password=testpass&client_id=my-client-id&client_secret=my-client-secret&scope=read+write',
        ),
      );
    });

    test('the token body keeps ~ literal and percent-encodes * ! \' ( )', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');
      final auth = OAuth2PasswordAuthenticator(
        host: 'https://api.example.com',
        clientId: 'cid',
        clientSecret: 'sec',
        tokenUrl: 'https://auth.example.com/token',
        username: 'a~b*c',
        password: "!'()",
      );
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      expect(
        client.lastBody,
        startsWith('grant_type=password&username=a~b%2Ac&password=%21%27%28%29&'),
      );
    });

    test('the Basic header keeps ~ literal and percent-encodes * ! \' ( )', () async {
      final client = _FakeApiClient();
      client.enqueue('{"access_token":"tok1","expires_in":3600}');
      final auth = OAuth2PasswordAuthenticator(
        host: 'https://api.example.com',
        clientId: 'a~b*c',
        clientSecret: "!'()",
        tokenUrl: 'https://auth.example.com/token',
        username: 'testuser',
        password: 'testpass',
        clientAuthMethod: ClientAuthMethod.basic,
      );
      auth.setApiClient(client);

      await auth.authHeadersAsync();

      final header = client.lastHeaders['Authorization']!;
      final decoded = utf8.decode(base64.decode(header.substring('Basic '.length)));
      expect(decoded, equals('a~b%2Ac:%21%27%28%29'));
    });

    test('the redacted repr shows the non-secret fields', () {
      expect(
        build().toString(),
        equals(
          'OAuth2PasswordAuthenticator(host: https://api.example.com, clientId: my-client-id, clientSecret: ***, tokenUrl: https://auth.example.com/token, refreshUrl: https://auth.example.com/token, username: testuser, password: ***, scopes: [read, write], clientAuthMethod: body)',
        ),
      );
    });
  });

  group('OAuth2PasswordAuthenticator scheme wrapper', () {
    test('LegacyAuthPasswordAuthenticator uses the declared token and refresh URLs', () async {
      final client = _FakeApiClient();
      client.enqueue(
        '{"access_token":"tok1","refresh_token":"ref1","expires_in":1}',
      );
      client.enqueue('{"access_token":"tok2","expires_in":3600}');
      final auth = LegacyAuthPasswordAuthenticator(
        host: 'https://api.example.com',
        clientId: 'cid',
        clientSecret: 'sec',
        username: 'u',
        password: 'p',
      );
      auth.setApiClient(client);

      await auth.authHeadersAsync();
      await auth.authHeadersAsync();

      expect(
        client.urls,
        equals([
          'https://auth.example.com/oauth/token',
          'https://auth.example.com/oauth/refresh',
        ]),
      );
      expect(
        client.bodies[0],
        equals(
          'grant_type=password&username=u&password=p&client_id=cid&client_secret=sec&scope=read',
        ),
      );
    });
  });
}
{{/generateTests}}
