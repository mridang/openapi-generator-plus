      final food = PetFood.fromJson(json);
      expect(food.actualInstance, isNotNull);
      expect(food.actualInstance, isA<WetFood>());
    });

    test('bhv unions 016 PetFood unknown discriminator throws SerializationException', () {
      // 4.7 — discriminator value not in the listed $ref mappings must
      // surface as a SerializationException, not silently fall through nor
      // bubble a generic ArgumentError.
      final json = <String, dynamic>{'foodType': 'raw', 'calories': 300};

      expect(
        () => PetFood.fromJson(json),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 015 PetFood missing discriminator throws SerializationException', () {
      // No foodType key at all — disc is null, still not a listed value.
      final json = <String, dynamic>{'calories': 300};

      expect(
        () => PetFood.fromJson(json),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 024 PetFood empty discriminator throws SerializationException', () {
      // An empty discriminator value matches no listed mapping and must
      // surface as a SerializationException, not route to a fitting variant.
      final json = <String, dynamic>{'foodType': '', 'weightKg': 2.5};

      expect(
        () => PetFood.fromJson(json),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 026 PetFood unknown discriminator error names the offending value', () {
      // CS4: the error message must surface the offending discriminator value
      // so callers can diagnose server/spec drift.
      final json = <String, dynamic>{'foodType': 'raw', 'calories': 300};

      expect(
        () => PetFood.fromJson(json),
        throwsA(
          isA<SerializationException>().having(
            (e) => e.toString(),
            'message',
            contains('raw'),
          ),
        ),
      );
    });

    test('bhv unions 020 PetFood serialize dry food', () {
      final json = <String, dynamic>{'foodType': 'dry', 'weightKg': 2.5};
      final food = PetFood.fromJson(json);

      final serialized = jsonEncode(food.toJson());
      final restored = jsonDecode(serialized) as Map<String, dynamic>;
      expect(restored['foodType'], equals('dry'));
    });

    test('bhv unions 030 DryFood fills the discriminator default when its key is absent', () {
      final food = DryFood.fromJson(<String, dynamic>{'weightKg': 2.5});

      expect(food.foodType, equals('dry'));
    });

    test('DryFood rejects an explicit null discriminator', () {
      expect(
        () => DryFood.fromJson(<String, dynamic>{'foodType': null, 'weightKg': 2.5}),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 029 oneOf wrappers have value equality', () {
      final json = <String, dynamic>{'foodType': 'dry', 'weightKg': 2.5};
      final a = PetFood.fromJson(json);
      final b = PetFood.fromJson(json);

      expect(a, equals(b));
      expect(a.hashCode, equals(b.hashCode));
    });

    test('bhv unions 033 an unknown, missing or empty discriminator fails with SerializationException', () {
      for (final json in <Map<String, dynamic>>[
        {'foodType': 'raw', 'calories': 300},
        {'calories': 300},
        {'foodType': '', 'weightKg': 2.5},
      ]) {
        expect(
          () => PetFood.fromJson(json),
          throwsA(isA<SerializationException>()),
        );
      }
    });

    test('bhv unions 034 a oneOf wrapper typed accessor returns the held variant and null for the other', () {
      final dry = PetFood.dryFood(DryFood(weightKg: 2.5));

      expect(dry.asDryFood, isNotNull);
      expect(dry.asWetFood, isNull);
    });

    test('bhv unions 035 a discriminator value not listed in the mapping fails to deserialize', () {
      expect(
        () => PetFood.fromJson(<String, dynamic>{'foodType': 'raw', 'calories': 300}),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 001 PetFood constructor wraps a variant that serializes with its discriminator', () {
      final food = PetFood(DryFood(weightKg: 2.5));

      expect(food.actualInstance, isA<DryFood>());
      expect(food.toJson(), equals(<String, dynamic>{'foodType': 'dry', 'weightKg': 2.5}));
    });

    test('PetFood constructor round trips through fromJson', () {
      final wire = jsonDecode(jsonEncode(PetFood(WetFood(volumeMl: 400)).toJson()))
          as Map<String, dynamic>;

      expect(PetFood.fromJson(wire).actualInstance, isA<WetFood>());
    });

    test('bhv unions 032 PetFood typed constructors, is and as accessors name the variant', () {
      final dry = PetFood.dryFood(DryFood(weightKg: 2.5));
      final wet = PetFood.wetFood(WetFood(volumeMl: 400));

      expect(dry.actualInstance, isA<DryFood>());
      expect(dry.isDryFood, isTrue);
      expect(dry.isWetFood, isFalse);
      expect(dry.asDryFood, isNotNull);
      expect(dry.asWetFood, isNull);
      expect(wet.asWetFood!.volumeMl, equals(400));
      expect(dry.toJson(), equals(<String, dynamic>{'foodType': 'dry', 'weightKg': 2.5}));
    });

    test('a result decoded by status code exposes its variant through the accessors', () {
      final reservation = ReserveStockResponse.reservation(
          const Reservation(reservationId: 1, quantity: 2));

      expect(reservation.isReservation, isTrue);
      expect(reservation.asReservationReceipt, isNull);
    });

    test('PetTreatment typed constructors and accessors name the variant', () {
      final surgery = PetTreatment.surgery(Surgery(procedureName: 'Spay', durationMinutes: 45));

      expect(surgery.isSurgery, isTrue);
      expect(surgery.isMedication, isFalse);
      expect(surgery.asSurgery!.procedureName, equals('Spay'));
      expect(surgery.asMedication, isNull);
      expect(surgery.matchedInstances, hasLength(1));
    });

    // anyOf without discriminator: PetTreatment

    test('bhv unions 014 PetTreatment deserialize medication', () {
      final json = <String, dynamic>{
        'drugName': 'Amoxicillin',
        'dosage': '250mg',
      };

      final treatment = PetTreatment.fromJson(json);
      expect(treatment.actualInstance, isNotNull);
      expect(treatment.actualInstance, isA<Medication>());
    });

    test('bhv unions 003 a payload matching one anyOf variant is its own actual and matched instance', () {
      final treatment = PetTreatment.fromJson(<String, dynamic>{
        'drugName': 'Amoxicillin',
        'dosage': '250mg',
      });

      expect(treatment.matchedInstances, hasLength(1));
      expect(treatment.actualInstance, same(treatment.matchedInstances.first));
      expect(treatment.actualInstance, isA<Medication>());
    });

    test('bhv unions 006 PetTreatment deserialize surgery', () {
      final json = <String, dynamic>{
        'procedureName': 'Spay',
        'durationMinutes': 45,
      };

      final treatment = PetTreatment.fromJson(json);
      expect(treatment.actualInstance, isNotNull);
      expect(treatment.actualInstance, isA<Surgery>());
    });

    test('bhv unions 007 PetTreatment no matching variant throws SerializationException', () {
      // Cross-cutting `oneof-nondiscriminator-no-match-silent`: a body
      // that matches none of the anyOf variants must surface a
      // SerializationException, not a silently-empty union (data loss).
      final json = <String, dynamic>{'completelyUnrelated': 'value'};

      expect(
        () => PetTreatment.fromJson(json),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv unions 008 PetTreatment serialize round trip', () {
      final json = <String, dynamic>{
        'drugName': 'Amoxicillin',
        'dosage': '250mg',
      };

      final treatment = PetTreatment.fromJson(json);
      final serialized = jsonEncode(treatment.toJson());
      expect(serialized, isNotEmpty);
    });

    test('bhv unions 009 PetTreatment retains all matching variants (medication and surgery) '
        'losslessly', () {
      // anyOf is documented as matching a medication, a surgery, OR BOTH. A
      // payload satisfying both variants at once must retain BOTH — keeping
      // only the first match would silently drop the surgery fields and lose
      // them on re-encode.
      final json = <String, dynamic>{
        'drugName': 'Amoxicillin',
        'dosage': '250mg',
        'procedureName': 'Spay',
        'durationMinutes': 45,
      };

      final treatment = PetTreatment.fromJson(json);

      // Both variants are accessible on the decoded value, not just the first.
      expect(treatment.actualInstance, isA<Medication>());
      expect(treatment.matchedInstances, [isA<Medication>(), isA<Surgery>()]);
      final medication = treatment.valueOf<Medication>();
      final surgery = treatment.valueOf<Surgery>();
      expect(medication, isNotNull);
      expect(surgery, isNotNull);
      expect(medication!.drugName, equals('Amoxicillin'));
      expect(medication.dosage, equals('250mg'));
      expect(surgery!.procedureName, equals('Spay'));
      expect(surgery.durationMinutes, equals(45));

      // Re-serialize: the JSON still carries ALL FOUR fields, so the
      // co-satisfied data round-trips with no silent drop.
      final restored =
          jsonDecode(jsonEncode(treatment.toJson())) as Map<String, dynamic>;
      expect(restored['drugName'], equals('Amoxicillin'));
      expect(restored['dosage'], equals('250mg'));
      expect(restored['procedureName'], equals('Spay'));
      expect(restored['durationMinutes'], equals(45));
    });

    test('bhv unions 010 PetTreatment shared-property collision keeps the last variant, '
        'emitted once', () {
      // anyOf-collision-last-wins: both Medication and Surgery declare `notes`.
      // Retaining both members with DIFFERENT `notes` values must encode the
      // LAST-declared member's value (Surgery) and emit `notes` exactly once —
      // never a duplicate JSON key.
      final treatment = PetTreatment.ofValues(<Object?>[
        Medication(drugName: 'Amoxicillin', notes: 'from-medication'),
        Surgery(procedureName: 'Spay', notes: 'from-surgery'),
      ]);

      final serialized = jsonEncode(treatment.toJson());
      final restored = jsonDecode(serialized) as Map<String, dynamic>;

      // Surgery is the later-declared member, so its `notes` wins the collision.
      expect(restored['notes'], equals('from-surgery'));
      // `notes` appears exactly once — no duplicate key.
      expect('"notes"'.allMatches(serialized).length, equals(1));
    });

    test('bhv unions 002 a shared property keeps the value of the later declared variant, emitted once', () {
      final treatment = PetTreatment.ofValues(<Object?>[
        Surgery(procedureName: 'Spay', notes: 'from-surgery'),
        Medication(drugName: 'Amoxicillin', notes: 'from-medication'),
      ]);

      final serialized = jsonEncode(treatment.toJson());
      final restored = jsonDecode(serialized) as Map<String, dynamic>;

      expect(restored['notes'], equals('from-medication'));
      expect('"notes"'.allMatches(serialized).length, equals(1));
    });

    test('bhv unions 025 TreatmentRecord tries variants in declaration order', () {
      final record = TreatmentRecord.fromJson(<String, dynamic>{
        'drugName': 'Amoxicillin',
        'procedureName': 'Spay',
      });

      expect(record.matchedInstances, [isA<Surgery>(), isA<Medication>()]);
    });

    test('bhv unions 005 an anyOf keeps its variants in declaration order, not alphabetical order', () {
      // TreatmentRecord declares Surgery before Medication, the reverse of
      // alphabetical order. The first declared match is the actual instance.
      final record = TreatmentRecord.fromJson(<String, dynamic>{
        'drugName': 'Amoxicillin',
        'procedureName': 'Spay',
      });

      expect(record.matchedInstances, [isA<Surgery>(), isA<Medication>()]);
      expect(record.actualInstance, isA<Surgery>());
    });

    test('bhv unions 011 anyOf unions decoded from identical JSON are equal', () {
      final json = <String, dynamic>{
        'drugName': 'Amoxicillin',
        'procedureName': 'Spay',
      };

      final a = PetTreatment.fromJson(json);
      final b = PetTreatment.fromJson(json);

      expect(a, equals(b));
      expect(a.hashCode, equals(b.hashCode));
      expect(
        a,
        isNot(equals(PetTreatment.fromJson(<String, dynamic>{'drugName': 'X'}))),
      );
    });

    test('oneOf unions decoded from identical JSON are equal', () {
      final json = <String, dynamic>{'foodType': 'dry', 'weightKg': 2.5};

      final a = PetFood.fromJson(json);
      final b = PetFood.fromJson(json);

      expect(a, equals(b));
      expect(a.hashCode, equals(b.hashCode));
      expect(
        a,
        isNot(
          equals(
            PetFood.fromJson(<String, dynamic>{'foodType': 'dry', 'weightKg': 3.5}),
          ),
        ),
      );
    });

    // allOf: PetWithOwner extends Pet fields

    test('bhv unions 004 PetWithOwner deserialize', () {
      final json = <String, dynamic>{
        'name': 'Fido',
        'photoUrls': ['http://example.com/fido.jpg'],
        'ownerName': 'John Doe',
        'ownerEmail': 'john@example.com',
      };

      final pet = PetWithOwner.fromJson(json);
      expect(pet, isNotNull);
    });

    test('bhv unions 021 PetWithOwner serialize', () {
      final json = <String, dynamic>{
        'name': 'Fido',
        'photoUrls': ['http://example.com/fido.jpg'],
        'ownerName': 'John Doe',
      };

      final pet = PetWithOwner.fromJson(json);
      final serialized = jsonEncode(pet.toJson());
      expect(serialized, isNotEmpty);

      final restored = jsonDecode(serialized) as Map<String, dynamic>;
      expect(restored['name'], equals('Fido'));
      expect(restored['ownerName'], equals('John Doe'));
    });

    test('bhv unions 017 PetWithOwner round trip', () {
      final json = <String, dynamic>{
        'name': 'Buddy',
        'photoUrls': ['http://example.com/buddy.jpg'],
        'ownerName': 'Jane Smith',
      };

      final original = PetWithOwner.fromJson(json);
      final serialized = jsonEncode(original.toJson());
      final restored =
          PetWithOwner.fromJson(jsonDecode(serialized) as Map<String, dynamic>);

      expect(restored, isNotNull);
    });

    // oneOf of primitive/array variants: SetPetAvatarThumbnailRequest
    // (oneOf: [string/byte, array of string/byte]). Regression for the
    // value-less empty-stub that silently dropped the payload.

    test(
        'bhv unions 023 setPetAvatarThumbnail byte oneOf round-trips through base64 (scalar)',
        () {
      final bytes = Uint8List.fromList(<int>[0x01, 0x02, 0x03, 0x04]);

      final req = SetPetAvatarThumbnailRequest(bytes);
      expect(req.actualInstance, equals(bytes));

      // The scalar `format:byte` variant must travel as a base64 STRING,
      // not a JSON int-array [1,2,3,4], not the raw bytes, not an empty
      // map/object. base64('AQIDBA==') is the canonical wire form here.
      final encoded = req.toJson();
      expect(encoded, isA<String>());
      expect(encoded, equals('AQIDBA=='));
      expect(encoded, equals(base64Encode(bytes)));

      // Deserializing that base64 string recovers exactly the 4 bytes.
      final restored = SetPetAvatarThumbnailRequest.fromJson(encoded);
      expect(restored.actualInstance, isA<Uint8List>());
      expect(restored.actualInstance, equals(bytes));
    });

    test(
        'bhv unions 018 setPetAvatarThumbnail byte oneOf resolves scalar before array on '
        'decode', () {
      // A scalar base64 string must deserialize to the SCALAR variant (one
      // Uint8List), NOT be mis-parsed element-by-element into a List. The
      // scalar branch is declared before the array branch so ordering holds.
      final bytes = Uint8List.fromList(<int>[0x01, 0x02, 0x03, 0x04]);
      final wire = base64Encode(bytes);

      final req = SetPetAvatarThumbnailRequest.fromJson(wire);
      expect(req.actualInstance, isA<Uint8List>());
      // The scalar variant is a Uint8List (which IS a List<int>), so the
      // meaningful ordering check is that it was NOT mis-parsed into the ARRAY
      // variant (a List<Uint8List>) element-by-element.
      expect(req.actualInstance, isNot(isA<List<Uint8List>>()));
      expect(req.actualInstance, equals(bytes));
    });

    test('bhv unions 019 SetPetAvatarThumbnailRequest round trips a single byte value', () {
      final bytes = Uint8List.fromList(<int>[10, 20, 30]);
      final wire = base64Encode(bytes);

      final req = SetPetAvatarThumbnailRequest.fromJson(wire);
      expect(req.actualInstance, isA<Uint8List>());
      expect(req.actualInstance, equals(bytes));
      expect(req.toJson(), equals(wire));
    });

    test('bhv unions 022 SetPetAvatarThumbnailRequest round trips an array of byte values',
        () {
      final a = Uint8List.fromList(<int>[1, 2]);
      final b = Uint8List.fromList(<int>[3, 4]);
      final wire = <String>[base64Encode(a), base64Encode(b)];

      final req = SetPetAvatarThumbnailRequest.fromJson(wire);
      final value = req.actualInstance as List;
      expect(value, hasLength(2));
      expect(value[0], equals(a));
      expect(value[1], equals(b));
      expect(req.toJson(), equals(wire));
    });

    test(
        'SetPetAvatarThumbnailRequest byte unions decoded from identical wire '
        'bytes are value-equal and hash equally', () {
      // M5 regression: the scalar `byte` variant decodes to a fresh Uint8List
      // per call, whose built-in `==` is identity. Two unions built from the
      // SAME base64 wire string must still compare equal and hash equally —
      // otherwise they wrongly collide in Sets/Maps. The union ==/hashCode
      // must use DeepCollectionEquality, like the rest of the SDK.
      final wire = base64Encode(Uint8List.fromList(<int>[0x01, 0x02, 0x03]));

      final a = SetPetAvatarThumbnailRequest.fromJson(wire);
      final b = SetPetAvatarThumbnailRequest.fromJson(wire);

      // Distinct underlying Uint8List instances (identity-unequal)...
      expect(identical(a.actualInstance, b.actualInstance), isFalse);
      // ...but the unions are value-equal and hash-consistent.
      expect(a, equals(b));
      expect(a.hashCode, equals(b.hashCode));
      // Usable as a Set key without duplicating.
      expect(<SetPetAvatarThumbnailRequest>{a, b}, hasLength(1));
    });

    test(
        'SetPetAvatarThumbnailRequest array unions decoded from identical wire '
        'bytes are value-equal and hash equally', () {
      // M5 regression for the ARRAY variant (List<Uint8List>): nested byte
      // lists are still identity-compared by Dart's built-in `==`, so the
      // union must deep-compare them too.
      final wire = <String>[
        base64Encode(Uint8List.fromList(<int>[1, 2])),
        base64Encode(Uint8List.fromList(<int>[3, 4])),
      ];

      final a = SetPetAvatarThumbnailRequest.fromJson(wire);
      final b = SetPetAvatarThumbnailRequest.fromJson(wire);

      expect(identical(a.actualInstance, b.actualInstance), isFalse);
      expect(a, equals(b));
      expect(a.hashCode, equals(b.hashCode));
    });

    test(
        'SetPetAvatarThumbnailRequest unions with differing bytes are unequal',
        () {
      // Sanity: deep-equality must still distinguish genuinely different
      // payloads — the fix must not collapse all unions to "equal".
      final a = SetPetAvatarThumbnailRequest.fromJson(
          base64Encode(Uint8List.fromList(<int>[1, 2, 3])));
      final b = SetPetAvatarThumbnailRequest.fromJson(
          base64Encode(Uint8List.fromList(<int>[9, 9, 9])));

      expect(a, isNot(equals(b)));
    });

    test('bhv unions 037 a union wrapper built from a variant holds that exact value and returns it unchanged', () {
      final dry = DryFood(weightKg: 2);
      final food = PetFood.dryFood(dry);

      expect(food.actualInstance, same(dry));
    });

    test('bhv unions 038 a union body that cannot be decoded raises the serialization error', () {
      expect(() => PetFood.fromJson({'foodType': 'fish'}),
          throwsA(isA<SerializationException>()));
      expect(() => PetFood.fromJson({'FoodType': 'dry', 'weightKg': 2}),
          throwsA(isA<SerializationException>()));
      expect(() => PetFood.fromJson({'foodType': 7}),
          throwsA(isA<SerializationException>()));
    });

    test('bhv unions 039 building a union wrapper from any value never validates or throws', () {
      expect(() => PetFood(null), returnsNormally);
      expect(() => PetFood('not a food'), returnsNormally);
      expect(() => PetFood.dryFood(DryFood(weightKg: 1)), returnsNormally);
    });

    test('bhv unions 040 a union wrapper typed accessor returns the variant it holds and nothing for the others', () {
      final dry = DryFood(weightKg: 2);
      final food = PetFood.dryFood(dry);

      expect(food.isDryFood, isTrue);
      expect(food.asDryFood, same(dry));
      expect(food.isWetFood, isFalse);
      expect(food.asWetFood, isNull);
    });

    test('bhv unions 041 a oneOf without a discriminator decodes each JSON shape to the variant that describes it', () {
      final byString = SetPetAvatarThumbnailRequest.fromJson(
        base64Encode(<int>[104, 105]),
      );
      expect(byString.actualInstance, isA<Uint8List>());
      expect(byString.actualInstance,
          equals(Uint8List.fromList(<int>[104, 105])));

      final byArray = SetPetAvatarThumbnailRequest.fromJson(
        <String>[base64Encode(<int>[104, 105])],
      );
      expect(byArray.actualInstance, isA<List<Object?>>());
      expect(byArray.actualInstance, isNot(isA<Uint8List>()));
      expect((byArray.actualInstance as List<Object?>).single, isA<Uint8List>());
    });

    test('bhv unions 042 a union wrapper built with a null variant holds no instance', () {
      const food = PetFood(null);

      expect(food.actualInstance, isNull);
      expect(food.isDryFood, isFalse);
      expect(food.isWetFood, isFalse);
      expect(food.asDryFood, isNull);
      expect(food.asWetFood, isNull);
    });

    test('bhv unions 043 a discriminator value already set on a subtype is written as given, not replaced by the default', () {
      final dry = DryFood(foodType: 'custom', weightKg: 1);

      expect(dry.toJson()['foodType'], equals('custom'));
    });
  });
}
