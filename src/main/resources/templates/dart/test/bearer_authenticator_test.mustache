    test('bhv auth 003 an empty environment variable counts as no value, so the next source is used', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'fixed',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: ''},
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer fixed'));
    });

    test('an unset environment variable and no other source fails at construction', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          environment: const {},
        ),
        throwsArgumentError,
      );
    });

    test('bhv auth 012 each rejected credential raises an error whose message says why', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: ''),
        throwsA(isA<ArgumentError>()
            .having((e) => '${e.message}', 'message', isNotEmpty)),
      );
    });

    test('bhv auth 016 every string form of an authenticator masks its secret and names its own type', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'secretvalue');

      expect('$auth', isNot(contains('secretvalue')));
      expect(auth.toString(), contains('BearerAuthenticator'));
    });

    test('bhv auth 022 an explicit argument is used first, then the environment, then the provider', () {
      final explicit = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'explicit',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: 'from-env'},
        tokenProvider: () => 'from-provider',
      );
      final fromEnv = BearerAuthenticator(
        host: '{{{basePath}}}',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: 'from-env'},
        tokenProvider: () => 'from-provider',
      );
      final fromProvider = BearerAuthenticator(
        host: '{{{basePath}}}',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: ''},
        tokenProvider: () => 'from-provider',
      );

      expect(explicit.authHeaders()['Authorization'], equals('Bearer explicit'));
      expect(fromEnv.authHeaders()['Authorization'], equals('Bearer from-env'));
      expect(fromProvider.authHeaders()['Authorization'], equals('Bearer from-provider'));
    });

    test('bhv auth 023 an explicitly passed empty credential is refused and is not replaced by the environment value', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          token: '',
          environment: {BearerAuthenticator.defaultEnvironmentVariable: 'from-env'},
        ),
        throwsArgumentError,
      );
    });

    test('bhv auth 030 concurrent reads of the token never observe a value that was not set', () async {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        tokenProvider: () async => 'tok',
      );

      final headers = await Future.wait(
        List.generate(50, (_) => auth.authHeadersAsync()),
      );
      for (final header in headers) {
        expect(header['Authorization'], equals('Bearer tok'));
      }
    });

    test('bhv misc 001 replacing the token while other callers read the headers gives each read one complete token', () async {
      var turn = 0;
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        tokenProvider: () async => 'tok${turn++ % 2}',
      );

      final headers = await Future.wait(
        List.generate(40, (_) => auth.authHeadersAsync()),
      );
      for (final header in headers) {
        expect(['Bearer tok0', 'Bearer tok1'], contains(header['Authorization']));
      }
    });

    test('bhv config 025 an empty token environment value counts as unset, so construction fails naming the missing variable', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          environment: {BearerAuthenticator.defaultEnvironmentVariable: ''},
        ),
        throwsA(isA<ArgumentError>().having((e) => '${e.message}', 'message',
            contains(BearerAuthenticator.defaultEnvironmentVariable))),
      );
    });
}
