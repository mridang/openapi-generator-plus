import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('BearerAuthenticator', () {
    test('bhv authscheme 009 a credential passed explicitly wins over its environment variable', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'explicit',
        environmentVariable: 'OTHER_TOKEN',
        environment: {'OTHER_TOKEN': 'fromenv'},
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer explicit'));
    });

    test('bhv authbearer 018 an explicit token wins over the environment', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'explicit',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: 'fromenv'},
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer explicit'));
    });

    test('bhv authbearer 025 the environment variable is read once, at construction', () {
      final environment = {BearerAuthenticator.defaultEnvironmentVariable: 'fromenv'};
      final auth = BearerAuthenticator(host: '{{{basePath}}}', environment: environment);

      environment[BearerAuthenticator.defaultEnvironmentVariable] = 'changed';

      expect(auth.authHeaders()['Authorization'], equals('Bearer fromenv'));
    });

    test('bhv lifecycle 028 an explicit host and token win over the environment', () {
      final auth = BearerAuthenticator(
        host: 'https://explicit.example.com',
        token: 'explicit',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: 'fromenv'},
      );

      expect(auth.host(), equals('https://explicit.example.com'));
      expect(auth.authHeaders()['Authorization'], equals('Bearer explicit'));
    });

    test('bhv lifecycle 032 a token passed to the client is preferred to the one in the environment', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'passed',
        environment: {BearerAuthenticator.defaultEnvironmentVariable: 'fromenv'},
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer passed'));
    });

    test('bhv authbearer 028 a bearer token containing CRLF is rejected at construction', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'tok\r\nInjected: yes'),
        throwsArgumentError,
      );
    });

    test('bhv lifecycle 025 the environment variable is read once, at construction', () {
      final environment = {BearerAuthenticator.defaultEnvironmentVariable: 'fromenv'};
      final auth = BearerAuthenticator(host: '{{{basePath}}}', environment: environment);

      environment[BearerAuthenticator.defaultEnvironmentVariable] = 'changed';

      expect(auth.authHeaders()['Authorization'], equals('Bearer fromenv'));
    });

    test('bhv auth 007 a named environment variable is read instead of the default', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        environmentVariable: 'OTHER_TOKEN',
        environment: {'OTHER_TOKEN': 'other'},
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer other'));
    });

    test('bhv authbearer 019 an empty environment value counts as unset', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          environment: {BearerAuthenticator.defaultEnvironmentVariable: ''},
        ),
        throwsA(isA<ArgumentError>().having((e) => e.message, 'message',
            contains(BearerAuthenticator.defaultEnvironmentVariable))),
      );
    });

    test('bhv authscheme 010 an empty environment value counts as unset and fails naming the variable', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          environment: {BearerAuthenticator.defaultEnvironmentVariable: ''},
        ),
        throwsA(isA<ArgumentError>().having((e) => e.message, 'message',
            contains(BearerAuthenticator.defaultEnvironmentVariable))),
      );
    });

    test('no token anywhere fails when the authenticator is built', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', environment: const {}),
        throwsA(isA<ArgumentError>()),
      );
    });

    test('bhv authbearer 026 a token and a provider together are refused', () {
      expect(
        () => BearerAuthenticator(
          host: '{{{basePath}}}',
          token: 'a',
          tokenProvider: () => 'b',
        ),
        throwsArgumentError,
      );
    });

    test('bhv authbearer 014 the provider is asked on every request', () async {
      var calls = 0;
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        tokenProvider: () => 'token${++calls}',
      );

      expect(auth.authHeaders()['Authorization'], equals('Bearer token1'));
      expect((await auth.authHeadersAsync())['Authorization'], equals('Bearer token2'));
    });

    test('bhv auth 001 an asynchronous provider works through authHeadersAsync only', () async {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        tokenProvider: () async => 'later',
      );

      expect((await auth.authHeadersAsync())['Authorization'], equals('Bearer later'));
      expect(auth.authHeaders, throwsStateError);
    });

    test('bhv authbearer 002 a provider result is validated like a fixed token', () async {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', tokenProvider: () => '');

      await expectLater(auth.authHeadersAsync(), throwsArgumentError);
    });

    test('bhv authbearer 009 raw token is prefixed with Bearer', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'xyz');
      final headers = auth.authHeaders();
      expect(headers['Authorization'], equals('Bearer xyz'));
    });

    test('bhv authbearer 012 rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'tok\r\nInjected: yes'),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'ñoño'),
        throwsArgumentError,
      );
    });

    test('bhv authbearer 022 a bearer authenticator rejects a non-ASCII token at construction', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'ñoño'),
        throwsArgumentError,
      );
    });

    test('bhv authbearer 027 a bearer authenticator rejects a whitespace-only token', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: '   '),
        throwsArgumentError,
      );
    });

    test('bhv authbearer 017 rejects an empty or whitespace token', () {
      // bearer-no-empty-token-guard: an empty / whitespace-only token would
      // emit a bare "Authorization: Bearer " header and send the request
      // unauthenticated, so the constructor must reject it.
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: ''),
        throwsA(isA<ArgumentError>().having(
          (e) => e.message, 'message', contains('Bearer token must not be empty'))),
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: '   '),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: ' \t\n\r\f\v '),
        throwsA(isA<ArgumentError>().having(
          (e) => e.message, 'message', contains('Bearer token must not be empty'))),
      );
    });

    test('bhv authbearer 016 a Unicode space is not blank, so the printable ASCII check rejects it', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: '\u00A0'),
        throwsA(isA<ArgumentError>().having(
          (e) => e.message, 'message', contains('printable ASCII'))),
      );
    });

    test('bhv authbearer 011 redacts the token in toString', () {
      // authenticator-secret-in-default-string-repr: the default toString()
      // must never expose the stored token.
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'xyz');
      expect(auth.toString(), isNot(contains('xyz')));
      expect(auth.toString(), contains('***'));
    });
  });

  group('BearerAuthenticator', () {
    test('bhv authbearer 003 already prefixed token is not doubled', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'Bearer xyz');

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer xyz'}));
    });

    test('bhv authbearer 007 lowercase bearer prefix is stripped', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'bearer xyz');

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer xyz'}));
    });

    test('uppercase bearer prefix is stripped', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'BEARER xyz');

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer xyz'}));
    });

    test('bhv authbearer 008 mixed case bearer prefix is stripped', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'BeArEr xyz');

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer xyz'}));
    });

    test('bhv authbearer 015 a token that merely begins with the word bearer is kept whole', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'bearerxyz');

      expect(
        auth.authHeaders(),
        equals({'Authorization': 'Bearer bearerxyz'}),
      );
    });

    test('bhv authbearer 004 doubled bearer prefix is stripped only once', () {
      final auth = BearerAuthenticator(host: '{{{basePath}}}', token: 'Bearer Bearer xyz');

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer Bearer xyz'}));
    });

    test('bhv authscheme 002 explicit arguments need no environment', () {
      final auth = BearerAuthenticator(
        host: '{{{basePath}}}',
        token: 'xyz',
        environment: const {},
      );

      expect(auth.authHeaders(), equals({'Authorization': 'Bearer xyz'}));
    });

    test('bhv authbearer 013 the redacted repr shows the host and masks the token', () {
      expect(
        BearerAuthenticator(host: '{{{basePath}}}', token: 'xyz').toString(),
        equals('BearerAuthenticator(host: {{{basePath}}}, token: ***)'),
      );
    });
  });

  group('BearerAuthenticator scheme wrappers', () {
    final builders = <String, BearerAuthenticator Function(String)>{
      'ServiceTokenAuthenticator': (token) =>
          ServiceTokenAuthenticator(host: '{{{basePath}}}', token: token),
      'PetStoreBearerAuthenticator': (token) =>
          PetStoreBearerAuthenticator(host: '{{{basePath}}}', token: token),
    };

    builders.forEach((name, build) {
      test('bhv authbearer 006 $name sends the token as a Bearer header', () {
        expect(
          build('xyz').authHeaders(),
          equals({'Authorization': 'Bearer xyz'}),
        );
      });

      test('bhv authbearer 005 $name rejects an empty token at construction', () {
        expect(() => build(''), throwsArgumentError);
      });

      test('bhv authbearer 001 $name prints its own name with the token masked', () {
        expect(
          build('xyz').toString(),
          equals('$name(host: {{{basePath}}}, token: ***)'),
        );
      });
    });

    test('bhv authscheme 011 an empty environment variable for a bearer scheme credential is treated as unset and fails naming the variable', () {
      expect(
        () => ServiceTokenAuthenticator(
          host: '{{{basePath}}}',
          environment: const {'SWAGGER_PETSTORE_OPEN_API_3_0_SERVICE_TOKEN_TOKEN': ''},
        ),
        throwsA(isA<ArgumentError>().having((e) => e.message, 'message',
            contains('SWAGGER_PETSTORE_OPEN_API_3_0_SERVICE_TOKEN_TOKEN'))),
      );
    });

    test('bhv authbearer 023 generated bearer scheme wrappers emit a Bearer header and keep their own name', () {
      builders.forEach((name, build) {
        expect(build('xyz').authHeaders(), equals({'Authorization': 'Bearer xyz'}));
        expect(build('xyz').toString(), startsWith('$name('));
      });
    });
  });

