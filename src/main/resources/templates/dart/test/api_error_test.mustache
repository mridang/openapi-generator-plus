import 'dart:io';

import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('ApiException', () {
    test('bhv errors 004 exposes statusCode, message, responseBody, responseHeaders, errorBody',
        () {
      const err = ApiException(
        statusCode: 404,
        message: 'not found',
        responseBody: '{"id":7,"name":"missing"}',
        responseHeaders: {'content-type': 'application/json'},
        errorBody: null,
      );

      expect(err.statusCode, equals(404));
      expect(err.message, equals('not found'));
      expect(err.responseBody, equals('{"id":7,"name":"missing"}'));
      expect(err.responseHeaders?['content-type'], equals('application/json'));
      expect(err.errorBody, isNull);
    });

    test('bhv errors 021 null headers and body mark transport-no-response', () {
      // apierror-responsebody-headers-nullable-split: null is distinct from an
      // empty header map / empty body so a pre-response transport failure can
      // be encoded.
      const err = ApiException(
        statusCode: 0,
        message: 'connection reset',
        responseBody: null,
        responseHeaders: null,
      );

      expect(err.responseHeaders, isNull);
      expect(err.responseBody, isNull);
    });

    test('bhv errors 019 is an Exception subclass with status in its string form', () {
      const err = ApiException(statusCode: 500, message: 'boom');

      expect(err, isA<Exception>());
      expect(err, isA<{{errorPrefix}}Exception>());
      expect(err.toString(), contains('500'));
    });

    test('bhv errors 018 is a {{errorPrefix}}Exception (branded root)', () {
      const err = ApiException(statusCode: 500, message: 'boom');

      expect(err, isA<{{errorPrefix}}Exception>());
      expect(err, isA<Exception>());
    });

    test('bhv errors 013 getTypedErrorBody deserializes the body into the requested type', () {
      const err = ApiException(
        statusCode: 400,
        message: 'bad request',
        responseBody: '{"id":42,"name":"Dogs"}',
      );

      final typed = err.getTypedErrorBody(Category.fromJson);
      expect(typed, isNotNull);
      expect(typed!.id, equals(42));
      expect(typed.name, equals('Dogs'));
    });

    test('bhv errors 015 getTypedErrorBody returns null when there is no response body', () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: null,
      );

      expect(err.getTypedErrorBody(Category.fromJson), isNull);
    });

    test('bhv errors 016 getTypedErrorBody returns null for an empty response body', () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: '',
      );

      expect(err.getTypedErrorBody(Category.fromJson), isNull);
    });

    test('bhv errors 005 getTypedErrorBody returns null for a bare JSON null body', () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: 'null',
      );

      expect(err.getTypedErrorBody(Category.fromJson), isNull);
    });

    test('bhv errors 017 getTypedErrorBody throws SerializationException for malformed JSON',
        () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: '{"id":',
      );

      expect(
        () => err.getTypedErrorBody(Category.fromJson),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv misc 015 getTypedErrorBody throws SerializationException for a JSON array body',
        () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: '[1,2,3]',
      );

      expect(
        () => err.getTypedErrorBody(Category.fromJson),
        throwsA(
          isA<SerializationException>().having(
            (e) => e.message,
            'message',
            equals('Expected JSON object, got List<dynamic>'),
          ),
        ),
      );
    });

    test('bhv langdart 008 getTypedErrorBody throws SerializationException for a type mismatch',
        () {
      const err = ApiException(
        statusCode: 500,
        message: 'oops',
        responseBody: '{"id":"not-a-number","name":"Dogs"}',
      );

      expect(
        () => err.getTypedErrorBody(Category.fromJson),
        throwsA(isA<SerializationException>()),
      );
    });

    test('bhv errors 014 getTypedErrorBody ignores extraneous fields not on the model', () {
      const err = ApiException(
        statusCode: 422,
        message: 'unprocessable',
        responseBody: '{"id":1,"name":"Cat","extra":"drop-me"}',
      );

      final typed = err.getTypedErrorBody(Category.fromJson);
      expect(typed, isNotNull);
      expect(typed!.id, equals(1));
      expect(typed.name, equals('Cat'));
    });
  });

  group('exception hierarchy', () {
    test('bhv errors 058 a 400 response maps to the bad request error', () {
      final err = ApiException.fromResponse(400, const {}, null);

      expect(err, isA<BadRequestException>());
    });

    test('bhv errors 059 a 403 response maps to the forbidden error', () {
      final err = ApiException.fromResponse(403, const {}, null);

      expect(err, isA<ForbiddenException>());
    });

    test('bhv errors 060 a 404 response maps to the not found error', () {
      final err = ApiException.fromResponse(404, const {}, null);

      expect(err, isA<NotFoundException>());
    });

    test('bhv errors 066 a 429 response becomes a too-many-requests error that is a client error', () {
      final err = ApiException.fromResponse(429, const {}, null);

      expect(err, isA<TooManyRequestsException>());
      expect(err, isA<ClientException>());
    });

    test('bhv errors 067 a 409 response becomes a conflict error', () {
      final err = ApiException.fromResponse(409, const {}, null);

      expect(err, isA<ConflictException>());
    });

    test('bhv errors 068 a 422 response becomes an unprocessable entity error', () {
      final err = ApiException.fromResponse(422, const {}, null);

      expect(err, isA<UnprocessableEntityException>());
    });

    test('bhv errors 069 a 500 response becomes an internal server error', () {
      final err = ApiException.fromResponse(500, const {}, null);

      expect(err, isA<InternalServerErrorException>());
    });

    test('bhv errors 070 a 502 response becomes a server error', () {
      final err = ApiException.fromResponse(502, const {}, null);

      expect(err, isA<ServerException>());
    });

    test('bhv errors 061 BadRequestException is ClientException, ApiException and {{errorPrefix}}Exception', () {
      const err = BadRequestException(message: 'bad request');

      expect(err, isA<BadRequestException>());
      expect(err, isA<ClientException>());
      expect(err, isA<ApiException>());
      expect(err, isA<{{errorPrefix}}Exception>());
      expect(err, isA<Exception>());
    });

    test('bhv errors 047 InternalServerErrorException is ServerException, ApiException and {{errorPrefix}}Exception',
        () {
      const err = InternalServerErrorException(message: 'boom');

      expect(err, isA<ServerException>());
      expect(err, isA<ApiException>());
      expect(err, isA<{{errorPrefix}}Exception>());
    });

    test('bhv errors 052 a typed client error is caught by a base ApiException catch and chains to the root', () {
      const error = BadRequestException(message: 'bad request');
      ApiException? caught;

      try {
        throw error;
      } on ApiException catch (e) {
        caught = e;
      }

      expect(caught, same(error));
      expect(caught, isA<{{errorPrefix}}Exception>());
    });

    test('bhv errors 053 each named error pins its own status code', () {
      expect(const BadRequestException(message: 'x').statusCode, equals(400));
      expect(const UnauthorizedException(message: 'x').statusCode, equals(401));
      expect(const ForbiddenException(message: 'x').statusCode, equals(403));
      expect(const NotFoundException(message: 'x').statusCode, equals(404));
      expect(const ConflictException(message: 'x').statusCode, equals(409));
      expect(const UnprocessableEntityException(message: 'x').statusCode, equals(422));
      expect(const TooManyRequestsException(message: 'x').statusCode, equals(429));
      expect(const TooManyRequestsException(message: 'x'), isA<ClientException>());
      expect(const PaymentRequiredException(message: 'x').statusCode, equals(402));
      expect(const PaymentRequiredException(message: 'x'), isA<ClientException>());
      expect(const MethodNotAllowedException(message: 'x').statusCode, equals(405));
      expect(const MethodNotAllowedException(message: 'x'), isA<ClientException>());
      expect(const RequestTimeoutException(message: 'x').statusCode, equals(408));
      expect(const RequestTimeoutException(message: 'x'), isA<ClientException>());
      expect(const GoneException(message: 'x').statusCode, equals(410));
      expect(const GoneException(message: 'x'), isA<ClientException>());
      expect(const PayloadTooLargeException(message: 'x').statusCode, equals(413));
      expect(const PayloadTooLargeException(message: 'x'), isA<ClientException>());
      expect(const UnsupportedMediaTypeException(message: 'x').statusCode, equals(415));
      expect(const UnsupportedMediaTypeException(message: 'x'), isA<ClientException>());
      expect(const LockedException(message: 'x').statusCode, equals(423));
      expect(const LockedException(message: 'x'), isA<ClientException>());
      expect(const NotImplementedException(message: 'x').statusCode, equals(501));
      expect(const NotImplementedException(message: 'x'), isA<ServerException>());
      expect(const BadGatewayException(message: 'x').statusCode, equals(502));
      expect(const BadGatewayException(message: 'x'), isA<ServerException>());
      expect(const ServiceUnavailableException(message: 'x').statusCode, equals(503));
      expect(const ServiceUnavailableException(message: 'x'), isA<ServerException>());
      expect(const GatewayTimeoutException(message: 'x').statusCode, equals(504));
      expect(const GatewayTimeoutException(message: 'x'), isA<ServerException>());
      expect(const InternalServerErrorException(message: 'x').statusCode, equals(500));
    });

    test('bhv errors 055 status error constructors default the response context to null', () {
      const err = BadRequestException();

      expect(err.statusCode, equals(400));
      expect(err.message, equals(''));
      expect(err.responseHeaders, isNull);
      expect(err.responseBody, isNull);
      expect(err.errorBody, isNull);
      expect(const NotFoundException(message: 'gone').responseHeaders, isNull);
    });

    test('bhv errors 003 every status error accepts an optional cause', () {
      final cause = StateError('root');
      final errors = <ApiException>[
        BadRequestException(cause: cause),
        UnauthorizedException(cause: cause),
        ForbiddenException(cause: cause),
        NotFoundException(cause: cause),
        ConflictException(cause: cause),
        UnprocessableEntityException(cause: cause),
        TooManyRequestsException(cause: cause),
        PaymentRequiredException(cause: cause),
        MethodNotAllowedException(cause: cause),
        RequestTimeoutException(cause: cause),
        GoneException(cause: cause),
        PayloadTooLargeException(cause: cause),
        UnsupportedMediaTypeException(cause: cause),
        LockedException(cause: cause),
        NotImplementedException(cause: cause),
        BadGatewayException(cause: cause),
        ServiceUnavailableException(cause: cause),
        GatewayTimeoutException(cause: cause),
        InternalServerErrorException(cause: cause),
        ClientException(statusCode: 418, message: 'x', cause: cause),
        ServerException(statusCode: 503, message: 'x', cause: cause),
      ];

      for (final err in errors) {
        expect(err.cause, same(cause));
      }
      expect(const NotFoundException().cause, isNull);
    });

    test('bhv errors 020 NetworkTimeoutException is NetworkException and ApiException with status 0',
        () {
      const err = NetworkTimeoutException(message: 'timed out');

      expect(err, isA<NetworkException>());
      expect(err, isA<ApiException>());
      expect(err, isA<{{errorPrefix}}Exception>());
      expect(err.statusCode, equals(0));
      expect(const NetworkException(message: 'refused').statusCode, equals(0));
    });

    test('bhv errors 025 SerializationException is a {{errorPrefix}}Exception', () {
      const err = SerializationException('nope');

      expect(err, isA<SerializationException>());
      expect(err, isA<{{errorPrefix}}Exception>());
      expect(err, isA<Exception>());
    });
  });

  group('fromResponse', () {
    test('bhv errors 006 maps each status to its exception', () {
      final cases = <int, Type>{
        400: BadRequestException,
        401: UnauthorizedException,
        403: ForbiddenException,
        404: NotFoundException,
        409: ConflictException,
        422: UnprocessableEntityException,
        429: TooManyRequestsException,
        402: PaymentRequiredException,
        405: MethodNotAllowedException,
        408: RequestTimeoutException,
        410: GoneException,
        413: PayloadTooLargeException,
        415: UnsupportedMediaTypeException,
        423: LockedException,
        501: NotImplementedException,
        502: BadGatewayException,
        503: ServiceUnavailableException,
        504: GatewayTimeoutException,
        418: ClientException,
        500: InternalServerErrorException,
        599: ServerException,
        302: ApiException,
      };

      cases.forEach((status, expected) {
        final err = ApiException.fromResponse(
          status,
          {'x-request-id': 'abc'},
          '{"code":7}',
        );

        expect(err.runtimeType, equals(expected));
        expect(err.statusCode, equals(status));
        expect(err.responseHeaders, equals({'x-request-id': 'abc'}));
        expect(err.responseBody, equals('{"code":7}'));
        expect(err.errorBody, equals({'code': 7}));
      });
    });

    test('bhv errors 056 a status at or above 600 yields the base error and not a server error', () {
      // The 5xx arm is bounded at < 600: a status outside 400-599 yields the
      // base ApiException, never ServerException.
      final err = ApiException.fromResponse(600, {'x-request-id': 'abc'}, null);

      expect(err.runtimeType, equals(ApiException));
      expect(err, isNot(isA<ServerException>()));
      expect(err.statusCode, equals(600));
    });

    test('bhv errors 009 refuses a deeply nested error body', () {
      // The error body is attacker-controlled, so parsing is depth-capped: an
      // over-deep payload leaves errorBody null instead of crashing the VM.
      final body = '${'[' * 2000}${']' * 2000}';

      final err = ApiException.fromResponse(400, const {}, body);

      expect(err.runtimeType, equals(BadRequestException));
      expect(err.responseBody, equals(body));
      expect(err.errorBody, isNull);
    });

    test('bhv errors 008 parses an error body that starts with a UTF-8 BOM', () {
      final err = ApiException.fromResponse(
        400,
        const {},
        '\u{FEFF}{"code": 7}',
      );

      expect(err.errorBody, equals({'code': 7}));
    });
  });

  group('request context', () {
    test('bhv errors 011 fromResponse names the request in the message and the fields', () {
      final err = ApiException.fromResponse(
        404,
        const {},
        null,
        requestMethod: 'GET',
        requestPath: '/items/7?token=secret#top',
      );

      expect(err, isA<NotFoundException>());
      expect(err.requestMethod, equals('GET'));
      expect(err.requestPath, equals('/items/7'));
      expect(err.message, equals('GET /items/7 returned status code 404'));
      expect(err.toString(), startsWith('GET /items/7 returned status code 404\n'));
    });

    test('bhv errors 012 fromResponse without a request keeps the plain message', () {
      final err = ApiException.fromResponse(500, const {}, null);

      expect(err.requestMethod, isNull);
      expect(err.requestPath, isNull);
      expect(err.message, equals('API returned status code 500'));
    });

    test('bhv errors 002 every status class carries the request', () {
      for (final status in [400, 401, 403, 404, 409, 418, 422, 429, 500, 503, 302]) {
        final err = ApiException.fromResponse(
          status,
          const {},
          null,
          requestMethod: 'POST',
          requestPath: '/x',
        );

        expect(err.requestMethod, equals('POST'), reason: '$status');
        expect(err.requestPath, equals('/x'), reason: '$status');
      }
    });

    test('bhv errors 026 the request method and path are rendered on their own line and never carry the query string', () {
      final err = ApiException.fromResponse(
        404,
        const {},
        null,
        requestMethod: 'GET',
        requestPath: '/items/7?token=secret',
      );

      expect(err.toString().split('\n').first,
          equals('GET /items/7 returned status code 404'));
      expect(err.toString(), isNot(contains('token=secret')));
    });

    test('bhv errors 030 getTypedErrorBody returns null for a response that carried no body', () {
      final err = ApiException.fromResponse(500, const {}, null);

      expect(err.getTypedErrorBody(Category.fromJson), isNull);
    });

    test('bhv errors 037 throws the exception that matches the status code', () {
      expect(ApiException.fromResponse(404, const {}, null),
          isA<NotFoundException>());
      expect(ApiException.fromResponse(500, const {}, null),
          isA<InternalServerErrorException>());
    });

    test('bhv errors 007 withRequest keeps the type and never overwrites a recorded request', () {
      const timeout = NetworkTimeoutException(message: 'slow');
      const plain = ApiException(statusCode: 302, message: 'moved');

      final a = timeout.withRequest('PUT', '/a?b=c');
      final b = plain.withRequest('PUT', '/a');
      final c = a.withRequest('GET', '/z');

      expect(a, isA<NetworkTimeoutException>());
      expect(a.requestPath, equals('/a'));
      expect(b.runtimeType, equals(ApiException));
      expect(b.requestMethod, equals('PUT'));
      expect(identical(c, a), isTrue);
    });
  });

  group('typed errors', () {
    test('bhv errors 201 an error is retryable exactly for the statuses the client retries', () {
      for (final status in [408, 409, 429, 500, 502, 503, 504, 599]) {
        expect(ApiException.fromResponse(status, const {}, null).isRetryable,
            isTrue,
            reason: 'status $status');
      }
      for (final status in [400, 401, 403, 404, 422, 501, 302]) {
        expect(ApiException.fromResponse(status, const {}, null).isRetryable,
            isFalse,
            reason: 'status $status');
      }
    });

    test('bhv errors 202 an error exposes the x-request-id response header as its request id', () {
      expect(
          ApiException.fromResponse(500, const {'X-Request-ID': 'abc'}, null)
              .requestId,
          equals('abc'));
      expect(
          ApiException.fromResponse(500, const {'x-request-id': 'abc'}, null)
              .requestId,
          equals('abc'));
      expect(
          ApiException.fromResponse(500, const {'other': 'abc'}, null)
              .requestId,
          isNull);
      expect(const ApiException(statusCode: 0, message: 'no response').requestId,
          isNull);
    });

    test('bhv errors 203 the error factory of an operation is chosen by exact status, then range, then default', () {
      ErrorFactory factory(String message) => ({
            required statusCode,
            responseHeaders,
            responseBody,
            requestMethod,
            requestPath,
          }) =>
              ApiException(statusCode: statusCode, message: message);
      final factories = <String, ErrorFactory>{
        '404': factory('exact'),
        '4XX': factory('range'),
        'default': factory('default'),
      };

      expect(
          ApiException.fromResponse(404, const {}, '{}',
                  errorSchemas: factories)
              .message,
          equals('exact'));
      expect(
          ApiException.fromResponse(418, const {}, '{}',
                  errorSchemas: factories)
              .message,
          equals('range'));
      expect(
          ApiException.fromResponse(502, const {}, '{}',
                  errorSchemas: factories)
              .message,
          equals('default'));
      expect(
          ApiException.fromResponse(502, const {}, '{}',
              errorSchemas: const <String, ErrorFactory>{}),
          isA<BadGatewayException>());
      expect(ApiException.fromResponse(404, const {}, '{}'),
          isA<NotFoundException>());
    });
