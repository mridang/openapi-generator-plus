  group('ApiException rendering', () {
    test('bhv errors 024 renders the message, status, headers and body one field per line', () {
      const err = ApiException(
        statusCode: 404,
        message: 'not found',
        responseBody: '{"id":7}',
        responseHeaders: {'x-request-id': 'abc'},
      );

      expect(
        err.toString(),
        equals(
          'not found\nHTTP status code: 404\nResponse headers: {"x-request-id":"abc"}\nResponse body: {"id":7}',
        ),
      );
    });

    test('bhv errors 050 response headers render in the error text as compact sorted JSON with unescaped slashes', () {
      const err = ApiException(
        statusCode: 500,
        message: 'boom',
        responseHeaders: {'b': '2', 'a': 'x/y'},
      );
      expect(err.toString(), contains('Response headers: {"a":"x/y","b":"2"}'));
    });

    test('bhv errors 065 cuts a long response body at 1 KiB and counts the bytes left out', () {
      final err = ApiException(
        statusCode: 502,
        message: 'bad gateway',
        responseBody: 'a' * 3000,
      );

      expect(
        err.toString(),
        equals(
          'bad gateway\nHTTP status code: 502\nResponse body: ${'a' * 1024}... (1976 more bytes)',
        ),
      );
      expect(err.responseBody?.length, equals(3000));
    });

    test('bhv misc 280 caps the rendered body and says how much was left out', () {
      final body = 'x' * 1030;
      final err = ApiException(
        statusCode: 502,
        message: 'bad gateway',
        responseBody: body,
      );

      expect(
        err.toString(),
        equals(
          'bad gateway\nHTTP status code: 502\nResponse body: ${'x' * 1024}... (6 more bytes)',
        ),
      );
      expect(err.responseBody, equals(body));
    });

    test('bhv errors 075 does not cut a multi-byte character when capping the body', () {
      final body = '${'x' * 1023}\u00e9tail';
      final err = ApiException(statusCode: 500, message: 'boom', responseBody: body);

      expect(
        err.toString(),
        endsWith('Response body: ${'x' * 1023}... (6 more bytes)'),
      );
    });

    test('bhv errors 001 escapes control characters in the rendered body', () {
      const err = ApiException(
        statusCode: 500,
        message: 'boom',
        responseBody: 'a\r\nHTTP status code: 200\u0001\u007f',
      );

      expect(
        err.toString(),
        equals(
          'boom\nHTTP status code: 500\nResponse body: a\\x0D\\x0AHTTP status code: 200\\x01\\x7F',
        ),
      );
    });

    test('bhv errors 023 masks credential headers in the rendered text only', () {
      const err = ApiException(
        statusCode: 401,
        message: 'denied',
        responseHeaders: {
          'Authorization': 'Bearer s1',
          'Proxy-Authorization': 'Basic s2',
          'Cookie': 's3',
          'Set-Cookie': 's4',
          'WWW-Authenticate': 'Bearer realm=s5',
          'Proxy-Authenticate': 's6',
          'X-Api-Key': 's7',
          'X-Refresh-Token': 's8',
          'X-Client-Secret': 's9',
          'X-Request-Id': 'visible',
        },
      );

      final text = err.toString();
      expect(text, contains('"X-Request-Id":"visible"'));
      expect(text, contains('"Authorization":"***"'));
      expect(text, contains('"WWW-Authenticate":"***"'));
      expect(text, contains('"X-Api-Key":"***"'));
      for (final leaked in ['s1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9']) {
        expect(text, isNot(contains('"$leaked"')));
        expect(text, isNot(contains(': $leaked')));
      }
      expect(err.responseHeaders!['Authorization'], equals('Bearer s1'));
    });

    test('bhv transport 057 masks the static Authorization, Cookie and Proxy-Authorization headers', () {
      const err = ApiException(
        statusCode: 401,
        message: 'denied',
        responseHeaders: {
          'Authorization': 'Bearer t1',
          'Cookie': 't2',
          'Proxy-Authorization': 'Basic t3',
          'X-Trace': 'visible',
        },
      );

      final text = err.toString();
      expect(text, contains('"Authorization":"***"'));
      expect(text, contains('"Cookie":"***"'));
      expect(text, contains('"Proxy-Authorization":"***"'));
      expect(text, contains('"X-Trace":"visible"'));
      for (final leaked in ['t1', 't2', 't3']) {
        expect(text, isNot(contains(leaked)));
      }
    });

    test('bhv transport 056 masks API key header names', () {
      const err = ApiException(
        statusCode: 401,
        message: 'denied',
        responseHeaders: {
          'X-Api-Key': 'k1',
          'api_key': 'k2',
          'X-Trace': 'visible',
        },
      );

      final text = err.toString();
      expect(text, contains('"X-Api-Key":"***"'));
      expect(text, contains('"api_key":"***"'));
      expect(text, contains('"X-Trace":"visible"'));
      for (final leaked in ['k1', 'k2']) {
        expect(text, isNot(contains(leaked)));
      }
    });

    test('bhv errors 074 omits the status for a transport failure', () {
      const err = NetworkException(message: 'connection refused');

      expect(err.toString(), equals('connection refused'));
