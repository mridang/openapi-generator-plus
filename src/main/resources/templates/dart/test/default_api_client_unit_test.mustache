    test('bhv transport 052 sends an empty User-Agent header when the option is the empty string',
        () async {
      final socket = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
      final received = StringBuffer();
      socket.listen((conn) {
        conn.listen((data) {
          received.write(latin1.decode(data));
          if (received.toString().contains('\r\n\r\n')) {
            conn.add(latin1.encode(
                'HTTP/1.1 200 OK\r\ncontent-length: 0\r\nconnection: close\r\n\r\n'));
            conn.close();
          }
        });
      });

      try {
        final client = DefaultApiClient(
          transportOptions: TransportOptionsBuilder().userAgent('').build(),
        );
        await client.sendRequest(
          'GET',
          'http://localhost:${socket.port}/test',
          {},
          null,
        );
        expect(
          RegExp(r'\r\nuser-agent: *\r\n', caseSensitive: false)
              .hasMatch(received.toString()),
          isTrue,
        );
      } finally {
        await socket.close();
      }
    });

