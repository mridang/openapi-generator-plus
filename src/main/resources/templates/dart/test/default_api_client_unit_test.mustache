import 'dart:convert';
import 'dart:io';

import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('DefaultApiClient unit tests', () {
    test('userAgent header', () async {
      String? receivedUA;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedUA = request.headers.value('user-agent');
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final transport = TransportOptionsBuilder()
            .userAgent('TestAgent/1.0')
            .build();
        final client = DefaultApiClient(transportOptions: transport);

        await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(receivedUA, equals('TestAgent/1.0'));
      } finally {
        await server.close();
      }
    });

    test('default userAgent', () async {
      String? receivedUA;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedUA = request.headers.value('user-agent');
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final client = DefaultApiClient();
        await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(receivedUA, isNotNull);
        expect(receivedUA, isNotEmpty);
      } finally {
        await server.close();
      }
    });

    test('X-Request-ID injection', () async {
      String? receivedRequestId;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedRequestId = request.headers.value('x-request-id');
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final transport = TransportOptionsBuilder()
            .injectRequestId(true)
            .build();
        final client = DefaultApiClient(transportOptions: transport);

        await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(receivedRequestId, isNotNull);
        expect(receivedRequestId, isNotEmpty);
      } finally {
        await server.close();
      }
    });

    test('X-Request-ID not injected when disabled', () async {
      String? receivedRequestId;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedRequestId = request.headers.value('x-request-id');
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final transport = TransportOptionsBuilder()
            .injectRequestId(false)
            .build();
        final client = DefaultApiClient(transportOptions: transport);

        await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {},
          null,
        );
        expect(receivedRequestId, isNull);
      } finally {
        await server.close();
      }
    });

    test('X-Request-ID not overridden when already set', () async {
      String? receivedRequestId;
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) {
        receivedRequestId = request.headers.value('x-request-id');
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final transport = TransportOptionsBuilder()
            .injectRequestId(true)
            .build();
        final client = DefaultApiClient(transportOptions: transport);

        await client.sendRequest(
          'GET',
          'http://localhost:${server.port}/test',
          {'X-Request-ID': 'my-custom-id'},
          null,
        );
        expect(receivedRequestId, equals('my-custom-id'));
      } finally {
        await server.close();
