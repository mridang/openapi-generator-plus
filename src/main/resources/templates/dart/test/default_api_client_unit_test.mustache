/* A transport-free client that holds a proxy credential, so the headers the
 * SDK builds can be read from a stub instead of a real proxy tunnel. */
/// A [BaseApi] that retries without sleeping, so retry counts run fast.
class _NoWaitRetryApi extends BaseApi {
  _NoWaitRetryApi(ApiClient client, String baseUrl)
      : super(
          apiClient: client,
          config: ConfigurationBuilder().baseUrl(baseUrl).build(),
        );

  @override
  Future<void> sleepBeforeRetry(Duration delay) async {}
}

class _ProxyCredentialClient extends AbstractApiClient {
  _ProxyCredentialClient(http.Client inner)
      : super(
          TransportOptionsBuilder().build(),
          inner,
          AbstractApiClient.buildProxyAuthHeader(
            Uri.parse('http://user:pass@proxy.test:3128'),
          ),
        );

  @override
  Uint8List decompressBytes(Uint8List bytes, String contentEncoding) => bytes;
}

class _OwnedTransportClient extends AbstractApiClient {
  _OwnedTransportClient(http.Client inner)
      : super(TransportOptionsBuilder().build(), inner, null);

  @override
  Uint8List decompressBytes(Uint8List bytes, String contentEncoding) => bytes;
}

class _CloseTrackingClient extends http.BaseClient {
  _CloseTrackingClient(this._inner);

  final http.Client _inner;
  bool closed = false;

  @override
  Future<http.StreamedResponse> send(http.BaseRequest request) =>
      _inner.send(request);

  @override
  void close() {
    closed = true;
    _inner.close();
  }
}

/* Answers every send with a redirect whose body is the given stream, so a test
 * can see whether the SDK reads that body off before it refuses the hop. */
class _RedirectBodyClient extends http.BaseClient {
  _RedirectBodyClient(this._body);

  final Stream<List<int>> _body;

  @override
  Future<http.StreamedResponse> send(http.BaseRequest request) async =>
      http.StreamedResponse(
        _body,
        307,
        headers: {'location': 'http://example.com/insecure'},
      );
}

/* Adds the caller's own default header to every request it sends, the way a
 * caller-supplied client with its own defaults would. */
class _DefaultHeaderClient extends http.BaseClient {
  _DefaultHeaderClient(this._inner);

  final http.Client _inner;

  @override
  Future<http.StreamedResponse> send(http.BaseRequest request) {
    request.headers['X-Client'] = 'yes';
    return _inner.send(request);
  }
}

void main() {
  group('DefaultApiClientUnit', () {
    test('bhv transport 040 a caller-supplied http client receives the request with the SDK defaults', () async {
      http.BaseRequest? seen;
      final custom = MockClient((request) async {
        seen = request;
        return http.Response('ok', 200);
      });
      final transport = TransportOptionsBuilder()
          .httpClient(custom)
          .userAgent('Sdk/9.9')
          .injectRequestId(true)
          .build();
      final client = DefaultApiClient(transportOptions: transport);

      final resp = await client.sendRequest(
        'GET',
        'http://custom.test/ping',
        {'X-Caller': 'yes'},
        null,
      );

      expect(resp.statusCode, equals(200));
      expect(resp.body, equals('ok'));
      expect(seen, isNotNull);
      expect(seen!.url.toString(), equals('http://custom.test/ping'));
      expect(seen!.headers['user-agent'], equals('Sdk/9.9'));
      expect(seen!.headers['X-Caller'], equals('yes'));
      expect(seen!.headers.keys.map((k) => k.toLowerCase()), contains('x-request-id'));
    });

    test('bhv lifecycle 020 close never closes a caller-supplied http client', () async {
      final custom = _CloseTrackingClient(MockClient((_) async => http.Response('', 200)));
      final client = DefaultApiClient(
        transportOptions: TransportOptionsBuilder().httpClient(custom).build(),
      );

      client.close();

      expect(custom.closed, isFalse);
    });

    test('bhv redirects 048 a 301 or 302 turns a POST follow-up into a GET with no body and keeps the other methods', () async {
      const rows = <(int, String, String)>[
        (301, 'POST', 'GET'),
        (302, 'POST', 'GET'),
        (301, 'PATCH', 'PATCH'),
        (302, 'DELETE', 'DELETE'),
        (301, 'GET', 'GET'),
      ];
      var landedMethod = '';
      var landedBody = '';
      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
      server.listen((request) async {
        if (request.uri.path == '/start') {
          await request.drain<void>();
          request.response
            ..statusCode = int.parse(request.uri.queryParameters['status']!)
            ..headers.set('Location', '/landed')
            ..close();
          return;
        }
        landedMethod = request.method;
        landedBody = await utf8.decoder.bind(request).join();
        request.response
          ..statusCode = 200
          ..close();
      });

      try {
        final client = DefaultApiClient(
          transportOptions: TransportOptionsBuilder().followRedirects(true).build(),
        );
        for (final row in rows) {
          landedMethod = '';
          landedBody = '';
          await client.sendRequest(
            row.$2,
            'http://localhost:${server.port}/start?status=${row.$1}',
            {'Content-Type': 'text/plain'},
            row.$2 == 'GET' ? null : 'payload',
          );
          expect(landedMethod, equals(row.$3), reason: '${row.$1} ${row.$2}');
          if (row.$2 == 'POST') {
            expect(landedBody, isEmpty, reason: '${row.$1} POST');
          }
        }
      } finally {
        await server.close();
      }
    });

