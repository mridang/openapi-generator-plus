          await expectLater(
            client.sendRequest(
              'GET',
              'http://localhost:${server.port}/bad-gzip',
              {},
              null,
            ),
            // A response arrived, so this is an ApiException carrying its
            // real status, never a NetworkException with status 0.
            throwsA(
              isA<ApiException>()
                  .having((e) => e.runtimeType, 'runtimeType', ApiException)
                  .having((e) => e.statusCode, 'statusCode', 200)
                  .having(
                    (e) => e.message,
                    'message',
                    contains('Failed to decompress gzip response body'),
                  ),
            ),
          );
        } finally {
          await server.close();
        }
      },
    );

