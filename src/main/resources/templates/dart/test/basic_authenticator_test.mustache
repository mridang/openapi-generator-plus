import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('BasicAuthenticator', () {
    test('valid credentials produce basic header', () {
      final auth = BasicAuthenticator(
        host: 'https://api.example.com',
        username: 'alice',
        password: 's3cret',
      );
      final headers = auth.authHeaders();
      expect(headers['Authorization'], equals('Basic YWxpY2U6czNjcmV0'));
    });

    test('rejects username with crlf at construction', () {
      expect(
        () => BasicAuthenticator(
          host: 'https://api.example.com',
          username: 'alice\r\n',
          password: 's3cret',
        ),
        throwsArgumentError,
      );
    });

    test('rejects password with nul at construction', () {
      expect(
        () => BasicAuthenticator(
          host: 'https://api.example.com',
          username: 'alice',
          password: 's3c\x00ret',
        ),
        throwsArgumentError,
      );
    });

    test('rejects username with colon at construction', () {
      expect(
        () => BasicAuthenticator(
          host: 'https://api.example.com',
          username: 'ali:ce',
          password: 's3cret',
        ),
        throwsArgumentError,
      );
    });

    test('password is masked in default toString', () {
      /// authenticator-secret-in-default-string-repr: the default toString()
      /// must redact the stored password to *** so it cannot leak through
      /// logging or string interpolation.
      final auth = BasicAuthenticator(
        host: 'https://api.example.com',
        username: 'alice',
        password: 's3cret',
      );
      expect(auth.toString(), isNot(contains('s3cret')));
      expect(auth.toString(), contains('***'));
    });
  });
}
