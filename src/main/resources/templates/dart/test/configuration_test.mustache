import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('Configuration', () {
    test('bhv config 005 builder with no calls produces the default values', () {
      final config = ConfigurationBuilder().build();

      expect(config.baseUrl, equals('{{{basePath}}}'));
      expect(config.defaultHeaders, isEmpty);
    });

    test('bhv config 014 default values', () {
      final config = Configuration.defaultConfiguration();

      expect(config.baseUrl, equals('{{{basePath}}}'));
      expect(config.defaultHeaders, isEmpty);
    });

    test('bhv config 007 builder returns builder instance', () {
      final builder = Configuration.builder();
      expect(builder, isA<ConfigurationBuilder>());
    });

    test('builder is the static entry point for the builder', () {
      final config = Configuration.builder()
          .baseUrl('https://static.example.com')
          .build();

      expect(config.baseUrl, equals('https://static.example.com'));
    });

    test('bhv config 011 builder sets baseUrl', () {
      final config = ConfigurationBuilder()
          .baseUrl('https://custom.example.com')
          .build();

      expect(config.baseUrl, equals('https://custom.example.com'));
    });

    test('bhv config 013 builder sets default header', () {
      final config = ConfigurationBuilder()
          .defaultHeader('X-Custom', 'value')
          .build();

      final headers = config.defaultHeaders;
      expect(headers['X-Custom'], equals('value'));
    });

    test('bhv config 012 builder sets multiple default headers', () {
      final config = ConfigurationBuilder()
          .defaultHeaders({
            'X-First': 'one',
            'X-Second': 'two',
          })
          .build();

      final headers = config.defaultHeaders;
      expect(headers['X-First'], equals('one'));
      expect(headers['X-Second'], equals('two'));
    });

    test('builder chaining', () {
      final config = ConfigurationBuilder()
          .baseUrl('https://api.example.com')
          .defaultHeader('Authorization', 'Bearer token')
          .build();

      expect(config.baseUrl, equals('https://api.example.com'));
      expect(config.defaultHeaders['Authorization'], equals('Bearer token'));
    });

    test('bhv config 008 server URL resolution', () {
      final server = ServerConfiguration(
        urlTemplate: 'https://{env}.example.com/api/{version}',
        description: 'Test server',
        variables: {
          'env': const ServerVariable(
            defaultValue: 'api',
            enumValues: ['api', 'staging'],
          ),
          'version': const ServerVariable(
            defaultValue: 'v3',
            enumValues: ['v2', 'v3'],
          ),
        },
      );

      final config = ConfigurationBuilder()
          .server(server, {'env': 'staging'})
          .build();

      expect(config.baseUrl, equals('https://staging.example.com/api/v3'));
    });

    test('server URL resolution with defaults', () {
      final server = ServerConfiguration(
        urlTemplate: 'https://{env}.example.com/api/{version}',
        description: 'Test server',
        variables: {
          'env': const ServerVariable(
            defaultValue: 'api',
            enumValues: ['api', 'staging'],
          ),
          'version': const ServerVariable(
            defaultValue: 'v3',
            enumValues: ['v2', 'v3'],
          ),
        },
      );

      final config = ConfigurationBuilder()
          .server(server)
          .build();

      expect(config.baseUrl, equals('https://api.example.com/api/v3'));
    });

    test('bhv config 001 baseUrl override', () {
      final config = ConfigurationBuilder()
          .baseUrl('https://original.example.com')
          .baseUrl('https://override.example.com')
          .build();

      expect(config.baseUrl, equals('https://override.example.com'));
    });

    test('default headers copy isolation', () {
      final config = ConfigurationBuilder()
          .defaultHeader('X-Test', 'value')
          .build();

      final headers = config.defaultHeaders;
      headers['X-Mutated'] = 'should-not-affect-config';

      final original = config.defaultHeaders;
      expect(original.containsKey('X-Mutated'), isFalse);
    });

    test('bhv config 002 builder accumulates multiple headers', () {
      final config = ConfigurationBuilder()
          .defaultHeader('X-First', 'one')
          .defaultHeader('X-Second', 'two')
          .build();

      final headers = config.defaultHeaders;
      expect(headers.length, equals(2));
      expect(headers['X-First'], equals('one'));
      expect(headers['X-Second'], equals('two'));
    });

    test('bhv config 004 builder merges single and bulk headers', () {
      final config = ConfigurationBuilder()
          .defaultHeader('X-First', 'one')
          .defaultHeaders({'X-Second': 'two'})
          .defaultHeader('X-Third', 'three')
          .build();

      final headers = config.defaultHeaders;
      expect(headers.length, equals(3));
      expect(headers['X-First'], equals('one'));
      expect(headers['X-Second'], equals('two'));
      expect(headers['X-Third'], equals('three'));
    });

    test('bhv config 009 builder server applies every variable override', () {
      final server = ServerConfiguration(
        urlTemplate: 'https://{env}.example.com/api/{version}',
        description: 'Test server',
        variables: {
          'env': const ServerVariable(
            defaultValue: 'api',
            enumValues: ['api', 'staging'],
          ),
          'version': const ServerVariable(
            defaultValue: 'v3',
            enumValues: ['v2', 'v3'],
          ),
        },
      );

      final config = ConfigurationBuilder()
          .server(server, {'env': 'staging', 'version': 'v2'})
          .build();

      expect(config.baseUrl, equals('https://staging.example.com/api/v2'));
    });

    test('bhv config 010 builder sets every field', () {
      final config = ConfigurationBuilder()
          .baseUrl('https://all.example.com')
          .defaultHeader('X-One', 'one')
          .defaultHeaders({'X-Two': 'two'})
          .build();

      expect(config.baseUrl, equals('https://all.example.com'));
      expect(config.defaultHeaders, equals({'X-One': 'one', 'X-Two': 'two'}));
    });

    test('bhv config 015 inspect masks sensitive default headers', () {
      final config = ConfigurationBuilder()
          .defaultHeader('Authorization', 'Bearer secret-token')
          .defaultHeader('X-Api-Key', 'key-value')
          .defaultHeader('X-Trace', 'visible')
          .build();

      final text = config.toString();

      expect(text, isNot(contains('secret-token')));
      expect(text, isNot(contains('key-value')));
      expect(text, contains('visible'));
      expect(text, contains('***'));
    });

    test('bhv config 016 invalid server variable enum value throws', () {
      const server = ServerConfiguration(
        urlTemplate: 'https://{env}.example.com',
        variables: {
          'env': ServerVariable(
            defaultValue: 'api',
            enumValues: ['api', 'staging'],
          ),
        },
      );

      expect(
        () => ConfigurationBuilder().server(server, {'env': 'invalid'}).build(),
        throwsA(isA<ArgumentError>()),
      );
    });

    test('bhv config 003 builder methods return the builder for chaining', () {
      final builder = ConfigurationBuilder();
      final server = ServerConfiguration(urlTemplate: 'https://example.com');

      expect(identical(builder.baseUrl('https://example.com'), builder), isTrue);
      expect(identical(builder.defaultHeader('X-Key', 'value'), builder), isTrue);
      expect(identical(builder.defaultHeaders({'X-Other': 'val'}), builder), isTrue);
      expect(identical(builder.server(server), builder), isTrue);
    });

    test('bhv config 006 builder produces independent instances', () {
      final builder = ConfigurationBuilder().baseUrl('https://example.com');
      final first = builder.build();
      final second = builder.build();

      expect(first.baseUrl, equals(second.baseUrl));
      expect(identical(first, second), isFalse);
    });
  });
}
{{/generateTests}}
