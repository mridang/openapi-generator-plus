import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:opentelemetry/sdk.dart' as otel_sdk;
import 'package:test/test.dart';
import 'package:{{packageName}}/src/api/base_api.dart';
{{>call_hook_recipe}}

void main() {
  tearDown(() {
    TraceContextUtil.propagator = null;
  });

  group('OpenTelemetryCallHook recipe', () {
    test('bhv telemetry 001 the span is named with the spec operation id and has kind client', () async {
      final setup = _Setup();

      await setup.call();

      final span = setup.exporter.spans.single;
      expect(span.name, equals('listItems'));
      expect(span.kind, equals(otel.SpanKind.client));
    });

    test('bhv telemetry 002 a 2xx sets the request attributes and the status and leaves the span status unset', () async {
      final setup = _Setup();

      await setup.call();

      final span = setup.exporter.spans.single;
      expect(span.attributes.get('http.request.method'), equals('GET'));
      expect(span.attributes.get('url.template'), equals('/items/{id}'));
      expect(span.attributes.get('server.address'), equals('api.example.com'));
      expect(span.attributes.get('http.response.status_code'), equals(200));
      expect(span.attributes.get('error.type'), isNull);
      expect(span.status.code, equals(otel.StatusCode.unset));
    });

    test('bhv telemetry 003 a 4xx or 5xx sets error.type to the status code and marks the span as an error', () async {
      final setup = _Setup(status: 404);

      await expectLater(setup.call(), throwsA(isA<NotFoundException>()));

      final span = setup.exporter.spans.single;
      expect(span.attributes.get('http.response.status_code'), equals(404));
      expect(span.attributes.get('error.type'), equals('404'));
      expect(span.status.code, equals(otel.StatusCode.error));
    });

    test('bhv telemetry 004 error.type is timeout, network_error, serialization_error or _OTHER by the error', () {
      final setup = _Setup();
      final errors = <Object, String>{
        const NetworkTimeoutException(message: 'slow'): 'timeout',
        const NetworkException(message: 'refused'): 'network_error',
        SerializationException('bad body'): 'serialization_error',
        StateError('anything else'): '_OTHER',
      };

      errors.forEach((error, token) {
        setup.finishWith(CallOutcome(statusCode: 0, headers: null, error: error));
      });

      expect(
        setup.exporter.spans.map((s) => s.attributes.get('error.type')),
        equals(errors.values),
      );
    });

    test('bhv telemetry 005 a call with no response sets no status code', () {
      final setup = _Setup();

      setup.finishWith(CallOutcome(
        statusCode: 0,
        headers: null,
        error: const NetworkException(message: 'refused'),
      ));

      final span = setup.exporter.spans.single;
      expect(span.attributes.get('http.response.status_code'), isNull);
      expect(span.status.code, equals(otel.StatusCode.error));
    });

    test('bhv telemetry 006 the span is a child of the active span and the traceparent sent names the client span', () async {
      final setup = _Setup();
      final parent = setup.tracer.startSpan('caller');
      final parentContext = otel.contextWithSpan(otel.Context.root, parent);
      /* The propagator of the SDK writes the caller's span first. */
      TraceContextUtil.propagator = (headers) {
        setup.propagator.inject(parentContext, headers, _MapSetter());
      };
      setup.parent = parentContext;

      try {
        await setup.call();
      } finally {
        parent.end();
      }

      final span =
          setup.exporter.spans.firstWhere((s) => s.name == 'listItems');
      expect(span.parentSpanId.toString(),
          equals(parent.spanContext.spanId.toString()));
      expect(span.spanContext.traceId.toString(),
          equals(parent.spanContext.traceId.toString()));
      final sent = setup.sentHeaders.single['traceparent']!;
      expect(sent, contains(span.spanContext.spanId.toString()));
      expect(sent, isNot(contains(parent.spanContext.spanId.toString())));
    });

    test('bhv telemetry 007 a call retried by the transport records one span and one count', () async {
      final setup = _Setup(statuses: [503, 503, 200]);

      await setup.call();

      expect(setup.sentHeaders, hasLength(3));
      expect(setup.exporter.spans, hasLength(1));
      expect(setup.counts, hasLength(1));
    });

    test('bhv telemetry 008 the request count is recorded once per call with the attributes of the span', () async {
      final setup = _Setup();

      await setup.call();

      final span = setup.exporter.spans.single;
      expect(setup.counts, hasLength(1));
      expect(
        setup.counts.single.map((a) => '${a.key}=${a.value}').toSet(),
        equals({
          'http.request.method=GET',
          'url.template=/items/{id}',
          'server.address=api.example.com',
          'http.response.status_code=200',
        }),
      );
      expect(setup.counts.single.map((a) => a.key).toSet(),
          equals({
            'http.request.method',
            'url.template',
            'server.address',
            'http.response.status_code',
          }));
      expect(span.attributes.get('http.response.status_code'), equals(200));
    });

    test('bhv telemetry 009 the duration is recorded once per call in seconds with the attributes of the span', () async {
      final setup = _Setup();

      await setup.call();

      expect(setup.durations, hasLength(1));
      expect(setup.durations.single.$1, greaterThanOrEqualTo(0));
      expect(setup.durations.single.$1, lessThan(5));
      expect(setup.durations.single.$2.map((a) => a.key).toSet(),
          equals(setup.counts.single.map((a) => a.key).toSet()));
    });

    test('bhv telemetry 010 the instrumentation scope is named after the package and carries the version', () async {
      final setup = _Setup();

      await setup.call();

      final scope = setup.exporter.spans.single.instrumentationScope;
      expect(scope.name, equals('{{packageName}}'));
      expect(scope.version, equals('{{packageVersion}}'));
    });

    test('bhv telemetry 011 a provider handed to the recipe is used instead of the global one', () async {
      final setup = _Setup();

      await setup.call();

      /* No global provider is registered in this test run: only the one handed
         over could have recorded the span. */
      expect(identical(otel.globalTracerProvider, setup.provider), isFalse);
      expect(setup.exporter.spans, hasLength(1));
    });

    test('bhv telemetry 012 with no provider configured the recipe does nothing and the call is unchanged', () async {
      final sent = <Map<String, String>>[];
      final api = _Api(
        MockClient((request) async {
          sent.add(Map<String, String>.of(request.headers));
          return http.Response('{}', 200);
        }),
        OpenTelemetryCallHook(),
      );

      final response = await api.invokeApi(
        method: 'GET',
        path: '/items/7',
        operationId: 'listItems',
        urlTemplate: '/items/{id}',
      );

      expect(response.statusCode, equals(200));
      expect(sent.single.containsKey('traceparent'), isFalse);
    });

    test('bhv telemetry 013 the span ends exactly once, also when the call throws', () async {
      final setup = _Setup(status: 500, maxRetries: 0);

      await expectLater(setup.call(), throwsA(isA<InternalServerErrorException>()));

      expect(setup.exporter.spans, hasLength(1));
      expect(setup.exporter.spans.single.endTime, isNotNull);
    });

    test('bhv telemetry 014 no attribute carries a query string, a header value or a credential', () async {
      final setup = _Setup();

      await setup.call(path: '/items/7?token=query-secret');

      final values = [
        ...setup.exporter.spans.single.attributes.keys
            .map((k) => '${setup.exporter.spans.single.attributes.get(k)}'),
        ...setup.counts.single.map((a) => '${a.value}'),
      ];
      for (final value in values) {
        expect(value, isNot(contains('query-secret')));
        expect(value, isNot(contains('header-secret')));
        expect(value, isNot(contains('?')));
      }
    });
  });
}

/// One recipe hook wired to a real SDK tracer provider that records every
/// finished span in memory, and to a transport that answers with the given
/// statuses in turn.
class _Setup {
  _Setup({int status = 200, List<int>? statuses, int maxRetries = 2})
      : _statuses = statuses ?? [status] {
    provider = otel_sdk.TracerProviderBase(
      processors: [otel_sdk.SimpleSpanProcessor(exporter)],
    );
    hook = OpenTelemetryCallHook(
      tracerProvider: provider,
      propagator: propagator,
      currentContext: () => parent ?? otel.Context.current,
      onRequest: counts.add,
      onDuration: (seconds, attributes) => durations.add((seconds, attributes)),
    );
    _api = _Api(
      MockClient((request) async {
        sentHeaders.add(Map<String, String>.of(request.headers));
        final next = _statuses.length > 1 ? _statuses.removeAt(0) : _statuses.first;
        return http.Response('{}', next, headers: {'content-type': 'application/json'});
      }),
      hook,
      maxRetries: maxRetries,
    );
  }

  final List<int> _statuses;

  /// The context the recipe's span is a child of; the active one when null.
  otel.Context? parent;
  final exporter = _InMemorySpanExporter();
  final propagator = otel.W3CTraceContextPropagator();
  final sentHeaders = <Map<String, String>>[];
  final counts = <List<otel.Attribute>>[];
  final durations = <(double, List<otel.Attribute>)>[];
  late final otel.TracerProvider provider;
  late final OpenTelemetryCallHook hook;
  late final _Api _api;

  otel.Tracer get tracer => provider.getTracer('test');

  Future<ApiHttpResponse> call({String path = '/items/7'}) => _api.invokeApi(
        method: 'GET',
        path: path,
        headerParams: {'X-Secret': 'header-secret'},
        operationId: 'listItems',
        urlTemplate: '/items/{id}',
      );

  /// Starts and finishes one call by hand, so an outcome no transport would
  /// produce can be told to the recipe.
  void finishWith(CallOutcome outcome) {
    final observer = hook.start(
      CallInfo.of(
        operationId: 'listItems',
        method: 'GET',
        urlTemplate: '/items/{id}',
        target: 'https://api.example.com/items/7',
      ),
      <String, String>{},
    );
    observer!.finish(outcome);
  }
}

class _Api extends BaseApi {
  _Api(http.Client transport, CallHook hook, {int maxRetries = 2})
      : super(
          apiClient: DefaultApiClient(
            transportOptions: TransportOptionsBuilder()
                .httpClient(transport)
                .maxRetries(maxRetries)
                .build(),
          ),
          config: ConfigurationBuilder()
              .baseUrl('https://api.example.com')
              .callHook(hook)
              .build(),
        );

  @override
  Future<void> sleepBeforeRetry(Duration delay) async {}
}

class _MapSetter implements otel.TextMapSetter<Map<String, String>> {
  @override
  void set(Map<String, String> carrier, String key, String value) {
    carrier[key] = value;
  }
}

/// Keeps every exported span in memory so a test can assert on it.
class _InMemorySpanExporter implements otel_sdk.SpanExporter {
  final List<otel_sdk.ReadOnlySpan> spans = [];

  @override
  void export(List<otel_sdk.ReadOnlySpan> spans) => this.spans.addAll(spans);

  @Deprecated('Removed from SpanExporter in opentelemetry 0.19.0.')
  @override
  void forceFlush() {}

  @override
  void shutdown() {}
}
