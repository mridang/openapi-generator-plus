import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';

import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

import 'testcontainers_helper.dart';

class _BaseApiAuth implements Authenticator {
  final Map<String, String> headers;
  final Map<String, String> query;
  final Map<String, String> cookies;

  _BaseApiAuth({
    this.headers = const {},
    this.query = const {},
    this.cookies = const {},
  });

  @override
  String host() => '';
  @override
  Map<String, String> authHeaders() => headers;
  @override
  Map<String, String> queryParams() => query;
  @override
  Map<String, String> cookieParams() => cookies;
}

PetApi _wiremockApi() {
  final config = ConfigurationBuilder()
      .baseUrl(wiremockHttpUrl)
      .build();
  return PetApi(apiClient: DefaultApiClient(), config: config);
}

void main() {
  setUpAll(() async {
    await setUpContainers();
  });

  tearDownAll(() async {
    await tearDownContainers();
  });

  group('BaseApi', () {
    test('error dispatch', () async {
      final testCases = <int, Type>{
        400: BadRequestError,
        401: UnauthorizedError,
        403: ForbiddenError,
        404: NotFoundError,
        409: ConflictError,
        422: UnprocessableEntityError,
        500: InternalServerError,
        502: ServerError,
      };

      for (final entry in testCases.entries) {
        final status = entry.key;
        final errType = entry.value;

        final config = ConfigurationBuilder()
            .baseUrl('$wiremockHttpUrl/api/error/$status')
            .build();
        final api = PetApi(apiClient: DefaultApiClient(), config: config);

        try {
          await api.getPetById(1, null);
          fail('Expected error for status $status');
        } on ApiError catch (e) {
          expect(e.runtimeType, equals(errType),
              reason: 'Status $status should throw $errType, got ${e.runtimeType}');
        }
      }
    });

    test('parses JSON error body', () async {
      final config = ConfigurationBuilder()
          .baseUrl('$wiremockHttpUrl/api/error/400')
          .build();
      final api = PetApi(apiClient: DefaultApiClient(), config: config);

      try {
        await api.getPetById(1, null);
        fail('Expected error for status 400');
      } on BadRequestError catch (e) {
        expect(e.errorBody, isNotNull, reason: 'errorBody should not be null for JSON responses');
      }
    });

    test('deserializes JSON response', () async {
      final client = DefaultApiClient();
      final resp = await client.sendRequest(
        'GET',
        '$wiremockHttpUrl/api/test',
        {},
        null,
      );
      expect(resp.body, isNotEmpty);

      final parsed = jsonDecode(resp.body) as Map<String, dynamic>;
      expect(parsed['message'], equals('success'));
    });

    test('returns raw body for non-JSON', () async {
      final client = DefaultApiClient();
      final resp = await client.sendRequest(
        'GET',
        '$wiremockHttpUrl/api/text',
        {},
        null,
      );
      expect(resp.body, contains('hello plain text'));
    });

