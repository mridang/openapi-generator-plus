class _BaseApiAuth implements Authenticator {
  final Map<String, String> headers;
  final Map<String, String> query;
  final Map<String, String> cookies;

  _BaseApiAuth({
    this.headers = const {},
    this.query = const {},
    this.cookies = const {},
  });

  @override
  String host() => '';
  @override
  Map<String, String> authHeaders() => headers;
  @override
  Future<Map<String, String>> authHeadersAsync() async => headers;
  @override
  Map<String, String> queryParams() => query;
  @override
  Map<String, String> cookieParams() => cookies;
}

class _ClientRecordingAuth implements HttpAwareAuthenticator {
  ApiClient? injected;

  @override
  void setApiClient(ApiClient client) {
    injected = client;
  }

  @override
  String host() => '';
  @override
  Map<String, String> authHeaders() => const {};
  @override
  Future<Map<String, String>> authHeadersAsync() async => const {};
  @override
  Map<String, String> queryParams() => const {};
  @override
  Map<String, String> cookieParams() => const {};
}

class _CapturingApiClient implements ApiClient {
  String capturedUrl = '';
  String capturedBody = '';

  @override
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
  }) async {
    capturedUrl = url;
    capturedBody = body is List<int> ? utf8.decode(body) : '';
    return ApiHttpResponse(
      statusCode: 200,
      body: '{}',
      headers: {'content-type': 'application/json'},
    );
  }
}

/// Plays back a script of responses and transport errors, recording what was
/// sent, and offers the retry policy the API classes read.
class _ScriptedApiClient implements RetryingApiClient {
  _ScriptedApiClient(this.script, {this.maxRetries = 2, this.timeoutMillis});

  final List<Object> script;
  final List<Map<String, String>> sentHeaders = [];
  final List<Object?> sentBodies = [];
  final List<int?> sentTimeouts = [];

  @override
  final int maxRetries;

  @override
  final int? timeoutMillis;

  @override
  Future<ApiHttpResponse> sendRequest(
    String method,
    String url,
    Map<String, String> headers,
    Object? body, {
    bool noRedirect = false,
    int? timeout,
    bool noDefaultHeaders = false,
  }) async {
    sentHeaders.add(Map<String, String>.from(headers));
    sentBodies.add(body);
    sentTimeouts.add(timeout);
    final next = script.removeAt(0);
    if (next is ApiHttpResponse) {
      return next;
    }
    throw next;
  }
}

ApiHttpResponse _reply(int status, {Map<String, String> headers = const {}}) =>
    ApiHttpResponse(statusCode: status, body: '{}', headers: headers);

/// A [BaseApi] that records the waits before a retry instead of sleeping.
class _RecordingApi extends BaseApi {
  _RecordingApi(ApiClient client, {Authenticator? authenticator})
      : super(
          apiClient: client,
          config: ConfigurationBuilder().baseUrl('https://api.example.com').build(),
          authenticator: authenticator,
        );

  final List<Duration> waits = [];

  @override
  Future<void> sleepBeforeRetry(Duration delay) async {
    waits.add(delay);
  }
}

/// A [BaseApi] whose client is closed during the first wait, as a caller that
/// gives up on the call does.
class _ClosingApi extends BaseApi {
  _ClosingApi(this._client, String baseUrl)
      : super(
          apiClient: _client,
          config: ConfigurationBuilder().baseUrl(baseUrl).build(),
        );

  final DefaultApiClient _client;

  @override
  Future<void> sleepBeforeRetry(Duration delay) async {
    _client.close();
  }
}

/// An OAuth2-like authenticator: a new token generation after every
/// invalidation, optionally failing to produce one.
class _RotatingAuth extends BaseAuthenticator implements AccessTokenInvalidating {
  int generation = 1;
  int invalidations = 0;
  bool failAfterInvalidation = false;

  @override
  String host() => '';

  @override
  Map<String, String> authHeaders() => {'Authorization': 'Bearer t$generation'};

  @override
  Future<Map<String, String>> authHeadersAsync() async {
    if (failAfterInvalidation && invalidations > 0) {
      throw StateError('no token');
    }
    return authHeaders();
  }

  @override
  void invalidateAccessToken() {
    invalidations++;
    generation++;
  }
}

/// An authenticator whose header differs on every call, to show a retry asks
/// for the credentials again.
class _CountingAuth extends BaseAuthenticator {
  int calls = 0;

  @override
  String host() => '';

  @override
  Map<String, String> authHeaders() => {'Authorization': 'Bearer n$calls'};

  @override
  Future<Map<String, String>> authHeadersAsync() async {
    calls++;
    return authHeaders();
  }
}

PetApi _chasmApi({Map<String, Authenticator>? schemes}) {
  final config = ConfigurationBuilder()
      .baseUrl(chasmHttpUrl)
      .build();
  return PetApi(
      apiClient: DefaultApiClient(),
      config: config,
      schemeAuthenticators: schemes);
}

/// An authenticator whose credential lookup suspends before it answers.
class _SlowAuth extends _BaseApiAuth {
  @override
  Future<Map<String, String>> authHeadersAsync() async {
    await Future<void>.delayed(const Duration(milliseconds: 20));
    return headers;
  }
}

