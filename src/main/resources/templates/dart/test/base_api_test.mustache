/// A [BaseApi] with a [CallHook] on its configuration that records the waits
/// before a retry instead of sleeping.
class _HookedApi extends BaseApi {
  _HookedApi(
    ApiClient client,
    CallHook? hook, {
    Authenticator? authenticator,
    String baseUrl = 'https://api.example.com',
    Map<String, String> defaultHeaders = const {},
  }) : super(
          apiClient: client,
          config: ConfigurationBuilder()
              .baseUrl(baseUrl)
              .defaultHeaders(defaultHeaders)
              .callHook(hook)
              .build(),
          authenticator: authenticator,
        );

  @override
  Future<void> sleepBeforeRetry(Duration delay) async {}
}

/// A hook that records what it is told and can edit the headers or fail.
class _RecordingHook implements CallHook {
  _RecordingHook({
    this.edit,
    this.failOnStart,
    this.failOnFinish,
    this.returnsObserver = true,
  });

  final void Function(Map<String, String> headers)? edit;
  final Object? failOnStart;
  final Object? failOnFinish;
  final bool returnsObserver;
  final List<CallInfo> infos = [];
  final List<Map<String, String>> seen = [];
  final List<CallOutcome> outcomes = [];

  @override
  CallObserver? start(CallInfo info, Map<String, String> headers) {
    infos.add(info);
    seen.add(Map<String, String>.of(headers));
    edit?.call(headers);
    final failure = failOnStart;
    if (failure != null) {
      throw failure;
    }
    return returnsObserver ? _RecordingObserver(this) : null;
  }
}

class _RecordingObserver implements CallObserver {
  _RecordingObserver(this._hook);

  final _RecordingHook _hook;

  @override
  void finish(CallOutcome outcome) {
    _hook.outcomes.add(outcome);
    final failure = _hook.failOnFinish;
    if (failure != null) {
      throw failure;
    }
  }
}
