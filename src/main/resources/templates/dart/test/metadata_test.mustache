  group('README.md', () {
    test('bhv options 044 names the builder setter that rejects a SOCKS proxy', () {
      final readme =
          File('${Directory.current.path}/README.md').readAsStringSync();
      expect(
          readme,
          contains('`TransportOptionsBuilder.proxy()` accepts only `http://` '
