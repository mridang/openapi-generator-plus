  group('pubspec manifest', () {
    test('bhv models 002 declares a non-empty description', () {
      // manifest-description-missing: the published pubspec must carry a
      // description (wired from the spec's appDescription, with a generated
      // fallback) so pub.dev does not show an empty description.
      final pubspec = File('${Directory.current.path}/pubspec.yaml');
      expect(pubspec.existsSync(), isTrue,
          reason: 'pubspec.yaml must exist at the project root');
      final contents = pubspec.readAsStringSync();
      final match =
          RegExp(r'^description:\s*(.+)$', multiLine: true).firstMatch(contents);
      expect(match, isNotNull, reason: 'pubspec.yaml must declare a description');
      expect(match!.group(1)!.trim(), isNotEmpty,
          reason: 'description must not be empty');
    });

    test('writes the description as a quoted YAML scalar', () {
      final contents =
          File('${Directory.current.path}/pubspec.yaml').readAsStringSync();
      final match =
          RegExp(r'^description:\s*(.+)$', multiLine: true).firstMatch(contents);
      expect(match!.group(1)!.trim(), matches(r'^".*"$'),
          reason: 'an unquoted scalar breaks on `: `, `#` and a leading `&`');
    });
  });

