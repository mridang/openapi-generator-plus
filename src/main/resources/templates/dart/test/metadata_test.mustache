    test('bhv skills 001 the error section names the root type and every branch of the tree', () {
      final skills =
          File('${Directory.current.path}/SKILLS.md').readAsStringSync();
      for (final name in [
        '{{errorPrefix}}Exception',
        'SerializationException',
        'OAuth2ServerException',
        'OAuth2TokenException',
      ]) {
        expect(skills, contains('`$name`'));
