  group('file header', () {
    test('bhv models 006 prints the info description without backslash-escaped quotes', () {
      /* F1156: the header comment of every generated source file renders the
       * info description; a quote must not reach it as a backslash-quote. */
      final headers = Directory('${Directory.current.path}/lib')
          .listSync(recursive: true)
          .whereType<File>()
          .where((file) => file.path.endsWith('.dart'))
          .map((file) => file
              .readAsLinesSync()
              .takeWhile((line) => line.startsWith('//'))
              .toList())
          .where((lines) => lines.isNotEmpty)
          .toList();
      expect(headers, isNotEmpty);
      for (final header in headers) {
        for (final line in header) {
          expect(line.contains(r'\"'), isFalse,
              reason: 'header line must not carry a backslash-escaped quote: $line');
        }
      }
    });
  });

  group('package barrel', () {
    test('documents the library without backslash-escaped quotes', () {
      final barrel =
          File('${Directory.current.path}/lib/{{packageName}}.dart').readAsLinesSync();
      final doc = barrel.where((line) => line.startsWith('///')).toList();
      expect(doc, isNotEmpty);
      for (final line in doc) {
        expect(line.contains(r'\"'), isFalse,
            reason: 'library doc line must not carry a backslash-escaped quote: $line');
      }
    });

    test('hides the internal no-auth sentinel from the public API', () {
      final barrel =
          File('${Directory.current.path}/lib/{{packageName}}.dart').readAsStringSync();
      expect(
        barrel,
        contains("export 'src/auth/authenticator.dart' hide NoAuthAuthenticator, noAuth;"),
      );
    });
  });

  group('Metadata model', () {
    test('bhv models 010 a declared property wins over a colliding additional property', () {
      final metadata = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: const {'createdAt': 'x', 'extra': 1},
      );

      final json = jsonEncode(metadata.toJson());

      expect(json,
          equals('{"createdAt":"2024-01-15T10:30:00.000+00:00","extra":1}'));
    });

    test('bhv models 008 serialize empty metadata', () {
      final obj = <String, dynamic>{};

      final json = jsonEncode(obj);

      expect(json, isNotEmpty);
    });

    test('deserialize from JSON', () {
      final jsonData = '{"createdAt":"2024-01-15T10:30:00+00:00"}';

      final parsed = jsonDecode(jsonData) as Map<String, dynamic>;
      expect(parsed['createdAt'], isNotNull);
    });

    test('bhv models 003 deserialize empty object', () {
      final jsonData = '{}';

      final parsed = jsonDecode(jsonData) as Map<String, dynamic>;
      expect(parsed, isEmpty);
    });

    test('bhv models 004 deserialize with additional properties', () {
      final jsonData =
          '{"createdAt":"2024-01-15T10:30:00+00:00","customField":"customValue","count":42}';

      final parsed = jsonDecode(jsonData) as Map<String, dynamic>;
      expect(parsed['customField'], equals('customValue'));
      expect(parsed['count'], equals(42));
    });

    test('bhv models 011 round trip', () {
      final jsonData = '{"createdAt":"2024-01-15T10:30:00+00:00"}';

      final parsed = jsonDecode(jsonData);
      final serialized = jsonEncode(parsed);
      expect(serialized, isNotEmpty);

      final restored = jsonDecode(serialized) as Map<String, dynamic>;
      expect(restored['createdAt'], equals('2024-01-15T10:30:00+00:00'));
    });

    // -- AdditionalPropertiesRoundTripTests (canonical scenario 5) --
    //
    // Metadata declares `additionalProperties: {type: string}`, so any JSON
    // key beyond the declared `createdAt` must be captured into the model's
    // additionalProperties map on fromJson, and re-emitted at the TOP level on
    // toJson (NOT nested under an "additionalProperties"/"additional_properties"
    // key). This exercises the real Metadata.fromJson / toJson, not raw
    // jsonDecode.
    test('bhv models 001 Metadata captures unknown keys and re-serializes them at top level', () {
      final source = <String, dynamic>{
        'createdAt': '2024-01-15T10:30:00+00:00',
        'customField': 'customValue',
        'region': 'eu',
      };

      final model = Metadata.fromJson(source);
      // Declared field is read normally.
      expect(model.createdAt, isNotNull);
      // Unknown keys are captured into the additionalProperties map.
      expect(model.additionalProperties['customField'], equals('customValue'));
      expect(model.additionalProperties['region'], equals('eu'));
      // The capture bucket is NOT itself populated with a declared key.
      expect(model.additionalProperties.containsKey('createdAt'), isFalse);

      final wire = model.toJson();
      // Re-serialized at the TOP level, flat — never nested under a bucket key.
      expect(wire['customField'], equals('customValue'));
      expect(wire['region'], equals('eu'));
      expect(wire.containsKey('additionalProperties'), isFalse);
      expect(wire.containsKey('additional_properties'), isFalse);
    });
  });

  group('Model doc comments', () {
    test('bhv models 007 no generated model claims a literal `null` example', () {
      // L1 regression: when the spec declares no example, the codegen fills
      // the property example with the literal string `null`, which is truthy
      // in Mustache. Without a guard, nearly every field would carry a false
      // `/// Example: `null`` doc line. The model template gates that line so
      // it is emitted ONLY for a genuine example. Assert NO generated model
      // file contains the polluting doc text.
      final modelsDir =
          Directory('${Directory.current.path}/lib/src/models');
      expect(modelsDir.existsSync(), isTrue,
          reason: 'generated models directory must exist');

      final offenders = <String>[];
      for (final entity in modelsDir.listSync()) {
        if (entity is File && entity.path.endsWith('.dart')) {
          final contents = entity.readAsStringSync();
          if (contents.contains('Example: `null`')) {
            offenders.add(entity.path);
          }
        }
      }

      expect(offenders, isEmpty,
          reason: 'these models stamp a false null example: $offenders');
    });
  });

  group('Metadata serialization', () {
    test('bhv serializationobject 020 an additional property re-serializes at the top level, not nested', () {
      final decoded = Metadata.fromJson({'region': 'eu'});
      expect(decoded.additionalProperties, equals({'region': 'eu'}));
      expect(decoded.toJson(), equals({'region': 'eu'}));
    });
  });

  group('Metadata value equality', () {
    test('instances differing only in additionalProperties are not equal', () {
      const first = Metadata(additionalProperties: {'region': 'eu'});
      const second = Metadata(additionalProperties: {'region': 'us'});

      expect(first, isNot(equals(second)));
    });

    test('bhv models 005 instances with equal additionalProperties are equal and hash alike', () {
      final first = Metadata(
        additionalProperties: {'tags': ['a', 'b'], 'region': 'eu'},
      );
      final second = Metadata(
        additionalProperties: {'region': 'eu', 'tags': ['a', 'b']},
      );

      expect(first, equals(second));
      expect(first.hashCode, equals(second.hashCode));
    });

    test('bhv equality 001 models built from the same values are equal and a nested change makes them unequal', () {
      final first = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: {
          'tags': ['a', 'b'],
          'limits': {'max': 3},
        },
      );
      final same = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: {
          'tags': ['a', 'b'],
          'limits': {'max': 3},
        },
      );
      final changedList = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: {
          'tags': ['a', 'c'],
          'limits': {'max': 3},
        },
      );
      final changedMap = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: {
          'tags': ['a', 'b'],
          'limits': {'max': 4},
        },
      );
      final Object? nothing = null;
      final Object other = 'metadata';

      expect(first, equals(same));
      expect(first.hashCode, equals(same.hashCode));
      expect(first, isNot(equals(changedList)));
      expect(first, isNot(equals(changedMap)));
      expect(first == other, isFalse);
      expect(first == nothing, isFalse);
    });

    test('bhv models 012 toString dumps the fields and the additionalProperties map', () {
      final metadata = Metadata(
        createdAt: DateTime.utc(2024, 1, 15, 10, 30),
        additionalProperties: const {'tags': ['a', 'b']},
      );

      final text = metadata.toString();

      expect(text, startsWith('Metadata('));
      expect(text, contains('createdAt: 2024-01-15 10:30:00.000Z'));
      expect(text, contains('additionalProperties: {tags: [a, b]}'));
      expect(text, isNot(contains("Instance of")));
    });
  });
}
