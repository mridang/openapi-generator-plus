import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

class _Step implements CallHook {
  _Step(this.name, this.log, {this.observes = true});

  final String name;
  final List<String> log;
  final bool observes;

  @override
  CallObserver? start(CallInfo info, Map<String, String> headers) {
    log.add('start $name');
    return observes ? _StepObserver(name, log) : null;
  }
}

class _StepObserver implements CallObserver {
  _StepObserver(this.name, this.log);

  final String name;
  final List<String> log;

  @override
  void finish(CallOutcome outcome) {
    log.add('finish $name');
  }
}

const _outcome = CallOutcome(statusCode: 200, headers: {}, error: null);

CallInfo _info() => CallInfo.of(
      operationId: 'listItems',
      method: 'get',
      urlTemplate: '/items',
      target: 'https://api.example.com/items',
    );

void main() {
  group('chainCallHooks', () {
    test('bhv hooks 020 chain starts the hooks in order and finishes their observers in reverse order, and a hook that returns nothing is skipped', () {
      final log = <String>[];
      final hook = chainCallHooks([_Step('a', log), _Step('b', log), _Step('c', log)]);

      hook.start(_info(), <String, String>{})!.finish(_outcome);

      expect(
        log,
        equals(['start a', 'start b', 'start c', 'finish c', 'finish b', 'finish a']),
      );

      final skipped = <String>[];
      final skipping = chainCallHooks([
        _Step('a', skipped),
        _Step('silent', skipped, observes: false),
        _Step('b', skipped),
      ]);

      skipping.start(_info(), <String, String>{})!.finish(_outcome);

      expect(
        skipped,
        equals(['start a', 'start silent', 'start b', 'finish b', 'finish a']),
      );
      expect(
        chainCallHooks([_Step('a', <String>[], observes: false)])
            .start(_info(), <String, String>{}),
        isNull,
      );
    });

    test('bhv langdart 026 every observer is finished although one of them throws, and the error is rethrown', () {
      final log = <String>[];
      final hook = chainCallHooks([_Step('a', log), _ThrowingStep(), _Step('b', log)]);
      final observer = hook.start(_info(), <String, String>{})!;

      expect(() => observer.finish(_outcome), throwsStateError);
      expect(log, equals(['start a', 'start b', 'finish b', 'finish a']));
    });

    test('bhv langdart 027 hooks start with the same header map, so each sees the edits of the one before', () {
      final headers = <String, String>{};
      final hook = chainCallHooks([_Setter('X-One', '1'), _Setter('X-Two', '2')]);

      hook.start(_info(), headers);

      expect(headers, equals({'X-One': '1', 'X-Two': '2'}));
    });
  });
}

class _ThrowingStep implements CallHook {
  @override
  CallObserver? start(CallInfo info, Map<String, String> headers) =>
      _ThrowingObserver();
}

class _ThrowingObserver implements CallObserver {
  @override
  void finish(CallOutcome outcome) {
    throw StateError('observer broke');
  }
}

class _Setter implements CallHook {
  _Setter(this.name, this.value);

  final String name;
  final String value;

  @override
  CallObserver? start(CallInfo info, Map<String, String> headers) {
    headers[name] = value;
    return null;
  }
}
