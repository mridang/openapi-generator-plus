class _TransportRecordingBearer extends BearerAuthenticator
    implements HttpAwareAuthenticator {
  _TransportRecordingBearer({required super.host, required super.token});

  ApiClient? injected;

  @override
  void setApiClient(ApiClient client) {
    injected = client;
  }
}

class _CountingHook implements CallHook {
  int starts = 0;
  int finishes = 0;

  @override
  CallObserver? start(CallInfo info, Map<String, String> headers) {
    starts++;
    return _CountingObserver(this);
  }
}

class _CountingObserver implements CallObserver {
  _CountingObserver(this._hook);

  final _CountingHook _hook;

  @override
  void finish(CallOutcome outcome) {
    _hook.finishes++;
  }
}
