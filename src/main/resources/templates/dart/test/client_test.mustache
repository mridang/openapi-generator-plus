        final transport = client.pet.apiClient as StreamingApiClient;
        final open = await transport.sendStreaming(
            'GET', server.url('/items/events'), {}, null);
        final reader = StreamIterator(open.body);
        expect(await reader.moveNext(), isTrue);
        expect(utf8.decode(reader.current), equals('tick'));

        final clock = Stopwatch()..start();
        client.close();
        expect(clock.elapsed, lessThan(const Duration(seconds: 5)),
            reason: 'closing did not wait for the endless stream');

        await expectLater(
          reader.moveNext(),
          throwsA(isA<StateError>().having(
              (e) => e.message,
              'message',
