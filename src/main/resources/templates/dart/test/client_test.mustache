import 'dart:io';

import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

class _CloseTrackingClient extends http.BaseClient {
  _CloseTrackingClient(this._inner);

  final http.Client _inner;
  bool closed = false;

  @override
  Future<http.StreamedResponse> send(http.BaseRequest request) =>
      _inner.send(request);

  @override
  void close() {
    closed = true;
    _inner.close();
  }
}

void main() {
  group('{{clientClassName}}', () {
    test('withToken takes a token provider instead of a token', () {
      final client = {{clientClassName}}.withToken(
        host: '{{{basePath}}}',
        tokenProvider: () => 'rotating-token',
      );

      expect(client, isNotNull);
    });

    test('withToken fails to build when no token is given or in the environment', () {
      if (Platform.environment[BearerAuthenticator.defaultEnvironmentVariable] != null) {
        return;
      }

      expect(
        () => {{clientClassName}}.withToken(host: '{{{basePath}}}'),
        throwsA(isA<ArgumentError>()),
      );
    });

    test('construct with authenticator only', () {
      final authenticator = BearerAuthenticator(host: '{{{basePath}}}', token: 'test-token');

      final client = {{clientClassName}}(authenticator: authenticator);

      expect(client, isNotNull);
    });

    test('construct with authenticator and null transport options', () {
      final authenticator = BearerAuthenticator(host: '{{{basePath}}}', token: 'test-token');

      final client = {{clientClassName}}(authenticator: authenticator, transportOptions: null);

      expect(client, isNotNull);
    });

    test('construct with authenticator and transport options', () {
      final authenticator = BearerAuthenticator(host: '{{{basePath}}}', token: 'test-token');
      final transport = TransportOptionsBuilder().build();

      final client = {{clientClassName}}(authenticator: authenticator, transportOptions: transport);

      expect(client, isNotNull);
    });

    test('construct with a caller-supplied http client in the transport options', () {
      final authenticator = BearerAuthenticator(host: '{{{basePath}}}', token: 'test-token');
      final transport = TransportOptionsBuilder()
          .httpClient(MockClient((_) async => http.Response('', 200)))
          .build();

      final client = {{clientClassName}}(authenticator: authenticator, transportOptions: transport);

      expect(client, isNotNull);
    });

    test('close never closes a caller-supplied http client', () {
      final supplied = _CloseTrackingClient(
        MockClient((_) async => http.Response('', 200)),
      );
      final client = {{clientClassName}}(
        authenticator: BearerAuthenticator(host: 'http://localhost:1', token: 'test-token'),
        transportOptions: TransportOptionsBuilder().httpClient(supplied).build(),
      );

      client.close();
      client.close();

      expect(supplied.closed, isFalse);
    });

    test('close on a client that built its own transport is idempotent', () {
      final client = {{clientClassName}}(
        authenticator: BearerAuthenticator(host: 'http://localhost:1', token: 'test-token'),
      );

      client.close();

      expect(client.close, returnsNormally);
    });

    test('BearerAuthenticator rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'tok\r\nInjected: yes'),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'ñoño'),
        throwsArgumentError,
      );
    });

    test('BearerAuthenticator rejects an empty or whitespace token', () {
      // bearer-no-empty-token-guard: an empty / whitespace-only token would
      // emit a bare "Authorization: Bearer " header and send the request
      // unauthenticated, so the constructor must reject it.
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: ''),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: '   '),
        throwsArgumentError,
      );
    });

    test('ApiKeyAuthenticator HEADER rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      // HEADER location must reject anything outside printable ASCII +
      // TAB to prevent header injection (\r\n) and silent UTF-8
      // mangling that varies per HTTP lib.
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'abc\r\nInjected: yes',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'kéy',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );

      // Non-header locations accept arbitrary chars.
      final queryAuth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'api_key',
        apiKey: 'kéy',
        location: ApiKeyLocation.query,
      );
      expect(queryAuth.queryParams(), equals({'api_key': 'kéy'}));
    });

    test('API groups are accessible', () {
      final authenticator = BearerAuthenticator(host: '{{{basePath}}}', token: 'test-token');

      final client = {{clientClassName}}(authenticator: authenticator);

{{#apiInfo}}
{{#apis}}
{{#operations}}
      expect(client.{{clientPropertyName}}, isNotNull);
{{/operations}}
{{/apis}}
{{/apiInfo}}
    });
  });
}
