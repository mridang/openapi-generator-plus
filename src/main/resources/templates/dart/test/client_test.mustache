    test('bhv lifecycle 006 BearerAuthenticator rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'tok\r\nInjected: yes'),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: 'ñoño'),
        throwsArgumentError,
      );
    });

    test('bhv lifecycle 005 BearerAuthenticator rejects an empty or whitespace token', () {
      // bearer-no-empty-token-guard: an empty / whitespace-only token would
      // emit a bare "Authorization: Bearer " header and send the request
      // unauthenticated, so the constructor must reject it.
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: ''),
        throwsArgumentError,
      );
      expect(
        () => BearerAuthenticator(host: '{{{basePath}}}', token: '   '),
        throwsArgumentError,
      );
    });

    test('bhv lifecycle 004 ApiKeyAuthenticator HEADER rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      // HEADER location must reject anything outside printable ASCII +
      // TAB to prevent header injection (\r\n) and silent UTF-8
      // mangling that varies per HTTP lib.
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'abc\r\nInjected: yes',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'kéy',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );

      // Non-header locations accept arbitrary chars.
      final queryAuth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'api_key',
        apiKey: 'kéy',
        location: ApiKeyLocation.query,
      );
      expect(queryAuth.queryParams(), equals({'api_key': 'kéy'}));
    });

    test('bhv lifecycle 002 API key header rejects a line feed and non-ASCII', () {
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'abc\ndef',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'naïve',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
