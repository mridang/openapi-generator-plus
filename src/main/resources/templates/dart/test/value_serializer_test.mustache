    // -- DateOnlyPathParamTests --
    //
    // For `format: date` parameters the Dart generator maps the type to
    // String, so the caller passes "YYYY-MM-DD" directly and it must flow
    // through serializeValue unchanged (after percent-encoding for path).
    //
    // This guards against accidental DateTime upcasting that would inject
    // a `T00:00:00+00:00` suffix into the URL.
    group('DateOnlyPathParam', () {
      test('bhv serializationparam 028 serializeValue path date-only string preserves YYYY-MM-DD', () {
        final result =
            serializeValue('2024-01-15', 'path', 'string', '');
        expect(result, equals('2024-01-15'),
            reason: 'a format: date value must not gain a time/offset suffix');
      });

      test('bhv serializationparam 054 serializeStyled simple path date-only preserves YYYY-MM-DD', () {
        final result = serializeStyled(
            'when', '2024-01-15', 'path', 'string', '', 'simple', false);
        expect(result, equals('2024-01-15'));
      });

      test('stringify of date-only string preserves YYYY-MM-DD', () {
        // Sanity check: stringify must not reformat date-only strings.
        expect(stringify('2024-01-15'), equals('2024-01-15'));
      });
    });

    test('bhv serializationparam 033 empty string path param throws ArgumentError', () {
      // Gap W — empty-string path values silently produce malformed
      // URLs like `/resource//details`; reject at serialization time so
      // callers see the real error rather than a downstream 404.
      expect(
        () => serializeStyled('id', '', 'path', 'string', '', 'simple', false),
        throwsArgumentError,
      );
    });

    for (final dots in ['.', '..']) {
      test('bhv serializationparam 029 dot segment "$dots" path param throws ArgumentError', () {
        expect(
          () => serializeStyled('id', dots, 'path', 'string', '', 'simple', false),
          throwsA(isA<ArgumentError>().having((e) => e.message, 'message',
              "Path parameter 'id' must not be '.' or '..'")),
        );
      });
    }

    test('bhv serializationparam 072 a value merely containing dots is a normal path segment', () {
      expect(serializeStyled('id', 'a..b', 'path', 'string', '', 'simple', false),
          equals('a..b'));
      expect(serializeStyled('id', '.hidden', 'path', 'string', '', 'simple', false),
          equals('.hidden'));
    });

    // N3/W3 parity: `format: date` path parameters must emit a date-only
    // string (YYYY-MM-DD), not a full ISO datetime. Dart has only
    // `DateTime`, so the codegen routes such params through
    // `stringifyDate` to strip the time component before path-encoding.
    group('format:date stringifyDate helper', () {
      test('bhv serializationobject 044 UTC DateTime returns YYYY-MM-DD', () {
        final date = DateTime.utc(2024, 1, 15, 14, 30, 45);
        expect(stringifyDate(date), equals('2024-01-15'));
      });

      test('bhv serializationparam 110 midnight UTC DateTime returns YYYY-MM-DD', () {
        final date = DateTime.utc(2024, 1, 15);
        expect(stringifyDate(date), equals('2024-01-15'));
      });

      test('bhv serializationparam 027 a date at a day and year boundary still emits date-only', () {
        expect(stringifyDate(DateTime.utc(2025, 12, 31, 23, 59, 59)), equals('2025-12-31'));
        expect(stringifyDate(DateTime.utc(2026, 1, 1)), equals('2026-01-01'));
      });
    });

    // OAS `allowReserved: true` — reserved query encoding parity. Reserved
    // characters must pass through literally, but everything else (space,
    // control, non-ASCII) must still be percent-encoded, and a space must
    // yield `%20`, never `+`.
    group('allowReserved query encoding', () {
      test('bhv serializationparam 002 allowReserved leaves reserved characters literal but still encodes others',
          () {
        expect(encodeQueryAllowingReserved('k=v&x=1;2'), equals('k=v&x=1;2'));
        expect(encodeQueryAllowingReserved('a b'), equals('a%20b'));
      });

      test('bhv serializationparam 080 reserved characters left literal, other characters still encoded',
          () {
        expect(encodeQueryAllowingReserved('v1.0/beta:rc1'),
            equals('v1.0/beta:rc1'));
        // Space is illegal in a URL and must still be percent-encoded even
        // when reserved characters are preserved.
        expect(encodeQueryAllowingReserved('a b:c'), equals('a%20b:c'));
      });

      test('bhv serializationparam 068 only the query-legal reserved set stays literal; # [ ] are encoded',
          () {
        expect(
            encodeQueryAllowingReserved(
                "a:b/c?d[e]f@g!h\$i&j'k(l)m*n+o,p;q=r~s#t u"),
            equals("a:b/c?d%5Be%5Df@g!h\$i&j'k(l)m*n+o,p;q=r~s%23t%20u"));
      });

      test('bhv serializationparam 003 non-ASCII characters are still percent-encoded as UTF-8', () {
        expect(encodeQueryAllowingReserved('é/日'), equals('%C3%A9/%E6%97%A5'));
      });

      test('bhv serializationparam 060 maybeAllowReserved wraps only when allowReserved is true', () {
        expect(maybeAllowReserved('plain', false), equals('plain'));
        final wrapped = maybeAllowReserved('v1/beta', true);
        expect(wrapped, isA<AllowReservedValue>());
        expect((wrapped as AllowReservedValue).value, equals('v1/beta'));
        expect(maybeAllowReserved(null, true), isNull);
      });
    });
  });

  group('encodeRfc3986QueryComponent', () {
    test('a query component keeps only the unreserved set literal', () {
      expect(encodeRfc3986QueryComponent("a~b*c!d'e(f)g h"),
          equals('a~b%2Ac%21d%27e%28f%29g%20h'));
    });

    test('bhv serializationwire 055 a form component encodes a space as plus', () {
      expect(encodeRfc3986QueryComponent("a~b*c!d'e(f)g h", spaceToPlus: true),
          equals('a~b%2Ac%21d%27e%28f%29g+h'));
    });

    test('a literal plus is always %2B', () {
      expect(encodeRfc3986QueryComponent('1+2'), equals('1%2B2'));
      expect(encodeRfc3986QueryComponent('1+2', spaceToPlus: true),
          equals('1%2B2'));
    });
  });

  group('format: byte parameters', () {
    test('bytes serialize to padded standard base64 in a query', () {
      expect(serializeStyled('fp', Uint8List.fromList([0x68, 0x69]), 'query',
          'string', '', 'form', true), equals('aGk='));
