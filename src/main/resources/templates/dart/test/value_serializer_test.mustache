    });

    // Cross-cutting `path-double-encoding`: serializeStyled must encode a
    // path segment EXACTLY ONCE. The operation template substitutes this
    // value directly (no outer re-encode), so a space must yield `%20`
    // (single-encoded) and never `%2520` (double-encoded), and `a/b` must
    // yield `a%2Fb` and never `a%252Fb`.
    test('bhv serializationparam 073 serializeStyled simple path scalar is single-encoded', () {
      final space =
          serializeStyled('p', 'a b', 'path', 'string', '', 'simple', false);
      expect(space, equals('a%20b'));
      expect(space, isNot(contains('%2520')));

      final slash =
          serializeStyled('p', 'a/b', 'path', 'string', '', 'simple', false);
      expect(slash, equals('a%2Fb'));
      expect(slash, isNot(contains('%252F')));
    });

