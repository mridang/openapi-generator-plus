  });

  group('ValueSerializer null elements and path sub-delimiters', () {
    final withNull = <Object?>['1', null, '3'];

    test('bhv serializationparam 001 a null array element becomes an empty slot in every collection format', () {
      expect(serializeValue(withNull, 'query', 'array', 'csv'), equals('1,,3'));
      expect(serializeValue(withNull, 'query', 'array', 'ssv'), equals('1  3'));
      expect(serializeValue(withNull, 'query', 'array', 'tsv'), equals('1\t\t3'));
      expect(serializeValue(withNull, 'query', 'array', 'pipes'), equals('1||3'));
      expect(
        serializeValue(withNull, 'query', 'array', 'multi'),
        equals(['1', '', '3']),
      );
      expect(serializeValue(withNull, 'header', 'array', 'csv'), equals('1,,3'));
    });

    const preserved = {
      ';': 'semicolon',
      '=': 'equals sign',
      '~': 'tilde',
      '@': 'at sign',
      '!': 'exclamation mark',
      r'$': 'dollar sign',
      '&': 'ampersand',
      "'": 'apostrophe',
      '(': 'opening parenthesis',
      ')': 'closing parenthesis',
      '*': 'asterisk',
      '+': 'plus sign',
      ',': 'comma',
      ':': 'colon',
    };
    preserved.forEach((char, name) {
      test('bhv serializationparam 071 the $name is kept literal in a path segment', () {
        expect(
          serializeValue('a${char}b', 'path', 'string', ''),
          equals('a${char}b'),
        );
      });
    });

    test('bhv serializationparam 011 an array keeps an empty slot for a null element with multi', () {
      expect(
        serializeValue([null, 'b', null], 'query', 'array', 'multi'),
        equals(['', 'b', '']),
      );
    });

    test('bhv serializationparam 032 an empty array returns an empty string for csv', () {
      expect(serializeValue(<String>[], 'query', 'array', 'csv'), equals(''));
    });

    test('bhv serializationparam 081 a semicolon is kept literal in a path segment', () {
      expect(serializeValue('a;b', 'path', 'string', ''), equals('a;b'));
    });

    test('bhv serializationparam 070 path encoding parity null returns an empty string', () {
      expect(serializeValue(null, 'path', 'string', ''), equals(''));
    });

    test('bhv serializationparam 004 an already percent-encoded value is encoded exactly once', () {
      expect(
        serializeValue('a%20b', 'path', 'string', ''),
        equals('a%2520b'),
      );
    });
  });
