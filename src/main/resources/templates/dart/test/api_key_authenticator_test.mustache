import 'package:test/test.dart';
import 'package:{{packageName}}/{{packageName}}.dart';

void main() {
  group('ApiKeyAuthenticator', () {
    test('valid header key is exposed in auth headers', () {
      final auth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'X-Api-Key',
        apiKey: 'abc123',
        location: ApiKeyLocation.header,
      );
      final headers = auth.authHeaders();
      expect(headers['X-Api-Key'], equals('abc123'));
    });

    test('valid query key is exposed in query params', () {
      final auth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'api_key',
        apiKey: 'abc123',
        location: ApiKeyLocation.query,
      );
      expect(auth.queryParams(), equals({'api_key': 'abc123'}));
    });

    test('HEADER rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () {
      // HEADER location must reject anything outside printable ASCII +
      // TAB to prevent header injection (\r\n) and silent UTF-8
      // mangling that varies per HTTP lib.
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'abc\r\nInjected: yes',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );
      expect(
        () => ApiKeyAuthenticator(
          host: '{{{basePath}}}',
          keyParamName: 'X-Api-Key',
          apiKey: 'kéy',
          location: ApiKeyLocation.header,
        ),
        throwsArgumentError,
      );
    });

    test('non-header locations accept arbitrary chars', () {
      final queryAuth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'api_key',
        apiKey: 'kéy',
        location: ApiKeyLocation.query,
      );
      expect(queryAuth.queryParams(), equals({'api_key': 'kéy'}));
    });

    test('redacts the API key in toString', () {
      // authenticator-secret-in-default-string-repr: the default toString()
      // must never expose the stored API key.
      final auth = ApiKeyAuthenticator(
        host: '{{{basePath}}}',
        keyParamName: 'X-Api-Key',
        apiKey: 'abc123',
        location: ApiKeyLocation.header,
      );
      expect(auth.toString(), isNot(contains('abc123')));
      expect(auth.toString(), contains('***'));
    });
  });
}
