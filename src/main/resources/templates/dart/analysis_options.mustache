include: package:lints/recommended.yaml

# Strict static typing, matching the other type-checked SDKs (node tsconfig
# `strict`, csharp `Nullable enable` + analyzers, php phpstan level 9): reject
# an implicit `dynamic`->T downcast, an un-inferrable type, and a raw generic,
# so a future template change that introduces one fails here as it would there.
analyzer:
  language:
    strict-casts: true
    strict-inference: true
    strict-raw-types: true

# No generated file carries an `// ignore_for_file:` directive, so every rule
# in the ruleset above applies to every file in lib/ and test/ and a new
# finding fails the build. The two rules below are the only ones turned off,
# and they are named one by one with the reason the generated shape cannot
# satisfy them.
linter:
  rules:
    # A server variable's constants take their identifiers from the enum
    # values in the spec, and all twelve SDKs expose that same name.
    constant_identifier_names: false
    # A doc comment reproduces the spec's description verbatim, and a
    # description may legitimately contain angle brackets; escaping them here
    # would change the documented text and diverge from the other eleven SDKs.
    unintended_html_in_doc_comment: false
