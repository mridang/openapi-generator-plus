/// Compiles a schema pattern, or returns null when Dart's engine cannot
/// compile it, in which case the pattern is not enforced.
RegExp? _compile(String source) {
  try {
    return RegExp(source);
  } on FormatException {
    return null;
  }
}

/// Whether a compiled pattern finds no match in [text]; a pattern that did
/// not compile never fails.
bool _mismatch(RegExp? pattern, String text) =>
    pattern != null && !pattern.hasMatch(text);
{{/dartConstraintHasPattern}}
{{#dartConstraintHasMultipleOf}}

/// Whether [value] divided by [limit] is a whole number, within 1e-9.
bool _multipleOf(num value, double limit) {
  final quotient = value / limit;
  return (quotient - quotient.roundToDouble()).abs() < 1e-9;
}
{{/dartConstraintHasMultipleOf}}

{{#dartConstraintHasMinSize}}
/// Whether a length or a size is below its minimum. A helper rather than an
/// inline comparison, since a minimum of 1 would read as an emptiness check.
bool _shorter(int size, int minimum) => size < minimum;

{{/dartConstraintHasMinSize}}
{{#dartConstraintHasMaxSize}}
/// Whether a length or a size is above its maximum.
bool _longer(int size, int maximum) => size > maximum;

{{/dartConstraintHasMaxSize}}
/// The path of the property [name] of the value at [prefix].
String _at(String prefix, String name) => '$prefix$name';

/// Throws the argument error for a violation.
Never _fail(String path, String message) =>
    throw ArgumentError('Invalid request body: $path $message');
