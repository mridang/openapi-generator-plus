/// Checks a request body against the validation keywords of its schema
/// (minLength, maxLength, pattern, minimum, maximum, exclusiveMinimum,
/// exclusiveMaximum, multipleOf, minItems, maxItems, minProperties and
/// maxProperties) and of the models it holds, before the request is sent.
///
/// `BaseApi` calls it only when `Configuration.validateConstraints` is on. It
/// is internal: the package library does not export it. A list body is
/// checked item by item; any other value that is not a model with
/// constraints passes. Throws an [ArgumentError] naming the path and the rule
/// of the first violation.
{{#hasConstraintModels}}
void validateRequestBody(Object body) {
  if (body is List<Object?>) {
    for (var i = 0; i < body.length; i++) {
      _validateValue(body[i], '[$i].');
    }
  } else {
    _validateValue(body, '');
  }
}

/// Checks one value whose path starts with [prefix]. The type is matched
/// exactly, so a model that extends another is checked by its own rules.
void _validateValue(Object? value, String prefix) {
{{#constraintModels}}
  if (value.runtimeType == {{classname}}) {
    _check{{classname}}(value as {{classname}}, prefix);
    return;
  }
{{/constraintModels}}
}
