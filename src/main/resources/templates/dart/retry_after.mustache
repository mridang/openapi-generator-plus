import 'package:http_parser/http_parser.dart';

/// The longest wait a `Retry-After` header can ask for.
const Duration maxRetryAfter = Duration(seconds: 60);

/// The `Retry-After` header of [headers] (seconds or an HTTP date, any letter
/// case of the name) as a wait capped at 60 s, or null when it is absent or
/// not understood.
Duration? retryAfterOf(Map<String, String> headers) {
  String? raw;
  for (final entry in headers.entries) {
    if (entry.key.toLowerCase() == 'retry-after') {
      raw = entry.value.trim();
      break;
    }
  }
  if (raw == null || raw.isEmpty) {
    return null;
  }
  final seconds = double.tryParse(raw);
  if (seconds != null) {
    if (seconds.isNaN || seconds < 0) {
      return null;
    }
    return seconds >= 60
        ? maxRetryAfter
        : Duration(milliseconds: (seconds * 1000).round());
  }
  final until = _tryParseHttpDate(raw);
  if (until == null) {
    return null;
  }
  final wait = until.difference(DateTime.now().toUtc());
  if (wait.isNegative) {
    return Duration.zero;
  }
  return wait > maxRetryAfter ? maxRetryAfter : wait;
}

/// Parses an HTTP date, or returns null when [value] is not one.
DateTime? _tryParseHttpDate(String value) {
  try {
    return parseHttpDate(value);
  } on FormatException {
    return null;
  }
}
