/* Reads the `Link` header of RFC 8288. A value is a comma separated list of
 * links, each an angle-bracketed URI reference followed by `;` parameters whose
 * values are tokens or quoted strings. Commas and semicolons inside the
 * brackets or inside a quoted string do not split anything. */

/// One link of the header: the URI reference and the relation types of its `rel` parameter.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) struct Link {
    pub(crate) target: String,
    pub(crate) relations: Vec<String>,
}

/// Returns the URI reference of the first link whose relation type is `next`,
/// exactly as written, or `None` when there is no `next` link. Repeated headers
/// arrive joined with a comma.
pub(crate) fn next(header: &str) -> Option<String> {
    parse(header)
        .into_iter()
        .find(|link| link.relations.iter().any(|relation| relation == "next"))
        .map(|link| link.target)
}

fn is_blank(byte: u8) -> bool {
    byte == b' ' || byte == b'\t'
}

/// Parses a header value into its links. A link that is malformed is skipped,
/// and the parse goes on with the next comma that is outside brackets and quotes.
pub(crate) fn parse(header: &str) -> Vec<Link> {
    let bytes = header.as_bytes();
    let n = bytes.len();
    let mut links = Vec::new();
    let mut i = 0;
    while i < n {
        while i < n && (is_blank(bytes[i]) || bytes[i] == b',') {
            i += 1;
        }
        if i >= n {
            break;
        }
        if bytes[i] != b'<' {
            i = skip_to_comma(bytes, i);
            continue;
        }
        let close = match header[i + 1..].find('>') {
            Some(offset) => i + 1 + offset,
            None => break,
        };
        let target = header[i + 1..close].to_string();
        i = close + 1;
        let mut relations: Vec<String> = Vec::new();
        while i < n {
            while i < n && is_blank(bytes[i]) {
                i += 1;
            }
            if i >= n || bytes[i] == b',' {
                break;
            }
            if bytes[i] != b';' {
                i = skip_to_comma(bytes, i);
                break;
            }
            i += 1;
            while i < n && is_blank(bytes[i]) {
                i += 1;
            }
            let name_start = i;
            while i < n && !b"=;, \t".contains(&bytes[i]) {
                i += 1;
            }
            let name = header[name_start..i].to_ascii_lowercase();
            let mut value: Vec<u8> = Vec::new();
            if i < n && bytes[i] == b'=' {
                i += 1;
                if i < n && bytes[i] == b'"' {
                    i += 1;
                    while i < n && bytes[i] != b'"' {
                        if bytes[i] == b'\\' && i + 1 < n {
                            i += 1;
                        }
                        value.push(bytes[i]);
                        i += 1;
                    }
                    i += 1;
                } else {
                    while i < n && !b";, \t".contains(&bytes[i]) {
                        value.push(bytes[i]);
                        i += 1;
                    }
                }
            }
            if name == "rel" && relations.is_empty() {
                let text = String::from_utf8_lossy(&value).to_ascii_lowercase();
                relations.extend(text.split_whitespace().map(str::to_string));
            }
        }
        links.push(Link { target, relations });
    }
    links
}

/// Skips to the next comma that is outside brackets and quotes, and returns its
/// index or the end.
fn skip_to_comma(bytes: &[u8], from: usize) -> usize {
    let mut quoted = false;
    let mut bracketed = false;
    let mut i = from;
    while i < bytes.len() {
        let c = bytes[i];
        if quoted {
            if c == b'\\' {
                i += 1;
            } else if c == b'"' {
                quoted = false;
            }
        } else if c == b'"' {
            quoted = true;
        } else if c == b'<' {
            bracketed = true;
        } else if c == b'>' {
            bracketed = false;
        } else if c == b',' && !bracketed {
            return i;
        }
        i += 1;
    }
    bytes.len()
}
