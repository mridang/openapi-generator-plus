use std::collections::HashMap;
use std::error::Error;
use std::fmt;
use std::panic::{catch_unwind, resume_unwind, AssertUnwindSafe};
use std::sync::Arc;

/// What a call is, handed to [`CallHook::start`].
///
/// The fields are read-only: the hook never builds one.
#[derive(Debug, Clone, PartialEq, Eq)]
#[non_exhaustive]
pub struct CallInfo {
    /// The operation id exactly as written in the specification.
    pub operation_id: String,
    /// The upper-case HTTP method.
    pub method: String,
    /// The path template of the operation without the server base path.
    pub url_template: String,
    /// The request URL without its query string and fragment.
    pub url: String,
    /// The lower-case host of the request URL, without port and without the
    /// brackets of an IPv6 literal.
    pub server_address: String,
}

/// How a call ended, handed to [`CallObserver::finish`].
#[derive(Debug, Clone, Copy)]
#[non_exhaustive]
pub struct CallOutcome<'a> {
    /// The HTTP status, or `0` when no response arrived.
    pub status_code: u16,
    /// The lower-cased response headers, or `None` when no response arrived.
    pub headers: Option<&'a HashMap<String, String>>,
    /// The very error the caller receives, or `None` on success.
    pub error: Option<&'a (dyn Error + 'static)>,
}

/// The error a [`CallObserver`] is given when the call ends without an outcome:
/// the future was dropped before it finished (native Rust cancellation), or a
/// later hook of a [`chain`] refused the call.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub struct CallCancelled;

impl fmt::Display for CallCancelled {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("the call was cancelled before it finished")
    }
}

impl Error for CallCancelled {}

/// The observer a hook returns from [`CallHook::start`]; it carries whatever
/// state the hook needs between the start and the end of the call.
pub trait CallObserver: Send {
    /// Called exactly once when the call ends, whichever way it ends: success,
    /// an error response, a network failure, a timeout, a body that cannot be
    /// encoded or decoded, or the future being dropped (reported as
    /// [`CallCancelled`]). A panic in `finish` is swallowed, so it never changes
    /// the result or the error of the call.
    fn finish(self: Box<Self>, outcome: &CallOutcome<'_>);
}

/// One small hook around every operation call. It can edit the request headers
/// before the send and observe the status or the error afterwards. Without a
/// hook nothing changes.
///
/// `start` runs once per call, however many sends happen inside it (retries, the
/// one replay after a `401`), after the headers are final: defaults, operation
/// headers, per-call headers, authentication, cookies and the propagated trace
/// context. It runs inline in the call's task, so it must not block. A header it
/// sets is on every send of the call; reuse the spelling a header already has to
/// replace it. A panic in `start` unwinds to the caller unchanged, nothing is
/// sent and `finish` is not called.
pub trait CallHook: Send + Sync {
    /// Called before the request is sent. Returns the observer to call when the
    /// call ends, or `None` to observe nothing.
    fn start(
        &self,
        info: &CallInfo,
        headers: &mut HashMap<String, String>,
    ) -> Option<Box<dyn CallObserver>>;
}

/// Combines hooks into one. The hooks start in the order given and their
/// observers finish in the reverse order. A hook that returns `None` is skipped.
pub fn chain(hooks: Vec<Arc<dyn CallHook>>) -> Arc<dyn CallHook> {
    Arc::new(ChainHook { hooks })
}

struct ChainHook {
    hooks: Vec<Arc<dyn CallHook>>,
}

struct ChainObserver {
    started: Vec<Box<dyn CallObserver>>,
}

impl CallHook for ChainHook {
    fn start(
        &self,
        info: &CallInfo,
        headers: &mut HashMap<String, String>,
    ) -> Option<Box<dyn CallObserver>> {
        let mut started: Vec<Box<dyn CallObserver>> = Vec::new();
        for hook in &self.hooks {
            match catch_unwind(AssertUnwindSafe(|| hook.start(info, &mut *headers))) {
                Ok(Some(observer)) => started.push(observer),
                Ok(None) => {}
                Err(refusal) => {
                    /* The hooks that already started are finished before the
                     * refusal reaches the caller. */
                    finish_all(
                        started,
                        &CallOutcome { status_code: 0, headers: None, error: Some(&CallCancelled) },
                    );
                    resume_unwind(refusal);
                }
            }
        }
        if started.is_empty() {
            None
        } else {
            Some(Box::new(ChainObserver { started }))
        }
    }
}

impl CallObserver for ChainObserver {
    fn finish(self: Box<Self>, outcome: &CallOutcome<'_>) {
        finish_all(self.started, outcome);
    }
}

/// Finishes the observers in reverse order; one that panics never stops the
/// others.
fn finish_all(observers: Vec<Box<dyn CallObserver>>, outcome: &CallOutcome<'_>) {
    for observer in observers.into_iter().rev() {
        finish_quietly(observer, outcome);
    }
}

/// Finishes an observer; a panic in it never replaces the result or the error of
/// the call.
fn finish_quietly(observer: Box<dyn CallObserver>, outcome: &CallOutcome<'_>) {
    let _ = catch_unwind(AssertUnwindSafe(|| observer.finish(outcome)));
}

/// The hook state of one call: the observer `start` returned and the response
/// that arrived. It finishes the observer exactly once, either through
/// [`CallScope::finish`] or, when the future is dropped first, from `Drop`.
pub(crate) struct CallScope {
    hooked: bool,
    observer: Option<Box<dyn CallObserver>>,
    response: Option<(u16, HashMap<String, String>)>,
}

impl CallScope {
    pub(crate) fn new() -> Self {
        Self { hooked: false, observer: None, response: None }
    }

    /// Whether a hook is set for this call.
    pub(crate) fn is_hooked(&self) -> bool {
        self.hooked
    }

    /// Calls the hook, when one is set. `info` is only built when it is.
    pub(crate) fn begin(
        &mut self,
        hook: Option<&Arc<dyn CallHook>>,
        headers: &mut HashMap<String, String>,
        info: impl FnOnce() -> CallInfo,
    ) {
        if let Some(hook) = hook {
            self.hooked = true;
            let info = info();
            self.observer = hook.start(&info, headers);
        }
    }

    /// Remembers the response that arrived, with its header names lower-cased.
    pub(crate) fn record_response(&mut self, status_code: u16, headers: &HashMap<String, String>) {
        if self.observer.is_some() {
            let lowered = headers
                .iter()
                .map(|(name, value)| (name.to_ascii_lowercase(), value.clone()))
                .collect();
            self.response = Some((status_code, lowered));
        }
    }

    /// Finishes the observer with the result the caller is about to receive.
    pub(crate) fn finish<T>(&mut self, result: &Result<T, Box<dyn Error + Send + Sync>>) {
        if let Some(observer) = self.observer.take() {
            let (status_code, headers) = match &self.response {
                Some((status, headers)) => (*status, Some(headers)),
                None => (0, None),
            };
            let error: Option<&(dyn Error + 'static)> = match result {
                Ok(_) => None,
                Err(err) => Some(&**err),
            };
            finish_quietly(observer, &CallOutcome { status_code, headers, error });
        }
    }
}

impl Drop for CallScope {
    fn drop(&mut self) {
        if let Some(observer) = self.observer.take() {
            let (status_code, headers) = match &self.response {
                Some((status, headers)) => (*status, Some(headers)),
                None => (0, None),
            };
            finish_quietly(
                observer,
                &CallOutcome { status_code, headers, error: Some(&CallCancelled) },
            );
        }
    }
}

/* These tests live in-crate (rather than under tests/) because `chain` and
 * `CallScope` are reached through crate-private paths in places and the module
 * mirrors its source file, as `trace_context_util.rs` does. */
#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Mutex;

    fn info() -> CallInfo {
        CallInfo {
            operation_id: "echo_operation".to_string(),
            method: "GET".to_string(),
            url_template: "/items/{id}".to_string(),
            url: "http://localhost/items/7".to_string(),
            server_address: "localhost".to_string(),
        }
    }

    struct Recording {
        name: &'static str,
        events: Arc<Mutex<Vec<String>>>,
        silent: bool,
        refuse: bool,
    }

    struct RecordingObserver {
        name: &'static str,
        events: Arc<Mutex<Vec<String>>>,
    }

    impl CallHook for Recording {
        fn start(
            &self,
            _info: &CallInfo,
            _headers: &mut HashMap<String, String>,
        ) -> Option<Box<dyn CallObserver>> {
            if self.refuse {
                panic!("refused");
            }
            self.events.lock().unwrap().push(format!("start {}", self.name));
            if self.silent {
                return None;
            }
            Some(Box::new(RecordingObserver { name: self.name, events: self.events.clone() }))
        }
    }

    impl CallObserver for RecordingObserver {
        fn finish(self: Box<Self>, _outcome: &CallOutcome<'_>) {
            self.events.lock().unwrap().push(format!("finish {}", self.name));
        }
    }

    fn hook(name: &'static str, events: &Arc<Mutex<Vec<String>>>) -> Arc<dyn CallHook> {
        Arc::new(Recording { name, events: events.clone(), silent: false, refuse: false })
    }

    fn outcome() -> CallOutcome<'static> {
        CallOutcome { status_code: 200, headers: None, error: None }
    }

    #[test]
    fn test_bhv_hooks_020_chain_starts_in_order_and_finishes_in_reverse() {
        let events = Arc::new(Mutex::new(Vec::new()));
        let chained = chain(vec![hook("a", &events), hook("b", &events)]);

        let observer = chained.start(&info(), &mut HashMap::new()).expect("an observer");
        observer.finish(&outcome());

        assert_eq!(
            vec!["start a", "start b", "finish b", "finish a"],
            *events.lock().unwrap()
        );
    }

    #[test]
    fn test_bhv_hooks_020_chain_skips_a_hook_that_returns_nothing() {
        let events = Arc::new(Mutex::new(Vec::new()));
        let silent: Arc<dyn CallHook> = Arc::new(Recording {
            name: "quiet",
            events: events.clone(),
            silent: true,
            refuse: false,
        });

        let observer = chain(vec![silent.clone(), hook("a", &events), silent.clone()])
            .start(&info(), &mut HashMap::new())
            .expect("an observer");
        observer.finish(&outcome());

        assert_eq!(
            vec!["start quiet", "start a", "start quiet", "finish a"],
            *events.lock().unwrap()
        );
        assert!(chain(vec![silent]).start(&info(), &mut HashMap::new()).is_none());
    }

    #[test]
    fn test_bhv_hooks_020_chain_shares_the_headers_between_the_hooks() {
        struct Setter;
        impl CallHook for Setter {
            fn start(
                &self,
                _info: &CallInfo,
                headers: &mut HashMap<String, String>,
            ) -> Option<Box<dyn CallObserver>> {
                headers.insert("X-First".to_string(), "1".to_string());
                None
            }
        }
        struct Reader(Arc<Mutex<Option<String>>>);
        impl CallHook for Reader {
            fn start(
                &self,
                _info: &CallInfo,
                headers: &mut HashMap<String, String>,
            ) -> Option<Box<dyn CallObserver>> {
                *self.0.lock().unwrap() = headers.get("X-First").cloned();
                None
            }
        }
        let seen = Arc::new(Mutex::new(None));

        chain(vec![Arc::new(Setter), Arc::new(Reader(seen.clone()))])
            .start(&info(), &mut HashMap::new());

        assert_eq!(Some("1".to_string()), *seen.lock().unwrap());
    }

    #[test]
    fn test_bhv_hooks_020_a_refusing_start_finishes_the_earlier_hooks_and_is_rethrown() {
        let events = Arc::new(Mutex::new(Vec::new()));
        let refusing: Arc<dyn CallHook> = Arc::new(Recording {
            name: "refuser",
            events: events.clone(),
            silent: false,
            refuse: true,
        });
        let chained = chain(vec![hook("a", &events), refusing, hook("b", &events)]);

        let caught = catch_unwind(AssertUnwindSafe(|| chained.start(&info(), &mut HashMap::new())));

        assert!(caught.is_err(), "the refusal reaches the caller");
        assert_eq!(vec!["start a", "finish a"], *events.lock().unwrap());
    }

    #[test]
    fn test_bhv_hooks_019_a_panic_in_finish_is_swallowed_and_the_others_still_finish() {
        struct Panicking;
        impl CallObserver for Panicking {
            fn finish(self: Box<Self>, _outcome: &CallOutcome<'_>) {
                panic!("finish failed");
            }
        }
        struct PanickingHook;
        impl CallHook for PanickingHook {
            fn start(
                &self,
                _info: &CallInfo,
                _headers: &mut HashMap<String, String>,
            ) -> Option<Box<dyn CallObserver>> {
                Some(Box::new(Panicking))
            }
        }
        let events = Arc::new(Mutex::new(Vec::new()));
        let chained = chain(vec![hook("a", &events), Arc::new(PanickingHook)]);

        let observer = chained.start(&info(), &mut HashMap::new()).expect("an observer");
        observer.finish(&outcome());

        assert_eq!(vec!["start a", "finish a"], *events.lock().unwrap());
    }

    #[test]
    fn test_bhv_hooks_015_a_scope_dropped_before_the_call_ends_finishes_as_cancelled() {
        struct Capture(Arc<Mutex<Vec<String>>>);
        impl CallObserver for Capture {
            fn finish(self: Box<Self>, outcome: &CallOutcome<'_>) {
                let error = outcome.error.map(|e| e.to_string()).unwrap_or_default();
                self.0.lock().unwrap().push(format!("{} {}", outcome.status_code, error));
            }
        }
        struct CaptureHook(Arc<Mutex<Vec<String>>>);
        impl CallHook for CaptureHook {
            fn start(
                &self,
                _info: &CallInfo,
                _headers: &mut HashMap<String, String>,
            ) -> Option<Box<dyn CallObserver>> {
                Some(Box::new(Capture(self.0.clone())))
            }
        }
        let seen = Arc::new(Mutex::new(Vec::new()));
        let hook: Arc<dyn CallHook> = Arc::new(CaptureHook(seen.clone()));

        let mut scope = CallScope::new();
        scope.begin(Some(&hook), &mut HashMap::new(), info);
        drop(scope);

        assert_eq!(
            vec![format!("0 {}", CallCancelled)],
            *seen.lock().unwrap()
        );
    }
}
