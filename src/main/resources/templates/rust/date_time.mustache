// SDK-owned `format: date-time` value. A newtype over chrono's fixed-offset
// date-time that owns its own `Serialize`/`Deserialize`, so the canonical wire
// form is produced in EVERY position the type appears (struct fields,
// `Option`, `Vec`, `HashSet`, map values, oneOf/anyOf variants and top-level
// JSON bodies) without any per-field `serde(with = ...)` attribute. chrono's own
// serde impl cannot be used: it writes a UTC value with the `Z` designator and
// a variable-width fraction.

use std::fmt;
use std::ops::Deref;
use std::str::FromStr;

use serde::de::{self, Visitor};
use serde::{Deserialize, Deserializer, Serialize, Serializer};

/// `chrono` format string for the canonical `format: date-time` wire form.
///
/// A fixed three-digit millisecond fraction and a numeric offset (rendering a
/// zero offset as `+00:00`, never the `Z` designator), e.g.
/// `2024-01-01T12:30:45.000+00:00`. All SDKs emit this exact shape so a value
/// serialises to identical bytes in every language.
///
/// Three digits (not a variable 0/3/6/9 fraction) because millisecond
/// precision is the cross-SDK common denominator, so any sub-millisecond
/// component is truncated on encode. The `%:z` specifier is what forbids the
/// `Z` form: chrono's default RFC 3339 output emits `Z` for UTC and a variable
/// fraction, and would diverge from the other SDKs.
const WIRE_FORMAT: &str = "%Y-%m-%dT%H:%M:%S%.3f%:z";

/// A `format: date-time` value.
///
/// Wraps a `chrono::DateTime<chrono::FixedOffset>` so a non-UTC offset survives
/// a round trip instead of being normalised to UTC. It serialises (and
/// displays) in the canonical wire form `YYYY-MM-DDTHH:MM:SS.mmm±HH:MM`: a
/// numeric offset (`+00:00` for UTC, never `Z`) and a fixed three-digit
/// millisecond fraction, with any finer precision truncated.
///
/// Deserialisation is lenient: any RFC 3339 date-time is accepted, including the
/// `Z` designator, a numeric offset and a fraction of any width (0, 3, 6 or 9
/// digits).
///
/// The wrapper dereferences to the inner `chrono::DateTime`, so chrono's
/// accessors are available. Note that chrono's own `to_rfc3339` formatter emits
/// `Z` for UTC; use `to_string` (or serialise the value) to get the canonical
/// wire form.
///
/// ```rust
/// # use {{packageName}}::date_time::DateTime;
/// let instant: DateTime = "2024-01-01T12:30:45Z".parse().unwrap();
/// assert_eq!(instant.to_string(), "2024-01-01T12:30:45.000+00:00");
/// assert_eq!(
///     serde_json::to_string(&instant).unwrap(),
///     "\"2024-01-01T12:30:45.000+00:00\""
/// );
/// ```
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct DateTime(chrono::DateTime<chrono::FixedOffset>);

impl DateTime {
    /// Wraps a fixed-offset chrono date-time.
    pub fn new(value: chrono::DateTime<chrono::FixedOffset>) -> Self {
        DateTime(value)
    }

    /// Returns the wrapped chrono date-time.
    pub fn into_inner(self) -> chrono::DateTime<chrono::FixedOffset> {
        self.0
    }
}

impl Default for DateTime {
    /// The Unix epoch (`1970-01-01T00:00:00.000+00:00`).
    fn default() -> Self {
        DateTime(chrono::DateTime::<chrono::Utc>::UNIX_EPOCH.fixed_offset())
    }
}

impl Deref for DateTime {
    type Target = chrono::DateTime<chrono::FixedOffset>;

    fn deref(&self) -> &Self::Target {
        &self.0
    }
}

impl fmt::Display for DateTime {
    /// Writes the canonical wire form.
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        fmt::Display::fmt(&self.0.format(WIRE_FORMAT), f)
    }
}

impl FromStr for DateTime {
    type Err = chrono::ParseError;

    /// Parses any RFC 3339 date-time (`Z` or a numeric offset, with or without
    /// a fractional second).
    fn from_str(text: &str) -> Result<Self, Self::Err> {
        chrono::DateTime::parse_from_rfc3339(text).map(DateTime)
    }
}

impl From<chrono::DateTime<chrono::FixedOffset>> for DateTime {
    fn from(value: chrono::DateTime<chrono::FixedOffset>) -> Self {
        DateTime(value)
    }
}

impl From<chrono::DateTime<chrono::Utc>> for DateTime {
    fn from(value: chrono::DateTime<chrono::Utc>) -> Self {
        DateTime(value.fixed_offset())
    }
}

impl From<DateTime> for chrono::DateTime<chrono::FixedOffset> {
    fn from(value: DateTime) -> Self {
        value.0
    }
}

impl From<DateTime> for chrono::DateTime<chrono::Utc> {
    fn from(value: DateTime) -> Self {
        value.0.with_timezone(&chrono::Utc)
    }
}

impl Serialize for DateTime {
    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        serializer.collect_str(self)
    }
}

/// Visitor that decodes a JSON string into a `DateTime`.
struct DateTimeVisitor;

impl Visitor<'_> for DateTimeVisitor {
    type Value = DateTime;

    fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("an RFC 3339 date-time string")
    }

    fn visit_str<E: de::Error>(self, value: &str) -> Result<DateTime, E> {
        value
            .parse::<DateTime>()
            .map_err(|e| E::custom(format!("invalid date-time {value:?}: {e}")))
    }
}

impl<'de> Deserialize<'de> for DateTime {
    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        deserializer.deserialize_str(DateTimeVisitor)
    }
}

#[cfg(test)]
mod tests {
    use super::DateTime;
    use std::collections::{BTreeMap, HashMap, HashSet};

    fn instant(text: &str) -> DateTime {
        text.parse().expect("reference instant must parse")
    }

    #[test]
    fn test_utc_serializes_with_numeric_offset_never_z() {
        let result = instant("2024-01-01T12:30:45Z").to_string();
        assert_eq!(result, "2024-01-01T12:30:45.000+00:00");
        assert!(!result.ends_with('Z'), "must not use the Z designator: {result}");
    }

    #[test]
    fn test_positive_and_negative_offsets_preserved() {
        assert_eq!(
            instant("2024-01-01T12:30:45+05:30").to_string(),
            "2024-01-01T12:30:45.000+05:30"
        );
        assert_eq!(
            instant("2024-01-01T12:30:45-08:00").to_string(),
            "2024-01-01T12:30:45.000-08:00"
        );
    }

    #[test]
    fn test_fraction_is_fixed_three_digits_and_truncated() {
        assert_eq!(
            instant("2024-01-01T12:30:45+00:00").to_string(),
            "2024-01-01T12:30:45.000+00:00"
        );
        assert_eq!(
            instant("2024-01-01T12:30:45.123+00:00").to_string(),
            "2024-01-01T12:30:45.123+00:00"
        );
        assert_eq!(
            instant("2024-01-01T12:30:45.123456789+00:00").to_string(),
            "2024-01-01T12:30:45.123+00:00"
        );
    }

    #[test]
    fn test_deserialize_is_lenient() {
        for text in [
            "2024-01-01T12:30:45Z",
            "2024-01-01T12:30:45+00:00",
            "2024-01-01T12:30:45.123Z",
            "2024-01-01T12:30:45.123456Z",
            "2024-01-01T12:30:45.123456789+00:00",
        ] {
            let json = format!("\"{text}\"");
            let parsed: DateTime = serde_json::from_str(&json)
                .unwrap_or_else(|e| panic!("{text} must deserialize: {e}"));
            assert_eq!(parsed.timestamp(), 1_704_112_245, "{text}");
        }
    }

    #[test]
    fn test_deserialize_rejects_non_date_time() {
        assert!(serde_json::from_str::<DateTime>("\"not-a-date\"").is_err());
        assert!(serde_json::from_str::<DateTime>("\"2024-01-01\"").is_err());
        assert!(serde_json::from_str::<DateTime>("12345").is_err());
    }

    #[test]
    fn test_round_trip_preserves_offset_and_instant() {
        let original = instant("2024-01-01T12:30:45.250+05:30");
        let json = serde_json::to_string(&original).expect("serialize");
        assert_eq!(json, "\"2024-01-01T12:30:45.250+05:30\"");
        let restored: DateTime = serde_json::from_str(&json).expect("deserialize");
        assert_eq!(restored, original);
        assert_eq!(restored.offset().local_minus_utc(), 5 * 3600 + 30 * 60);
    }

    #[test]
    fn test_chrono_conversions() {
        let utc: chrono::DateTime<chrono::Utc> = "2024-01-01T12:30:45Z"
            .parse()
            .expect("reference instant must parse");
        let wrapped = DateTime::from(utc);
        assert_eq!(chrono::DateTime::<chrono::Utc>::from(wrapped), utc);
        assert_eq!(wrapped.into_inner().timestamp(), utc.timestamp());
        assert_eq!(DateTime::default().to_string(), "1970-01-01T00:00:00.000+00:00");
    }

    /// The wire form must be canonical in every position, not only direct
    /// struct fields: this is the reason the type owns its serde impls.
    #[test]
    fn test_canonical_wire_form_in_every_position() {
        const CANONICAL: &str = "2024-01-01T12:30:45.000+00:00";
        let value = instant("2024-01-01T12:30:45Z");

        #[derive(serde::Serialize, serde::Deserialize)]
        struct Fields {
            required: DateTime,
            optional: Option<DateTime>,
            list: Vec<DateTime>,
            optional_list: Option<Vec<DateTime>>,
            set: HashSet<DateTime>,
            by_name: HashMap<String, DateTime>,
            sorted: BTreeMap<String, DateTime>,
        }

        let fields = Fields {
            required: value,
            optional: Some(value),
            list: vec![value],
            optional_list: Some(vec![value]),
            set: HashSet::from([value]),
            by_name: HashMap::from([("a".to_string(), value)]),
            sorted: BTreeMap::from([("a".to_string(), value)]),
        };
        let json = crate::object_serializer::serialize(&fields).expect("serialize failed");
        let parsed: serde_json::Value = serde_json::from_str(&json).expect("valid JSON");
        let expect_canonical = |v: &serde_json::Value| assert_eq!(v, CANONICAL);
        expect_canonical(&parsed["required"]);
        expect_canonical(&parsed["optional"]);
        expect_canonical(&parsed["list"][0]);
        expect_canonical(&parsed["optional_list"][0]);
        expect_canonical(&parsed["set"][0]);
        expect_canonical(&parsed["by_name"]["a"]);
        expect_canonical(&parsed["sorted"]["a"]);
        assert!(!json.contains('Z'), "no Z designator anywhere: {json}");

        // Top-level bodies (a `Vec<DateTime>` or map response/request).
        let list = Vec::from([value]);
        let body = crate::object_serializer::serialize(&list).expect("serialize failed");
        assert_eq!(body, format!("[\"{CANONICAL}\"]"));
        let map_body = crate::object_serializer::serialize(&HashMap::from([("k", value)]))
            .expect("serialize failed");
        assert_eq!(map_body, r#"{"k":"2024-01-01T12:30:45.000+00:00"}"#);

        // Absent optionals decode to `None` without any `default` attribute.
        let restored: Fields = serde_json::from_str(
            r#"{"required":"2024-01-01T12:30:45Z","list":[],"set":[],"by_name":{},"sorted":{}}"#,
        )
        .expect("deserialize failed");
        assert_eq!(restored.optional, None);
        assert_eq!(restored.optional_list, None);
    }

    /// Parameter path: `stringify` (used for query, header, cookie and
    /// multipart text values) yields the canonical string, and an array
    /// parameter's items are canonical individually.
    #[test]
    fn test_parameter_path_emits_canonical_string() {
        let value = instant("2024-01-01T12:30:45Z");
        assert_eq!(
            crate::object_serializer::stringify(&value),
            "2024-01-01T12:30:45.000+00:00"
        );
        let items: Vec<String> = [value, instant("2024-01-01T12:30:45.5+05:30")]
            .iter()
            .map(crate::object_serializer::stringify)
            .collect();
        assert_eq!(
            items,
            ["2024-01-01T12:30:45.000+00:00", "2024-01-01T12:30:45.500+05:30"]
        );
    }
}
