    /* -- serialize_styled: form -- */

    #[test]
    fn test_bhv_serializationparam_105_serialize_styled_form_scalar_and_an_address_is_canonical_text() {
        let result = super::serialize_styled(
            "color", Some("blue"), None, "query", "string", "", "form", true,
        );
        assert_eq!(unwrap_single(result), "blue");

        assert_eq!(serde_json::to_value(std::net::Ipv4Addr::new(192, 0, 2, 1)).expect("encode"), "192.0.2.1");
        assert_eq!(
            serde_json::to_value("2001:0DB8::1".parse::<std::net::Ipv6Addr>().expect("parse")).expect("encode"),
            "2001:db8::1"
        );
    }

    #[test]
    fn test_bhv_serializationparam_106_path_with_null_style_behaves_like_simple_and_a_decimal_is_plain() {
        let null_style = super::serialize_styled("id", Some("5"), None, "path", "string", "", "", false);
        let simple = super::serialize_styled("id", Some("5"), None, "path", "string", "", "simple", false);
        assert_eq!(unwrap_single(null_style), "5");
        assert_eq!(unwrap_single(simple), "5");
        let digits = "12345678901234567890.12345678";
        let decimal = rust_decimal::Decimal::from_str_exact(digits).expect("exact");
        assert_eq!(crate::object_serializer::stringify(&decimal), digits);
        assert_eq!(
            crate::object_serializer::stringify(&rust_decimal::Decimal::from_str_exact("0.00000001").expect("exact")),
            "0.00000001"
        );
    }

