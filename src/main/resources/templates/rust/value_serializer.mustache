    #[test]
    fn test_bhv_serializationparam_111_serialize_deep_object() {
        let mut obj = std::collections::HashMap::new();
        obj.insert("status".to_string(), "active".to_string());
        obj.insert("type".to_string(), "dog".to_string());

        let result = super::serialize_deep_object("filter", &obj);
        let result_map: std::collections::HashMap<String, String> = result.into_iter().collect();

        assert_eq!(result_map.get("filter[status]").unwrap(), "active");
        assert_eq!(result_map.get("filter[type]").unwrap(), "dog");
    }

    #[test]
    fn test_bhv_serializationparam_017_serialize_deep_object_sorts_keys() {
        let mut obj = std::collections::HashMap::new();
        for key in ["m", "z", "a", "q", "b"] {
            obj.insert(key.to_string(), "v".to_string());
        }
        for _ in 0..20 {
            let names: Vec<String> = super::serialize_deep_object("f", &obj)
                .into_iter()
                .map(|(k, _)| k)
                .collect();
            assert_eq!(names, vec!["f[a]", "f[b]", "f[m]", "f[q]", "f[z]"]);
        }
    }

