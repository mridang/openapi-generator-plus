use std::collections::HashMap;


/// Represents a serialized parameter value that may be a single value or
/// multiple values (for exploded form-style query parameters).
#[derive(Debug, Clone)]
pub enum SerializedValue {
    /// A single serialized string value.
    Single(String),
    /// Multiple values for the same key (form style with explode=true).
    Multi(Vec<String>),
}

/// Percent-encodes a value for use as a URL path segment.
///
/// Encodes characters that are not allowed in a URI path segment per RFC 3986,
/// but preserves the sub-delimiters (including `;`, `=`, `,`, `:`, etc.) that
/// OAS 3.0 matrix/label/simple styles use as structural separators in the
/// styled value: `; = , : @ ! $ & ' ( ) * +`.
/// Percent-encodes every byte that is not an ASCII letter or digit, so a cookie
/// parameter value carrying a model's JSON arrives fully encoded.
fn encode_cookie_value(s: &str) -> String {
    s.bytes()
        .map(|b| {
            if b.is_ascii_alphanumeric() {
                (b as char).to_string()
            } else {
                format!("%{:02X}", b)
            }
        })
        .collect()
}

fn encode_path_segment(s: &str) -> String {
    urlencoding::encode(s)
        .into_owned()
        .replace("%3B", ";")
        .replace("%3D", "=")
        .replace("%2C", ",")
        .replace("%3A", ":")
        .replace("%40", "@")
        .replace("%21", "!")
        .replace("%24", "$")
        .replace("%26", "&")
        .replace("%27", "'")
        .replace("%28", "(")
        .replace("%29", ")")
        .replace("%2A", "*")
        .replace("%2B", "+")
}

/// Percent-encodes a single path-array ITEM before it is joined with the `,`
/// structural separator (OAS `simple`/`label`/`matrix` non-explode styles).
///
/// Per RFC 6570 a literal `,` inside an item value is preserved (not escaped),
/// matching the other 11 SDKs. For example `["a,b", "c"]` serializes to
/// `a,b,c`. Every per-item value is encoded BEFORE the join.
fn encode_path_array_item(s: &str) -> String {
    encode_path_segment(s)
}

/// Percent-encodes a query value while leaving the RFC 3986 query-legal reserved
/// characters literal (OAS `allowReserved: true`).
///
/// This is the reserved-preserving variant of the query encoder used by
/// `base_api::build_query_string` (the `urlencoding` crate). Only the reserved
/// characters RFC 3986 section 3.4 permits inside a query component,
/// `: / ? @ ! $ & ' ( ) * + , ; =`, are restored after `urlencoding::encode`
/// over-encodes them. `#` (the fragment delimiter, which would truncate the
/// query), `[` and `]` (not allowed in a query) stay percent-encoded as `%23`,
/// `%5B` and `%5D`, as does everything else that is not unreserved: spaces
/// (`%20`), control characters and non-ASCII.
///
/// The string returned here is the contract. The transport's URL parser (the
/// WHATWG-conformant `url` crate behind reqwest) then rewrites a literal `'`
/// to `%27`; that is a documented, value-preserving exception that the SDK
/// does not try to defeat.
///
/// `~` is left untouched: the `urlencoding` crate treats it as RFC 3986
/// unreserved and never encodes it, so no restore is needed (unlike Java's
/// `URLEncoder`).
pub fn encode_query_allowing_reserved(s: &str) -> String {
    urlencoding::encode(s)
        .into_owned()
        .replace("%3A", ":")
        .replace("%2F", "/")
        .replace("%3F", "?")
        .replace("%40", "@")
        .replace("%21", "!")
        .replace("%24", "$")
        .replace("%26", "&")
        .replace("%27", "'")
        .replace("%28", "(")
        .replace("%29", ")")
        .replace("%2A", "*")
        .replace("%2B", "+")
        .replace("%2C", ",")
        .replace("%3B", ";")
        .replace("%3D", "=")
}

/// Turns the reserved characters of an already path-encoded value back into
/// their literal form, for a path parameter declared with `allowReserved: true`
/// (OAS 3.2).
///
/// `encoded` is the output of the normal path-segment encoding. The escapes
/// `%2F %3A %40 %21 %24 %26 %27 %28 %29 %2A %2B %2C %3B %3D` (hex digits in
/// either case) become `/ : @ ! $ & ' ( ) * + , ; =`. Every other escape is
/// kept, so `?`, `#`, `[`, `]`, a space and a literal `%` (as `%25`) stay
/// encoded, and a value the caller had already percent-encoded (`%2F`, sent as
/// `%252F`) is not decoded.
#[must_use]
pub fn allow_reserved_in_path(encoded: &str) -> String {
    const RESERVED: &[u8] = b"/:@!$&'()*+,;=";
    let hex = |b: u8| char::from(b).to_digit(16);
    let bytes = encoded.as_bytes();
    let mut out: Vec<u8> = Vec::with_capacity(bytes.len());
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == b'%' && i + 2 < bytes.len() {
            if let (Some(high), Some(low)) = (hex(bytes[i + 1]), hex(bytes[i + 2])) {
                if let Ok(byte) = u8::try_from(high * 16 + low) {
                    if RESERVED.contains(&byte) {
                        out.push(byte);
                        i += 3;
                        continue;
                    }
                }
            }
        }
        out.push(bytes[i]);
        i += 1;
    }
    /* Only ASCII escapes were replaced by ASCII bytes, so the bytes are still
     * the valid UTF-8 they started as and the lossy conversion changes nothing. */
    String::from_utf8_lossy(&out).into_owned()
}

/// Returns whether every character of `value` is an RFC 6265 cookie-octet
/// (`%x21 / %x23-2B / %x2D-3A / %x3C-5B / %x5D-7E`).
fn is_cookie_octets(value: &str) -> bool {
    value.chars().all(|c| {
        let o = u32::from(c);
        o == 0x21
            || (0x23..=0x2B).contains(&o)
            || (0x2D..=0x3A).contains(&o)
            || (0x3C..=0x5B).contains(&o)
            || (0x5D..=0x7E).contains(&o)
    })
}

/// Builds the `Cookie` header fragment for one OAS 3.2 `style: cookie`
/// parameter.
///
/// A missing value, an empty array and an empty object give the empty string
/// (nothing is sent). A scalar gives `name=value`. An array gives
/// `name=a,b,c`, or `name=a; name=b; name=c` with `explode`. A model or map
/// gives `name=k1,v1,k2,v2`, or `k1=v1; k2=v2` with `explode`, its properties
/// in declaration order with null ones left out. Values are written as the
/// styled serializer writes them and are never percent-encoded.
///
/// # Errors
///
/// Returns `ConfigurationError::InvalidArgument` naming the parameter when a
/// value, item, key or property value holds a character outside the RFC 6265
/// cookie-octet set, and a `SerializationError` when a property of an object
/// is itself a nested value.
pub fn cookie_pairs<T: serde::Serialize + 'static>(
    name: &str,
    value: Option<&T>,
    explode: bool,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    let Some(value) = value else {
        return Ok(String::new());
    };
    let check = |text: &str| -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
        if is_cookie_octets(text) {
            Ok(())
        } else {
            Err(Box::new(crate::errors::configuration_error::ConfigurationError::InvalidArgument(format!(
                "Cookie value for '{name}' contains characters forbidden by RFC 6265"
            ))))
        }
    };
    if let Some(pairs) = crate::object_serializer::object_param_pairs(value)? {
        for (key, text) in &pairs {
            check(key)?;
            check(text)?;
        }
        if pairs.is_empty() {
            return Ok(String::new());
        }
        if explode {
            return Ok(pairs
                .iter()
                .map(|(key, text)| format!("{key}={text}"))
                .collect::<Vec<_>>()
                .join("; "));
        }
        let joined = pairs
            .into_iter()
            .flat_map(|(key, text)| [key, text])
            .collect::<Vec<_>>()
            .join(",");
        return Ok(format!("{name}={joined}"));
    }
    if crate::object_serializer::scalar_override(value).is_none() {
        if let Ok(serde_json::Value::Array(items)) = serde_json::to_value(value) {
            let texts: Vec<String> = items.iter().map(crate::object_serializer::stringify).collect();
            for text in &texts {
                check(text)?;
            }
            if texts.is_empty() {
                return Ok(String::new());
            }
            if explode {
                return Ok(texts
                    .iter()
                    .map(|text| format!("{name}={text}"))
                    .collect::<Vec<_>>()
                    .join("; "));
            }
            return Ok(format!("{name}={}", texts.join(",")));
        }
    }
    let text = crate::object_serializer::stringify(value);
    check(&text)?;
    Ok(format!("{name}={text}"))
}

/// Serializes a value for use in an HTTP request parameter.
///
/// The serialization strategy depends on the `location`: for `path`, scalar
/// values are stringified and URL-encoded; for `query`, a missing value is
/// omitted (returns `None`); for any other location a missing value becomes the
/// empty string.
///
/// # Arguments
///
/// * `value` - The value to serialize, or `None`
/// * `location` - Where the parameter appears: "path", "query", "header", or "cookie"
/// * `schema_type` - The OpenAPI schema type (currently unused, reserved for
///   future format-aware serialization)
/// * `collection_format` - The collection format: "multi", "csv", "ssv", "tsv",
///   or "pipes" (only relevant for query parameters)
pub fn serialize_value(
    value: Option<&str>,
    location: &str,
    _schema_type: &str,
    _collection_format: &str,
) -> Option<String> {
    match value {
        None => serialize_nil(location),
        Some(val) => {
            if location == "path" {
                Some(encode_path_segment(val))
            } else if location == "cookie" {
                Some(encode_cookie_value(val))
            } else {
                Some(val.to_string())
            }
        }
    }
}

/// Serializes an array value for use in an HTTP request parameter.
///
/// For `query`, the items are formatted according to `collection_format`; for
/// any other location they are joined with commas.
pub fn serialize_array_value(
    items: &[String],
    location: &str,
    collection_format: &str,
) -> Option<SerializedValue> {
    if location == "query" {
        Some(serialize_query_array(items, collection_format))
    } else {
        Some(SerializedValue::Single(items.join(",")))
    }
}

/// Serializes a deepObject-style query parameter.
///
/// Produces a list of flattened `(param_name[key], value)` pairs. A hash map
/// has no declared order, so the keys are sorted lexicographically to give the
/// same bytes on every run.
pub fn serialize_deep_object(
    param_name: &str,
    value: &HashMap<String, String>,
) -> Vec<(String, String)> {
    let mut keys: Vec<&String> = value.keys().collect();
    keys.sort();
    keys.into_iter()
        .map(|key| (format!("{}[{}]", param_name, key), value[key].clone()))
        .collect()
}

/// Serializes a parameter value according to OAS 3.0 style and explode rules.
///
/// # Arguments
///
/// * `param_name` - The parameter name
/// * `value` - The value to serialize, or None
/// * `location` - "path", "query", "header", "cookie"
/// * `_schema_type` - The parameter's Rust data type. Currently unused: a
///   `format: date-time` parameter is the SDK-owned `crate::date_time::DateTime`
///   newtype, whose `Serialize` impl already yields the canonical wire form
///   before it reaches this function, so no type-specific rewriting is needed.
/// * `collection_format` - Legacy collection format
/// * `style` - OAS 3.0 style (e.g. "matrix", "label", "form", "simple", "spaceDelimited", "pipeDelimited")
/// * `explode` - Whether to explode array values
pub fn serialize_styled(
    param_name: &str,
    value: Option<&str>,
    items: Option<&[String]>,
    location: &str,
    _schema_type: &str,
    _collection_format: &str,
    style: &str,
    explode: bool,
) -> Option<SerializedValue> {
    /* An empty required path value is rejected at the OPERATION layer: the
     * generated API method returns Err(ConfigurationError::InvalidArgument)
     * before ever calling this function. Per the SDK error contract a caller
     * mistake must surface as a typed Err, never a panic, so this serializer
     * does not panic on an empty path — it serializes gracefully and leaves
     * rejection to the call site (matching how go/swift validate up front). */

    /* A path value with no style behaves like `simple` and is percent-encoded
     * here; other locations pass the raw stringified value through. */
    if style.is_empty() {
        return match value {
            Some(val) if location == "path" => Some(SerializedValue::Single(encode_path_segment(val))),
            Some(val) => Some(SerializedValue::Single(val.to_string())),
            None => serialize_nil(location).map(SerializedValue::Single),
        };
    }

    let is_array = items.is_some();

    match style {
        "matrix" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                if explode {
                    /* Each item is in its own `;name=value` segment, so the
                     * structural `,` separator is not used — preserve commas. */
                    let enc: Vec<String> = if location == "path" {
                        arr.iter().map(|v| encode_path_segment(v)).collect()
                    } else {
                        arr.to_vec()
                    };
                    let parts: Vec<String> = enc
                        .iter()
                        .map(|v| format!(";{}={}", param_name, v))
                        .collect();
                    Some(SerializedValue::Single(parts.join("")))
                } else {
                    /* Items are joined with `,`; per RFC 6570 a literal `,`
                     * inside an item is preserved (not escaped). */
                    let enc: Vec<String> = if location == "path" {
                        arr.iter().map(|v| encode_path_array_item(v)).collect()
                    } else {
                        arr.to_vec()
                    };
                    Some(SerializedValue::Single(format!(";{}={}", param_name, enc.join(","))))
                }
            } else {
                match value {
                    Some(val) => {
                        let encoded = if location == "path" { encode_path_segment(val) } else { val.to_string() };
                        Some(SerializedValue::Single(format!(";{}={}", param_name, encoded)))
                    }
                    None => Some(SerializedValue::Single(format!(";{}", param_name))),
                }
            }
        }
        "label" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                if explode {
                    /* Explode joins with `.`; commas are not structural here. */
                    let enc: Vec<String> = if location == "path" {
                        arr.iter().map(|v| encode_path_segment(v)).collect()
                    } else {
                        arr.to_vec()
                    };
                    Some(SerializedValue::Single(format!(".{}", enc.join("."))))
                } else {
                    /* Non-explode joins with `,`; per RFC 6570 a literal `,`
                     * inside an item is preserved (not escaped). */
                    let enc: Vec<String> = if location == "path" {
                        arr.iter().map(|v| encode_path_array_item(v)).collect()
                    } else {
                        arr.to_vec()
                    };
                    Some(SerializedValue::Single(format!(".{}", enc.join(","))))
                }
            } else {
                match value {
                    Some(val) => {
                        let encoded = if location == "path" { encode_path_segment(val) } else { val.to_string() };
                        Some(SerializedValue::Single(format!(".{}", encoded)))
                    }
                    None => Some(SerializedValue::Single(".".to_string())),
                }
            }
        }
        "spaceDelimited" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                if explode {
                    Some(SerializedValue::Multi(arr.to_vec()))
                } else {
                    Some(SerializedValue::Single(arr.join(" ")))
                }
            } else {
                match value {
                    Some(val) => Some(SerializedValue::Single(val.to_string())),
                    None => Some(SerializedValue::Single(String::new())),
                }
            }
        }
        "pipeDelimited" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                if explode {
                    Some(SerializedValue::Multi(arr.to_vec()))
                } else {
                    Some(SerializedValue::Single(arr.join("|")))
                }
            } else {
                match value {
                    Some(val) => Some(SerializedValue::Single(val.to_string())),
                    None => Some(SerializedValue::Single(String::new())),
                }
            }
        }
        "form" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                if explode {
                    Some(SerializedValue::Multi(arr.to_vec()))
                } else {
                    Some(SerializedValue::Single(arr.join(",")))
                }
            } else {
                match value {
                    Some(val) => Some(SerializedValue::Single(val.to_string())),
                    None => Some(SerializedValue::Single(String::new())),
                }
            }
        }
        "simple" => {
            if value.is_none() && !is_array {
                return if location == "query" { None } else { Some(SerializedValue::Single(String::new())) };
            }
            if let Some(arr) = items {
                /* `simple` always joins with `,`; per RFC 6570 a literal `,`
                 * inside an item is preserved (not escaped). */
                let enc: Vec<String> = if location == "path" {
                    arr.iter().map(|v| encode_path_array_item(v)).collect()
                } else {
                    arr.to_vec()
                };
                Some(SerializedValue::Single(enc.join(",")))
            } else {
                match value {
                    Some(val) => {
                        let encoded = if location == "path" { encode_path_segment(val) } else { val.to_string() };
                        Some(SerializedValue::Single(encoded))
                    }
                    None => Some(SerializedValue::Single(String::new())),
                }
            }
        }
        _ => match value {
            Some(val) => Some(SerializedValue::Single(val.to_string())),
            None => serialize_nil(location).map(SerializedValue::Single),
        },
    }
}

/// Serializes a `content: application/json` query parameter to its JSON text.
///
/// The object serializer writes the canonical SDK wire form for every nested
/// value, so a date-time inside the JSON keeps its `format: date-time` form. The
/// text is returned unencoded; the query builder percent-encodes it once.
pub fn serialize_query_content<T: serde::Serialize>(
    value: &T,
) -> Result<String, crate::errors::serialization_error::SerializationError> {
    crate::object_serializer::serialize(value)
}

fn serialize_nil(location: &str) -> Option<String> {
    if location == "query" {
        None
    } else {
        Some(String::new())
    }
}

fn serialize_query_array(items: &[String], collection_format: &str) -> SerializedValue {
    match collection_format {
        "multi" => SerializedValue::Multi(items.to_vec()),
        "ssv" => SerializedValue::Single(items.join(" ")),
        "tsv" => SerializedValue::Single(items.join("\t")),
        "pipes" => SerializedValue::Single(items.join("|")),
        _ => SerializedValue::Single(items.join(",")),
    }
}

/* These tests live in-crate (rather than under tests/) because `value_serializer`
 * and its `SerializedValue` type are crate-private (an internal
 * parameter-style serialization detail, not part of the public API), so they
 * would otherwise be unable to reach the module from the external
 * integration-test crate. */
#[cfg(test)]
mod tests {
    use super::*;
    fn unwrap_single(val: Option<super::SerializedValue>) -> String {
        match val {
            Some(super::SerializedValue::Single(s)) => s,
            Some(super::SerializedValue::Multi(v)) => v.join(","),
            None => panic!("expected Some, got None"),
        }
    }

    fn unwrap_multi(val: Option<super::SerializedValue>) -> Vec<String> {
        match val {
            Some(super::SerializedValue::Multi(v)) => v,
            Some(super::SerializedValue::Single(s)) => vec![s],
            None => panic!("expected Some, got None"),
        }
    }

    /* -- path segment encoding -- */

    #[test]
    fn test_bhv_serializationparam_081_encode_path_segment_keeps_the_sub_delimiters_and_unreserved_set_literal() {
        let literal = ";=,:@!$&'()*+~-._";
        assert_eq!(super::encode_path_segment(literal), literal);
    }

    #[test]
    fn test_bhv_serializationparam_004_encode_path_segment_encodes_everything_else_once() {
        assert_eq!(
            super::encode_path_segment("a b/c?d#e[f]g%h"),
            "a%20b%2Fc%3Fd%23e%5Bf%5Dg%25h"
        );
        assert_eq!(super::encode_path_segment("a%20b"), "a%2520b");
        assert_eq!(super::encode_path_segment("caf\u{e9}"), "caf%C3%A9");
    }

    /* -- style: cookie and allowReserved in a path (OpenAPI 3.2) -- */

    #[test]
    fn test_bhv_serializationparam_501_cookie_pairs_writes_each_shape_unencoded() {
        let mut entries = serde_json::Map::new();
        entries.insert("k1".to_string(), serde_json::json!("v1"));
        entries.insert("k2".to_string(), serde_json::json!("v2"));
        assert_eq!(super::cookie_pairs("region", Some(&"eu"), false).unwrap(), "region=eu");
        assert_eq!(super::cookie_pairs("region", Some(&vec!["a", "b"]), false).unwrap(), "region=a,b");
        assert_eq!(super::cookie_pairs("region", Some(&vec!["a", "b"]), true).unwrap(), "region=a; region=b");
        assert_eq!(super::cookie_pairs("region", Some(&entries), false).unwrap(), "region=k1,v1,k2,v2");
        assert_eq!(super::cookie_pairs("region", Some(&entries), true).unwrap(), "k1=v1; k2=v2");
        assert_eq!(super::cookie_pairs("region", Some(&"a%2Cb"), false).unwrap(), "region=a%2Cb");
        assert_eq!(super::cookie_pairs::<String>("region", None, false).unwrap(), "");
    }

    #[test]
    fn test_bhv_serializationparam_502_cookie_pairs_rejects_a_value_outside_the_cookie_octets() {
        let errors = [
            super::cookie_pairs("region", Some(&vec!["a b"]), false).unwrap_err(),
            super::cookie_pairs("region", Some(&"a;b"), true).unwrap_err(),
            super::cookie_pairs("region", Some(&vec!["a,b"]), true).unwrap_err(),
        ];
        for err in errors {
            assert!(
                err.downcast_ref::<crate::errors::configuration_error::ConfigurationError>().is_some(),
                "expected a ConfigurationError, got: {err}"
            );
            assert!(err.to_string().contains("'region'"), "message must name the parameter: {err}");
        }
    }

    #[test]
    fn test_bhv_serializationparam_503_allow_reserved_in_path_restores_only_the_reserved_set() {
        assert_eq!(
            super::allow_reserved_in_path(&super::encode_path_segment("v1.0/beta:rc1@x")),
            "v1.0/beta:rc1@x"
        );
        assert_eq!(
            super::allow_reserved_in_path(&super::encode_path_segment("a?b#c[d]e%f g")),
            "a%3Fb%23c%5Bd%5De%25f%20g"
        );
        assert_eq!(super::allow_reserved_in_path("%2f"), "/");
    }

    #[test]
    fn test_bhv_serializationparam_072_serialize_styled_simple_path_keeps_dots_inside_a_value() {
        let result = super::serialize_styled(
            "id", Some("a.b.c"), None, "path", "string", "", "simple", false,
        );
        assert_eq!(unwrap_single(result), "a.b.c");
    }

    /* -- serialize_value by location -- */

    #[test]
    fn test_bhv_serializationparam_062_serialize_value_path_null() {
        let result = super::serialize_value(None::<&str>, "path", "string", "");
        assert_eq!(result.unwrap(), "");
    }

    #[test]
    fn test_bhv_serializationparam_066_null_returns_empty_string_in_path_location() {
        let result = super::serialize_value(None::<&str>, "path", "string", "");
        assert_eq!(result.unwrap(), "");
    }

    #[test]
    fn test_bhv_serializationparam_100_serialize_value_path_string_as_is() {
        let result = super::serialize_value(Some("hello"), "path", "string", "");
        assert_eq!(result.unwrap(), "hello");
    }

