    #[test]
    fn test_bhv_serializationparam_119_a_tilde_is_kept_literal_in_a_path_value() {
        assert_eq!(super::serialize_value(Some("a~b"), "path", "string", "").unwrap(), "a~b");
        assert_eq!(super::serialize_value(Some("~"), "path", "string", "").unwrap(), "~");
    }

