    /* ── N3/W3 parity: format:date path parameter emits YYYY-MM-DD ──
     *
     * Rust uses `String` for both `format: date` and `format: date-time`,
     * so the caller controls the wire format. The codegen does not insert
     * a date-only stringifier; the caller passes a pre-formatted
     * "YYYY-MM-DD" string and the value serializer passes it through
     * unchanged (subject to path encoding). */

    #[test]
    fn test_bhv_serializationparam_048_format_date_path_param_string_passes_through() {
        let result = super::serialize_value(Some("2024-01-15"), "path", "string", "");
        assert_eq!(result.unwrap(), "2024-01-15");
    }

    #[test]
    fn test_bhv_serializationparam_054_format_date_path_param_via_serialize_styled_simple() {
        let result = super::serialize_styled(
            "since",
            Some("2024-01-15"),
            None,
            "path",
            "string",
            "",
            "simple",
            false,
        );
        assert_eq!(unwrap_single(result), "2024-01-15");
    }

    /* UTC/midnight edge: a caller-formatted date-only string (the wire form the
     * codegen produces for a `format: date` value at midnight UTC) passes through
     * the path serializer unchanged, matching the StringifyDate UTC behaviour of
     * Go/Node/Swift/Dart. */
    #[test]
    fn test_bhv_serializationparam_028_format_date_path_param_midnight_utc_string_passes_through() {
        let result = super::serialize_value(Some("2024-01-15"), "path", "string", "");
        assert_eq!(result.unwrap(), "2024-01-15");
    }

    /* path-double-encoding: serialize_styled already percent-encodes the path
     * segment, so the operation template must NOT wrap it again. A space must
     * become %20 (never %2520) and a slash %2F (never %252F). */
    #[test]
    fn test_bhv_serializationparam_073_serialize_styled_path_encoded_exactly_once() {
        let space = super::serialize_styled(
            "id", Some("a b"), None, "path", "string", "", "simple", false,
        );
        let space = unwrap_single(space);
        assert_eq!(space, "a%20b");
        assert!(!space.contains("%2520"), "space was double-encoded: {space}");

        let slash = super::serialize_styled(
            "id", Some("a/b"), None, "path", "string", "", "simple", false,
        );
        let slash = unwrap_single(slash);
        assert_eq!(slash, "a%2Fb");
        assert!(!slash.contains("%252F"), "slash was double-encoded: {slash}");
    }

    /* The value serializer must NEVER panic on an empty path value (error
     * contract: a caller mistake is a typed Err at the call site, never a
     * panic). An empty required path is rejected at the operation layer (the
     * generated API method returns ConfigurationError::InvalidArgument before
     * reaching here); the serializer itself simply produces the empty segment
     * without panicking. */
    #[test]
    fn test_bhv_serializationparam_033_empty_string_path_param_does_not_panic() {
        let result = super::serialize_styled(
            "id", Some(""), None, "path", "string", "", "simple", false,
        );
        match result {
            Some(super::SerializedValue::Single(s)) => assert_eq!(s, ""),
            other => panic!("expected Some(Single(\"\")), got {other:?}"),
        }
    }

    /* OAS allowReserved: RFC 3986 reserved characters are sent literally, but
     * everything else (space, control chars, non-ASCII) is still percent-encoded.
     * Mirrors the Java AllowReservedTests. */
    #[test]
    fn test_bhv_serializationparam_002_encode_query_allowing_reserved_preserves_reserved_chars() {
        /* Reserved characters `/` and `:` are left literal. */
        assert_eq!(
            super::encode_query_allowing_reserved("v1.0/beta:rc1"),
            "v1.0/beta:rc1"
        );
    }

    #[test]
    fn test_bhv_serializationparam_003_encode_query_allowing_reserved_still_encodes_space() {
        /* Space is not reserved, so it is still percent-encoded, while the
         * reserved `:` between the words stays literal. */
        assert_eq!(super::encode_query_allowing_reserved("a b:c"), "a%20b:c");
    }

    #[test]
    fn test_bhv_serializationparam_080_reserved_characters_literal_other_characters_encoded() {
        /* The reserved `:`, `/`, `+` stay literal; the space and the non-ASCII
         * `e` with acute accent are percent-encoded. */
        assert_eq!(
            super::encode_query_allowing_reserved("a:b/c+d e\u{e9}"),
            "a:b/c+d%20e%C3%A9"
        );
    }

    #[test]
    fn test_bhv_serializationparam_068_encode_query_allowing_reserved_keeps_only_the_query_legal_reserved_set() {
        /* `#` would start the fragment and `[`/`]` are not legal in a query, so
         * they are percent-encoded; the rest of the reserved set stays literal. */
        assert_eq!(
            super::encode_query_allowing_reserved("a:b/c?d[e]f@g!h$i&j'k(l)m*n+o,p;q=r~s#t u"),
            "a:b/c?d%5Be%5Df@g!h$i&j'k(l)m*n+o,p;q=r~s%23t%20u"
        );
    }

    #[test]
    fn test_bhv_serializationparam_122_an_allow_reserved_value_keeps_its_reserved_characters_literal() {
        assert_eq!(
            super::encode_query_allowing_reserved(":/?@!$&'()*+,;=~"),
            ":/?@!$&'()*+,;=~"
        );
    }

    #[test]
    fn test_bhv_serialization_005_a_path_value_keeps_unreserved_and_sub_delimiters_and_encodes_the_rest() {
        let literal = ";=,:@!$&'()*+~-._";
        assert_eq!(super::encode_path_segment(literal), literal);
        assert_eq!(super::encode_path_segment("a/b c?d#e%f"), "a%2Fb%20c%3Fd%23e%25f");
    }

