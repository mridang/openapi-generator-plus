use std::collections::HashMap;
use std::error::Error;
use std::future::Future;
use std::pin::Pin;
use std::sync::Arc;
use std::time::Duration;

use crate::api_client::ApiClient;
use crate::auth::http_aware_authenticator::HttpAwareAuthenticator;
use crate::auth::oauth::oauth2_token_manager::{
    parse_expires_in, OAuth2TokenManager, MAX_EXPIRES_IN_SECONDS,
};
use crate::auth::Authenticator;
use crate::errors::oauth2_authorization_code_error::OAuth2AuthorizationCodeError;
use crate::errors::oauth2_server_error::OAuth2ServerError;
use crate::errors::oauth2_token_error::OAuth2TokenError;

/// Grant type of the device access token request (RFC 8628 section 3.4).
const DEVICE_CODE_GRANT_TYPE: &str = "urn:ietf:params:oauth:grant-type:device_code";

/// Polling interval, in seconds, when the device authorization response
/// carries none (RFC 8628 section 3.2).
const DEFAULT_POLL_INTERVAL_SECONDS: u64 = 5;

/// Seconds a `slow_down` answer adds to the polling interval (RFC 8628
/// section 3.5).
const SLOW_DOWN_INCREMENT_SECONDS: u64 = 5;

/// The device authorization response (RFC 8628 section 3.2): the codes and the
/// URI to show to the user, and how long and how often to poll.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct DeviceAuthorization {
    /// The device verification code sent back when polling.
    pub device_code: String,
    /// The code the user enters at the verification URI.
    pub user_code: String,
    /// The page where the user enters the user code.
    pub verification_uri: String,
    /// The verification URI with the user code included, when the server sent one.
    pub verification_uri_complete: Option<String>,
    /// The lifetime of the codes, in seconds.
    pub expires_in: u64,
    /// The minimum wait between polls, in seconds (5 when the server sent none).
    pub interval: u64,
}

/// Authenticator for the OAuth2 device authorization flow (RFC 8628), for a
/// public client without a secret.
///
/// Implements [`HttpAwareAuthenticator`] so that the device authorization and
/// token requests use the shared [`ApiClient`] with the same transport
/// configuration (proxy, TLS, timeouts) as regular API calls.
///
/// Usage:
///  1. Call `request_device_authorization` to get the user code and verification URI
///  2. Show them to the user
///  3. Call `poll_for_token` with the authorization to wait for the approval
///  4. Use the authenticator normally: tokens are managed automatically
pub struct OAuth2DeviceAuthorizationAuthenticator {
    host: String,
    client_id: String,
    device_authorization_url: String,
    token_url: String,
    refresh_url: String,
    scopes: Vec<String>,
    token_manager: Arc<OAuth2TokenManager>,
}

impl OAuth2DeviceAuthorizationAuthenticator {
    /// Creates a new device authorization authenticator.
    ///
    /// `host` is the API base URL, `client_id` the OAuth2 client id,
    /// `device_authorization_url` the device authorization endpoint URL,
    /// `token_url` the token endpoint URL, `scopes` the requested scopes and
    /// `refresh_url` the refresh token endpoint URL (falls back to `token_url`
    /// if empty).
    pub fn new(
        host: &str,
        client_id: &str,
        device_authorization_url: &str,
        token_url: &str,
        scopes: Vec<String>,
        refresh_url: &str,
    ) -> Self {
        let effective_refresh_url = if refresh_url.is_empty() {
            token_url.to_string()
        } else {
            refresh_url.to_string()
        };
        Self {
            host: host.to_string(),
            client_id: client_id.to_string(),
            device_authorization_url: device_authorization_url.to_string(),
            token_url: token_url.to_string(),
            refresh_url: effective_refresh_url,
            scopes,
            token_manager: Arc::new(OAuth2TokenManager::new()),
        }
    }

    /// Asks the device authorization endpoint for a device code and a user code
    /// (RFC 8628 section 3.1). Showing the user code and the verification URI
    /// to the user is the caller's job.
    ///
    /// A non-2xx answer is an [`OAuth2ServerError`]; a 2xx answer that cannot
    /// be used is an [`OAuth2TokenError`].
    pub async fn request_device_authorization(
        &self,
    ) -> Result<DeviceAuthorization, Box<dyn Error + Send + Sync>> {
        let mut params = HashMap::new();
        params.insert("client_id".to_string(), self.client_id.clone());
        if !self.scopes.is_empty() {
            params.insert("scope".to_string(), self.scopes.join(" "));
        }
        let body = self
            .token_manager
            .post_form(&self.device_authorization_url, &params)
            .await?;
        parse_device_authorization(&body)
    }

    /// Polls the token endpoint until the user approves the device (RFC 8628
    /// section 3.4), waiting the authorization's interval before each poll.
    ///
    /// `authorization_pending` keeps polling and `slow_down` adds five seconds
    /// to the interval. A success replaces the session; any other error ends
    /// polling with that [`OAuth2ServerError`]. Polling stops with an
    /// [`OAuth2TokenError`] once the authorization's `expires_in` has passed.
    pub async fn poll_for_token(
        &self,
        authorization: &DeviceAuthorization,
    ) -> Result<(), Box<dyn Error + Send + Sync>> {
        let mut params = HashMap::new();
        params.insert("grant_type".to_string(), DEVICE_CODE_GRANT_TYPE.to_string());
        params.insert("client_id".to_string(), self.client_id.clone());
        params.insert("device_code".to_string(), authorization.device_code.clone());
        /* tokio's clock, so a test with paused time does not wait. */
        let started = tokio::time::Instant::now();
        let lifetime = Duration::from_secs(authorization.expires_in);
        let mut interval = authorization.interval;
        loop {
            let wait = Duration::from_secs(interval);
            if started.elapsed() + wait > lifetime {
                return Err(Box::new(OAuth2TokenError::new(
                    "Device authorization expired before the user approved it".to_string(),
                )));
            }
            tokio::time::sleep(wait).await;
            let error = match self
                .token_manager
                .exchange(&self.token_url, &params, &HashMap::new())
                .await
            {
                Ok(_) => return Ok(()),
                Err(error) => error,
            };
            match error.downcast_ref::<OAuth2ServerError>().and_then(|e| e.code()) {
                Some("authorization_pending") => {}
                Some("slow_down") => interval += SLOW_DOWN_INCREMENT_SECONDS,
                _ => return Err(error),
            }
        }
    }
}

/// Reads a 2xx device authorization response. The messages are fixed text with
/// no parser detail, the same in every SDK.
fn parse_device_authorization(
    body: &str,
) -> Result<DeviceAuthorization, Box<dyn Error + Send + Sync>> {
    let token_error = |message: String| -> Box<dyn Error + Send + Sync> {
        Box::new(OAuth2TokenError::new(message))
    };
    let parsed: serde_json::Value = serde_json::from_str(body)
        .map_err(|_| token_error("Device authorization response is not valid JSON".to_string()))?;
    let fields = parsed
        .as_object()
        .ok_or_else(|| token_error("Device authorization response is not a JSON object".to_string()))?;
    let required = |name: &str| -> Result<String, Box<dyn Error + Send + Sync>> {
        fields
            .get(name)
            .and_then(|v| v.as_str())
            .filter(|s| !s.is_empty())
            .map(str::to_string)
            .ok_or_else(|| {
                token_error(format!(
                    "Device authorization response missing or empty {} field",
                    name
                ))
            })
    };
    let device_code = required("device_code")?;
    let user_code = required("user_code")?;
    let verification_uri = required("verification_uri")?;
    let interval = match fields.get("interval") {
        None | Some(serde_json::Value::Null) => DEFAULT_POLL_INTERVAL_SECONDS,
        Some(value) => parse_expires_in(Some(value)).min(MAX_EXPIRES_IN_SECONDS),
    };
    Ok(DeviceAuthorization {
        device_code,
        user_code,
        verification_uri,
        verification_uri_complete: fields
            .get("verification_uri_complete")
            .and_then(|v| v.as_str())
            .filter(|s| !s.is_empty())
            .map(str::to_string),
        expires_in: parse_expires_in(fields.get("expires_in")).min(MAX_EXPIRES_IN_SECONDS),
        interval,
    })
}

/// Renders the configuration. The flow has no client secret, and the tokens
/// held by the token manager are never printed.
impl std::fmt::Debug for OAuth2DeviceAuthorizationAuthenticator {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("OAuth2DeviceAuthorizationAuthenticator")
            .field("host", &self.host)
            .field("client_id", &self.client_id)
            .field("device_authorization_url", &self.device_authorization_url)
            .field("token_url", &self.token_url)
            .field("refresh_url", &self.refresh_url)
            .field("scopes", &self.scopes)
            .finish()
    }
}

impl Authenticator for OAuth2DeviceAuthorizationAuthenticator {
    fn host(&self) -> &str {
        &self.host
    }

    /// Returns the Bearer authentication header with a valid access token.
    ///
    /// Returns an empty map if [`poll_for_token`](Self::poll_for_token) has not
    /// obtained a token yet or if token refresh fails. The API client calls
    /// [`try_auth_headers`](Self::try_auth_headers), which reports those
    /// failures instead.
    fn auth_headers<'a>(
        &'a self,
    ) -> Pin<Box<dyn Future<Output = HashMap<String, String>> + Send + 'a>> {
        Box::pin(async move {
            self.try_auth_headers().await.unwrap_or_else(|_| HashMap::new())
        })
    }

    /// Returns the Bearer authentication header with a valid access token, or
    /// [`OAuth2AuthorizationCodeError::DeviceTokenNotPolled`] before
    /// [`poll_for_token`](Self::poll_for_token) has obtained a token, or the
    /// error of a failed refresh.
    fn try_auth_headers<'a>(
        &'a self,
    ) -> Pin<
        Box<
            dyn Future<
                    Output = Result<HashMap<String, String>, Box<dyn Error + Send + Sync>>,
                > + Send
                + 'a,
        >,
    > {
        Box::pin(async move {
            if !self.token_manager.is_exchanged() {
                return Err(Box::new(OAuth2AuthorizationCodeError::DeviceTokenNotPolled)
                    as Box<dyn Error + Send + Sync>);
            }
            let refresh_token = self.token_manager.refresh_token().await;
            let token = if refresh_token.is_empty() {
                /* Nothing to refresh with: serve the cached token while it is
                 * valid, and otherwise the device has to be authorized again. */
                self.token_manager.cached_access_token().await.ok_or_else(|| {
                    Box::new(OAuth2AuthorizationCodeError::DeviceTokenNotPolled)
                        as Box<dyn Error + Send + Sync>
                })?
            } else {
                let mut params = HashMap::new();
                params.insert("grant_type".to_string(), "refresh_token".to_string());
                params.insert("refresh_token".to_string(), refresh_token);
                params.insert("client_id".to_string(), self.client_id.clone());
                self.token_manager
                    .get_access_token(&self.refresh_url, &params)
                    .await?
            };
            let mut headers = HashMap::new();
            headers.insert("Authorization".to_string(), format!("Bearer {}", token));
            Ok(headers)
        })
    }

    fn inject_api_client(&self, client: Arc<dyn ApiClient>) {
        self.token_manager.ensure_api_client(client);
    }

    fn invalidate_access_token<'a>(&'a self) -> Pin<Box<dyn Future<Output = bool> + Send + 'a>> {
        Box::pin(async move {
            self.token_manager.invalidate_access_token().await;
            true
        })
    }

    fn as_http_aware_mut(&mut self) -> Option<&mut dyn HttpAwareAuthenticator> {
        Some(self)
    }
}

impl HttpAwareAuthenticator for OAuth2DeviceAuthorizationAuthenticator {
    fn set_api_client(&mut self, client: Arc<dyn ApiClient>) {
        self.token_manager.set_api_client(client);
    }
}
