/// Checks a request body against the validation keywords of its schema and of
/// every model it holds, depth first in declaration order, and returns the
/// first violation. A body that is not a model with a keyword, or a list of
/// one, passes.
pub(crate) fn validate_request_body(body: &dyn Any) -> Result<(), ConfigurationError> {
{{#constraintModels}}
    if let Some(model) = body.downcast_ref::<crate::models::{{classname}}>() {
        return model.validate("");
    }
    if let Some(models) = body.downcast_ref::<Vec<crate::models::{{classname}}>>() {
        return models.validate("");
    }
    if let Some(model) = body.downcast_ref::<Option<crate::models::{{classname}}>>() {
        return model.validate("");
    }
{{/constraintModels}}
    Ok(())
}
