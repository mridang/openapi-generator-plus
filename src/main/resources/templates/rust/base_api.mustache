        assert_eq!(1, accepted.load(std::sync::atomic::Ordering::SeqCst), "the timed-out request must be sent once");
    }

    /* Answers the first `failures` connections with 503 and every later one with 200,
     * recording the X-Request-ID header of each request in arrival order. */
    fn start_flaky_request_id_server(failures: usize) -> (String, Arc<std::sync::Mutex<Vec<String>>>) {
        let captured = Arc::new(std::sync::Mutex::new(Vec::new()));
        let recorded = captured.clone();
        let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("failed to bind");
        let base_url = format!("http://{}", listener.local_addr().expect("local address"));
        std::thread::spawn(move || {
            for (i, stream) in listener.incoming().enumerate() {
                let Ok(mut stream) = stream else { continue };
                let mut buf = [0u8; 8192];
                let n = std::io::Read::read(&mut stream, &mut buf).unwrap_or(0);
                let text = String::from_utf8_lossy(&buf[..n]).to_string();
                if let Some(line) = text.lines().find(|l| l.to_ascii_lowercase().starts_with("x-request-id:")) {
                    let value = line.split_once(':').map(|(_, v)| v.trim().to_string()).unwrap_or_default();
                    recorded.lock().unwrap().push(value);
                }
                let response = if i < failures {
                    "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
                } else {
                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"
                };
                let _ = std::io::Write::write_all(&mut stream, response.as_bytes());
            }
        });
        std::thread::sleep(std::time::Duration::from_millis(50));
        (base_url, captured)
    }

