    /* The headers each connection of an event stream was sent, and a token that is new on every request. */
    struct EventClient {
        sent: std::sync::Mutex<Vec<HashMap<String, String>>>,
    }

    impl ApiClient for EventClient {
        fn send_request(
            &self,
            _method: &str,
            _url: &str,
            _headers: &HashMap<String, String>,
            _body: Option<&RequestBody>,
        ) -> std::pin::Pin<
            Box<
                dyn std::future::Future<
                        Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>,
                    > + Send
                    + '_,
            >,
        > {
            Box::pin(async { Ok(ApiHttpResponse::new(200, String::new(), HashMap::new())) })
        }

        fn send_streaming(
            &self,
            _method: &str,
            _url: &str,
            headers: &HashMap<String, String>,
            _body: Option<&RequestBody>,
            _options: &crate::api_client::RequestOptions,
        ) -> std::pin::Pin<
            Box<
                dyn std::future::Future<
                        Output = Result<
                            crate::api_stream_response::ApiStreamResponse,
                            Box<dyn std::error::Error + Send + Sync>,
                        >,
                    > + Send
                    + '_,
            >,
        > {
            let first = {
                let mut sent = self.sent.lock().unwrap();
                sent.push(headers.clone());
                sent.len() == 1
            };
            let response = if first {
                crate::api_stream_response::ApiStreamResponse::new(
                    200,
                    HashMap::from([("content-type".to_string(), "text/event-stream".to_string())]),
                    futures_util::stream::iter(vec![Ok(bytes::Bytes::from("data: a\n\n"))]),
                )
            } else {
                crate::api_stream_response::ApiStreamResponse::new(
                    204,
                    HashMap::new(),
                    futures_util::stream::iter(Vec::new()),
                )
            };
            Box::pin(async move { Ok(response) })
        }
    }

    struct RotatingAuthenticator {
        issued: std::sync::atomic::AtomicUsize,
    }

    impl crate::auth::Authenticator for RotatingAuthenticator {
        fn host(&self) -> &str {
            "http://localhost"
        }

        fn auth_headers<'a>(
            &'a self,
        ) -> std::pin::Pin<Box<dyn std::future::Future<Output = HashMap<String, String>> + Send + 'a>> {
            Box::pin(async move {
                let issued = self.issued.fetch_add(1, std::sync::atomic::Ordering::SeqCst) + 1;
                HashMap::from([("Authorization".to_string(), format!("Bearer t{issued}"))])
            })
        }
    }

    #[tokio::test]
    async fn test_bhv_sse_013_an_sse_reconnect_rebuilds_the_headers_so_a_refreshed_token_is_the_one_sent() {
        use futures_util::StreamExt as _;
        let client = Arc::new(EventClient { sent: std::sync::Mutex::new(Vec::new()) });
        let config = ConfigurationBuilder::new().base_url("http://localhost").build();
        let rotating = Arc::new(RotatingAuthenticator { issued: std::sync::atomic::AtomicUsize::new(0) });
        let api = BaseApi::new(client.clone(), config, Some(rotating));
        let options = crate::stream_options::StreamOptions::new().reconnect_delay(std::time::Duration::from_millis(1));

        let mut stream = api
            .invoke_api_for_sse::<String>(call_params(CallOptions::default()), None, Some(&options), None, true)
            .await
            .expect("the first connection opens");
        while let Some(event) = stream.next().await {
            event.expect("an event");
        }

        let sent = client.sent.lock().unwrap();
        assert_eq!(2, sent.len(), "the stream asked again after the feed ended");
        assert_eq!(Some(&"Bearer t1".to_string()), sent[0].get("Authorization"));
        assert_eq!(Some(&"Bearer t2".to_string()), sent[1].get("Authorization"));
    }
