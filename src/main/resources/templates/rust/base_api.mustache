/// Sends the credentials of several schemes at once, for a security
/// requirement that names more than one scheme.
struct CombinedAuthenticator {
    parts: Vec<Arc<dyn Authenticator>>,
}

impl Authenticator for CombinedAuthenticator {
    fn host(&self) -> &str {
        self.parts[0].host()
    }

    fn auth_headers<'a>(
        &'a self,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = HashMap<String, String>> + Send + 'a>> {
        Box::pin(async move {
            let mut merged = HashMap::new();
            for part in &self.parts {
                merged.extend(part.auth_headers().await);
            }
            merged
        })
    }

    fn try_auth_headers<'a>(
        &'a self,
    ) -> std::pin::Pin<
        Box<
            dyn std::future::Future<Output = Result<HashMap<String, String>, Box<dyn std::error::Error + Send + Sync>>>
                + Send
                + 'a,
        >,
    > {
        Box::pin(async move {
            let mut merged = HashMap::new();
            for part in &self.parts {
                merged.extend(part.try_auth_headers().await?);
            }
            Ok(merged)
        })
    }

    fn query_params(&self) -> HashMap<String, String> {
        self.parts.iter().flat_map(|p| p.query_params()).collect()
    }

    fn cookie_params(&self) -> HashMap<String, String> {
        self.parts.iter().flat_map(|p| p.cookie_params()).collect()
    }

    fn invalidate_access_token<'a>(&'a self) -> std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send + 'a>> {
        Box::pin(async move {
            let mut any = false;
            for part in &self.parts {
                any |= part.invalidate_access_token().await;
            }
            any
        })
    }
}

/// Sentinel authenticator that marks an operation as explicitly unauthenticated.
///
/// An operation declared with `security: []` in the spec opts out of all
/// authentication. Its generated method passes this sentinel as the `auth`
/// argument so that `BaseApi` can distinguish three states that a plain `None`
/// could not:
///
///   - `auth` IS the sentinel  -> the operation is unauthenticated; the
///     client-level authenticator must NOT be applied (no credential leak);
///   - `auth` is `None`        -> a secured operation with no per-call override;
///     fall back to the client-level authenticator;
///   - `auth` is `Some(real)`  -> a per-call override; use it.
///
/// This is a private, identity-comparable singleton; it returns empty
/// header/query/cookie maps so that even if it were ever applied it would
/// attach nothing. Callers never see it: the api template passes
/// `no_auth_sentinel()` for `security: []` operations, and `BaseApi` recognises
/// it by pointer identity (`is_no_auth`), distinct from any real authenticator
/// and from `None`.
struct NoAuth;

impl Authenticator for NoAuth {
    fn host(&self) -> &str {
        ""
    }

    fn auth_headers<'a>(
        &'a self,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = HashMap<String, String>> + Send + 'a>> {
        Box::pin(async { HashMap::new() })
    }
}

/// The single shared no-auth sentinel instance. A `'static` so its address is
/// stable for the lifetime of the program, which is what `is_no_auth` compares
/// against.
static NO_AUTH: NoAuth = NoAuth;

/// Returns the no-auth sentinel as an `Authenticator` trait object. The api
/// template passes this for operations declared `security: []` so BaseApi can
/// distinguish "explicitly unauthenticated" from "no per-call override" (`None`).
pub(crate) fn no_auth_sentinel() -> &'static dyn Authenticator {
    &NO_AUTH
}

/// Reports whether `auth` is the no-auth sentinel, by comparing the trait
/// object's data pointer against the sentinel's address. Identity comparison —
/// not a value/`PartialEq` check — so it can never be spoofed by a real
/// authenticator that happens to look empty.
fn is_no_auth(auth: &dyn Authenticator) -> bool {
    /* Cast the fat trait-object pointer to a thin data pointer (drops the
     * vtable) and compare it to the sentinel's address. `std::ptr::eq` over
     * thin pointers is a pure identity check. */
    let data_ptr = auth as *const dyn Authenticator as *const ();
    let sentinel_ptr = &NO_AUTH as *const NoAuth as *const ();
    std::ptr::eq(data_ptr, sentinel_ptr)
}

/// The most of an error body a stream call reads before it raises the error.
const STREAM_ERROR_BODY_LIMIT: usize = 64 * 1024;

/// What the transport handed back for one call: the whole response of a buffered
/// call, or the response of a stream call with its body not read yet.
enum Delivered {
    Buffered(ApiHttpResponse),
    Streamed(ApiStreamResponse),
}

impl Delivered {
    fn status_code(&self) -> u16 {
        match self {
            Delivered::Buffered(response) => response.status_code(),
            Delivered::Streamed(response) => response.status_code(),
        }
    }

    fn headers(&self) -> &HashMap<String, String> {
        match self {
            Delivered::Buffered(response) => response.headers(),
            Delivered::Streamed(response) => response.headers(),
        }
    }

    /// The status, the headers and the text of the body of a response that is
    /// not a success. A stream is read up to [`STREAM_ERROR_BODY_LIMIT`] bytes
    /// and dropped, which closes it.
    async fn into_error_parts(self) -> (u16, HashMap<String, String>, String) {
        match self {
            Delivered::Buffered(response) => (
                response.status_code(),
                response.headers().clone(),
                response.body().to_string(),
            ),
            Delivered::Streamed(response) => {
                let (status, mut headers, raw) = response.read_bounded(STREAM_ERROR_BODY_LIMIT).await;
                let body = crate::default_api_client::error_body_text(&raw, &mut headers);
                (status, headers, body)
            }
        }
    }
}

/// Parameters for the `invoke_api` call.
pub(crate) struct InvokeApiParams<'a> {
    /// The `Class.operationId` the call belongs to, named in the errors the call raises.
    pub operation: &'a str,
    pub method: &'a str,
    pub path: &'a str,
    /// The operation id exactly as written in the specification, handed to the
    /// call hook.
    pub operation_id: &'a str,
    /// The path template of the operation, handed to the call hook.
    pub url_template: &'a str,
    /// Query parameters as `(name, value, allow_reserved)` triples. When
    /// `allow_reserved` is true (OAS `allowReserved: true`), the value's RFC 3986
    /// reserved characters are left literal on the wire; otherwise the value is
    /// encoded normally.
    pub query_params: Vec<(String, String, bool)>,
    pub header_params: HashMap<String, String>,
    pub body: Option<Vec<u8>>,
    /// A raw binary body sent as it is read, never buffered. When set it is the
    /// body of the request and `body` is ignored. A replayable source is sent
    /// again for a retry, a replay after a 401 and a 307 or 308 redirect; a
    /// single-use one is sent once and its call is never retried.
    pub source: Option<BodySource>,
    /// Multipart/form-data fields. When set, the request is sent as
    /// `multipart/form-data` and `body` is ignored. File parts carry their
    /// bytes via `MultipartValue::Bytes`, repeated fields via
    /// `MultipartValue::List`, object parts via `MultipartValue::Json` (which
    /// carries `Content-Type: application/json`), and scalar form fields via
    /// `MultipartValue::Text`.
    /// Serialization (boundary, per-part Content-Type from the field-name
    /// extension, RFC 5987 filename handling, non-ASCII field-name UTF-8
    /// preservation) is performed by the API client's `serialize_multipart_body`.
    pub multipart: Option<Vec<(String, MultipartValue)>>,
    pub accepts: Vec<&'a str>,
    pub content_type: &'a str,
    pub return_type: &'a str,
    pub auth: Option<&'a dyn Authenticator>,
    /// The per-call timeout, retry budget and extra headers a caller set on the
    /// operation's options struct.
    pub call: CallOptions,
    /// The operation's own error factories by declared status (`"404"`,
    /// `"4XX"`, `"default"`), see [`ApiError::from_response_with`]. Empty when
    /// the operation declares no error schema.
    pub error_schemas: &'static [(&'static str, crate::errors::api_error::ErrorFactory)],
}

/// The credential of a call, owned so that a reconnect can use it again.
enum OwnedAuth {
    /// No per-call credential: the client's own authenticator applies.
    Inherit,
    /// The operation is unauthenticated (`security: []`).
    NoAuth,
    /// The credential of the scheme the operation requires.
    Given(Arc<dyn Authenticator>),
}

/// An owned copy of the parameters of a call, so that an event stream can send
/// the same request again on every reconnect.
struct StreamCall {
    operation: String,
    method: String,
    path: String,
    operation_id: String,
    url_template: String,
    query_params: Vec<(String, String, bool)>,
    header_params: HashMap<String, String>,
    body: Option<Vec<u8>>,
    source: Option<BodySource>,
    multipart: Option<Vec<(String, MultipartValue)>>,
    accepts: Vec<String>,
    content_type: String,
    return_type: String,
    auth: OwnedAuth,
    call: CallOptions,
    error_schemas: &'static [(&'static str, crate::errors::api_error::ErrorFactory)],
}

impl StreamCall {
    fn of(params: InvokeApiParams<'_>, credential: Option<Arc<dyn Authenticator>>) -> Self {
        let auth = match (params.auth, credential) {
            (None, _) => OwnedAuth::Inherit,
            (Some(a), _) if is_no_auth(a) => OwnedAuth::NoAuth,
            (Some(_), Some(credential)) => OwnedAuth::Given(credential),
            (Some(_), None) => OwnedAuth::Inherit,
        };
        Self {
            operation: params.operation.to_string(),
            method: params.method.to_string(),
            path: params.path.to_string(),
            operation_id: params.operation_id.to_string(),
            url_template: params.url_template.to_string(),
            query_params: params.query_params,
            header_params: params.header_params,
            body: params.body,
            source: params.source,
            multipart: params.multipart,
            accepts: params.accepts.iter().map(|a| a.to_string()).collect(),
            content_type: params.content_type.to_string(),
            return_type: params.return_type.to_string(),
            auth,
            call: params.call,
            error_schemas: params.error_schemas,
        }
    }

    /// The parameters of one request of the call, with `Last-Event-ID` when
    /// `last_event_id` is not empty.
    fn params(&self, last_event_id: &str) -> InvokeApiParams<'_> {
        let mut header_params = self.header_params.clone();
        if !last_event_id.is_empty() {
            header_params.insert("Last-Event-ID".to_string(), last_event_id.to_string());
        }
        InvokeApiParams {
            operation: &self.operation,
            method: &self.method,
            path: &self.path,
            operation_id: &self.operation_id,
            url_template: &self.url_template,
            query_params: self.query_params.clone(),
            header_params,
            body: self.body.clone(),
            source: self.source.clone(),
            multipart: self.multipart.clone(),
            accepts: self.accepts.iter().map(String::as_str).collect(),
            content_type: &self.content_type,
            return_type: &self.return_type,
            auth: match &self.auth {
                OwnedAuth::Inherit => None,
                OwnedAuth::NoAuth => Some(no_auth_sentinel()),
                OwnedAuth::Given(credential) => Some(credential.as_ref()),
            },
            call: self.call.clone(),
            error_schemas: self.error_schemas,
        }
    }
}

/// Decodes one JSON Lines line or one `data` field as `T`, or hands the text over
/// as it is when `raw` is set (then `T` is a `String`).
fn item_decoder<T>(raw: bool) -> Box<dyn Fn(&str) -> Result<T, crate::errors::serialization_error::SerializationError> + Send + Sync>
where
    T: DeserializeOwned,
{
    use crate::errors::serialization_error::SerializationError;
    if raw {
        return Box::new(|text| {
            serde_json::from_value(serde_json::Value::String(text.to_string()))
                .map_err(|e| SerializationError::new(e.to_string(), Some(Box::new(e))))
        });
    }
    Box::new(|text| {
        crate::object_serializer::deserialize::<T>(text.as_bytes())?
            .ok_or_else(|| SerializationError::new("The value decoded to nothing".to_string(), None))
    })
}

/// Per-call settings that override the client's for one operation: the
/// end-to-end timeout, the retry budget and extra request headers. Every field
/// left at its default leaves the client's own setting in force.
#[derive(Debug, Clone, Default)]
pub(crate) struct CallOptions {
    /// Replaces the client's end-to-end timeout for this call. Zero is refused
    /// with `ConfigurationError::InvalidTimeout`.
    pub timeout: Option<std::time::Duration>,
    /// Replaces the client's retry budget for this call; `Some(0)` turns the
    /// retries off.
    pub max_retries: Option<u32>,
    /// Headers added to this call after the client's default headers and the
    /// operation's own header parameters, so they win over both; the
    /// authentication headers are applied after them.
    pub headers: HashMap<String, String>,
    /// Replaces the idle timeout of the stream this call opens; zero disables
    /// it. Set by a stream method from its `StreamOptions`.
    pub idle_timeout: Option<std::time::Duration>,
}

/// Base struct for all API groups. Provides the `invoke_api` method that
/// handles URL construction, header selection, body serialization, request
/// dispatch, and response deserialization.
#[derive(Clone)]
pub(crate) struct BaseApi {
    /// API-level configuration (base URL and default headers).
    config: Configuration,

    /// The HTTP transport client used for sending requests.
    api_client: Arc<dyn ApiClient>,

    /// Content negotiation logic for Accept and Content-Type headers.
    header_selector: HeaderSelector,

    /// Default authenticator used when no credential is held for the operation's scheme.
    authenticator: Option<Arc<dyn Authenticator>>,

    /// One credential per security scheme, by scheme id, when the client was
    /// built from `Credentials`.
    scheme_authenticators: HashMap<String, Arc<dyn Authenticator>>,
}

impl BaseApi {
    /// The full URL a call's path is sent to: an absolute URL is used as it is,
    /// and a relative path is joined to the base URL. A trailing slash on the
    /// base URL is dropped before a path that starts with a slash, so
    /// `https://x/` + `/y` yields `https://x/y` rather than `https://x//y`.
    fn request_url_of(&self, path: &str) -> String {
        if path.starts_with("http://") || path.starts_with("https://") {
            return path.to_string();
        }
        let base = self.config.base_url();
        let base_trimmed = if path.starts_with('/') {
            base.trim_end_matches('/')
        } else {
            base
        };
        format!("{}{}", base_trimmed, path)
    }

    /// Creates an API instance with a custom API client, configuration, and
    /// default authenticator (used for operations without explicit auth).
    pub fn new(api_client: Arc<dyn ApiClient>, config: Configuration, authenticator: Option<Arc<dyn Authenticator>>) -> Self {
        Self {
            config,
            api_client,
            header_selector: HeaderSelector::new(),
            authenticator,
            scheme_authenticators: HashMap::new(),
        }
    }

    /// Gives this API one credential per security scheme, by scheme id.
    pub(crate) fn with_scheme_authenticators(
        mut self,
        authenticators: HashMap<String, Arc<dyn Authenticator>>,
    ) -> Self {
        self.scheme_authenticators = authenticators;
        self
    }

    /// Sets the call hook of this API.
    pub(crate) fn with_call_hook(mut self, hook: Arc<dyn crate::call_hook::CallHook>) -> Self {
        self.config = self.config.with_call_hook(hook);
        self
    }

    /// The credential of the first of `schemes` that the client holds, in the
    /// order the operation lists them, or `None` when it holds none of them.
    pub(crate) fn authenticator_for(&self, schemes: &[&str]) -> Option<Arc<dyn Authenticator>> {
        schemes
            .iter()
            .find_map(|scheme| self.scheme_authenticators.get(*scheme).cloned())
    }

    /// The credential of the first alternative whose schemes the client all
    /// holds, or `None` when no alternative is fully held. An alternative that
    /// names several schemes needs all of them: their headers, query
    /// parameters and cookies are sent together.
    pub(crate) fn authenticator_for_alternatives(
        &self,
        alternatives: &[&[&str]],
    ) -> Option<Arc<dyn Authenticator>> {
        for schemes in alternatives {
            let held: Vec<Arc<dyn Authenticator>> = schemes
                .iter()
                .filter_map(|scheme| self.scheme_authenticators.get(*scheme).cloned())
                .collect();
            if held.is_empty() || held.len() != schemes.len() {
                continue;
            }
            if held.len() == 1 {
                return held.into_iter().next();
            }
            return Some(Arc::new(CombinedAuthenticator { parts: held }));
        }
        None
    }

    /// Invokes an API operation and returns the raw HTTP response, after
    /// building the URL, selecting headers, applying authentication, and
    /// serializing the body. A non-2xx status is returned as an `ApiError`, and
    /// an error with no response (network failure, timeout) carries the method
    /// and path of the request, never its query string.
    pub async fn invoke_api(
        &self,
        params: InvokeApiParams<'_>,
    ) -> Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>> {
        let mut scope = CallScope::new();
        let result = self.invoke_scoped(params, &mut scope).await;
        scope.finish(&result);
        result
    }

    /// The call without the hook's last step: the caller finishes `scope` once
    /// it has the result it returns, so a decoding failure is observed too.
    async fn invoke_scoped(
        &self,
        params: InvokeApiParams<'_>,
        scope: &mut CallScope,
    ) -> Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>> {
        match self.invoke_scoped_for(params, scope, false).await? {
            Delivered::Buffered(response) => Ok(response),
            Delivered::Streamed(_) => unreachable!("a buffered call is sent through send_request_with_options"),
        }
    }

    /// [`invoke_scoped`](Self::invoke_scoped) for a buffered or a stream call.
    async fn invoke_scoped_for(
        &self,
        params: InvokeApiParams<'_>,
        scope: &mut CallScope,
        stream: bool,
    ) -> Result<Delivered, Box<dyn std::error::Error + Send + Sync>> {
        let method = params.method;
        let request_path = crate::errors::api_error::request_path_of(&self.request_url_of(params.path));
        /* Read on the first poll, in the caller's task, before any await. */
        let trace = trace_context_util::TraceContext::capture();
        self.invoke_api_inner(params, &request_path, &trace, scope, stream)
            .await
            .map_err(|err| crate::errors::api_error::attach_request(err, method, &request_path))
    }

    async fn invoke_api_inner(
        &self,
        params: InvokeApiParams<'_>,
        request_path: &str,
        trace: &trace_context_util::TraceContext,
        scope: &mut CallScope,
        stream: bool,
    ) -> Result<Delivered, Box<dyn std::error::Error + Send + Sync>> {
        if let Some(timeout) = params.call.timeout {
            if timeout.as_millis() == 0 {
                return Err(Box::new(ConfigurationError::InvalidTimeout(0)));
            }
        }
        /* A header value with a CR or LF would split the request head; refuse it before anything is sent. */
        for (name, value) in params.header_params.iter().chain(params.call.headers.iter()) {
            if value.contains(['\r', '\n']) {
                return Err(Box::new(ConfigurationError::InvalidArgument(format!(
                    "header '{}' must not contain CR or LF characters",
                    name
                ))));
            }
        }
        let mut request_url = self.request_url_of(params.path);

        /* Three-state auth resolution. The no-auth sentinel (security: [])
         * suppresses the client authenticator; None falls back to it (secured
         * op whose scheme the client holds no credential for); any other
         * instance is the credential of the scheme the operation requires.
         * Identity comparison against the sentinel -- never equals. */
        let mut query_params = params.query_params;
        let effective_auth: Option<&dyn Authenticator> = match params.auth {
            Some(a) if is_no_auth(a) => None,
            Some(a) => Some(a),
            None => self.authenticator.as_ref().map(|a| a.as_ref()),
        };
        if let Some(auth) = effective_auth {
            /* A per-call authenticator never met the client's constructor, so it
             * gets this API's transport before it is asked for headers. An
             * authenticator that already has one keeps it. */
            auth.inject_api_client(self.api_client.clone());
            for (k, v) in auth.query_params() {
                /* The authenticator's value replaces an operation query
                 * parameter of the same name, so the name is sent once. */
                query_params.retain(|(name, _, _)| *name != k);
                query_params.push((k, v, false));
            }
        }

        /* The URL the call hook sees never carries the query string. */
        let url_end = request_url.len();

        /* Build query string */
        let query_string = build_query_string(&query_params);
        if !query_string.is_empty() {
            request_url = format!("{}?{}", request_url, query_string);
        }

        /* Select headers */
        let is_multipart = params.content_type == "multipart/form-data";
        let mut headers = self.header_selector.select_headers(&params.accepts, params.content_type, is_multipart);

        /* Merge config default headers */
        for (k, v) in self.config.default_headers() {
            insert_header(&mut headers, k, v);
        }

        /* Merge operation-specific headers */
        for (k, v) in &params.header_params {
            insert_header(&mut headers, k.clone(), v.clone());
        }

        /* Merge the per-call headers, which win over both */
        for (k, v) in &params.call.headers {
            insert_header(&mut headers, k.clone(), v.clone());
        }

        /* Merge auth headers */
        if let Some(auth) = effective_auth {
            /* try_auth_headers, not auth_headers: an authenticator that cannot
             * produce credentials must fail the call rather than let the
             * request go out unauthenticated. */
            for (k, v) in auth.try_auth_headers().await? {
                insert_header(&mut headers, k, v);
            }
            /* RFC 6265 -- cookie name is a token (RFC 7230 s3.2.6); cookie
             * value is *cookie-octet (US-ASCII excluding whitespace, DQUOTE,
             * comma, semicolon, backslash, controls). DO NOT URL-encode here:
             * most cookie parsers do not URL-decode, so `=` (base64 padding)
             * would arrive as literal `%3D` and break JWT/session cookies.
             * Validate and pass through raw instead. Invalid input is a caller
             * mistake, reported as ConfigurationError::InvalidArgument. */
            let cookies = auth.cookie_params();
            if !cookies.is_empty() {
                /* A map has no order, so the cookies are written sorted by
                 * name and the header bytes are the same on every run. */
                let mut ordered: Vec<(&String, &String)> = cookies.iter().collect();
                ordered.sort();
                let mut cookie_parts: Vec<String> = Vec::with_capacity(cookies.len());
                for (k, v) in ordered {
                    if !is_valid_cookie_name(k) {
                        return Err(Box::new(ConfigurationError::InvalidArgument(format!(
                            "Cookie name '{}' contains characters forbidden by RFC 6265",
                            k
                        ))));
                    }
                    if !is_valid_cookie_value(v) {
                        return Err(Box::new(ConfigurationError::InvalidArgument(format!(
                            "Cookie value for '{}' contains characters forbidden by RFC 6265",
                            k
                        ))));
                    }
                    cookie_parts.push(format!("{}={}", k, v));
                }
                let cookie_str = cookie_parts.join("; ");
                if let Some(existing) = headers.get("Cookie").cloned() {
                    headers.insert(
                        "Cookie".to_string(),
                        format!("{}; {}", existing, cookie_str),
                    );
                } else {
                    headers.insert("Cookie".to_string(), cookie_str);
                }
            }
        }

        /* Inject trace context */
        trace.inject(&mut headers);

        /* The call hook starts once per call, right after the trace context is
         * injected: the headers are final, so it can read and replace any of
         * them. A header it sets stays in this map for every send of the call. */
        scope.begin(self.config.call_hook(), &mut headers, || CallInfo {
            operation_id: params.operation_id.to_string(),
            method: params.method.to_ascii_uppercase(),
            url_template: params.url_template.to_string(),
            url: strip_query_and_fragment(&request_url[..url_end]).to_string(),
            server_address: server_address_of(&request_url[..url_end]),
        });
        let hooked = scope.is_hooked();

        /* Serialize body. For multipart/form-data we hand the structured
         * fields to the API client as `RequestBody::Multipart`; the client's
         * `serialize_multipart_body` generates the boundary, sets the
         * `Content-Type` header (overriding the placeholder selected above),
         * derives each file part's Content-Type from its field-name extension,
         * emits RFC 5987 directives for non-ASCII filenames, and preserves
         * non-ASCII field names as UTF-8. The placeholder Content-Type chosen
         * by the header selector lacks the boundary, so we drop it here and let
         * the client install the boundary-bearing value. */
        let serialized_body: Option<RequestBody> = if let Some(fields) = params.multipart {
            remove_header(&mut headers, "Content-Type");
            /* A declared multipart type other than form-data (multipart/mixed, ...)
             * is handed on so the client keeps the subtype; it appends the boundary. */
            if params.content_type != "multipart/form-data"
                && params.content_type.starts_with("multipart/")
            {
                insert_header(&mut headers, "Content-Type".to_string(), params.content_type.to_string());
            }
            if fields.is_empty() {
                None
            } else {
                Some(RequestBody::Multipart(fields))
            }
        } else if let Some(source) = params.source {
            /* A raw binary body is sent unchanged as it is read; nothing is serialized. */
            Some(RequestBody::Source(source))
        } else {
            serialize_body(params.body, params.content_type)?.map(RequestBody::Bytes)
        };

        if serialized_body.is_none() {
            remove_header(&mut headers, "Content-Type");
        }

        /* Send the request. A failed call is sent again up to `max_retries`
         * times (a network failure before a response, for an idempotent method
         * only; 408, 409, 429, 500-599
         * except 501), each time as a fresh request with its authentication
         * headers applied again. The retries share the transport's end-to-end
         * timeout, so a retry that would not fit in what is left is not made,
         * and dropping the returned future cancels the wait between attempts.
         * A multipart body and a single-use body source are never sent twice: the
         * first error, or the first response, is the one that is reported. */
        let replayable = match &serialized_body {
            Some(RequestBody::Multipart(_)) => false,
            Some(RequestBody::Source(source)) => source.is_replayable(),
            _ => true,
        };
        let max_retries = if replayable {
            params.call.max_retries.unwrap_or_else(|| self.api_client.max_retries())
        } else {
            0
        };
        let deadline = params
            .call
            .timeout
            .or_else(|| self.api_client.request_timeout())
            .map(|budget| std::time::Instant::now() + budget);
        let send_options = RequestOptions::new()
            .deadline(deadline)
            .idle_timeout(params.call.idle_timeout);
        let mut attempt: u32 = 0;
        let mut renewed_after_401 = false;
        let response = loop {
            /* A stream call is sent through `send_streaming`: the retries, the
             * replay after a 401 and the error contract below run on the headers
             * it returns, and a response that is retried or replayed is dropped
             * unread, which closes it. Nothing is retried once the body has
             * started, because the caller only ever sees the stream after this
             * loop has ended. */
            let sent = if stream {
                self.api_client
                    .send_streaming(
                        params.method,
                        &request_url,
                        &headers,
                        serialized_body.as_ref(),
                        &send_options,
                    )
                    .await
                    .map(Delivered::Streamed)
            } else {
                self.api_client
                    .send_request_with_options(
                        params.method,
                        &request_url,
                        &headers,
                        serialized_body.as_ref(),
                        &send_options,
                    )
                    .await
                    .map(Delivered::Buffered)
            };
            let response = match sent {
                Ok(response) => response,
                Err(err) => {
                    if attempt < max_retries && is_idempotent_method(params.method) && is_retryable_error(err.as_ref()) {
                        let delay = retry_delay(attempt, None);
                        if fits_budget(deadline, delay)
                            && refresh_request_headers(effective_auth, &mut headers, trace, hooked).await
                        {
                            tokio::time::sleep(delay).await;
                            attempt += 1;
                            continue;
                        }
                    }
                    return Err(err);
                }
            };

            /* A 401 on a request signed by a token flow means the cached token
             * was revoked or rotated: drop it, get a new one (a refresh grant
             * first) and replay the request once. A multipart body is not
             * replayed, and a failure to re-authenticate leaves the original
             * 401 to be reported. */
            if response.status_code() == 401 && !renewed_after_401 && replayable {
                renewed_after_401 = true;
                if let Some(auth) = effective_auth {
                    if auth.invalidate_access_token().await {
                        if let Ok(fresh) = auth.try_auth_headers().await {
                            for (k, v) in fresh {
                                insert_header(&mut headers, k, v);
                            }
                            continue;
                        }
                    }
                }
            }

            if attempt < max_retries && is_retryable_status(response.status_code()) {
                let retry_after = response
                    .headers()
                    .iter()
                    .find(|(name, _)| name.eq_ignore_ascii_case("retry-after"))
                    .and_then(|(_, value)| parse_retry_after(value));
                let delay = retry_delay(attempt, retry_after);
                if fits_budget(deadline, delay) && refresh_request_headers(effective_auth, &mut headers, trace, hooked).await {
                    tokio::time::sleep(delay).await;
                    attempt += 1;
                    continue;
                }
            }
            break response;
        };

        scope.record_response(response.status_code(), response.headers());

        /* Check for errors. A stream call reads at most 64 KiB of the body of an
         * error status and closes it, so the error is the one of a buffered call
         * and no stream is ever returned for it. */
        if response.status_code() < 200 || response.status_code() >= 300 {
            let (status, headers, body) = response.into_error_parts().await;
            return Err(ApiError::from_response_with(
                status,
                &headers,
                &body,
                Some(params.method),
                Some(request_path),
                params.error_schemas,
            ));
        }

        Ok(response)
    }

    /// Invokes an operation whose success response is binary and returns its
    /// body as a [`ByteStream`], not read yet. Everything up to the response
    /// headers is the buffered call: the same retries, redirects, authentication,
    /// replay after a 401, headers and call hook. A status that is not a success
    /// raises the same typed error as a buffered call, with its body read up to
    /// 64 KiB, and no stream is returned. The raw body of the result is empty.
    pub async fn invoke_api_for_stream(
        &self,
        params: InvokeApiParams<'_>,
    ) -> Result<ApiResult<ByteStream>, Box<dyn std::error::Error + Send + Sync>> {
        let mut scope = CallScope::new();
        let result = match self.invoke_scoped_for(params, &mut scope, true).await {
            Ok(Delivered::Streamed(response)) => {
                let (status, headers, body) = response.into_parts();
                let stream = ByteStream::new(status, headers.clone(), body);
                Ok(ApiResult::new(status, Some(stream), String::new(), headers))
            }
            Ok(Delivered::Buffered(_)) => {
                unreachable!("a stream call is sent through send_streaming")
            }
            Err(err) => Err(err),
        };
        scope.finish(&result);
        result
    }

    /// Invokes an operation whose success response is JSON Lines and returns its
    /// items as a stream, not read yet. Everything up to the response headers is
    /// the buffered call; a status that is not a success raises the typed error and
    /// no stream is returned. With `raw` each line is handed over as a `String`
    /// instead of being decoded as JSON.
    pub async fn invoke_api_for_json_lines<T>(
        &self,
        mut params: InvokeApiParams<'_>,
        options: Option<&StreamOptions>,
        raw: bool,
    ) -> Result<JsonLinesStream<T>, Box<dyn std::error::Error + Send + Sync>>
    where
        T: DeserializeOwned,
    {
        params.call.idle_timeout = options.and_then(|o| o.get_idle_timeout());
        let max_line_bytes = options.and_then(|o| o.get_max_event_bytes()).unwrap_or(1024 * 1024);
        let method = params.method.to_string();
        let request_path = crate::errors::api_error::request_path_of(&self.request_url_of(params.path));
        let mut scope = CallScope::new();
        let result = match self.invoke_scoped_for(params, &mut scope, true).await {
            Ok(Delivered::Streamed(response)) => Ok(response),
            Ok(Delivered::Buffered(_)) => unreachable!("a stream call is sent through send_streaming"),
            Err(err) => Err(err),
        };
        scope.finish(&result);
        let (status, headers, body) = result?.into_parts();
        Ok(JsonLinesStream::new(
            ByteStream::new(status, headers, body),
            item_decoder::<T>(raw),
            max_line_bytes,
            &method,
            &request_path,
        ))
    }

    /// Invokes an operation whose success response is server-sent events and
    /// returns its events as a stream that reconnects. Each connection is a fresh
    /// call, so the headers and the credential are built again and the call hook
    /// runs again; the stream adds `Cache-Control: no-cache` and
    /// `Accept-Encoding: identity` unless the caller set them, and
    /// `Last-Event-ID` once it has an id. `credential` is the per-call
    /// authenticator `params.auth` was taken from. With `raw` each `data` field is
    /// handed over as a `String` instead of being decoded as JSON.
    pub async fn invoke_api_for_sse<T>(
        &self,
        mut params: InvokeApiParams<'_>,
        credential: Option<Arc<dyn Authenticator>>,
        options: Option<&StreamOptions>,
        terminator: Option<&str>,
        raw: bool,
    ) -> Result<SseStream<T>, Box<dyn std::error::Error + Send + Sync>>
    where
        T: DeserializeOwned + Send + 'static,
    {
        params.call.idle_timeout = options.and_then(|o| o.get_idle_timeout());
        for (name, value) in [("Cache-Control", "no-cache"), ("Accept-Encoding", "identity")] {
            let set = params
                .header_params
                .keys()
                .chain(params.call.headers.keys())
                .chain(self.config.default_headers().keys())
                .any(|k| k.eq_ignore_ascii_case(name));
            if !set {
                params.header_params.insert(name.to_string(), value.to_string());
            }
        }
        let has_body = params.body.is_some() || params.source.is_some() || params.multipart.is_some();
        let single_use_body = params.source.as_ref().is_some_and(|source| !source.is_replayable());
        let method = params.method.to_string();
        let request_path = crate::errors::api_error::request_path_of(&self.request_url_of(params.path));
        let call = StreamCall::of(params, credential);
        let base = self.clone();
        let call = Arc::new(call);
        let opener: EventOpener = Box::new(move |last_event_id: String| {
            let base = base.clone();
            let call = call.clone();
            Box::pin(async move { base.open_event_stream(&call, &last_event_id).await })
        });
        SseStream::open(
            opener,
            item_decoder::<T>(raw),
            terminator.map(str::to_string),
            options,
            has_body,
            single_use_body,
            &method,
            &request_path,
        )
        .await
    }

    /// Sends one request of an event stream: a whole call of its own, so the call
    /// hook, the headers and the credential are the ones of a first request, plus
    /// `Last-Event-ID` when there is an id.
    async fn open_event_stream(
        &self,
        call: &StreamCall,
        last_event_id: &str,
    ) -> Result<ApiStreamResponse, Box<dyn std::error::Error + Send + Sync>> {
        let mut scope = CallScope::new();
        let result = match self.invoke_scoped_for(call.params(last_event_id), &mut scope, true).await {
            Ok(Delivered::Streamed(response)) => Ok(response),
            Ok(Delivered::Buffered(_)) => unreachable!("a stream call is sent through send_streaming"),
            Err(err) => Err(err),
        };
        scope.finish(&result);
        result
    }

    /// Invokes an API operation and returns the full result including status
    /// code, headers, and raw body alongside the deserialized data.
    pub async fn invoke_api_for_result<T: DeserializeOwned>(
        &self,
        params: InvokeApiParams<'_>,
    ) -> Result<ApiResult<T>, Box<dyn std::error::Error + Send + Sync>> {
        /* Capture the target return type before `params` is consumed by
         * invoke_api. Binary operations set this to "Vec<u8>" so we can route
         * non-JSON bodies straight to the raw-bytes path below. */
        let is_binary_return = params.return_type == "Vec<u8>";
        let operation = params.operation;
        let method = params.method;
        let request_path = crate::errors::api_error::request_path_of(&self.request_url_of(params.path));
        let mut scope = CallScope::new();
        let result = match self.invoke_scoped(params, &mut scope).await {
            Ok(response) => decode_response(&response, is_binary_return, operation)
                .map_err(|err| attach_response(err, &response, method, &request_path)),
            Err(err) => Err(err),
        };
        scope.finish(&result);
        result
    }

    /// Invokes an operation that declares several 2xx responses with different
    /// schemas and returns the full result. `decode` is handed the actual
    /// status code and the raw body and builds the union variant that status
    /// declares, so a 201 is never read as the schema of the 200. An empty
    /// body leaves the data `None`.
    pub async fn invoke_api_for_status_union<T, F>(
        &self,
        params: InvokeApiParams<'_>,
        decode: F,
    ) -> Result<ApiResult<T>, Box<dyn std::error::Error + Send + Sync>>
    where
        F: FnOnce(
            u16,
            &[u8],
        ) -> Result<Option<T>, crate::errors::serialization_error::SerializationError>,
    {
        let method = params.method;
        let request_path = crate::errors::api_error::request_path_of(&self.request_url_of(params.path));
        let mut scope = CallScope::new();
        let result = match self.invoke_scoped(params, &mut scope).await {
            Ok(response) => {
                let data = if response.body().is_empty() {
                    Ok(None)
                } else {
                    decode(response.status_code(), response.body().as_bytes()).map_err(|err| {
                        Box::new(
                            err.with_response(response.status_code(), response.headers(), response.body())
                                .with_request(method, &request_path),
                        ) as Box<dyn std::error::Error + Send + Sync>
                    })
                };
                data.map(|data| {
                    ApiResult::new(
                        response.status_code(),
                        data,
                        response.body().to_string(),
                        response.headers().clone(),
                    )
                })
            }
            Err(err) => Err(err),
        };
        scope.finish(&result);
        result
    }

    /// Invokes an API operation with no return type and returns the full
    /// result (status code, headers, and raw body) with unit data.
    pub async fn invoke_api_for_empty_result(
        &self,
        params: InvokeApiParams<'_>,
    ) -> Result<ApiResult<()>, Box<dyn std::error::Error + Send + Sync>> {
        let response = self.invoke_api(params).await?;
        Ok(ApiResult::new(
            response.status_code(),
            Some(()),
            response.body().to_string(),
            response.headers().clone(),
        ))
    }
}

/// Gives a decoding failure the response it came from and the request that drew
/// it; any other error is returned unchanged.
fn attach_response(
    err: Box<dyn std::error::Error + Send + Sync>,
    response: &ApiHttpResponse,
    method: &str,
    request_path: &str,
) -> Box<dyn std::error::Error + Send + Sync> {
    match err.downcast::<crate::errors::serialization_error::SerializationError>() {
        Ok(serialization) => Box::new(
            serialization
                .with_response(response.status_code(), response.headers(), response.body())
                .with_request(method, request_path),
        ),
        Err(other) => other,
    }
}

/// Decodes the body of a successful response as the return type `T`.
fn decode_response<T: DeserializeOwned>(
    response: &ApiHttpResponse,
    is_binary_return: bool,
    operation: &str,
) -> Result<ApiResult<T>, Box<dyn std::error::Error + Send + Sync>> {
    {
        /* Check Content-Type before deserializing -- only deserialize JSON responses */
        let resp_content_type = response.headers().iter()
            .find(|(k, _)| k.eq_ignore_ascii_case("content-type"))
            .map(|(_, v)| v.split(';').next().unwrap_or("").trim().to_string());

        let is_json = match &resp_content_type {
            None => true,
            Some(ct) => {
                let selector = HeaderSelector::new();
                selector.is_json_mime(ct)
            }
        };

        let data = if is_binary_return && !response.body().is_empty() {
            /* Binary return type (T = Vec<u8>). Mock/real servers encode binary
             * payloads inconsistently: some send a base64-encoded transport body
             * (non-JSON content-type), others a JSON string of base64, others a
             * JSON array of byte values. Normalise all three to raw bytes and
             * present them as a JSON array, which is how serde deserializes
             * Vec<u8>. from_utf8_lossy is deliberately avoided -- it would
             * corrupt non-UTF-8 binary. */
            use base64::Engine as _;
            let bytes: Vec<u8> = if is_json {
                match serde_json::from_slice::<serde_json::Value>(response.body().as_bytes()) {
                    /* Base64 string of the binary payload. */
                    Ok(serde_json::Value::String(s)) => base64::engine::general_purpose::STANDARD
                        .decode(s.as_bytes())
                        .map_err(|e| {
                            crate::errors::serialization_error::SerializationError::new(
                                format!("Invalid base64 value for a format: byte response: {e}"),
                                Some(Box::new(e)),
                            )
                        })?,
                    /* JSON array of byte values -- already the target shape. */
                    Ok(serde_json::Value::Array(items))
                        if items.iter().all(|v| v.as_u64().is_some_and(|n| n <= 255)) =>
                    {
                        return Ok(ApiResult::new(
                            response.status_code(),
                            serde_json::from_value(serde_json::Value::Array(items)).ok(),
                            response.body().to_string(),
                            response.headers().clone(),
                        ));
                    }
                    /* Any other JSON document (content negotiation answered the
                     * binary operation with its application/json variant): the
                     * caller gets its raw bytes, never an empty body. */
                    _ => response.body().as_bytes().to_vec(),
                }
            } else {
                /* Non-JSON content-type: transport layer base64-encoded the raw
                 * bytes; decode them back. */
                base64::engine::general_purpose::STANDARD
                    .decode(response.body().as_bytes())
                    .unwrap_or_default()
            };
            let arr = serde_json::Value::Array(
                bytes.iter().map(|&b| serde_json::Value::from(b)).collect(),
            );
            serde_json::from_value(arr).ok()
        } else if is_json && !response.body().is_empty() {
            crate::object_serializer::deserialize(response.body().as_bytes())?
        } else if !is_json && !response.body().is_empty() {
            /* Non-JSON, non-binary response. The transport keeps text media
             * types as decoded text and base64-encodes everything else, so only
             * the latter is decoded back; text is surfaced verbatim. */
            let text = if resp_content_type.as_deref().is_some_and(is_text_media_type) {
                response.body().to_string()
            } else {
                use base64::Engine as _;
                let bytes = base64::engine::general_purpose::STANDARD
                    .decode(response.body().as_bytes())
                    .map_err(|e| {
                        crate::errors::serialization_error::SerializationError::new(
                            format!("Invalid base64 value for a non-JSON response body: {e}"),
                            Some(Box::new(e)),
                        )
                    })?;
                String::from_utf8_lossy(&bytes).into_owned()
            };
            /* D32: a String return takes the text; any other return type is a
             * SerializationError naming the Content-Type, never a silent None. */
            match serde_json::from_value(serde_json::Value::String(text)) {
                Ok(value) => Some(value),
                Err(_) => {
                    return Err(Box::new(
                        crate::errors::serialization_error::SerializationError::new(
                            format!(
                                "Unexpected response Content-Type '{}' for {}",
                                resp_content_type.as_deref().unwrap_or(""),
                                operation
                            ),
                            None,
                        ),
                    ));
                }
            }
        } else {
            None
        };

        Ok(ApiResult::new(
            response.status_code(),
            data,
            response.body().to_string(),
            response.headers().clone(),
        ))
    }
}

/* Retry policy (F823). The numbers follow the other SDKs: 0.5 s doubling to
 * 8 s, 25% jitter, a Retry-After honoured up to 60 s. */
const RETRY_BASE_DELAY_MS: u64 = 500;
const RETRY_MAX_DELAY_MS: u64 = 8_000;
const RETRY_AFTER_CAP_MS: u64 = 60_000;

/// Whether a response status is worth sending the request again for.
pub(crate) fn is_retryable_status(status: u16) -> bool {
    crate::errors::api_error::is_retryable_status(status)
}

/// Whether a transport error happened before a response and may be retried: a
/// [`NetworkError`](crate::errors::NetworkError) whose cause is not a failure
/// to read a body that had already started to arrive. A timeout has used up
/// the end-to-end budget and is never retried.
pub(crate) fn is_retryable_error(err: &(dyn std::error::Error + Send + Sync + 'static)) -> bool {
    if err.downcast_ref::<crate::errors::NetworkError>().is_none() {
        return false;
    }
    let mut cause = err.source();
    while let Some(c) = cause {
        if is_tls_failure_message(&c.to_string()) {
            return false;
        }
        if let Some(e) = c.downcast_ref::<reqwest::Error>() {
            if e.is_body() || e.is_decode() {
                return false;
            }
        }
        cause = c.source();
    }
    true
}

/// Whether an error message names a TLS or certificate failure. Such a failure
/// is about the peer's identity, so it is reported at once and never retried.
fn is_tls_failure_message(message: &str) -> bool {
    let lower = message.to_ascii_lowercase();
    ["certificate", "tls", "ssl", "rustls", "native-tls", "native_tls"]
        .iter()
        .any(|needle| lower.contains(needle))
}

/// Whether a method is idempotent (RFC 9110 section 9.2.2, plus QUERY), so a
/// request that never got a response can be sent again without repeating a change.
pub(crate) fn is_idempotent_method(method: &str) -> bool {
    matches!(
        method.to_ascii_uppercase().as_str(),
        "GET" | "HEAD" | "OPTIONS" | "TRACE" | "PUT" | "DELETE" | "QUERY"
    )
}

/// Parses a `Retry-After` value: whole seconds or an HTTP date. A date in the
/// past is a zero wait; anything else unparseable is `None`.
pub(crate) fn parse_retry_after(value: &str) -> Option<std::time::Duration> {
    let value = value.trim();
    if let Ok(seconds) = value.parse::<u64>() {
        return Some(std::time::Duration::from_secs(seconds));
    }
    let date = chrono::DateTime::parse_from_rfc2822(value).ok()?;
    let wait = date.with_timezone(&chrono::Utc) - chrono::Utc::now();
    Some(wait.to_std().unwrap_or_default())
}

/// The wait before retry number `attempt + 1` (`attempt` counts from 0): the
/// `Retry-After` value capped at 60 s when the server sent one, otherwise 0.5 s
/// doubled per attempt up to 8 s and reduced by up to 25% jitter.
pub(crate) fn retry_delay(attempt: u32, retry_after: Option<std::time::Duration>) -> std::time::Duration {
    match retry_after {
        Some(wait) => wait.min(std::time::Duration::from_millis(RETRY_AFTER_CAP_MS)),
        None => {
            let base = RETRY_BASE_DELAY_MS
                .saturating_mul(1u64 << attempt.min(16))
                .min(RETRY_MAX_DELAY_MS);
            let random = f64::from(uuid::Uuid::new_v4().as_u128() as u32) / f64::from(u32::MAX);
            std::time::Duration::from_millis((base as f64 * (1.0 - 0.25 * random)) as u64)
        }
    }
}

/// Whether a wait of `delay` leaves time in the end-to-end budget for another
/// request. Without a deadline there is no budget to protect.
fn fits_budget(deadline: Option<std::time::Instant>, delay: std::time::Duration) -> bool {
    match deadline {
        Some(deadline) => std::time::Instant::now() + delay < deadline,
        None => true,
    }
}

/// Prepares the headers of a retry: the authentication headers are asked for
/// again (a token may have been renewed since the first attempt) and the trace
/// context is injected again. `false` when the authenticator cannot produce
/// credentials, in which case the call is not retried.
async fn refresh_request_headers(
    auth: Option<&dyn Authenticator>,
    headers: &mut HashMap<String, String>,
    trace: &trace_context_util::TraceContext,
    hooked: bool,
) -> bool {
    if let Some(auth) = auth {
        match auth.try_auth_headers().await {
            Ok(fresh) => {
                for (k, v) in fresh {
                    insert_header(headers, k, v);
                }
            }
            Err(_) => return false,
        }
    }
    /* With a call hook the headers already carry the trace context as the hook
     * left it (an adapter writes the client span there), so it is not
     * injected over it again. */
    if !hooked {
        trace.inject(headers);
    }
    true
}

/// The URL without its query string and fragment.
fn strip_query_and_fragment(url: &str) -> &str {
    let end = url.find(['?', '#']).unwrap_or(url.len());
    &url[..end]
}

/// The lower-case host of the URL, without port and without the brackets of an
/// IPv6 literal; empty when the URL has no host.
fn server_address_of(url: &str) -> String {
    match reqwest::Url::parse(strip_query_and_fragment(url)) {
        Ok(parsed) => parsed
            .host_str()
            .map(|host| host.trim_start_matches('[').trim_end_matches(']').to_ascii_lowercase())
            .unwrap_or_default(),
        Err(_) => String::new(),
    }
}

/// Reports whether the transport hands a response with this media type back as
/// decoded text (rather than base64), mirroring the text/binary split in
/// `DefaultApiClient`. JSON media types are routed separately by the caller.
fn is_text_media_type(media_type: &str) -> bool {
    let media_type = media_type.to_ascii_lowercase();
    media_type.is_empty()
        || media_type.starts_with("text/")
        || media_type == "application/xml"
        || media_type == "application/javascript"
        || media_type.ends_with("+xml")
}

fn build_query_string(query_params: &[(String, String, bool)]) -> String {
    if query_params.is_empty() {
        return String::new();
    }

    let parts: Vec<String> = query_params
        .iter()
        .map(|(k, v, allow_reserved)| {
            /* OAS allowReserved: a flagged value keeps RFC 3986 reserved
             * characters literal instead of percent-encoding them; the key is
             * always encoded normally. */
            let encoded_value = if *allow_reserved {
                crate::value_serializer::encode_query_allowing_reserved(v)
            } else {
                urlencoding::encode(v).into_owned()
            };
            format!(
                "{}={}",
                urlencoding::encode(k),
                encoded_value
            )
        })
        .collect();

    parts.join("&")
}

/* multipart/form-data serialization (boundary, per-part Content-Type from the
 * field-name extension, RFC 5987 filename handling, non-ASCII field-name UTF-8
 * preservation, repeated-field expansion, field-name validation/escaping) lives
 * in `default_api_client::serialize_multipart_body`. `invoke_api` hands the
 * structured `Vec<(String, MultipartValue)>` to the client as
 * `RequestBody::Multipart`; the client owns the wire format so the same bytes
 * and boundary can be replayed across 307/308 redirects. */

pub(crate) fn serialize_body(
    body: Option<Vec<u8>>,
    content_type: &str,
) -> Result<Option<Vec<u8>>, Box<dyn std::error::Error + Send + Sync>> {
    let body = match body {
        Some(b) => b,
        None => return Ok(None),
    };

    if content_type == "multipart/form-data" {
        /* Multipart is handled separately by the API client */
        return Ok(None);
    }

    if content_type.starts_with("image/") || content_type == "application/octet-stream" {
        return Ok(Some(body));
    }

    if content_type == "text/plain" {
        /* Ensure the body is valid UTF-8 text */
        let text = String::from_utf8(body)?;
        return Ok(Some(text.into_bytes()));
    }

    if content_type == "application/x-www-form-urlencoded" {
        /* Canonical form serialization (identical across every SDK). The body
         * arrives as a JSON array of `[key, value]` pairs in
         * spec-declaration order (built by the operation template). Each value
         * is one of:
         *   - a JSON array  → emitted as REPEATED keys (`tags=a&tags=b`), the
         *                     exploded form (never `tags=a,b` or `tags[]=`);
         *   - JSON null     → OMITTED entirely (an absent optional field must
         *                     not appear as an empty `note=` pair);
         *   - any scalar    → stringified and emitted as a single pair.
         * Encoding uses the shared `form_url_encode` helper so the byte-level
         * escape set matches the OAuth2 token-endpoint helper exactly: a space
         * becomes `+` (the application/x-www-form-urlencoded convention), not
         * `%20`, and every other non-unreserved byte becomes `%XX`. */
        let pairs: Vec<(String, serde_json::Value)> = serde_json::from_slice(&body)?;
        let mut encoded: Vec<String> = Vec::new();
        for (key, value) in pairs {
            match value {
                serde_json::Value::Null => {}
                serde_json::Value::Array(items) => {
                    for item in items {
                        if item.is_null() {
                            continue;
                        }
                        encoded.push(format!(
                            "{}={}",
                            form_url_encode(&key),
                            form_url_encode(&form_scalar_to_string(&key, &item)?)
                        ));
                    }
                }
                scalar => {
                    encoded.push(format!(
                        "{}={}",
                        form_url_encode(&key),
                        form_url_encode(&form_scalar_to_string(&key, &scalar)?)
                    ));
                }
            }
        }
        return Ok(Some(encoded.join("&").into_bytes()));
    }

    /* Default: JSON -- body is already serialized by the caller */
    Ok(Some(body))
}

/// Renders a single JSON scalar as the string form used on the wire for a
/// form-urlencoded value. Mirrors `object_serializer::stringify`: strings pass
/// through unquoted, numbers/booleans use their natural rendering and null
/// becomes empty. An object or nested array has no defined form encoding (the
/// generator does not emit an OAS `encoding` style), so it is rejected with a
/// `SerializationError` rather than guessed at.
fn form_scalar_to_string(
    key: &str,
    value: &serde_json::Value,
) -> Result<String, crate::errors::serialization_error::SerializationError> {
    match value {
        serde_json::Value::String(s) => Ok(s.clone()),
        serde_json::Value::Bool(b) => Ok(b.to_string()),
        serde_json::Value::Number(n) => Ok(n.to_string()),
        serde_json::Value::Null => Ok(String::new()),
        _ => Err(crate::errors::serialization_error::SerializationError::new(
            format!("form-urlencoded field {} must be a scalar or array of scalars", key),
            None,
        )),
    }
}

/// RFC 6265 cookie-name validation (RFC 7230 token).
fn is_valid_cookie_name(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    name.chars().all(|c| {
        c.is_ascii_alphanumeric() || "!#$%&'*+-.^_`|~".contains(c)
    })
}

/// RFC 6265 cookie-value validation (cookie-octet*).
fn is_valid_cookie_value(value: &str) -> bool {
    value.chars().all(|c| {
        let v = c as u32;
        v == 0x21
            || (0x23..=0x2B).contains(&v)
            || (0x2D..=0x3A).contains(&v)
            || (0x3C..=0x5B).contains(&v)
            || (0x5D..=0x7E).contains(&v)
    })
}

