        for attempt in 0u32..6 {
            let base_ms = (500u64 << attempt).min(8_000) as f64;
            let delay_ms = retry_delay(attempt, None).as_millis() as f64;
            assert!(delay_ms >= base_ms * 0.75 && delay_ms <= base_ms * 1.25, "attempt {attempt}: {delay_ms} ms");
        }
    }

    #[test]
    fn test_bhv_retries_027_backoff_doubles_from_half_a_second_to_eight_seconds_with_jitter() {
        use std::time::Duration;
        for (attempt, base_ms) in [(0u32, 500u64), (1, 1_000), (2, 2_000), (3, 4_000), (4, 8_000), (9, 8_000)] {
            for _ in 0..20 {
                let delay = retry_delay(attempt, None);
                assert!(delay <= Duration::from_millis(base_ms), "attempt {}: {:?}", attempt, delay);
                assert!(delay >= Duration::from_millis(base_ms * 3 / 4), "attempt {}: {:?}", attempt, delay);
            }
        }
    }

    #[test]
    fn test_bhv_retries_030_retry_backoff_jitter_takes_at_most_a_quarter_off_the_delay() {
        use std::time::Duration;
        for attempt in 0..5u32 {
            let base_ms = 500u64 * (1u64 << attempt);
            for _ in 0..50 {
                let delay = retry_delay(attempt, None);
                assert!(delay >= Duration::from_millis(base_ms * 3 / 4), "attempt {}: {:?}", attempt, delay);
                assert!(delay <= Duration::from_millis(base_ms), "attempt {}: {:?}", attempt, delay);
            }
        }
    }

    #[test]
    fn test_bhv_retries_041_backoff_starts_at_half_a_second_and_is_capped_at_eight_seconds() {
        use std::time::Duration;
        for _ in 0..50 {
            let first = retry_delay(0, None);
            assert!(first <= Duration::from_millis(500), "{:?}", first);
            assert!(first >= Duration::from_millis(375), "{:?}", first);
            for attempt in 4..=12u32 {
                let delay = retry_delay(attempt, None);
                assert!(delay <= Duration::from_millis(8_000), "attempt {}: {:?}", attempt, delay);
                assert!(delay >= Duration::from_millis(6_000), "attempt {}: {:?}", attempt, delay);
            }
        }
    }

