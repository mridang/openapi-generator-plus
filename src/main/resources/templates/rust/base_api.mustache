        use std::time::Duration;
        assert_eq!(Duration::from_secs(3), retry_delay(0, Some(Duration::from_secs(3))));
        assert_eq!(Duration::from_secs(60), retry_delay(0, Some(Duration::from_secs(3_600))));
    }

