    /* The call hook, recorded: what start saw, what it set and how the call ended. */
    use crate::call_hook::{CallHook, CallInfo, CallObserver, CallOutcome};

    #[derive(Default)]
    struct Seen {
        infos: Vec<CallInfo>,
        headers: Vec<HashMap<String, String>>,
        finished: Vec<(u16, Option<HashMap<String, String>>, String)>,
    }

    struct LogHook {
        seen: Arc<std::sync::Mutex<Seen>>,
        set: Vec<(&'static str, &'static str)>,
        panic_in_start: bool,
        panic_in_finish: bool,
    }

    struct LogObserver {
        seen: Arc<std::sync::Mutex<Seen>>,
        panic_in_finish: bool,
    }

    impl LogHook {
        fn new() -> (Arc<Self>, Arc<std::sync::Mutex<Seen>>) {
            Self::with(Vec::new(), false, false)
        }

        fn with(
            set: Vec<(&'static str, &'static str)>,
            panic_in_start: bool,
            panic_in_finish: bool,
        ) -> (Arc<Self>, Arc<std::sync::Mutex<Seen>>) {
            let seen = Arc::new(std::sync::Mutex::new(Seen::default()));
            (
                Arc::new(Self { seen: seen.clone(), set, panic_in_start, panic_in_finish }),
                seen,
            )
        }
    }

    impl CallHook for LogHook {
        fn start(
            &self,
            info: &CallInfo,
            headers: &mut HashMap<String, String>,
        ) -> Option<Box<dyn CallObserver>> {
            if self.panic_in_start {
                panic!("start refused the call");
            }
            {
                let mut seen = self.seen.lock().unwrap();
                seen.infos.push(info.clone());
                seen.headers.push(headers.clone());
            }
            for (name, value) in &self.set {
                headers.insert(name.to_string(), value.to_string());
            }
            Some(Box::new(LogObserver {
                seen: self.seen.clone(),
                panic_in_finish: self.panic_in_finish,
            }))
        }
    }

    impl CallObserver for LogObserver {
        fn finish(self: Box<Self>, outcome: &CallOutcome<'_>) {
            self.seen.lock().unwrap().finished.push((
                outcome.status_code,
                outcome.headers.cloned(),
                outcome.error.map(|e| e.to_string()).unwrap_or_default(),
            ));
            if self.panic_in_finish {
                panic!("finish failed");
            }
        }
    }

    fn hooked_api(
        client: Arc<ScriptedClient>,
        base_url: &str,
        hook: Arc<dyn CallHook>,
    ) -> BaseApi {
        let config = ConfigurationBuilder::new()
            .base_url(base_url)
            .default_header("X-Call", "from-default")
            .call_hook(hook)
            .build();
        BaseApi::new(client, config, None)
    }

