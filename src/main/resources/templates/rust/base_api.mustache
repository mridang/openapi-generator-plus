        use std::time::Duration;
        assert_eq!(Some(Duration::from_secs(7)), parse_retry_after(" 7 "));
        assert_eq!(Some(Duration::ZERO), parse_retry_after("Sun, 06 Nov 1994 08:49:37 GMT"));
        let later = chrono::Utc::now() + chrono::Duration::seconds(30);
        let wait = parse_retry_after(&later.format("%a, %d %b %Y %H:%M:%S GMT").to_string())
            .expect("an HTTP date");
        assert!(wait <= Duration::from_secs(30) && wait >= Duration::from_secs(28), "{:?}", wait);
        assert_eq!(None, parse_retry_after("soon"));
        assert_eq!(None, parse_retry_after("-3"));
    }

