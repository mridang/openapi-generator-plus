use std::collections::HashMap;

/// Represents an HTTP API response.
#[derive(Debug, Clone)]
pub struct ApiHttpResponse {
    /// The HTTP status code.
    status_code: u16,

    /// The raw response body string.
    body: String,

    /// The response headers (unmodifiable; exposed only through a shared reference).
    headers: HashMap<String, String>,
}

impl ApiHttpResponse {
    /// Creates an ApiHttpResponse with the given values.
    pub fn new(status_code: u16, body: String, headers: HashMap<String, String>) -> Self {
        Self {
            status_code,
            body,
            headers,
        }
    }

    /// Returns the HTTP status code of the response.
    pub fn status_code(&self) -> u16 {
        self.status_code
    }

    /// Returns the raw response body as a string.
    pub fn body(&self) -> &str {
        &self.body
    }

    /// Returns the response headers.
    pub fn headers(&self) -> &HashMap<String, String> {
        &self.headers
    }
}
