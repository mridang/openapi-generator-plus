[package]
name = "{{packageName}}"
version = "{{packageVersion}}"
edition = "2021"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
reqwest = { version = "0.12", features = ["json", "brotli", "gzip", "deflate", "zstd", "multipart"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
base64 = "0.22"
uuid = { version = "1", features = ["v4"] }
regex = "1"
urlencoding = "2"

[features]
default = []
opentelemetry = ["dep:opentelemetry"]

[dependencies.opentelemetry]
version = "0.22"
optional = true

{{#generateTests}}
[dev-dependencies]
testcontainers = { version = "0.24", features = ["blocking"] }
{{/generateTests}}
