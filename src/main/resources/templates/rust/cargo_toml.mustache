[package]
name = "{{packageName}}"
version = "{{packageVersion}}"
edition = "2021"
rust-version = "1.85"
license = "{{licenseId}}"
description = "{{#appDescription}}{{{appDescription}}}{{/appDescription}}{{^appDescription}}Generated API client for {{packageName}}{{/appDescription}}"
{{#hasAuthors}}
authors = [{{#authorsList}}"{{{name}}}"{{^-last}}, {{/-last}}{{/authorsList}}]
{{/hasAuthors}}
{{#repositoryUrl}}
repository = "{{{repositoryUrl}}}"
{{/repositoryUrl}}
{{#homepageUrl}}
homepage = "{{{homepageUrl}}}"
{{/homepageUrl}}
{{#documentationUrl}}
documentation = "{{{documentationUrl}}}"
{{/documentationUrl}}

# Lint configuration for the generated crate.
#
# This is the single, documented home for lint exclusions. No generated source
# file carries `#![allow(...)]` or `#[allow(...)]`: a lint that machine-
# generated code cannot satisfy is named here, once, with the reason it cannot.
# Everything else stays at its default level and `cargo clippy -- -D warnings`
# enforces it.
[lints.rust]
# The SDK has no use for `unsafe`: its shared state sits behind `Arc`, `Mutex`
# and `RwLock`, so `Send` and `Sync` follow from the field types. Forbidding it
# keeps a hand-written `unsafe impl Send` from masking a field that is not.
unsafe_code = "forbid"
# A schema may mark models, fields and operations deprecated, and the generated
# constructors, accessors and tests must still set and read them.
deprecated = "allow"
# The request builders declare their locals (`path`, `query_params`,
# `header_params`, `cookie_parts`, `form_pairs`) up front and mutate them only
# in the branches the operation's parameters emit, so `mut` is unused for an
# operation that declares none of them.
unused_mut = "allow"
# `object_serializer` and `value_serializer` are crate-private and expose a
# complete parameter-encoding helper set (`to_query_value`, `to_header_value`,
# `to_cookie_value`, `to_form_value`, `serialize_value`, ...). A given document
# exercises only the subset its parameter styles require.
dead_code = "allow"

[lints.clippy]
# Operation signatures take one argument per parameter the OpenAPI document
# declares, and their result types are the document's response types.
too_many_arguments = "allow"
type_complexity = "allow"
# Enum variants are emitted verbatim from the document's enum strings
# (`US`, `EU`, `SANDBOX`), which callers match against.
upper_case_acronyms = "allow"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_repr = "0.1"
# `raw_value` lets a `format: decimal` number be read from, and written as, its
# exact source text instead of passing through an `f64`.
serde_json = { version = "1", features = ["unbounded_depth", "preserve_order", "raw_value"] }
reqwest = { version = "0.12", default-features = false, features = ["json", "multipart", "stream", "http2", "charset", "rustls-tls-native-roots"] }
flate2 = "1"
brotli = "7"
zstd = "0.13"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "time", "sync", "fs", "io-util"] }
bytes = "1"
futures-core = "0.3"
futures-util = "0.3"
base64 = "0.22"
sha2 = "0.10"
uuid = { version = "1", features = ["serde", "v4"] }
chrono = { version = "0.4", features = ["serde"] }
rust_decimal = { version = "1", default-features = false, features = ["std", "serde"] }
regex = "1"
urlencoding = "2"
encoding_rs = "0.8"

[features]
default = []
opentelemetry = ["dep:opentelemetry"]

[dependencies.opentelemetry]
version = "0.32"
optional = true
features = ["trace", "metrics"]

[dev-dependencies]
# The in-crate trace-context tests install the OpenTelemetry SDK with an
# in-memory exporter and a current span. They are compiled with the
# `opentelemetry` feature, so run the tests with `--all-features`.
opentelemetry_sdk = { version = "0.32", features = ["testing"] }
{{#hasOAuth2DeviceAuthorization}}
# Paused tokio time lets the device authorization tests poll without waiting.
tokio = { version = "1", features = ["test-util"] }
{{/hasOAuth2DeviceAuthorization}}
{{#generateTests}}
# reusable-containers lets every integration binary share one set of fixture
# containers. Cargo compiles each file under tests/ separately, so without it
# each of them starts its own Squid and Chasm; see tests/testcontainers_helper.rs.
testcontainers = { version = "0.24", features = ["blocking", "reusable-containers"] }
{{/generateTests}}
