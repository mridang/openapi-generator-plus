[package]
name = "{{packageName}}"
version = "{{packageVersion}}"
edition = "2021"
rust-version = "1.85"
license = "{{licenseId}}"
description = "{{#appDescription}}{{appDescription}}{{/appDescription}}{{^appDescription}}Generated API client for {{packageName}}{{/appDescription}}"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_repr = "0.1"
serde_json = "1"
reqwest = { version = "0.12", default-features = false, features = ["json", "multipart", "http2", "charset", "rustls-tls-native-roots"] }
flate2 = "1"
zstd = "0.13"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
base64 = "0.22"
uuid = { version = "1", features = ["serde", "v4"] }
chrono = { version = "0.4", features = ["serde"] }
regex = "1"
urlencoding = "2"
encoding_rs = "0.8"

[features]
default = []
opentelemetry = ["dep:opentelemetry"]

[dependencies.opentelemetry]
version = "0.32"
optional = true

[dev-dependencies]
# The in-crate trace-context tests install the OpenTelemetry SDK with an
# in-memory exporter and a current span. They are compiled with the
# `opentelemetry` feature, so run the tests with `--all-features`.
opentelemetry_sdk = { version = "0.32", features = ["testing"] }
{{#generateTests}}
# reusable-containers lets every integration binary share one set of fixture
# containers. Cargo compiles each file under tests/ separately, so without it
# each of them starts its own Squid and Chasm; see tests/testcontainers_helper.rs.
testcontainers = { version = "0.24", features = ["blocking", "reusable-containers"] }
{{/generateTests}}
