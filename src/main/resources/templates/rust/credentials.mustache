use std::collections::HashMap;
use std::sync::Arc;

use crate::auth::Authenticator;

/// One optional credential for each distinct security scheme of the API, named
/// after the scheme.
///
/// Give the client the credentials it should have with
/// [`{{clientClassName}}::with_credentials`](crate::{{clientClassName}}::with_credentials). Each operation
/// uses the credential of the first scheme its specification requires that is set
/// here, and goes out unauthenticated when none of them is. A single call cannot
/// pick another scheme.
#[derive(Clone, Default)]
pub struct Credentials {
{{#perSchemeAuthEntries}}
    scheme_{{fieldName}}: Option<Arc<dyn Authenticator>>,
{{/perSchemeAuthEntries}}
}

impl Credentials {
    /// Creates a set of credentials with none set.
    pub fn new() -> Self {
        Self::default()
    }
{{#perSchemeAuthEntries}}

    /// Sets the credential of the `{{schemeId}}` security scheme.
    pub fn with_{{fieldName}}(mut self, authenticator: impl Authenticator + 'static) -> Self {
        self.scheme_{{fieldName}} = Some(Arc::new(authenticator));
        self
    }
{{/perSchemeAuthEntries}}

    /// The credentials that are set, by scheme id.
    pub(crate) fn by_scheme(&self) -> HashMap<String, Arc<dyn Authenticator>> {
        let mut credentials: HashMap<String, Arc<dyn Authenticator>> = HashMap::new();
{{#perSchemeAuthEntries}}
        if let Some(authenticator) = &self.scheme_{{fieldName}} {
            credentials.insert("{{schemeId}}".to_string(), authenticator.clone());
        }
{{/perSchemeAuthEntries}}
        credentials
    }
}
