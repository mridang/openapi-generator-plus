use std::collections::{HashMap, VecDeque};
use std::pin::Pin;
use std::task::{Context, Poll};

use futures_core::Stream;

use crate::byte_stream::ByteStream;
use crate::errors::serialization_error::SerializationError;
use crate::event_stream::LineSplitter;

/// Decodes one line of a JSON Lines response into an item.
pub(crate) type LineDecoder<T> = Box<dyn Fn(&str) -> Result<T, SerializationError> + Send + Sync>;

/// The items of a JSON Lines response, decoded one per line as they arrive.
/// Blank lines are skipped, and a last line without a newline counts. A line that
/// does not decode is a [`SerializationError`] that names its 1-based line number
/// and ends the stream, as does a line over `max_event_bytes`.
///
/// It is a [`Stream`] of `Result<T, Box<dyn Error + Send + Sync>>`: iterate it
/// with `StreamExt::next`. [`close`](Self::close) is idempotent and aborts the
/// connection instead of draining it; dropping the stream does the same, so
/// stopping early never leaves a connection busy. A failure of the connection
/// after the headers is the last item, and closing the client cancels the streams
/// still open. The `Debug` and `Display` forms show the status code and the lines
/// read, never the content.
pub struct JsonLinesStream<T> {
    source: ByteStream,
    lines: LineSplitter,
    decoder: LineDecoder<T>,
    method: String,
    path: String,
    ready: VecDeque<String>,
    failed_line: Option<String>,
    line_number: u64,
    ended: bool,
    done: bool,
}

impl<T> JsonLinesStream<T> {
    /// Wraps an open response body.
    pub(crate) fn new(
        source: ByteStream,
        decoder: LineDecoder<T>,
        max_line_bytes: usize,
        method: &str,
        path: &str,
    ) -> Self {
        Self {
            source,
            lines: LineSplitter::new(max_line_bytes),
            decoder,
            method: method.to_string(),
            path: path.to_string(),
            ready: VecDeque::new(),
            failed_line: None,
            line_number: 0,
            ended: false,
            done: false,
        }
    }

    /// Returns the HTTP status code of the response.
    pub fn status_code(&self) -> u16 {
        self.source.status_code()
    }

    /// Returns the response headers, with lower-cased names.
    pub fn headers(&self) -> &HashMap<String, String> {
        self.source.headers()
    }

    /// The number of lines read so far, blank ones included.
    pub fn lines_read(&self) -> u64 {
        self.line_number
    }

    /// Aborts the connection and ends the stream; the next read finds it ended.
    /// Closing again does nothing.
    pub fn close(&mut self) {
        self.done = true;
        self.ready.clear();
        self.source.close();
    }

    fn failure(&self, message: String, cause: Option<Box<dyn std::error::Error + Send + Sync>>) -> Box<dyn std::error::Error + Send + Sync> {
        Box::new(
            SerializationError::new(message, cause)
                .with_response(self.source.status_code(), self.source.headers(), "")
                .with_request(&self.method, &self.path),
        )
    }
}

impl<T> Stream for JsonLinesStream<T> {
    type Item = Result<T, Box<dyn std::error::Error + Send + Sync>>;

    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
        let this = &mut *self;
        loop {
            if this.done {
                return Poll::Ready(None);
            }
            if let Some(line) = this.ready.pop_front() {
                this.line_number += 1;
                if line.trim().is_empty() {
                    continue;
                }
                return match (this.decoder)(&line) {
                    Ok(item) => Poll::Ready(Some(Ok(item))),
                    Err(error) => {
                        let message = format!(
                            "Line {} of the JSON Lines response does not decode: {}",
                            this.line_number, error
                        );
                        let failure = this.failure(message, Some(Box::new(error)));
                        this.close();
                        Poll::Ready(Some(Err(failure)))
                    }
                };
            }
            if let Some(message) = this.failed_line.take() {
                let failure = this.failure(
                    format!(
                        "Line {} of the JSON Lines response is too long: {}",
                        this.line_number + 1,
                        message
                    ),
                    None,
                );
                this.close();
                return Poll::Ready(Some(Err(failure)));
            }
            if this.ended {
                this.close();
                return Poll::Ready(None);
            }
            match Pin::new(&mut this.source).poll_next(cx) {
                Poll::Pending => return Poll::Pending,
                Poll::Ready(Some(Ok(chunk))) => {
                    let mut lines = Vec::new();
                    let split = this.lines.push(&chunk, &mut lines);
                    this.ready.extend(lines);
                    if let Err(too_long) = split {
                        this.failed_line = Some(too_long.to_string());
                    }
                }
                Poll::Ready(Some(Err(error))) => {
                    this.close();
                    return Poll::Ready(Some(Err(error)));
                }
                Poll::Ready(None) => {
                    if let Some(last) = this.lines.finish() {
                        this.ready.push_back(last);
                    }
                    this.ended = true;
                }
            }
        }
    }
}

impl<T> std::fmt::Debug for JsonLinesStream<T> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(
            f,
            "JsonLinesStream(status={}, lines_read={})",
            self.source.status_code(),
            self.line_number
        )
    }
}

impl<T> std::fmt::Display for JsonLinesStream<T> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        std::fmt::Debug::fmt(self, f)
    }
}

#[cfg(test)]
mod tests {
    use std::collections::HashMap;

    use bytes::Bytes;
    use futures_util::StreamExt;

    use super::*;

    fn bytes(text: &'static str) -> ByteStream {
        ByteStream::new(
            200,
            HashMap::new(),
            Box::pin(futures_util::stream::iter(vec![Ok(Bytes::from(text))])),
        )
    }

    fn text_lines(source: ByteStream, limit: usize) -> JsonLinesStream<String> {
        JsonLinesStream::new(source, Box::new(|line| Ok(line.to_string())), limit, "GET", "/items")
    }

    async fn collect(mut stream: JsonLinesStream<String>) -> Vec<String> {
        let mut items = Vec::new();
        while let Some(item) = stream.next().await {
            items.push(item.expect("an item"));
        }
        items
    }

    #[tokio::test]
    async fn test_bhv_streaming_002_a_json_lines_stream_yields_one_decoded_item_per_line_and_skips_blank_lines() {
        let items = collect(text_lines(bytes("a\n\n  \nb\nc\n"), 1024)).await;
        assert_eq!(vec!["a", "b", "c"], items);
    }

    #[tokio::test]
    async fn test_bhv_streaming_003_a_json_lines_stream_accepts_crlf_line_ends_and_a_last_line_without_a_newline() {
        let items = collect(text_lines(bytes("a\r\nb\r\nc"), 1024)).await;
        assert_eq!(vec!["a", "b", "c"], items);
    }

    #[tokio::test]
    async fn test_bhv_streaming_004_a_json_lines_line_that_does_not_decode_names_its_line_and_ends_the_stream() {
        let decoder: LineDecoder<i64> = Box::new(|line| {
            line.parse::<i64>()
                .map_err(|e| SerializationError::new("not a number".to_string(), Some(Box::new(e))))
        });
        let mut stream = JsonLinesStream::new(bytes("1\n2\nnope\n4\n"), decoder, 1024, "GET", "/items");
        assert_eq!(1, stream.next().await.expect("item").expect("decoded"));
        assert_eq!(2, stream.next().await.expect("item").expect("decoded"));
        let failure = stream.next().await.expect("the failure").expect_err("line 3 does not decode");
        let failure = failure.downcast::<SerializationError>().expect("a serialization error");
        assert!(failure.to_string().contains("Line 3"), "{}", failure);
        assert_eq!(Some(200), failure.status_code());
        assert!(stream.next().await.is_none(), "the stream ended at the bad line");
        assert_eq!("JsonLinesStream(status=200, lines_read=3)", format!("{stream}"));
    }
}
