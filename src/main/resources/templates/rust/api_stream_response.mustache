use std::collections::HashMap;
use std::pin::Pin;

use bytes::Bytes;
use futures_core::Stream;

/// The body of a streamed response: chunks in order, ending after the last one.
/// A failure after the headers (a reset, a body shorter than its declared
/// length, a stall longer than the idle timeout) is the last item.
pub type BodyStream =
    Pin<Box<dyn Stream<Item = Result<Bytes, Box<dyn std::error::Error + Send + Sync>>> + Send>>;

/// What [`ApiClient::send_streaming`](crate::api_client::ApiClient::send_streaming)
/// returns: the status, the lower-cased headers and a body that has not been
/// read yet. Dropping it aborts the connection.
pub struct ApiStreamResponse {
    status_code: u16,
    headers: HashMap<String, String>,
    body: BodyStream,
}

impl ApiStreamResponse {
    /// Creates a response from its status, its lower-cased headers and its open body.
    pub fn new(
        status_code: u16,
        headers: HashMap<String, String>,
        body: impl Stream<Item = Result<Bytes, Box<dyn std::error::Error + Send + Sync>>> + Send + 'static,
    ) -> Self {
        Self {
            status_code,
            headers,
            body: Box::pin(body),
        }
    }

    /// Returns the HTTP status code of the response.
    pub fn status_code(&self) -> u16 {
        self.status_code
    }

    /// Returns the response headers, with lower-cased names.
    pub fn headers(&self) -> &HashMap<String, String> {
        &self.headers
    }

    /// Splits the response into its status, its headers and its open body.
    pub fn into_parts(self) -> (u16, HashMap<String, String>, BodyStream) {
        (self.status_code, self.headers, self.body)
    }

    /// Reads at most `limit` bytes of the body and drops the rest, which closes
    /// the connection. A failure in the middle of the body ends the read with
    /// what has arrived.
    pub(crate) async fn read_bounded(self, limit: usize) -> (u16, HashMap<String, String>, Vec<u8>) {
        use futures_util::StreamExt as _;
        let (status_code, headers, mut body) = self.into_parts();
        let mut collected: Vec<u8> = Vec::new();
        while collected.len() < limit {
            match body.next().await {
                Some(Ok(chunk)) => {
                    let room = limit - collected.len();
                    collected.extend_from_slice(&chunk[..chunk.len().min(room)]);
                }
                Some(Err(_)) | None => break,
            }
        }
        (status_code, headers, collected)
    }
}

impl std::fmt::Debug for ApiStreamResponse {
    /// Shows the status code only: the headers can carry credentials and the
    /// body is not read.
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("ApiStreamResponse")
            .field("status_code", &self.status_code)
            .finish()
    }
}
