.PHONY: all build test lint format audit docs clean{{#generateExamples}} examples examples-run{{/generateExamples}}

all: build

format:
	cargo fmt

lint:
	cargo fmt -- --check
	cargo clippy --all-targets --all-features -- -D warnings

audit:
	cargo deny check

build:
	cargo build

test:
	cargo llvm-cov nextest --all-features --cobertura --output-path .out/coverage.xml --profile ci

docs:
	RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --target-dir .out/cargo-doc
	rm -rf .out/docs
	cp -r .out/cargo-doc/doc .out/docs

clean:
	cargo clean
{{#generateExamples}}

# Builds every program under examples/ as a cargo example target.
examples:
	cargo build --examples

examples-run: examples
	{{envPrefix}}_BASE_URL="$(API_BASE_URL)" {{envPrefix}}_ACCESS_TOKEN=placeholder cargo run --example quickstart
{{/generateExamples}}
