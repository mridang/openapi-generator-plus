use base64::{Engine as _, engine::general_purpose::STANDARD};
use serde::{Deserialize, Deserializer, Serializer, de};

/// Serialize/deserialize a `Vec<u8>` as a base64-encoded string.
pub fn serialize<S: Serializer>(data: &Vec<u8>, s: S) -> Result<S::Ok, S::Error> {
    s.serialize_str(&STANDARD.encode(data))
}

/// Deserialize a base64-encoded string into a `Vec<u8>`.
pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<u8>, D::Error> {
    let s = String::deserialize(d)?;
    STANDARD.decode(&s).map_err(de::Error::custom)
}

/// Serialize/deserialize `Option<Vec<u8>>` as an optional base64-encoded string.
pub mod option {
    use super::*;

    pub fn serialize<S: Serializer>(data: &Option<Vec<u8>>, s: S) -> Result<S::Ok, S::Error> {
        match data {
            Some(d) => s.serialize_str(&STANDARD.encode(d)),
            None => s.serialize_none(),
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Option<Vec<u8>>, D::Error> {
        let s: Option<String> = Option::deserialize(d)?;
        match s {
            Some(s) => STANDARD.decode(&s).map(Some).map_err(de::Error::custom),
            None => Ok(None),
        }
    }
}

/// Serialize/deserialize `Vec<Vec<u8>>` as an array of base64-encoded strings.
pub mod vec {
    use super::*;
    use serde::ser::SerializeSeq;

    pub fn serialize<S: Serializer>(data: &Vec<Vec<u8>>, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(data.len()))?;
        for item in data {
            seq.serialize_element(&STANDARD.encode(item))?;
        }
        seq.end()
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<Vec<u8>>, D::Error> {
        let strings: Vec<String> = Vec::deserialize(d)?;
        strings
            .into_iter()
            .map(|s| STANDARD.decode(&s).map_err(de::Error::custom))
            .collect()
    }
}

/// Serialize/deserialize `Option<Vec<Vec<u8>>>` as an optional array of base64-encoded strings.
pub mod vec_option {
    use super::*;

    pub fn serialize<S: Serializer>(data: &Option<Vec<Vec<u8>>>, s: S) -> Result<S::Ok, S::Error> {
        match data {
            Some(d) => super::vec::serialize(d, s),
            None => s.serialize_none(),
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(
        d: D,
    ) -> Result<Option<Vec<Vec<u8>>>, D::Error> {
        let opt: Option<Vec<String>> = Option::deserialize(d)?;
        match opt {
            Some(strings) => strings
                .into_iter()
                .map(|s| STANDARD.decode(&s).map_err(de::Error::custom))
                .collect::<Result<Vec<_>, _>>()
                .map(Some),
            None => Ok(None),
        }
    }
}
