use base64::{Engine as _, engine::general_purpose::STANDARD};
use serde::{Deserialize, Deserializer, Serializer, de};

/// Serialize/deserialize a `Vec<u8>` as a base64-encoded string.
pub fn serialize<S: Serializer>(data: &Vec<u8>, s: S) -> Result<S::Ok, S::Error> {
    s.serialize_str(&STANDARD.encode(data))
}

/// Deserialize a base64-encoded string into a `Vec<u8>`.
pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<u8>, D::Error> {
    let s = String::deserialize(d)?;
    STANDARD.decode(&s).map_err(de::Error::custom)
}

/// Serialize/deserialize `Option<Vec<u8>>` as an optional base64-encoded string.
pub mod option {
    use super::*;

    pub fn serialize<S: Serializer>(data: &Option<Vec<u8>>, s: S) -> Result<S::Ok, S::Error> {
        match data {
            Some(d) => s.serialize_str(&STANDARD.encode(d)),
            None => s.serialize_none(),
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Option<Vec<u8>>, D::Error> {
        let s: Option<String> = Option::deserialize(d)?;
        match s {
            Some(s) => STANDARD.decode(&s).map(Some).map_err(de::Error::custom),
            None => Ok(None),
        }
    }
}

/// Serialize/deserialize `Vec<Vec<u8>>` as an array of base64-encoded strings.
pub mod vec {
    use super::*;
    use serde::ser::SerializeSeq;

    pub fn serialize<S: Serializer>(data: &Vec<Vec<u8>>, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(data.len()))?;
        for item in data {
            seq.serialize_element(&STANDARD.encode(item))?;
        }
        seq.end()
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<Vec<u8>>, D::Error> {
        let strings: Vec<String> = Vec::deserialize(d)?;
        strings
            .into_iter()
            .map(|s| STANDARD.decode(&s).map_err(de::Error::custom))
            .collect()
    }
}

/// Serialize/deserialize `Option<Vec<Vec<u8>>>` as an optional array of base64-encoded strings.
pub mod vec_option {
    use super::*;

    pub fn serialize<S: Serializer>(data: &Option<Vec<Vec<u8>>>, s: S) -> Result<S::Ok, S::Error> {
        match data {
            Some(d) => super::vec::serialize(d, s),
            None => s.serialize_none(),
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(
        d: D,
    ) -> Result<Option<Vec<Vec<u8>>>, D::Error> {
        let opt: Option<Vec<String>> = Option::deserialize(d)?;
        match opt {
            Some(strings) => strings
                .into_iter()
                .map(|s| STANDARD.decode(&s).map_err(de::Error::custom))
                .collect::<Result<Vec<_>, _>>()
                .map(Some),
            None => Ok(None),
        }
    }
}

/// Serialize/deserialize `HashMap<String, Vec<u8>>` as a map of base64-encoded strings.
pub mod map {
    use super::*;
    use serde::ser::SerializeMap;
    use std::collections::HashMap;

    pub fn serialize<S: Serializer>(
        data: &HashMap<String, Vec<u8>>,
        s: S,
    ) -> Result<S::Ok, S::Error> {
        /* Ascending key order, so the bytes do not depend on the per-process
         * `HashMap` order (F1090). */
        let mut entries: Vec<(&String, &Vec<u8>)> = data.iter().collect();
        entries.sort_by(|a, b| a.0.cmp(b.0));
        let mut map = s.serialize_map(Some(entries.len()))?;
        for (k, v) in entries {
            map.serialize_entry(k, &STANDARD.encode(v))?;
        }
        map.end()
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(
        d: D,
    ) -> Result<HashMap<String, Vec<u8>>, D::Error> {
        let strings: HashMap<String, String> = HashMap::deserialize(d)?;
        strings
            .into_iter()
            .map(|(k, v)| STANDARD.decode(&v).map(|b| (k, b)).map_err(de::Error::custom))
            .collect()
    }
}

/// Serialize/deserialize `Option<HashMap<String, Vec<u8>>>` as an optional map of base64-encoded strings.
pub mod map_option {
    use super::*;
    use std::collections::HashMap;

    pub fn serialize<S: Serializer>(
        data: &Option<HashMap<String, Vec<u8>>>,
        s: S,
    ) -> Result<S::Ok, S::Error> {
        match data {
            Some(d) => super::map::serialize(d, s),
            None => s.serialize_none(),
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(
        d: D,
    ) -> Result<Option<HashMap<String, Vec<u8>>>, D::Error> {
        let opt: Option<HashMap<String, String>> = Option::deserialize(d)?;
        match opt {
            Some(strings) => strings
                .into_iter()
                .map(|(k, v)| STANDARD.decode(&v).map(|b| (k, b)).map_err(de::Error::custom))
                .collect::<Result<HashMap<_, _>, _>>()
                .map(Some),
            None => Ok(None),
        }
    }
}

#[cfg(test)]
mod tests {
    use serde::{Deserialize, Serialize};
    use std::collections::HashMap;

    #[derive(Serialize, Deserialize)]
    struct Bare {
        #[serde(with = "super::map")]
        blobs: HashMap<String, Vec<u8>>,
    }

    #[derive(Serialize, Deserialize)]
    struct Optional {
        #[serde(with = "super::map_option")]
        blobs: Option<HashMap<String, Vec<u8>>>,
    }

    fn blobs() -> HashMap<String, Vec<u8>> {
        (0..16u8)
            .rev()
            .map(|i| (format!("key{:02}", i), vec![i]))
            .collect()
    }

    fn expected() -> String {
        let entries: Vec<String> = (0..16u8)
            .map(|i| {
                use base64::{Engine as _, engine::general_purpose::STANDARD};
                format!("\"key{:02}\":\"{}\"", i, STANDARD.encode([i]))
            })
            .collect();
        let mut json = String::from("{\"blobs\":");
        json.push('{');
        json.push_str(&entries.join(","));
        json.push_str("}}");
        json
    }

    /* A map of byte arrays is written in ascending key order, so the body
     * bytes are the same in every process. */
    #[test]
    fn test_bhv_langrust_011_map_of_byte_arrays_is_written_in_ascending_key_order() {
        let json = serde_json::to_string(&Bare { blobs: blobs() }).expect("serializes");
        assert_eq!(expected(), json);
    }

    #[test]
    fn test_bhv_langrust_012_optional_map_of_byte_arrays_is_written_in_ascending_key_order() {
        let json = serde_json::to_string(&Optional { blobs: Some(blobs()) }).expect("serializes");
        assert_eq!(expected(), json);
        let none = serde_json::to_string(&Optional { blobs: None }).expect("serializes");
        assert_eq!("{\"blobs\":null}", none);
    }

    #[test]
    fn test_bhv_langrust_013_map_of_byte_arrays_round_trips_by_content() {
        let json = serde_json::to_string(&Bare { blobs: blobs() }).expect("serializes");
        let back: Bare = serde_json::from_str(&json).expect("deserializes");
        assert_eq!(blobs(), back.blobs);
    }
}
