    /* Rust pins the same 1000-deep JSON nesting cap as the other eleven SDKs
     * (MAX_JSON_DEPTH), enforced by the byte-scan with serde_json's own ~128-deep
     * recursion limit disabled. A payload nested between serde's default limit
     * and the cap (e.g. 500) must now DECODE (it was rejected before the cap was
     * added), while one deeper than the cap is rejected as a SerializationError. */
    #[test]
    fn test_bhv_serializationobject_051_json_nesting_depth_cap_matches_other_sdks() {
        let shallow = format!("{}{}", "[".repeat(50), "]".repeat(50));
        let ok: Result<Option<serde_json::Value>, _> =
            object_serializer::deserialize(shallow.as_bytes());
        assert!(ok.is_ok(), "a shallow payload must decode");

        /* 500 is past serde_json's built-in ~128 limit but within the 1000 cap:
         * it must decode, proving the cap (not serde's default) is the authority. */
        let mid = format!("{}{}", "[".repeat(500), "]".repeat(500));
        let mid_ok: Result<Option<serde_json::Value>, _> =
            object_serializer::deserialize(mid.as_bytes());
        assert!(mid_ok.is_ok(), "a payload within the 1000-deep cap must decode");

        let deep = format!("{}{}", "[".repeat(1500), "]".repeat(1500));
        let err: Result<Option<serde_json::Value>, _> =
            object_serializer::deserialize(deep.as_bytes());
        assert!(err.is_err(), "a payload deeper than the 1000 cap must be rejected");
    }

