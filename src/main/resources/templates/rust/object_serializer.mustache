/// Serde adapter for `uniqueItems` arrays: the set is written in ascending
/// natural order when every member is a scalar (numbers numerically, strings
/// and enum wire values by Unicode code point, `false` before `true`), so the
/// bytes are identical on every run whatever the set's hash order. A set of
/// objects keeps the set's own (unspecified) order.
pub mod sorted_set {
    use serde::{Serialize, Serializer};

    fn ordered<T: Serialize>(members: impl Iterator<Item = T>) -> Result<Vec<serde_json::Value>, serde_json::Error> {
        let mut values = members.map(serde_json::to_value).collect::<Result<Vec<_>, _>>()?;
        let all_numbers = values.iter().all(serde_json::Value::is_number);
        let all_strings = values.iter().all(serde_json::Value::is_string);
        let all_bools = values.iter().all(serde_json::Value::is_boolean);
        if all_numbers {
            values.sort_by(|a, b| {
                let (x, y) = (a.as_f64().unwrap_or(0.0), b.as_f64().unwrap_or(0.0));
                x.total_cmp(&y)
            });
        } else if all_strings {
            values.sort_by(|a, b| a.as_str().cmp(&b.as_str()));
        } else if all_bools {
            values.sort_by_key(|v| v.as_bool());
        }
        Ok(values)
    }

    pub fn serialize<'a, C, T, S>(set: &'a C, serializer: S) -> Result<S::Ok, S::Error>
    where
        &'a C: IntoIterator<Item = &'a T>,
        T: Serialize + 'a,
        S: Serializer,
    {
        ordered(set.into_iter())
            .map_err(serde::ser::Error::custom)?
            .serialize(serializer)
    }

    /// The same adapter for an optional field.
    pub fn option<'a, C, T, S>(set: &'a Option<C>, serializer: S) -> Result<S::Ok, S::Error>
    where
        &'a C: IntoIterator<Item = &'a T>,
        T: Serialize + 'a,
        S: Serializer,
    {
        match set {
            Some(members) => serialize(members, serializer),
            None => serializer.serialize_none(),
        }
    }
}

/// Decode check for `format: uri` fields: the text must be an absolute RFC 3986
/// URI (a scheme, then `:`, with no whitespace or control characters anywhere).
/// Any scheme is accepted (`https:`, `ftp:`, `mailto:`, `urn:`); a relative
/// reference or an empty string is a decode error. The accepted text is kept
/// byte for byte, so encoding writes back exactly what was decoded.
pub mod absolute_uri {
    use serde::{Deserialize, Deserializer};

    /// Returns `true` when `text` is an absolute URI per RFC 3986 section 3.
    pub fn is_absolute(text: &str) -> bool {
        let Some((scheme, _)) = text.split_once(':') else {
            return false;
        };
        let mut chars = scheme.chars();
        chars.next().is_some_and(|c| c.is_ascii_alphabetic())
            && chars.all(|c| c.is_ascii_alphanumeric() || matches!(c, '+' | '-' | '.'))
            && !text.chars().any(|c| c.is_whitespace() || c.is_control())
    }

    fn check<E: serde::de::Error>(text: String) -> Result<String, E> {
        if is_absolute(&text) {
            Ok(text)
        } else {
            Err(E::custom(format!("'{text}' is not an absolute URI")))
        }
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<String, D::Error> {
        check(String::deserialize(deserializer)?)
    }

    /// The same check for an optional field.
    pub fn option<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Option<String>, D::Error> {
        Option::<String>::deserialize(deserializer)?.map(check).transpose()
    }
}

/// Decode adapter for a property that is both required and nullable. The key
/// must be present (an absent key is a decode error, unlike a plain optional
/// field), and an explicit `null` is a legal value that decodes to `None`.
/// serde treats a missing `Option` field as `None`, but any field that names a
/// `deserialize_with` function is required, so naming this one makes the key
/// mandatory while still accepting `null`.
pub mod required_nullable {
    use serde::{Deserialize, Deserializer};

    pub fn deserialize<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
    where
        D: Deserializer<'de>,
        T: Deserialize<'de>,
    {
        Option::<T>::deserialize(deserializer)
    }
}

/// Writes a model's additional properties, leaving out every key that is the
/// wire name of one of its `declared` properties: the declared value wins and
/// no key is ever written twice. The keys are written in ascending order: a
/// `HashMap` iterates in a per-process random order, which would make the bytes
/// of a body with two or more extras differ from run to run.
pub fn serialize_extras<V: Serialize, S: serde::Serializer>(
    extras: &std::collections::HashMap<String, V>,
    declared: &[&str],
    serializer: S,
) -> Result<S::Ok, S::Error> {
    let mut entries: Vec<(&String, &V)> =
        extras.iter().filter(|(key, _)| !declared.contains(&key.as_str())).collect();
    entries.sort_by(|a, b| a.0.cmp(b.0));
    serializer.collect_map(entries)
}

/// Returns the wire text of the parameter types whose form is not their serde
/// form: `format: byte` (`Vec<u8>`) is padded standard-alphabet base64 rather
/// than a number array, `format: time` is [`format_time`], and `format: duration`
/// is the protobuf-JSON string of `crate::proto_duration::format` (chrono's own
/// serde form is a `{secs, nanos}` struct).
pub fn scalar_override<T: 'static>(value: &T) -> Option<String> {
    use base64::Engine as _;
    let any = value as &dyn std::any::Any;
    if let Some(bytes) = any.downcast_ref::<Vec<u8>>() {
        return Some(base64::engine::general_purpose::STANDARD.encode(bytes));
    }
    if let Some(duration) = any.downcast_ref::<chrono::TimeDelta>() {
        return Some(crate::proto_duration::format(duration));
    }
    /* A decimal parameter is written in plain notation with every digit;
     * rust_decimal's own serde form would quote it. */
    if let Some(decimal) = any.downcast_ref::<rust_decimal::Decimal>() {
        return Some(decimal.to_string());
    }
    any.downcast_ref::<chrono::NaiveTime>().map(format_time)
}

/// Converts a single scalar value to its string representation.
///
/// This is the canonical type-conversion method used by all parameter
/// encoding helpers (`to_path_value`, `to_query_value`, etc.) and by
/// `value_serializer` for transport formatting.
///
/// Booleans produce lowercase `"true"`/`"false"`, null produces the empty
/// string, and strings pass through unquoted.
pub fn stringify<T: Serialize + 'static>(value: &T) -> String {
    if let Some(text) = scalar_override(value) {
        return text;
    }
    match serde_json::to_value(value) {
        Ok(serde_json::Value::String(s)) => s,
        Ok(serde_json::Value::Bool(b)) => b.to_string(),
        Ok(serde_json::Value::Number(n)) => n.to_string(),
        Ok(serde_json::Value::Null) => String::new(),
        Ok(other) => other.to_string(),
        Err(_) => String::new(),
    }
}

/// Converts a value to a string suitable for use as a URL path parameter.
///
/// The value's own type determines its wire form: a `format: date` parameter
/// is a `chrono::NaiveDate` and already serializes to `YYYY-MM-DD`, while a
/// `format: date-time` parameter is a `DateTime` and serializes to the full
/// RFC 3339 instant. This is a plain stringify with no date-shape heuristic —
/// an earlier version truncated ANY RFC-3339-shaped string to its date part,
/// which silently corrupted a genuine date-time path value to date-only.
pub fn to_path_value<T: Serialize + 'static>(value: &T) -> String {
    stringify(value)
}

/// Represents a query parameter value, which can be either a single string
/// or multiple values (for the "multi" collection format).
#[derive(Debug, Clone)]
pub enum QueryValue {
    Single(String),
    Multi(Vec<String>),
}

/// Converts a value to a representation suitable for use as a query parameter.
/// For collections, joins using the specified collection format delimiter.
/// Returns `QueryValue::Multi` for the "multi" format, `QueryValue::Single` otherwise.
pub fn to_query_value<T: Serialize + 'static>(value: &T, collection_format: &str) -> QueryValue {
    /* A time-of-day query value keeps non-zero milliseconds and drops finer precision (D103). */
    if let Some(time) = (value as &dyn std::any::Any).downcast_ref::<chrono::NaiveTime>() {
        return QueryValue::Single(format_time(time));
    }
    if let Some(text) = scalar_override(value) {
        return QueryValue::Single(text);
    }
    let json_value = match serde_json::to_value(value) {
        Ok(v) => v,
        Err(_) => return QueryValue::Single(String::new()),
    };

    match json_value {
        serde_json::Value::Array(items) => {
            let strings: Vec<String> = items
                .iter()
                .map(|item| match item {
                    serde_json::Value::String(s) => s.clone(),
                    serde_json::Value::Null => String::new(),
                    other => other.to_string(),
                })
                .collect();
            join_collection(&strings, collection_format)
        }
        serde_json::Value::String(s) => QueryValue::Single(s),
        serde_json::Value::Null => QueryValue::Single(String::new()),
        other => QueryValue::Single(other.to_string()),
    }
}

/// Converts a value to a string suitable for use as an HTTP header value.
pub fn to_header_value<T: Serialize + 'static>(value: &T) -> String {
    if let Some(text) = scalar_override(value) {
        return text;
    }
    let json_value = match serde_json::to_value(value) {
        Ok(v) => v,
        Err(_) => return String::new(),
    };

    match json_value {
        serde_json::Value::Array(items) => {
            let strings: Vec<String> = items
                .iter()
                .map(|item| match item {
                    serde_json::Value::String(s) => s.clone(),
                    serde_json::Value::Null => String::new(),
                    other => other.to_string(),
                })
                .collect();
            strings.join(",")
        }
        serde_json::Value::String(s) => s,
        serde_json::Value::Null => String::new(),
        other => other.to_string(),
    }
}

/// Converts a value to a string suitable for use as an HTTP cookie value.
/// Cookie values follow the same encoding rules as header values.
pub fn to_cookie_value<T: Serialize + 'static>(value: &T) -> String {
    to_header_value(value)
}

/// Converts a value to a representation suitable for use as a form parameter.
pub fn to_form_value<T: Serialize + 'static>(value: &T) -> String {
    stringify(value)
}

fn join_collection(items: &[String], collection_format: &str) -> QueryValue {
    match collection_format {
        "multi" => QueryValue::Multi(items.to_vec()),
        "ssv" => QueryValue::Single(items.join(" ")),
        "tsv" => QueryValue::Single(items.join("\t")),
        "pipes" => QueryValue::Single(items.join("|")),
        _ => QueryValue::Single(items.join(",")),
    }
}

/* These tests live in-crate (rather than under tests/) because
 * `object_serializer` is a crate-private module (an internal (de)serialization
 * detail, not part of the public API), so they would otherwise be unable to
 * reach the module from the external integration-test crate. */
#[cfg(test)]
mod tests {
    use super::{
        self as object_serializer, deserialize, encode_content_cookie, object_query_pairs, serialize,
        to_header_value, to_query_value, QueryValue, SerializationError,
    };

    fn sample_object() -> std::collections::HashMap<String, serde_json::Value> {
        let mut map: std::collections::HashMap<String, serde_json::Value> =
            std::collections::HashMap::new();
        map.insert("min_age".to_string(), serde_json::json!(3));
        map.insert("breed".to_string(), serde_json::json!("lab"));
        map.insert("skipped".to_string(), serde_json::Value::Null);
        map
    }

    /* D47: an object-valued parameter is expanded per property, in declaration
     * order for a model and in key order for a map; a nested value is refused. */
    #[test]
    fn test_bhv_serializationparam_036_object_query_pairs_one_entry_per_property() {
        let map = sample_object();

        assert_eq!(
            Some(vec![
                ("breed".to_string(), "lab".to_string()),
                ("min_age".to_string(), "3".to_string())
            ]),
            object_serializer::object_query_pairs(&map, "form", true).unwrap()
        );
    }

    #[test]
    fn test_bhv_serializationparam_039_stringify_param_form_not_exploded_is_one_list() {
        let map = sample_object();

        assert_eq!(None, object_serializer::object_query_pairs(&map, "form", false).unwrap());
        assert_eq!(
            "breed,lab,min_age,3",
            object_serializer::stringify_param(&map, "form", false).unwrap()
        );
    }

    #[test]
    fn test_bhv_serializationparam_082_stringify_param_simple_object_is_a_header_list() {
        let map = sample_object();

        assert_eq!(
            "breed,lab,min_age,3",
            object_serializer::stringify_param(&map, "simple", false).unwrap()
        );
        assert_eq!(
            "breed=lab,min_age=3",
            object_serializer::stringify_param(&map, "simple", true).unwrap()
        );
    }

    #[test]
    fn test_bhv_serialization_016_object_valued_parameters_pipe_delimited_and_nested_values() {
        let mut map = sample_object();

        assert_eq!(
            "breed|lab|min_age|3",
            object_serializer::stringify_param(&map, "pipeDelimited", false).unwrap()
        );
        assert_eq!("lab", object_serializer::stringify_param(&"lab".to_string(), "form", true).unwrap());

        map.insert("nested".to_string(), serde_json::json!({"a": 1}));
        assert!(object_serializer::stringify_param(&map, "form", false).is_err());
        assert!(object_serializer::object_query_pairs(&map, "form", true).is_err());
    }

    /* D84: request JSON writes U+2028, U+2029, DEL, `/`, `<`, `>`, `&` and
     * non-ASCII literally; only the quote, the backslash and controls below
     * U+0020 are escaped. */
    #[test]
    fn test_bhv_serializationobject_124_request_json_writes_line_separators_and_del_literally() {
        let value = serde_json::json!({"k": "a\u{2028}b\u{2029}c\u{7f}/<>&\u{e9}\"\\\n"});
        let json = object_serializer::serialize(&value).expect("serializes");
        assert_eq!(
            "{\"k\":\"a\u{2028}b\u{2029}c\u{7f}/<>&\u{e9}\\\"\\\\\\n\"}",
            json
        );
    }

    /* F933 / D15: the serializer's messages keep one prefix per direction, so a
     * caller (and the other SDKs' tests) can tell a request that could not be
     * written from a response that could not be read. */
    #[test]
    fn test_bhv_serializationobject_200_a_serialize_failure_carries_the_canonical_prefix_and_the_detail() {
        let non_finite = object_serializer::serialize(&f64::NAN).expect_err("NaN is refused");
        assert_eq!(
