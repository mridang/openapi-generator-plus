    fn test_bhv_serializationparam_104_the_content_cookie_encoding_keeps_only_the_unreserved_set_literal_and_a_duration_is_protobuf_form() {
        /* Every ASCII byte: A-Z a-z 0-9 - _ ~ stays literal and every other byte,
         * the dot included, is written as %XX, the encoding a content cookie uses. */
        for byte in 0u8..=0x7f {
            let text = (byte as char).to_string();
            let encoded = encode_content_cookie(&text);
            let unreserved = (byte as char).is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'~');
            if unreserved {
                assert_eq!(text, encoded, "byte {:#04x} must stay literal", byte);
            } else {
                assert_eq!(format!("%{:02X}", byte), encoded, "byte {:#04x} must be percent-encoded", byte);
            }
        }

        assert_eq!(crate::proto_duration::format(&chrono::TimeDelta::hours(1)), "3600s");
    }

