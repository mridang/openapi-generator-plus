    /* A non-finite float (NaN, ±Infinity) must reject on ENCODE with a
     * SerializationError. serde_json silently encodes such a value as JSON
     * `null` (RFC 8259 §6 has no NaN/Infinity token); the FiniteFloatCheck
     * pre-flight walk surfaces it, at the top level and nested in a struct. */
    #[test]
    fn test_bhv_serializationobject_153_serialize_non_finite_float_is_error() {
        #[derive(serde::Serialize)]
        struct Holder {
            weight: f64,
        }
        assert!(object_serializer::serialize(&Holder { weight: f64::NAN }).is_err());
        assert!(object_serializer::serialize(&Holder { weight: f64::INFINITY }).is_err());
        assert!(object_serializer::serialize(&f64::NEG_INFINITY).is_err());
        /* A finite float still serializes cleanly. */
        assert!(object_serializer::serialize(&Holder { weight: 1.5 }).is_ok());
    }

