            case: &str,
            payload: &[u8],
        ) {
            let err = object_serializer::deserialize::<T>(payload)
                .expect_err(&format!("{} must fail", case));
            let _: &dyn crate::errors::{{errorPrefix}}Error = &err;
            assert!(!err.to_string().is_empty(), "{}", case);
