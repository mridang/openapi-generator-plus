     * custom Deserialize routing on foodType="dry", not fall through to a
     * silent untagged match. */
    #[test]
    fn test_bhv_serializationobject_055_deserialize_parent_routes_to_subtype() {
        let payload = br#"{"foodType":"dry","weightKg":2.5}"#;
        let result: Option<PetFood> =
            object_serializer::deserialize(payload).expect("deserialize must succeed");
        match result.expect("expected Some(PetFood)") {
            PetFood::DryFood(dry) => assert_eq!(dry.weight_kg, 2.5),
            other => panic!("expected PetFood::DryFood, got: {other:?}"),
        }
    }

    /* JSON `null` on a required, non-nullable field must HARD-FAIL
     * deserialization. The payload `{"name": null, "photoUrls": ["u"]}` sets
     * the required `name` (a plain `String`, not `Option<String>`) to JSON
     * null. serde's derived `Deserialize` rejects the null because the field is
     * non-Option, surfacing the SDK's SerializationError rather than silently
     * constructing a Pet with an empty/partial `name`. */
    #[test]
    fn test_bhv_serializationobject_062_null_on_required_field_rejected() {
        let payload = br#"{"name":null,"photoUrls":["u"]}"#;
        let result: Result<Option<Pet>, SerializationError> =
            object_serializer::deserialize(payload);
        assert!(
            result.is_err(),
            "null on the required non-nullable `name` must be rejected"
        );
    }

    /* A discriminator value the spec does not list, or an empty one, must
     * HARD-FAIL as a SerializationError that names the problem, never dispatch
     * to a variant whose fields happen to fit. */

    /* A discriminated oneOf payload that omits the discriminator property must
     * HARD-FAIL, not wrap the raw object in a union container. The payload
     * `{"weightKg": 5.0}` omits `foodType`; PetFood's hand-rolled Deserialize
     * reads the discriminator field and returns an Err when it is absent
     * (rather than serde-untagged's "try every variant" fall-through). */
    #[test]
    fn test_bhv_serializationobject_085_missing_discriminator_rejected() {
        let payload = br#"{"weightKg":5.0}"#;
        let result: Result<Option<PetFood>, SerializationError> =
            object_serializer::deserialize(payload);
        assert!(
            result.is_err(),
            "PetFood missing the `foodType` discriminator must be rejected"
        );
    }

    #[test]
    fn test_bhv_serializationobject_008_uri_property_accepts_any_absolute_uri_and_rejects_relative_references() {
        for uri in [
