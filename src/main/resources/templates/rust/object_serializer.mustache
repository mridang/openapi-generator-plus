/// Maximum JSON nesting depth accepted on deserialize. Matches the cap the
/// other SDKs pin (java/kotlin/csharp/python/dart/ruby/node/swift/php/go/elixir
/// all use 1000) so a deeply-nested response is rejected uniformly rather than
/// at serde_json's differing built-in recursion limit.
const MAX_JSON_DEPTH: usize = 1000;

/// Returns the maximum `{`/`[` nesting depth in the JSON bytes, ignoring
/// braces/brackets inside strings. A cheap pre-flight scan (mirrors the
/// go SDK's `jsonMaxDepth`) run before serde_json's recursive parser.
fn json_max_depth(data: &[u8]) -> usize {
    let mut depth: usize = 0;
    let mut max: usize = 0;
    let mut in_string = false;
    let mut escaped = false;
    for &b in data {
        if in_string {
            if escaped {
                escaped = false;
            } else if b == b'\\' {
                escaped = true;
            } else if b == b'"' {
                in_string = false;
            }
            continue;
        }
        match b {
            b'"' => in_string = true,
            b'{' | b'[' => {
                depth += 1;
                if depth > max {
                    max = depth;
                }
            }
            b'}' | b']' => {
                depth = depth.saturating_sub(1);
            }
            _ => {}
        }
    }
    max
}

/// Sentinel error raised by [`FiniteFloatCheck`] the moment it walks a
/// non-finite float (NaN or ±Infinity). It carries no message of its own —
/// [`serialize`] maps it to the SDK's [`SerializationError`].
#[derive(Debug)]
struct NonFiniteError;

impl std::fmt::Display for NonFiniteError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(
            f,
            "non-finite float (NaN or Infinity) is not permitted by RFC 8259"
        )
    }
}

impl std::error::Error for NonFiniteError {}

impl serde::ser::Error for NonFiniteError {
    fn custom<T: std::fmt::Display>(_msg: T) -> Self {
        NonFiniteError
    }
}

/// A `serde::Serializer` that produces no output and exists only to reject a
/// non-finite float anywhere inside a value BEFORE it reaches `serde_json`.
///
/// `serde_json` silently encodes a NaN or ±Infinity float as JSON `null`
/// (RFC 8259 §6 has no such token), which would corrupt the wire form and
/// diverge from the other SDKs, which reject non-finite floats. Walking the
/// value first lets [`serialize`] fail loudly with a [`SerializationError`].
/// Every scalar is a no-op except `serialize_f32`/`serialize_f64`, which error
/// on a non-finite value; the compound impls recurse so a float nested in a
/// struct, map or sequence is checked too.
#[derive(Clone, Copy)]
struct FiniteFloatCheck;

impl serde::Serializer for FiniteFloatCheck {
    type Ok = ();
    type Error = NonFiniteError;
    type SerializeSeq = Self;
    type SerializeTuple = Self;
    type SerializeTupleStruct = Self;
    type SerializeTupleVariant = Self;
    type SerializeMap = Self;
    type SerializeStruct = Self;
    type SerializeStructVariant = Self;

    fn serialize_bool(self, _v: bool) -> Result<(), NonFiniteError> { Ok(()) }
    fn serialize_i8(self, _v: i8) -> Result<(), NonFiniteError> { Ok(()) }
    fn serialize_i16(self, _v: i16) -> Result<(), NonFiniteError> { Ok(()) }
