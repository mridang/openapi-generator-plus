use std::collections::HashMap;

use crate::errors::configuration_error::ConfigurationError;

/// TransportOptions holds immutable HTTP transport configuration for DefaultApiClient.
///
/// Controls low-level HTTP behavior such as TLS verification, proxy routing,
/// timeouts, redirect handling, and automatic header injection. These settings
/// are independent of API-level concerns (base URL, authentication headers)
/// which belong in `Configuration`.
///
/// This struct is immutable and thread-safe. Use [`TransportOptions::builder`]
/// to create instances:
///
/// ```rust,no_run
/// # use {{packageName}}::TransportOptions;
/// let transport = TransportOptions::builder()
///     .verify_ssl(false)
///     .proxy("http://proxy.example.com:8080")
///     .timeout(Some(5000))
///     .user_agent("MyApp/1.0")
///     .build()?;
/// # Ok::<(), {{packageName}}::ConfigurationError>(())
/// ```
#[derive(Debug, Clone)]
pub struct TransportOptions {
    /// Controls whether TLS certificate verification is enabled.
    verify_ssl: bool,

    /// Path to a custom CA certificate bundle for TLS verification.
    ca_cert_path: Option<String>,

    /// The PEM bytes read from `ca_cert_path` by `build`, which also checked
    /// that they parse as a certificate.
    ca_cert_pem: Option<Vec<u8>>,

    /// HTTP or HTTPS proxy URL for all outbound requests.
    proxy: Option<String>,

    /// End-to-end request timeout in milliseconds. Covers the entire request
    /// lifecycle: connection, TLS handshake, sending the request body, and
    /// reading the response. `None` means no timeout.
    timeout: Option<i64>,

    /// Controls whether the client follows HTTP 3xx redirects.
    follow_redirects: bool,

    /// Maximum number of consecutive redirects to follow.
    /// Only meaningful when `follow_redirects` is true.
    max_redirects: Option<usize>,

    /// Custom User-Agent header value. `None` means no User-Agent header is
    /// injected by the transport, so the header can be omitted entirely.
    user_agent: Option<String>,

    /// Transport-level default headers included in every request. These have
    /// the lowest priority: API-level headers, operation-specific headers,
    /// and authentication headers all take precedence.
    default_headers: HashMap<String, String>,

    /// Controls whether to auto-inject an X-Request-ID header with a unique
    /// UUID on every request.
    inject_request_id: bool,
}

impl TransportOptions {
    /// Returns a new [`TransportOptionsBuilder`]. This is the entry point for
    /// building transport options.
    pub fn builder() -> TransportOptionsBuilder {
        TransportOptionsBuilder::new()
    }

    /// Returns whether TLS certificate verification is enabled.
    pub fn verify_ssl(&self) -> bool {
        self.verify_ssl
    }

    /// Returns the path to a custom CA certificate bundle.
    pub fn ca_cert_path(&self) -> Option<&str> {
        self.ca_cert_path.as_deref()
    }

    /// Returns the PEM bytes read from the CA certificate bundle.
    pub(crate) fn ca_cert_pem(&self) -> Option<&[u8]> {
        self.ca_cert_pem.as_deref()
    }

    /// Returns the proxy URL, or None if no proxy is configured.
    pub fn proxy(&self) -> Option<&str> {
        self.proxy.as_deref()
    }

    /// Returns the end-to-end request timeout in milliseconds.
    pub fn timeout(&self) -> Option<i64> {
        self.timeout
    }

    /// Returns whether the client follows HTTP 3xx redirects.
    pub fn follow_redirects(&self) -> bool {
        self.follow_redirects
    }

    /// Returns the maximum number of consecutive redirects to follow.
    pub fn max_redirects(&self) -> Option<usize> {
        self.max_redirects
    }

    /// Returns the custom User-Agent header value, or `None` if no User-Agent
    /// header should be injected by the transport.
    pub fn user_agent(&self) -> Option<&str> {
        self.user_agent.as_deref()
    }

    /// Returns a copy of the transport-level default headers.
    pub fn default_headers(&self) -> HashMap<String, String> {
        self.default_headers.clone()
    }

    /// Returns whether X-Request-ID injection is enabled.
    pub fn inject_request_id(&self) -> bool {
        self.inject_request_id
    }
}

/// TransportOptionsBuilder builds immutable TransportOptions instances.
pub struct TransportOptionsBuilder {
    verify_ssl: bool,
    ca_cert_path: Option<String>,
    proxy: Option<String>,
    proxy_error: Option<ConfigurationError>,
    timeout: Option<i64>,
    follow_redirects: bool,
    max_redirects: Option<usize>,
    user_agent: Option<String>,
    default_headers: HashMap<String, String>,
    inject_request_id: bool,
}

impl TransportOptionsBuilder {
    /// Creates a new builder with sensible defaults.
    pub fn new() -> Self {
        Self {
            verify_ssl: true,
            ca_cert_path: None,
            proxy: None,
            proxy_error: None,
            // Default 10-second end-to-end timeout (10_000 ms). Callers can
            // override it via `TransportOptionsBuilder::timeout`, which takes
            // `None` for no timeout; `Some(0)` is a zero-millisecond deadline.
            timeout: Some(10_000),
            follow_redirects: true,
            max_redirects: None,
            user_agent: Some("{{userAgentDefault}}".to_string()),
            default_headers: HashMap::new(),
            inject_request_id: false,
        }
    }

    /// Enables or disables TLS certificate verification.
    pub fn verify_ssl(mut self, val: bool) -> Self {
        self.verify_ssl = val;
        self
    }

    /// Sets the path to a custom CA certificate bundle.
    pub fn ca_cert_path(mut self, val: &str) -> Self {
        self.ca_cert_path = Some(val.to_string());
        self
    }

    /// Sets the HTTP/HTTPS proxy URL. An invalid URL is reported by
    /// [`build`](Self::build) as [`ConfigurationError::InvalidProxy`].
    ///
    /// Only HTTP and HTTPS proxy URLs are supported.
    pub fn proxy(mut self, val: &str) -> Self {
        self.proxy = None;
        self.proxy_error = None;
        if val.is_empty() {
            return self;
        }
        match reqwest::Url::parse(val) {
            Err(e) => {
                self.proxy_error = Some(ConfigurationError::InvalidProxy(format!("{:?}: {}", val, e)));
            }
            Ok(parsed) if parsed.scheme() != "http" && parsed.scheme() != "https" => {
                self.proxy_error = Some(ConfigurationError::InvalidProxy(format!(
                    "{:?}: must use http or https scheme",
                    val
                )));
            }
            Ok(parsed) if parsed.host_str().unwrap_or("").is_empty() => {
                self.proxy_error =
                    Some(ConfigurationError::InvalidProxy(format!("{:?}: missing host", val)));
            }
            Ok(_) => self.proxy = Some(val.to_string()),
        }
        self
    }

    /// Sets the end-to-end request timeout in milliseconds, or `None` for no
    /// timeout. A negative value is reported by [`build`](Self::build) as
    /// [`ConfigurationError::InvalidTimeout`].
    pub fn timeout(mut self, val: Option<i64>) -> Self {
        self.timeout = val;
        self
    }

    /// Enables or disables automatic redirect following.
    pub fn follow_redirects(mut self, val: bool) -> Self {
        self.follow_redirects = val;
        self
    }

    /// Sets the maximum number of redirects to follow.
    /// Pass `Some(n)` to limit to `n` redirects, or `None` for unlimited.
    pub fn max_redirects(mut self, val: Option<usize>) -> Self {
        self.max_redirects = val;
        self
    }

    /// Sets a custom User-Agent header value.
    pub fn user_agent(mut self, val: &str) -> Self {
        self.user_agent = Some(val.to_string());
        self
    }

    /// Sets (or clears) the custom User-Agent header value. Pass `Some(value)`
    /// to inject a User-Agent header, or `None` to omit it entirely.
    pub fn user_agent_opt(mut self, val: Option<&str>) -> Self {
        self.user_agent = val.map(|v| v.to_string());
        self
    }

    /// Adds a single transport-level default header.
    pub fn default_header(mut self, name: &str, value: &str) -> Self {
        self.default_headers.insert(name.to_string(), value.to_string());
        self
    }

    /// Adds multiple transport-level default headers.
    pub fn default_headers(mut self, headers: HashMap<String, String>) -> Self {
        self.default_headers.extend(headers);
        self
    }

    /// Enables or disables automatic X-Request-ID header injection.
    pub fn inject_request_id(mut self, val: bool) -> Self {
        self.inject_request_id = val;
        self
    }

    /// Validates the configuration and returns an immutable TransportOptions
    /// instance.
    ///
    /// # Errors
    ///
    /// Returns [`ConfigurationError::InvalidProxy`] when the proxy URL is
    /// invalid, [`ConfigurationError::InvalidCaCertificate`] when the CA
    /// certificate file cannot be read or parsed, and
    /// [`ConfigurationError::InvalidTimeout`] when the timeout is negative.
    pub fn build(self) -> Result<TransportOptions, ConfigurationError> {
        if let Some(e) = self.proxy_error {
            return Err(e);
        }
        if let Some(ms) = self.timeout {
            if ms < 0 {
                return Err(ConfigurationError::InvalidTimeout(ms));
            }
        }
        let ca_cert_pem = match &self.ca_cert_path {
            None => None,
            Some(path) => {
                let pem = std::fs::read(path).map_err(|e| {
                    ConfigurationError::InvalidCaCertificate(format!("failed to read {:?}: {}", path, e))
                })?;
                reqwest::Certificate::from_pem(&pem).map_err(|e| {
                    ConfigurationError::InvalidCaCertificate(format!("failed to parse {:?}: {}", path, e))
                })?;
                Some(pem)
            }
        };
        Ok(self.assemble(ca_cert_pem))
    }

    /// Assembles the options from already-validated builder state.
    fn assemble(self, ca_cert_pem: Option<Vec<u8>>) -> TransportOptions {
        TransportOptions {
            verify_ssl: self.verify_ssl,
            ca_cert_path: self.ca_cert_path,
            ca_cert_pem,
            proxy: self.proxy,
            timeout: self.timeout,
            follow_redirects: self.follow_redirects,
            max_redirects: self.max_redirects,
            user_agent: self.user_agent,
            default_headers: self.default_headers,
            inject_request_id: self.inject_request_id,
        }
    }
}

impl Default for TransportOptions {
    /// The options a `None` argument stands for. The defaults configure no
    /// proxy, no CA bundle and a positive timeout, so they need no validation.
    fn default() -> Self {
        TransportOptionsBuilder::new().assemble(None)
    }
}

impl Default for TransportOptionsBuilder {
    fn default() -> Self {
        Self::new()
    }
}
