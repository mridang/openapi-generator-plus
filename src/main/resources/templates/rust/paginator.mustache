use std::future::Future;
use std::pin::Pin;
use std::sync::Arc;

use futures_core::Stream;
use futures_util::StreamExt as _;

use crate::api_result::ApiResult;
use crate::errors::pagination_error::PaginationError;

type Failure = Box<dyn std::error::Error + Send + Sync>;

/// The request of one page, not sent until it is polled.
pub type PageFuture<B> = Pin<Box<dyn Future<Output = Result<ApiResult<B>, Failure>> + Send>>;

type PageStream<T, C, B> = Pin<Box<dyn Stream<Item = Result<Page<T, C, B>, Failure>> + Send>>;

/// A cursor value: the type of the cursor request parameter. A cursor that is
/// blank (an empty string) ends the list, like an absent one.
#[doc(hidden)]
pub trait CursorValue: Clone + PartialEq + Send + Sync + 'static {
    /// Whether the value ends the list.
    fn is_blank(&self) -> bool;
}

impl CursorValue for String {
    fn is_blank(&self) -> bool {
        self.is_empty()
    }
}

macro_rules! numeric_cursor {
    ($($number:ty),+) => {
        $(
            impl CursorValue for $number {
                fn is_blank(&self) -> bool {
                    false
                }
            }
        )+
    };
}

numeric_cursor!(i32, i64, u32, u64);

/// Reads the items of a decoded page, whether the property is optional or not.
#[doc(hidden)]
pub trait ItemsOf<T> {
    /// The items, in order; none for a property that is absent.
    fn items_of(&self) -> Vec<T>;
}

impl<T: Clone> ItemsOf<T> for Vec<T> {
    fn items_of(&self) -> Vec<T> {
        self.clone()
    }
}

impl<T: Clone> ItemsOf<T> for Option<Vec<T>> {
    fn items_of(&self) -> Vec<T> {
        self.clone().unwrap_or_default()
    }
}

/// Reads the next cursor of a decoded page, whether the property is optional or not.
#[doc(hidden)]
pub trait CursorOf<C> {
    /// The cursor of the next page, or `None` when the property is absent.
    fn cursor_of(&self) -> Option<C>;
}

impl<C: Clone> CursorOf<C> for Option<C> {
    fn cursor_of(&self) -> Option<C> {
        self.clone()
    }
}

macro_rules! plain_cursor {
    ($($cursor:ty),+) => {
        $(
            impl CursorOf<$cursor> for $cursor {
                fn cursor_of(&self) -> Option<$cursor> {
                    Some(self.clone())
                }
            }
        )+
    };
}

plain_cursor!(String, i32, i64, u32, u64);

/// Reads the `has_more` flag of a decoded page, whether the property is optional or not.
#[doc(hidden)]
pub trait MoreOf {
    /// Whether a further page follows; a flag that is absent does not end the list.
    fn more_of(&self) -> bool;
}

impl MoreOf for bool {
    fn more_of(&self) -> bool {
        *self
    }
}

impl MoreOf for Option<bool> {
    fn more_of(&self) -> bool {
        self.unwrap_or(true)
    }
}

/// Reads the URL of the next page from a decoded page. An absent, `null` or empty URL ends the list.
#[doc(hidden)]
pub trait UrlOf {
    /// The URL of the next page, or `None` when the page does not name one.
    fn url_of(&self) -> Option<String>;
}

impl UrlOf for String {
    fn url_of(&self) -> Option<String> {
        Some(self.clone()).filter(|url| !url.is_empty())
    }
}

impl UrlOf for Option<String> {
    fn url_of(&self) -> Option<String> {
        self.clone().filter(|url| !url.is_empty())
    }
}

/// One page of a paged list: the items it holds, the cursor of the page after
/// it, and the result of the request that returned it.
///
/// `T` is the item type, `C` the type of the cursor request parameter (`()` for
/// a list that is followed by a `Link` header or a next URL in the body) and `B` the type of the decoded
/// page body.
#[derive(Debug, Clone)]
pub struct Page<T, C, B> {
    items: Vec<T>,
    next_cursor: Option<C>,
    result: ApiResult<B>,
}

impl<T, C, B> Page<T, C, B> {
    /// The items of this page, in order.
    pub fn items(&self) -> &[T] {
        &self.items
    }

    /// Consumes the page and returns its items.
    pub fn into_items(self) -> Vec<T> {
        self.items
    }

    /// The cursor of the next page, or `None` on the last page; always `None`
    /// for a list that is followed by a `Link` header or a next URL in the body.
    pub fn next_cursor(&self) -> Option<&C> {
        self.next_cursor.as_ref()
    }

    /// What the matching `_with_http_info` method returns for this page: the
    /// status, the headers, the raw body and the decoded body.
    pub fn result(&self) -> &ApiResult<B> {
        &self.result
    }
}

/// The items of a paged list, read lazily. The method that returns it sends no
/// request; the first request goes out when you first poll the items or the
/// pages, and each next request goes out only when you ask for more. Every page
/// is an ordinary call, so the retries, timeouts, redirects, authentication,
/// redaction, headers and per-call options of the method apply to each one.
///
/// [`items`](Self::items) and [`pages`](Self::pages) each return a new stream
/// that starts again from the starting position, so two loops read the list
/// twice. Dropping a stream stops the requests and leaves nothing to close. A
/// failed page request is the last item of the stream, after the items of the
/// earlier pages; a cursor equal to the one just sent yields a
/// [`PaginationError`] after the items of the page that repeated it.
///
/// `T` is the item type, `C` the type of the cursor request parameter (`()` for
/// a list that is followed by a `Link` header or a next URL in the body) and `B` the type of the decoded
/// page body.
pub struct Paginator<T, C, B> {
    open: Arc<dyn Fn() -> PageStream<T, C, B> + Send + Sync>,
}

impl<T, C, B> Clone for Paginator<T, C, B> {
    fn clone(&self) -> Self {
        Self {
            open: self.open.clone(),
        }
    }
}

impl<T, C, B> Paginator<T, C, B>
where
    T: Send + 'static,
    C: Send + 'static,
    B: Send + 'static,
{
    /// Creates a paginator from a function that opens a fresh stream of pages
    /// every time it is called. The generated `_pages` methods use the two
    /// functions below instead.
    pub fn from_pages<F, S>(open: F) -> Self
    where
        F: Fn() -> S + Send + Sync + 'static,
        S: Stream<Item = Result<Page<T, C, B>, Failure>> + Send + 'static,
    {
        Self {
            open: Arc::new(move || Box::pin(open()) as PageStream<T, C, B>),
        }
    }

    /// The pages, each with its items, next cursor and result. Every call
    /// starts again at the starting position.
    pub fn pages(&self) -> impl Stream<Item = Result<Page<T, C, B>, Failure>> + Send + Unpin + 'static {
        (self.open)()
    }

    /// The items of every page, in order. Every call starts again at the
    /// starting position; the request of the next page is sent only when the
    /// items of the page before it are used up.
    pub fn items(&self) -> impl Stream<Item = Result<T, Failure>> + Send + Unpin + 'static {
        (self.open)().flat_map(|page| {
            let items: Vec<Result<T, Failure>> = match page {
                Ok(page) => page.items.into_iter().map(Ok).collect(),
                Err(failure) => vec![Err(failure)],
            };
            futures_util::stream::iter(items)
        })
    }
}

struct CursorState<C> {
    sent: Option<C>,
    repeated: Option<PaginationError>,
    done: bool,
}

impl<T, C, B> Paginator<T, C, B>
where
    T: Send + 'static,
    C: CursorValue,
    B: Send + 'static,
{
    /// Creates a paginator that follows a cursor: a token, the id of the last
    /// item, an offset or a page number. Used by the generated `_pages` methods.
    ///
    /// `start` is the cursor of the first request (`None` starts at the
    /// beginning), `fetch` sends the request for a cursor and `items` reads the
    /// items of a decoded page. `next` reads the cursor of the page after it from
    /// the page, the cursor that was sent for it (`None` for the first request)
    /// and the number of items it held; an absent or empty cursor ends the list,
    /// and so does a page after which `more` is false. `request_path` is the path
    /// of the operation, for errors.
    pub fn of_cursor<F, I, N, M>(start: Option<C>, fetch: F, items: I, next: N, more: M, request_path: String) -> Self
    where
        F: Fn(Option<C>) -> PageFuture<B> + Send + Sync + 'static,
        I: Fn(&B) -> Vec<T> + Send + Sync + 'static,
        N: Fn(&B, Option<&C>, usize) -> Option<C> + Send + Sync + 'static,
        M: Fn(&B) -> bool + Send + Sync + 'static,
    {
        let shared = Arc::new((fetch, items, next, more, request_path));
        Self::from_pages(move || {
            let shared = shared.clone();
            let state = CursorState {
                sent: start.clone(),
                repeated: None,
                done: false,
            };
            futures_util::stream::unfold(state, move |mut state| {
                let shared = shared.clone();
                async move {
                    if state.done {
                        return None;
                    }
                    if let Some(repeated) = state.repeated.take() {
                        state.done = true;
                        return Some((Err(Box::new(repeated) as Failure), state));
                    }
                    let (fetch, items, next, more, request_path) = &*shared;
                    let result = match fetch(state.sent.clone()).await {
                        Ok(result) => result,
                        Err(failure) => {
                            state.done = true;
                            return Some((Err(failure), state));
                        }
                    };
                    let (list, following) = match result.data() {
                        Some(body) => {
                            let list = items(body);
                            let following = if more(body) {
                                next(body, state.sent.as_ref(), list.len())
                            } else {
                                None
                            };
                            (list, following)
                        }
                        None => (Vec::new(), None),
                    };
                    let following = following.filter(|cursor| !cursor.is_blank());
                    match &following {
                        None => state.done = true,
                        Some(cursor) => {
                            if state.sent.as_ref() == Some(cursor) {
                                /* The page itself is good: it is delivered, and the next read fails. */
                                state.repeated = Some(PaginationError::new(
                                    "The server returned the cursor that was just sent, so the list cannot advance",
                                    Some(request_path.clone()),
                                ));
                            }
                            state.sent = Some(cursor.clone());
                        }
                    }
                    let page = Page {
                        items: list,
                        next_cursor: following,
                        result,
                    };
                    Some((Ok(page), state))
                }
            })
        })
    }
}

struct UrlState {
    url: Option<String>,
    repeated: Option<PaginationError>,
    done: bool,
}

impl<T, B> Paginator<T, (), B>
where
    T: Send + 'static,
    B: Send + 'static,
{
    /// Creates a paginator that follows the `rel="next"` link of the `Link`
    /// header. Used by the generated `_pages` methods.
    ///
    /// `base_url` is the base URL of the client: a next URL that leaves its
    /// scheme, host or port is refused. `fetch` sends the request for a URL
    /// (`None` for the first page) and `items` reads the items of a decoded
    /// page. `request_path` is the path of the operation, for errors.
    pub fn of_link<F, I>(base_url: String, fetch: F, items: I, request_path: String) -> Self
    where
        F: Fn(Option<String>) -> PageFuture<B> + Send + Sync + 'static,
        I: Fn(&B) -> Vec<T> + Send + Sync + 'static,
    {
        Self::of_urls(
            base_url,
            fetch,
            items,
            |result: &ApiResult<B>| {
                result
                    .headers()
                    .iter()
                    .find(|(name, _)| name.eq_ignore_ascii_case("link"))
                    .and_then(|(_, value)| crate::link_header::next(value))
            },
            request_path,
        )
    }

    /// Creates a paginator that follows the URL that the body of each page names.
    /// Used by the generated `_pages` methods.
    ///
    /// It is followed exactly as a `Link` list is: `next` reads the URL of the
    /// next page from the decoded body, and a URL that is absent, `null` or
    /// empty ends the list. A URL on another origin is refused.
    pub fn of_next_url<F, I, N>(base_url: String, fetch: F, items: I, next: N, request_path: String) -> Self
    where
        F: Fn(Option<String>) -> PageFuture<B> + Send + Sync + 'static,
        I: Fn(&B) -> Vec<T> + Send + Sync + 'static,
        N: Fn(&B) -> Option<String> + Send + Sync + 'static,
    {
        Self::of_urls(
            base_url,
            fetch,
            items,
            move |result: &ApiResult<B>| result.data().and_then(|body| next(body)),
            request_path,
        )
    }

    /// The shared reader of the URL-driven lists: `next` reads the URL of the
    /// page after the one just read from its result.
    fn of_urls<F, I, N>(base_url: String, fetch: F, items: I, next: N, request_path: String) -> Self
    where
        F: Fn(Option<String>) -> PageFuture<B> + Send + Sync + 'static,
        I: Fn(&B) -> Vec<T> + Send + Sync + 'static,
        N: Fn(&ApiResult<B>) -> Option<String> + Send + Sync + 'static,
    {
        let shared = Arc::new((base_url, fetch, items, next, request_path));
        Self::from_pages(move || {
            let shared = shared.clone();
            let state = UrlState {
                url: None,
                repeated: None,
                done: false,
            };
            futures_util::stream::unfold(state, move |mut state| {
                let shared = shared.clone();
                async move {
                    if state.done {
                        return None;
                    }
                    if let Some(repeated) = state.repeated.take() {
                        state.done = true;
                        return Some((Err(Box::new(repeated) as Failure), state));
                    }
                    let (base_url, fetch, items, next, request_path) = &*shared;
                    let result = match fetch(state.url.clone()).await {
                        Ok(result) => result,
                        Err(failure) => {
                            state.done = true;
                            return Some((Err(failure), state));
                        }
                    };
                    let list = match result.data() {
                        Some(body) => items(body),
                        None => Vec::new(),
                    };
                    let link = next(&result);
                    match link {
                        None => state.done = true,
                        Some(link) => {
                            /* The page itself is good: it is delivered, and the next read fails. */
                            match resolve(base_url, state.url.as_deref(), &link, request_path) {
                                Ok(target) if state.url.as_deref() == Some(target.as_str()) => {
                                    state.repeated = Some(PaginationError::new(
                                        "The server returned a next link to the page that was just read, so the list cannot advance",
                                        Some(request_path.clone()),
                                    ));
                                }
                                Ok(target) => state.url = Some(target),
                                Err(refused) => state.repeated = Some(refused),
                            }
                        }
                    }
                    let page = Page {
                        items: list,
                        next_cursor: None,
                        result,
                    };
                    Some((Ok(page), state))
                }
            })
        })
    }
}

/// Resolves a link against the page just read and refuses a scheme, host or
/// port other than the client's.
fn resolve(base_url: &str, current: Option<&str>, link: &str, request_path: &str) -> Result<String, PaginationError> {
    let base = reqwest::Url::parse(base_url)
        .map_err(|_| PaginationError::new("The base URL of the client is not a valid URL", Some(request_path.to_string())))?;
    let from = match current {
        Some(url) => reqwest::Url::parse(url).unwrap_or_else(|_| base.clone()),
        None => base.clone(),
    };
    let target = from
        .join(link.trim())
        .map_err(|_| PaginationError::new("The next link is not a valid URI", Some(request_path.to_string())))?;
    if !crate::default_api_client::same_origin(&base, &target) {
        return Err(PaginationError::new(
            "The next link leaves the origin of the request and was not followed",
            Some(request_path.to_string()),
        ));
    }
    Ok(target.to_string())
}
