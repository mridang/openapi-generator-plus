{{/isModel}}
{{/bodyParam}}
{{/binaryStreamOperation}}

async fn download(
    client: &{{clientClassName}},
{{#binaryStreamOperation}}
{{#vendorExtensions.op.signatureArgs}}
{{#isPath}}
