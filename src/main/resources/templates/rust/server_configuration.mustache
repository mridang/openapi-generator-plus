use std::collections::HashMap;

/// ServerVariable represents a server variable from the OpenAPI specification.
///
/// Server variables define substitution parameters in server URL templates.
/// Each variable has a default value and may optionally restrict values to
/// an enumerated set.
#[derive(Debug, Clone)]
pub struct ServerVariable {
    /// The default value for this variable.
    default_value: String,

    /// A human-readable description of this variable.
    description: String,

    /// The allowed values for this variable. An empty vec means any value
    /// is accepted.
    enum_values: Vec<String>,
}

impl ServerVariable {
    /// Creates a new server variable.
    pub fn new(default_value: String, description: String, enum_values: Vec<String>) -> Self {
        Self {
            default_value,
            description,
            enum_values,
        }
    }

    /// Returns the default value for this variable.
    pub fn default_value(&self) -> &str {
        &self.default_value
    }

    /// Returns the human-readable description of this variable.
    pub fn description(&self) -> &str {
        &self.description
    }

    /// Returns the allowed values for this variable. An empty slice means any
    /// value is accepted.
    pub fn enum_values(&self) -> &[String] {
        &self.enum_values
    }
}

/// ServerConfiguration represents a single server entry from the OpenAPI specification.
///
/// A server URL may contain template variables (e.g.
/// `https://{env}.api.example.com/v{version}`). Use `url` to resolve the URL
/// with default variable values, or `url` with overrides to substitute specific
/// variables.
#[derive(Debug, Clone)]
pub struct ServerConfiguration {
    /// The raw URL template before variable substitution.
    url_template: String,

    /// A human-readable description of this server.
    description: String,

    /// The server variables and their definitions.
    variables: HashMap<String, ServerVariable>,
}

impl ServerConfiguration {
    /// Creates a new server configuration.
    pub fn new(
        url_template: String,
        description: String,
        variables: HashMap<String, ServerVariable>,
    ) -> Self {
        Self {
            url_template,
            description,
            variables,
        }
    }

    /// Returns the raw URL template before variable substitution.
    pub fn url_template(&self) -> &str {
        &self.url_template
    }

    /// Returns the human-readable description of this server.
    pub fn description(&self) -> &str {
        &self.description
    }

    /// Returns the server variables and their definitions.
    pub fn variables(&self) -> &HashMap<String, ServerVariable> {
        &self.variables
    }

    /// Resolves the URL template using default variable values or the given overrides.
    ///
    /// Variables not present in overrides use their default values. If a variable
    /// has an enum constraint, the override value is validated against the allowed values.
    ///
    /// # Errors
    ///
    /// Returns an error if an override value is not in the variable's enum constraint.
    pub fn url(&self, overrides: &HashMap<String, String>) -> Result<String, Box<dyn std::error::Error>> {
        let mut result = self.url_template.clone();
        for (var_name, variable) in &self.variables {
            let value = overrides
                .get(var_name)
                .unwrap_or(&variable.default_value)
                .clone();

            if !variable.enum_values.is_empty()
                && !variable.enum_values.contains(&value)
            {
                return Err(format!(
                    "invalid value '{}' for variable '{}'; allowed: {:?}",
                    value, var_name, variable.enum_values
                ).into());
            }

