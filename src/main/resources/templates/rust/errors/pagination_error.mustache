use std::fmt;

/// Raised when a paged list cannot be followed safely: the server returned the
/// cursor that was just sent, so asking again would loop forever, or a `Link`
/// header pointed to another origin, so following it would send the credentials
/// there. It is not a network error and not an API error: it is a direct child
/// of the SDK error root, and the items already delivered are complete and
/// correct. A failed page request returns the SDK error of that failure instead.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct PaginationError {
    message: String,
    request_path: Option<String>,
}

impl PaginationError {
    /// Creates a new error. `message` says what made the list impossible to
    /// follow and never holds a query string; `request_path` is the path of the
    /// request that returned the page, without its query.
    pub fn new(message: impl Into<String>, request_path: Option<String>) -> Self {
        Self {
            message: message.into(),
            request_path,
        }
    }

    /// Returns what made the list impossible to follow.
    pub fn message(&self) -> &str {
        &self.message
    }

    /// Returns the path of the request whose response could not be followed,
    /// without its query, or `None` when it is not known.
    pub fn request_path(&self) -> Option<&str> {
        self.request_path.as_deref()
    }
}

impl fmt::Display for PaginationError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(&self.message)
    }
}

impl std::error::Error for PaginationError {}
