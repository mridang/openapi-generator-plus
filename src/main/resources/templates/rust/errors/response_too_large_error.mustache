use std::collections::HashMap;
use std::fmt;

use crate::errors::api_error::ApiError;

/// Error for a buffered response whose body, on the wire or after
/// decompression, passed the transport's
/// [`max_response_bytes`](crate::TransportOptions::max_response_bytes).
///
/// A response arrived, so it wraps an [`ApiError`] carrying the real status
/// code and the lower-cased response headers; the body is empty because it was
/// not read in full. It is never retried.
#[derive(Debug, Clone)]
pub struct ResponseTooLargeError {
    api_error: ApiError,
    limit: u64,
}

impl ResponseTooLargeError {
    /// Creates the error for a response whose body passed `limit` bytes.
    pub fn new(status_code: u16, response_headers: HashMap<String, String>, limit: u64) -> Self {
        Self {
            api_error: ApiError::new(
                status_code,
                format!("Response body exceeds the limit of {} bytes", limit),
                Some(response_headers),
                None,
            ),
            limit,
        }
    }

    /// Returns the underlying [`ApiError`].
    pub fn api_error(&self) -> &ApiError {
        &self.api_error
    }

    /// The `max_response_bytes` the body passed.
    pub fn limit(&self) -> u64 {
        self.limit
    }

    /// Always `false`: the same response would pass the limit again, whatever
    /// its status.
    pub fn is_retryable(&self) -> bool {
        false
    }

    /// Records the request this error belongs to on the wrapped [`ApiError`].
    pub(crate) fn with_request(mut self, method: &str, path: &str) -> Self {
        self.api_error = self.api_error.with_request(method, path);
        self
    }
}

impl fmt::Display for ResponseTooLargeError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        fmt::Display::fmt(&self.api_error, f)
    }
}

impl std::error::Error for ResponseTooLargeError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        Some(&self.api_error)
    }
}
