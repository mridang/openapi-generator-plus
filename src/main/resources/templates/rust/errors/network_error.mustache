use std::fmt;

use crate::errors::api_error::ApiError;

/// NetworkError represents a request that produced no HTTP response:
/// connection refused, DNS failure, TLS failure or connection reset. The
/// status code is 0 and the transport error is kept as the source.
#[derive(Debug, Clone)]
pub struct NetworkError {
    api_error: ApiError,
}

impl NetworkError {
    /// Returns the underlying [`ApiError`].
    pub fn api_error(&self) -> &ApiError {
        &self.api_error
    }
}

impl fmt::Display for NetworkError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "Network error: {}", self.api_error.message())
    }
}

impl std::error::Error for NetworkError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        Some(&self.api_error)
    }
}

impl From<ApiError> for NetworkError {
    fn from(api_error: ApiError) -> Self {
        Self { api_error }
    }
}
