/// The error every operation returns.
///
/// One variant per kind of failure, the same kinds the other SDKs raise: a
/// variant for each HTTP status the SDK names, [`Client`](Self::Client) and
/// [`Server`](Self::Server) for any other 4xx and 5xx, [`Api`](Self::Api) for
/// any other status, [`ResponseTooLarge`](Self::ResponseTooLarge) for a body
/// past the size limit, the failures with no response ([`Network`](Self::Network),
/// [`NetworkTimeout`](Self::NetworkTimeout), [`Stream`](Self::Stream)), the
/// errors raised before or after the exchange, one variant per error schema the
/// API declares, and [`Other`](Self::Other) for anything else, such as an error
/// a custom [`ApiClient`](crate::ApiClient) returns. The enum is
/// `#[non_exhaustive]`, so a later kind is not a breaking change; a `match`
/// ends with a wildcard arm.
///
/// Each variant boxes its error so that a `Result` stays small. `Error`
/// implements [`std::error::Error`], so `?` turns it into a
/// `Box<dyn std::error::Error + Send + Sync>` or any error type with a
/// `From<Error>`; [`Display`](std::fmt::Display) and
/// [`source`](std::error::Error::source) are those of the error it holds.
///
/// ```ignore
/// match api.get_item(id).await {
///     Ok(item) => println!("{item:?}"),
///     Err(Error::NotFound(e)) => println!("not found: {e}"),
///     Err(e) if e.api_error().is_some() => println!("HTTP error: {e}"),
///     Err(e) => return Err(e.into()),
/// }
/// ```
#[derive(Debug)]
#[non_exhaustive]
pub enum Error {
    /// HTTP 400 Bad Request.
    BadRequest(Box<BadRequestError>),
    /// HTTP 401 Unauthorized.
    Unauthorized(Box<UnauthorizedError>),
    /// HTTP 403 Forbidden.
    Forbidden(Box<ForbiddenError>),
    /// HTTP 404 Not Found.
    NotFound(Box<NotFoundError>),
    /// HTTP 409 Conflict.
    Conflict(Box<ConflictError>),
    /// HTTP 422 Unprocessable Entity.
    UnprocessableEntity(Box<UnprocessableEntityError>),
    /// HTTP 429 Too Many Requests.
    TooManyRequests(Box<TooManyRequestsError>),
    /// HTTP 402 Payment Required.
    PaymentRequired(Box<PaymentRequiredError>),
    /// HTTP 405 Method Not Allowed.
    MethodNotAllowed(Box<MethodNotAllowedError>),
    /// HTTP 408 Request Timeout.
    RequestTimeout(Box<RequestTimeoutError>),
    /// HTTP 410 Gone.
    Gone(Box<GoneError>),
    /// HTTP 413 Payload Too Large.
    PayloadTooLarge(Box<PayloadTooLargeError>),
    /// HTTP 415 Unsupported Media Type.
    UnsupportedMediaType(Box<UnsupportedMediaTypeError>),
    /// HTTP 423 Locked.
    Locked(Box<LockedError>),
    /// Any other 4xx status.
    Client(Box<ClientError>),
    /// HTTP 500 Internal Server Error.
    InternalServerError(Box<InternalServerError>),
    /// HTTP 501 Not Implemented.
    NotImplemented(Box<NotImplementedError>),
    /// HTTP 502 Bad Gateway.
    BadGateway(Box<BadGatewayError>),
    /// HTTP 503 Service Unavailable.
    ServiceUnavailable(Box<ServiceUnavailableError>),
    /// HTTP 504 Gateway Timeout.
    GatewayTimeout(Box<GatewayTimeoutError>),
    /// Any other 5xx status.
    Server(Box<ServerError>),
    /// A response with any other status, or a success with no body to decode.
    Api(Box<ApiError>),
    /// A buffered response body passed the transport's `max_response_bytes`.
    ResponseTooLarge(Box<ResponseTooLargeError>),
{{#errorSchemas}}
    /// A response whose body is the declared error schema of its status.
    {{className}}(Box<{{className}}>),
{{/errorSchemas}}
    /// No HTTP response arrived: the connection was refused, reset or failed.
    Network(Box<NetworkError>),
    /// The call ran out of its time budget before a response arrived.
    NetworkTimeout(Box<NetworkTimeoutError>),
    /// The connection failed while a streamed response body was being read.
    Stream(Box<StreamError>),
    /// A request could not be encoded or a response could not be decoded.
    Serialization(Box<SerializationError>),
    /// A paged list cannot be followed.
    Pagination(Box<PaginationError>),
    /// The token endpoint answered with an OAuth2 error.
    OAuth2Server(Box<OAuth2ServerError>),
    /// A token could not be obtained from the token endpoint.
    OAuth2Token(Box<OAuth2TokenError>),
    /// The authorization code flow was used before its code was exchanged.
    OAuth2AuthorizationCode(Box<OAuth2AuthorizationCodeError>),
    /// The call was refused before it was sent: an argument or the
    /// configuration is not valid.
    Configuration(Box<ConfigurationError>),
    /// Any other error.
    Other(Box<dyn std::error::Error + Send + Sync>),
}

