/// Implements [`ApiErrorInfo`] for the named 4xx wrappers, which reach their
/// [`ApiError`] through the [`ClientError`] they wrap.
macro_rules! api_error_info_through_client {
    ($($wrapper:ty),+ $(,)?) => {
        $(
            impl ApiErrorInfo for $wrapper {
                fn api_error(&self) -> &ApiError {
                    self.client_error().api_error()
                }
            }
        )+
    };
}

/// Implements [`ApiErrorInfo`] for the named 5xx wrappers, which reach their
/// [`ApiError`] through the [`ServerError`] they wrap.
macro_rules! api_error_info_through_server {
    ($($wrapper:ty),+ $(,)?) => {
        $(
            impl ApiErrorInfo for $wrapper {
                fn api_error(&self) -> &ApiError {
                    self.server_error().api_error()
                }
            }
        )+
    };
}

api_error_info_through_client!(
    BadRequestError,
    UnauthorizedError,
    ForbiddenError,
    NotFoundError,
    ConflictError,
    UnprocessableEntityError,
    TooManyRequestsError,
    PaymentRequiredError,
    MethodNotAllowedError,
    RequestTimeoutError,
    GoneError,
    PayloadTooLargeError,
    UnsupportedMediaTypeError,
    LockedError,
);

api_error_info_through_server!(
    NotImplementedError,
    BadGatewayError,
    ServiceUnavailableError,
    GatewayTimeoutError,
    InternalServerError,
);

impl ApiErrorInfo for ClientError {
    fn api_error(&self) -> &ApiError {
        ClientError::api_error(self)
    }
}

impl ApiErrorInfo for ServerError {
    fn api_error(&self) -> &ApiError {
        ServerError::api_error(self)
    }
}

impl ApiErrorInfo for NetworkError {
