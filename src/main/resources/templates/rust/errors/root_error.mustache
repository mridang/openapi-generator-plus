/// The [`ApiError`] a boxed SDK error is or wraps, or `None`. The crate's own
/// transport layer still passes errors boxed; this reads them without taking
/// ownership.
pub(crate) fn api_error_of<'a>(error: &'a (dyn std::error::Error + Send + Sync + 'static)) -> Option<&'a ApiError> {
    if let Some(e) = error.downcast_ref::<Error>() {
        return e.api_error();
    }
    if let Some(e) = error.downcast_ref::<ApiError>() {
        return Some(e);
    }
