use std::fmt;

use crate::errors::api_error::ApiError;

/// Error for HTTP 5xx server errors.
#[derive(Debug, Clone)]
pub struct ServerError {
    api_error: ApiError,
}

impl ServerError {
    /// Returns the underlying [`ApiError`].
    pub fn api_error(&self) -> &ApiError {
        &self.api_error
    }
}

impl fmt::Display for ServerError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        fmt::Display::fmt(&self.api_error, f)
    }
}

impl std::error::Error for ServerError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        Some(&self.api_error)
    }
}

/// Wraps an [`ApiError`] whose status is 5xx. Any other status is handed back
/// unchanged as the error, so the type and its status cannot disagree.
impl TryFrom<ApiError> for ServerError {
    type Error = ApiError;

    fn try_from(api_error: ApiError) -> Result<Self, Self::Error> {
        if (500..600).contains(&api_error.status_code()) {
            Ok(Self { api_error })
        } else {
            Err(api_error)
        }
    }
}
