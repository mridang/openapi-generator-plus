use std::fmt;

use crate::errors::server_error::ServerError;

/// Error for HTTP 500 Internal Server Error.
#[derive(Debug, Clone)]
pub struct InternalServerError {
    server_error: ServerError,
}

impl InternalServerError {
    /// Returns the underlying [`ServerError`].
    pub fn server_error(&self) -> &ServerError {
        &self.server_error
    }
}

impl fmt::Display for InternalServerError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        fmt::Display::fmt(self.server_error.api_error(), f)
    }
}

impl std::error::Error for InternalServerError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        Some(&self.server_error)
    }
}

/// Wraps a [`ServerError`] whose status is 500. Any other status is handed back
/// unchanged as the error, so the type and its status cannot disagree.
impl TryFrom<ServerError> for InternalServerError {
    type Error = ServerError;

    fn try_from(server_error: ServerError) -> Result<Self, Self::Error> {
        if server_error.api_error().status_code() == 500 {
            Ok(Self { server_error })
        } else {
            Err(server_error)
        }
    }
}
