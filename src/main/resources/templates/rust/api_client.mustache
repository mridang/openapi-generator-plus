use std::collections::HashMap;
use std::future::Future;
use std::pin::Pin;

use crate::api_http_response::ApiHttpResponse;
use crate::api_stream_response::ApiStreamResponse;

/// Represents the body of an HTTP request.
///
/// Supports raw bytes, multipart form data (as ordered (field name, value) parts),
/// or no body.
#[derive(Debug, Clone)]
pub enum RequestBody {
    /// Raw bytes body.
    Bytes(Vec<u8>),
    /// Multipart form data: ordered (field name, value) parts in
    /// declaration order. Values may be raw bytes
    /// (for file uploads), strings, or JSON-serializable objects.
    Multipart(Vec<(String, MultipartValue)>),
}

/// A single value in a multipart form data body.
#[derive(Debug, Clone)]
pub enum MultipartValue {
    /// Raw bytes (sent as file upload).
    Bytes(Vec<u8>),
    /// Plain text value (a scalar form field). Written without a part
    /// `Content-Type` header — multipart text defaults to text/plain.
    Text(String),
    /// A JSON document for an object-typed part. The OAS `encoding.contentType`
    /// for a model part is `application/json`, so this part MUST carry a
    /// `Content-Type: application/json` header on the wire; a server that
    /// content-negotiates the part otherwise parses the JSON as text/plain.
    Json(String),
    /// A list of values for the same field name.
    List(Vec<MultipartValue>),
}

/// Per-request options that complement the transport-wide `TransportOptions`.
///
/// `no_redirect` lets a single caller (e.g. an OAuth2 token POST) refuse to
/// follow redirects, so a malicious or misconfigured server cannot replay the
/// credentialed body to an attacker-controlled URL. Other 3xx codes
/// (301/302/303) drop the body per RFC 7231, so they are unaffected by this
/// flag; only the body-preserving 307/308 are refused. Such a request also
/// leaves `TransportOptions::default_headers` out, so a credential meant for
/// the API is never sent to an identity provider.
#[derive(Debug, Clone, Default)]
pub struct RequestOptions {
    /// When `true`, the client must NOT follow 307 or 308 redirects and
    /// must return the first such response to the caller as-is.
    pub no_redirect: bool,
    /// The instant by which the whole call must have finished. A caller that
    /// sends several requests under one end-to-end timeout (the retry loop of
    /// `BaseApi`) sets it, so the transport gives each request only what is
    /// left of the budget. `None` lets the transport start its own timeout.
    pub deadline: Option<std::time::Instant>,
    /// The longest a stream's body may stay silent between two reads, for this
    /// request only: `Some(Duration::ZERO)` disables the idle timeout and `None`
    /// keeps the transport's. Only a streaming call reads it.
    pub idle_timeout: Option<std::time::Duration>,
}

impl RequestOptions {
    /// Creates a new `RequestOptions` with all flags defaulted to `false`.
    pub fn new() -> Self {
        Self::default()
    }

    /// Sets the end-to-end deadline shared by the requests of one call.
    pub fn deadline(mut self, value: Option<std::time::Instant>) -> Self {
        self.deadline = value;
        self
    }

    /// Sets the idle timeout of a streamed body for this request.
    pub fn idle_timeout(mut self, value: Option<std::time::Duration>) -> Self {
        self.idle_timeout = value;
        self
    }

    /// Sets the `no_redirect` flag.
    pub fn no_redirect(mut self, value: bool) -> Self {
        self.no_redirect = value;
        self
    }
}

/// Interface for API HTTP transport.
///
/// Implementations handle the actual HTTP request/response cycle. The default
/// implementation is `DefaultApiClient`, which uses reqwest.
pub trait ApiClient: Send + Sync {
    /// Send an HTTP request and return the response.
    ///
    /// # Arguments
    ///
    /// * `method` - HTTP method (GET, POST, PUT, DELETE, etc.)
    /// * `url` - Fully qualified URL
    /// * `headers` - HTTP headers
    /// * `body` - Request body (raw bytes, or a map for multipart form data; may be `None`)
    ///
    /// # Returns
    ///
    /// An `ApiHttpResponse` containing status code, body, and headers, or an
    /// error if the request fails.
    fn send_request(
        &self,
        method: &str,
        url: &str,
        headers: &HashMap<String, String>,
        body: Option<&RequestBody>,
    ) -> Pin<Box<dyn Future<Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>>;

    /// Send an HTTP request, optionally refusing to follow redirects.
    ///
    /// When `options.no_redirect` is `true`, any 3xx response (including
    /// 307/308) is returned to the caller as-is rather than being replayed to
    /// the `Location` target. OAuth2 token/revoke/authorize endpoint POSTs use
    /// this guard so a malicious or misconfigured server cannot replay the
    /// credentialed body to an attacker-controlled URL.
    ///
    /// The default implementation ignores `options` and delegates to
    /// `send_request` for backwards compatibility; transport implementations
    /// that own the redirect loop (such as `DefaultApiClient`) should override
    /// this method and honour the flag.
    fn send_request_with_options(
        &self,
        method: &str,
        url: &str,
        headers: &HashMap<String, String>,
        body: Option<&RequestBody>,
        _options: &RequestOptions,
    ) -> Pin<Box<dyn Future<Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        self.send_request(method, url, headers, body)
    }

    /// Sends an HTTP request and returns as soon as the response headers have
    /// arrived, with the body not read yet.
    ///
    /// The redirect, header and credential rules are those of
    /// [`send_request_with_options`](Self::send_request_with_options), up to the
    /// headers; `options.deadline` stops at the headers, and the idle timeout of
    /// the transport bounds the gap between two reads of the body. A non-2xx
    /// response is returned like any other, with its body open, and dropping the
    /// returned value aborts the connection.
    ///
    /// The default implementation returns an
    /// [`std::io::ErrorKind::Unsupported`] error that names the transport: a
    /// transport written before streaming keeps working for every buffered call,
    /// and a call that needs a stream fails clearly instead of falling back to
    /// buffering (a buffered fallback would never end on an endless feed).
    fn send_streaming(
        &self,
        _method: &str,
        _url: &str,
        _headers: &HashMap<String, String>,
        _body: Option<&RequestBody>,
        _options: &RequestOptions,
    ) -> Pin<Box<dyn Future<Output = Result<ApiStreamResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        let message = format!(
            "{} cannot stream: it does not implement send_streaming, so an operation that returns a stream cannot be called through it",
            std::any::type_name::<Self>()
        );
        Box::pin(async move {
            Err(Box::new(std::io::Error::new(std::io::ErrorKind::Unsupported, message))
                as Box<dyn std::error::Error + Send + Sync>)
        })
    }

    /// The number of times a failed call is sent again (network failure before
    /// a response, or a status of 408, 409, 429, 500-599 except 501). The
    /// default is `0`, so a custom client never retries; `DefaultApiClient`
    /// returns `TransportOptions::max_retries`.
    fn max_retries(&self) -> u32 {
        0
    }

    /// The end-to-end timeout of one call, which the retries of that call
    /// share. The default is `None` (no limit known to the caller);
    /// `DefaultApiClient` returns `TransportOptions::timeout`.
    fn request_timeout(&self) -> Option<std::time::Duration> {
        None
    }

    /// Releases any resources held by this client (connection pool, sockets).
    /// Default implementation is a no-op; implementations that own a pooled
    /// HTTP client should override and dispose of it. A transport that hands out
    /// streams should cancel the ones still open.
    fn close(&self) {
        /* No-op by default. Implementations override to release resources. */
    }

    /// Returns true once [`ApiClient::close`] has been called. The default is
    /// `false`; implementations that track a close flag override it.
    fn is_closed(&self) -> bool {
        false
    }
}

/// Writes `name: value` into `headers`, replacing any entry whose name matches
/// under ASCII case-folding (RFC 9110 section 5.1), so one header is never sent
/// under two spellings. The later layer wins and its spelling is kept.
pub(crate) fn insert_header(headers: &mut HashMap<String, String>, name: String, value: String) {
    remove_header(headers, &name);
    headers.insert(name, value);
}

/// Removes every entry of `headers` whose name matches `name` under ASCII
/// case-folding.
pub(crate) fn remove_header(headers: &mut HashMap<String, String>, name: &str) {
    headers.retain(|k, _| !k.eq_ignore_ascii_case(name));
}

#[cfg(test)]
mod tests {
    use super::*;

    /* The later layer replaces an earlier spelling of the same header and
     * keeps its own spelling, so only one line reaches the wire. */
    #[test]
    fn test_bhv_langrust_002_insert_header_replaces_a_case_variant_with_the_later_spelling() {
        let mut headers = HashMap::new();
        headers.insert("accept".to_string(), "text/plain".to_string());
        headers.insert("X-Other".to_string(), "kept".to_string());

        insert_header(&mut headers, "Accept".to_string(), "application/json".to_string());

        assert_eq!(2, headers.len());
        assert_eq!(Some(&"application/json".to_string()), headers.get("Accept"));
        assert!(!headers.contains_key("accept"));
        assert_eq!(Some(&"kept".to_string()), headers.get("X-Other"));
    }

    #[test]
    fn test_bhv_misc_182_remove_header_ignores_case() {
        let mut headers = HashMap::new();
        headers.insert("content-type".to_string(), "application/json".to_string());
        headers.insert("Content-Type".to_string(), "text/plain".to_string());

        remove_header(&mut headers, "Content-Type");

        assert!(headers.is_empty());
    }

    /* A transport that implements only `send_request` is still closable: the
     * default `close` is a no-op, so calling it (twice, even) is harmless and
     * the default `is_closed` stays false. */
    struct MinimalClient;

    impl ApiClient for MinimalClient {
        fn send_request(
            &self,
            _method: &str,
            _url: &str,
            _headers: &HashMap<String, String>,
            _body: Option<&RequestBody>,
        ) -> Pin<Box<dyn Future<Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
            Box::pin(async { Ok(ApiHttpResponse::new(200, String::new(), HashMap::new())) })
        }
    }

    #[test]
    fn test_bhv_lifecycle_038_a_minimal_transport_is_closable_through_the_default_close() {
        let client = MinimalClient;

        client.close();
        client.close();

        assert!(!client.is_closed());
        assert_eq!(0, client.max_retries());
        assert_eq!(None, client.request_timeout());
    }
}
