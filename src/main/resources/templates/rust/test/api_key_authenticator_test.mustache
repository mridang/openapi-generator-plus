use {{packageName}}::auth::api_key_authenticator::ApiKeyAuthenticator;
use {{packageName}}::auth::api_key_location::ApiKeyLocation;
use {{packageName}}::auth::Authenticator;

#[tokio::test(flavor = "multi_thread")]
async fn test_valid_header_key_passes() {
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "X-API-Key",
        "abc123",
        ApiKeyLocation::Header,
    );
    let headers = auth.auth_headers().await;
    assert_eq!(headers.get("X-API-Key").map(|s| s.as_str()), Some("abc123"));
}

#[test]
fn test_valid_query_key_passes() {
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "api_key",
        "abc123",
        ApiKeyLocation::Query,
    );
    let params = auth.query_params();
    assert_eq!(params.get("api_key").map(|s| s.as_str()), Some("abc123"));
}

#[test]
fn test_valid_cookie_key_passes() {
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "session",
        "abc123",
        ApiKeyLocation::Cookie,
    );
    let params = auth.cookie_params();
    assert_eq!(params.get("session").map(|s| s.as_str()), Some("abc123"));
}

#[test]
fn test_query_accepts_non_ascii() {
    // Non-header locations accept arbitrary chars.
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "api_key",
        "kéy",
        ApiKeyLocation::Query,
    );
    assert_eq!(auth.query_params().get("api_key"), Some(&"kéy".to_string()));
}

