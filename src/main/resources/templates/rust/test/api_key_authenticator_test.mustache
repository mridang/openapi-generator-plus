/// Empty or whitespace-only keys and CR/LF/NUL are rejected at every
/// location; RFC 7230 §3.2.6 also rejects anything outside printable ASCII in
/// a header key. Every rejection is `ConfigurationError::InvalidArgument`,
/// never a panic.
#[test]
fn test_bhv_auth_009_invalid_keys_are_invalid_arguments() {
    for (key, location, expected) in [
        ("", ApiKeyLocation::Header, "must not be empty"),
        ("", ApiKeyLocation::Query, "must not be empty"),
        ("", ApiKeyLocation::Cookie, "must not be empty"),
        ("   ", ApiKeyLocation::Header, "must not be empty"),
        ("\x0b\x0c \t", ApiKeyLocation::Query, "must not be empty"),
        ("abc\r\n", ApiKeyLocation::Query, "control characters"),
        ("abc\n", ApiKeyLocation::Cookie, "control characters"),
        ("abc\rdef", ApiKeyLocation::Header, "control characters"),
        ("kéy", ApiKeyLocation::Header, "printable ASCII"),
    ] {
        match ApiKeyAuthenticator::new("https://api.example.com", "X-API-Key", key, location) {
            Err(ConfigurationError::InvalidArgument(reason)) => {
                assert!(reason.contains(expected), "{}", reason)
            }
            other => panic!(
                "expected ConfigurationError::InvalidArgument for {:?}, got {:?}",
                key, other
            ),
        }
    }
}

/// The default Debug representation must mask the stored API key: the secret
/// value must be absent and a `***` redaction marker present.
#[test]
fn test_bhv_authapikey_010_redacts_the_api_key_in_tostring() {
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "X-API-Key",
        "abc123",
        ApiKeyLocation::Header,
    )
    .unwrap();
    let debug = format!("{:?}", auth);
    assert!(!debug.contains("abc123"));
    assert!(debug.contains("***"));
}

/// The redacted representation shows the non-secret fields (host, parameter
/// name and location) and masks only the key.
#[test]
fn test_bhv_authapikey_012_redacted_representation_shows_the_non_secret_fields() {
    for (location, name) in [
        (ApiKeyLocation::Header, "Header"),
        (ApiKeyLocation::Query, "Query"),
        (ApiKeyLocation::Cookie, "Cookie"),
    ] {
        let auth =
            ApiKeyAuthenticator::new("https://api.example.com", "k-name", "abc123", location)
                .unwrap();
        let expected = "ApiKeyAuthenticator { host: \"https://api.example.com\", \
key_param_name: \"k-name\", api_key: \"***\", location: "
            .to_string()
            + name
            + " }";
        assert_eq!(expected, format!("{:?}", auth));
    }
}

#[test]
fn test_bhv_authapikey_020_scheme_wrapper_debug_names_the_wrapper_and_redacts_the_key() {
    let auth = ApiKeyHeaderAuthenticator::new("https://api.example.com", Some("wrapper-key")).unwrap();
    let debug = format!("{:?}", auth);
    assert!(debug.starts_with("ApiKeyHeaderAuthenticator("), "{}", debug);
    assert!(!debug.contains("wrapper-key"), "{}", debug);
    assert!(debug.contains("***"), "{}", debug);
}

/// Each generated scheme wrapper emits its key under the name and at the
/// location its security scheme declares, and nowhere else.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authapikey_007_scheme_wrappers_emit_the_key_at_the_declared_name_and_location() {
    let host = "https://api.example.com";

    let header = ApiKeyHeaderAuthenticator::new(host, Some("key-1")).unwrap();
    assert_eq!(header.auth_headers().await.get("X-API-Key"), Some(&"key-1".to_string()));
    assert!(header.query_params().is_empty());
    assert!(header.cookie_params().is_empty());

    let internal = InternalApiKeyAuthenticator::new(host, Some("key-2")).unwrap();
    assert_eq!(internal.auth_headers().await.get("X-Internal-Key"), Some(&"key-2".to_string()));
    assert!(internal.query_params().is_empty());
    assert!(internal.cookie_params().is_empty());

    let query = ApiKeyQueryAuthenticator::new(host, Some("key-3")).unwrap();
    assert_eq!(query.query_params().get("api_key"), Some(&"key-3".to_string()));
    assert!(query.auth_headers().await.is_empty());
    assert!(query.cookie_params().is_empty());

    let cookie = SessionCookieAuthenticator::new(host, Some("key-4")).unwrap();
    assert_eq!(cookie.cookie_params().get("SESSION_ID"), Some(&"key-4".to_string()));
    assert!(cookie.auth_headers().await.is_empty());
    assert!(cookie.query_params().is_empty());
}

/// A wrapper validates its key as eagerly as the authenticator it wraps.
#[test]
fn test_bhv_authapikey_019_scheme_wrappers_reject_an_empty_key() {
    let host = "https://api.example.com";
    for result in [
        ApiKeyHeaderAuthenticator::new(host, Some("")).map(|_| ()),
        InternalApiKeyAuthenticator::new(host, Some("")).map(|_| ()),
        ApiKeyQueryAuthenticator::new(host, Some("")).map(|_| ()),
        SessionCookieAuthenticator::new(host, Some("")).map(|_| ()),
    ] {
        match result {
            Err(ConfigurationError::InvalidArgument(reason)) => {
                assert!(reason.contains("must not be empty"), "{}", reason)
            }
            other => panic!("expected ConfigurationError::InvalidArgument, got {:?}", other),
        }
    }
}

/// Every wrapper prints its own name around the redacted inner authenticator.
#[test]
fn test_bhv_authapikey_025_scheme_wrappers_mask_the_key_and_keep_the_declared_name() {
    let host = "https://api.example.com";
    assert_eq!(
        "ApiKeyHeaderAuthenticator(ApiKeyAuthenticator { host: \"https://api.example.com\", key_param_name: \"X-API-Key\", api_key: \"***\", location: Header })",
        format!("{:?}", ApiKeyHeaderAuthenticator::new(host, Some("secret-1")).unwrap())
    );
    assert_eq!(
        "InternalApiKeyAuthenticator(ApiKeyAuthenticator { host: \"https://api.example.com\", key_param_name: \"X-Internal-Key\", api_key: \"***\", location: Header })",
        format!("{:?}", InternalApiKeyAuthenticator::new(host, Some("secret-2")).unwrap())
    );
    assert_eq!(
        "ApiKeyQueryAuthenticator(ApiKeyAuthenticator { host: \"https://api.example.com\", key_param_name: \"api_key\", api_key: \"***\", location: Query })",
        format!("{:?}", ApiKeyQueryAuthenticator::new(host, Some("secret-3")).unwrap())
    );
    assert_eq!(
        "SessionCookieAuthenticator(ApiKeyAuthenticator { host: \"https://api.example.com\", key_param_name: \"SESSION_ID\", api_key: \"***\", location: Cookie })",
        format!("{:?}", SessionCookieAuthenticator::new(host, Some("secret-4")).unwrap())
    );
}

/// A key is emitted only at the location it was declared for, and nowhere else.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authapikey_022_a_key_is_emitted_only_at_its_own_location() {
    let host = "https://api.example.com";

    let header = ApiKeyAuthenticator::new(host, "X-API-Key", "abc123", ApiKeyLocation::Header).unwrap();
    assert_eq!(header.auth_headers().await.get("X-API-Key"), Some(&"abc123".to_string()));
    assert!(header.query_params().is_empty());
    assert!(header.cookie_params().is_empty());

    let query = ApiKeyAuthenticator::new(host, "api_key", "abc123", ApiKeyLocation::Query).unwrap();
    assert_eq!(query.query_params().get("api_key"), Some(&"abc123".to_string()));
    assert!(query.auth_headers().await.is_empty());
    assert!(query.cookie_params().is_empty());

    let cookie = ApiKeyAuthenticator::new(host, "SESSION_ID", "abc123", ApiKeyLocation::Cookie).unwrap();
    assert_eq!(cookie.cookie_params().get("SESSION_ID"), Some(&"abc123".to_string()));
    assert!(cookie.auth_headers().await.is_empty());
    assert!(cookie.query_params().is_empty());
}

