#[test]
#[should_panic(expected = "control characters")]
fn test_crlf_in_header_key_panics() {
    // RFC 7230 §3.2.6 — the Header location must reject CR/LF to prevent
    // header injection. CR/LF is caught by the control-character guard
    // before the printable-ASCII check.
    let _ = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "X-API-Key",
        "abc\rdef",
        ApiKeyLocation::Header,
    );
}

#[test]
#[should_panic(expected = "printable ASCII")]
fn test_non_ascii_header_key_panics() {
    let _ = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "X-API-Key",
        "kéy",
        ApiKeyLocation::Header,
    );
}

/// The default Debug representation must mask the stored API key: the secret
/// value must be absent and a `***` redaction marker present.
#[test]
fn test_redacts_secret() {
    let auth = ApiKeyAuthenticator::new(
        "https://api.example.com",
        "X-API-Key",
        "abc123",
        ApiKeyLocation::Header,
    );
    let debug = format!("{:?}", auth);
    assert!(!debug.contains("abc123"));
    assert!(debug.contains("***"));
}
