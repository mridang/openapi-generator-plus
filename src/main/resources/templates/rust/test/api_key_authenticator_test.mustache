/// The reason a key is refused at construction, or a panic when it is accepted.
fn refusal_reason(key: &str, location: ApiKeyLocation) -> String {
    match ApiKeyAuthenticator::new("https://api.example.com", "X-API-Key", key, location) {
        Err(ConfigurationError::InvalidArgument(reason)) => reason,
        other => panic!("expected ConfigurationError::InvalidArgument for {:?}, got {:?}", key, other),
    }
}

