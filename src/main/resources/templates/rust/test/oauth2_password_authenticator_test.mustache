#[tokio::test(flavor = "multi_thread")]
async fn test_returns_authorization_bearer_header() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"tok-pwd","expires_in":3600}"#, 200);

    let mut auth = create_authenticator();
    auth.set_api_client(client.clone());

    let headers = auth.auth_headers();

    assert_eq!("Bearer tok-pwd", headers.get("Authorization").unwrap());
}

#[tokio::test(flavor = "multi_thread")]
async fn test_uses_refresh_token_on_subsequent_calls() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(
        r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":1}"#,
        200,
    );
    client.enqueue(r#"{"access_token":"tok2","expires_in":3600}"#, 200);

    let mut auth = create_authenticator();
    auth.set_api_client(client.clone());

    // First call uses password grant
    auth.auth_headers();
    // Second call should use refresh_token grant since token is expired
    auth.auth_headers();

    let body = client.last_body().expect("should have body");
    assert!(body.contains("grant_type=refresh_token"));
    assert!(body.contains("refresh_token=ref1"));
}

#[test]
fn test_get_host_returns_configured_host() {
    let auth = create_authenticator();
    assert_eq!("https://api.example.com", auth.host());
}
