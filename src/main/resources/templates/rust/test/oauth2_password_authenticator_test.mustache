/// The Basic client-auth header keeps `-._~` literal and percent-encodes
/// everything else, including `*`, `!`, `'`, `(` and `)`.
#[tokio::test(flavor = "multi_thread")]
async fn test_basic_auth_encodes_the_unreserved_set_exactly() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"at","expires_in":3600}"#, 200);
    let mut auth = OAuth2PasswordAuthenticator::new(
        "https://api.example.com",
        "id~1-2_3.4*5!6'7(8)",
        "s ecret",
        "https://auth.example.com/token",
        "testuser",
        "testpass",
        vec!["read".to_string()],
        "",
    )
    .with_client_auth_method(ClientAuthMethod::Basic);
    auth.set_api_client(client.clone());

    auth.auth_headers().await;

    let headers = client.last_headers().expect("should have headers");
    let encoded = &headers.get("Authorization").expect("Authorization header")["Basic ".len()..];
    let decoded = String::from_utf8(BASE64_STANDARD.decode(encoded).expect("base64")).expect("utf8");
    assert_eq!("id~1-2_3.4%2A5%216%277%288%29:s+ecret", decoded);
}

