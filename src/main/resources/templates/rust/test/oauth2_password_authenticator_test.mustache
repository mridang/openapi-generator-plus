use std::collections::HashMap;
use std::future::Future;
use std::pin::Pin;
use std::sync::{Arc, Mutex};

use {{packageName}}::api_client::{ApiClient, RequestBody};
use {{packageName}}::api_http_response::ApiHttpResponse;
use {{packageName}}::auth::oauth::client_auth_method::ClientAuthMethod;
use {{packageName}}::auth::oauth::{LegacyAuthPasswordAuthenticator, OAuth2PasswordAuthenticator};
