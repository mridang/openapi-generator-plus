/// RFC 6749 §6: in BODY mode the refresh grant carries the client credentials
/// in the body, exactly as the password grant did.
#[tokio::test(flavor = "multi_thread")]
async fn test_refresh_grant_authenticates_the_client_in_the_body() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":1}"#, 200);
    client.enqueue(r#"{"access_token":"tok2","expires_in":3600}"#, 200);
    let mut auth = create_authenticator();
    auth.set_api_client(client.clone());

    auth.auth_headers().await;
    auth.auth_headers().await;

    assert_eq!(
        Some(
            "grant_type=refresh_token&refresh_token=ref1&client_id=my-client-id&client_secret=my-client-secret"
                .to_string()
        ),
        client.last_body()
    );
}

/// In BASIC mode the refresh grant carries the Basic header and no client
/// credentials in the body.
#[tokio::test(flavor = "multi_thread")]
async fn test_refresh_grant_authenticates_the_client_with_basic() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":1}"#, 200);
    client.enqueue(r#"{"access_token":"tok2","expires_in":3600}"#, 200);
    let mut auth = create_authenticator().with_client_auth_method(ClientAuthMethod::Basic);
    auth.set_api_client(client.clone());

    auth.auth_headers().await;
    auth.auth_headers().await;

    assert_eq!(
        Some("grant_type=refresh_token&refresh_token=ref1".to_string()),
        client.last_body()
    );
    let headers = client.last_headers().expect("should have headers");
    assert_eq!(
        Some(&format!("Basic {}", BASE64_STANDARD.encode("my-client-id:my-client-secret"))),
        headers.get("Authorization")
    );
}

/// A rejected refresh falls back to re-running the password grant at the
/// token URL, and that grant's token is returned.
#[tokio::test(flavor = "multi_thread")]
async fn test_rejected_refresh_falls_back_to_the_password_grant() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":1}"#, 200);
    client.enqueue(r#"{"error":"invalid_grant"}"#, 400);
    client.enqueue(r#"{"access_token":"tok3","expires_in":3600}"#, 200);
    let mut auth = OAuth2PasswordAuthenticator::new(
        "https://api.example.com",
        "my-client-id",
        "my-client-secret",
        "https://auth.example.com/token",
        "testuser",
        "testpass",
        vec![],
        "https://auth.example.com/refresh",
    );
    auth.set_api_client(client.clone());

    auth.auth_headers().await;
    let headers = auth.try_auth_headers().await.expect("the password grant succeeds");

    assert_eq!(Some(&"Bearer tok3".to_string()), headers.get("Authorization"));
    assert_eq!(
        vec![
            "https://auth.example.com/token".to_string(),
            "https://auth.example.com/refresh".to_string(),
            "https://auth.example.com/token".to_string()
        ],
        client.urls()
    );
    assert!(
        client.last_body().unwrap_or_default().starts_with("grant_type=password&"),
        "{:?}",
        client.last_body()
    );
}
