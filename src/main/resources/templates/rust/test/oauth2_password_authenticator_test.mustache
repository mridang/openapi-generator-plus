/// The first grant goes to the token URL and the refresh grant to the refresh
/// URL; with no refresh URL the refresh grant falls back to the token URL.
#[tokio::test(flavor = "multi_thread")]
async fn test_refresh_grant_goes_to_the_refresh_url() {
    for (refresh_url, expected_refresh_target) in [
        ("https://auth.example.com/refresh", "https://auth.example.com/refresh"),
        ("", "https://auth.example.com/token"),
    ] {
        let client = Arc::new(FakeApiClient::new());
        client.enqueue(r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":1}"#, 200);
        client.enqueue(r#"{"access_token":"tok2","expires_in":3600}"#, 200);
        let mut auth = OAuth2PasswordAuthenticator::new(
            "https://api.example.com",
            "my-client-id",
            "my-client-secret",
            "https://auth.example.com/token",
            "testuser",
            "testpass",
            vec!["read".to_string()],
            refresh_url,
        );
        auth.set_api_client(client.clone());

        auth.auth_headers().await;
        auth.auth_headers().await;

        assert_eq!(
            vec![
                "https://auth.example.com/token".to_string(),
                expected_refresh_target.to_string()
            ],
            client.urls(),
            "refresh url {:?}",
            refresh_url
        );
    }
}

