// The fixture-container helper is shared by every integration-test binary, so its own
// tests live here, in the one binary that exercises them.

mod testcontainers_helper;

fn lock_path_for(name: &str) -> std::path::PathBuf {
    std::env::temp_dir().join(format!("openapi-generator-{}-{}.lock", name, std::process::id()))
}

#[test]
fn test_bhv_langrust_052_creation_lock_is_released_when_the_guarded_body_panics() {
    let path = lock_path_for("panic");
    let _ = std::fs::remove_file(&path);

    let outcome = std::panic::catch_unwind(|| {
        testcontainers_helper::with_lock_file(&path, || panic!("docker is not reachable"))
    });

    assert!(outcome.is_err(), "the panic must propagate to the caller");
    assert!(!path.exists(), "a panicking body must not leave the lock file behind");
}

#[test]
fn test_bhv_langrust_053_creation_lock_is_released_when_the_guarded_body_returns() {
    let path = lock_path_for("return");
    let _ = std::fs::remove_file(&path);

    let value = testcontainers_helper::with_lock_file(&path, || {
        assert!(path.exists(), "the lock file must exist while the body runs");
        7
    });

    assert_eq!(7, value);
    assert!(!path.exists(), "the lock file must be removed after the body returns");
}

#[test]
fn test_bhv_langrust_054_panic_message_reports_str_and_string_payloads() {
    let from_str = std::panic::catch_unwind(|| panic!("static reason")).unwrap_err();
    assert_eq!("static reason", testcontainers_helper::panic_message(from_str.as_ref()));

    let from_string = std::panic::catch_unwind(|| panic!("{} reason", "formatted")).unwrap_err();
    assert_eq!("formatted reason", testcontainers_helper::panic_message(from_string.as_ref()));
}
