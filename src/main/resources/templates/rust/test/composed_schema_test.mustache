// -- oneOf with discriminator: PetFood --

#[test]
fn test_pet_food_deserialize_dry_food() {
    let json_data = r#"{"foodType":"dry","weightKg":2.5}"#;

    let food: PetFood =
        serde_json::from_str(json_data).expect("failed to deserialize PetFood as DryFood");

    match food {
        PetFood::DryFood(_) => {} // expected
        _ => panic!("expected DryFood variant, got {:?}", food),
    }
}

