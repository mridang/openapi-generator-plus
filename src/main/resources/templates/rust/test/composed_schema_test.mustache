#[test]
fn test_pet_food_deserialize_unknown_discriminator() {
    let json_data = r#"{"foodType":"raw","calories":300}"#;

    let result = serde_json::from_str::<PetFood>(json_data);
    assert!(
        result.is_err(),
        "expected error for unknown discriminator value"
