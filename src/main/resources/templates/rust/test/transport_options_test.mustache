/* D79: the proxy messages are the canonical ones, and the userinfo of the
 * rejected URL is shown as `***@`, so a proxy credential never reaches a log. */
#[test]
fn test_bhv_options_024_transport_options_invalid_proxy_url_throws_exception() {
    for (proxy, message) in [
        ("not-a-valid-url", "Invalid proxy URL: not-a-valid-url"),
        (
            "ftp://proxy.example.com:21",
            "Invalid proxy URL (must use http or https scheme): ftp://proxy.example.com:21",
        ),
        (
            "socks5://proxy.example.com:1080",
            "Invalid proxy URL (must use http or https scheme): socks5://proxy.example.com:1080",
        ),
        ("http://", "Invalid proxy URL (missing host): http://"),
        (
            "ftp://user:s3cr3t@proxy.example.com:21",
            "Invalid proxy URL (must use http or https scheme): ftp://***@proxy.example.com:21",
        ),
        (
            "http://user:s3cr3t@",
            "Invalid proxy URL (missing host): http://***@",
        ),
    ] {
        let result = TransportOptionsBuilder::new().proxy(proxy).build();
        assert_eq!(
            result.as_ref().err(),
            Some(&ConfigurationError::InvalidProxy(message.to_string())),
            "unexpected result for {:?}: {:?}",
            proxy,
            result
        );
        assert_eq!(
            result.err().map(|e| e.to_string()),
            Some(message.to_string()),
            "the error must display the canonical message verbatim"
        );
    }
}

/// F1065: an IPv6 literal host is a valid proxy host (brackets kept, userinfo
