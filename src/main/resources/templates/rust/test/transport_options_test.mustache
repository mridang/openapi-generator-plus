#[test]
fn test_transport_options_missing_ca_cert_file_is_rejected() {
    let result = TransportOptionsBuilder::new()
        .ca_cert_path("/nonexistent/ca.pem")
        .build();
    match result {
        Err(ConfigurationError::InvalidCaCertificate(message)) => assert!(
            message.starts_with("failed to read CA certificate from \"/nonexistent/ca.pem\": "),
            "unexpected message: {}",
            message
        ),
        other => panic!("expected InvalidCaCertificate, got {:?}", other),
    }
}

/// Builds transport options around a CA file holding `contents` and returns the
/// reason the build was rejected, panicking if it was accepted.
fn ca_file_rejection(name: &str, contents: &str) -> String {
    let path = std::env::temp_dir().join(format!("ca-cert-{}-{}.pem", std::process::id(), name));
    std::fs::write(&path, contents).expect("failed to write the CA file");
    let result = TransportOptionsBuilder::new()
        .ca_cert_path(path.to_str().expect("temp path is UTF-8"))
        .build();
    let _ = std::fs::remove_file(&path);
    match result {
        Err(ConfigurationError::InvalidCaCertificate(reason)) => reason,
        other => panic!("expected InvalidCaCertificate, got {:?}", other),
    }
}

#[test]
fn test_bhv_errors_039_a_garbage_pem_ca_cert_path_is_rejected_when_the_options_are_built() {
    let reason = ca_file_rejection("no-pem", "this is not a certificate\n");
    assert!(
        reason.starts_with("failed to parse CA certificate from ") && reason.ends_with(": no PEM blocks found"),
        "unexpected reason: {}",
        reason
    );
}

