fn test_bhv_options_009_transport_options_proxy_with_an_ipv6_literal_host() {
    for proxy in ["http://[::1]:3128", "http://user@[::1]:3128", "https://[2001:db8::1]"] {
        let opts = TransportOptionsBuilder::new()
            .proxy(proxy)
            .build()
            .expect("an IPv6 literal proxy host is valid");
        assert_eq!(opts.proxy(), Some(proxy));
    }
}

/// F1065: an unterminated IPv6 literal is rejected, with the userinfo of the
/// rejected URL masked as `***@`.
#[test]
fn test_bhv_options_010_a_proxy_url_with_an_unterminated_ipv6_literal_is_rejected() {
    for (proxy, message) in [
        ("http://[::1:3128", "Invalid proxy URL: http://[::1:3128"),
        ("http://user@[::1:3128", "Invalid proxy URL: http://***@[::1:3128"),
    ] {
        let result = TransportOptionsBuilder::new().proxy(proxy).build();
        assert_eq!(
            result.err(),
            Some(ConfigurationError::InvalidProxy(message.to_string())),
            "unexpected result for {:?}",
            proxy
        );
    }
}

/// A proxy URL error never carries the userinfo of the rejected URL: the
/// password is replaced by the `***` mask.
#[test]
fn test_bhv_options_008_a_proxy_url_error_never_carries_the_user_info() {
    let secret = ["s3", "cr3t"].concat();
    for proxy in [
        format!("ftp://user:{}@proxy.example.com:21", secret),
        format!("http://user:{}@", secret),
    ] {
        let text = TransportOptionsBuilder::new()
            .proxy(&proxy)
            .build()
            .expect_err("the proxy URL is rejected")
            .to_string();
        assert!(!text.contains(&secret), "{}", text);
        assert!(text.contains("***@"), "{}", text);
    }
}

