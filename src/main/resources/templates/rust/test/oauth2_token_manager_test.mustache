    client.enqueue(
        r#"{"access_token":"tok1","refresh_token":"ref1","expires_in":3600}"#,
        200,
    );

    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);

    let mut params = HashMap::new();
    params.insert("grant_type".to_string(), "authorization_code".to_string());

    manager
        .get_access_token("https://auth.example.com/token", &params)
        .expect("should succeed");

    assert_eq!("ref1", manager.refresh_token());
}

#[tokio::test(flavor = "multi_thread")]
async fn test_returns_cached_token_when_not_expired() {
    let client = Arc::new(FakeApiClient::new());
    client.enqueue(r#"{"access_token":"tok1","expires_in":3600}"#, 200);

    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);

    let mut params = HashMap::new();
    params.insert("grant_type".to_string(), "client_credentials".to_string());

    let first = manager
        .get_access_token("https://auth.example.com/token", &params)
        .expect("should succeed");
    let second = manager
        .get_access_token("https://auth.example.com/token", &params)
        .expect("should succeed");

    assert_eq!("tok1", first);
    assert_eq!("tok1", second);
}

#[tokio::test(flavor = "multi_thread")]
async fn test_refetches_token_when_expired() {
    let client = Arc::new(FakeApiClient::new());
    // First token with 1 second expiry (treated as expired due to 30s buffer)
    client.enqueue(r#"{"access_token":"tok1","expires_in":1}"#, 200);
    client.enqueue(r#"{"access_token":"tok2","expires_in":3600}"#, 200);

    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);

    let mut params = HashMap::new();
    params.insert("grant_type".to_string(), "client_credentials".to_string());

    let first = manager
        .get_access_token("https://auth.example.com/token", &params)
        .expect("should succeed");
    let second = manager
        .get_access_token("https://auth.example.com/token", &params)
        .expect("should succeed");

    assert_eq!("tok1", first);
    assert_eq!("tok2", second);
}

