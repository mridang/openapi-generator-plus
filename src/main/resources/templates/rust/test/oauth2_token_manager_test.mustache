        ("", "Token response is not valid JSON"),
        ("[1, 2]", "Token response is not a JSON object"),
        ("\"tok\"", "Token response is not a JSON object"),
        ("{}", "Token response missing or empty access_token field"),
        (r#"{"access_token":""}"#, "Token response missing or empty access_token field"),
    ] {
        let client = Arc::new(FakeApiClient::new());
        client.enqueue(body, 200);
        let manager = OAuth2TokenManager::new();
        manager.set_api_client(client);
        let mut params = HashMap::new();
        params.insert("grant_type".to_string(), "client_credentials".to_string());

        let err = manager
            .get_access_token("https://auth.example.com/token", &params)
            .await
            .expect_err("an unusable token response must error");

        let token_err = err
            .downcast_ref::<OAuth2TokenError>()
            .unwrap_or_else(|| panic!("expected OAuth2TokenError for {body:?}, got: {err}"));
        assert_eq!(expected, token_err.message(), "body {body:?}");
