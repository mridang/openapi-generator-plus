/// Token endpoint: a 2xx body that is not JSON is an `OAuth2TokenError`, a
/// non-2xx answer an `OAuth2ServerError`, and a transport failure passes
/// through as the `NetworkError` / `NetworkTimeoutError` it already is.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authoauthtwotokenmgr_037_token_endpoint_failures_are_typed() {
    let mut params = HashMap::new();
    params.insert("grant_type".to_string(), "client_credentials".to_string());

    let client = Arc::new(FakeApiClient::new());
    client.enqueue("<html>ok</html>", 200);
    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);
    let err = manager
        .get_access_token("https://auth.example.com/token", &params)
        .await
        .expect_err("a non-JSON 2xx body must fail");
    assert!(err.downcast_ref::<OAuth2TokenError>().is_some(), "got: {}", err);

    let client = Arc::new(FakeApiClient::new());
    client.enqueue("upstream down", 503);
    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);
    let err = manager
        .get_access_token("https://auth.example.com/token", &params)
        .await
        .expect_err("a 503 must fail");
    assert!(err.downcast_ref::<OAuth2ServerError>().is_some(), "got: {}", err);

    let client = Arc::new(FakeApiClient::new());
    client.enqueue_error(Box::new(NetworkError::try_from(ApiError::new(
        0,
        "connection refused".to_string(),
        None,
        None,
    )).expect("status 0")));
    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);
    let err = manager
        .get_access_token("https://auth.example.com/token", &params)
        .await
        .expect_err("a refused connection must fail");
    assert!(err.downcast_ref::<NetworkError>().is_some(), "got: {}", err);

    let client = Arc::new(FakeApiClient::new());
    client.enqueue_error(Box::new(NetworkTimeoutError::from(
        NetworkError::try_from(ApiError::new(0, "timed out".to_string(), None, None))
            .expect("status 0"),
    )));
    let manager = OAuth2TokenManager::new();
    manager.set_api_client(client);
    let err = manager
        .get_access_token("https://auth.example.com/token", &params)
        .await
        .expect_err("a timeout must fail");
    assert!(err.downcast_ref::<NetworkTimeoutError>().is_some(), "got: {}", err);
}

/// Counts every request so the single-flight test can assert that N
/// concurrent callers collapse onto exactly one token endpoint hit.
struct CountingApiClient {
    call_count: Mutex<usize>,
    response_body: String,
    delay_ms: u64,
}

impl CountingApiClient {
    fn new(response_body: &str, delay_ms: u64) -> Self {
        Self {
            call_count: Mutex::new(0),
            response_body: response_body.to_string(),
            delay_ms,
        }
    }

    fn calls(&self) -> usize {
        *self.call_count.lock().unwrap()
    }
}

impl ApiClient for CountingApiClient {
    fn send_request(
        &self,
        _method: &str,
        _url: &str,
        _headers: &HashMap<String, String>,
        _body: Option<&RequestBody>,
    ) -> Pin<Box<dyn Future<Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        {
            let mut count = self.call_count.lock().unwrap();
            *count += 1;
        }
        let body = self.response_body.clone();
        let delay = self.delay_ms;
        Box::pin(async move {
            tokio::time::sleep(std::time::Duration::from_millis(delay)).await;
            Ok(ApiHttpResponse::new(200, body, HashMap::new()))
        })
    }
}

#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authoauthtwotokenmgr_027_concurrent_refresh_is_single_flight() {
    let client = Arc::new(CountingApiClient::new(
        r#"{"access_token":"single-flight","expires_in":3600}"#,
        100,
    ));

    let manager = Arc::new(OAuth2TokenManager::new());
    manager.set_api_client(client.clone());

    let mut handles = Vec::new();
    for _ in 0..10 {
        let manager = manager.clone();
        handles.push(tokio::spawn(async move {
            let mut params = HashMap::new();
            params.insert("grant_type".to_string(), "client_credentials".to_string());
            manager
                .get_access_token("https://auth.example.com/token", &params)
                .await
                .expect("token fetch should succeed")
        }));
    }

    for handle in handles {
        let token = handle.await.expect("task should not panic");
        assert_eq!("single-flight", token);
    }

    assert_eq!(
        1,
        client.calls(),
        "concurrent callers must collapse onto a single token endpoint call"
    );
}

