use {{packageName}}::auth::Authenticator;
use {{packageName}}::auth::BasicAuthenticator;
use {{packageName}}::ConfigurationError;

#[tokio::test(flavor = "multi_thread")]
async fn test_valid_credentials_produce_basic_header() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    let headers = auth.auth_headers().await;
    assert_eq!(
        headers.get("Authorization").map(|s| s.as_str()),
        Some("Basic YWxpY2U6czNjcmV0")
    );
}

/// basic-auth-rust-silent-drop: malformed credentials (CR/LF/NUL in either
/// field, or a colon in the username, per RFC 7617 §2) fail closed at
/// construction with `ConfigurationError::InvalidArgument` — never a panic and
/// never an empty header map that would send the request unauthenticated.
#[test]
fn test_malformed_credentials_are_invalid_arguments() {
    for (username, password) in [
        ("alice\r\n", "s3cret"),
        ("al\nice", "s3cret"),
        ("alice", "s3c\0ret"),
        ("ali:ce", "s3cret"),
    ] {
        match BasicAuthenticator::new("https://api.example.com", username, password) {
            Err(ConfigurationError::InvalidArgument(reason)) => {
                assert!(reason.contains("invalid HTTP Basic credentials"), "{}", reason)
            }
            other => panic!(
                "expected ConfigurationError::InvalidArgument for ({:?}, {:?}), got {:?}",
                username, password, other
            ),
        }
    }
}

#[test]
fn redacts_secret() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    let debug = format!("{:?}", auth);
    assert!(!debug.contains("s3cret"));
    assert!(debug.contains("***"));
}
