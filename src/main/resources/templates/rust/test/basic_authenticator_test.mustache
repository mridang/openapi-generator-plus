/// authenticator-secret-in-default-string-repr: BasicAuthenticator has a manual
/// Debug impl that redacts the password as `***`. Formatting it with `{:?}`
/// must never leak the secret.
#[tokio::test(flavor = "multi_thread")]
async fn test_password_is_not_leaked_in_default_repr() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret");
    let debug = format!("{:?}", auth);
    assert!(!debug.contains("s3cret"));
    assert!(debug.contains("***"));
}

/// basic-auth-rust-silent-drop: malformed credentials must FAIL CLOSED
/// (panic), never silently produce an empty header map that would send the
/// request unauthenticated. This panics rather than returning `{}`.
#[tokio::test(flavor = "multi_thread")]
#[should_panic(expected = "invalid HTTP Basic credentials")]
async fn test_malformed_credentials_panic_not_silent_drop() {
    let _ = BasicAuthenticator::new("https://api.example.com", "al\nice", "s3cret");
}
