use {{packageName}}::auth::Authenticator;
use {{packageName}}::auth::{AdminBasicAuthenticator, BasicAuthenticator, PetStoreBasicAuthenticator};
use {{packageName}}::ConfigurationError;

#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authbasic_011_valid_credentials_produce_basic_header() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    let headers = auth.auth_headers().await;
    assert_eq!(
        headers.get("Authorization").map(|s| s.as_str()),
        Some("Basic YWxpY2U6czNjcmV0")
    );
}

/// basic-auth-rust-silent-drop: malformed credentials (CR/LF/NUL in either
/// field, or a colon in the username, per RFC 7617 §2) fail closed at
/// construction with `ConfigurationError::InvalidArgument` — never a panic and
/// never an empty header map that would send the request unauthenticated.
fn assert_rejected_at_construction(username: &str, password: &str, expected: &str) {
    match BasicAuthenticator::new("https://api.example.com", username, password) {
        Err(ConfigurationError::InvalidArgument(reason)) => assert_eq!(expected, reason),
        other => panic!(
            "expected ConfigurationError::InvalidArgument for ({:?}, {:?}), got {:?}",
            username, password, other
        ),
    }
}

#[test]
fn test_bhv_authbasic_009_rejects_username_with_crlf_at_construction() {
    assert_rejected_at_construction(
        "alice\r\n",
        "s3cret",
        "Basic auth username must not contain CR, LF, or NUL characters",
    );
    assert_rejected_at_construction(
        "al\nice",
        "s3cret",
        "Basic auth username must not contain CR, LF, or NUL characters",
    );
}

#[test]
fn test_bhv_authbasic_007_rejects_password_with_nul_at_construction() {
    assert_rejected_at_construction(
        "alice",
        "s3c\0ret",
        "Basic auth password must not contain CR, LF, or NUL characters",
    );
}

#[test]
fn test_bhv_authbasic_008_rejects_username_with_colon_at_construction() {
    assert_rejected_at_construction(
        "ali:ce",
        "s3cret",
        "Basic auth username must not contain ':' (RFC 7617 §2)",
    );
}

#[test]
fn test_bhv_authbasic_006_redacts_secret() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    let debug = format!("{:?}", auth);
    assert!(!debug.contains("s3cret"));
    assert!(debug.contains("***"));
}

#[test]
fn test_bhv_authbasic_005_password_is_not_leaked_in_default_to_string() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    let text = format!("{:?}", auth);
    assert!(!text.contains("s3cret"), "{}", text);
}

#[test]
fn test_scheme_wrapper_debug_names_the_wrapper_and_redacts_the_password() {
    let auth = AdminBasicAuthenticator::new("https://api.example.com", Some("alice"), Some("s3cret")).unwrap();
    let debug = format!("{:?}", auth);
    assert!(debug.starts_with("AdminBasicAuthenticator("), "{}", debug);
    assert!(!debug.contains("s3cret"), "{}", debug);
    assert!(debug.contains("***"), "{}", debug);
}

/// Non-ASCII credentials are sent as UTF-8 bytes (RFC 7617 section 2.1), not as
/// Latin-1 or the platform encoding.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authbasic_004_non_ascii_credentials_are_encoded_as_utf8() {
    let auth = BasicAuthenticator::new("https://api.example.com", "ünïcødé", "pässwörd").unwrap();
    let headers = auth.auth_headers().await;
    assert_eq!(
        headers.get("Authorization").map(|s| s.as_str()),
        Some("Basic w7xuw69jw7hkw6k6cMOkc3N3w7ZyZA==")
    );
}

/// The redacted representation shows the host and username and masks only the
/// password.
#[test]
fn test_bhv_authbasic_010_redacted_representation_shows_the_host_and_username() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    assert_eq!(
        "BasicAuthenticator { host: \"https://api.example.com\", username: \"alice\", password: \"***\" }",
        format!("{:?}", auth)
    );
}

/// Only the username may not contain a colon: a colon in the password is sent as-is.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authbasic_018_a_password_may_contain_a_colon() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "pa:ss:word").unwrap();
    let headers = auth.auth_headers().await;
    assert_eq!(
        headers.get("Authorization").map(|s| s.as_str()),
        Some("Basic YWxpY2U6cGE6c3M6d29yZA==")
    );
}

/// A generated basic wrapper emits exactly the header the base authenticator emits.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authbasic_019_generated_basic_wrappers_emit_the_same_basic_header_as_the_base() {
    let host = "https://api.example.com";
    let base = BasicAuthenticator::new(host, "alice", "s3cret").unwrap().auth_headers().await;
    let admin = AdminBasicAuthenticator::new(host, Some("alice"), Some("s3cret"))
        .unwrap()
        .auth_headers()
        .await;
    assert_eq!(admin.get("Authorization"), base.get("Authorization"));
}

/// The password is masked in the debug output, compact and pretty alike.
#[test]
fn test_bhv_authbasic_020_masks_the_password_in_its_debug_output() {
    let auth = BasicAuthenticator::new("https://api.example.com", "alice", "s3cret").unwrap();
    for text in [format!("{:?}", auth), format!("{:#?}", auth)] {
        assert!(!text.contains("s3cret"), "{}", text);
    }
}

/// The scheme wrappers emit the same header as the authenticator they wrap and
/// validate the credentials as eagerly.
#[tokio::test(flavor = "multi_thread")]
async fn test_bhv_authbasic_002_scheme_wrappers_emit_the_basic_header_and_validate_eagerly() {
    let host = "https://api.example.com";
    let admin = AdminBasicAuthenticator::new(host, Some("alice"), Some("s3cret")).unwrap();
    let store = PetStoreBasicAuthenticator::new(host, Some("alice"), Some("s3cret")).unwrap();
    for headers in [admin.auth_headers().await, store.auth_headers().await] {
        assert_eq!(
            headers.get("Authorization").map(|s| s.as_str()),
            Some("Basic YWxpY2U6czNjcmV0")
        );
    }
    assert!(matches!(
        AdminBasicAuthenticator::new(host, Some("ali:ce"), Some("s3cret")),
        Err(ConfigurationError::InvalidArgument(_))
    ));
    assert!(matches!(
        PetStoreBasicAuthenticator::new(host, Some("alice"), Some("s3c\0ret")),
        Err(ConfigurationError::InvalidArgument(_))
    ));
}
