use {{packageName}}::object_serializer;
use {{packageName}}::models::Category;

#[test]
fn test_serialize_map_to_json() {
    let mut input = serde_json::Map::new();
    input.insert("name".to_string(), serde_json::Value::String("Fido".to_string()));
    input.insert("age".to_string(), serde_json::json!(3));

    let data = object_serializer::serialize(&serde_json::Value::Object(input))
        .expect("unexpected serialization error");
    assert!(!data.is_empty(), "expected non-empty serialized data");

    let parsed: serde_json::Value =
        serde_json::from_str(&data).expect("failed to parse serialized JSON");
    assert_eq!(parsed["name"], "Fido");
}

#[test]
fn test_deserialize_json_to_map() {
    let input = br#"{"name":"Fido","age":3}"#;

    let result: serde_json::Value = object_serializer::deserialize(input)
        .expect("unexpected deserialization error")
        .expect("expected Some value");
    assert_eq!(result["name"], "Fido");
}

#[test]
fn test_deserialize_empty_data() {
    let result: Result<Option<serde_json::Value>, _> = object_serializer::deserialize(b"");
    assert!(result.is_ok(), "expected Ok for empty data");
    assert!(result.unwrap().is_none(), "expected None for empty data");
}

