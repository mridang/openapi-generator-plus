#[test]
fn test_serialize_includes_fields_set_to_default_values() {
    let category = Category {
        id: Some(0),
        name: Some("".to_string()),
    };
    let json = object_serializer::serialize(&category).expect("serialization failed");
    assert!(
        json.contains("\"id\":0"),
        "serialized JSON should include id=0, got: {}",
        json
    );
    assert!(
        json.contains("\"name\":\"\""),
        "serialized JSON should include empty name, got: {}",
        json
    );
}
