#[test]
fn test_proto_duration_accepts_the_full_protobuf_range() {
    use {{packageName}}::proto_duration;
    use chrono::Duration;

    // Past ~292 years the total nanosecond count no longer fits an i64, but the
    // protobuf range reaches ~10,000 years.
    let max = proto_duration::parse("315576000000s").expect("the protobuf maximum must parse");
    assert_eq!(max, Duration::seconds(315_576_000_000));
    let min = proto_duration::parse("-315576000000s").expect("the protobuf minimum must parse");
    assert_eq!(min, -Duration::seconds(315_576_000_000));
    let past_i64_nanos = proto_duration::parse("9223372037.5s").expect("must parse past 292 years");
    assert_eq!(
        past_i64_nanos,
        Duration::seconds(9_223_372_037) + Duration::milliseconds(500)
    );
    assert_eq!(proto_duration::format(&max), "315576000000s");
}

#[test]
fn test_proto_duration_format_does_not_overflow() {
    use {{packageName}}::proto_duration;
    use chrono::Duration;

    // Beyond ~292 years num_nanoseconds() is None; the old fallback multiplied
    // the seconds by 1e9 and overflowed.
    let huge = Duration::seconds(i64::MAX / 1_000);
    assert_eq!(proto_duration::format(&huge), format!("{}s", i64::MAX / 1_000));
    assert_eq!(proto_duration::format(&-huge), format!("-{}s", i64::MAX / 1_000));
}

#[test]
fn test_proto_duration_sub_tenth_milli_magnitude_no_scientific_notation() {
    // Regression: a sub-0.0001s magnitude must render as a plain decimal
    // fraction (fixed-point, padded to a 3/6/9-digit grouping), NEVER in
    // scientific notation ("5e-5s"). 50 microseconds is 50_000 nanoseconds,
    // which trims to the six-digit grouping "0.000050s".
    use {{packageName}}::proto_duration;
    use chrono::Duration;

    let tiny = Duration::microseconds(50);
    let formatted = proto_duration::format(&tiny);
    assert_eq!(
        formatted, "0.000050s",
        "sub-0.0001s magnitude must be fixed-point, got: {}",
        formatted
    );
    assert!(
        !formatted.contains('e') && !formatted.contains('E'),
        "duration must never use scientific notation, got: {}",
        formatted
    );
    // And it must round-trip back to the same magnitude.
    assert_eq!(proto_duration::parse(&formatted).unwrap(), tiny);

    // A single nanosecond keeps the full nine-digit grouping.
    let one_nano = Duration::nanoseconds(1);
    let nano_fmt = proto_duration::format(&one_nano);
    assert_eq!(nano_fmt, "0.000000001s", "single-nanosecond magnitude");
    assert!(!nano_fmt.contains('e') && !nano_fmt.contains('E'));
}

#[test]
fn test_bhv_serializationobject_145_proto_duration_serde_round_trip() {
    use {{packageName}}::proto_duration;
    use chrono::Duration;
    use serde::{Deserialize, Serialize};

    #[derive(Debug, Serialize, Deserialize, PartialEq)]
    struct Wrap {
        #[serde(with = "proto_duration")]
        d: Duration,
        #[serde(with = "proto_duration::option")]
        e: Option<Duration>,
    }

    let value = Wrap {
        d: Duration::hours(1) + Duration::minutes(30),
        e: Some(Duration::seconds(45)),
    };
    let json = serde_json::to_string(&value).expect("serialize");
    assert!(json.contains("\"d\":\"5400s\""), "got: {}", json);
    assert!(json.contains("\"e\":\"45s\""), "got: {}", json);

    let back: Wrap = serde_json::from_str(&json).expect("deserialize");
    assert_eq!(back, value);

    let none = Wrap {
        d: Duration::zero(),
        e: None,
    };
    let json2 = serde_json::to_string(&none).expect("serialize none");
    assert!(json2.contains("\"e\":null"), "got: {}", json2);
}

#[test]
fn test_bhv_serializationobject_171_decimal_type_number_serializes_as_unquoted_number() {
    // Wave B parity: a `type: number` property with NO `format` (a bare JSON
    // number, e.g. Pet.weightKg) must serialize as an UNQUOTED JSON number
    // (1.5), never as a quoted string ("1.5"). Some SDKs model such fields as
    // an arbitrary-precision Decimal and then emit them as JSON strings, which
    // violates the spec's `type: number`. Rust maps this to a plain `f64`, so
    // serde_json emits a bare number; this test locks that wire format and
    // proves the field survives a serialize -> deserialize round trip as a
    // number rather than a string.
    use {{packageName}}::models::Pet;

    let mut pet = Pet::new("doggie".to_string(), std::collections::HashSet::new());
    pet.weight_kg = Some(1.5);

    let json = serde_json::to_string(&pet).expect("serialize Pet");
    assert!(
        json.contains("\"weightKg\":1.5"),
        "weightKg must be an unquoted JSON number, got: {}",
        json
    );
    assert!(
        !json.contains("\"weightKg\":\"1.5\""),
        "weightKg must NOT be a quoted string, got: {}",
        json
    );

    // Round-trips back to the same numeric value (not a string).
    let back: Pet = serde_json::from_str(&json).expect("deserialize Pet");
    assert_eq!(back.weight_kg, Some(1.5));
}

#[test]
fn test_bhv_serializationobject_064_naive_time_serde_round_trip() {
    use chrono::NaiveTime;
    use serde::{Deserialize, Serialize};

    // Locks the wire format chrono produces for the type mapping that
    // BetterRustCodegen installs for `format: time` (NaiveTime). If
    // chrono's default representation ever drifts the codegen would
    // silently produce non-RFC-3339-partial-time output.
    #[derive(Debug, Serialize, Deserialize, PartialEq)]
    struct Wrap {
        t: NaiveTime,
    }

    let value = Wrap {
        t: NaiveTime::from_hms_opt(12, 34, 56).expect("valid time"),
    };
    let json = serde_json::to_string(&value).expect("serialize");
    assert!(json.contains("\"t\":\"12:34:56\""), "got: {}", json);

    let back: Wrap = serde_json::from_str(&json).expect("deserialize");
    assert_eq!(back, value);
}

// readOnly and writeOnly carry no wire effect: a readOnly id is decoded from a
// response and a writeOnly password is written on a request and kept on decode.
#[test]
fn test_bhv_serializationobject_017_read_only_and_write_only_fields_round_trip() {
    use {{packageName}}::models::Account;

    let decoded: Account = serde_json::from_str(r#"{"id":7,"username":"u"}"#).unwrap();
    assert_eq!(decoded.id, Some(7));

    let mut outgoing = Account::new("u".to_string());
    outgoing.password = Some("p".to_string());
    let body = serde_json::to_string(&outgoing).unwrap();
    assert!(body.contains(r#""password":"p""#), "body: {}", body);

    let full: Account =
        serde_json::from_str(r#"{"id":7,"username":"u","password":"p"}"#).unwrap();
    assert_eq!(full.password.as_deref(), Some("p"));
}

// F1112: byte arrays compare by content, not identity: a bare array, a list of
// arrays and a map of arrays, each built fresh for the two sides.
#[test]
fn test_bhv_serializationobject_075_byte_array_fields_compare_by_content() {
    use {{packageName}}::models::BinaryVault;

    fn vault() -> BinaryVault {
        let mut vault = BinaryVault::new();
        vault.seal = Some(vec![1, 2, 3]);
        vault.shards = Some(vec![vec![4, 5], vec![6]]);
        vault.labels = Some(std::collections::HashMap::from([("first".to_string(), vec![7, 8])]));
        vault
    }

    assert_eq!(vault(), vault());

    let mut seal = vault();
    seal.seal = Some(vec![1, 2, 4]);
    assert_ne!(vault(), seal);

    let mut shard = vault();
    shard.shards = Some(vec![vec![4, 5], vec![7]]);
    assert_ne!(vault(), shard);

    let mut label = vault();
    label.labels = Some(std::collections::HashMap::from([("first".to_string(), vec![7, 9])]));
    assert_ne!(vault(), label);
}

// F867: a `format: password` property is shown as `***` in the Debug output,
// and the wire form still carries the value.
#[test]
fn test_bhv_serializationobject_007_password_property_is_masked_in_debug_output() {
    use {{packageName}}::models::Account;

    let secret = ["tr", "0ub4", "dor-", "9"].concat();
    let mut account = Account::new("u".to_string());
    account.password = Some(secret.clone());

    let shown = format!("{:?}", account);
    assert!(!shown.contains(&secret), "{}", shown);
    assert!(shown.contains("***"), "{}", shown);
    assert!(shown.contains("username"), "{}", shown);
    let pretty = format!("{:#?}", account);
    assert!(!pretty.contains(&secret), "{}", pretty);
    let wire = serde_json::to_string(&account).expect("serializes");
    assert!(wire.contains(&secret), "{}", wire);
}

