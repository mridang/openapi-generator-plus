// The `object_serializer` module is crate-private (an internal (de)serialization
// detail, not part of the public API). Its unit tests have been moved into an
// in-crate `#[cfg(test)] mod tests` block inside `src/object_serializer.rs`,
// where they retain access to the private module. The `resolve_one_of` /
// `resolve_any_of` helpers were dead code (no generated caller — Rust models use
// `#[serde(untagged)]` enums) and were removed along with their tests.
//
// The tests below exercise only the *public* `proto_duration` module and the
// `chrono`/`serde_json` wire formats the codegen relies on, so they remain in
// this external integration-test crate.

// Gap 4.8: protobuf-JSON duration helper. These tests cover the
// hand-rolled `format`/`parse` round-trip and the serde shim used by
// generated models with `format: duration`. The wire shape is
// google.protobuf.Duration ("<seconds>s", e.g. "3600s"), not ISO-8601.
// Time-of-day (`format: time`) is covered by chrono's own `NaiveTime`
// serde impl and exercised here as a smoke test to lock the wire format
// the codegen relies on.
#[test]
fn test_bhv_serializationobject_105_proto_duration_format_basic() {
    use {{packageName}}::proto_duration;
    use chrono::TimeDelta as Duration;

    assert_eq!(proto_duration::format(&Duration::zero()), "0s");
    assert_eq!(proto_duration::format(&Duration::seconds(45)), "45s");
    assert_eq!(
        proto_duration::format(&(Duration::hours(1) + Duration::minutes(30))),
        "5400s"
    );
    assert_eq!(
        proto_duration::format(&Duration::milliseconds(1500)),
        "1.500s"
    );
    assert_eq!(
        proto_duration::format(&(Duration::seconds(3600) + Duration::nanoseconds(1))),
        "3600.000000001s"
    );
    assert_eq!(proto_duration::format(&-Duration::minutes(5)), "-300s");
}

#[test]
fn test_bhv_serializationobject_113_proto_duration_parse_basic() {
    use {{packageName}}::proto_duration;
    use chrono::TimeDelta as Duration;

    assert_eq!(proto_duration::parse("0s").unwrap(), Duration::zero());
    assert_eq!(
        proto_duration::parse("5400s").unwrap(),
        Duration::hours(1) + Duration::minutes(30)
    );
    assert_eq!(
        proto_duration::parse("1.5s").unwrap(),
        Duration::milliseconds(1500)
    );
    assert_eq!(
        proto_duration::parse("3600.000000001s").unwrap(),
        Duration::seconds(3600) + Duration::nanoseconds(1)
    );
    assert_eq!(
        proto_duration::parse("-300s").unwrap(),
        -Duration::minutes(5)
    );
}

#[test]
fn test_bhv_serializationobject_073_proto_duration_round_trip() {
    use {{packageName}}::proto_duration;
    use chrono::TimeDelta as Duration;

    for d in [
        Duration::zero(),
        Duration::seconds(1),
        Duration::milliseconds(1500),
        Duration::hours(1) + Duration::minutes(30) + Duration::seconds(15),
        Duration::days(2) + Duration::hours(3),
        Duration::seconds(3600) + Duration::nanoseconds(1),
        -(Duration::hours(1) + Duration::minutes(30)),
    ] {
        let s = proto_duration::format(&d);
        let parsed = proto_duration::parse(&s)
            .unwrap_or_else(|e| panic!("parse({:?}) failed: {}", s, e));
        assert_eq!(parsed, d, "round trip mismatch for {:?} -> {:?}", d, s);
    }
}

