use {{packageName}}::auth::oauth::OAuth2ImplicitAuthenticator;
use {{packageName}}::auth::Authenticator;

fn create_authenticator() -> OAuth2ImplicitAuthenticator {
    OAuth2ImplicitAuthenticator::new(
        "https://api.example.com",
        "my-client-id",
        "https://auth.example.com/authorize",
        vec!["read".to_string(), "write".to_string()],
    )
}

#[test]
fn test_builds_authorization_url_with_response_type_token() {
    let auth = create_authenticator();

    let url = auth.build_authorization_url("");

    assert!(url.starts_with("https://auth.example.com/authorize?"));
    assert!(url.contains("response_type=token"));
}

#[test]
fn test_builds_authorization_url_with_client_id() {
    let auth = create_authenticator();

    let url = auth.build_authorization_url("");

    assert!(url.contains("client_id=my-client-id"));
}

#[test]
fn test_builds_authorization_url_with_scopes() {
    let auth = create_authenticator();

    let url = auth.build_authorization_url("");

    assert!(url.contains("scope=read"));
    assert!(url.contains("write"));
}

#[test]
fn test_builds_authorization_url_with_state() {
    let auth = create_authenticator();

    let url = auth.build_authorization_url("my-state");

    assert!(url.contains("state=my-state"));
}

#[tokio::test]
async fn test_get_auth_headers_returns_bearer_after_set_access_token() {
    let auth = create_authenticator();
    auth.set_access_token("implicit-tok");

    let headers = auth.auth_headers().await;

    assert_eq!("Bearer implicit-tok", headers.get("Authorization").unwrap());
}

#[tokio::test]
#[should_panic(expected = "must set access token")]
async fn test_throws_when_access_token_not_set() {
    let auth = create_authenticator();
    auth.auth_headers().await;
}

#[test]
fn test_get_host_returns_configured_host() {
    let auth = create_authenticator();
    assert_eq!("https://api.example.com", auth.host());
}

#[test]
fn test_debug_redacts_access_token() {
    let auth = create_authenticator();
    auth.set_access_token("super-secret-token");

    let debug = format!("{:?}", auth);

    assert!(!debug.contains("super-secret-token"));
    assert!(debug.contains("***"));
}
