// immutability regression: ServerConfiguration / ServerVariable expose their
// state only through accessor methods. Because Server0/Server1/all_servers
// hand out shared values, private fields prevent a caller from mutating a
// server's url_template / variables and corrupting every other consumer.
#[test]
fn test_bhv_config_009_server_configuration_and_variable_accessor_only() {
    let mut variables = HashMap::new();
    variables.insert(
        "env".to_string(),
        ServerVariable::new(
            "api".to_string(),
            "the environment".to_string(),
            vec!["api".to_string(), "staging".to_string()],
        ),
    );
    let server = ServerConfiguration::new(
        "https://{env}.example.com".to_string(),
        "Test server".to_string(),
        variables,
    );

    assert_eq!(server.url_template(), "https://{env}.example.com");
    assert_eq!(server.description(), "Test server");
    let var = server.variables().get("env").expect("env variable present");
    assert_eq!(var.default_value(), "api");
    assert_eq!(var.description(), "the environment");
    assert_eq!(var.enum_values(), &["api".to_string(), "staging".to_string()]);
}

#[test]
fn test_bhv_config_015_configuration_debug_masks_credential_headers() {
    let config = ConfigurationBuilder::new()
        .default_header("Authorization", "Bearer s3cr3t")
        .default_header("Cookie", "sid=s3cr3t")
        .default_header("X-Api-Key", "s3cr3t")
        .default_header("X-Custom", "visible")
        .build();

    let shown = format!("{:?}", config);

    assert!(!shown.contains("s3cr3t"));
    assert!(shown.contains("***"));
    assert!(shown.contains("visible"));
}

/// The builder sets the base URL, a single default header and a bulk of default
/// headers on one configuration.
#[test]
fn test_bhv_config_010_configuration_builder_sets_all_fields() {
    let mut bulk = HashMap::new();
    bulk.insert("X-Trace".to_string(), "abc".to_string());

    let config = ConfigurationBuilder::new()
        .base_url("https://all.example.com")
        .default_header("Authorization", "Bearer token")
        .default_headers(bulk)
        .build();

    assert_eq!(config.base_url(), "https://all.example.com");
    let headers = config.default_headers();
    assert_eq!(headers.get("Authorization").map(|v| v.as_str()), Some("Bearer token"));
    assert_eq!(headers.get("X-Trace").map(|v| v.as_str()), Some("abc"));
}

/// A hook set on the builder is read back, and the debug form names no hook
/// internals.
#[test]
fn test_configuration_carries_the_call_hook_and_does_not_print_it() {
    use std::sync::Arc;

    struct SecretHook;
    impl CallHook for SecretHook {
        fn start(&self, _info: &CallInfo, _headers: &mut HashMap<String, String>) -> Option<Box<dyn CallObserver>> {
            None
        }
    }
    assert!(Configuration::default().call_hook().is_none());
    let hook: Arc<dyn CallHook> = Arc::new(SecretHook);

    let config = ConfigurationBuilder::new().call_hook(hook.clone()).build();

    assert!(Arc::ptr_eq(&hook, config.call_hook().expect("a hook is set")));
    let shown = format!("{:?}", config);
    assert!(shown.contains("<hook>"), "{shown}");
    assert!(!shown.contains("SecretHook"), "{shown}");
}

