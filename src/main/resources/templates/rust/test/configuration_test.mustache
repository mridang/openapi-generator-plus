#[test]
fn test_bhv_misc_279_changing_headers_returned_from_a_configuration_leaves_its_own_headers_unchanged() {
    let config = Configuration::builder().default_header("X-Keep", "yes").build();
    let mut copy = config.default_headers();
    copy.insert("X-New".to_string(), "no".to_string());
    assert!(!config.default_headers().contains_key("X-New"), "the configuration must not see the change");
    assert_eq!(Some(&"yes".to_string()), config.default_headers().get("X-Keep"));
}
