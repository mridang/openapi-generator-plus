fn test_bhv_models_006_file_header_prints_the_info_description_without_escaped_quotes() {
    let lib = std::fs::read_to_string(std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src/lib.rs"))
        .expect("failed to read src/lib.rs");
    let header: Vec<&str> = lib.lines().filter(|line| line.starts_with("//!")).collect();
