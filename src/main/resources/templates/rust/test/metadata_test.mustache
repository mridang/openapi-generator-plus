#[test]
fn test_bhv_models_022_a_model_whose_schema_allows_undeclared_properties_accepts_them() {
    use {{packageName}}::models::StrictTag;
    let open: Metadata = serde_json::from_str(r#"{"undeclared":"yes"}"#).expect("an open model accepts it");
    assert_eq!(open.additional_properties.get("undeclared").map(String::as_str), Some("yes"));
    assert!(
        serde_json::from_str::<StrictTag>(r#"{"undeclared":true}"#).is_err(),
        "a strict model reports the unknown key instead"
    );
}

