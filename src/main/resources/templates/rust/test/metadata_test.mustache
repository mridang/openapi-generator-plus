#[test]
fn test_metadata_additional_properties_round_trip_preserves_free_form_json() {
    /* FIX 3 (no serde_json in public fields): `additional_properties` is a
     * HashMap<String, JsonValue> where JsonValue is the SDK-owned wrapper.
     * Free-form JSON in unknown fields must round-trip losslessly. */
    let json_data =
        r#"{"createdAt":"2024-01-15T10:30:00+00:00","customField":"customValue","count":42,"nested":{"a":[1,2,3]}}"#;

    let metadata: Metadata =
        serde_json::from_str(json_data).expect("failed to deserialize Metadata");

    // The free-form values landed in additional_properties via the public
    // JsonValue wrapper (no serde_json::Value in the field signature).
    let custom = metadata
        .additional_properties
        .get("customField")
        .expect("expected customField in additional_properties");
    assert_eq!(custom.as_str(), Some("customValue"));
    let count = metadata
        .additional_properties
        .get("count")
        .expect("expected count in additional_properties");
    assert_eq!(count.as_i64(), Some(42));
    let nested = metadata
        .additional_properties
        .get("nested")
        .expect("expected nested in additional_properties");
    assert!(nested.is_object(), "expected nested to be a JSON object");

    // Re-serialize and confirm the free-form JSON fields are preserved
    // verbatim. (The typed `createdAt` field is excluded because chrono
    // normalises the datetime representation, which is unrelated to the
    // free-form JsonValue round-trip under test.)
    let reserialized: serde_json::Value =
        serde_json::from_str(&serde_json::to_string(&metadata).expect("failed to serialize"))
            .expect("re-parsed JSON");
    let original: serde_json::Value =
        serde_json::from_str(json_data).expect("parsed original JSON");
    for key in ["customField", "count", "nested"] {
        assert_eq!(
            reserialized.get(key),
            original.get(key),
            "free-form field {} must round-trip unchanged",
            key
        );
    }
}

#[test]
fn test_pet_location_free_form_json_round_trips() {
    /* FIX 3: Pet.location is Option<Vec<JsonValue>> (free-form JSON array). The
     * inner free-form JSON must round-trip losslessly through the public
     * JsonValue wrapper, with no serde_json::Value in the field signature. */
    let json_data = r#"{
        "name": "doggie",
        "photoUrls": ["http://example.com/1.png"],
        "location": [{"lat": 12.5, "lng": -7.25}, "freeform-string", 99]
    }"#;

    let pet: Pet = serde_json::from_str(json_data).expect("failed to deserialize Pet");
    let location = pet.location.as_ref().expect("expected location to be present");
    assert_eq!(location.len(), 3, "expected three free-form location entries");
    assert!(location[0].is_object(), "first entry must be a JSON object");
    assert_eq!(location[1].as_str(), Some("freeform-string"));
    assert_eq!(location[2].as_i64(), Some(99));

    // Re-serialize and confirm the location array is preserved verbatim.
    let reserialized: serde_json::Value =
        serde_json::from_str(&serde_json::to_string(&pet).expect("failed to serialize"))
            .expect("re-parsed JSON");
    let original: serde_json::Value =
        serde_json::from_str(json_data).expect("parsed original JSON");
    assert_eq!(
        reserialized.get("location"),
        original.get("location"),
        "free-form location JSON must round-trip unchanged"
    );
}

// -- date-time serializes in a consistent UTC-offset form and round-trips
// (behavior 8) --
//
// `Metadata.createdAt` is a `chrono::DateTime<Utc>`. The wire form must be a
// single, consistent RFC-3339 representation carrying an explicit UTC offset
// (`+00:00`/`Z`), and parsing that representation back must yield the same
// instant. A `Z`-suffixed input and a `+00:00` input denote the same instant,
// so they must serialize identically after a round-trip.
#[test]
fn test_metadata_date_time_round_trips_with_consistent_utc_offset() {
    use chrono::{DateTime, Utc};

    let json_data = r#"{"createdAt":"2024-01-15T10:30:00Z"}"#;
    let metadata: Metadata =
        serde_json::from_str(json_data).expect("failed to deserialize Metadata");

    let created = metadata
        .created_at
        .expect("expected createdAt to be present");
    let expected: DateTime<Utc> = "2024-01-15T10:30:00Z"
        .parse()
        .expect("reference instant must parse");
    assert_eq!(created, expected, "deserialized instant mismatch");

    // Serialize and confirm a single, explicit UTC-offset wire form.
    let data = serde_json::to_string(&metadata).expect("failed to serialize Metadata");
    let parsed: serde_json::Value =
        serde_json::from_str(&data).expect("failed to parse serialized Metadata");
    let wire = parsed["createdAt"]
        .as_str()
        .expect("createdAt must serialize as a JSON string");
    assert!(
        wire.ends_with('Z') || wire.ends_with("+00:00"),
        "date-time must carry an explicit UTC offset, got: {}",
        wire
    );

    // The wire form must itself parse back to the same instant: a stable,
    // self-consistent representation.
    let reparsed: DateTime<Utc> = wire.parse().expect("serialized wire form must re-parse");
    assert_eq!(reparsed, expected, "round-tripped instant must be unchanged");

    // A `+00:00`-suffixed input denotes the same instant and must serialize
    // identically, proving the offset form is normalized, not echoed verbatim.
    let alt: Metadata = serde_json::from_str(r#"{"createdAt":"2024-01-15T10:30:00+00:00"}"#)
        .expect("failed to deserialize alternate-offset Metadata");
    let alt_data = serde_json::to_string(&alt).expect("failed to serialize alternate Metadata");
    assert_eq!(
        alt_data, data,
        "equivalent UTC instants must serialize to the same wire form"
    );
}

// manifest-description-missing: the published Cargo.toml must carry a
// non-empty `description` (wired from the spec's appDescription) so the crate
// does not publish with an empty description on crates.io.
#[test]
fn test_cargo_manifest_declares_non_empty_description() {
    let manifest_path =
        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("Cargo.toml");
    let contents =
        std::fs::read_to_string(&manifest_path).expect("failed to read Cargo.toml");

    let description = contents
        .lines()
        .find_map(|line| {
            let trimmed = line.trim_start();
            let rest = trimmed.strip_prefix("description")?;
            let rest = rest.trim_start().strip_prefix('=')?.trim();
            let unquoted = rest.strip_prefix('"').and_then(|s| s.strip_suffix('"'));
            unquoted.map(str::to_string)
        })
        .expect("Cargo.toml must declare a description");

    assert!(
        !description.trim().is_empty(),
        "description must not be empty"
    );
}
