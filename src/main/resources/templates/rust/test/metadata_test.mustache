// -- date-time serialization preserves sub-second precision --
//
// `Metadata.createdAt` is the SDK's `date_time::DateTime`. An instant carrying
// millisecond sub-second precision (2020-01-02T03:04:05.123Z) must serialize
// WITH the `.123` fraction intact: the encoder must NOT truncate to whole
// seconds while the decoder happily accepts fractions (a lossy, asymmetric
// round-trip). Milliseconds (3 digits) are the cross-SDK common denominator
// every language's native date-time type supports, so the exact canonical
// string is asserted.
#[test]
fn test_bhv_serializationobject_199_subseconds_are_preserved_in_a_serialized_date_time() {
    use {{packageName}}::date_time::DateTime;

    // The canonical instant with millisecond precision.
    let instant: DateTime = "2020-01-02T03:04:05.123Z"
        .parse()
        .expect("reference instant must parse");

    let mut metadata = Metadata::new();
    metadata.created_at = Some(instant);

    // (1) The serialized date-time STRING must contain the `.123` fraction:
    // the milliseconds were NOT truncated to whole seconds.
    let data = serde_json::to_string(&metadata).expect("failed to serialize Metadata");
    let parsed: serde_json::Value =
        serde_json::from_str(&data).expect("failed to parse serialized Metadata");
    let wire = parsed["createdAt"]
        .as_str()
        .expect("createdAt must serialize as a JSON string");
    assert_eq!(
        wire, "2020-01-02T03:04:05.123+00:00",
        "date-time encoder must preserve millisecond precision in the canonical wire form"
    );

    // (2) Deserializing that JSON back must yield a date-time equal to the
    // original instant — a lossless round-trip down to the millisecond.
    let restored: Metadata =
        serde_json::from_str(&data).expect("failed to deserialize Metadata");
    let restored_created = restored
        .created_at
        .expect("expected createdAt to be present after round-trip");
    assert_eq!(
        restored_created, instant,
        "round-tripped instant must equal the original millisecond-precision value"
    );
}

// manifest-description-missing: the published Cargo.toml must carry a
// non-empty `description` (wired from the spec's appDescription) so the crate
// does not publish with an empty description on crates.io.
#[test]
fn test_bhv_models_002_cargo_manifest_declares_non_empty_description() {
    let manifest_path =
        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("Cargo.toml");
    let contents =
        std::fs::read_to_string(&manifest_path).expect("failed to read Cargo.toml");

    let description = contents
        .lines()
        .find_map(|line| {
            let trimmed = line.trim_start();
            let rest = trimmed.strip_prefix("description")?;
            let rest = rest.trim_start().strip_prefix('=')?.trim();
            let unquoted = rest.strip_prefix('"').and_then(|s| s.strip_suffix('"'));
            unquoted.map(str::to_string)
        })
        .expect("Cargo.toml must declare a description");

    assert!(
        !description.trim().is_empty(),
        "description must not be empty"
    );
}

// L1 example-null-doc-pollution: a property whose schema declares no `example`
// must NOT emit a `/// Example: `null`` doc line. OpenAPI Generator core seeds
// CodegenProperty.example with the bare string "null" when the spec omits an
// example, and that string is truthy in Mustache, so an unguarded model
// template would stamp a false null-example claim onto nearly every field. The
// Rust generator nulls that literal out before rendering, so no generated model
// source should carry the bogus doc text. Scan every model file to guard the
// whole crate, not just one struct.
#[test]
fn test_bhv_models_007_generated_models_have_no_null_example_doc() {
    let models_dir =
        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src/models");
    let entries =
        std::fs::read_dir(&models_dir).expect("failed to read src/models directory");

    let mut scanned = 0usize;
    for entry in entries {
        let path = entry.expect("failed to read directory entry").path();
        if path.extension().and_then(|e| e.to_str()) != Some("rs") {
            continue;
        }
        let contents =
            std::fs::read_to_string(&path).expect("failed to read model source file");
        scanned += 1;
        assert!(
            !contents.contains("Example: `null`"),
            "generated model {:?} must not contain a `Example: `null`` doc line",
            path
        );
    }

    assert!(
        scanned > 0,
        "expected at least one generated model source file to scan"
    );
}

/// Generated library source uses block comments and `///`/`//!` doc comments
/// only, never a `//` line comment, matching the other SDKs and the comment
/// style SKILLS.md documents.
#[test]
fn test_bhv_langrust_039_generated_source_has_no_line_comments() {
    fn walk(dir: &std::path::Path, files: &mut Vec<std::path::PathBuf>) {
        for entry in std::fs::read_dir(dir).expect("failed to read source directory") {
            let path = entry.expect("failed to read directory entry").path();
            if path.is_dir() {
                walk(&path, files);
            } else if path.extension().and_then(|e| e.to_str()) == Some("rs") {
                files.push(path);
            }
        }
    }
    let mut files = Vec::new();
    walk(&std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src"), &mut files);
    assert!(!files.is_empty(), "expected generated source files to scan");

    let mut violations = Vec::new();
    for path in &files {
        let contents = std::fs::read_to_string(path).expect("failed to read source file");
        for (index, line) in contents.lines().enumerate() {
            let trimmed = line.trim_start();
            if trimmed.starts_with("//") && !trimmed.starts_with("///") && !trimmed.starts_with("//!") {
                violations.push(format!("{}:{}", path.display(), index + 1));
            }
        }
    }
    assert!(violations.is_empty(), "line comments found: {:?}", violations);
}

