/// An empty bearer token fails closed with `ConfigurationError::InvalidArgument`
/// at construction, never a panic, so no bare `Authorization: Bearer ` header
/// is emitted (bearer-no-empty-token-guard).
#[test]
fn test_bhv_authbearer_005_empty_token_is_rejected_at_construction() {
    match BearerAuthenticator::new("https://api.example.com", "") {
        Err(ConfigurationError::InvalidArgument(reason)) => {
            assert!(reason.contains("Bearer token must not be empty"), "{}", reason)
        }
        other => panic!(
            "expected ConfigurationError::InvalidArgument for an empty token, got {:?}",
            other
        ),
    }
}

/// A bearer token containing CR/LF is rejected at construction, before any
/// header is built from it.
#[test]
fn test_bhv_authbearer_028_a_bearer_token_containing_crlf_is_rejected_at_construction() {
    match BearerAuthenticator::new("https://api.example.com", "tok\r\nInjected: yes") {
        Err(ConfigurationError::InvalidArgument(_)) => {}
        other => panic!("expected ConfigurationError::InvalidArgument, got {:?}", other),
    }
}

/// Bearer tokens with CR/LF would CRLF-inject the Authorization header and
/// non-ASCII bytes are mangled, so both fail closed with
/// `ConfigurationError::InvalidArgument` (RFC 7230 section 3.2.6).
#[test]
fn test_bhv_authbearer_012_rejects_crlf_and_non_ascii_tokens() {
    for token in ["tok\r\nInjected: yes", "ñoño"] {
        match BearerAuthenticator::new("https://api.example.com", token) {
            Err(ConfigurationError::InvalidArgument(reason)) => {
                assert!(reason.contains("printable ASCII"), "{}", reason)
            }
            other => panic!(
                "expected ConfigurationError::InvalidArgument for {:?}, got {:?}",
                token, other
            ),
        }
    }
}

/// A whitespace-only token is rejected at construction, the same way as an
/// empty one, so it never produces a bare `Authorization: Bearer ` header.
#[test]
fn test_bhv_authbearer_017_whitespace_only_token_is_rejected_at_construction() {
    match BearerAuthenticator::new("https://api.example.com", "   ") {
        Err(ConfigurationError::InvalidArgument(reason)) => {
            assert!(reason.contains("Bearer token must not be empty"), "{}", reason)
        }
        other => panic!(
            "expected ConfigurationError::InvalidArgument for a whitespace token, got {:?}",
            other
        ),
    }
}

/// A token made only of Unicode spaces is not "empty" (the empty rule covers
/// ASCII whitespace); the printable-ASCII rule rejects it instead.
#[test]
fn test_bhv_authbearer_016_unicode_space_only_token_is_rejected_by_the_printable_ascii_rule() {
    for token in ["\u{00A0}", "\u{2003}", " \u{00A0} "] {
        match BearerAuthenticator::new("https://api.example.com", token) {
            Err(ConfigurationError::InvalidArgument(reason)) => {
                assert!(reason.contains("printable ASCII"), "{}", reason);
                assert!(!reason.contains("must not be empty"), "{}", reason);
            }
            other => panic!(
                "expected ConfigurationError::InvalidArgument for {:?}, got {:?}",
                token, other
            ),
        }
    }
}

