use {{packageName}}::value_serializer;
use {{packageName}}::value_serializer::SerializedValue;

fn unwrap_single(val: Option<SerializedValue>) -> String {
    match val {
        Some(SerializedValue::Single(s)) => s,
        Some(SerializedValue::Multi(v)) => v.join(","),
        None => panic!("expected Some, got None"),
    }
}

fn unwrap_multi(val: Option<SerializedValue>) -> Vec<String> {
    match val {
        Some(SerializedValue::Multi(v)) => v,
        Some(SerializedValue::Single(s)) => vec![s],
        None => panic!("expected Some, got None"),
    }
}

