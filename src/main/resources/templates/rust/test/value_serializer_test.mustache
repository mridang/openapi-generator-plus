// -- serialize_styled: matrix --

#[test]
fn test_serialize_styled_matrix_scalar() {
    let result = value_serializer::serialize_styled("id", Some("5"), None, "path", "string", "", "matrix", false);
    assert_eq!(result.unwrap(), ";id=5");
}

#[test]
fn test_serialize_styled_matrix_array_no_explode() {
    let items = vec!["red".to_string(), "green".to_string(), "blue".to_string()];
    let result = value_serializer::serialize_styled(
        "color",
        None,
        Some(&items),
        "path",
        "array",
        "",
        "matrix",
        false,
    );
    assert_eq!(result.unwrap(), ";color=red,green,blue");
}

#[test]
fn test_serialize_styled_matrix_array_explode() {
    let items = vec!["red".to_string(), "green".to_string(), "blue".to_string()];
    let result = value_serializer::serialize_styled(
        "color",
        None,
        Some(&items),
        "path",
        "array",
        "",
        "matrix",
        true,
    );
    assert_eq!(result.unwrap(), ";color=red;color=green;color=blue");
}

