// -- serialize_deep_object --

#[test]
fn test_serialize_deep_object() {
    let mut obj = std::collections::HashMap::new();
    obj.insert("status".to_string(), "active".to_string());
    obj.insert("type".to_string(), "dog".to_string());

    let result = value_serializer::serialize_deep_object("filter", &obj);
    let result_map: std::collections::HashMap<String, String> = result.into_iter().collect();

    assert_eq!(result_map.get("filter[status]").unwrap(), "active");
    assert_eq!(result_map.get("filter[type]").unwrap(), "dog");
}

#[test]
fn test_serialize_deep_object_empty() {
    let obj = std::collections::HashMap::new();
    let result = value_serializer::serialize_deep_object("filter", &obj);
    assert!(result.is_empty());
}

