use {{packageName}}::value_serializer;

// -- serialize_value by location --

#[test]
fn test_serialize_value_query_string() {
    let result = value_serializer::serialize_value(Some("hello"), "query", "string", "");
    assert_eq!(result.unwrap(), "hello");
}

#[test]
fn test_serialize_value_path_string() {
    let result = value_serializer::serialize_value(Some("hello world"), "path", "string", "");
    assert_eq!(result.unwrap(), "hello%20world");
}

#[test]
fn test_serialize_value_header_string() {
    let result = value_serializer::serialize_value(Some("hello"), "header", "string", "");
    assert_eq!(result.unwrap(), "hello");
}

#[test]
fn test_serialize_value_cookie_string() {
    let result = value_serializer::serialize_value(Some("hello"), "cookie", "string", "");
    assert_eq!(result.unwrap(), "hello");
}

#[test]
fn test_serialize_value_query_array_csv() {
    let items = vec!["a".to_string(), "b".to_string(), "c".to_string()];
    let result = value_serializer::serialize_array_value(&items, "query", "csv");
    assert_eq!(result.unwrap(), "a,b,c");
}

#[test]
fn test_serialize_value_header_array() {
    let items = vec!["a".to_string(), "b".to_string(), "c".to_string()];
    let result = value_serializer::serialize_array_value(&items, "header", "");
