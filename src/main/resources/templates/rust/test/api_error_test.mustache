// immutability regression: ApiError's state is only reachable through the
// constructor + accessors. The fields are private, so a caller can neither
// forge an ApiError by struct literal nor mutate `status_code` after the fact.
// This test pins the read-only accessor surface; the privacy itself is
// enforced at compile time by the generated `struct` having no `pub` fields.
#[test]
fn test_api_error_fields_are_accessor_only() {
    let mut headers = HashMap::new();
    headers.insert("x-trace".to_string(), "abc".to_string());
    let err = ApiError::new(
        500,
        "boom".to_string(),
        Some("body".to_string()),
        Some(headers),
    );

    /* Every piece of state is reachable only via an accessor method. */
    assert_eq!(err.status_code(), 500);
    assert_eq!(err.message(), "boom");
    assert_eq!(err.response_body(), Some("body"));
    assert_eq!(
        err.response_headers().and_then(|h| h.get("x-trace")).map(String::as_str),
        Some("abc"),
    );
}

// -- Branded error hierarchy: {{errorPrefix}}Error ---------------------------------
//
// Rust expresses the "every SDK-thrown error is a {{errorPrefix}}Error" relationship
// (a base class in the OO SDKs) as a marker trait. These tests pin that every
// error type the client can produce is reachable as `&dyn {{errorPrefix}}Error`, that
// the supertrait gives `std::error::Error` (Display + source chaining), and
// that the brand is honoured.

/// Coerces any reference to a `&dyn {{errorPrefix}}Error`. The call only compiles when
/// `T: {{errorPrefix}}Error`, so each call site below is a compile-time proof that the
/// concrete error type implements the branded root trait.
fn assert_is_{{errorPrefixSnake}}_error<T: {{errorPrefix}}Error>(err: &T) -> &dyn {{errorPrefix}}Error {
    err
}

/// Builds the per-status wrapper chain ApiError -> ClientError -> <status>.
fn client_chain(status: u16, message: &str) -> ClientError {
    ClientError::from(ApiError::new(status, message.to_string(), None, None))
}

/// Builds the per-status wrapper chain ApiError -> ServerError -> <status>.
fn server_chain(status: u16, message: &str) -> ServerError {
    ServerError::from(ApiError::new(status, message.to_string(), None, None))
}

#[test]
fn test_api_error_is_{{errorPrefixSnake}}_error() {
    let err = ApiError::new(404, "not found".to_string(), None, None);
    let branded = assert_is_{{errorPrefixSnake}}_error(&err);
    // Supertrait gives Display and source() for free.
    assert!(!branded.to_string().is_empty());
    // No transport cause was supplied, so the chain terminates here.
    assert!(std::error::Error::source(branded).is_none());
}

