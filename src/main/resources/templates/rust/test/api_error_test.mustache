/// Whether `err`, or any error in its `source()` chain, is a `T`: each error's
/// `source()` is its parent in the hierarchy, so this is the "is a" check.
fn is_a<T: std::error::Error + 'static>(err: &(dyn std::error::Error + 'static)) -> bool {
    std::iter::successors(Some(err), |&e| e.source()).any(|e| e.is::<T>())
}

/// Checks that an error is of the one type a status maps to.
type IsExpectedType = fn(&(dyn std::error::Error + 'static)) -> bool;

#[test]
fn test_bhv_errors_006_from_response_maps_every_status_to_its_type() {
    let mut headers = HashMap::new();
    headers.insert("x-request-id".to_string(), "abc".to_string());
    let cases: [(u16, IsExpectedType); 12] = [
        (400, |e| e.is::<BadRequestError>()),
        (401, |e| e.is::<UnauthorizedError>()),
        (403, |e| e.is::<ForbiddenError>()),
        (404, |e| e.is::<NotFoundError>()),
        (409, |e| e.is::<ConflictError>()),
        (422, |e| e.is::<UnprocessableEntityError>()),
        (429, |e| e.is::<TooManyRequestsError>()),
        (418, |e| e.is::<ClientError>()),
        (500, |e| e.is::<InternalServerError>()),
        (503, |e| e.is::<ServerError>()),
        (302, |e| e.is::<ApiError>()),
        /* A status outside 400-599 is neither a ClientError nor a
         * ServerError: the 5xx arm stops at 599, so 600 is a plain ApiError. */
        (600, |e| e.is::<ApiError>()),
    ];
    for (status, is_expected_type) in cases {
        let err = ApiError::from_response(status, &headers, r#"{"k":"v"}"#, None, None);
        assert!(is_expected_type(&*err), "status {status}: unexpected type {err:?}");
        assert!(is_a::<ApiError>(&*err), "status {status}: must chain to ApiError");
        assert_eq!(is_a::<ClientError>(&*err), (400..500).contains(&status));
        assert_eq!(is_a::<ServerError>(&*err), (500..600).contains(&status));

        let api_error = std::iter::successors(Some(&*err as &(dyn std::error::Error + 'static)), |e| e.source())
            .find_map(|e| e.downcast_ref::<ApiError>())
            .expect("every HTTP error chains to an ApiError");
        assert_eq!(api_error.status_code(), status);
        assert_eq!(api_error.response_body(), Some(r#"{"k":"v"}"#));
        assert_eq!(
            api_error.response_headers().and_then(|h| h.get("x-request-id")).map(String::as_str),
            Some("abc")
        );
    }
}

/* F830: the error names the request it belongs to, without the query string, in
 * the message and on the accessors of the root and of every status wrapper. */
#[test]
fn test_bhv_errors_007_from_response_carries_the_request_method_and_path_without_the_query() {
    let headers = HashMap::new();
    for status in [400u16, 401, 403, 404, 409, 418, 422, 429, 500, 503, 302] {
        let err = ApiError::from_response(
            status,
            &headers,
            "",
            Some("GET"),
            Some("/items/7?token=secret#fragment"),
        );
        let api_error = std::iter::successors(Some(&*err as &(dyn std::error::Error + 'static)), |e| e.source())
            .find_map(|e| e.downcast_ref::<ApiError>())
            .expect("every HTTP error chains to an ApiError");
        assert_eq!(api_error.request_method(), Some("GET"), "status {status}");
        assert_eq!(api_error.request_path(), Some("/items/7"), "status {status}");
        let text = err.to_string();
        assert!(
            text.starts_with(&format!("API returned status code {status} for GET /items/7\nHTTP status code: {status}")),
            "status {status}: {text}"
        );
        assert!(!text.contains("secret"), "the query string must not reach the text: {text}");
    }
}

