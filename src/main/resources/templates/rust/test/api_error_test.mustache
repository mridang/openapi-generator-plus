/* F1080: the rendered text carries a bounded, single-line body and no
 * credential-bearing header value; the full body and headers stay on the
 * error's accessors. */
#[test]
fn test_bhv_errors_001_api_error_display_caps_the_body_and_escapes_control_characters() {
    let body = format!("{}\r\nforged: line", "a".repeat(1024));
    let err = ApiError::new(500, "boom".to_string(), None, Some(body.clone()));
    let text = err.to_string();
    let expected_body = format!("{}... ({} more bytes)", "a".repeat(1024), body.len() - 1024);
    assert_eq!(
        format!("boom\nHTTP status code: 500\nResponse body: {}", expected_body),
        text
    );
    assert_eq!(Some(body.as_str()), err.response_body(), "the full body stays on the error");

    let hostile = ApiError::new(500, "boom".to_string(), None, Some("x\ny\u{7}z".to_string()));
    assert_eq!("boom\nHTTP status code: 500\nResponse body: x\\ny\\u0007z", hostile.to_string());
}

