    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::NotFoundError>();
    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::ConflictError>();
    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::UnprocessableEntityError>();
    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::ServerError>();
    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::InternalServerError>();
    assert_type_is_{{errorPrefixSnake}}_error::<{{packageName}}::NetworkError>();
