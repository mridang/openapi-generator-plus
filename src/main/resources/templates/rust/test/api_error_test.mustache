/// A named error is only ever the error for its own status: wrapping a
/// `ClientError` or `ServerError` that carries another status is refused and the
/// wrapped error is handed back unchanged.
#[test]
fn test_bhv_errors_053_named_errors_accept_only_their_own_status() {
    fn refuses<T: std::fmt::Debug>(
        name: &str,
        wrong_status: u16,
        attempt: Result<T, ClientError>,
    ) {
        let handed_back = attempt.expect_err(&format!("{name} must refuse status {wrong_status}"));
        assert_eq!(wrong_status, handed_back.api_error().status_code());
    }

    refuses("BadRequestError", 404, BadRequestError::try_from(client_chain(404, "x")));
    refuses("UnauthorizedError", 400, UnauthorizedError::try_from(client_chain(400, "x")));
    refuses("ForbiddenError", 404, ForbiddenError::try_from(client_chain(404, "x")));
    refuses("NotFoundError", 403, NotFoundError::try_from(client_chain(403, "x")));
    refuses("ConflictError", 418, ConflictError::try_from(client_chain(418, "x")));
    refuses("TooManyRequestsError", 409, TooManyRequestsError::try_from(client_chain(409, "x")));
    refuses("UnprocessableEntityError", 409, UnprocessableEntityError::try_from(client_chain(409, "x")));

    let handed_back = InternalServerError::try_from(server_chain(503, "x"))
        .expect_err("InternalServerError must refuse status 503");
    assert_eq!(503, handed_back.api_error().status_code());
}

