/// Every per-status wrapper renders the wrapped ApiError's text (message, status
/// code, headers and body), the same string `ApiError` and `ApiErrorKind` print,
/// so logging any of them keeps the response body.
#[test]
fn test_status_wrappers_display_the_wrapped_api_error() {
    let mut headers = HashMap::new();
    headers.insert("x-trace".to_string(), "abc".to_string());
    for status in [400u16, 401, 403, 404, 409, 418, 422, 500, 503] {
        let boxed = ApiError::from_response(status, &headers, "detail-body", None, None);
        let expected = ApiError::new(
            status,
            format!("API returned status code {}", status),
            Some(headers.clone()),
            Some("detail-body".to_string()),
        );
        assert_eq!(expected.to_string(), boxed.to_string(), "status {}", status);
        let kind = {{packageName}}::ApiErrorKind::from(expected.clone());
        assert_eq!(expected.to_string(), kind.to_string(), "kind for status {}", status);
        assert!(boxed.to_string().contains("Response body: detail-body"), "status {}", status);
    }
}

