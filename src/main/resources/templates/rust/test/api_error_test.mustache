/// A status-specific error reports the request method and path it answers, through its wrapper chain.
#[test]
fn test_bhv_errors_002_every_status_error_carries_the_request_context() {
    let api = ApiError::new(404, "missing".to_string(), None, None).with_request("GET", "/items/7?token=x");
    let not_found = NotFoundError::try_from(ClientError::try_from(api).expect("a 4xx"))
        .expect("a 404");
    assert_eq!(not_found.client_error().api_error().request_method(), Some("GET"));
    assert_eq!(not_found.client_error().api_error().request_path(), Some("/items/7"));

    let api = ApiError::new(500, "boom".to_string(), None, None).with_request("POST", "/orders?id=1");
    let internal = InternalServerError::try_from(ServerError::try_from(api).expect("a 5xx"))
        .expect("a 500");
    assert_eq!(internal.server_error().api_error().request_method(), Some("POST"));
    assert_eq!(internal.server_error().api_error().request_path(), Some("/orders"));
}

/// A status-specific error keeps the optional cause it was built with, and reaches it through its source chain.
#[test]
fn test_bhv_errors_003_status_specific_errors_keep_an_optional_cause() {
    let cause: std::sync::Arc<dyn std::error::Error + Send + Sync> =
        std::sync::Arc::new(std::io::Error::other("socket reset"));
    let with_cause = ApiError::with_source(404, "missing".to_string(), None, None, cause);
    let not_found = NotFoundError::try_from(ClientError::try_from(with_cause).expect("a 4xx"))
        .expect("a 404");
    let chain_has_cause = std::iter::successors(
        Some(&not_found as &(dyn std::error::Error + 'static)),
        |e| e.source(),
    )
    .any(|e| e.downcast_ref::<std::io::Error>().is_some());
    assert!(chain_has_cause, "the cause must be reachable from the status error");

    let plain = ApiError::new(404, "missing".to_string(), None, None);
    let plain_error = NotFoundError::try_from(ClientError::try_from(plain).expect("a 4xx"))
        .expect("a 404");
    let plain_has_cause = std::iter::successors(
        Some(&plain_error as &(dyn std::error::Error + 'static)),
        |e| e.source(),
    )
    .any(|e| e.downcast_ref::<std::io::Error>().is_some());
    assert!(!plain_has_cause, "a status error built without a cause has none");
}

/// FromResponse puts the method and the path into the message, and into the error's fields.
#[test]
fn test_bhv_errors_011_from_response_names_the_request_in_the_message_and_the_fields() {
    let err = ApiError::from_response(409, &HashMap::new(), "", Some("DELETE"), Some("/pets/9?force=1"));

    let text = err.to_string();
    assert!(
        text.starts_with("API returned status code 409 for DELETE /pets/9\nHTTP status code: 409"),
        "{text}"
    );
    let api_error = std::iter::successors(Some(&*err as &(dyn std::error::Error + 'static)), |e| e.source())
        .find_map(|e| e.downcast_ref::<ApiError>())
        .expect("an ApiError in the chain");
    assert_eq!(api_error.request_method(), Some("DELETE"));
    assert_eq!(api_error.request_path(), Some("/pets/9"));
}

fn nested_array(depth: usize) -> String {
    format!("{}{}", "[".repeat(depth), "]".repeat(depth))
}

#[test]
fn test_api_error_body_nested_beyond_serde_default_limit_still_parses() {
    // serde_json stops at ~128 levels; the shared cap is 1000, as on the
    // success path.
    let err = ApiError::new(400, "bad".to_string(), None, Some(nested_array(500)));

    assert!(err.error_body().is_some(), "a 500-deep error body must still parse");
    let typed: Option<serde_json::Value> = err
        .typed_error_body()
        .expect("a 500-deep error body must deserialize");
    assert!(typed.is_some());
}

#[test]
fn test_bhv_errors_009_api_error_body_nested_beyond_shared_cap_is_rejected() {
    let err = ApiError::new(400, "bad".to_string(), None, Some(nested_array(1001)));

    assert!(err.error_body().is_none(), "a 1001-deep error body must not parse");
    let failure = err
        .typed_error_body::<serde_json::Value>()
        .expect_err("a 1001-deep error body must be rejected");
    assert_eq!(failure.message(), "JSON nesting depth 1001 exceeds limit 1000");
}

/* D15 (F933): a malformed error body is a SerializationError whose message
 * names the parse failure and which keeps the parser error as its source. */
#[test]
fn test_bhv_errors_017_api_error_malformed_body_is_a_serialization_error_with_the_parse_message() {
    let err = ApiError::new(400, "bad".to_string(), None, Some(r#"{"id":"#.to_string()));

    assert!(err.error_body().is_none(), "a malformed body must not parse");
    let failure = err
        .typed_error_body::<serde_json::Value>()
        .expect_err("a malformed body must be rejected");
    assert!(
        failure.message().starts_with("failed to deserialize JSON: "),
        "unexpected message {:?}",
        failure.message()
    );
    assert!(std::error::Error::source(&failure).is_some(), "the parser error is the source");
}

