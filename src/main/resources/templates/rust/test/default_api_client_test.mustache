// Gap AK: userinfo embedded in the proxy URL must be base64-encoded
// and surfaced as Proxy-Authorization so the proxy can authenticate
// the tunnel — otherwise the proxy 407s. reqwest's `Proxy::all` reads
// userinfo natively from the URL; we assert TransportOptions preserves
// the userinfo end-to-end.
#[tokio::test]
async fn test_default_api_client_proxy_with_credentials_injects_basic_authorization() {
    use base64::{engine::general_purpose::STANDARD, Engine as _};
    use reqwest::Url;

    let transport = TransportOptionsBuilder::new()
        .proxy("http://alice:s3cret@127.0.0.1:3128")
        .build();

    let proxy = transport.proxy().expect("proxy must be set");
    let parsed = Url::parse(proxy).expect("proxy url must parse");
    assert_eq!(parsed.username(), "alice");
    assert_eq!(parsed.password(), Some("s3cret"));
    let raw = format!("{}:{}", parsed.username(), parsed.password().unwrap_or(""));
    let encoded = STANDARD.encode(raw.as_bytes());
    assert_eq!(format!("Basic {}", encoded), "Basic YWxpY2U6czNjcmV0");
}

