/// Reads the interface block (the trait) and the group class of one API source file.
fn read_group(file: &str, trait_name: &str) -> (Vec<String>, Vec<String>) {
    let source = std::fs::read_to_string(file).expect("the API source is readable from the crate root");
    let start = source.find(&format!("pub trait {} {{", trait_name)).expect("the group trait is declared");
    let end = start + source[start..].find("\n}\n").expect("the group trait is closed");
    let listed = source[start..end]
        .lines()
        .filter_map(|line| line.trim().strip_prefix("fn "))
        .filter_map(|rest| rest.split('(').next())
        .map(str::to_string)
        .collect();
    let declared = source
        .lines()
        .filter_map(|line| line.trim().strip_prefix("pub async fn "))
        .filter_map(|rest| rest.split('(').next())
        .map(str::to_string)
        .collect();
    (listed, declared)
}

