/* F824: closing the facade closes the transport it built, and a request made
 * afterwards is rejected with the closed-client error. */
#[test]
fn test_client_close_marks_the_client_closed() {
    let client = {{clientClassName}}::with_token(Some("{{{basePath}}}"), Some("test-token"), None).expect("valid token");
    assert!(!client.is_closed());
    client.close();
    assert!(client.is_closed());
}

/* F824 / S9: closing the facade never shuts down a caller-supplied transport. */
#[test]
fn test_bhv_lifecycle_007_client_close_leaves_a_supplied_http_client_usable() {
    let supplied = reqwest::Client::new();
    let authenticator = BearerAuthenticator::new("{{{basePath}}}", "test-token").unwrap();
    let client = {{clientClassName}}::with_http_client(Box::new(authenticator), supplied.clone(), None)
        .expect("no conflict");
    client.close();
    assert!(client.is_closed());
    assert!(supplied.get("http://127.0.0.1:1/").build().is_ok());
}

/* F862: credentials come from the argument first, then the environment (read
 * once, an empty value counts as unset), and a missing one fails construction.
 * The tests share the process environment, so they run one at a time. */
static ENV_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());

const BASE_URL_VAR: &str = "{{envPrefix}}_BASE_URL";
const ACCESS_TOKEN_VAR: &str = "{{envPrefix}}_ACCESS_TOKEN";

fn with_environment<R>(base_url: Option<&str>, access_token: Option<&str>, body: impl FnOnce() -> R) -> R {
    let _guard = ENV_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
    let saved = [
        (BASE_URL_VAR, std::env::var(BASE_URL_VAR).ok()),
        (ACCESS_TOKEN_VAR, std::env::var(ACCESS_TOKEN_VAR).ok()),
    ];
    for (name, value) in [(BASE_URL_VAR, base_url), (ACCESS_TOKEN_VAR, access_token)] {
        match value {
            Some(value) => std::env::set_var(name, value),
            None => std::env::remove_var(name),
        }
    }
    let result = body();
    for (name, value) in saved {
        match value {
            Some(value) => std::env::set_var(name, value),
            None => std::env::remove_var(name),
        }
    }
    result
}

fn invalid_argument_text<T>(result: Result<T, ConfigurationError>) -> String {
    match result {
        Err(ConfigurationError::InvalidArgument(text)) => text,
        Err(other) => panic!("expected InvalidArgument, got {:?}", other),
        Ok(_) => panic!("expected InvalidArgument, got a client"),
    }
}

