#[test]
fn test_get_next_weight_27_steps() {
    let hs = HeaderSelector::new();

    let mut weight = 1000;
    for _ in 0..27 {
        weight = hs.get_next_weight(weight, false);
    }
    assert_eq!(weight, 1);
}
