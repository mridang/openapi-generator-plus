use {{packageName}}::auth::Authenticator;
use {{packageName}}::auth::BearerAuthenticator;
use {{packageName}}::ConfigurationError;

/* F862: every per-scheme authenticator reads its credentials from the
 * environment when an argument is not passed. The tests share the process
 * environment, so they run one at a time. */
static ENV_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());

fn with_variables<R>(variables: &[(&str, Option<&str>)], body: impl FnOnce() -> R) -> R {
    let _guard = ENV_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
    let saved: Vec<(String, Option<String>)> = variables
        .iter()
        .map(|(name, _)| (name.to_string(), std::env::var(name).ok()))
        .collect();
    for (name, value) in variables {
        match value {
            Some(value) => std::env::set_var(name, value),
            None => std::env::remove_var(name),
        }
    }
    let result = body();
    for (name, value) in saved {
        match value {
            Some(value) => std::env::set_var(name, value),
            None => std::env::remove_var(name),
        }
    }
    result
}

fn invalid_argument_text<T>(result: Result<T, ConfigurationError>) -> String {
    match result {
        Err(ConfigurationError::InvalidArgument(text)) => text,
        Err(other) => panic!("expected InvalidArgument, got {:?}", other),
        Ok(_) => panic!("expected InvalidArgument, got an authenticator"),
    }
}
#[test]
fn test_bhv_auth_007_a_generic_authenticator_built_without_credentials_reads_no_environment() {
    with_variables(&[("AUTH_UNREAD_TOKEN", Some("value-that-must-not-be-read"))], || {
        assert!(BearerAuthenticator::new("https://api.example.com", "").is_err());
    });
}
