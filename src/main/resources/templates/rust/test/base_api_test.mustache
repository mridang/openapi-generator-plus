struct QueryCapturingApiClient {
    captured_url: Mutex<String>,
}

impl QueryCapturingApiClient {
    fn new() -> Self {
        QueryCapturingApiClient {
            captured_url: Mutex::new(String::new()),
        }
    }
}

impl {{packageName}}::api_client::ApiClient for QueryCapturingApiClient {
    fn send_request(
        &self,
        _method: &str,
        url: &str,
        _headers: &HashMap<String, String>,
        _body: Option<&{{packageName}}::api_client::RequestBody>,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<{{packageName}}::api_http_response::ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        *self.captured_url.lock().unwrap() = url.to_string();
        Box::pin(async {
            Ok({{packageName}}::api_http_response::ApiHttpResponse::new(200, "{}".to_string(), {
                    let mut h = HashMap::new();
                    h.insert("Content-Type".to_string(), "application/json".to_string());
                    h
                }))
        })
    }
}

