/* F823: a failed call is sent again up to `max_retries` times, as a fresh
 * request with its authentication headers applied again. */
enum Scripted {
    Status(u16, Option<&'static str>),
    Network,
    Timeout,
}

struct ScriptedApiClient {
    script: Mutex<Vec<Scripted>>,
    retries: u32,
    budget: Option<std::time::Duration>,
    authorizations: Mutex<Vec<Option<String>>>,
    deadlines: Mutex<Vec<Option<std::time::Instant>>>,
}

impl ScriptedApiClient {
    fn new(script: Vec<Scripted>, retries: u32, budget: Option<std::time::Duration>) -> Arc<Self> {
        Arc::new(ScriptedApiClient {
            script: Mutex::new(script),
            retries,
            budget,
            authorizations: Mutex::new(Vec::new()),
            deadlines: Mutex::new(Vec::new()),
        })
    }

    fn calls(&self) -> usize {
        self.authorizations.lock().unwrap().len()
    }
}

impl {{packageName}}::api_client::ApiClient for ScriptedApiClient {
    fn send_request(
        &self,
        method: &str,
        url: &str,
        headers: &HashMap<String, String>,
        body: Option<&{{packageName}}::api_client::RequestBody>,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<{{packageName}}::api_http_response::ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        self.send_request_with_options(method, url, headers, body, &{{packageName}}::api_client::RequestOptions::default())
    }

    fn send_request_with_options(
        &self,
        _method: &str,
        _url: &str,
        headers: &HashMap<String, String>,
        _body: Option<&{{packageName}}::api_client::RequestBody>,
        options: &{{packageName}}::api_client::RequestOptions,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<{{packageName}}::api_http_response::ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        self.authorizations.lock().unwrap().push(headers.get("Authorization").cloned());
        self.deadlines.lock().unwrap().push(options.deadline);
        let step = self.script.lock().unwrap().remove(0);
        Box::pin(async move {
            match step {
                Scripted::Status(status, retry_after) => {
                    let mut h = HashMap::new();
                    h.insert("Content-Type".to_string(), "application/json".to_string());
                    if let Some(value) = retry_after {
                        h.insert("retry-after".to_string(), value.to_string());
                    }
                    Ok({{packageName}}::api_http_response::ApiHttpResponse::new(status, "{}".to_string(), h))
                }
                Scripted::Network => {
                    let failed = ApiError::new(0, "connection refused".to_string(), None, None);
                    Err(Box::new(NetworkError::try_from(failed).expect("status 0")) as Box<dyn std::error::Error + Send + Sync>)
                }
                Scripted::Timeout => {
                    let failed = ApiError::new(0, "timed out".to_string(), None, None);
                    let network = NetworkError::try_from(failed).expect("status 0");
                    Err(Box::new(NetworkTimeoutError::from(network)) as Box<dyn std::error::Error + Send + Sync>)
                }
            }
        })
    }

    fn max_retries(&self) -> u32 {
        self.retries
    }

    fn request_timeout(&self) -> Option<std::time::Duration> {
        self.budget
    }
}

/// Hands out a different bearer token on every call.
struct CountingAuthenticator {
    asked: std::sync::atomic::AtomicUsize,
}

impl {{packageName}}::auth::Authenticator for CountingAuthenticator {
    fn host(&self) -> &str {
        "http://localhost"
    }

    fn auth_headers<'a>(
        &'a self,
    ) -> std::pin::Pin<
        Box<dyn std::future::Future<Output = HashMap<String, String>> + Send + 'a>,
    > {
        Box::pin(async move {
            let n = self.asked.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
            let mut headers = HashMap::new();
            headers.insert("Authorization".to_string(), format!("Bearer n{}", n));
            headers
        })
    }
}

fn retrying_api(client: &Arc<ScriptedApiClient>) -> PetApi {
    let config = ConfigurationBuilder::new().base_url("http://localhost").build();
    PetApi::new(client.clone(), config, None)
}

fn retrying_api_with(
    client: &Arc<ScriptedApiClient>,
    authenticator: Arc<dyn {{packageName}}::auth::Authenticator>,
) -> PetApi {
    let config = ConfigurationBuilder::new().base_url("http://localhost").build();
    PetApi::new(client.clone(), config, Some(authenticator))
}

