    let original: Vec<u8> = vec![0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d];
    let encoded = base64::engine::general_purpose::STANDARD.encode(&original);

