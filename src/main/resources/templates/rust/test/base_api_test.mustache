/* F855, F856: a token-flow authenticator is told to drop its token when the
 * API answers 401, the request is replayed once with the new credentials, and
 * a per-call authenticator is handed the transport before it is used. */
struct RenewableAuthenticator {
    generation: std::sync::atomic::AtomicUsize,
    injected: std::sync::atomic::AtomicUsize,
}

impl RenewableAuthenticator {
    fn new() -> Self {
        RenewableAuthenticator {
            generation: std::sync::atomic::AtomicUsize::new(0),
            injected: std::sync::atomic::AtomicUsize::new(0),
        }
    }
}

impl {{packageName}}::auth::Authenticator for RenewableAuthenticator {
    fn host(&self) -> &str {
        "http://localhost"
    }

    fn auth_headers<'a>(
        &'a self,
    ) -> std::pin::Pin<
        Box<dyn std::future::Future<Output = HashMap<String, String>> + Send + 'a>,
    > {
        Box::pin(async move {
            let mut headers = HashMap::new();
            headers.insert(
                "Authorization".to_string(),
                format!("Bearer gen{}", self.generation.load(std::sync::atomic::Ordering::SeqCst)),
            );
            headers
        })
    }

    fn inject_api_client(&self, _client: Arc<dyn {{packageName}}::api_client::ApiClient>) {
        self.injected.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
    }

    fn invalidate_access_token<'a>(
        &'a self,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send + 'a>> {
        Box::pin(async move {
            self.generation.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
            true
        })
    }
}

/// Answers the statuses in order and records the Authorization header of each request.
struct StatusSequenceApiClient {
    statuses: Mutex<Vec<u16>>,
    authorizations: Mutex<Vec<Option<String>>>,
}

impl {{packageName}}::api_client::ApiClient for StatusSequenceApiClient {
    fn send_request(
        &self,
        _method: &str,
        _url: &str,
        headers: &HashMap<String, String>,
        _body: Option<&{{packageName}}::api_client::RequestBody>,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<{{packageName}}::api_http_response::ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        self.authorizations.lock().unwrap().push(headers.get("Authorization").cloned());
        let status = self.statuses.lock().unwrap().remove(0);
        Box::pin(async move {
            Ok({{packageName}}::api_http_response::ApiHttpResponse::new(status, "{}".to_string(), {
                let mut h = HashMap::new();
                h.insert("Content-Type".to_string(), "application/json".to_string());
                h
            }))
        })
    }
}

