use std::collections::HashMap;
use std::future::Future;
use std::pin::Pin;
use std::sync::{Arc, Mutex};

use {{packageName}}::api_client::{ApiClient, RequestBody};
use {{packageName}}::api_http_response::ApiHttpResponse;
use {{packageName}}::auth::oauth::OpenIdConnectAuthenticator;
use {{packageName}}::auth::Authenticator;
use {{packageName}}::auth::HttpAwareAuthenticator;
use {{packageName}}::{
    ApiError, ConfigurationError, InternalServerError, NetworkError, NetworkTimeoutError,
    NotFoundError, SerializationError,
};

type BoxError = Box<dyn std::error::Error + Send + Sync>;

struct FakeApiClient {
    responses: Mutex<Vec<Result<ApiHttpResponse, BoxError>>>,
    last_url: Mutex<Option<String>>,
    last_body: Mutex<Option<String>>,
    last_method: Mutex<Option<String>>,
    get_count: Mutex<u32>,
}

impl FakeApiClient {
    fn new() -> Self {
        Self {
            responses: Mutex::new(Vec::new()),
            last_url: Mutex::new(None),
            last_body: Mutex::new(None),
            last_method: Mutex::new(None),
            get_count: Mutex::new(0),
        }
    }

    fn get_count(&self) -> u32 {
        *self.get_count.lock().unwrap()
    }

    fn enqueue(&self, body: &str, status_code: u16) {
        let mut responses = self.responses.lock().unwrap();
        responses.push(Ok(ApiHttpResponse::new(status_code, body.to_string(), HashMap::new())));
    }

    fn enqueue_error(&self, error: BoxError) {
        self.responses.lock().unwrap().push(Err(error));
    }

    fn last_url(&self) -> Option<String> {
        self.last_url.lock().unwrap().clone()
    }

    fn last_body(&self) -> Option<String> {
        self.last_body.lock().unwrap().clone()
    }

    fn last_method(&self) -> Option<String> {
        self.last_method.lock().unwrap().clone()
    }
}

impl ApiClient for FakeApiClient {
    fn send_request(
        &self,
        method: &str,
        url: &str,
        _headers: &HashMap<String, String>,
        body: Option<&RequestBody>,
    ) -> Pin<Box<dyn Future<Output = Result<ApiHttpResponse, Box<dyn std::error::Error + Send + Sync>>> + Send + '_>> {
        {
            let mut last_method = self.last_method.lock().unwrap();
            *last_method = Some(method.to_string());
        }
        if method == "GET" {
            let mut get_count = self.get_count.lock().unwrap();
            *get_count += 1;
        }
        {
            let mut last_url = self.last_url.lock().unwrap();
            *last_url = Some(url.to_string());
        }
        if let Some(RequestBody::Bytes(b)) = body {
            let mut last_body = self.last_body.lock().unwrap();
            *last_body = Some(String::from_utf8_lossy(b).to_string());
        }
        let response = {
            let mut responses = self.responses.lock().unwrap();
            responses.remove(0)
        };
        Box::pin(async move { response })
    }
}

fn create_authenticator() -> OpenIdConnectAuthenticator {
    OpenIdConnectAuthenticator::new(
        "https://api.example.com",
        "https://auth.example.com/.well-known/openid-configuration",
        "my-client-id",
        "my-client-secret",
        "https://app.example.com/callback",
        vec!["openid".to_string(), "profile".to_string()],
    )
}

#[tokio::test(flavor = "multi_thread")]
async fn test_builds_authorization_url_from_discovery() {
    let client = Arc::new(FakeApiClient::new());
    // Discovery document response
    client.enqueue(
        r#"{"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}"#,
        200,
    );

    let mut auth = create_authenticator();
    auth.set_api_client(client.clone());

    let url = auth
        .build_authorization_url("my-state")
        .await
        .expect("should succeed");

    assert!(url.starts_with("https://auth.example.com/authorize?"));
    assert!(url.contains("response_type=code"));
    assert!(url.contains("client_id=my-client-id"));
    assert!(url.contains("state=my-state"));
}

