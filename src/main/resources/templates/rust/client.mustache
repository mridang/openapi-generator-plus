{{/apiInfo}}
        }
    }

    /// Creates a client authenticated with a static Bearer token.
    pub fn with_token(host: &str, access_token: &str, transport_options: Option<TransportOptions>) -> Self {
        Self::new(
            Box::new(BearerAuthenticator::new(host, access_token)),
            transport_options,
        )
    }
