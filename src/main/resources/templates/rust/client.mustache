impl {{clientClassName}} {
    /// Creates a new client with the given authenticator and optional transport options.
    pub fn new(
        mut authenticator: Box<dyn Authenticator>,
        transport_options: Option<TransportOptions>,
    ) -> Self {
        let transport = transport_options.unwrap_or_else(|| TransportOptionsBuilder::new().build());
        let api_client: Arc<dyn ApiClient> = Arc::new(DefaultApiClient::new(Some(transport)));

        if let Some(http_aware) = authenticator.as_http_aware_mut() {
            http_aware.set_api_client(api_client.clone());
        }

        let config = ConfigurationBuilder::new()
            .base_url(authenticator.host())
            .build();

        let authenticator: Arc<dyn Authenticator> = Arc::from(authenticator);

        Self {
{{#apiInfo}}
{{#apis}}
{{#operations}}
            {{clientPropertyName}}: {{classname}}::new(api_client.clone(), config.clone(), Some(authenticator.clone())),
{{/operations}}
{{/apis}}
{{/apiInfo}}
        }
    }

    /// Creates a client authenticated with a static Bearer token.
    pub fn with_token(host: &str, access_token: &str, transport_options: Option<TransportOptions>) -> Self {
        Self::new(
            Box::new(BearerAuthenticator::new(host, access_token)),
            transport_options,
        )
    }

    /// Creates a client from any pre-built [`Authenticator`].
    ///
    /// This is the generic entry point for bespoke authentication strategies
    /// (client credentials, JWT private key, personal access tokens, etc.) that
    /// are not covered by the convenience constructors.
    pub fn with_authenticator(authenticator: Box<dyn Authenticator>, transport_options: Option<TransportOptions>) -> Self {
        Self::new(authenticator, transport_options)
    }
}
