{{#operations}}
    /// API operations for the {{classname}} group.
    pub {{clientPropertyName}}: {{classname}},
{{/operations}}
{{/apis}}
{{/apiInfo}}
    /* The transport the facade was built around. Closing the facade closes
     * the SDK-built HTTP stack; a caller-supplied reqwest::Client is never
     * shut down (the wrapper only stops sending through it). */
    api_client: Arc<dyn ApiClient>,
}

impl {{clientClassName}} {
    /// Creates a new client with the given authenticator and transport options.
    ///
    /// When `transport_options` is `None`, default transport settings are used.
    /// If the authenticator is HTTP-aware, the shared [`ApiClient`] is injected
    /// so that token exchange and discovery requests use the same proxy, TLS,
    /// and timeout settings.
    pub fn new(
        authenticator: Box<dyn Authenticator>,
        transport_options: Option<TransportOptions>,
    ) -> Self {
        let transport = transport_options.unwrap_or_default();
        let api_client: Arc<dyn ApiClient> = Arc::new(DefaultApiClient::new(Some(transport)));
        Self::from_api_client(authenticator, api_client)
    }

    /// Wires the API groups to an already-built [`ApiClient`].
    fn from_api_client(
        mut authenticator: Box<dyn Authenticator>,
        api_client: Arc<dyn ApiClient>,
    ) -> Self {
        if let Some(http_aware) = authenticator.as_http_aware_mut() {
            http_aware.set_api_client(api_client.clone());
        }

        let config = ConfigurationBuilder::new()
            .base_url(authenticator.host())
            .build();

        let authenticator: Arc<dyn Authenticator> = Arc::from(authenticator);

        Self {
            api_client: api_client.clone(),
{{#apiInfo}}
{{#apis}}
{{#operations}}
            {{clientPropertyName}}: {{classname}}::new(api_client.clone(), config.clone(), Some(authenticator.clone())),
{{/operations}}
{{/apis}}
{{/apiInfo}}
        }
    }

    /// Creates a client that sends every request through a caller-supplied
    /// [`reqwest::Client`].
    ///
    /// The SDK defaults (timeout, `User-Agent`, redirect handling, default
    /// headers) are applied on top of the supplied client. The caller owns the
    /// client's lifecycle: the SDK never shuts it down. Build the client with
    /// `reqwest::redirect::Policy::none()` so the SDK's own redirect handling
    /// stays in charge.
    ///
    /// # Errors
    ///
    /// Returns [`ConfigurationError::InvalidArgument`] when `transport_options`
    /// sets a proxy, a CA certificate or `verify_ssl(false)`, which conflict
    /// with a client the SDK did not build.
    pub fn with_http_client(
        authenticator: Box<dyn Authenticator>,
        http_client: reqwest::Client,
        transport_options: Option<TransportOptions>,
    ) -> Result<Self, ConfigurationError> {
        let api_client: Arc<dyn ApiClient> =
            Arc::new(DefaultApiClient::with_client(http_client, transport_options)?);
        Ok(Self::from_api_client(authenticator, api_client))
    }

    /// Releases the HTTP stack this client owns. Any request made afterwards
    /// fails with `ConfigurationError::InvalidState("ApiClient is closed")`.
    /// A caller-supplied `reqwest::Client` (see [`Self::with_http_client`]) is
    /// never closed: its owner keeps using it. Dropping the client also
    /// releases the pool once the last handle goes away.
    pub fn close(&self) {
        self.api_client.close();
    }

    /// Returns true once [`Self::close`] has been called.
    pub fn is_closed(&self) -> bool {
        self.api_client.is_closed()
    }

    /// Creates a client authenticated with a static Bearer token.
    ///
    /// `host` is the API base URL, `access_token` the Bearer token, and
    /// `transport_options` optional HTTP transport configuration (proxy, TLS,
    /// timeouts, etc.).
    ///
    /// # Errors
    ///
    /// Returns [`ConfigurationError::InvalidArgument`] when the token is empty
    /// or holds a character that cannot be sent in a header.
    pub fn with_token(
        host: &str,
        access_token: &str,
        transport_options: Option<TransportOptions>,
    ) -> Result<Self, ConfigurationError> {
        Ok(Self::new(
            Box::new(BearerAuthenticator::new(host, access_token)?),
            transport_options,
        ))
    }

    /// Creates a client from any [`Authenticator`] implementation.
    ///
    /// This is the generic entry point for bespoke authentication strategies such as
    /// OAuth2 client credentials, JWT private-key (service account), or a personal access
    /// token (PAT). Supply any [`Authenticator`] implementation; if it is also HTTP-aware,
    /// the shared [`ApiClient`] is injected so its HTTP calls reuse the same transport
    /// configuration.
    pub fn with_authenticator(authenticator: Box<dyn Authenticator>, transport_options: Option<TransportOptions>) -> Self {
        Self::new(authenticator, transport_options)
    }
}
