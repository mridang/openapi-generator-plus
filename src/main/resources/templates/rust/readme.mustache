{{#binaryStreamOperation}}
{{#bodyParam}}
{{#isModel}}
use {{packageName}}::models::{{{dataType}}};
{{/isModel}}
{{/bodyParam}}
{{/binaryStreamOperation}}

async fn download(
    client: &{{clientClassName}},
{{#binaryStreamOperation}}
{{#vendorExtensions.op.signatureArgs}}
{{#isPath}}
    {{paramName}}: {{{dataType}}},
{{/isPath}}
{{#isBody}}
    {{paramName}}: {{#nullable}}Option<{{/nullable}}{{{dataType}}}{{#nullable}}>{{/nullable}},
{{/isBody}}
{{/vendorExtensions.op.signatureArgs}}
{{/binaryStreamOperation}}
) -> Result<u64, Box<dyn std::error::Error + Send + Sync>> {
    let mut stream = client.{{#binaryStreamOperation}}{{#binaryStreamGroup}}{{clientPropertyName}}{{/binaryStreamGroup}}.{{operationId}}({{#vendorExtensions.op.signatureArgs}}{{^isServer}}{{^isOptions}}{{paramName}}, {{/isOptions}}{{/isServer}}{{/vendorExtensions.op.signatureArgs}}{{#vendorExtensions.op.signatureArgs}}{{#isServer}}None, {{/isServer}}{{/vendorExtensions.op.signatureArgs}}{{#vendorExtensions.op.signatureArgs}}{{#isOptions}}None{{/isOptions}}{{/vendorExtensions.op.signatureArgs}}{{#consumes.1}}, None{{/consumes.1}}).await?{{/binaryStreamOperation}};
