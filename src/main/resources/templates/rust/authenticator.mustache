use std::collections::HashMap;

use crate::auth::http_aware_authenticator::HttpAwareAuthenticator;

/// Authenticator provides authentication credentials to the API client.
/// Implementations supply the API host URL and authorization headers.
pub trait Authenticator: Send + Sync {
    /// Returns the base URL of the API.
    fn host(&self) -> &str;

    /// Returns the authentication headers to include in every request.
    fn auth_headers(&self) -> HashMap<String, String>;

    /// Returns query parameters to include for authentication.
    fn query_params(&self) -> HashMap<String, String> {
        HashMap::new()
    }

    /// Returns cookie parameters to include for authentication.
    fn cookie_params(&self) -> HashMap<String, String> {
        HashMap::new()
    }

    /// Returns a mutable reference to this authenticator as an
    /// HttpAwareAuthenticator, if it implements that trait.
    ///
    /// The default implementation returns `None`. OAuth2 and OpenID Connect
    /// authenticators override this to return `Some(self)` so the client
    /// can inject the shared ApiClient.
    fn as_http_aware_mut(&mut self) -> Option<&mut dyn HttpAwareAuthenticator> {
        None
    }
}
