{{>api_info}}
package {{packageName}}

import (
	"context"
	"errors"
	"fmt"
	"os"

	"{{packageName}}/pkg/auth"
)

// ErrMissingCredential is returned when a credential is neither passed to the
// constructor nor set in the environment. Match it with errors.Is.
var ErrMissingCredential = errors.New("missing credential")

/* resolveCredential applies the order every credential follows: the value the
 * caller passed wins, then the environment variable, read once, here; an empty
 * value is the same as none. */
func resolveCredential(passed, envName, what string) (string, error) {
	if passed != "" {
		return passed, nil
	}
	if fromEnv := os.Getenv(envName); fromEnv != "" {
		return fromEnv, nil
	}
	return "", fmt.Errorf("%w: no %s was passed and %s is not set", ErrMissingCredential, what, envName)
}

// {{clientClassName}} is the unified entry point for all API services.
//
// Takes an Authenticator and optionally TransportOptions, then exposes
// each API group as a typed field. If the authenticator implements
// auth.HttpAwareAuthenticator, the shared ApiClient is injected so that
// authentication HTTP calls (token exchange, discovery) use the same
// transport configuration as regular API calls.
//
// Usage:
//
//	// Default transport
//	client := {{packageName}}.New{{clientClassName}}(authenticator, nil)
//
//	// Custom transport (proxy, timeouts, etc.)
//
//	timeout := 5000
//	transport, err := {{packageName}}.NewTransportOptionsBuilder().
//		Proxy("http://proxy:3128").
//		Timeout(&timeout).
//		Build()
//	if err != nil {
//		return err
//	}
//	client := {{packageName}}.New{{clientClassName}}(authenticator, transport)
//
//	// Bring your own HTTP client (the SDK keeps its defaults on top and never
//	// closes it); every operation takes a context.Context first.
//
//	transport, err = {{packageName}}.NewTransportOptionsBuilder().
//		HttpClient(myHTTPClient).
//		Build()
type {{clientClassName}} struct {
{{#apiInfo}}
{{#apis}}
{{#operations}}
	/* {{baseName}} holds the API operations for the {{classname}} group. */
	{{baseName}} *{{classname}}
{{/operations}}
{{/apis}}
{{/apiInfo}}

	apiClient ApiClient
}

// Close releases the client's transport and cancels its base context, which
// aborts every request still in flight (they fail with an error satisfying
// errors.Is(err, context.Canceled)). A transport the caller supplied through
// TransportOptionsBuilder.HttpClient or RoundTripper is never closed: the
// caller owns its lifecycle.
func (c *{{clientClassName}}) Close() error {
	return c.apiClient.Close()
}

// New{{clientClassName}} creates a new client with the given authenticator and transport options.
//
// The authenticator provides the host URL and auth headers. The transport
// options carry the HTTP transport configuration (proxy, TLS, timeouts, etc.);
// nil selects the default transport settings.
//
// If the authenticator implements auth.HttpAwareAuthenticator, the shared ApiClient
// is injected so that token exchange and discovery requests use the same proxy,
// TLS, and timeout settings.
func New{{clientClassName}}(authenticator Authenticator, transportOptions *TransportOptions) *{{clientClassName}} {
	if transportOptions == nil {
		transportOptions = defaultTransportOptions()
	}
	apiClient := NewDefaultApiClient(transportOptions)

	if httpAware, ok := authenticator.(auth.HttpAwareAuthenticator); ok {
		httpAware.SetApiClient(&authApiClientAdapter{inner: apiClient})
	}

	config := NewConfigurationBuilder().
		BaseURL(authenticator.Host()).
		Build()

	return &{{clientClassName}}{
		apiClient: apiClient,
{{#apiInfo}}
{{#apis}}
{{#operations}}
		{{baseName}}: New{{classname}}(apiClient, config, authenticator),
{{/operations}}
{{/apis}}
{{/apiInfo}}
	}
}

// New{{clientClassName}}WithToken creates a client authenticated with a static Bearer token.
//
// The host is the API base URL and the accessToken is the Bearer token. Each is
// resolved once, here: the value you pass wins, then the environment variable
// {{envPrefix}}_BASE_URL for the host and {{envPrefix}}_ACCESS_TOKEN for the token; an
// empty value counts as unset. The optional transport options carry the HTTP
// transport configuration (proxy, TLS, timeouts, etc.).
//
// Returns ErrMissingCredential when the host or the token cannot be resolved
// (a missing token also satisfies auth.ErrInvalidBearerToken), and
// auth.ErrInvalidBearerToken when the token contains a character that cannot
// be sent in a header.
func New{{clientClassName}}WithToken(host, accessToken string, transportOptions *TransportOptions) (*{{clientClassName}}, error) {
	resolvedHost, err := resolveCredential(host, "{{envPrefix}}_BASE_URL", "host")
	if err != nil {
		return nil, err
	}
	resolvedToken, err := resolveCredential(accessToken, "{{envPrefix}}_ACCESS_TOKEN", "access token")
	if err != nil {
		return nil, fmt.Errorf("%w: %w", err, auth.ErrInvalidBearerToken)
	}
	authenticator, err := auth.NewBearerAuthenticator(resolvedHost, resolvedToken)
	if err != nil {
		return nil, err
	}
	return New{{clientClassName}}(authenticator, transportOptions), nil
}

// New{{clientClassName}}WithTokenProvider creates a client authenticated with a
// Bearer token that provider returns for every request, so a token that rotates
// is always current. The provider receives the context of the API call; an
// error from it fails that call before any request is sent.
//
// The host is resolved like in New{{clientClassName}}WithToken. Returns
// ErrMissingCredential when it cannot be resolved, and
// auth.ErrInvalidBearerToken when the provider is nil.
func New{{clientClassName}}WithTokenProvider(host string, provider auth.TokenProvider, transportOptions *TransportOptions) (*{{clientClassName}}, error) {
	resolvedHost, err := resolveCredential(host, "{{envPrefix}}_BASE_URL", "host")
	if err != nil {
		return nil, err
	}
	authenticator, err := auth.NewBearerAuthenticatorWithProvider(resolvedHost, provider)
	if err != nil {
		return nil, err
	}
	return New{{clientClassName}}(authenticator, transportOptions), nil
}

// New{{clientClassName}}WithAuthenticator creates a client from any Authenticator implementation.
//
// This is the generic entry point for bespoke authentication strategies such as
// OAuth2 client credentials, JWT private-key (service account), or a personal
// access token (PAT). Supply any Authenticator implementation; if it also
// implements auth.HttpAwareAuthenticator, the shared ApiClient is injected so
// its HTTP calls reuse the same transport configuration. The optional transport
// options are applied to both API calls and any authentication HTTP calls the
// authenticator performs.
func New{{clientClassName}}WithAuthenticator(authenticator Authenticator, transportOptions *TransportOptions) *{{clientClassName}} {
	return New{{clientClassName}}(authenticator, transportOptions)
}

// authApiClientAdapter adapts the main package's ApiClient interface to the
// auth package's ApiClient interface, bridging the ApiHttpResponse types to
// avoid circular imports between the root module and the auth subpackage.
type authApiClientAdapter struct {
	inner ApiClient
}

func (a *authApiClientAdapter) SendRequest(method, url string, headers map[string]string, body any) (*auth.ApiHttpResponse, error) {
	return a.SendRequestWithOptions(method, url, headers, body, nil)
}

func (a *authApiClientAdapter) SendRequestWithOptions(method, url string, headers map[string]string, body any, opts *auth.RequestOptions) (*auth.ApiHttpResponse, error) {
	/* Every request that comes through this adapter is an authentication
	 * request (token endpoint, discovery document); the marker tells the
	 * transport to leave the caller's default headers off it. */
	base := context.Background()
	if opts != nil && opts.Context != nil {
		base = opts.Context
	}
	inner := &RequestOptions{Context: context.WithValue(base, authRequestContextKey{}, true)}
	if opts != nil {
		inner.NoRedirect = opts.NoRedirect
	}
	resp, err := a.inner.SendRequestWithOptions(method, url, headers, body, inner)
	if err != nil {
		return nil, err
	}
	return &auth.ApiHttpResponse{
		StatusCode: resp.StatusCode,
		Body:       resp.Body,
		Headers:    resp.Headers,
	}, nil
}
