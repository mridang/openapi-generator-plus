package {{packageName}}

import (
	"fmt"
	"time"

	"{{packageName}}/pkg/internal/protoduration"
)

// Helpers for OAS `format: time` and `format: duration`. Go's stdlib
// has no civil-time type, so `format: time` is surfaced as `string` in
// generated models; FormatTimeOfDay / ParseTimeOfDay convert it to and from
// the time-of-day component of a `time.Time`.
//
// `format: duration` is surfaced as the standard library's time.Duration,
// which the SDK writes in the protobuf-JSON google.protobuf.Duration form
// ("3600s") in bodies and parameters alike.
// MarshalDurationProtoJSON / UnmarshalDurationProtoJSON convert a
// time.Duration to and from that string form.

// MarshalDurationProtoJSON formats a time.Duration as a protobuf-JSON
// google.protobuf.Duration string: a decimal number of seconds suffixed
// with "s", e.g. "3600s", "1.5s", or "3600.000000001s". A protobuf-JSON
// API (any google.protobuf.Duration field) rejects ISO-8601 durations
// like "PT1H"; this is the only accepted shape.
//
// The fractional part is trimmed to 3, 6, or 9 digits (the smallest width
// that preserves every non-zero nanosecond), matching the protobuf JSON
// encoder. Negative durations carry a leading "-".
func MarshalDurationProtoJSON(d time.Duration) string {
	return protoduration.Format(d)
}

// UnmarshalDurationProtoJSON parses a protobuf-JSON google.protobuf.Duration
// string (see MarshalDurationProtoJSON) and returns the corresponding
// time.Duration. The accepted grammar is -?\d+(\.\d{1,9})?s; anything else
// (an ISO-8601 "PT1H", a bare number, or a fractional part wider than nine
// digits) is rejected with a *SerializationError, as is a value outside the
// range of time.Duration (about ±292 years).
func UnmarshalDurationProtoJSON(s string) (time.Duration, error) {
	d, err := protoduration.Parse(s)
	if err != nil {
		return 0, newSerializationError(fmt.Sprintf("invalid duration %q", s), err)
	}
	return d, nil
}

// FormatTimeOfDay returns the HH:MM:SS portion of a time.Time, matching
// the wire format for OAS `format: time` (RFC 3339 partial-time). Non-zero
// milliseconds are kept as .SSS and any finer precision is dropped (D103).
func FormatTimeOfDay(t time.Time) string {
	if t.Nanosecond()/1000000 == 0 {
		return t.Format("15:04:05")
	}
	return t.Format("15:04:05.000")
}

// ParseTimeOfDay parses an ISO-8601 partial-time string (HH:MM:SS or
// HH:MM:SS.fff) and returns a time.Time on the zero date in UTC. The
// time portion is the only meaningful field; callers should treat the
// date portion as undefined.
func ParseTimeOfDay(s string) (time.Time, error) {
	for _, layout := range []string{"15:04:05.000", "15:04:05.00", "15:04:05.0", "15:04:05"} {
		if t, err := time.Parse(layout, s); err == nil {
			return t, nil
		}
	}
	return time.Time{}, newSerializationError(fmt.Sprintf("ISO-8601 time: cannot parse %q (expected HH:MM:SS[.fff])", s), nil)
}
