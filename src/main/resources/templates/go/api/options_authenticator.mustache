package options

// Authenticator mirrors the root package's Authenticator interface so the
// options package can carry a per-operation authenticator without importing the
// root package, which would create an import cycle (the root package dot-imports
// pkg/options). Go's structural typing lets any implementation satisfy both.
type Authenticator interface {
	Host() string
	AuthHeaders() map[string]string
	QueryParams() map[string]string
	CookieParams() map[string]string
}
