/* checkConstraints runs the checks of one property on its value: a nil pointer
 * (an absent or null value) is not checked. Lengths count code points. */
func checkConstraints(value any, path string, checks []constraintCheck) error {
	rv := reflect.ValueOf(value)
	for rv.Kind() == reflect.Pointer || rv.Kind() == reflect.Interface {
		if rv.IsNil() {
			return nil
		}
		rv = rv.Elem()
	}
	for _, check := range checks {
		if !constraintHolds(rv, check) {
			return &constraintViolationError{path: path, rule: check.rule}
		}
	}
	return nil
}

/* constraintHolds reports whether a value meets one check; a check that does
 * not apply to the kind of the value holds. */
func constraintHolds(rv reflect.Value, check constraintCheck) bool {
	switch check.kind {
	case constraintMinLength, constraintMaxLength, constraintPattern:
		if rv.Kind() != reflect.String {
			return true
		}
		text := rv.String()
		switch check.kind {
		case constraintMinLength:
			return float64(utf8.RuneCountInString(text)) >= check.limit
		case constraintMaxLength:
			return float64(utf8.RuneCountInString(text)) <= check.limit
		default:
			compiled := constraintRegexp(check.pattern)
			return compiled == nil || compiled.MatchString(text)
		}
	case constraintMinItems, constraintMaxItems:
		if rv.Kind() != reflect.Slice && rv.Kind() != reflect.Array {
			return true
		}
		if check.kind == constraintMinItems {
			return float64(rv.Len()) >= check.limit
		}
		return float64(rv.Len()) <= check.limit
	case constraintMinProperties, constraintMaxProperties:
		if rv.Kind() != reflect.Map {
			return true
		}
		if check.kind == constraintMinProperties {
			return float64(rv.Len()) >= check.limit
		}
		return float64(rv.Len()) <= check.limit
	}
	number, ok := constraintNumber(rv)
	if !ok {
		return true
	}
	switch check.kind {
	case constraintMinimum:
		return number >= check.limit
	case constraintMaximum:
		return number <= check.limit
	case constraintExclusiveMinimum:
		return number > check.limit
	case constraintExclusiveMaximum:
		return number < check.limit
	default:
		quotient := number / check.limit
		return math.Abs(quotient-math.Round(quotient)) < 1e-9
	}
}

/* constraintNumber reads an integer or a float as a float64. */
func constraintNumber(rv reflect.Value) (float64, bool) {
	switch rv.Kind() {
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		return float64(rv.Int()), true
	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
		return float64(rv.Uint()), true
	case reflect.Float32, reflect.Float64:
		return rv.Float(), true
	}
	return 0, false
}
