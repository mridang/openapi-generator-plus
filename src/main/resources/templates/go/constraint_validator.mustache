/* validateRequestBody checks a request body against the validation keywords of
 * its schema and of every model it holds, depth first in declaration order, and
 * returns the first violation. A body that is not a model with a keyword (a map,
 * a scalar, a stream, a form) passes. */
func validateRequestBody(body any) error {
	return validateConstraintValue(body, "")
}

/* validateConstraintValue dispatches on the model type of a value; a list of
 * models is checked item by item, its index in brackets in the path. */
func validateConstraintValue(value any, path string) error {
	switch v := value.(type) {
