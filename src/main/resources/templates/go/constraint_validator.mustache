/* constraintViolationError is the error of the first broken keyword. Its text
 * is the one message all the SDKs share, so it keeps the capital letter that
 * staticcheck ST1005 asks a literal error string to drop; errors.Is matches it
 * to ErrInvalidRequestBody. */
type constraintViolationError struct {
	path string
	rule string
}

func (e *constraintViolationError) Error() string {
	return "Invalid request body: " + e.path + " " + e.rule
}

func (e *constraintViolationError) Unwrap() error {
	return ErrInvalidRequestBody
}

/* constraintKind names the keyword one check enforces. */
type constraintKind int

const (
	constraintMinLength constraintKind = iota
	constraintMaxLength
	constraintPattern
	constraintMinimum
	constraintMaximum
	constraintExclusiveMinimum
	constraintExclusiveMaximum
	constraintMultipleOf
	constraintMinItems
	constraintMaxItems
	constraintMinProperties
	constraintMaxProperties
)

/* constraintCheck is one keyword of one property: its kind, its limit, its
 * pattern and the rule text of the message. */
type constraintCheck struct {
	kind    constraintKind
	limit   float64
	pattern string
	rule    string
}

/* constraintPatterns holds each pattern compiled once, nil for a pattern RE2
 * cannot compile. */
var constraintPatterns sync.Map

/* constraintRegexp compiles a pattern on first use; a pattern RE2 cannot
 * compile (a look-around, a back-reference) is nil and is not enforced. */
func constraintRegexp(pattern string) *regexp.Regexp {
	if cached, ok := constraintPatterns.Load(pattern); ok {
		compiled, _ := cached.(*regexp.Regexp)
		return compiled
	}
	compiled, err := regexp.Compile(pattern)
	if err != nil {
		compiled = nil
	}
	constraintPatterns.Store(pattern, compiled)
	return compiled
}
