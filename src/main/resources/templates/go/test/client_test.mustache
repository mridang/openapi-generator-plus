		seen = r.Header.Get("Authorization")
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"id":1,"name":"Test","photoUrls":[]}`))
	}))
	defer explicitServer.Close()
	t.Setenv("{{envVarPrefix}}_BASE_URL", envServer.URL)
	t.Setenv("{{envVarPrefix}}_TOKEN", "env-token")

	client, err := {{packageName}}.New{{clientClassName}}WithToken(explicitServer.URL, "arg-token", nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	defer func() { _ = client.Close() }()
	_, _ = client.Pet.GetPetById(context.Background(), int64(1), nil)

	if seen != "Bearer arg-token" {
