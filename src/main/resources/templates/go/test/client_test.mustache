// lifecycleRoundTripper answers every request itself and counts them.
type lifecycleRoundTripper struct {
	hits atomic.Int32
}

func (rt *lifecycleRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	rt.hits.Add(1)
	return &http.Response{
		StatusCode: 200,
		Header:     http.Header{"Content-Type": []string{"application/json"}},
		Body:       io.NopCloser(strings.NewReader(`{"id":1,"name":"Test","photoUrls":[]}`)),
		Request:    req,
	}, nil
}

// A client built with a caller-supplied transport sends its requests through that transport.
func TestBhvLifecycle042_Client_ACallerSuppliedTransportCarriesEveryRequest(t *testing.T) {
