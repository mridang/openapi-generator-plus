// closableDoer is a caller-supplied HTTP client that records whether anyone closed it.
type closableDoer struct {
	inner  *http.Client
	closed atomic.Bool
}

func (d *closableDoer) Do(req *http.Request) (*http.Response, error) {
	return d.inner.Do(req)
}

func (d *closableDoer) Close() error {
	d.closed.Store(true)
	return nil
}

// Closing the SDK client does not close an HTTP client the caller supplied, which keeps sending requests.
func TestBhvLifecycle045_Client_ClosingTheSdkLeavesACallerSuppliedClientOpen(t *testing.T) {
	t.Parallel()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(200)
	}))
	defer server.Close()
	doer := &closableDoer{inner: server.Client()}
	opts, err := {{packageName}}.NewTransportOptionsBuilder().HttpClient(doer).Build()
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	client, err := {{packageName}}.New{{clientClassName}}WithToken(server.URL, "test-token", opts)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if err := client.Close(); err != nil {
		t.Fatalf("unexpected error from Close: %v", err)
	}

	if doer.closed.Load() {
		t.Fatal("the SDK closed the caller-supplied client")
	}
	req, err := http.NewRequest(http.MethodGet, server.URL, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	resp, err := doer.Do(req)
	if err != nil {
		t.Fatalf("expected the caller-supplied client to keep working, got %v", err)
	}
	_ = resp.Body.Close()
}

