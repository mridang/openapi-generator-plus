// A request in flight when the client is closed, retries included, still completes.
func TestBhvLifecycle044_Client_AnInFlightRequestCompletesAfterClose(t *testing.T) {
	t.Parallel()
	started := make(chan struct{}, 1)
	release := make(chan struct{})
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		select {
		case started <- struct{}{}:
		default:
		}
		<-release
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"id":1,"name":"Test","photoUrls":[]}`))
	}))
	defer server.Close()
	client, err := {{packageName}}.New{{clientClassName}}WithToken(server.URL, "test-token", nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	done := make(chan error, 1)
	go func() {
		_, err := client.Pet.GetPetById(context.Background(), int64(1), nil)
		done <- err
	}()
