	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	client, err := {{packageName}}.New{{clientClassName}}WithToken("https://api.example.com", "test-token", opts)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
