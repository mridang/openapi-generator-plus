func TestHeaderSelector_SelectHeadersMultipleJSONTypesWithPriority(t *testing.T) {
	t.Parallel()
	hs := newHeaderSelector()

	headers := hs.selectHeaders(
		[]string{"text/html", "application/vnd.api+json", "application/json"},
		"application/json",
		false,
	)

	accept := headers["Accept"]
	if !strings.HasPrefix(accept, "application/json") {
		t.Errorf("expected Accept to start with application/json, got %q", accept)
	}
	jsonIdx := strings.Index(accept, "application/json")
	vendorIdx := strings.Index(accept, "application/vnd.api+json")
	htmlIdx := strings.Index(accept, "text/html")
	if !(jsonIdx < vendorIdx) {
		t.Error("expected application/json to appear before application/vnd.api+json")
	}
	if !(vendorIdx < htmlIdx) {
		t.Error("expected application/vnd.api+json to appear before text/html")
	}
}

