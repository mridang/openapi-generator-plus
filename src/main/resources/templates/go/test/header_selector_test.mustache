func TestHeaderSelector_QualityWeighting(t *testing.T) {
	t.Parallel()
	hs := newHeaderSelector()

	// When multiple JSON and non-JSON types are provided, JSON types should be
	// preferred with higher quality weights
	headers := hs.selectHeaders(
		[]string{"application/json", "application/xml", "text/plain"},
		"application/json",
		false,
	)

	accept := headers["Accept"]
	if accept == "" {
		t.Fatal("expected non-empty Accept header")
	}

	// application/json should appear first (highest priority)
	jsonIdx := strings.Index(accept, "application/json")
	xmlIdx := strings.Index(accept, "application/xml")
	if jsonIdx < 0 {
		t.Error("expected application/json in Accept header")
	}
	if xmlIdx < 0 {
		t.Error("expected application/xml in Accept header")
	}
	if jsonIdx > xmlIdx {
		t.Error("expected application/json to appear before application/xml")
	}
}

