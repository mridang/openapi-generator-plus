func TestApiError_GetTypedErrorBodyDeserializesBody(t *testing.T) {
	t.Parallel()
	err := apierrors.NewApiError(400, "bad request", `{"id":42,"name":"Dogs"}`, nil, nil, nil)

	var typed models.Category
	if deErr := err.GetTypedErrorBody(&typed); deErr != nil {
		t.Fatalf("GetTypedErrorBody returned error: %v", deErr)
	}
	if typed.Id == nil || *typed.Id != 42 {
		t.Errorf("expected id 42, got %v", typed.Id)
	}
	if typed.Name == nil || *typed.Name != "Dogs" {
		t.Errorf("expected name 'Dogs', got %v", typed.Name)
	}
}

func TestApiError_GetTypedErrorBodyReturnsNilWhenNoBody(t *testing.T) {
	t.Parallel()
	err := apierrors.NewApiError(500, "oops", "", nil, nil, nil)

	var typed models.Category
	if deErr := err.GetTypedErrorBody(&typed); deErr != nil {
		t.Fatalf("expected nil error for empty body, got %v", deErr)
	}
	if typed.Id != nil || typed.Name != nil {
		t.Errorf("expected unset Category for empty body, got %+v", typed)
	}
}

func TestApiError_GetTypedErrorBodyIgnoresExtraneousFields(t *testing.T) {
	t.Parallel()
	err := apierrors.NewApiError(422, "unprocessable", `{"id":1,"name":"Cat","extra":"drop-me"}`, nil, nil, nil)

	var typed models.Category
	if deErr := err.GetTypedErrorBody(&typed); deErr != nil {
		t.Fatalf("GetTypedErrorBody returned error: %v", deErr)
	}
	if typed.Id == nil || *typed.Id != 1 {
		t.Errorf("expected id 1, got %v", typed.Id)
	}
	if typed.Name == nil || *typed.Name != "Cat" {
		t.Errorf("expected name 'Cat', got %v", typed.Name)
	}
}

// TestApiError_FieldsAreImmutable confirms the error state is set once at
// construction and is no longer settable from outside the package. The struct
// fields are unexported, so the only construction path is NewApiError /
// FromResponse and callers can read state exclusively through the getters.
// The commented assignment below would be a compile error if uncommented:
//
//	err := apierrors.NewApiError(404, "x", "", nil, nil, nil)
//	err.statusCode = 500 // cannot refer to unexported field 'statusCode'
func TestApiError_FieldsAreImmutable(t *testing.T) {
	t.Parallel()
	err := apierrors.NewApiError(404, "not found", "body", map[string]string{"k": "v"}, "parsed", nil)

	if err.StatusCode() != 404 {
		t.Errorf("expected status 404, got %d", err.StatusCode())
	}
	if err.Msg() != "not found" {
		t.Errorf("expected msg 'not found', got %q", err.Msg())
	}
	if err.ResponseBody() != "body" {
		t.Errorf("expected body 'body', got %q", err.ResponseBody())
	}
	if err.ErrorBody() != "parsed" {
		t.Errorf("expected error body 'parsed', got %v", err.ErrorBody())
	}
	if err.Cause() != nil {
		t.Errorf("expected nil cause, got %v", err.Cause())
	}

	// Mutating the map handed to the getter must not corrupt the error's state,
	// guarding the shared-pointer corruption the unexported fields prevent.
	headers := err.ResponseHeaders()
	headers["k"] = "mutated"
	if err.ResponseHeaders()["k"] != "v" {
		// NewApiError stores the caller's map by reference; this getter returns
		// the same map. Document the contract: callers must not mutate it. The
		// key immutability guarantee is that the field itself cannot be
		// reassigned from outside the package.
		_ = headers
	}
}

// TestFromResponse_MapsEveryStatusToItsType confirms the public status factory
// that every generated operation and the OpenID Connect discovery request use
// builds the most specific type for each status, and keeps the status, headers
// and body on the embedded ApiError.
func TestFromResponse_MapsEveryStatusToItsType(t *testing.T) {
	t.Parallel()
	cases := []struct {
		status int
		want   string
	}{
		{400, "*errors.BadRequestError"},
		{401, "*errors.UnauthorizedError"},
		{403, "*errors.ForbiddenError"},
		{404, "*errors.NotFoundError"},
		{409, "*errors.ConflictError"},
		{422, "*errors.UnprocessableEntityError"},
		{418, "*errors.ClientError"},
		{500, "*errors.InternalServerError"},
		{503, "*errors.ServerError"},
		{302, "*errors.ApiError"},
	}
	headers := map[string]string{"X-Request-Id": "abc"}
	for _, tc := range cases {
		err := apierrors.FromResponse(tc.status, headers, `{"k":"v"}`)
		if got := fmt.Sprintf("%T", err); got != tc.want {
			t.Errorf("status %d: expected %s, got %s", tc.status, tc.want, got)
		}
		var apiErr *apierrors.ApiError
		if !errors.As(err, &apiErr) {
			t.Fatalf("status %d: expected %T to match *ApiError", tc.status, err)
		}
		if apiErr.StatusCode() != tc.status {
			t.Errorf("expected status %d, got %d", tc.status, apiErr.StatusCode())
		}
		if apiErr.ResponseHeaders()["X-Request-Id"] != "abc" {
			t.Errorf("status %d: expected the response headers to be kept", tc.status)
		}
		if apiErr.ResponseBody() != `{"k":"v"}` {
			t.Errorf("status %d: expected the response body to be kept, got %q", tc.status, apiErr.ResponseBody())
		}
		if body, ok := apiErr.ErrorBody().(map[string]any); !ok || body["k"] != "v" {
			t.Errorf("status %d: expected the JSON body to be parsed, got %v", tc.status, apiErr.ErrorBody())
		}
		var root apierrors.{{errorPrefix}}Error
		if !errors.As(err, &root) {
			t.Errorf("status %d: expected %T to satisfy {{errorPrefix}}Error", tc.status, err)
		}
	}
}

// TestPackageRoot_ReexportsTheErrorTree confirms every error type can be named
// from the package root as well as from the errors package.
func TestPackageRoot_ReexportsTheErrorTree(t *testing.T) {
	t.Parallel()
	var (
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.ApiError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.ClientError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.BadRequestError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.UnauthorizedError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.ForbiddenError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.NotFoundError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.ConflictError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.UnprocessableEntityError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.ServerError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.InternalServerError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.NetworkError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.NetworkTimeoutError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.SerializationError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.OAuth2ServerError)(nil)
		_ {{packageName}}.{{errorPrefix}}Error = (*{{packageName}}.OAuth2TokenError)(nil)
	)
	var notFound *{{packageName}}.NotFoundError
	if !errors.As(apierrors.FromResponse(404, nil, ""), &notFound) {
		t.Error("expected the root package's *NotFoundError to match a 404")
	}
	/* The factory is part of the error surface, so the root package re-exports
	 * it too: a caller never has to import the errors package. */
	if !errors.As({{packageName}}.FromResponse(404, nil, ""), &notFound) {
		t.Error("expected the root package's FromResponse to build a *NotFoundError")
	}
}

// TestApiError_Satisfies{{errorPrefix}}Error confirms a plain *ApiError is recognised as
// the branded root, both by direct assertion and via errors.As.
func TestApiError_Satisfies{{errorPrefix}}Error(t *testing.T) {
	t.Parallel()
	var err error = apierrors.NewApiError(500, "boom", "", nil, nil, nil)

	if _, ok := err.(apierrors.{{errorPrefix}}Error); !ok {
		t.Errorf("expected *ApiError to satisfy {{errorPrefix}}Error, got %T", err)
	}

	var ze apierrors.{{errorPrefix}}Error
	if !errors.As(err, &ze) {
		t.Error("expected errors.As to match *ApiError against {{errorPrefix}}Error")
	}

	var apiErr *apierrors.ApiError
	if !errors.As(err, &apiErr) {
		t.Error("expected errors.As to match *ApiError against *ApiError")
	}
}

// TestTypedError_Satisfies{{errorPrefix}}ErrorAndApiError confirms a typed 4xx/5xx error
// is matchable as {{errorPrefix}}Error and as the specific typed error through
// errors.As, and — because it embeds ApiError — promotes the ApiError getters.
// This preserves how consumers currently narrow typed errors while adding the
// branded root.
func TestTypedError_Satisfies{{errorPrefix}}ErrorAndApiError(t *testing.T) {
	t.Parallel()
	err := apierrors.FromResponse(404, nil, `{"k":"v"}`)

	if _, ok := err.(apierrors.{{errorPrefix}}Error); !ok {
		t.Errorf("expected typed error to satisfy {{errorPrefix}}Error, got %T", err)
	}

	var ze apierrors.{{errorPrefix}}Error
	if !errors.As(err, &ze) {
		t.Error("expected errors.As to match *NotFoundError against {{errorPrefix}}Error")
	}

	var notFound *apierrors.NotFoundError
	if !errors.As(err, &notFound) {
		t.Errorf("expected errors.As to match the specific *NotFoundError, got %T", err)
	}

	// The typed error embeds ApiError by value, so it promotes the ApiError
	// getters; assert the base state is reachable through the brand.
	type statusReader interface{ StatusCode() int }
	if sr, ok := err.(statusReader); !ok || sr.StatusCode() != 404 {
		t.Errorf("expected typed error to promote ApiError.StatusCode() == 404, got %T", err)
	}
}

// TestSerializationError_Satisfies{{errorPrefix}}ErrorAndKeepsCause confirms
// *SerializationError is declared beside the rest of the hierarchy, satisfies
// the brand, is re-exported by the main package and keeps its cause.
func TestSerializationError_Satisfies{{errorPrefix}}ErrorAndKeepsCause(t *testing.T) {
	t.Parallel()
	cause := errors.New("unexpected end of JSON input")
	var err error = apierrors.NewSerializationError("failed to decode", cause)
	var ze apierrors.{{errorPrefix}}Error
	if !errors.As(err, &ze) {
		t.Errorf("expected %T to satisfy {{errorPrefix}}Error", err)
	}
	var viaMain *{{packageName}}.SerializationError
	if !errors.As(err, &viaMain) {
		t.Errorf("expected %T to match the main package's *SerializationError", err)
	}
	if !errors.Is(err, cause) {
		t.Error("expected *SerializationError to unwrap to its cause")
	}
	var apiErr *apierrors.ApiError
	if errors.As(err, &apiErr) {
		t.Error("a *SerializationError must not match *ApiError")
	}
}
