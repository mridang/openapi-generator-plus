// oauth-cc-authheaders-error-swallow: AuthHeadersOrError must surface the real
// token-endpoint failure instead of swallowing it into an empty header map.
func TestOAuth2ClientCredentials_AuthHeadersOrErrorPropagatesTokenError(t *testing.T) {
	t.Parallel()
	client := &fakeClientCredsClient{
		responses: []fakeClientCredsResponse{
			{body: `{"error":"invalid_client"}`, statusCode: 401},
		},
	}

	authObj := createClientCredentialsAuthenticator()
	authObj.SetApiClient(client)

	headers, err := authObj.AuthHeadersOrError()
	if err == nil {
		t.Fatalf("expected AuthHeadersOrError to return the token-endpoint error, got headers=%v", headers)
	}
	if headers != nil {
		t.Errorf("expected nil headers on error, got %v", headers)
	}
}

// The infallible AuthHeaders interface method collapses the same failure to an
// empty header map (interface conformance), confirming both the error path and
// the collapse path exist. Use AuthHeadersOrError to observe the real error.
func TestOAuth2ClientCredentials_AuthHeadersCollapsesErrorToEmptyMap(t *testing.T) {
	t.Parallel()
	client := &fakeClientCredsClient{
		responses: []fakeClientCredsResponse{
			{body: `{"error":"invalid_client"}`, statusCode: 401},
		},
	}

	authObj := createClientCredentialsAuthenticator()
	authObj.SetApiClient(client)

	headers := authObj.AuthHeaders()
	if _, ok := headers["Authorization"]; ok {
		t.Errorf("collapsed error path must not produce an Authorization header, got %v", headers)
	}
}

func TestOAuth2ClientCredentials_CachesTokenAcrossCalls(t *testing.T) {
	t.Parallel()
	// The token manager caches the access token until expiry, so two
	// consecutive header requests reuse the same token and issue only a single
	// token request. Only one response is supplied; a second token fetch would
	// index out of range and panic, proving single-flight.
	client := &fakeClientCredsClient{
		responses: []fakeClientCredsResponse{
			{body: `{"access_token":"cached-cc-token","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createClientCredentialsAuthenticator()
	authObj.SetApiClient(client)

	headers1 := authObj.AuthHeaders()
	headers2 := authObj.AuthHeaders()

	if headers1["Authorization"] != "Bearer cached-cc-token" {
		t.Errorf("expected first Authorization 'Bearer cached-cc-token', got %q", headers1["Authorization"])
	}
	if headers2["Authorization"] != "Bearer cached-cc-token" {
		t.Errorf("expected second Authorization 'Bearer cached-cc-token', got %q", headers2["Authorization"])
	}
}

