// F855: InvalidateAccessToken drops the cached token, so the next call fetches a
// new one instead of serving the token the API rejected.
func TestBhvAuthoauthtwoclientcred005_OAuth2ClientCredentialsAuthenticator_InvalidateAccessTokenForcesAFreshToken(t *testing.T) {
	t.Parallel()
	client := &recordingTokenClient{responses: []fakeResponse{
		{body: `{"access_token":"tok1","expires_in":3600}`, statusCode: 200},
		{body: `{"access_token":"tok2","expires_in":3600}`, statusCode: 200},
	}}
	authObj := createClientCredentialsAuthenticator()
	authObj.SetApiClient(client)

	if headers, err := authObj.AuthHeadersOrError(); err != nil || headers["Authorization"] != "Bearer tok1" {
		t.Fatalf("expected Bearer tok1, got %v, %v", headers, err)
	}
	if _, err := authObj.AuthHeadersOrError(); err != nil || client.requestCount() != 1 {
		t.Fatalf("expected the token to be cached, got %d requests, %v", client.requestCount(), err)
	}
	authObj.InvalidateAccessToken()
	headers, err := authObj.AuthHeadersOrError()
	if err != nil || headers["Authorization"] != "Bearer tok2" {
		t.Fatalf("expected Bearer tok2 after the invalidation, got %v, %v", headers, err)
	}
	if client.requestCount() != 2 {
		t.Errorf("expected a second token request, got %d", client.requestCount())
	}
}

