func TestOAuth2ClientCredentials_BasicAuthUrlEncodesClientIdAndSecret(t *testing.T) {
	t.Parallel()
	// Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
	// client_id and client_secret MUST be application/x-www-form-
	// urlencoded BEFORE being joined with ':' and base64-encoded.
	client := &fakeClientCredsClient{
		responses: []fakeClientCredsResponse{
			{body: `{"access_token":"at","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := oauth.NewOAuth2ClientCredentialsAuthenticator(
		"https://api.example.com",
		"id+with/special",
		"secret&with=stuff",
		"https://auth.example.com/token",
		[]string{"read"},
	).WithClientAuthMethod(oauth.ClientAuthMethodBasic)
	authObj.SetApiClient(client)

	authObj.AuthHeaders()

	authHeader, ok := client.LastHeaders["Authorization"]
	if !ok {
		t.Fatalf("expected Authorization header to be set")
	}
	if !strings.HasPrefix(authHeader, "Basic ") {
		t.Fatalf("expected Basic auth header, got %q", authHeader)
	}
	b64 := strings.TrimPrefix(authHeader, "Basic ")
	decodedBytes, err := base64.StdEncoding.DecodeString(b64)
	if err != nil {
		t.Fatalf("failed to base64-decode Authorization header: %v", err)
	}
	decoded := string(decodedBytes)
	// Expected: form-urlencoded id ':' form-urlencoded secret
	expected := "id%2Bwith%2Fspecial:secret%26with%3Dstuff"
	if decoded != expected {
		t.Errorf("expected decoded basic auth %q, got %q", expected, decoded)
	}
}
