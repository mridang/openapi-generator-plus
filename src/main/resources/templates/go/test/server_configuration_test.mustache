func TestServerConfiguration_AccessorsExposeImmutableState(t *testing.T) {
	t.Parallel()
	server := {{packageName}}.NewServerConfiguration(
		"https://{env}.example.com",
		"Test server",
		map[string]{{packageName}}.ServerVariable{
			"env": {{packageName}}.NewServerVariable("api", "", []string{"api", "staging"}),
		},
	)

	if got, want := server.URLTemplate(), "https://{env}.example.com"; got != want {
		t.Errorf("URLTemplate = %q, want %q", got, want)
	}
	if got, want := server.Description(), "Test server"; got != want {
		t.Errorf("Description = %q, want %q", got, want)
	}

	// The map returned by Variables is a copy; mutating it must not corrupt
	// the shared server configuration.
	vars := server.Variables()
	if _, ok := vars["env"]; !ok {
		t.Fatal("expected 'env' variable to be present")
	}
	delete(vars, "env")
	if _, ok := server.Variables()["env"]; !ok {
		t.Error("mutating the returned variables map must not affect the configuration")
	}
}
