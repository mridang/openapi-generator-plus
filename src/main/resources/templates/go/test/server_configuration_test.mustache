func TestServerConfiguration_URLSubstitutesOverrides(t *testing.T) {
	t.Parallel()
	server := {{packageName}}.NewServerConfiguration(
		"https://{env}.example.com/api/{version}",
		"Test server",
		map[string]{{packageName}}.ServerVariable{
			"env":     {{packageName}}.NewServerVariable("api", "", []string{"api", "staging"}),
			"version": {{packageName}}.NewServerVariable("v3", "", []string{"v2", "v3"}),
		},
	)

	url, err := server.URL(map[string]string{"env": "staging", "version": "v2"})
	if err != nil {
		t.Fatalf("URL() returned error: %v", err)
	}
	if want := "https://staging.example.com/api/v2"; url != want {
		t.Errorf("URL = %q, want %q", url, want)
	}
}

