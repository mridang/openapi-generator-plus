func TestServerConfiguration_URLRejectsValueOutsideEnum(t *testing.T) {
	t.Parallel()
	server := {{packageName}}.NewServerConfiguration(
		"https://{env}.example.com",
		"",
		map[string]{{packageName}}.ServerVariable{
			"env": {{packageName}}.NewServerVariable("api", "", []string{"api", "staging"}),
		},
	)

	_, err := server.URL(map[string]string{"env": "invalid"})
	if err == nil {
		t.Error("expected error for value outside the enum, got nil")
	}
}

