// mustApiKey builds an ApiKeyAuthenticator from a key the test knows is valid,
// failing the test if the constructor rejects it.
func mustApiKey(t *testing.T, host, name, key string, location auth.ApiKeyLocation) *auth.ApiKeyAuthenticator {
	t.Helper()
	a, err := auth.NewApiKeyAuthenticator(host, name, key, location)
	if err != nil {
		t.Fatalf("unexpected error from NewApiKeyAuthenticator: %v", err)
	}
	return a
}

// expectInvalidApiKey asserts the constructor rejects a key with
// ErrInvalidApiKey and returns no authenticator.
func expectInvalidApiKey(t *testing.T, value string, location auth.ApiKeyLocation) {
	t.Helper()
	a, err := auth.NewApiKeyAuthenticator("https://api.example.com", "X-API-Key", value, location)
	if !errors.Is(err, auth.ErrInvalidApiKey) {
		t.Errorf("expected ErrInvalidApiKey for %q, got %v", value, err)
	}
	if a != nil {
		t.Errorf("expected a nil authenticator for %q", value)
	}
}

func TestApiKeyAuthenticator_ValidHeaderKeyPasses(t *testing.T) {
	t.Parallel()
	a := mustApiKey(t, "https://api.example.com", "X-API-Key", "abc123", auth.ApiKeyLocationHeader)
	headers := a.AuthHeaders()
	if got, want := headers["X-API-Key"], "abc123"; got != want {
		t.Fatalf("X-API-Key header = %q, want %q", got, want)
	}
}

func TestApiKeyAuthenticator_ValidQueryKeyPasses(t *testing.T) {
	t.Parallel()
	a := mustApiKey(t, "https://api.example.com", "api_key", "abc123", auth.ApiKeyLocationQuery)
	params := a.QueryParams()
	if got, want := params["api_key"], "abc123"; got != want {
		t.Fatalf("api_key query param = %q, want %q", got, want)
	}
}

