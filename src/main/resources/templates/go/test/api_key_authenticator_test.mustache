// A non-header location accepts non-ASCII characters because only the HTTP
// header value is subject to the RFC 7230 printable-ASCII rule.
func TestApiKeyAuthenticator_QueryLocationAcceptsNonAscii(t *testing.T) {
	t.Parallel()
	a := mustApiKey(t, "https://api.example.com", "api_key", "kéy", auth.ApiKeyLocationQuery)
	params := a.QueryParams()
	if got, want := params["api_key"], "kéy"; got != want {
		t.Fatalf("api_key query param = %q, want %q", got, want)
	}
}

// Empty or whitespace-only API keys are caller mistakes at every location.
func TestApiKeyAuthenticator_RejectsEmptyOrWhitespaceKey(t *testing.T) {
	t.Parallel()
	cases := []struct {
		name     string
		value    string
		location auth.ApiKeyLocation
	}{
		{"header-empty", "", auth.ApiKeyLocationHeader},
		{"query-empty", "", auth.ApiKeyLocationQuery},
		{"cookie-empty", "", auth.ApiKeyLocationCookie},
		{"header-whitespace", "   ", auth.ApiKeyLocationHeader},
	}
	for _, tc := range cases {
		expectInvalidApiKey(t, tc.value, tc.location)
	}
}

// CR/LF/NUL are forbidden at every location to prevent header/cookie/query
// injection.
func TestApiKeyAuthenticator_RejectsControlCharsAtEveryLocation(t *testing.T) {
	t.Parallel()
	cases := []struct {
		value    string
		location auth.ApiKeyLocation
	}{
		{"abc\r\n", auth.ApiKeyLocationQuery},
		{"abc\n", auth.ApiKeyLocationCookie},
		{"abc\rdef", auth.ApiKeyLocationHeader},
		{"abc\x00def", auth.ApiKeyLocationHeader},
	}
	for _, tc := range cases {
		expectInvalidApiKey(t, tc.value, tc.location)
	}
}

// RFC 7230 §3.2.6 — a header-location key must reject anything outside
// printable ASCII + TAB to prevent silent UTF-8 mangling that varies per HTTP
// lib.
func TestApiKeyAuthenticator_HeaderLocationRejectsNonAscii(t *testing.T) {
	t.Parallel()
	expectInvalidApiKey(t, "kéy", auth.ApiKeyLocationHeader)
}

// The rejection reads as the canonical sentence the other SDKs use, with the
// key name quoted.
func TestApiKeyAuthenticator_RejectionMessages(t *testing.T) {
	t.Parallel()
	cases := []struct {
		value    string
		location auth.ApiKeyLocation
		want     string
	}{
		{"", auth.ApiKeyLocationHeader, "API key value for 'X-API-Key' must not be empty"},
		{"abc\n", auth.ApiKeyLocationQuery, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"},
		{"kéy", auth.ApiKeyLocationHeader, "API key value for header 'X-API-Key' must contain only printable ASCII characters (RFC 7230 §3.2.6)"},
	}
	for _, tc := range cases {
		_, err := auth.NewApiKeyAuthenticator("https://api.example.com", "X-API-Key", tc.value, tc.location)
		if err == nil || err.Error() != tc.want {
			t.Errorf("value %q: expected %q, got %v", tc.value, tc.want, err)
		}
	}
}

// authenticator-secret-in-default-string-repr: the API key must not leak
// through the default string/format representation.
func TestApiKeyAuthenticator_RedactsSecret(t *testing.T) {
	t.Parallel()
	a := mustApiKey(t, "https://api.example.com", "X-API-Key", "abc123", auth.ApiKeyLocationHeader)
	for _, s := range []string{a.String(), fmt.Sprintf("%v", a), fmt.Sprintf("%+v", a), fmt.Sprintf("%#v", a), fmt.Sprintf("%v", *a), fmt.Sprintf("%+v", *a), fmt.Sprintf("%#v", *a)} {
		if strings.Contains(s, "abc123") {
			t.Errorf("expected api key to be redacted, got %q", s)
		}
		if !strings.Contains(s, "***") {
			t.Errorf("expected redaction marker '***', got %q", s)
		}
	}
}

// keyEmitter is what every API-key authenticator, plain or per-scheme wrapper,
// offers the request builder.
type keyEmitter interface {
	AuthHeaders() map[string]string
	QueryParams() map[string]string
	CookieParams() map[string]string
}

// Each per-scheme wrapper fixes the key name and the location its security
// scheme declares: the key is emitted there and nowhere else, an empty key is
// refused up front, and the printed form names the wrapper and masks the key.
func TestApiKeyWrappers_EmitTheKeyWhereTheirSchemeDeclaresIt(t *testing.T) {
	t.Parallel()
	const host = "https://api.example.com"
	none := map[string]string{}
	cases := []struct {
		name   string
		build  func(key string) (keyEmitter, error)
		header map[string]string
		query  map[string]string
		cookie map[string]string
		repr   string
	}{
		{
			"ApiKeyHeaderAuthenticator",
			func(key string) (keyEmitter, error) { return auth.NewApiKeyHeaderAuthenticator(host, key) },
			map[string]string{"X-API-Key": "abc123"}, none, none,
			`ApiKeyHeaderAuthenticator{host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: ***, location: Header}`,
		},
		{
			"InternalApiKeyAuthenticator",
			func(key string) (keyEmitter, error) { return auth.NewInternalApiKeyAuthenticator(host, key) },
			map[string]string{"X-Internal-Key": "abc123"}, none, none,
			`InternalApiKeyAuthenticator{host: "https://api.example.com", keyParamName: "X-Internal-Key", apiKey: ***, location: Header}`,
		},
		{
			"ApiKeyQueryAuthenticator",
			func(key string) (keyEmitter, error) { return auth.NewApiKeyQueryAuthenticator(host, key) },
			none, map[string]string{"api_key": "abc123"}, none,
			`ApiKeyQueryAuthenticator{host: "https://api.example.com", keyParamName: "api_key", apiKey: ***, location: Query}`,
		},
		{
			"SessionCookieAuthenticator",
			func(key string) (keyEmitter, error) { return auth.NewSessionCookieAuthenticator(host, key) },
			none, none, map[string]string{"SESSION_ID": "abc123"},
			`SessionCookieAuthenticator{host: "https://api.example.com", keyParamName: "SESSION_ID", apiKey: ***, location: Cookie}`,
		},
	}
	for _, tc := range cases {
		a, err := tc.build("abc123")
		if err != nil {
			t.Errorf("%s: unexpected error: %v", tc.name, err)
			continue
		}
		if got := a.AuthHeaders(); !reflect.DeepEqual(got, tc.header) {
			t.Errorf("%s: expected header params %v, got %v", tc.name, tc.header, got)
		}
		if got := a.QueryParams(); !reflect.DeepEqual(got, tc.query) {
			t.Errorf("%s: expected query params %v, got %v", tc.name, tc.query, got)
		}
		if got := a.CookieParams(); !reflect.DeepEqual(got, tc.cookie) {
			t.Errorf("%s: expected cookie params %v, got %v", tc.name, tc.cookie, got)
		}
		if got := fmt.Sprint(a); got != tc.repr {
			t.Errorf("%s: expected %q, got %q", tc.name, tc.repr, got)
		}
		if _, err := tc.build(""); !errors.Is(err, auth.ErrInvalidApiKey) {
			t.Errorf("%s: expected ErrInvalidApiKey for an empty key, got %v", tc.name, err)
		}
	}
}

// The printed form shows the non-secret fields, host, key name and location, and
// masks only the key.
func TestApiKeyAuthenticator_ReprShowsTheNonSecretFields(t *testing.T) {
	t.Parallel()
	a := mustApiKey(t, "https://api.example.com", "X-API-Key", "abc123", auth.ApiKeyLocationHeader)
	want := `ApiKeyAuthenticator{host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: ***, location: Header}`
	if got := a.String(); got != want {
		t.Errorf("expected %q, got %q", want, got)
	}
}
