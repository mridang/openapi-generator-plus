func TestBhvServers015_ServerVariable_EnumValuesIsNilWhenUnconstrained(t *testing.T) {
	t.Parallel()
	v := {{packageName}}.NewServerVariable("api", "", nil)

	if enum := v.EnumValues(); enum != nil {
		t.Errorf("EnumValues = %v, want nil for an unconstrained variable", enum)
	}
}

func TestBhvLanggo095_ServerVariable_ConstructorCopiesEnumSlice(t *testing.T) {
	t.Parallel()
	source := []string{"v2", "v3"}
	v := {{packageName}}.NewServerVariable("v3", "", source)

	// Mutating the caller's slice after construction must not change the
	// variable's stored enum values, since they are defensively copied.
	source[0] = "mutated"

	enum := v.EnumValues()
	if len(enum) != 2 || enum[0] != "v2" || enum[1] != "v3" {
		t.Errorf("EnumValues = %v, want [v2 v3] after mutating the source slice", enum)
	}
}

// Go has no frozen slice, so the accessor hands out a copy: a caller that
// changes the slice it read does not change the variable's enum values.
func TestBhvServers024_ServerVariable_EnumValuesCannotBeMutatedThroughTheAccessor(t *testing.T) {
	t.Parallel()
	v := {{packageName}}.NewServerVariable("v3", "", []string{"v2", "v3"})

	v.EnumValues()[0] = "mutated"

	if enum := v.EnumValues(); enum[0] != "v2" || enum[1] != "v3" {
		t.Errorf("EnumValues = %v, want [v2 v3] after a caller changed the slice it read", enum)
	}
}

// A variable exposes its default value, its description and its enum values.
func TestBhvServers017_ServerVariable_ExposesDefaultValueDescriptionAndEnumValues(t *testing.T) {
	t.Parallel()
	v := {{packageName}}.NewServerVariable("v3", "API version", []string{"v2", "v3"})

	if got, want := v.DefaultValue(), "v3"; got != want {
		t.Errorf("DefaultValue = %q, want %q", got, want)
	}
	if got, want := v.Description(), "API version"; got != want {
		t.Errorf("Description = %q, want %q", got, want)
	}
	if enum := v.EnumValues(); len(enum) != 2 || enum[0] != "v2" || enum[1] != "v3" {
		t.Errorf("EnumValues = %v, want [v2 v3]", enum)
	}
}

// The enum values are exposed so a caller can validate a value against them.
func TestBhvServers018_ServerVariable_EnumValuesAreExposedForValidation(t *testing.T) {
	t.Parallel()
	v := {{packageName}}.NewServerVariable("prod", "", []string{"prod", "staging"})

	enum := v.EnumValues()
	if len(enum) != 2 || enum[0] != "prod" || enum[1] != "staging" {
		t.Errorf("EnumValues = %v, want [prod staging]", enum)
	}
}

// A value outside the allowed set is absent from the enum values.
func TestBhvServers019_ServerVariable_EnumDoesNotContainAValueOutsideTheAllowedSet(t *testing.T) {
	t.Parallel()
	v := {{packageName}}.NewServerVariable("prod", "", []string{"prod", "staging"})

	for _, value := range v.EnumValues() {
		if value == "dev" {
			t.Errorf("EnumValues = %v must not contain %q", v.EnumValues(), "dev")
		}
	}
}
