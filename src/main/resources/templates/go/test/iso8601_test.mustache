func TestParseTimeOfDay_Basic(t *testing.T) {
	t.Parallel()
	got, err := {{packageName}}.ParseTimeOfDay("09:15:30")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got.Hour() != 9 || got.Minute() != 15 || got.Second() != 30 {
		t.Errorf("expected 09:15:30, got %v", got)
	}
}

func TestParseTimeOfDay_WithFraction(t *testing.T) {
	t.Parallel()
	got, err := {{packageName}}.ParseTimeOfDay("09:15:30.500")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got.Hour() != 9 || got.Minute() != 15 || got.Second() != 30 {
		t.Errorf("expected hours/mins/secs from 09:15:30.500, got %v", got)
	}
}

func TestParseTimeOfDay_Invalid(t *testing.T) {
	t.Parallel()
	if _, err := {{packageName}}.ParseTimeOfDay("not a time"); err == nil {
		t.Fatal("expected error for invalid time string")
	}
}

func TestTimeOfDay_RoundTrip(t *testing.T) {
	t.Parallel()
	original := "14:25:00"
	parsed, err := {{packageName}}.ParseTimeOfDay(original)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got := {{packageName}}.FormatTimeOfDay(parsed); got != original {
		t.Errorf("round-trip mismatch: original=%q got=%q", original, got)
	}
}
