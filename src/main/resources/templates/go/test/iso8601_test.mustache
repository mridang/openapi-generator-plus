		t.Fatal("expected error for year designator")
	}
}

func TestUnmarshalDurationISO8601_RejectsMonths(t *testing.T) {
	t.Parallel()
	if _, err := {{packageName}}.UnmarshalDurationISO8601("P1M"); err == nil {
		t.Fatal("expected error for month designator")
	}
