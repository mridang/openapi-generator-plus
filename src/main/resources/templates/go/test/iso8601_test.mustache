// 4.8: format:duration ↔ time.Duration round-trip helpers.

func TestMarshalDurationISO8601_Zero(t *testing.T) {
	t.Parallel()
	if got := {{packageName}}.MarshalDurationISO8601(0); got != "PT0S" {
		t.Errorf("expected PT0S, got %q", got)
	}
}

func TestMarshalDurationISO8601_HoursMinutes(t *testing.T) {
	t.Parallel()
	d := time.Hour + 30*time.Minute
	if got := {{packageName}}.MarshalDurationISO8601(d); got != "PT1H30M" {
		t.Errorf("expected PT1H30M, got %q", got)
	}
}

func TestMarshalDurationISO8601_DaysAndTime(t *testing.T) {
	t.Parallel()
	d := 2*24*time.Hour + 3*time.Hour
	if got := {{packageName}}.MarshalDurationISO8601(d); got != "P2DT3H" {
		t.Errorf("expected P2DT3H, got %q", got)
	}
}

func TestMarshalDurationISO8601_SecondsOnly(t *testing.T) {
	t.Parallel()
	if got := {{packageName}}.MarshalDurationISO8601(45 * time.Second); got != "PT45S" {
		t.Errorf("expected PT45S, got %q", got)
	}
}

func TestMarshalDurationISO8601_Negative(t *testing.T) {
	t.Parallel()
	if got := {{packageName}}.MarshalDurationISO8601(-(time.Hour + time.Minute)); got != "-PT1H1M" {
		t.Errorf("expected -PT1H1M, got %q", got)
	}
}

func TestUnmarshalDurationISO8601_HoursMinutes(t *testing.T) {
	t.Parallel()
	got, err := {{packageName}}.UnmarshalDurationISO8601("PT1H30M")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got != time.Hour+30*time.Minute {
		t.Errorf("expected 1h30m, got %v", got)
	}
}

func TestUnmarshalDurationISO8601_DaysHours(t *testing.T) {
	t.Parallel()
	got, err := {{packageName}}.UnmarshalDurationISO8601("P1DT2H")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	want := 24*time.Hour + 2*time.Hour
	if got != want {
		t.Errorf("expected %v, got %v", want, got)
	}
}

