// secs*1e9 wraps an int64 past about 9.2e9 seconds; a value outside the range
// of time.Duration must be rejected, not silently wrapped.
func TestBhvLanggo046_Iso8601_UnmarshalDurationProtoJSON_RejectsOverflow(t *testing.T) {
	t.Parallel()
	cases := []string{"9223372037s", "-9223372037s", "9223372036.854775808s", "99999999999999999999s"}
	for _, c := range cases {
		_, err := {{packageName}}.UnmarshalDurationProtoJSON(c)
		var serErr *{{packageName}}.SerializationError
		if !errors.As(err, &serErr) {
			t.Errorf("expected *SerializationError for %q, got %T: %v", c, err, err)
		}
	}
}

func TestBhvSerialization047_Iso8601_Duration_RoundTripsTheExtremes(t *testing.T) {
	t.Parallel()
	for _, wire := range []string{"9223372037s", "-9223372037s"} {
		_, err := {{packageName}}.UnmarshalDurationProtoJSON(wire)
		var serErr *{{packageName}}.SerializationError
		if !errors.As(err, &serErr) {
			t.Errorf("expected *SerializationError for out-of-range %q, got %T: %v", wire, err, err)
		}
	}
	for _, orig := range []time.Duration{math.MaxInt64, -math.MaxInt64} {
		wire := {{packageName}}.MarshalDurationProtoJSON(orig)
		got, err := {{packageName}}.UnmarshalDurationProtoJSON(wire)
		if err != nil {
			t.Errorf("round-trip parse failed for %v (%q): %v", orig, wire, err)
			continue
		}
		if got != orig {
			t.Errorf("round-trip mismatch: original=%v wire=%q parsed=%v", orig, wire, got)
		}
	}
}

func TestBhvLanggo047_Iso8601_Duration_RoundTrip(t *testing.T) {
	t.Parallel()
	originals := []time.Duration{
