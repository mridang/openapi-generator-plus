// capturingApiClient captures the headers, URL, and body sent by BaseApi.
type capturingApiClient struct {
	capturedHeaders map[string]string
	capturedURL     string
	capturedBody    any
	capturedOpts    *{{packageName}}.RequestOptions
	responseBody    string
}

func (c *capturingApiClient) SendRequest(method, url string, headers map[string]string, body any) (*{{packageName}}.ApiHttpResponse, error) {
	return c.SendRequestWithOptions(method, url, headers, body, nil)
}

func (c *capturingApiClient) SendRequestWithOptions(method, url string, headers map[string]string, body any, opts *{{packageName}}.RequestOptions) (*{{packageName}}.ApiHttpResponse, error) {
	c.capturedOpts = opts
	c.capturedHeaders = make(map[string]string)
	for k, v := range headers {
		c.capturedHeaders[k] = v
	}
	c.capturedURL = url
	c.capturedBody = body
	return &{{packageName}}.ApiHttpResponse{StatusCode: 200, Body: c.body(), Headers: map[string]string{"content-type": "application/json"}}, nil
}

// body is the canned response text: "{}" unless a test sets responseBody.
func (c *capturingApiClient) body() string {
	if c.responseBody == "" {
		return "{}"
	}
	return c.responseBody
}

// Close satisfies the ApiClient contract; this stub holds no resources.
func (c *capturingApiClient) Close() error { return nil }

