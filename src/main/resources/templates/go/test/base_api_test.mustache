// ── F823: automatic retries with backoff ──

// scriptedReply is one answer of a scriptedServer.
type scriptedReply struct {
	status     int
	retryAfter string
}

// scriptedServer answers its requests from a script (the last reply repeats) and
// records the Authorization header of each.
type scriptedServer struct {
	*httptest.Server
	mu   sync.Mutex
	auth []string
	hits atomic.Int32
}

func newScriptedServer(t *testing.T, script ...scriptedReply) *scriptedServer {
	t.Helper()
	srv := &scriptedServer{}
	srv.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		n := int(srv.hits.Add(1)) - 1
		srv.mu.Lock()
		srv.auth = append(srv.auth, r.Header.Get("Authorization"))
		srv.mu.Unlock()
		reply := script[min(n, len(script)-1)]
		w.Header().Set("Content-Type", "application/json")
		if reply.retryAfter != "" {
			w.Header().Set("Retry-After", reply.retryAfter)
		}
		w.WriteHeader(reply.status)
		if reply.status >= 200 && reply.status < 300 {
			_, _ = w.Write([]byte(`{"id":1,"name":"Test","photoUrls":[]}`))
			return
		}
		_, _ = w.Write([]byte(`{"message":"failed"}`))
	}))
	t.Cleanup(srv.Close)
	return srv
}

// retryApi is a PetApi on the server with the given transport options.
func retryApi(t *testing.T, srv *scriptedServer, configure func(*{{packageName}}.TransportOptionsBuilder), authenticator {{packageName}}.Authenticator) *{{packageName}}.PetApi {
	t.Helper()
	builder := {{packageName}}.NewTransportOptionsBuilder()
	if configure != nil {
		configure(builder)
	}
	transport, err := builder.Build()
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL(srv.URL).Build()
	client := {{packageName}}.NewDefaultApiClient(transport)
	t.Cleanup(func() { _ = client.Close() })
	return {{packageName}}.NewPetApi(client, config, authenticator, {{packageName}}.Credentials{})
}

func addPetCall(api *{{packageName}}.PetApi) error {
	_, err := api.AddPet(context.Background(), *models.NewPet("Test", []string{}), nil)
	return err
}

func TestBaseApi_RetriesTwiceByDefaultWithBackoff(t *testing.T) {
	t.Parallel()
	srv := newScriptedServer(t, scriptedReply{status: 500}, scriptedReply{status: 503}, scriptedReply{status: 200})
	api := retryApi(t, srv, nil, nil)

	started := time.Now()
	if err := addPetCall(api); err != nil {
		t.Fatalf("expected the third attempt to succeed, got %v", err)
	}
	if got := srv.hits.Load(); got != 3 {
		t.Errorf("expected 3 requests, got %d", got)
	}
	/* 0.5 s and 1 s, each reduced by at most 25% jitter. */
	if elapsed := time.Since(started); elapsed < 1100*time.Millisecond {
		t.Errorf("expected the backoff to wait about 1.5 s, waited %v", elapsed)
	}
}

