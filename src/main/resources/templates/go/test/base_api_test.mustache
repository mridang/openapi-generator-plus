	for _, tc := range testCases {
		t.Run(tc.errType, func(t *testing.T) {
			config := {{packageName}}.NewConfigurationBuilder().BaseURL(chasmHTTPURL + tc.path).Build()
			api := {{packageName}}.NewPetApi({{packageName}}.NewDefaultApiClient(noRetryTransport(t)), config, nil, {{packageName}}.Credentials{})
