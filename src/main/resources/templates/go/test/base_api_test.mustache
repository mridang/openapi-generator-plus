// ── Configured authenticator is actually applied (AUTH-APPLIED) ──

// auth-applied-regression-guard: a client constructed with a configured
// authenticator must apply that credential to a secured request even when the
// per-operation Options carry no Auth override. This is the regression guard
// for the Elixir bug where a configured authenticator was silently dropped: the
// client-level authenticator (3rd arg to NewPetApi) is the fallback, and the
// outbound request must carry its Authorization header. We route through a
// capturing client so we can assert on the exact headers BaseApi emitted.
func TestBhvAuthintegration006_BaseApi_ConfiguredAuthenticatorIsAppliedToSecuredRequest(t *testing.T) {
	t.Parallel()
	client := &capturingApiClient{}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL(chasmHTTPURL).Build()

	// Bearer is one of the schemes the petstore spec defines (petStoreBearer).
	bearer := mustBearer(t, "https://api.example.com", "secret-jwt")
	api := {{packageName}}.NewPetApi(client, config, bearer, {{packageName}}.Credentials{})

	// Secured operation with no per-operation Auth override: the configured
	// client-level authenticator must supply the credential. capturingApiClient
	// records request headers at send time, so the deserialize outcome of its
	// placeholder ("{}") response body is irrelevant to this assertion (the
	// sibling header tests ignore it the same way).
	_, _ = api.AddPet(context.Background(), *models.NewPet("Test", []string{}), nil)

	if got, want := client.capturedHeaders["Authorization"], "Bearer secret-jwt"; got != want {
		t.Fatalf("outbound Authorization header = %q, want %q (configured authenticator was dropped)", got, want)
	}
}

// ── security: [] suppresses the client authenticator (SECURITY-NONE) ──

// security-none-suppresses-client-auth: an operation declared `security: []` in
// the spec is explicitly unauthenticated. Even when the client is constructed
// WITH an authenticator, the outbound request for such an operation must carry
// NO auth material — no Authorization header, no api-key header or query param,
// and no auth cookie. GetInventory is declared `security: []`, so invoking it must
// strip the configured credential. This is the core of Wave A2: base_api sees
// the noAuth sentinel passed by the unauthenticated operation and does NOT fall
// back to the client-level authenticator. A capturing client records the exact
// outbound headers/URL so the suppression can be asserted directly.
func TestBhvAuthintegration005_BaseApi_SecurityNoneSuppressesClientAuthenticator(t *testing.T) {
	t.Parallel()
	client := &capturingApiClient{}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://localhost").Build()

	// A multi-vector authenticator: it would inject an Authorization header, an
	// api-key header, an api-key query param, and a session cookie on a secured
	// request. None of these may appear on a security:[] operation.
	leaky := &baseApiAuth{
		headers: map[string]string{
			"Authorization": "Bearer secret-jwt",
			"api-key":       "secret-api-key",
		},
		query:   map[string]string{"api_key": "secret-api-key"},
		cookies: map[string]string{"session": "secret-session"},
	}
	api := {{packageName}}.NewStoreApi(client, config, leaky, {{packageName}}.Credentials{})

	// GetInventory is declared security:[] — the configured authenticator must be
	// suppressed entirely.
	_, _ = api.GetInventory(context.Background())

	if got, ok := client.capturedHeaders["Authorization"]; ok {
		t.Errorf("security:[] operation leaked Authorization header = %q; client credential must be suppressed", got)
	}
	if got, ok := client.capturedHeaders["api-key"]; ok {
		t.Errorf("security:[] operation leaked api-key header = %q; client credential must be suppressed", got)
	}
	if got, ok := client.capturedHeaders["Cookie"]; ok {
		t.Errorf("security:[] operation leaked Cookie header = %q; client credential must be suppressed", got)
	}
	if strings.Contains(client.capturedURL, "api_key") || strings.Contains(client.capturedURL, "secret-api-key") {
		t.Errorf("security:[] operation leaked api-key query param in URL = %q; client credential must be suppressed", client.capturedURL)
	}
}

// ── inherited global security applies the client authenticator ──

// inherited-global-applies-client-auth: GetPetById declares no security of its
// own, so it inherits the global requirement. This generator strips the
// inherited auth methods off such an operation, so the api method passes a nil
// per-call override (not the noAuth sentinel); base_api must then fall back to
// the client-level authenticator. A configured client credential MUST reach the
// wire — the regression that silently dropped auth on every inherited-security
// operation.
func TestBhvAuthintegration012_BaseApi_InheritedGlobalSecurityAppliesClientAuthenticator(t *testing.T) {
	t.Parallel()
	client := &capturingApiClient{}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://localhost").Build()

	bearer := &baseApiAuth{
		headers: map[string]string{"Authorization": "Bearer secret-jwt"},
	}
	api := {{packageName}}.NewPetApi(client, config, bearer, {{packageName}}.Credentials{})

	// GetPetById inherits the global security requirement; with no per-call
	// override the client authenticator must be applied.
	_, _ = api.GetPetById(context.Background(), int64(1), nil)

	if got, want := client.capturedHeaders["Authorization"], "Bearer secret-jwt"; got != want {
		t.Errorf("inherited-security operation Authorization header = %q, want %q (client authenticator was dropped)", got, want)
	}
}

