// ── F855: a 401 on an OAuth2 request replays it once ──

// oauthReplayServer is an API that accepts one access token and a token endpoint
// that issues tok1, tok2, ...; it counts the calls to each.
type oauthReplayServer struct {
	*httptest.Server
	apiHits   atomic.Int32
	tokenHits atomic.Int32
}

// newOAuthReplayServer starts the server; failTokenFrom, when positive, makes
// the token endpoint answer 500 from that request on.
func newOAuthReplayServer(t *testing.T, accepted string, failTokenFrom int32) *oauthReplayServer {
	t.Helper()
	srv := &oauthReplayServer{}
	srv.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		if r.URL.Path == "/token" {
			n := srv.tokenHits.Add(1)
			if failTokenFrom > 0 && n >= failTokenFrom {
				w.WriteHeader(500)
				_, _ = w.Write([]byte(`{"error":"server_error"}`))
				return
			}
			_, _ = w.Write([]byte(`{"access_token":"tok` + string(rune('0'+n)) + `","expires_in":3600}`))
			return
		}
		srv.apiHits.Add(1)
		if r.Header.Get("Authorization") != "Bearer "+accepted {
			w.WriteHeader(401)
			_, _ = w.Write([]byte(`{"message":"expired"}`))
			return
		}
		_, _ = w.Write([]byte(`{"id":1,"name":"Test","photoUrls":[]}`))
	}))
	t.Cleanup(srv.Close)
	return srv
}

func replayClient(t *testing.T, srv *oauthReplayServer) *{{packageName}}.{{clientClassName}} {
	t.Helper()
	authObj := oauth.NewOAuth2ClientCredentialsAuthenticator(srv.URL, "id", "secret", srv.URL+"/token", nil)
	client := {{packageName}}.New{{clientClassName}}(authObj, noRetryTransport(t))
	t.Cleanup(func() { _ = client.Close() })
	return client
}

