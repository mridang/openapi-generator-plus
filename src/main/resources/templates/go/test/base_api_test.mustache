// baseApiAuth implements Authenticator for base API tests.
type baseApiAuth struct {
	headers map[string]string
	query   map[string]string
	cookies map[string]string
}

func (a *baseApiAuth) Host() string                    { return "" }
func (a *baseApiAuth) AuthHeaders() map[string]string  { return a.headers }
func (a *baseApiAuth) QueryParams() map[string]string  { return a.query }
func (a *baseApiAuth) CookieParams() map[string]string { return a.cookies }

