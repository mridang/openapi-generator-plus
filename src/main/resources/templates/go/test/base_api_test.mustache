func noRetryTransport(t *testing.T) *{{packageName}}.TransportOptions {
	t.Helper()
	transport, err := {{packageName}}.NewTransportOptionsBuilder().MaxRetries(0).Build()
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
