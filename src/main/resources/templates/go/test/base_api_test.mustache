func TestBhvSerializationwire025_BaseApi_SkipsDeserializationForNonJSON(t *testing.T) {
	t.Parallel()
	client := &contentTypeApiClient{
		responseContentType: "text/plain",
		responseBody:        "hello plain text",
	}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://localhost").Build()
	api := {{packageName}}.NewPetApi(client, config, nil, {{packageName}}.Credentials{})
	pet, err := api.GetPetById(context.Background(), int64(1), nil)
	/* A text/plain body must NOT be handed to the JSON deserializer, and a
	 * model return type must never come back as a zero-valued model with a nil
	 * error: the SDK raises a SerializationError naming the Content-Type. */
	var serErr *apierrors.SerializationError
	if !errors.As(err, &serErr) {
		t.Fatalf("expected *SerializationError for a text/plain body on a model return, got %T: %v", err, err)
	}
	if !strings.Contains(serErr.Message(), "text/plain") {
		t.Errorf("expected the error to name text/plain, got %q", serErr.Message())
	}
	if pet != nil {
		t.Errorf("expected no model, got %+v", pet)
	}
}

func TestBhvSerializationwire005_BaseApi_DeserializesVendorJsonMimeType(t *testing.T) {
	t.Parallel()
	client := &contentTypeApiClient{
		responseContentType: "application/problem+json",
		responseBody:        `{"title":"Not Found"}`,
	}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://localhost").Build()
	api := {{packageName}}.NewPetApi(client, config, nil, {{packageName}}.Credentials{})
	_, err := api.GetPetById(context.Background(), int64(1), nil)
	/* The vendor JSON MIME type should be recognized as JSON and deserialized.
	 * If it fails, it should not be because of a content-type mismatch. */
	if err != nil {
		// Parse the raw response to verify it was valid JSON
		var parsed map[string]any
