}

// A token with a control or non-ASCII character is refused whichever it is, so
// CR/LF cannot inject a header and non-ASCII bytes are never mangled.
func TestBhvAuthbearer012_BearerAuthenticator_RejectsCrLfAndNonAscii(t *testing.T) {
	t.Parallel()
	for _, token := range []string{"tok\r\nX-Injected: yes", "t\nok", "toké"} {
		a, err := auth.NewBearerAuthenticator("https://api.example.com", token)
		if !errors.Is(err, auth.ErrInvalidBearerToken) {
			t.Errorf("token %q: expected ErrInvalidBearerToken, got %v", token, err)
		}
		if a != nil {
			t.Errorf("token %q: expected a nil authenticator", token)
		}
	}
}

// TestBhvAuthbearer028 pins that a token holding a carriage return and line feed is
// rejected when the authenticator is built, so no request is ever sent with it.
func TestBhvAuthbearer028_BearerAuthenticator_CrLfTokenIsRejectedAtConstruction(t *testing.T) {
	t.Parallel()
	a, err := auth.NewBearerAuthenticator("https://api.example.com", "tok\r\nX-Injected: yes")

	if !errors.Is(err, auth.ErrInvalidBearerToken) {
		t.Errorf("expected ErrInvalidBearerToken, got %v", err)
	}
	if a != nil {
		t.Error("expected a nil authenticator")
	}
}

// The token provider is asked again for every request, not once at construction.
func TestBhvAuthbearer014_BearerAuthenticator_TokenProviderIsCalledForEveryRequest(t *testing.T) {
	t.Parallel()
	calls := 0
	a, err := auth.NewBearerAuthenticatorWithProvider("https://api.example.com", func(context.Context) (string, error) {
		calls++
		return "tok", nil
	})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	for i := 0; i < 3; i++ {
		if _, err := a.AuthHeadersOrError(); err != nil {
			t.Fatalf("request %d: unexpected error: %v", i+1, err)
		}
	}
	if calls != 3 {
		t.Errorf("expected the provider to be asked 3 times, got %d", calls)
	}
}

