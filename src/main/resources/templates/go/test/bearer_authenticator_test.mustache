// mustBearer builds a BearerAuthenticator from a token the test knows is
// valid, failing the test if the constructor rejects it.
func mustBearer(t *testing.T, host, token string) *auth.BearerAuthenticator {
	t.Helper()
	a, err := auth.NewBearerAuthenticator(host, token)
	if err != nil {
		t.Fatalf("unexpected error from NewBearerAuthenticator: %v", err)
	}
	return a
}

func TestBearerAuthenticator_RawTokenIsPrefixedWithBearer(t *testing.T) {
	t.Parallel()
	a := mustBearer(t, "https://api.example.com", "xyz")
	headers := a.AuthHeaders()
	if got, want := headers["Authorization"], "Bearer xyz"; got != want {
		t.Fatalf("Authorization header = %q, want %q", got, want)
	}
}

func TestBearerAuthenticator_AlreadyPrefixedTokenIsNotDoubled(t *testing.T) {
	t.Parallel()
	a := mustBearer(t, "https://api.example.com", "Bearer xyz")
	headers := a.AuthHeaders()
