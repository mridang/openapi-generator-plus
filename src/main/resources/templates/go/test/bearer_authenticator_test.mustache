// The service-token wrapper is a Bearer authenticator under its own name: it
// emits the same header, refuses an empty token, and prints its own name with
// the token masked.
func TestBhvAuthbearer023_BearerAuthenticator_ServiceTokenWrapperBehavesAsBearerUnderItsOwnName(t *testing.T) {
	t.Parallel()
	a, err := auth.NewServiceTokenAuthenticator("https://api.example.com", "xyz")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got, want := a.AuthHeaders()["Authorization"], "Bearer xyz"; got != want {
		t.Errorf("Authorization header = %q, want %q", got, want)
	}
	want := `ServiceTokenAuthenticator{host: "https://api.example.com", token: ***}`
	if got := fmt.Sprint(a); got != want {
		t.Errorf("expected %q, got %q", want, got)
	}
	if _, err := auth.NewServiceTokenAuthenticator("https://api.example.com", ""); !errors.Is(err, auth.ErrInvalidBearerToken) {
		t.Errorf("expected ErrInvalidBearerToken for an empty token, got %v", err)
	}
}

// A token the provider returns is checked like a fixed token: a bad one fails
// the call with ErrInvalidBearerToken and no header is built.
func TestBhvAuthbearer002_BearerAuthenticator_AProviderResultIsValidatedLikeAFixedToken(t *testing.T) {
	t.Parallel()
	a, err := auth.NewBearerAuthenticatorWithProvider("https://api.example.com", func(context.Context) (string, error) {
		return "bad\r\nX-Injected: yes", nil
	})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if _, err := a.AuthHeadersOrError(); !errors.Is(err, auth.ErrInvalidBearerToken) {
		t.Errorf("expected ErrInvalidBearerToken for a bad provider token, got %v", err)
	}
}

// The generated scheme wrapper emits the bearer header and keeps the token out
// of its printed form.
func TestBhvAuthbearer006_BearerAuthenticator_SchemeWrapperEmitsABearerHeaderAndMasksTheToken(t *testing.T) {
	t.Parallel()
	w, err := auth.NewPetStoreBearerAuthenticator("https://api.example.com", "super-secret-token")
	if err != nil {
		t.Fatalf("NewPetStoreBearerAuthenticator failed: %v", err)
	}
	if got, want := w.AuthHeaders()["Authorization"], "Bearer super-secret-token"; got != want {
