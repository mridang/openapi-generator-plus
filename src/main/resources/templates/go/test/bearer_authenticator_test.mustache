// bearer-no-empty-token-guard: an empty or whitespace-only Bearer token would
// emit the literal `Authorization: Bearer ` header and send the request
// unauthenticated. RFC 7230 §3.2.6 — Bearer tokens commonly arrive with
// trailing newlines from .env / file reads; CRLF would inject the
// Authorization header, and non-ASCII bytes are silently mangled per HTTP lib.
// The constructor returns ErrInvalidBearerToken for all of them, never panics.
func TestBearerAuthenticator_RejectsInvalidToken(t *testing.T) {
	t.Parallel()
	for _, bad := range []string{"", "   ", "\t", "tok\r\nInjected: yes", "ñoño"} {
		a, err := auth.NewBearerAuthenticator("https://api.example.com", bad)
		if !errors.Is(err, auth.ErrInvalidBearerToken) {
			t.Errorf("expected ErrInvalidBearerToken for %q, got %v", bad, err)
		}
		if a != nil {
			t.Errorf("expected a nil authenticator for %q", bad)
		}
	}
}

// authenticator-secret-in-default-string-repr: the bearer token must not leak
// through the default string/format representation.
func TestBearerAuthenticator_RedactsSecret(t *testing.T) {
	t.Parallel()
	a := mustBearer(t, "https://api.example.com", "super-secret-token")
	for _, s := range []string{a.String(), fmt.Sprintf("%v", a), fmt.Sprintf("%+v", a)} {
		if strings.Contains(s, "super-secret-token") {
			t.Errorf("expected token to be redacted, got %q", s)
		}
		if !strings.Contains(s, "***") {
			t.Errorf("expected redaction marker '***', got %q", s)
		}
	}
}
