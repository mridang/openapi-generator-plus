// Only a network error is retried: not a cancellation, not a closed client and
// not an error that is not a network error.
func TestBhvRetries013_DefaultApiClientUnit_IsRetryableTransportError_IsTheNetworkErrors(t *testing.T) {
	t.Parallel()
	cause := errors.New("connection reset")
	cases := []struct {
		name string
		err  error
		want bool
	}{
		{"network error", pkgerrors.NewNetworkError("request failed", cause), true},
		{"timeout error", pkgerrors.NewNetworkTimeoutError("request timed out", cause), false},
		{"cancellation", fmt.Errorf("request cancelled: %w", context.Canceled), false},
		{"closed client", ErrClientClosed, false},
		{"invalid request", fmt.Errorf("%w: bad", ErrInvalidRequest), false},
	}
	for _, tc := range cases {
		if got := isRetryableTransportError(tc.err); got != tc.want {
			t.Errorf("%s: expected %t, got %t", tc.name, tc.want, got)
		}
	}
}

func TestBhvRetries042_DefaultApiClientUnit_ATimeoutIsNotRetried(t *testing.T) {
	t.Parallel()
	release := make(chan struct{})
	hits := make(chan struct{}, 8)
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		hits <- struct{}{}
		<-release
	}))
	defer server.Close()
	defer close(release)

	timeout := 100
	transport, err := NewTransportOptionsBuilder().Timeout(&timeout).Build()
	if err != nil {
		t.Fatal(err)
	}
	client := NewDefaultApiClient(transport)
	_, err = client.SendRequest("GET", server.URL+"/slow", map[string]string{}, nil)
	var timeoutErr *pkgerrors.NetworkTimeoutError
	if !errors.As(err, &timeoutErr) {
		t.Fatalf("expected *NetworkTimeoutError, got %T: %v", err, err)
	}
	if got := len(hits); got != 1 {
		t.Errorf("expected the timed-out request to be sent once, got %d attempts", got)
	}
}

// closeRecordingReader is a caller-supplied stream that counts its Close calls.
type closeRecordingReader struct {
	*bytes.Reader
	closed bool
}

func (r *closeRecordingReader) Close() error {
	r.closed = true
	return nil
}

func TestBhvTransport061_DefaultApiClientUnit_CallerSuppliedStreamIsLeftOpenAfterTheBodyIsSent(t *testing.T) {
	t.Parallel()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		_, _ = io.ReadAll(r.Body)
		w.WriteHeader(200)
	}))
	defer server.Close()

	stream := &closeRecordingReader{Reader: bytes.NewReader([]byte("payload"))}
	client := NewDefaultApiClient(nil)
	if _, err := client.SendRequest("POST", server.URL+"/upload", map[string]string{}, map[string]any{"file": stream}); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if stream.closed {
		t.Error("expected the caller-supplied stream to stay open after the body was sent")
	}
}

func TestBhvSerializationwire030_DefaultApiClientUnit_DecodesBigEndianBomUtf16AsBigEndian(t *testing.T) {
	t.Parallel()
	/* A big-endian byte-order mark (FE FF) selects big-endian; "Tag" follows. */
	body := []byte{0xFE, 0xFF, 0x00, 0x54, 0x00, 0x61, 0x00, 0x67}
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/plain; charset=utf-16")
		w.WriteHeader(200)
		_, _ = w.Write(body)
	}))
	defer server.Close()

	client := NewDefaultApiClient(nil)
	resp, err := client.SendRequest("GET", server.URL+"/utf16-be-bom", map[string]string{}, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp.Body != "Tag" {
		t.Errorf("expected a big-endian BOM body to decode to \"Tag\", got %q", resp.Body)
	}
}

func TestBhvSerializationwire032_DefaultApiClientUnit_DecodesIso88591ToUtf8WhenCharsetIsDeclaredInLowercase(t *testing.T) {
	t.Parallel()
	/* "Café" in ISO-8859-1: the lower-case charset label must still select the decoder. */
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/plain; charset=iso-8859-1")
		w.WriteHeader(200)
		_, _ = w.Write([]byte{'C', 'a', 'f', 0xE9})
	}))
	defer server.Close()

	client := NewDefaultApiClient(nil)
	resp, err := client.SendRequest("GET", server.URL+"/latin1-lower", map[string]string{}, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp.Body != "Café" {
		t.Errorf("expected the ISO-8859-1 body to decode to UTF-8 \"Café\", got %q", resp.Body)
	}
}

// multipartWireStamp is a model whose Go field names differ from their wire names.
type multipartWireStamp struct {
	Label    string          `json:"label"`
	FullName string          `json:"full_name"`
	Moment   models.DateTime `json:"moment"`
}

func TestBhvSerializationwire045_DefaultApiClientUnit_MultipartModelPartUsesWirePropertyNamesAndDateTimeFormat(t *testing.T) {
	t.Parallel()
	boundary := "test-boundary-model"
	body, err := buildMultipartBody(map[string]any{
		"stamp": multipartWireStamp{
			Label:    "x",
			FullName: "y",
			Moment:   models.DateTime(time.Date(2024, 1, 15, 10, 30, 0, 0, time.UTC)),
		},
	}, boundary)
	if err != nil {
		t.Fatalf("buildMultipartBody failed: %v", err)
	}
	mr := multipart.NewReader(strings.NewReader(string(body)), boundary)
	part, err := mr.NextPart()
	if err != nil {
		t.Fatalf("reading multipart part failed: %v", err)
	}
	content, _ := io.ReadAll(part)
	want := `{"label":"x","full_name":"y","moment":"2024-01-15T10:30:00.000+00:00"}`
	if string(content) != want {
		t.Errorf("expected the model part %s, got %s", want, string(content))
	}
}

func TestBhvSerializationwire047_DefaultApiClientUnit_MultipartPngFileGetsImagePngContentType(t *testing.T) {
	t.Parallel()
	var wireBody string
