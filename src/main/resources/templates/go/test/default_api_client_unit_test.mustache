func TestDefaultApiClient_InjectsCustomUserAgent(t *testing.T) {
	t.Parallel()
	var receivedUA string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		receivedUA = r.Header.Get("User-Agent")
		w.WriteHeader(200)
	}))
	defer server.Close()

	customAgent := "TestAgent/1.0"
	transport, buildErr := NewTransportOptionsBuilder().
		UserAgent(&customAgent).
		Build()
	if buildErr != nil {
		t.Fatal(buildErr)
	}
	client := NewDefaultApiClient(transport)

	_, err := client.SendRequest("GET", server.URL+"/test", map[string]string{}, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if receivedUA != "TestAgent/1.0" {
		t.Errorf("expected User-Agent 'TestAgent/1.0', got %q", receivedUA)
	}
}

