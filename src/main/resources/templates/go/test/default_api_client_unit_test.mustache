// A Retry-After in seconds or as an HTTP date is honoured, capped at 60 seconds,
// and an unusable one is ignored.
func TestBhvRetries023_DefaultApiClientUnit_RetryAfterDelay_ReadsSecondsAndDatesAndCapsAtAMinute(t *testing.T) {
	t.Parallel()
	now := time.Date(2030, 1, 2, 3, 4, 5, 0, time.UTC)
	cases := []struct {
		name   string
		header string
		want   time.Duration
		ok     bool
	}{
		{"seconds", "7", 7 * time.Second, true},
		{"zero", "0", 0, true},
		{"spaces are trimmed", " 3 ", 3 * time.Second, true},
		{"seconds beyond a minute are capped", "3600", 60 * time.Second, true},
		{"a date", now.Add(5 * time.Second).Format(http.TimeFormat), 5 * time.Second, true},
		{"a date in the past waits nothing", now.Add(-time.Hour).Format(http.TimeFormat), 0, true},
		{"a date beyond a minute is capped", now.Add(time.Hour).Format(http.TimeFormat), 60 * time.Second, true},
		{"negative is ignored", "-5", 0, false},
		{"NaN is ignored", "NaN", 0, false},
		{"text is ignored", "soon", 0, false},
		{"empty is ignored", "", 0, false},
	}
	for _, tc := range cases {
		got, ok := retryAfterDelay(map[string]string{"retry-after": tc.header}, now)
		if ok != tc.ok || got != tc.want {
			t.Errorf("%s: expected %v, %t, got %v, %t", tc.name, tc.want, tc.ok, got, ok)
		}
	}
	if _, ok := retryAfterDelay(map[string]string{"Retry-After": "1"}, now); !ok {
		t.Error("expected the header name to be matched case-insensitively")
	}
	if _, ok := retryAfterDelay(nil, now); ok {
		t.Error("expected no delay without headers")
	}
}

// A Retry-After that cannot be read is ignored, so the wait is the first backoff step.
func TestBhvRetries029_DefaultApiClientUnit_UnreadableRetryAfterFallsBackToTheBackoff(t *testing.T) {
