func scheme{{className}}RejectsAnEmptyKey(t *testing.T) {
	for _, variable := range scheme{{className}}Variables {
		setSchemeEnvironment(t, scheme{{className}}Variables, scheme{{className}}Fields, variable, "unset")

		a, err := {{package}}.New{{className}}(schemeHost{{#envVars}}, ""{{/envVars}})
		if err == nil {
			t.Errorf("expected an empty key to be refused at construction for %s", variable)
		}
		if a != nil {
			t.Error("expected no authenticator")
		}
	}
}
