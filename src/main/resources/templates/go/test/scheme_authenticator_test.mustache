func Test{{#firstBasic}}BhvAuthbasic003_{{/firstBasic}}{{#failsId}}{{.}}{{/failsId}}SchemeAuthenticator_{{className}}_FailsNamingAVariableThatIsEmptyOrUnset(t *testing.T) {
	for i, variable := range scheme{{className}}Variables {
		for _, mode := range []string{"empty", "unset"} {
			t.Run(scheme{{className}}Fields[i]+"/"+mode, func(t *testing.T) {
				setSchemeEnvironment(t, scheme{{className}}Variables, scheme{{className}}Fields, variable, mode)

				a, err := {{package}}.New{{className}}(schemeHost{{#envVars}}, ""{{/envVars}})

				requireMissingCredential(t, err, variable)
				if a != nil {
					t.Error("expected no authenticator")
				}
{{#isBearer}}
				if !errors.Is(err, auth.ErrInvalidBearerToken) {
					t.Errorf("expected a missing token to match ErrInvalidBearerToken, got %v", err)
				}
{{/isBearer}}
			})
		}
	}
}
