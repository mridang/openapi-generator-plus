func TestSchemeAuthenticator_{{className}}_WithProviderRejectsANilProvider(t *testing.T) {
	a, err := {{package}}.New{{className}}WithProvider(schemeHost, nil)

	if !errors.Is(err, auth.ErrInvalidBearerToken) {
		t.Errorf("expected ErrInvalidBearerToken, got %v", err)
	}
	if a != nil {
		t.Error("expected no authenticator")
	}
}
