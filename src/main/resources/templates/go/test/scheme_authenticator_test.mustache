func TestBhvAuthscheme002_SchemeAuthenticator_{{className}}_WithProviderAsksTheProviderAndReadsNoVariable(t *testing.T) {
	setSchemeEnvironment(t, scheme{{className}}Variables, scheme{{className}}Fields, "", "")

	a, err := {{package}}.New{{className}}WithProvider(schemeHost, schemeTokenFrom("provider-token"))
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	if got, want := a.AuthHeaders()["Authorization"], "Bearer provider-token"; got != want {
		t.Errorf("expected %q, got %q", want, got)
	}
}

func Test{{#firstBearer}}BhvLifecycle025_{{/firstBearer}}SchemeAuthenticator_{{className}}_ReadsTheEnvironmentOnceWhenItIsBuilt(t *testing.T) {
	setSchemeEnvironment(t, scheme{{className}}Variables, scheme{{className}}Fields, "", "")

	a, err := {{package}}.New{{className}}(schemeHost{{#envVars}}, ""{{/envVars}})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	t.Setenv(scheme{{className}}Variables[0], "changed-after-build")

	requireScheme{{className}}Credentials(t, a, schemeEnvValue)
