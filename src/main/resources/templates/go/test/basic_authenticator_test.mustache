// mustBasic builds a BasicAuthenticator from credentials the test knows are
// valid, failing the test if the constructor rejects them.
func mustBasic(t *testing.T, host, username, password string) *auth.BasicAuthenticator {
	t.Helper()
	a, err := auth.NewBasicAuthenticator(host, username, password)
	if err != nil {
		t.Fatalf("unexpected error from NewBasicAuthenticator: %v", err)
	}
	return a
}

func TestBhvAuthbasic011_BasicAuthenticator_ValidCredentialsProduceBasicHeader(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	headers := a.AuthHeaders()
	if got, want := headers["Authorization"], "Basic YWxpY2U6czNjcmV0"; got != want {
		t.Fatalf("Authorization header = %q, want %q", got, want)
	}
}

// Malformed credentials are a caller mistake: the constructor returns the
// matching sentinel, never panics, and the error is not a {{errorPrefix}}Error.
func requireBasicRejected(t *testing.T, username, password string, want error) {
	t.Helper()
	a, err := auth.NewBasicAuthenticator("https://api.example.com", username, password)
	if !errors.Is(err, want) {
		t.Errorf("NewBasicAuthenticator(%q, %q): expected %v, got %v", username, password, want, err)
	}
	if a != nil {
		t.Errorf("NewBasicAuthenticator(%q, %q): expected a nil authenticator", username, password)
	}
	var root apierrors.{{errorPrefix}}Error
	if errors.As(err, &root) {
		t.Errorf("a caller mistake must not be a {{errorPrefix}}Error, got %T", err)
	}
}

func TestBhvAuthbasic009_BasicAuthenticator_RejectsUsernameWithCrlfAtConstruction(t *testing.T) {
	t.Parallel()
	requireBasicRejected(t, "alice\r\n", "s3cret", auth.ErrBasicAuthUsernameControlChar)
}

func TestBhvAuthbasic007_BasicAuthenticator_RejectsPasswordWithNulAtConstruction(t *testing.T) {
	t.Parallel()
	requireBasicRejected(t, "alice", "s3c\x00ret", auth.ErrBasicAuthPasswordControlChar)
}

func TestBhvAuthbasic008_BasicAuthenticator_RejectsUsernameWithColonAtConstruction(t *testing.T) {
	t.Parallel()
	requireBasicRejected(t, "ali:ce", "s3cret", auth.ErrBasicAuthUsernameColon)
}

func TestBhvAuthbasic006_BasicAuthenticator_RedactsSecret(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	for _, s := range []string{a.String(), fmt.Sprintf("%v", a), fmt.Sprintf("%+v", a), fmt.Sprintf("%#v", a), fmt.Sprintf("%v", *a), fmt.Sprintf("%+v", *a), fmt.Sprintf("%#v", *a)} {
		if strings.Contains(s, "s3cret") {
			t.Errorf("expected password to be redacted, got %q", s)
		}
		if !strings.Contains(s, "***") {
			t.Errorf("expected redaction marker '***', got %q", s)
		}
	}
}

// Credentials are encoded as UTF-8 before the base64 step (RFC 7617 §2.1), so a
// non-ASCII pair yields the same header in every SDK.
func TestBhvAuthbasic004_BasicAuthenticator_NonAsciiCredentialsAreEncodedAsUtf8(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "ünïcødé", "pässwörd")
	headers := a.AuthHeaders()
	if got, want := headers["Authorization"], "Basic w7xuw69jw7hkw6k6cMOkc3N3w7ZyZA=="; got != want {
		t.Fatalf("Authorization header = %q, want %q", got, want)
	}
}

// The password is masked in every default string form, including the value form.
func TestBhvAuthbasic005_BasicAuthenticator_PasswordIsNotLeakedInDefaultToString(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")

	for _, s := range []string{a.String(), fmt.Sprint(a), fmt.Sprint(*a)} {
		if strings.Contains(s, "s3cret") {
			t.Errorf("expected the password not to appear in the default string form, got %q", s)
		}
	}
}

// The printed form shows the non-secret fields, host and username, and masks
// only the password.
func TestBhvAuthbasic010_BasicAuthenticator_ReprShowsTheNonSecretFields(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	want := `BasicAuthenticator{host: "https://api.example.com", username: "alice", password: ***}`
	if got := a.String(); got != want {
		t.Errorf("expected %q, got %q", want, got)
	}
}

// Each per-scheme wrapper is a Basic authenticator under its own name: it emits
// the same Authorization header, refuses the same malformed credentials, and
// prints its own name with the password masked.
func TestBhvAuthbasic002_BasicAuthenticator_BasicWrappers_EmitTheBasicHeaderUnderTheirOwnName(t *testing.T) {
	t.Parallel()
	const host = "https://api.example.com"
	type wrapper interface {
		AuthHeaders() map[string]string
	}
	cases := []struct {
		name  string
		build func(username, password string) (wrapper, error)
	}{
		{"PetStoreBasicAuthenticator", func(u, p string) (wrapper, error) { return auth.NewPetStoreBasicAuthenticator(host, u, p) }},
		{"AdminBasicAuthenticator", func(u, p string) (wrapper, error) { return auth.NewAdminBasicAuthenticator(host, u, p) }},
	}
	for _, tc := range cases {
		a, err := tc.build("alice", "s3cret")
		if err != nil {
			t.Errorf("%s: unexpected error: %v", tc.name, err)
			continue
		}
		if got, want := a.AuthHeaders()["Authorization"], "Basic YWxpY2U6czNjcmV0"; got != want {
			t.Errorf("%s: Authorization header = %q, want %q", tc.name, got, want)
		}
		want := tc.name + `{host: "https://api.example.com", username: "alice", password: ***}`
		if got := fmt.Sprint(a); got != want {
			t.Errorf("%s: expected %q, got %q", tc.name, want, got)
		}
		if _, err := tc.build("ali:ce", "s3cret"); !errors.Is(err, auth.ErrBasicAuthUsernameColon) {
			t.Errorf("%s: expected ErrBasicAuthUsernameColon, got %v", tc.name, err)
		}
	}
}

// A colon is allowed in the password; only the username is forbidden from carrying one.
func TestBhvAuthbasic018_BasicAuthenticator_PasswordMayContainAColon(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "pass:word")
	want := "Basic " + base64.StdEncoding.EncodeToString([]byte("alice:pass:word"))
	if got := a.AuthHeaders()["Authorization"]; got != want {
		t.Fatalf("Authorization header = %q, want %q", got, want)
	}
}

// The password is masked in every debug form of the authenticator, including when it is nested in another value.
func TestBhvAuthbasic020_BasicAuthenticator_PasswordIsMaskedInEveryDebugForm(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	holder := struct{ Auth *auth.BasicAuthenticator }{a}
	for _, v := range []interface{}{a, *a, holder, []*auth.BasicAuthenticator{a}} {
		for _, s := range []string{fmt.Sprint(v), fmt.Sprintf("%+v", v), fmt.Sprintf("%#v", v)} {
			if strings.Contains(s, "s3cret") {
				t.Errorf("expected the password to be masked, got %q", s)
			}
		}
	}
}

func TestBhvErrors081_BasicAuthenticator_RefusalNamesTheFaultyField(t *testing.T) {
	t.Parallel()
	_, userErr := auth.NewBasicAuthenticator("https://api.example.com", "bad:user", "secret")
	if userErr == nil || !strings.Contains(userErr.Error(), "username") || strings.Contains(userErr.Error(), "password") {
		t.Errorf("expected a refusal naming the username only, got %v", userErr)
	}
	_, passErr := auth.NewBasicAuthenticator("https://api.example.com", "user", "pass\nword")
	if passErr == nil || !strings.Contains(passErr.Error(), "password") || strings.Contains(passErr.Error(), "username") {
		t.Errorf("expected a refusal naming the password only, got %v", passErr)
	}
}


// The username of a Basic authenticator may not contain a colon (RFC 7617 section 2).
func TestBhvAuth036_BasicAuthenticator_RefusesAUsernameWithAColon(t *testing.T) {
	t.Parallel()
	a, err := auth.NewBasicAuthenticator("https://api.example.com", "user:name", "secret")
	if !errors.Is(err, auth.ErrBasicAuthUsernameColon) || a != nil {
		t.Errorf("expected ErrBasicAuthUsernameColon and no authenticator, got %v %v", a, err)
	}
}
