package {{packageName}}_test

import (
	"errors"
	"fmt"
	"strings"
	"testing"

	"{{packageName}}/pkg/auth"
	apierrors "{{packageName}}/pkg/errors"
)

// mustBasic builds a BasicAuthenticator from credentials the test knows are
// valid, failing the test if the constructor rejects them.
func mustBasic(t *testing.T, host, username, password string) *auth.BasicAuthenticator {
	t.Helper()
	a, err := auth.NewBasicAuthenticator(host, username, password)
	if err != nil {
		t.Fatalf("unexpected error from NewBasicAuthenticator: %v", err)
	}
	return a
}

func TestBasicAuthenticator_ValidCredentialsProduceBasicHeader(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	headers := a.AuthHeaders()
	if got, want := headers["Authorization"], "Basic YWxpY2U6czNjcmV0"; got != want {
		t.Fatalf("Authorization header = %q, want %q", got, want)
	}
}

// Malformed credentials are a caller mistake: the constructor returns the
// matching sentinel, never panics, and the error is not a {{errorPrefix}}Error.
func TestBasicAuthenticator_RejectsMalformedCredentials(t *testing.T) {
	t.Parallel()
	cases := []struct {
		username, password string
		want               error
	}{
		{"alice\r\n", "s3cret", auth.ErrBasicAuthUsernameControlChar},
		{"alice", "s3c\x00ret", auth.ErrBasicAuthPasswordControlChar},
		{"ali:ce", "s3cret", auth.ErrBasicAuthUsernameColon},
	}
	for _, c := range cases {
		a, err := auth.NewBasicAuthenticator("https://api.example.com", c.username, c.password)
		if !errors.Is(err, c.want) {
			t.Errorf("NewBasicAuthenticator(%q, %q): expected %v, got %v", c.username, c.password, c.want, err)
		}
		if a != nil {
			t.Errorf("NewBasicAuthenticator(%q, %q): expected a nil authenticator", c.username, c.password)
		}
		var root apierrors.{{errorPrefix}}Error
		if errors.As(err, &root) {
			t.Errorf("a caller mistake must not be a {{errorPrefix}}Error, got %T", err)
		}
	}
}

func TestBasicRedactsSecret(t *testing.T) {
	t.Parallel()
	a := mustBasic(t, "https://api.example.com", "alice", "s3cret")
	for _, s := range []string{a.String(), fmt.Sprintf("%v", a), fmt.Sprintf("%+v", a)} {
		if strings.Contains(s, "s3cret") {
			t.Errorf("expected password to be redacted, got %q", s)
		}
		if !strings.Contains(s, "***") {
			t.Errorf("expected redaction marker '***', got %q", s)
		}
	}
}
