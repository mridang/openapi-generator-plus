package {{packageName}}_test

import (
	"strings"
	"sync/atomic"
	"testing"

	"{{packageName}}/pkg/auth"
	"{{packageName}}/pkg/auth/oauth"
)

// fakeOIDCClient implements auth.ApiClient for OpenID Connect tests.
type fakeOIDCClient struct {
	responses  []fakeOIDCResponse
	index      int32
	LastBody   string
	LastURL    string
	LastMethod string
}

type fakeOIDCResponse struct {
	body       string
	statusCode int
}

func (c *fakeOIDCClient) SendRequest(method, url string, headers map[string]string, body interface{}) (*auth.HttpResponse, error) {
	c.LastMethod = method
	c.LastURL = url
	if body != nil {
		if b, ok := body.([]byte); ok {
			c.LastBody = string(b)
		}
	}
	idx := atomic.AddInt32(&c.index, 1) - 1
	resp := c.responses[idx]
	return &auth.HttpResponse{
		StatusCode: resp.statusCode,
		Body:       resp.body,
		Headers:    map[string]string{},
	}, nil
}

func createOpenIdConnectAuthenticator() *oauth.OpenIdConnectAuthenticator {
	return oauth.NewOpenIdConnectAuthenticator(
		"https://api.example.com",
		"https://auth.example.com/.well-known/openid-configuration",
		"my-client-id",
		"my-client-secret",
		"https://app.example.com/callback",
		[]string{"openid", "profile"},
	)
}

func TestOpenIdConnect_BuildsAuthorizationUrlFromDiscovery(t *testing.T) {
	client := &fakeOIDCClient{
		responses: []fakeOIDCResponse{
			{body: `{"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}`, statusCode: 200},
		},
	}

	authObj := createOpenIdConnectAuthenticator()
	authObj.SetApiClient(client)

	url, err := authObj.BuildAuthorizationURL("my-state")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	if !strings.HasPrefix(url, "https://auth.example.com/authorize?") {
		t.Errorf("expected URL to start with authorization endpoint, got %q", url)
	}
	if !strings.Contains(url, "response_type=code") {
		t.Error("expected URL to contain response_type=code")
	}
	if !strings.Contains(url, "client_id=my-client-id") {
		t.Error("expected URL to contain client_id=my-client-id")
	}
	if !strings.Contains(url, "state=my-state") {
		t.Error("expected URL to contain state=my-state")
	}
}

func TestOpenIdConnect_FetchesDiscoveryDocument(t *testing.T) {
	client := &fakeOIDCClient{
		responses: []fakeOIDCResponse{
			{body: `{"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}`, statusCode: 200},
		},
	}

	authObj := createOpenIdConnectAuthenticator()
	authObj.SetApiClient(client)

	_, err := authObj.BuildAuthorizationURL("")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	if client.LastMethod != "GET" {
		t.Errorf("expected GET method for discovery, got %q", client.LastMethod)
	}
	if client.LastURL != "https://auth.example.com/.well-known/openid-configuration" {
		t.Errorf("expected discovery URL, got %q", client.LastURL)
	}
}

func TestOpenIdConnect_ObtainsTokenAfterCodeExchange(t *testing.T) {
	client := &fakeOIDCClient{
		responses: []fakeOIDCResponse{
			// Discovery document
			{body: `{"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}`, statusCode: 200},
			// Token response
			{body: `{"access_token":"oidc-tok","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createOpenIdConnectAuthenticator()
	authObj.SetApiClient(client)

	err := authObj.ExchangeCode("oidc-code")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	if !strings.Contains(client.LastBody, "grant_type=authorization_code") {
		t.Errorf("expected body to contain grant_type=authorization_code, got %q", client.LastBody)
	}
	if !strings.Contains(client.LastBody, "code=oidc-code") {
		t.Errorf("expected body to contain code=oidc-code, got %q", client.LastBody)
	}
}

func TestOpenIdConnect_GetAuthHeadersReturnsBearerAfterExchange(t *testing.T) {
	client := &fakeOIDCClient{
		responses: []fakeOIDCResponse{
			// Discovery document
			{body: `{"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}`, statusCode: 200},
			// Token response for ExchangeCode
			{body: `{"access_token":"oidc-tok","expires_in":3600}`, statusCode: 200},
			// Token response for AuthHeaders refresh
			{body: `{"access_token":"oidc-tok","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createOpenIdConnectAuthenticator()
	authObj.SetApiClient(client)

	err := authObj.ExchangeCode("oidc-code")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	headers := authObj.AuthHeaders()

	if headers["Authorization"] != "Bearer oidc-tok" {
		t.Errorf("expected Authorization 'Bearer oidc-tok', got %q", headers["Authorization"])
	}
}

func TestOpenIdConnect_ThrowsWhenNoApiClientInjected(t *testing.T) {
	authObj := createOpenIdConnectAuthenticator()

	_, err := authObj.BuildAuthorizationURL("")
	if err == nil {
		t.Fatal("expected error when no API client injected, got nil")
	}
}

func TestOpenIdConnect_GetHostReturnsConfiguredHost(t *testing.T) {
	authObj := createOpenIdConnectAuthenticator()

	if authObj.Host() != "https://api.example.com" {
		t.Errorf("expected host 'https://api.example.com', got %q", authObj.Host())
	}
}
