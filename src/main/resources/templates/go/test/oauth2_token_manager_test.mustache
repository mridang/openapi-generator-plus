package {{packageName}}_test

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"sync/atomic"
	"testing"

	"{{packageName}}/pkg/auth"
	"{{packageName}}/pkg/auth/oauth"
)

// fakeTokenClient implements auth.ApiClient for token manager tests.
type fakeTokenClient struct {
	responses []fakeResponse
	index     int32
	LastBody  string
	LastURL   string
}

type fakeResponse struct {
	body       string
	statusCode int
}

func (c *fakeTokenClient) SendRequest(method, url string, headers map[string]string, body []byte) (*auth.HttpResponse, error) {
	c.LastURL = url
	if body != nil {
		c.LastBody = string(body)
	}
	idx := atomic.AddInt32(&c.index, 1) - 1
	resp := c.responses[idx]
	return &auth.HttpResponse{
		StatusCode: resp.statusCode,
		Body:       resp.body,
		Headers:    map[string]string{},
	}, nil
}

func newFakeTokenClient(responses ...fakeResponse) *fakeTokenClient {
	return &fakeTokenClient{responses: responses}
}

func TestOAuth2TokenManager_ExtractsAccessTokenFromResponse(t *testing.T) {
	client := newFakeTokenClient(fakeResponse{
		body:       `{"access_token":"tok123","expires_in":3600}`,
		statusCode: 200,
	})

	manager := oauth.NewOAuth2TokenManager()
	manager.SetApiClient(client)

	token, err := manager.GetAccessToken("https://auth.example.com/token", map[string]string{
		"grant_type": "client_credentials",
	})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if token != "tok123" {
		t.Errorf("expected token 'tok123', got %q", token)
	}
}

func TestOAuth2TokenManager_StoresRefreshToken(t *testing.T) {
	client := newFakeTokenClient(fakeResponse{
		body:       `{"access_token":"tok1","refresh_token":"ref1","expires_in":3600}`,
		statusCode: 200,
	})

	manager := oauth.NewOAuth2TokenManager()
	manager.SetApiClient(client)

	_, err := manager.GetAccessToken("https://auth.example.com/token", map[string]string{
		"grant_type": "authorization_code",
	})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if manager.RefreshToken() != "ref1" {
		t.Errorf("expected refresh token 'ref1', got %q", manager.RefreshToken())
	}
}

func TestOAuth2TokenManager_ReturnsCachedTokenWhenNotExpired(t *testing.T) {
	callCount := int32(0)
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		atomic.AddInt32(&callCount, 1)
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"access_token": "tok1",
			"expires_in":   3600,
		})
	}))
	defer server.Close()

	client := newFakeTokenClient(fakeResponse{
		body:       `{"access_token":"tok1","expires_in":3600}`,
		statusCode: 200,
	})

	manager := oauth.NewOAuth2TokenManager()
	manager.SetApiClient(client)

	params := map[string]string{"grant_type": "client_credentials"}
	first, err := manager.GetAccessToken("https://auth.example.com/token", params)
	if err != nil {
		t.Fatalf("unexpected error on first call: %v", err)
	}
	second, err := manager.GetAccessToken("https://auth.example.com/token", params)
	if err != nil {
		t.Fatalf("unexpected error on second call: %v", err)
	}

	if first != "tok1" {
		t.Errorf("expected first token 'tok1', got %q", first)
	}
	if second != "tok1" {
		t.Errorf("expected second token 'tok1', got %q", second)
	}
	// Only one HTTP call should have been made (index should be 1)
	if atomic.LoadInt32(&client.index) != 1 {
		t.Errorf("expected 1 HTTP call, got %d", atomic.LoadInt32(&client.index))
	}
}

func TestOAuth2TokenManager_RefetchesTokenWhenExpired(t *testing.T) {
	client := newFakeTokenClient(
		fakeResponse{body: `{"access_token":"tok1","expires_in":1}`, statusCode: 200},
		fakeResponse{body: `{"access_token":"tok2","expires_in":3600}`, statusCode: 200},
	)

	manager := oauth.NewOAuth2TokenManager()
	manager.SetApiClient(client)

	params := map[string]string{"grant_type": "client_credentials"}

	first, err := manager.GetAccessToken("https://auth.example.com/token", params)
	if err != nil {
		t.Fatalf("unexpected error on first call: %v", err)
	}
	// Token with expires_in=1 minus 30s buffer is already expired
	second, err := manager.GetAccessToken("https://auth.example.com/token", params)
	if err != nil {
		t.Fatalf("unexpected error on second call: %v", err)
	}

	if first != "tok1" {
		t.Errorf("expected first token 'tok1', got %q", first)
	}
	if second != "tok2" {
		t.Errorf("expected second token 'tok2', got %q", second)
	}
}

func TestOAuth2TokenManager_SetAccessTokenBypassesEndpoint(t *testing.T) {
	manager := oauth.NewOAuth2TokenManager()
	manager.SetAccessToken("manual-token")

	// No API client needed since token is set manually
	token, err := manager.GetAccessToken("https://auth.example.com/token", map[string]string{})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if token != "manual-token" {
		t.Errorf("expected token 'manual-token', got %q", token)
	}
}

func TestOAuth2TokenManager_ErrorsWhenNoApiClientInjected(t *testing.T) {
	manager := oauth.NewOAuth2TokenManager()

	_, err := manager.GetAccessToken("https://auth.example.com/token", map[string]string{
		"grant_type": "client_credentials",
	})
	if err == nil {
		t.Fatal("expected error when no API client injected, got nil")
	}
}
