	}
}

// F1078: Close is graceful. A request already in flight finishes with its
// response, a request sent afterwards fails with ErrClientClosed, and closing
// twice is harmless.
func TestDefaultApiClient_CloseLetsTheRequestsInFlightFinish(t *testing.T) {
	t.Parallel()
	started := make(chan struct{})
	release := make(chan struct{})
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		close(started)
		<-release
		w.WriteHeader(200)
		_, _ = w.Write([]byte("done"))
	}))
	defer server.Close()
	client := NewDefaultApiClient(nil)
	type outcome struct {
		resp *ApiHttpResponse
		err  error
	}
	done := make(chan outcome, 1)
	go func() {
		resp, err := client.SendRequest("GET", server.URL, map[string]string{}, nil)
		done <- outcome{resp, err}
	}()
	<-started

	if err := client.Close(); err != nil {
		t.Fatalf("unexpected error from Close: %v", err)
	}
	if err := client.Close(); err != nil {
		t.Fatalf("unexpected error from the second Close: %v", err)
	}
	if _, err := client.SendRequest("GET", server.URL, map[string]string{}, nil); !errors.Is(err, ErrClientClosed) {
		t.Errorf("expected ErrClientClosed for a request sent after Close, got %v", err)
	}
	close(release)

	got := <-done
	if got.err != nil {
		t.Fatalf("expected the request in flight to finish, got %v", got.err)
	}
	if got.resp.StatusCode != 200 || got.resp.Body != "done" {
		t.Errorf("expected the full response, got %d %q", got.resp.StatusCode, got.resp.Body)
	}
}

// Close releases only a transport the SDK created: one the caller supplied is
// still usable through the caller's own handle afterwards.
func TestDefaultApiClient_CloseNeverClosesACallerSuppliedClient(t *testing.T) {
	t.Parallel()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
	defer server.Close()
	own := &http.Client{}
	transport, err := NewTransportOptionsBuilder().HttpClient(own).Build()
	if err != nil {
		t.Fatal(err)
	}
	client := NewDefaultApiClient(transport)

	_ = client.Close()

	resp, err := own.Get(server.URL)
	if err != nil {
		t.Fatalf("expected the caller's client to keep working, got %v", err)
	}
	_ = resp.Body.Close()
}

func TestDefaultApiClient_AnAlreadyCancelledContextSendsNothing(t *testing.T) {
	t.Parallel()
	var hits int
	var mu sync.Mutex
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		mu.Lock()
		hits++
		mu.Unlock()
		w.WriteHeader(200)
	}))
	defer server.Close()
	client := NewDefaultApiClient(nil)
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	_, err := client.SendRequestWithOptions("GET", server.URL, map[string]string{}, nil, &RequestOptions{Context: ctx})
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("expected context.Canceled, got %T: %v", err, err)
	}
	mu.Lock()
	defer mu.Unlock()
	if hits != 0 {
		t.Errorf("expected no request on the wire, got %d", hits)
	}
}

type recordingRoundTripper struct {
	mu       sync.Mutex
	requests []*http.Request
	inner    http.RoundTripper
}

func (r *recordingRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	r.mu.Lock()
	r.requests = append(r.requests, req)
	r.mu.Unlock()
	return r.inner.RoundTrip(req)
}

type closeTrackingTransport struct {
	recordingRoundTripper
	closed bool
}

func (c *closeTrackingTransport) CloseIdleConnections() { c.closed = true }

func TestBhvTransport040_DefaultApiClient_CustomRoundTripperReceivesTheRequestWithSdkDefaults(t *testing.T) {
	t.Parallel()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) }))
	defer server.Close()
	recorder := &closeTrackingTransport{recordingRoundTripper: recordingRoundTripper{inner: http.DefaultTransport.(*http.Transport).Clone()}}
	userAgent := "Injected/1.0"
	transport, err := NewTransportOptionsBuilder().RoundTripper(recorder).UserAgent(&userAgent).Build()
	if err != nil {
		t.Fatal(err)
	}
	client := NewDefaultApiClient(transport)
	if _, err := client.SendRequest("GET", server.URL+"/x", map[string]string{}, nil); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	recorder.mu.Lock()
	defer recorder.mu.Unlock()
	if len(recorder.requests) != 1 {
		t.Fatalf("expected the custom transport to receive 1 request, got %d", len(recorder.requests))
	}
	if got := recorder.requests[0].Header.Get("User-Agent"); got != "Injected/1.0" {
		t.Errorf("expected the SDK User-Agent on top of the custom transport, got %q", got)
	}
	_ = client.Close()
	if recorder.closed {
		t.Error("the SDK must never close a caller-supplied transport")
	}
}

type recordingDoer struct {
	requests []*http.Request
}

func (d *recordingDoer) Do(req *http.Request) (*http.Response, error) {
	d.requests = append(d.requests, req)
	return &http.Response{
		StatusCode: 200,
		Header:     http.Header{"Content-Type": []string{"application/json"}},
		Body:       io.NopCloser(strings.NewReader("{}")),
		Request:    req,
	}, nil
}

func TestDefaultApiClient_ClosedClientRejectsRequestsAndLeavesSuppliedDoerOpen(t *testing.T) {
	t.Parallel()
	doer := &recordingDoer{}
	transport, err := NewTransportOptionsBuilder().HttpClient(doer).Build()
	if err != nil {
		t.Fatal(err)
	}
	client := NewDefaultApiClient(transport)
	if err := client.Close(); err != nil {
		t.Fatalf("unexpected error from Close: %v", err)
	}
	if _, err := client.SendRequest("GET", "http://example.invalid/pets", map[string]string{}, nil); !errors.Is(err, ErrClientClosed) {
		t.Errorf("expected ErrClientClosed, got %v", err)
	}
	if len(doer.requests) != 0 {
		t.Errorf("expected no request to reach the supplied doer after Close, got %d", len(doer.requests))
	}
	/* The supplied doer is still usable by its owner: Close never touches it. */
	other := NewDefaultApiClient(transport)
	if _, err := other.SendRequest("GET", "http://example.invalid/pets", map[string]string{}, nil); err != nil {
		t.Errorf("expected the supplied doer to stay open, got %v", err)
	}
}

func TestDefaultApiClient_CustomHttpDoerReceivesTheRequest(t *testing.T) {
	t.Parallel()
	doer := &recordingDoer{}
	transport, err := NewTransportOptionsBuilder().HttpClient(doer).Build()
	if err != nil {
		t.Fatal(err)
	}
	client := NewDefaultApiClient(transport)
	resp, err := client.SendRequest("GET", "http://example.invalid/pets", map[string]string{"X-Test": "1"}, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp.StatusCode != 200 || resp.Body != "{}" {
		t.Errorf("unexpected response %d %q", resp.StatusCode, resp.Body)
	}
	if len(doer.requests) != 1 {
		t.Fatalf("expected the custom doer to receive 1 request, got %d", len(doer.requests))
	}
	req := doer.requests[0]
	if req.URL.String() != "http://example.invalid/pets" || req.Header.Get("X-Test") != "1" {
		t.Errorf("unexpected request %s %v", req.URL, req.Header)
	}
	if req.Header.Get("User-Agent") == "" {
		t.Error("expected the SDK default User-Agent on the request")
	}
}

func TestDefaultApiClient_TransportOptionsBuilder_SuppliedTransportConflictsWithSdkProxyAndTlsSettings(t *testing.T) {
	t.Parallel()
	cases := map[string]*TransportOptionsBuilder{
