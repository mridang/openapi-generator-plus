		"verify ssl":    NewTransportOptionsBuilder().HttpClient(&recordingDoer{}).VerifySsl(false),
		"ca bundle":     NewTransportOptionsBuilder().RoundTripper(http.DefaultTransport).CACertPath("/tmp/ca.pem"),
		"both supplied": NewTransportOptionsBuilder().HttpClient(&recordingDoer{}).RoundTripper(http.DefaultTransport),
	}
	for name, builder := range cases {
