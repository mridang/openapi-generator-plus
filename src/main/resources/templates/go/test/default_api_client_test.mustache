func TestDefaultApiClient_TlsVerificationDisabled(t *testing.T) {
	transport := {{packageName}}.NewTransportOptionsBuilder().VerifySSL(false).Build()
	client := {{packageName}}.NewDefaultApiClient(transport)
	resp, err := client.SendRequest("GET", wiremockHTTPSURL+"/api/test", map[string]string{}, nil)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if resp.StatusCode != 200 {
		t.Errorf("expected status 200, got %d", resp.StatusCode)
	}
	if !strings.Contains(resp.Body, "success") {
		t.Errorf("expected body to contain 'success', got %q", resp.Body)
	}
}

