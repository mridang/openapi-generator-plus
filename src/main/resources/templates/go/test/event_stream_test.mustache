func TestBhvSse003_EventStream_AnSseStreamDropsAByteOrderMarkAcceptsEveryLineEndAndRemovesOneSpaceAfterTheColon(t *testing.T) {
	t.Parallel()
	for name, end := range map[string]string{"LF": "\n", "CR": "\r", "CRLF": "\r\n"} {
		events := parseEvents(t, "\xef\xbb\xbfdata: a"+end+"data:  b"+end+end)
		if len(events) != 1 || events[0].data != "a\n b" {
			t.Errorf("line end %s: expected one event with data %q, got %+v", name, "a\n b", events)
		}
	}
	if events := parseEvents(t, "data:x\n\n"); len(events) != 1 || events[0].data != "x" {
		t.Errorf("expected no space to remove, got %+v", events)
	}
}

