func TestBhvSse008_EventStream_AnSseReconnectWaitsTheServerRetryValueElseTheReconnectDelayDoublingToACap(t *testing.T) {
	t.Parallel()
	retry, retryAfter := int64(250), 5*time.Second
	for _, row := range []struct {
		attempt    int
		serverRetry *int64
		retryAfter *time.Duration
		jitter     float64
		want       time.Duration
	}{
		{3, &retry, nil, 0, 250 * time.Millisecond},
		{1, nil, nil, 0, time.Second},
		{2, nil, nil, 0, 2 * time.Second},
		{3, nil, nil, 0, 4 * time.Second},
		{10, nil, nil, 0, 30 * time.Second},
		{1, nil, nil, 1, 750 * time.Millisecond},
		{1, nil, &retryAfter, 0, 5 * time.Second},
	} {
		if got := reconnectWait(row.attempt, time.Second, row.serverRetry, row.retryAfter, row.jitter); got != row.want {
			t.Errorf("attempt %d: expected %v, got %v", row.attempt, row.want, got)
		}
	}
}

func TestBhvSse009_EventStream_AnSseGetStreamStopsAfterFiveFailedReconnectsByDefaultAndRaisesTheLastFailure(t *testing.T) {
	t.Parallel()
	script := scripted("")
	stream := sseOf(t, script.open, fast())

	_, err := dataOf(stream)

	var network *pkgerrors.NetworkError
	if !errors.As(err, &network) {
		t.Errorf("expected a *NetworkError, got %v", err)
	}
	if len(script.lastIDs) != 6 {
		t.Errorf("expected one request and five reconnects, got %d requests", len(script.lastIDs))
