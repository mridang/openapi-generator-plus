func TestBhvSse010_EventStream_AnSseReconnectCounterResetsAfterAnEventIsReceived(t *testing.T) {
	t.Parallel()
	script := scripted("data: a\n\n", "data: b\n\n", "data: c\n\n", "")
	stream := sseOf(t, script.open, withReconnects(fast(), 1))

	data, err := dataOf(stream)

	var network *pkgerrors.NetworkError
	if !errors.As(err, &network) {
		t.Errorf("expected the end to be raised after the last event, got %v", err)
	}
	wantStrings(t, data, "a", "b", "c")
}

func TestBhvSse011_EventStream_AnSseStreamDoesNotReconnectAfterA204A4xxStatusOrAResponseThatIsNotAnEventStream(t *testing.T) {
	t.Parallel()
	none := scripted(noContentResponse())
	if data, err := dataOf(sseOf(t, none.open, fast())); err != nil || len(data) != 0 || len(none.lastIDs) != 1 {
		t.Errorf("expected an empty end after one request, got %q (%v) after %d", data, err, len(none.lastIDs))
	}

	refused := scripted("data: a\n\n", pkgerrors.NewApiError(404, "missing", "{}", nil, nil, nil))
	_, err := dataOf(sseOf(t, refused.open, fast()))
	var api *pkgerrors.ApiError
	if !errors.As(err, &api) || api.StatusCode() != 404 {
		t.Errorf("expected the 404 to be raised, got %v", err)
	}

	wrongType := scripted("data: a\n\n", NewApiStreamResponse(200, map[string]string{"content-type": "text/html"}, io.NopCloser(strings.NewReader(""))))
	_, err = dataOf(sseOf(t, wrongType.open, fast()))
	var serialization *pkgerrors.SerializationError
	if !errors.As(err, &serialization) || len(wrongType.lastIDs) != 2 {
		t.Errorf("expected a *SerializationError after one more request, got %v after %d", err, len(wrongType.lastIDs))
	}
}

func TestBhvSse014_EventStream_AnSseRetryFieldThatIsNotDigitsAndAnIdContainingNulAreIgnored(t *testing.T) {
	t.Parallel()
	parser := newSseParser(strings.NewReader("retry: 12x\nid: a\x00b\ndata: x\n\n"), 1024, "")

	event, err := parser.next()

	if err != nil || event == nil || event.data != "x" || event.id != "" || parser.retry != nil {
		t.Errorf("expected the retry and the id to be ignored, got %+v retry %v (%v)", event, parser.retry, err)
	}
}

func TestBhvSse016_EventStream_AnSseRequestWithABodyIsNotReconnectedUnlessTheCallerTurnsReconnectOn(t *testing.T) {
	t.Parallel()
	off := scripted("data: a\n\n", "data: b\n\n")
	stream, err := openSse(context.Background(), off.open, decodeText, nil, fast(), true, false, "POST", "/events")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	data, err := dataOf(stream)
	wantStrings(t, data, "a")
	if err != nil || len(off.lastIDs) != 1 {
		t.Errorf("expected no reconnect for a request with a body, got %v after %d requests", err, len(off.lastIDs))
	}

	on := scripted("data: a\n\n", "data: b\n\n", noContentResponse())
	stream, err = openSse(context.Background(), on.open, decodeText, nil, withReconnects(fast(), 2), true, false, "POST", "/events")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	data, err = dataOf(stream)
	wantStrings(t, data, "a", "b")
	if err != nil {
		t.Errorf("unexpected error: %v", err)
	}

	single := scripted("data: a\n\n", "data: b\n\n", noContentResponse())
	stream, err = openSse(context.Background(), single.open, decodeText, nil, withReconnects(fast(), 5), true, true, "POST", "/events")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	data, err = dataOf(stream)
	wantStrings(t, data, "a")
	if err != nil || len(single.lastIDs) != 1 {
		t.Errorf("expected a single use body never to be sent again, got %v after %d requests", err, len(single.lastIDs))
	}
}

func TestBhvSse017_EventStream_AnSseEventWithAnIdAndNoDataIsNotDispatchedButUpdatesTheLastEventIdAndAReconnectResumesFromIt(t *testing.T) {
	t.Parallel()
	script := scripted("data: a\nid: 1\n\nid: 2\n\n", "data: b\nid: 3\n\n", noContentResponse())

	data, err := dataOf(sseOf(t, script.open, fast()))

	wantStrings(t, data, "a", "b")
	if err != nil || len(script.lastIDs) < 2 || script.lastIDs[0] != "" || script.lastIDs[1] != "2" {
		t.Errorf("expected the reconnect to resume from id 2, got %v (%v)", script.lastIDs, err)
	}
}

func TestBhvSse019_EventStream_AnSseEventCutOffByTheEndOfTheConnectionIsDiscarded(t *testing.T) {
	t.Parallel()
	events := parseEvents(t, "data: whole\n\ndata: cut off\n")
	if len(events) != 1 || events[0].data != "whole" {
		t.Errorf("expected only the whole event, got %+v", events)
	}
	if events := parseEvents(t, "data: no newline at all"); len(events) != 0 {
		t.Errorf("expected a line without a line end to be discarded, got %+v", events)
	}
}

func TestBhvSse021_EventStream_TheConfiguredSseTerminatorEndsTheStreamAndIsNotDelivered(t *testing.T) {
	t.Parallel()
	terminator := "[DONE]"
	stream, err := openSse(context.Background(), scripted("data: a\n\ndata: [DONE]\n\ndata: b\n\n").open, decodeText, &terminator, fast(), false, false, "GET", "/events")
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}

	data, err := dataOf(stream)

	wantStrings(t, data, "a")
	if err != nil {
		t.Errorf("unexpected error: %v", err)
	}
}

func TestBhvSse022_EventStream_AnSseEventNamedErrorRaisesTheApiErrorWithTheStatusAndDataAndAnyOtherNameIsAnItem(t *testing.T) {
	t.Parallel()
	script := scripted("event: update\ndata: fine\n\nevent: error\ndata: {\"why\":\"bad\"}\n\n", "data: again\n\n")
	stream := sseOf(t, script.open, fast())

	var names []string
	var failure error
	for event, err := range stream.All() {
		if err != nil {
			failure = err
			continue
		}
		names = append(names, event.Event)
	}

	wantStrings(t, names, "update")
	var api *pkgerrors.ApiError
	if !errors.As(failure, &api) || api.StatusCode() != 200 || api.ResponseBody() != "{\"why\":\"bad\"}" {
		t.Fatalf("expected the API error with the status and the data, got %v", failure)
	}
	if len(script.lastIDs) != 1 {
		t.Errorf("expected an error event not to be reconnected, got %d requests", len(script.lastIDs))
	}
}

