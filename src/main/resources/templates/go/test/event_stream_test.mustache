// eventsResponse is a 200 event stream response over canned bytes.
func eventsResponse(text string) *ApiStreamResponse {
	return NewApiStreamResponse(200, map[string]string{"content-type": "text/event-stream"}, io.NopCloser(strings.NewReader(text)))
}

// noContentResponse is a 204 response.
func noContentResponse() *ApiStreamResponse {
	return NewApiStreamResponse(204, map[string]string{}, io.NopCloser(strings.NewReader("")))
}

// parseEvents reads every event of text with the parser.
func parseEvents(t *testing.T, text string) []*rawEvent {
	t.Helper()
	parser := newSseParser(strings.NewReader(text), 1024, "")
	var events []*rawEvent
	for {
		event, err := parser.next()
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if event == nil {
			return events
		}
		events = append(events, event)
	}
}

// linesOf reads every line of text as a JSON Lines stream of strings.
func linesOf(t *testing.T, text string) []string {
	t.Helper()
	stream := newJsonLinesStream(eventsResponse(text), decodeText, 1024, "GET", "/items")
	var items []string
	for item, err := range stream.All() {
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		items = append(items, item)
	}
	return items
}

// connectionScript opens an event stream whose n-th connection (from 1) is the
// n-th entry: a string is the body of a 200 response, an error fails the
// connection and a *ApiStreamResponse is used as it is. The last entry repeats.
type connectionScript struct {
	connections []any
	lastIDs     []string
}

func scripted(connections ...any) *connectionScript {
	return &connectionScript{connections: connections}
}

func (s *connectionScript) open(lastEventID string) (*ApiStreamResponse, error) {
	s.lastIDs = append(s.lastIDs, lastEventID)
	next := s.connections[min(len(s.lastIDs), len(s.connections))-1]
	switch value := next.(type) {
	case error:
		return nil, value
	case *ApiStreamResponse:
		return value, nil
	}
	return eventsResponse(next.(string)), nil
}

// fast makes the reconnect wait one millisecond.
func fast() *callSettings {
	delay := time.Millisecond
	return &callSettings{reconnectDelay: &delay}
}

func withReconnects(settings *callSettings, maxReconnects int) *callSettings {
	settings.maxReconnects = &maxReconnects
	return settings
}

func sseOf(t *testing.T, opener func(string) (*ApiStreamResponse, error), settings *callSettings) *SseStream[string] {
	t.Helper()
	stream, err := openSse(context.Background(), opener, decodeText, nil, settings, false, false, "GET", "/events")
	if err != nil {
		t.Fatalf("unexpected error opening the stream: %v", err)
	}
	return stream
}

// dataOf collects the data of every event, and the error that ended the stream.
func dataOf(stream *SseStream[string]) ([]string, error) {
	var data []string
	for event, err := range stream.All() {
		if err != nil {
			return data, err
		}
		data = append(data, event.Data)
	}
	return data, nil
}

func wantStrings(t *testing.T, got []string, want ...string) {
	t.Helper()
	if strings.Join(got, "|") != strings.Join(want, "|") || len(got) != len(want) {
		t.Errorf("expected %q, got %q", want, got)
	}
}

