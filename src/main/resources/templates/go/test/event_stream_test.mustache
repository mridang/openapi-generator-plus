func TestBhvStreaming004_EventStream_AJsonLinesLineThatDoesNotDecodeNamesItsLineAndEndsTheStream(t *testing.T) {
	t.Parallel()
	decode := func(line string) (int, error) {
		number, err := strconv.Atoi(line)
		if err != nil {
			return 0, newSerializationError("not a number", err)
		}
		return number, nil
	}
	stream := newJsonLinesStream(eventsResponse("1\n2\nnope\n4\n"), decode, 1024, "GET", "/items")

	var items []int
	var failure error
	for item, err := range stream.All() {
		if err != nil {
			failure = err
			continue
		}
		items = append(items, item)
	}

	if len(items) != 2 || items[0] != 1 || items[1] != 2 {
		t.Errorf("expected the items before the bad line, got %v", items)
	}
	var serialization *pkgerrors.SerializationError
	if !errors.As(failure, &serialization) || !strings.Contains(failure.Error(), "line 3") {
		t.Errorf("expected a *SerializationError naming line 3, got %v", failure)
	}
}

func TestBhvStreaming005_EventStream_ALineOrEventLongerThanTheLimitRaisesASerializationErrorAndEndsTheStream(t *testing.T) {
	t.Parallel()
	lineStream := newJsonLinesStream(eventsResponse("ok\n"+strings.Repeat("x", 50)+"\nlater\n"), decodeText, 10, "GET", "/items")
	var items []string
	var lineFailure error
	for item, err := range lineStream.All() {
		if err != nil {
			lineFailure = err
			continue
		}
		items = append(items, item)
	}
	var serialization *pkgerrors.SerializationError
	if !errors.As(lineFailure, &serialization) {
		t.Errorf("expected a *SerializationError for a long line, got %v", lineFailure)
	}
	wantStrings(t, items, "ok")

	limit := 10
	events := sseOf(t, scripted("data: "+strings.Repeat("y", 50)+"\n\n").open, &callSettings{maxEventBytes: &limit})
	data, eventFailure := dataOf(events)
	if !errors.As(eventFailure, &serialization) || len(data) != 0 {
		t.Errorf("expected a *SerializationError for a long event, got %v (%q)", eventFailure, data)
	}
}

func TestBhvSse001_EventStream_AnSseStreamYieldsTheIdEventDataAndRetryFieldsOfEachEventWithMessageAsTheDefault(t *testing.T) {
	t.Parallel()
	events := parseEvents(t, "id: 7\nevent: tick\nretry: 250\ndata: one\n\ndata: two\n\n")
	if len(events) != 2 {
		t.Fatalf("expected 2 events, got %d", len(events))
	}
	if first := events[0]; first.id != "7" || first.event != "tick" || first.data != "one" || first.retry == nil || *first.retry != 250 {
		t.Errorf("unexpected first event %+v", first)
	}
	if events[1].event != "message" || events[1].data != "two" || events[1].id != "7" {
		t.Errorf("expected the default event name and the persistent id, got %+v", events[1])
	}

	stream := sseOf(t, scripted("id: 7\nevent: tick\nretry: 250\ndata: one\n\n").open, fast())
	for event, err := range stream.All() {
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if event.ID != "7" || event.Event != "tick" || event.Data != "one" || event.Retry == nil || *event.Retry != 250 || event.Raw != "one" {
			t.Errorf("unexpected event %+v", event)
		}
		break
	}
}

