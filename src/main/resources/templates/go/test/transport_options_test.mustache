// A CA file that exists and is readable but holds no PEM certificate is a caller
// mistake just like a missing one: Build reports it, naming the file, instead of
// the first request failing or silently falling back to the system trust store.
func TestTransportOptions_GarbagePemCaCertFileIsRejected(t *testing.T) {
	t.Parallel()
	path := filepath.Join(t.TempDir(), "ca.pem")
	if err := os.WriteFile(path, []byte("this is not a certificate"), 0o600); err != nil {
		t.Fatal(err)
	}

	opts, err := {{packageName}}.NewTransportOptionsBuilder().
		CACertPath(path).
		Build()
	if !errors.Is(err, {{packageName}}.ErrInvalidCACertificate) {
		t.Fatalf("expected ErrInvalidCACertificate, got %v", err)
	}
	want := fmt.Sprintf("failed to parse CA certificate from %q: no PEM blocks found", path)
	if err.Error() != want {
		t.Errorf("expected message %q, got %q", want, err.Error())
	}
	var root apierrors.OpenAPIError
	if errors.As(err, &root) {
		t.Errorf("a garbage CA file must not be a OpenAPIError, got %T", err)
	}
	if opts != nil {
		t.Error("expected nil TransportOptions")
	}
}

// Every rejected proxy value names itself and says why: a scheme other than
// http or https, and a URL with no host.
func TestBhvOptions031_TransportOptions_ProxyRejectionMessages(t *testing.T) {
	t.Parallel()
	cases := []struct {
		proxy string
		want  string
	}{
		{"not-a-valid-url", `invalid proxy URL "not-a-valid-url": must use http or https scheme`},
		{"ftp://proxy.example.com:21", `invalid proxy URL "ftp://proxy.example.com:21": must use http or https scheme`},
		{"socks5://proxy.example.com:1080", `invalid proxy URL "socks5://proxy.example.com:1080": must use http or https scheme`},
		{"http://", `invalid proxy URL "http://": missing host`},
		{"https:///only-a-path", `invalid proxy URL "https:///only-a-path": missing host`},
		{"socks5://svc:s3cret@proxy.example.com:1080", `invalid proxy URL "socks5://***@proxy.example.com:1080": must use http or https scheme`},
		{"http://svc:s3cret@", `invalid proxy URL "http://***@": missing host`},
	}
	for _, tc := range cases {
		_, err := {{packageName}}.NewTransportOptionsBuilder().Proxy(tc.proxy).Build()
		if !errors.Is(err, {{packageName}}.ErrInvalidProxyURL) {
			t.Errorf("%q: expected ErrInvalidProxyURL, got %v", tc.proxy, err)
			continue
		}
		if err.Error() != tc.want {
			t.Errorf("%q: expected message %q, got %q", tc.proxy, tc.want, err.Error())
		}
	}
}

// An empty file and a directory are told apart: the empty file is readable but
// holds no certificate, a directory cannot be read.
func TestTransportOptions_EmptyCaCertFileAndDirectoryGetTheirOwnMessages(t *testing.T) {
	t.Parallel()
	dir := t.TempDir()
	empty := filepath.Join(dir, "empty.pem")
	if err := os.WriteFile(empty, nil, 0o600); err != nil {
		t.Fatal(err)
	}
	_, err := {{packageName}}.NewTransportOptionsBuilder().CACertPath(empty).Build()
	if want := fmt.Sprintf("failed to parse CA certificate from %q: no PEM blocks found", empty); err == nil || err.Error() != want {
		t.Errorf("empty file: expected %q, got %v", want, err)
	}
	_, err = {{packageName}}.NewTransportOptionsBuilder().CACertPath(dir).Build()
	if !errors.Is(err, {{packageName}}.ErrInvalidCACertificate) {
		t.Fatalf("directory: expected ErrInvalidCACertificate, got %v", err)
	}
	if want := fmt.Sprintf("failed to read CA certificate from %q: ", dir); !strings.HasPrefix(err.Error(), want) {
		t.Errorf("directory: expected a message starting with %q, got %v", want, err)
	}
}

