	opts, err := builder.Build()
	if !errors.Is(err, {{packageName}}.ErrInvalidProxyURL) {
		t.Fatalf("expected ErrInvalidProxyURL from Build, got %v", err)
	}
	if opts != nil {
		t.Error("expected nil TransportOptions from Build")
	}
}

// A bracketed IPv6 literal host is accepted and read back verbatim, and an
// unterminated one is refused.
func TestBhvOptions010_TransportOptions_ProxyUrlWithAnIpv6LiteralIsAcceptedAndAnUnterminatedOneRefused(t *testing.T) {
	t.Parallel()
	opts, err := {{packageName}}.NewTransportOptionsBuilder().Proxy("http://[::1]:3128").Build()
	if err != nil {
		t.Fatalf("expected the IPv6 proxy to be accepted, got %v", err)
	}
	if opts.Proxy() == nil || opts.Proxy().String() != "http://[::1]:3128" {
		t.Errorf("expected proxy 'http://[::1]:3128' on read-back, got %v", opts.Proxy())
	}
	_, err = {{packageName}}.NewTransportOptionsBuilder().Proxy("http://[::1:3128").Build()
	if !errors.Is(err, {{packageName}}.ErrInvalidProxyURL) {
		t.Fatalf("expected ErrInvalidProxyURL for an unterminated IPv6 literal, got %v", err)
	}
	if want := `invalid proxy URL "http://[::1:3128": missing ']' in host`; err.Error() != want {
		t.Errorf("expected message %q, got %q", want, err.Error())
	}
}

// A URL scheme is case-insensitive, so an upper-case proxy scheme is accepted.
func TestBhvOptions014_TransportOptions_UpperCaseProxySchemeIsAccepted(t *testing.T) {
	t.Parallel()
	opts, err := {{packageName}}.NewTransportOptionsBuilder().
		Proxy("HTTP://proxy.example.com:3128").
		Build()
	if err != nil {
		t.Fatalf("expected an upper-case scheme to be accepted, got %v", err)
	}
	if opts.Proxy() == nil || opts.Proxy().Host != "proxy.example.com:3128" {
		t.Errorf("expected the proxy host to be kept, got %v", opts.Proxy())
	}
}

func TestBhvOptions023_TransportOptions_StringMasksProxyPasswordAndSecretHeaders(t *testing.T) {
	t.Parallel()
	opts, err := {{packageName}}.NewTransportOptionsBuilder().
		Proxy("http://user:p4ssw0rd@proxy.example.com:8080").
		DefaultHeader("Authorization", "Bearer s3cret-value").
		DefaultHeader("X-Api-Key", "s3cret-value").
		DefaultHeader("Accept", "application/json").
		Build()
	if err != nil {
		t.Fatal(err)
	}

	for _, got := range []string{opts.String(), fmt.Sprintf("%v", opts), fmt.Sprintf("%+v", *opts), fmt.Sprintf("%#v", opts)} {
		if strings.Contains(got, "p4ssw0rd") || strings.Contains(got, "s3cret-value") {
			t.Errorf("expected secrets to be masked, got %s", got)
		}
		if !strings.Contains(got, "http://user:***@proxy.example.com:8080") {
			t.Errorf("expected the proxy password to print as ***, got %s", got)
		}
		if !strings.Contains(got, `"Accept": "application/json"`) {
			t.Errorf("expected a non-secret header to print as is, got %s", got)
		}
	}
}
