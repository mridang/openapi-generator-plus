func TestBhvOptions017_TransportOptions_BuilderSetsAllFields(t *testing.T) {
	t.Parallel()
	customAgent := "CustomAgent/2.0"
	customTimeout := 30000
	opts, err := {{packageName}}.NewTransportOptionsBuilder().
		VerifySsl(false).
		CACertPath("../testdata/certs/ca.pem").
		Proxy("http://proxy.example.com:8080").
		Timeout(&customTimeout).
		FollowRedirects(false).
		MaxRedirects(5).
		UserAgent(&customAgent).
		DefaultHeader("X-Custom", "value").
		InjectRequestID(true).
		Build()
	if err != nil {
		t.Fatal(err)
	}

	if opts.VerifySsl() {
		t.Error("expected VerifySsl to be false")
	}
	if opts.CACertPath() != "../testdata/certs/ca.pem" {
		t.Errorf("expected CACertPath '../testdata/certs/ca.pem', got %q", opts.CACertPath())
	}
	if opts.Proxy() == nil {
		t.Fatal("expected non-nil Proxy")
	}
	if opts.Proxy().String() != "http://proxy.example.com:8080" {
		t.Errorf("expected proxy 'http://proxy.example.com:8080', got %q", opts.Proxy().String())
	}
	if opts.Timeout() == nil || *opts.Timeout() != 30000 {
		t.Error("expected timeout 30000ms")
	}
	if opts.FollowRedirects() {
		t.Error("expected FollowRedirects to be false")
	}
	if opts.MaxRedirects() == nil || *opts.MaxRedirects() != 5 {
		t.Error("expected MaxRedirects to be 5")
	}
	if opts.UserAgent() == nil || *opts.UserAgent() != "CustomAgent/2.0" {
		t.Errorf("expected UserAgent 'CustomAgent/2.0', got %v", opts.UserAgent())
	}
	if opts.DefaultHeaders()["X-Custom"] != "value" {
		t.Errorf("expected default header X-Custom='value', got %q", opts.DefaultHeaders()["X-Custom"])
	}
	if !opts.InjectRequestID() {
		t.Error("expected InjectRequestID to be true")
	}
}

