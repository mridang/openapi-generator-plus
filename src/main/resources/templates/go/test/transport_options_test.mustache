func TestTransportOptions_Defaults(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().Build()

	if !opts.VerifySSL() {
		t.Error("expected VerifySSL to be true by default")
	}
	if opts.CACertPath() != "" {
		t.Errorf("expected empty CACertPath, got %q", opts.CACertPath())
	}
	if opts.Proxy() != nil {
		t.Error("expected nil Proxy by default")
	}
	if opts.Timeout() != 0 {
		t.Errorf("expected zero timeout by default, got %v", opts.Timeout())
	}
	if !opts.FollowRedirects() {
		t.Error("expected FollowRedirects to be true by default")
	}
	if opts.MaxRedirects() != 0 {
		t.Errorf("expected MaxRedirects 0 by default, got %d", opts.MaxRedirects())
	}
	if opts.UserAgent() == "" {
		t.Error("expected non-empty default UserAgent")
	}
	if len(opts.DefaultHeaders()) != 0 {
		t.Errorf("expected empty default headers, got %v", opts.DefaultHeaders())
	}
	if opts.InjectRequestID() {
		t.Error("expected InjectRequestID to be false by default")
	}
	if opts.TLSConfig() != nil {
		t.Error("expected nil TLSConfig by default")
	}
}

func TestTransportOptions_SetAllFields(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		VerifySSL(false).
		CACertPath("/path/to/ca.pem").
		Proxy("http://proxy.example.com:8080").
		Timeout(30 * time.Second).
		FollowRedirects(false).
		MaxRedirects(5).
		UserAgent("CustomAgent/2.0").
		DefaultHeader("X-Custom", "value").
		InjectRequestID(true).
		Build()

	if opts.VerifySSL() {
		t.Error("expected VerifySSL to be false")
	}
	if opts.CACertPath() != "/path/to/ca.pem" {
		t.Errorf("expected CACertPath '/path/to/ca.pem', got %q", opts.CACertPath())
	}
	if opts.Proxy() == nil {
		t.Fatal("expected non-nil Proxy")
	}
	if opts.Proxy().String() != "http://proxy.example.com:8080" {
		t.Errorf("expected proxy 'http://proxy.example.com:8080', got %q", opts.Proxy().String())
	}
	if opts.Timeout() != 30*time.Second {
		t.Errorf("expected timeout 30s, got %v", opts.Timeout())
	}
	if opts.FollowRedirects() {
		t.Error("expected FollowRedirects to be false")
	}
	if opts.MaxRedirects() != 5 {
		t.Errorf("expected MaxRedirects 5, got %d", opts.MaxRedirects())
	}
	if opts.UserAgent() != "CustomAgent/2.0" {
		t.Errorf("expected UserAgent 'CustomAgent/2.0', got %q", opts.UserAgent())
	}
	if opts.DefaultHeaders()["X-Custom"] != "value" {
		t.Errorf("expected default header X-Custom='value', got %q", opts.DefaultHeaders()["X-Custom"])
	}
	if !opts.InjectRequestID() {
		t.Error("expected InjectRequestID to be true")
	}
}

func TestTransportOptions_BuilderChaining(t *testing.T) {
	builder := {{packageName}}.NewTransportOptionsBuilder()

	// Chaining should return the same builder
	result := builder.
		VerifySSL(true).
		UserAgent("Test/1.0").
		Timeout(10 * time.Second)

	if result == nil {
		t.Fatal("expected non-nil builder from chaining")
	}

	opts := result.Build()
	if opts.UserAgent() != "Test/1.0" {
		t.Errorf("expected UserAgent 'Test/1.0', got %q", opts.UserAgent())
	}
	if opts.Timeout() != 10*time.Second {
		t.Errorf("expected timeout 10s, got %v", opts.Timeout())
	}
}

func TestTransportOptions_MultipleDefaultHeaders(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		DefaultHeaders(map[string]string{
			"X-First":  "one",
			"X-Second": "two",
		}).
		Build()

	headers := opts.DefaultHeaders()
	if headers["X-First"] != "one" {
		t.Errorf("expected X-First='one', got %q", headers["X-First"])
	}
	if headers["X-Second"] != "two" {
		t.Errorf("expected X-Second='two', got %q", headers["X-Second"])
	}
}

func TestTransportOptions_DefaultHeadersCopyIsolation(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		DefaultHeader("X-Test", "value").
		Build()

	headers := opts.DefaultHeaders()
	headers["X-Mutated"] = "should-not-affect-options"

	original := opts.DefaultHeaders()
	if _, found := original["X-Mutated"]; found {
		t.Error("modifying returned headers should not affect the transport options")
	}
}
