func TestTransportOptions_BuilderMethodsReturnSameInstance(t *testing.T) {
	builder := {{packageName}}.NewTransportOptionsBuilder()

	result := builder.
		VerifySSL(true).
		UserAgent("Test/1.0").
		Timeout(10000)

	if result == nil {
		t.Fatal("expected non-nil builder from chaining")
	}

	opts := result.Build()
	if opts.UserAgent() != "Test/1.0" {
		t.Errorf("expected UserAgent 'Test/1.0', got %q", opts.UserAgent())
	}
	if opts.Timeout() == nil || *opts.Timeout() != 10000 {
		t.Error("expected timeout 10000ms")
	}
}

func TestTransportOptions_AccumulatesHeadersFromDefaultHeaderCalls(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		DefaultHeader("X-First", "one").
		DefaultHeader("X-Second", "two").
		Build()

	headers := opts.DefaultHeaders()
	if len(headers) != 2 {
		t.Errorf("expected 2 headers, got %d", len(headers))
	}
	if headers["X-First"] != "one" {
		t.Errorf("expected X-First='one', got %q", headers["X-First"])
	}
	if headers["X-Second"] != "two" {
		t.Errorf("expected X-Second='two', got %q", headers["X-Second"])
	}
}

func TestTransportOptions_MergesHeadersFromDefaultHeadersCall(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		DefaultHeader("X-First", "one").
		DefaultHeaders(map[string]string{
			"X-Second": "two",
			"X-Third":  "three",
		}).
		Build()

	headers := opts.DefaultHeaders()
	if len(headers) != 3 {
		t.Errorf("expected 3 headers, got %d", len(headers))
	}
	if headers["X-First"] != "one" {
		t.Errorf("expected X-First='one', got %q", headers["X-First"])
	}
	if headers["X-Second"] != "two" {
		t.Errorf("expected X-Second='two', got %q", headers["X-Second"])
	}
	if headers["X-Third"] != "three" {
		t.Errorf("expected X-Third='three', got %q", headers["X-Third"])
	}
}

func TestTransportOptions_ModifyingSourceMapDoesNotAffectBuiltOptions(t *testing.T) {
	opts := {{packageName}}.NewTransportOptionsBuilder().
		DefaultHeader("X-Test", "value").
		Build()

	headers := opts.DefaultHeaders()
	headers["X-Mutated"] = "should-not-affect-options"

	original := opts.DefaultHeaders()
	if _, found := original["X-Mutated"]; found {
		t.Error("modifying returned headers should not affect the transport options")
	}
}

func TestTransportOptions_BuilderProducesIndependentInstances(t *testing.T) {
	builder := {{packageName}}.NewTransportOptionsBuilder().VerifySSL(false)
	first := builder.Build()
	second := builder.Build()

	if first.VerifySSL() != second.VerifySSL() {
		t.Error("expected both instances to have the same VerifySSL value")
	}
	if first == second {
		t.Error("expected builder to produce independent instances")
	}
}
