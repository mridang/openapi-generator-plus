func TestTransportOptions_BuilderMethodsReturnSameInstance(t *testing.T) {
	t.Parallel()
	builder := {{packageName}}.NewTransportOptionsBuilder()

	testAgent := "Test/1.0"
	result := builder.
		VerifySsl(true).
		UserAgent(&testAgent).
		Timeout(10000)

	if result == nil {
		t.Fatal("expected non-nil builder from chaining")
	}

	opts := result.Build()
	if opts.UserAgent() == nil || *opts.UserAgent() != "Test/1.0" {
		t.Errorf("expected UserAgent 'Test/1.0', got %v", opts.UserAgent())
	}
	if opts.Timeout() == nil || *opts.Timeout() != 10000 {
		t.Error("expected timeout 10000ms")
	}
}

func TestTransportOptions_AccumulatesHeadersFromDefaultHeaderCalls(t *testing.T) {
