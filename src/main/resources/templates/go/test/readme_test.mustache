package {{packageName}}_test

import (
	"os"
	"strings"
	"testing"
)

// readSourceFile returns the contents of the file at path, failing the test when
// it cannot be read. It is shared by the doc and config tests of this package.
func readSourceFile(t *testing.T, path string) string {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatalf("failed to read %s: %v", path, err)
	}
	return string(data)
}

func TestReadme_SocksNoteNamesTheGoProxySetter(t *testing.T) {
	t.Parallel()
	readme := readSourceFile(t, "../README.md")
	if !strings.Contains(readme, "`TransportOptionsBuilder.Proxy(...)` accepts only `http://` and `https://` URLs.") {
		t.Errorf("expected the SOCKS note to name TransportOptionsBuilder.Proxy(...)")
	}
	if strings.Contains(readme, "TransportOptions.proxy()") {
		t.Errorf("expected the SOCKS note not to name another language's TransportOptions.proxy() accessor")
	}
}

func TestReadme_LintNoteNamesOnlyTheLintersTheConfigRuns(t *testing.T) {
	t.Parallel()
	readme := readSourceFile(t, "../README.md")
	if !strings.Contains(readme, "# Lint (runs errcheck, govet, ineffassign, staticcheck and unused)") {
		t.Errorf("expected the lint comment to list the default golangci-lint linters")
	}
	for _, notRun := range []string{"revive", "gocritic", "gosec", "bodyclose"} {
		if strings.Contains(readme, notRun) {
			t.Errorf("expected the README not to claim the %s linter, which .golangci.yml does not enable", notRun)
		}
	}
}
