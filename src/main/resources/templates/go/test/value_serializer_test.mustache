func TestPathEncodingParity_LabelStyleEncodesValue(t *testing.T) {
	t.Parallel()
	result := {{packageName}}.SerializeStyled("color", "a b", "path", "string", "", "label", false)
	if result != ".a%20b" {
		t.Errorf("expected '.a%%20b', got %v", result)
	}
}

func TestPathEncodingParity_QueryLocationNotPathEncoded(t *testing.T) {
	t.Parallel()
	result := {{packageName}}.SerializeStyled("color", "a b", "query", "string", "", "form", false)
	if result != "a b" {
		t.Errorf("expected 'a b' (not path-encoded), got %v", result)
	}
}

func TestEmptyStringPathParamPanics(t *testing.T) {
	t.Parallel()
	// Gap W — empty-string path values silently produce malformed
	// URLs like `/pet//details`; reject at serialization time so
	// callers see the real error rather than a downstream 404.
	defer func() {
		if r := recover(); r == nil {
			t.Fatal("expected panic for empty-string path param")
		}
	}()
	_ = {{packageName}}.SerializeStyled("id", "", "path", "string", "", "simple", false)
}

// ── N3/W3 parity: format:date path parameter emits YYYY-MM-DD ──
//
// Go has only time.Time (no separate date-only type), so the codegen
// routes `format: date` path params through StringifyDate to strip the
// time component. Without this, a date param would go out as a full
// ISO+offset string, mismatching the 6 SDKs (Java/Kotlin/C#/Python/
// Ruby/Elixir) with native LocalDate types.

func TestFormatDatePathParam_TimeReturnsDateOnly(t *testing.T) {
	t.Parallel()
	when := time.Date(2024, time.January, 15, 14, 30, 45, 0, time.UTC)
	if got := {{packageName}}.StringifyDate(when); got != "2024-01-15" {
		t.Errorf("expected '2024-01-15', got %q", got)
	}
}

func TestFormatDatePathParam_StringPassesThrough(t *testing.T) {
	t.Parallel()
	if got := {{packageName}}.StringifyDate("2024-01-15"); got != "2024-01-15" {
		t.Errorf("expected '2024-01-15', got %q", got)
	}
}
