func TestSerializeValue_QueryArrayMulti(t *testing.T) {
	result := {{packageName}}.SerializeValue([]string{"a", "b"}, "query", "array", "multi")
	items, ok := result.([]string)
	if !ok {
		t.Fatalf("expected []string for multi collection format, got %T", result)
	}
	if len(items) != 2 || items[0] != "a" || items[1] != "b" {
		t.Errorf("expected [a b], got %v", items)
	}
}

