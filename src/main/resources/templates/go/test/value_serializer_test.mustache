// ── SerializeDeepObject ──

func TestSerializeDeepObject(t *testing.T) {
	result := {{packageName}}.SerializeDeepObject("filter", map[string]interface{}{
		"status": "active",
		"type":   "dog",
	})

	if result["filter[status]"] != "active" {
		t.Errorf("expected filter[status]='active', got %q", result["filter[status]"])
	}
	if result["filter[type]"] != "dog" {
		t.Errorf("expected filter[type]='dog', got %q", result["filter[type]"])
	}
}

func TestSerializeDeepObject_Nil(t *testing.T) {
	result := {{packageName}}.SerializeDeepObject("filter", nil)
	if len(result) != 0 {
		t.Errorf("expected empty map for nil, got %v", result)
	}
}

