// ── SerializeValue by location ──

func TestSerializeValue_QueryString(t *testing.T) {
	result := {{packageName}}.SerializeValue("hello", "query", "string", "")
	if result != "hello" {
		t.Errorf("expected 'hello', got %v", result)
	}
}

func TestSerializeValue_PathString(t *testing.T) {
	result := {{packageName}}.SerializeValue("hello world", "path", "string", "")
	str, ok := result.(string)
	if !ok {
		t.Fatalf("expected string result, got %T", result)
	}
	if str != "hello%20world" {
		t.Errorf("expected URL-encoded path value 'hello%%20world', got %q", str)
	}
}

