/* Go tooling (gopls, staticcheck SA1019) only recognises a deprecation when a
 * paragraph of the doc comment STARTS with "Deprecated: ". These tests parse the
 * generated model sources and check that the marker is its own paragraph and
 * that the description stays in the same doc comment. hasDeprecatedParagraph is
 * shared with pet_api_test.go. */

func TestBhvLanggo055_Model_DeprecatedSchemaCarriesADeprecatedParagraph(t *testing.T) {
	t.Parallel()
	path := "../pkg/models/tag.go"
	file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ParseComments)
	if err != nil {
		t.Fatalf("failed to parse %s: %v", path, err)
	}
	found := false
	for _, decl := range file.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || gen.Tok != token.TYPE || len(gen.Specs) != 1 {
			continue
		}
		spec, ok := gen.Specs[0].(*ast.TypeSpec)
		if !ok || spec.Name.Name != "Tag" {
			continue
		}
		found = true
		doc := gen.Doc.Text()
		if !strings.HasPrefix(doc, "Tag Tags are deprecated") {
			t.Errorf("expected the Tag description to start the doc comment, got %q", doc)
		}
		if !hasDeprecatedParagraph(doc) {
			t.Errorf("expected the Tag doc to have a Deprecated: paragraph, got %q", doc)
		}
	}
	if !found {
		t.Fatalf("type Tag not found in %s", path)
	}
}

// A model's externalDocs description reaches its doc comment as written, with no
// HTML entity in place of the quote, apostrophe, ampersand or angle brackets.
func TestBhvSerializationobject227_Model_ExternalDocsDescriptionKeepsTheSpecProseVerbatim(t *testing.T) {
	t.Parallel()
	path := "../pkg/models/account.go"
	file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ParseComments)
	if err != nil {
		t.Fatalf("failed to parse %s: %v", path, err)
	}
	for _, decl := range file.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || gen.Tok != token.TYPE {
			continue
		}
		want := `See https://example.com/docs/account Account <docs> & "notes" it's here`
		if doc := gen.Doc.Text(); !strings.Contains(doc, want) {
			t.Errorf("expected the Account doc to contain %q, got %q", want, doc)
		}
		return
	}
	t.Fatalf("no type declared in %s", path)
}

func TestBhvLanggo056_Model_DeprecatedFieldKeepsItsDescriptionAndStartsADeprecatedParagraph(t *testing.T) {
	t.Parallel()
	path := "../pkg/models/pet.go"
	file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ParseComments)
	if err != nil {
		t.Fatalf("failed to parse %s: %v", path, err)
	}
	found := false
	ast.Inspect(file, func(node ast.Node) bool {
		field, ok := node.(*ast.Field)
		if !ok || len(field.Names) == 0 || field.Names[0].Name != "Status" {
			return true
		}
		found = true
		doc := field.Doc.Text()
		if !strings.Contains(doc, "Status pet status in the store") {
			t.Errorf("expected the Status description to stay in the field doc, got %q", doc)
		}
		if !hasDeprecatedParagraph(doc) {
			t.Errorf("expected the Status field doc to have a Deprecated: paragraph, got %q", doc)
		}
		return false
	})
	if !found {
		t.Fatalf("field Status not found in %s", path)
	}
}

