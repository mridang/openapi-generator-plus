func TestMetadata_SerializeDeserialize(t *testing.T) {
	original := models.NewMetadata()

	data, err := json.Marshal(original)
	if err != nil {
		t.Fatalf("failed to serialize Metadata: %v", err)
	}
	if len(data) == 0 {
		t.Fatal("expected non-empty serialized data")
	}

	var restored models.Metadata
	if err := json.Unmarshal(data, &restored); err != nil {
		t.Fatalf("failed to deserialize Metadata: %v", err)
	}
}

func TestMetadata_DeserializeFromJSON(t *testing.T) {
	jsonData := []byte(`{"createdAt":"2024-01-15T10:30:00+00:00"}`)

	var metadata models.Metadata
	err := json.Unmarshal(jsonData, &metadata)
	if err != nil {
		t.Fatalf("failed to deserialize Metadata: %v", err)
	}
}

func TestMetadata_DeserializeEmptyObject(t *testing.T) {
	jsonData := []byte(`{}`)

	var metadata models.Metadata
	err := json.Unmarshal(jsonData, &metadata)
	if err != nil {
		t.Fatalf("failed to deserialize empty Metadata: %v", err)
	}
}

func TestMetadata_DeserializeWithAdditionalProperties(t *testing.T) {
	// Metadata may contain additional properties beyond the defined schema fields.
	// This test verifies that unknown fields are handled gracefully during
	// deserialization (either ignored or captured depending on schema config).
	jsonData := []byte(`{"createdAt":"2024-01-15T10:30:00+00:00","customField":"customValue","count":42}`)

	var metadata models.Metadata
	err := json.Unmarshal(jsonData, &metadata)
	if err != nil {
		t.Fatalf("failed to deserialize Metadata with additional properties: %v", err)
	}
}

func TestMetadata_RoundTrip(t *testing.T) {
	jsonData := []byte(`{"createdAt":"2024-01-15T10:30:00+00:00"}`)

	var metadata models.Metadata
	if err := json.Unmarshal(jsonData, &metadata); err != nil {
		t.Fatalf("failed to deserialize: %v", err)
	}

	data, err := json.Marshal(metadata)
	if err != nil {
		t.Fatalf("failed to serialize: %v", err)
	}
	if len(data) == 0 {
		t.Fatal("expected non-empty serialized data after round-trip")
	}
}
