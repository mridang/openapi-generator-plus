func TestBhvPagination017_Paginator_ThePerCallTimeoutHeadersAndRetryCountApplyToEachPageRequest(t *testing.T) {
	t.Parallel()
	server := servePaged(t, func(r pagedRequest, n int) pagedReply {
		if n%2 == 1 {
			return statusReply(503)
		}
		page := 1
		if n == 2 {
			page = 0
		}
		return okReply(catalogBody(page, 1, 2))
	})

	_, err := petNames(petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil, WithMaxRetries(1), WithHeaders(map[string]string{"X-Trace": "t1"})).Items())

	if err != nil || server.count() != 4 {
		t.Fatalf("expected each page to be tried twice, got %d requests (%v)", server.count(), err)
	}
	for index := range 4 {
		if got := server.request(index).headers["x-trace"]; got != "t1" {
			t.Errorf("request %d: expected the per-call header, got %q", index, got)
		}
	}

	slow := servePaged(t, func(r pagedRequest, n int) pagedReply {
		if r.param("cursor") == "" {
			return okReply(catalogBody(0, 1, 2))
		}
		reply := okReply(catalogBody(1, 1, 2))
		reply.delay = 1500 * time.Millisecond
		return reply
	})
	names, err := petNames(petApiFor(t, slow, 0, nil).ListPetCatalogPages(context.Background(), nil, WithTimeout(300*time.Millisecond)).Items())

	if len(names) != 1 || names[0] != "p0-0" {
		t.Errorf("expected the first page to answer within its own budget, got %v", names)
	}
	var timeout *pkgerrors.NetworkTimeoutError
	if !errors.As(err, &timeout) {
		t.Errorf("expected the second page to time out, got %T: %v", err, err)
	}
}

func TestBhvPagination018_Paginator_StoppingEarlySendsNoFurtherRequestAndLeavesNothingToClose(t *testing.T) {
	t.Parallel()
	server := catalogServer(t, 3, 2)
	paginator := petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil)

	for pet, err := range paginator.Items() {
		if err != nil || pet.Name != "p0-0" {
			t.Fatalf("unexpected item %q (%v)", pet.Name, err)
		}
		break
	}
	if got := server.count(); got != 1 {
		t.Errorf("expected one request after stopping at the first item, got %d", got)
	}

	taken := 0
	for _, err := range paginator.Items() {
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if taken++; taken == 2 {
			break
		}
	}
	if got := server.count(); got != 2 {
		t.Errorf("expected stopping after two items to have read exactly one more page, got %d requests", got)
	}
	if _, closable := reflect.TypeOf(paginator).MethodByName("Close"); closable {
		t.Error("expected nothing to close")
	}
}

func TestBhvPagination019_Paginator_CancellingMidIterationAbortsTheInFlightPageRequestAndIsNotReportedAsATimeout(t *testing.T) {
	t.Parallel()
	server := servePaged(t, func(r pagedRequest, n int) pagedReply {
		if r.param("cursor") == "" {
			return okReply(catalogBody(0, 1, 2))
		}
		reply := okReply(catalogBody(1, 1, 2))
		reply.delay = 8 * time.Second
		return reply
	})
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	api := petApiFor(t, server, 0, nil, func(b *TransportOptionsBuilder) { timeout := 20000; b.Timeout(&timeout) })
	failed := make(chan error, 1)
	go func() {
		_, err := petNames(api.ListPetCatalogPages(ctx, nil).Items())
		failed <- err
	}()
	deadline := time.Now().Add(5 * time.Second)
	for server.count() < 2 && time.Now().Before(deadline) {
		time.Sleep(20 * time.Millisecond)
	}
	if server.count() != 2 {
		t.Fatal("expected the second page to be in flight")
	}

	cancel()

	select {
	case err := <-failed:
		var timeout *pkgerrors.NetworkTimeoutError
		if !errors.Is(err, context.Canceled) || errors.As(err, &timeout) {
			t.Errorf("expected a cancellation that is not a timeout, got %T: %v", err, err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("expected the cancelled iteration to stop promptly")
	}
}

