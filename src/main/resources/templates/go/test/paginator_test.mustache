/* pagedRequest is one request a paged-list server saw: the path, the decoded
 * query and the headers with lower-cased names. */
type pagedRequest struct {
	path    string
	query   url.Values
	headers map[string]string
}

func (r pagedRequest) param(name string) string { return r.query.Get(name) }

/* pagedReply is what a paged-list server answers: a status, a JSON body, extra
 * headers and a delay before it answers. */
type pagedReply struct {
	status  int
	body    string
	headers []string
	delay   time.Duration
}

func okReply(body string, headers ...string) pagedReply {
	return pagedReply{status: 200, body: body, headers: headers}
}

func statusReply(status int) pagedReply {
	return pagedReply{status: status, body: "{}", headers: []string{"Retry-After: 0"}}
}

/* pagedServer is a raw server whose answer depends on the request it gets and on
 * how many it has had, which the shared mock cannot do. It records every request
 * in arrival order. */
type pagedServer struct {
	*rawServer
	mu   sync.Mutex
	seen []pagedRequest
}

func parsePagedRequest(head string) pagedRequest {
	lines := strings.Split(head, "\r\n")
	request := pagedRequest{headers: map[string]string{}}
	if parts := strings.Fields(lines[0]); len(parts) >= 2 {
		if parsed, err := url.ParseRequestURI(parts[1]); err == nil {
			request.path = parsed.Path
			request.query = parsed.Query()
		}
	}
	for _, line := range lines[1:] {
		if name, value, found := strings.Cut(line, ":"); found {
			request.headers[strings.ToLower(name)] = strings.TrimSpace(value)
		}
	}
	return request
}

func servePaged(t *testing.T, handler func(r pagedRequest, n int) pagedReply) *pagedServer {
	t.Helper()
	paged := &pagedServer{}
	paged.rawServer = serveRaw(t, func(s *rawServer, conn net.Conn, hit int, head string) {
		request := parsePagedRequest(head)
		paged.mu.Lock()
		paged.seen = append(paged.seen, request)
		number := len(paged.seen)
		paged.mu.Unlock()
		reply := handler(request, number)
		if reply.delay > 0 {
			time.Sleep(reply.delay)
		}
		headers := append([]string{"Content-Type: application/json", fmt.Sprintf("Content-Length: %d", len(reply.body))}, reply.headers...)
		rawHead(conn, reply.status, headers...)
		_, _ = conn.Write([]byte(reply.body))
	})
	return paged
}

func (s *pagedServer) count() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	return len(s.seen)
}

func (s *pagedServer) request(n int) pagedRequest {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.seen[n]
}

/* params is the value of a query parameter on every request, in order, with the
 * empty string for a request that did not carry it. */
func (s *pagedServer) params(name string) []string {
	s.mu.Lock()
	defer s.mu.Unlock()
	var values []string
	for _, request := range s.seen {
		values = append(values, request.param(name))
	}
	return values
}

func pagedPtr[T any](value T) *T { return &value }

func petJSON(name string) string {
	return `{"id":1,"name":"` + name + `","photoUrls":[]}`
}

/* catalogBody is page `page` of `pages`, with `size` pets; the cursor of page n is "c" followed by n. */
func catalogBody(page, size, pages int) string {
	items := make([]string, 0, size)
	for i := 0; i < size; i++ {
		items = append(items, petJSON(fmt.Sprintf("p%d-%d", page, i)))
	}
	next := ""
	if page+1 < pages {
		next = fmt.Sprintf(`,"next_cursor":"c%d"`, page+1)
	}
	return `{"items":[` + strings.Join(items, ",") + `]` + next + `}`
}

func catalogServer(t *testing.T, pages, size int) *pagedServer {
	t.Helper()
	return servePaged(t, func(r pagedRequest, n int) pagedReply {
		page := 0
		if cursor := r.param("cursor"); cursor != "" {
			page, _ = strconv.Atoi(strings.TrimPrefix(cursor, "c"))
		}
		return okReply(catalogBody(page, size, pages))
	})
}

func petApiFor(t *testing.T, server *pagedServer, retries int, authenticator Authenticator, configure ...func(*TransportOptionsBuilder)) *PetApi {
	t.Helper()
	builder := NewTransportOptionsBuilder().MaxRetries(retries)
	for _, apply := range configure {
		apply(builder)
	}
	transport, err := builder.Build()
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	client := NewDefaultApiClient(transport)
	t.Cleanup(func() { _ = client.Close() })
	config := NewConfigurationBuilder().BaseURL(server.url("")).Build()
	return NewPetApi(client, config, authenticator, Credentials{})
}

func petNames(items iter.Seq2[models.Pet, error]) ([]string, error) {
	var names []string
	for pet, err := range items {
		if err != nil {
			return names, err
		}
		names = append(names, pet.Name)
	}
	return names, nil
}

func wantNames(t *testing.T, got []string, err error, want ...string) {
	t.Helper()
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("expected %v, got %v", want, got)
	}
}

func wantParams(t *testing.T, got []string, want ...string) {
	t.Helper()
	if !reflect.DeepEqual(got, want) {
		t.Errorf("expected the parameter values %q, got %q", want, got)
	}
}

/* feedServer answers a feed page with one pet and a Link header that names the
 * next page, or none on the last. */
func feedServer(t *testing.T, pages int, link func(self *pagedServer, next int) string) *pagedServer {
	t.Helper()
	var self *pagedServer
	self = servePaged(t, func(r pagedRequest, n int) pagedReply {
		index := 0
		if page := r.param("page"); page != "" {
			index, _ = strconv.Atoi(page)
		}
		body := "[" + petJSON(fmt.Sprintf("f%d", index)) + "]"
		if index+1 < pages {
			return okReply(body, "Link: "+link(self, index+1))
		}
		return okReply(body)
	})
	return self
}

func sameOriginFeed(t *testing.T, pages int) *pagedServer {
	t.Helper()
	return feedServer(t, pages, func(self *pagedServer, next int) string {
		return fmt.Sprintf(`<%s/pet/feed?page=%d&secret=s3>; rel="next"`, self.url(""), next)
	})
}

/* petRange is the pets p[from] up to p[to-1] as a JSON array, for a server that holds five pets p0 to p4. */
func petRange(from, to int) string {
	var items []string
	for i := from; i < to; i++ {
		items = append(items, petJSON(fmt.Sprintf("p%d", i)))
	}
	return "[" + strings.Join(items, ",") + "]"
}

/* offsetServer answers the two pets from the offset it is sent, or from the start with none. */
func offsetServer(t *testing.T) *pagedServer {
	t.Helper()
	return servePaged(t, func(r pagedRequest, n int) pagedReply {
		from := 0
		if offset := r.param("offset"); offset != "" {
			from, _ = strconv.Atoi(offset)
		}
		return okReply(`{"items":` + petRange(from, min(from+2, 5)) + `}`)
	})
}

/* pageNumberServer answers the two pets of the page it is sent, from page 1, and a has_more flag that stays true. */
func pageNumberServer(t *testing.T) *pagedServer {
	t.Helper()
	return servePaged(t, func(r pagedRequest, n int) pagedReply {
		page := 1
		if value := r.param("page"); value != "" {
			page, _ = strconv.Atoi(value)
		}
		from := (page - 1) * 2
		return okReply(fmt.Sprintf(`{"items":%s,"has_more":true}`, petRange(from, min(from+2, 5))))
	})
}

/* afterServer answers the two pets after the id it is sent, from the start with none, with the id of its last pet and a has_more flag. */
func afterServer(t *testing.T) *pagedServer {
	t.Helper()
	return servePaged(t, func(r pagedRequest, n int) pagedReply {
		from := 0
		if after := r.param("starting_after"); after != "" {
			index, _ := strconv.Atoi(strings.TrimPrefix(after, "p"))
			from = index + 1
		}
		to := min(from+2, 5)
		return okReply(fmt.Sprintf(`{"data":%s,"has_more":%t,"last_id":"p%d"}`, petRange(from, to), to < 5, to-1))
	})
}

/* nextUrlServer answers one pet a page, with the URL of the next page in the body of every page but the last. */
func nextUrlServer(t *testing.T, pages int) *pagedServer {
	t.Helper()
	var self *pagedServer
	self = servePaged(t, func(r pagedRequest, n int) pagedReply {
		index := 0
		if p := r.param("p"); p != "" {
			index, _ = strconv.Atoi(p)
		}
		next := ""
		if index+1 < pages {
			next = fmt.Sprintf(`,"next_url":"%s/pet/next?p=%d"`, self.url(""), index+1)
		}
		return okReply(`{"items":[` + petJSON(fmt.Sprintf("f%d", index)) + `]` + next + `}`)
	})
	return self
}

func TestBhvPagination001_Paginator_APagedOperationReadsNoPageUntilTheFirstRead(t *testing.T) {
	t.Parallel()
	server := catalogServer(t, 2, 2)
	paginator := petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil)
	if server.count() != 0 {
		t.Fatal("expected the method to send nothing")
	}
	items, pages := paginator.Items(), paginator.Pages()
	if items == nil || pages == nil || server.count() != 0 {
		t.Fatalf("expected getting a view to send nothing, got %d requests", server.count())
	}

	next, stop := iter.Pull2(items)
	defer stop()
	if _, err, ok := next(); !ok || err != nil {
		t.Fatalf("expected the first item, got %v", err)
	}
	if got := server.count(); got != 1 {
		t.Errorf("expected the first read to send the first request, got %d", got)
	}
}

func TestBhvPagination002_Paginator_ATokenCursorOperationYieldsEveryItemInOrder(t *testing.T) {
	t.Parallel()
	server := catalogServer(t, 3, 2)

	names, err := petNames(petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil).Items())

	wantNames(t, names, err, "p0-0", "p0-1", "p1-0", "p1-1", "p2-0", "p2-1")
	wantParams(t, server.params("cursor"), "", "c1", "c2")
}

func TestBhvPagination003_Paginator_TheNextRequestIsSentOnlyWhenTheConsumerAsksForMore(t *testing.T) {
	t.Parallel()
	server := catalogServer(t, 3, 2)
	next, stop := iter.Pull2(petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil).Items())
	defer stop()

	for range 2 {
		if _, err, ok := next(); !ok || err != nil {
			t.Fatalf("unexpected end: %v", err)
		}
	}
	if got := server.count(); got != 1 {
		t.Errorf("expected both items of the first page to come from one request, got %d", got)
	}
	if _, err, ok := next(); !ok || err != nil {
		t.Fatalf("unexpected end: %v", err)
	}
	if got := server.count(); got != 2 {
		t.Errorf("expected the third item to need the second page, got %d requests", got)
	}
}

