func wantNamesPrefix(t *testing.T, got []string, want ...string) {
	t.Helper()
	if !reflect.DeepEqual(got, want) {
		t.Errorf("expected the items %v before the failure, got %v", want, got)
	}
}

/* tokenIssuer issues a different token on every request it is asked for. */
type tokenIssuer struct{ issued atomic.Int32 }

func (r *tokenIssuer) Host() string { return "" }
func (r *tokenIssuer) AuthHeaders() map[string]string {
	return map[string]string{"Authorization": fmt.Sprintf("Bearer token-%d", r.issued.Add(1))}
}
func (r *tokenIssuer) QueryParams() map[string]string  { return nil }
func (r *tokenIssuer) CookieParams() map[string]string { return nil }

