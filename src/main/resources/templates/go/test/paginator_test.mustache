func TestBhvPagination012_Paginator_ResumingWithTheNextCursorOfAPageContinuesWithTheFollowingPage(t *testing.T) {
	t.Parallel()
	server := catalogServer(t, 3, 1)
	api := petApiFor(t, server, 0, nil)
	var resume *string
	for page, err := range api.ListPetCatalogPages(context.Background(), nil).Pages() {
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		resume = page.NextCursor
		break
	}
	if resume == nil || *resume != "c1" {
		t.Fatalf("expected the next cursor c1, got %v", resume)
