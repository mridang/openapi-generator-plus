/* pagesMethods are the names of the paged methods a type declares, sorted. */
func pagesMethods(typ reflect.Type) []string {
	var names []string
	for index := range typ.NumMethod() {
		if name := typ.Method(index).Name; strings.HasSuffix(name, "Pages") {
			names = append(names, name)
		}
	}
	sort.Strings(names)
	return names
}

