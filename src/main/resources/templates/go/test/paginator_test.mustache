func TestBhvPagination025_Paginator_APagedMethodHasTheSameParametersAsTheBaseMethodAndTheBaseMethodIsUnchanged(t *testing.T) {
	t.Parallel()
	for _, typ := range []reflect.Type{reflect.TypeOf(&PetApi{}), reflect.TypeOf((*PetApiInterface)(nil)).Elem()} {
		for _, name := range pagesMethods(typ) {
			pages, _ := typ.MethodByName(name)
			base, found := typ.MethodByName(strings.TrimSuffix(name, "Pages"))
			if !found {
				t.Fatalf("%s: expected a base method", name)
			}
			if pages.Type.NumIn() != base.Type.NumIn() || pages.Type.IsVariadic() != base.Type.IsVariadic() {
				t.Errorf("%s: expected the parameters of %s, got %v and %v", name, base.Name, pages.Type, base.Type)
				continue
			}
			for index := 0; index < pages.Type.NumIn(); index++ {
				if pages.Type.In(index) != base.Type.In(index) {
					t.Errorf("%s: parameter %d differs: %v and %v", name, index, pages.Type.In(index), base.Type.In(index))
				}
			}
			if strings.Contains(base.Type.Out(0).String(), "Paginator") {
				t.Errorf("%s: expected the base method to still return the page body, got %v", base.Name, base.Type.Out(0))
			}
		}
	}
}

