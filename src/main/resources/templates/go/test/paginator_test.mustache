func TestBhvPagination008_Paginator_ALinkNextUrlOnAnotherOriginIsRefusedAndNoCredentialsAreSentToIt(t *testing.T) {
	t.Parallel()
	elsewhere := servePaged(t, func(r pagedRequest, n int) pagedReply {
		return okReply("[" + petJSON("stolen") + "]")
	})
	origin := servePaged(t, func(r pagedRequest, n int) pagedReply {
		return okReply("["+petJSON("f0")+"]", fmt.Sprintf(`Link: <%s/pet/feed?page=1>; rel="next"`, elsewhere.url("")))
	})
	api := petApiFor(t, origin, 0, nil, func(b *TransportOptionsBuilder) { b.DefaultHeader("Authorization", "Bearer secret") })

	names, err := petNames(api.ListPetFeedPages(context.Background(), nil).Items())

	if len(names) != 1 || names[0] != "f0" {
		t.Errorf("expected the page before the foreign link to be delivered, got %v", names)
	}
	var refused *pkgerrors.PaginationError
	if !errors.As(err, &refused) {
		t.Fatalf("expected the link to another origin to be refused, got %T: %v", err, err)
	}
	if strings.Contains(err.Error(), "page=1") {
		t.Errorf("expected the message to hold no query, got %q", err.Error())
	}
	if got := origin.request(0).headers["authorization"]; got != "Bearer secret" {
		t.Errorf("expected the credential on the own origin, got %q", got)
	}
	if elsewhere.count() != 0 || origin.count() != 1 {
		t.Errorf("expected nothing sent to the other origin, got %d and %d requests", elsewhere.count(), origin.count())
	}
}

func TestBhvPagination009_Paginator_AnEmptyPageWithANextCursorContinuesAndAnAbsentNullOrEmptyCursorEnds(t *testing.T) {
	t.Parallel()
	for _, end := range []string{"", `,"next_cursor":null`, `,"next_cursor":""`} {
		server := servePaged(t, func(r pagedRequest, n int) pagedReply {
			if r.param("cursor") == "" {
				return okReply(`{"items":[],"next_cursor":"c1"}`)
			}
			return okReply(`{"items":[` + petJSON("only") + `]` + end + `}`)
		})

		names, err := petNames(petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil).Items())

		wantNames(t, names, err, "only")
		if got := server.count(); got != 2 {
			t.Errorf("%q: expected the empty page to continue and the end to end, got %d requests", end, got)
		}
	}
}

func TestBhvPagination010_Paginator_PagesYieldsOnePagePerResponseWithItsItemsStatusHeadersBodyAndNextCursor(t *testing.T) {
	t.Parallel()
	server := servePaged(t, func(r pagedRequest, n int) pagedReply {
		page := 0
		if cursor := r.param("cursor"); cursor != "" {
			page, _ = strconv.Atoi(strings.TrimPrefix(cursor, "c"))
		}
		return okReply(catalogBody(page, 2, 2), fmt.Sprintf("X-Page: %d", page))
	})
	var pages []*Page[models.Pet, string]

	for page, err := range petApiFor(t, server, 0, nil).ListPetCatalogPages(context.Background(), nil).Pages() {
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		pages = append(pages, page)
	}

	if len(pages) != 2 {
		t.Fatalf("expected two pages, got %d", len(pages))
	}
	if len(pages[0].Items) != 2 || pages[0].Items[0].Name != "p0-0" || pages[0].Items[1].Name != "p0-1" {
		t.Errorf("expected the items of the first page, got %v", pages[0].Items)
	}
	if pages[0].Result.StatusCode != 200 || pages[0].Result.Headers["x-page"] != "0" || pages[1].Result.Headers["x-page"] != "1" {
		t.Errorf("expected the status and the headers of each page, got %+v and %+v", pages[0].Result, pages[1].Result)
	}
	if body, ok := (*pages[0].Result.Data).(models.PetCatalogPage); !ok || body.NextCursor == nil || *body.NextCursor != "c1" {
		t.Errorf("expected the decoded body behind Data, got %v", pages[0].Result.Data)
	}
	if pages[0].NextCursor == nil || *pages[0].NextCursor != "c1" || pages[1].NextCursor != nil {
		t.Errorf("expected c1 and then no next cursor, got %v and %v", pages[0].NextCursor, pages[1].NextCursor)
	}
}

