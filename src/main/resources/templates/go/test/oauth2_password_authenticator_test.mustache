package {{packageName}}_test

import (
	"strings"
	"sync/atomic"
	"testing"

	"{{packageName}}/pkg/auth"
	"{{packageName}}/pkg/auth/oauth"
)

// fakePasswordClient implements auth.ApiClient for password authenticator tests.
type fakePasswordClient struct {
	responses []fakePasswordResponse
	index     int32
	LastBody  string
	LastURL   string
}

type fakePasswordResponse struct {
	body       string
	statusCode int
}

func (c *fakePasswordClient) SendRequest(method, url string, headers map[string]string, body interface{}) (*auth.HttpResponse, error) {
	c.LastURL = url
	if body != nil {
		if b, ok := body.([]byte); ok {
			c.LastBody = string(b)
		}
	}
	idx := atomic.AddInt32(&c.index, 1) - 1
	resp := c.responses[idx]
	return &auth.HttpResponse{
		StatusCode: resp.statusCode,
		Body:       resp.body,
		Headers:    map[string]string{},
	}, nil
}

func createPasswordAuthenticator() *oauth.OAuth2PasswordAuthenticator {
	return oauth.NewOAuth2PasswordAuthenticator(
		"https://api.example.com",
		"my-client-id",
		"my-client-secret",
		"https://auth.example.com/token",
		"testuser",
		"testpass",
		[]string{"read", "write"},
		"",
	)
}

func TestOAuth2Password_SendsPasswordGrantType(t *testing.T) {
	client := &fakePasswordClient{
		responses: []fakePasswordResponse{
			{body: `{"access_token":"tok1","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createPasswordAuthenticator()
	authObj.SetApiClient(client)

	authObj.AuthHeaders()

	if !strings.Contains(client.LastBody, "grant_type=password") {
		t.Errorf("expected body to contain grant_type=password, got %q", client.LastBody)
	}
}

func TestOAuth2Password_SendsUsernameAndPassword(t *testing.T) {
	client := &fakePasswordClient{
		responses: []fakePasswordResponse{
			{body: `{"access_token":"tok1","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createPasswordAuthenticator()
	authObj.SetApiClient(client)

	authObj.AuthHeaders()

	if !strings.Contains(client.LastBody, "username=testuser") {
		t.Errorf("expected body to contain username=testuser, got %q", client.LastBody)
	}
	if !strings.Contains(client.LastBody, "password=testpass") {
		t.Errorf("expected body to contain password=testpass, got %q", client.LastBody)
	}
}

func TestOAuth2Password_SendsClientIdAndSecret(t *testing.T) {
	client := &fakePasswordClient{
		responses: []fakePasswordResponse{
			{body: `{"access_token":"tok1","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createPasswordAuthenticator()
	authObj.SetApiClient(client)

	authObj.AuthHeaders()

	if !strings.Contains(client.LastBody, "client_id=my-client-id") {
		t.Errorf("expected body to contain client_id=my-client-id, got %q", client.LastBody)
	}
	if !strings.Contains(client.LastBody, "client_secret=my-client-secret") {
		t.Errorf("expected body to contain client_secret=my-client-secret, got %q", client.LastBody)
	}
}

func TestOAuth2Password_ReturnsAuthorizationBearerHeader(t *testing.T) {
	client := &fakePasswordClient{
		responses: []fakePasswordResponse{
			{body: `{"access_token":"tok-pwd","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createPasswordAuthenticator()
	authObj.SetApiClient(client)

	headers := authObj.AuthHeaders()

	if headers["Authorization"] != "Bearer tok-pwd" {
		t.Errorf("expected Authorization 'Bearer tok-pwd', got %q", headers["Authorization"])
	}
}

func TestOAuth2Password_UsesRefreshTokenOnSubsequentCalls(t *testing.T) {
	client := &fakePasswordClient{
		responses: []fakePasswordResponse{
			{body: `{"access_token":"tok1","refresh_token":"ref1","expires_in":1}`, statusCode: 200},
			{body: `{"access_token":"tok2","expires_in":3600}`, statusCode: 200},
		},
	}

	authObj := createPasswordAuthenticator()
	authObj.SetApiClient(client)

	// First call uses password grant
	authObj.AuthHeaders()
	// Second call should use refresh_token grant since token is expired
	authObj.AuthHeaders()

	if !strings.Contains(client.LastBody, "grant_type=refresh_token") {
		t.Errorf("expected body to contain grant_type=refresh_token, got %q", client.LastBody)
	}
	if !strings.Contains(client.LastBody, "refresh_token=ref1") {
		t.Errorf("expected body to contain refresh_token=ref1, got %q", client.LastBody)
	}
}

func TestOAuth2Password_HostReturnsConfiguredHost(t *testing.T) {
	authObj := createPasswordAuthenticator()

	if authObj.Host() != "https://api.example.com" {
		t.Errorf("expected host 'https://api.example.com', got %q", authObj.Host())
	}
}
