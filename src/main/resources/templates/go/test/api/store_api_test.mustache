	client := {{packageName}}.NewDefaultApiClient(noRetryTransport(t))
	return {{packageName}}.NewStoreApi(client, config, nil, {{packageName}}.Credentials{})
}

// F1128: createAccount sends the write-only password, keeps the read-only id
// of the response, and carries no credential of its own.
func TestBhvOperations098_StoreApi_CreateAccountSendsPasswordAndDecodesReadOnlyId(t *testing.T) {
	t.Parallel()
	var gotBody, gotMethod, gotPath, gotAuth string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, _ := io.ReadAll(r.Body)
		gotBody, gotMethod, gotPath, gotAuth = string(raw), r.Method, r.URL.Path, r.Header.Get("Authorization")
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(`{"id":7,"username":"u"}`))
	}))
	defer server.Close()
	api := newStoreApiForMock(t, server)

	password := "p"
	result, err := api.CreateAccount(context.Background(), models.Account{Username: "u", Password: &password})
	if err != nil {
		t.Fatalf("CreateAccount failed: %v", err)
	}
	if gotMethod != "POST" || gotPath != "/store/account" {
		t.Errorf("expected POST /store/account, got %s %s", gotMethod, gotPath)
	}
	if gotBody != `{"username":"u","password":"p"}` {
		t.Errorf("expected the password on the wire, got %s", gotBody)
	}
	if gotAuth != "" {
		t.Errorf("expected no Authorization header, got %q", gotAuth)
	}
	if result.Id == nil || *result.Id != 7 {
		t.Errorf("expected the read-only id 7, got %v", result.Id)
	}
}

// F1161: the typed status routes of the mock answer getOrderById with each
// status, and the matching status-specific error class is chosen.
func TestBhvOperations110_StoreApi_GetOrderByIdPicksTheStatusSpecificErrorClass(t *testing.T) {
	t.Parallel()
	cases := []struct {
		status int
		match  func(error) bool
	}{
		{400, func(err error) bool { var e *pkgerrors.BadRequestError; return errors.As(err, &e) }},
		{401, func(err error) bool { var e *pkgerrors.UnauthorizedError; return errors.As(err, &e) }},
		{403, func(err error) bool { var e *pkgerrors.ForbiddenError; return errors.As(err, &e) }},
		{409, func(err error) bool { var e *pkgerrors.ConflictError; return errors.As(err, &e) }},
		{418, func(err error) bool { var e *pkgerrors.ClientError; return errors.As(err, &e) }},
		{422, func(err error) bool { var e *pkgerrors.UnprocessableEntityError; return errors.As(err, &e) }},
		{502, func(err error) bool { var e *pkgerrors.ServerError; return errors.As(err, &e) }},
	}
	for _, tc := range cases {
		config := {{packageName}}.NewConfigurationBuilder().
			BaseURL(fmt.Sprintf("%s/test/status/%d", chasmURL, tc.status)).
			Build()
		api := {{packageName}}.NewStoreApi({{packageName}}.NewDefaultApiClient(noRetryTransport(t)), config, nil, {{packageName}}.Credentials{})
		_, err := api.GetOrderById(context.Background(), int64(1))
		if err == nil {
			t.Fatalf("status %d: expected an error", tc.status)
		}
		if !tc.match(err) {
			t.Errorf("status %d: unexpected error class %T: %v", tc.status, err, err)
		}
	}
}

