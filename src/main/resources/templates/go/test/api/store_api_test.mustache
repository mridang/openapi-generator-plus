// A nested generic container (array of map of Category) must deserialize so its
// leaves are typed Category instances, not raw maps. The static type of the
// result already guarantees this in Go; this asserts the values decode and the
// typed fields are populated end-to-end through the operation.
func TestBhvOperations101_StoreApi_GetGroupedCategoriesDeserializesTypedLeaves(t *testing.T) {
	t.Parallel()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(`[{"a":{"id":1,"name":"Dogs"}},{"b":{"id":2,"name":"Cats"}}]`))
	}))
	defer server.Close()

	api := newStoreApiForMock(t, server)

	result, err := api.GetGroupedCategories(context.Background())
	if err != nil {
		t.Fatalf("GetGroupedCategories failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result from GetGroupedCategories")
	}
	groups := result
	if len(groups) != 2 {
		t.Fatalf("expected 2 groups, got %d", len(groups))
	}

	// result[0]["a"] must be a typed Category with its fields decoded.
	var first models.Category = groups[0]["a"]
	if first.Id == nil || *first.Id != 1 {
		t.Errorf("expected first.Id 1, got %v", first.Id)
	}
	if first.Name == nil || *first.Name != "Dogs" {
		t.Errorf("expected first.Name 'Dogs', got %v", first.Name)
	}

	second := groups[1]["b"]
	if second.Id == nil || *second.Id != 2 {
		t.Errorf("expected second.Id 2, got %v", second.Id)
	}
	if second.Name == nil || *second.Name != "Cats" {
		t.Errorf("expected second.Name 'Cats', got %v", second.Name)
	}
}

