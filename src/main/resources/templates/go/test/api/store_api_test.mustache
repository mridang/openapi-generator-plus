func newStoreApiForIntegration(t *testing.T) *{{packageName}}.StoreApi {
	t.Helper()
	config := {{packageName}}.NewConfigurationBuilder().
		BaseURL(prismURL).
		DefaultHeader("Authorization", "Bearer test-token").
		Build()
	client := {{packageName}}.NewDefaultApiClient(nil)
	return {{packageName}}.NewStoreApi(client, config, nil)
}

func newStoreApiForMock(t *testing.T, server *httptest.Server) *{{packageName}}.StoreApi {
	t.Helper()
	config := {{packageName}}.NewConfigurationBuilder().BaseURL(server.URL).Build()
	client := {{packageName}}.NewDefaultApiClient(nil)
	return {{packageName}}.NewStoreApi(client, config, nil)
}

func TestStoreApi_PlaceOrder(t *testing.T) {
	api := newStoreApiForIntegration(t)

	order := models.NewOrder()

	result, err := api.PlaceOrder(order)
	if err != nil {
		t.Fatalf("PlaceOrder failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result from PlaceOrder")
	}
}

func TestStoreApi_PlaceOrderWithHTTPInfo(t *testing.T) {
	api := newStoreApiForIntegration(t)

	order := models.NewOrder()

	result, err := api.PlaceOrderWithHTTPInfo(order)
	if err != nil {
		t.Fatalf("PlaceOrderWithHTTPInfo failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
	if result.StatusCode < 200 || result.StatusCode >= 300 {
		t.Errorf("expected 2xx status, got %d", result.StatusCode)
	}
	if result.Data == nil {
		t.Error("expected non-nil Data")
	}
	if result.RawBody == "" {
		t.Error("expected non-empty RawBody")
	}
}

