// jsonStoreServer answers every request with the given JSON body and hands the
// request to seen, so a test can assert what the operation put on the wire.
func jsonStoreServer(body string, seen func(*http.Request)) *httptest.Server {
	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		seen(r)
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(body))
	}))
}

// A named-enum ($ref) parameter reaches the wire as its declared value in the
// path, in the query and in a header, never as a Go-specific rendering of the
// type.
func TestBhvOperations122_StoreApi_GetBySwatchSendsTheEnumWireValueInPathQueryAndHeader(t *testing.T) {
	t.Parallel()
	var path, query, header string
	server := jsonStoreServer(`{"id":1,"name":"echo"}`, func(r *http.Request) {
		path = r.URL.Path
		query = r.URL.RawQuery
		header = r.Header.Get("Preferred-Swatch")
	})
	defer server.Close()

	api := newStoreApiForMock(t, server)
	querySwatch := models.SwatchGreen
	preferred := models.SwatchBlue
	result, err := api.GetBySwatch(context.Background(), models.SwatchRed, &options.GetBySwatchOptions{
		QuerySwatch:     &querySwatch,
		PreferredSwatch: &preferred,
	})
	if err != nil {
		t.Fatalf("GetBySwatch failed: %v", err)
	}
	if result == nil || result.Name == nil || *result.Name != "echo" {
		t.Errorf("expected the echoed category, got %v", result)
	}
	if path != "/store/by-swatch/red" {
		t.Errorf("expected path /store/by-swatch/red, got %q", path)
	}
	if query != "querySwatch=green" {
		t.Errorf("expected query querySwatch=green, got %q", query)
	}
	if header != "blue" {
		t.Errorf("expected header Preferred-Swatch: blue, got %q", header)
	}
}

