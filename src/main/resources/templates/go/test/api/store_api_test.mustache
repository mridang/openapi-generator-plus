// Nested containers and enum bodies decode into their typed leaves through the
// operation, not just through the serializer.
func TestStoreApi_NestedContainerOperationsDecodeTypedLeaves(t *testing.T) {
	t.Parallel()

	t.Run("matrix", func(t *testing.T) {
		t.Parallel()
		server := jsonStoreServer(`[[1,2],[3,4]]`, func(*http.Request) {})
		defer server.Close()
		result, err := newStoreApiForMock(t, server).GetMatrix(context.Background())
		if err != nil {
			t.Fatalf("GetMatrix failed: %v", err)
		}
		rows := result
		if len(rows) != 2 || len(rows[1]) != 2 || rows[1][0] != 3 {
			t.Errorf("expected [[1 2] [3 4]], got %v", rows)
		}
	})

	t.Run("swatch", func(t *testing.T) {
		t.Parallel()
		server := jsonStoreServer(`"green"`, func(*http.Request) {})
		defer server.Close()
		result, err := newStoreApiForMock(t, server).GetSwatch(context.Background())
		if err != nil {
			t.Fatalf("GetSwatch failed: %v", err)
		}
		if *result != models.SwatchGreen {
			t.Errorf("expected green, got %v", *result)
		}
	})

	t.Run("swatch groups", func(t *testing.T) {
		t.Parallel()
		server := jsonStoreServer(`[{"warm":"red"},{"cool":"blue"}]`, func(*http.Request) {})
		defer server.Close()
		result, err := newStoreApiForMock(t, server).GetSwatchGroups(context.Background())
		if err != nil {
			t.Fatalf("GetSwatchGroups failed: %v", err)
		}
		groups := result
		if len(groups) != 2 || groups[0]["warm"] != models.SwatchRed || groups[1]["cool"] != models.SwatchBlue {
			t.Errorf("expected typed swatches per group, got %v", groups)
		}
	})

	t.Run("timestamp groups", func(t *testing.T) {
		t.Parallel()
		server := jsonStoreServer(`[{"created":"2024-01-02T03:04:05.000Z"}]`, func(*http.Request) {})
		defer server.Close()
		result, err := newStoreApiForMock(t, server).GetTimestampGroups(context.Background())
		if err != nil {
			t.Fatalf("GetTimestampGroups failed: %v", err)
		}
		groups := result
		if len(groups) != 1 {
			t.Fatalf("expected 1 group, got %d", len(groups))
		}
		if got := groups[0]["created"].Time().UTC().Format("2006-01-02T15:04:05"); got != "2024-01-02T03:04:05" {
			t.Errorf("expected the timestamp to decode, got %s", got)
		}
	})

	t.Run("tree", func(t *testing.T) {
		t.Parallel()
		server := jsonStoreServer(`{"value":"root","child":{"value":"leaf"}}`, func(*http.Request) {})
		defer server.Close()
		result, err := newStoreApiForMock(t, server).GetTree(context.Background())
		if err != nil {
			t.Fatalf("GetTree failed: %v", err)
		}
		if result.Value != "root" || result.Child == nil || result.Child.Value != "leaf" {
			t.Errorf("expected root with a leaf child, got %+v", result)
		}
	})
}

