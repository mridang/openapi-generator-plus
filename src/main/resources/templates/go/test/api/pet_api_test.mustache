// petAuth implements Authenticator for PetApi integration tests.
type petAuth struct{}

func (a *petAuth) Host() string                    { return "" }
func (a *petAuth) AuthHeaders() map[string]string  { return map[string]string{"Authorization": "Bearer test-token"} }
func (a *petAuth) QueryParams() map[string]string  { return map[string]string{} }
func (a *petAuth) CookieParams() map[string]string { return map[string]string{} }

func newPetApiForIntegration(t *testing.T) *{{packageName}}.PetApi {
	t.Helper()
	config := {{packageName}}.NewConfigurationBuilder().
		BaseURL(prismURL).
		DefaultHeader("Authorization", "Bearer test-token").
		Build()
	client := {{packageName}}.NewDefaultApiClient(nil)
	return {{packageName}}.NewPetApi(client, config, nil)
}

func newPetApiForMock(t *testing.T, server *httptest.Server) *{{packageName}}.PetApi {
	t.Helper()
	config := {{packageName}}.NewConfigurationBuilder().BaseURL(server.URL).Build()
	client := {{packageName}}.NewDefaultApiClient(nil)
	return {{packageName}}.NewPetApi(client, config, nil)
}

// newTempFile returns a temp *os.File with the supplied contents, registered for cleanup.
func newTempFile(t *testing.T, contents string) *os.File {
	t.Helper()
	f, err := os.CreateTemp("", "pet-test-*")
	if err != nil {
		t.Fatalf("CreateTemp failed: %v", err)
	}
	if _, err := f.WriteString(contents); err != nil {
		t.Fatalf("write temp failed: %v", err)
	}
	if _, err := f.Seek(0, 0); err != nil {
		t.Fatalf("seek temp failed: %v", err)
	}
	t.Cleanup(func() {
		_ = f.Close()
		_ = os.Remove(f.Name())
	})
	return f
}

func TestPetApi_AddPet(t *testing.T) {
	api := newPetApiForIntegration(t)
	auth := &petAuth{}

	pet := models.NewPet("Fido", []string{"http://example.com/fido.jpg"})

	result, err := api.AddPet(auth, *pet)
	if err != nil {
		t.Fatalf("AddPet failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result from AddPet")
	}
}

func TestPetApi_AddPetWithHTTPInfo(t *testing.T) {
	api := newPetApiForIntegration(t)
	auth := &petAuth{}

	pet := models.NewPet("Buddy", []string{"http://example.com/buddy.jpg"})

	result, err := api.AddPetWithHTTPInfo(auth, *pet)
	if err != nil {
		t.Fatalf("AddPetWithHTTPInfo failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
	if result.StatusCode < 200 || result.StatusCode >= 300 {
		t.Errorf("expected 2xx status, got %d", result.StatusCode)
	}
	if result.Data == nil {
		t.Error("expected non-nil Data")
	}
	if result.RawBody == "" {
		t.Error("expected non-empty RawBody")
	}
}

