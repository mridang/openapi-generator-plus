// TestPetApi_SetPetAvatarStreamsRawBytesWithDeclaredContentType is the canonical
// binary-request-body regression (finding C1). setPetAvatar declares a request
// body of type:string format:binary with Content-Type image/jpeg, so the *os.File
// contents must go on the wire as the EXACT raw bytes under the declared
// Content-Type — never json.Marshal'd to the literal "{}", never base64-encoded,
// never a JSON int-array, and never with the Content-Type overridden to
// application/octet-stream or application/json.
func TestBhvOperations073_PetApi_SetPetAvatarStreamsRawBytesWithDeclaredContentType(t *testing.T) {
	t.Parallel()
	// A non-trivial payload: the JPEG SOI marker (0xFF 0xD8 0xFF 0xE0).
	payload := []byte{0xFF, 0xD8, 0xFF, 0xE0}

	var capturedBody []byte
	var capturedContentType string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		capturedContentType = r.Header.Get("Content-Type")
		capturedBody, _ = io.ReadAll(r.Body)
		w.WriteHeader(200)
	}))
	defer server.Close()

	api := newPetApiForMock(t, server)

	f, err := os.CreateTemp("", "pet-avatar-*")
	if err != nil {
		t.Fatalf("CreateTemp failed: %v", err)
	}
	t.Cleanup(func() {
		_ = f.Close()
		_ = os.Remove(f.Name())
	})
	if _, err := f.Write(payload); err != nil {
		t.Fatalf("write temp failed: %v", err)
	}
	if _, err := f.Seek(0, 0); err != nil {
		t.Fatalf("seek temp failed: %v", err)
	}

	if err := api.SetPetAvatar(context.Background(), int64(1), f); err != nil {
		t.Fatalf("SetPetAvatar failed: %v", err)
	}

	// (1) The body bytes must be EXACTLY the raw payload.
	if !bytes.Equal(capturedBody, payload) {
		t.Errorf("expected raw body bytes %v, got %v (string %q)", payload, capturedBody, string(capturedBody))
	}
	// (2) The Content-Type must be exactly the declared image/jpeg.
	if capturedContentType != "image/jpeg" {
		t.Errorf("expected Content-Type image/jpeg, got %q", capturedContentType)
	}
}

// TestPetApi_SetPetAvatarHonoursSelectedRequestContentType is the canonical
// optional-content-type-selector regression. setPetAvatar declares the request
// content-types image/jpeg, image/png and application/json. The generated method
// takes an OPTIONAL WithRequestContentType call option:
//
//	(1) Calling SetPetAvatar WITHOUT the option sends the FIRST declared
//	    content-type (image/jpeg) — backward compatible with prior call sites.
//	(2) Calling SetPetAvatar with the option set to "image/png" and the same
//	    raw bytes sends Content-Type: image/png (NOT image/jpeg).
func TestBhvOperations071_PetApi_SetPetAvatarHonoursSelectedRequestContentType(t *testing.T) {
	t.Parallel()
	// The same raw bytes are sent in both cases; only the header changes.
	payload := []byte{0xFF, 0xD8, 0xFF, 0xE0}

	var capturedContentType string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		capturedContentType = r.Header.Get("Content-Type")
		w.WriteHeader(200)
	}))
	defer server.Close()

	api := newPetApiForMock(t, server)

	// newTempFile resets the *os.File to the start so its contents stream as the
	// raw request body; a fresh file is used per call to avoid a consumed reader.
	makeFile := func() *os.File {
		f, err := os.CreateTemp("", "pet-avatar-*")
		if err != nil {
			t.Fatalf("CreateTemp failed: %v", err)
		}
		t.Cleanup(func() {
			_ = f.Close()
			_ = os.Remove(f.Name())
		})
		if _, err := f.Write(payload); err != nil {
			t.Fatalf("write temp failed: %v", err)
		}
		if _, err := f.Seek(0, 0); err != nil {
			t.Fatalf("seek temp failed: %v", err)
		}
		return f
	}

	// (1) No selector -> first declared content-type (image/jpeg).
	if err := api.SetPetAvatar(context.Background(), int64(1), makeFile()); err != nil {
		t.Fatalf("SetPetAvatar (default content-type) failed: %v", err)
	}
	if capturedContentType != "image/jpeg" {
		t.Errorf("expected default Content-Type image/jpeg, got %q", capturedContentType)
	}

	// (2) Selector "image/png" -> Content-Type: image/png (NOT image/jpeg).
	capturedContentType = ""
	if err := api.SetPetAvatar(context.Background(), int64(1), makeFile(), {{packageName}}.WithRequestContentType("image/png")); err != nil {
		t.Fatalf("SetPetAvatar (image/png selector) failed: %v", err)
	}
	if capturedContentType != "image/png" {
		t.Errorf("expected selected Content-Type image/png, got %q", capturedContentType)
	}
}

// A format:binary body sent with the application/json selector still goes on
// the wire as the caller's exact bytes: the selector changes only the
// Content-Type header, never routes the bytes through the JSON serializer.
func TestBhvOperations072_PetApi_SetPetAvatarSendsBinaryBytesVerbatimUnderTheJsonSelector(t *testing.T) {
	t.Parallel()
	payload := []byte{0xFF, 0xD8, 0xFF, 0xE0}

	var capturedBody []byte
	var capturedContentType string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		capturedContentType = r.Header.Get("Content-Type")
		capturedBody, _ = io.ReadAll(r.Body)
		w.WriteHeader(200)
	}))
	defer server.Close()

	api := newPetApiForMock(t, server)
	f := newTempFile(t, string(payload))

	if err := api.SetPetAvatar(context.Background(), int64(1), f, {{packageName}}.WithRequestContentType("application/json")); err != nil {
		t.Fatalf("SetPetAvatar (application/json selector) failed: %v", err)
	}
	if !bytes.Equal(capturedBody, payload) {
