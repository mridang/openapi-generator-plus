// ── Scenario 6: an operation cookie param with CR/LF fails closed (RFC 6265) ──
//
// DeletePet carries an optional api_key cookie param (DeletePetOptions.ApiKey).
// A value containing a CR/LF or other control character must be rejected with the
// RFC-6265 error BEFORE any request is sent, so it cannot be smuggled into the
// Cookie header — mirroring the auth-cookie validation assertions.
func TestBhvOperations029_PetApi_CookieParamWithCRLFFailsClosed(t *testing.T) {
	t.Parallel()
	var called bool
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		called = true
		w.WriteHeader(200)
	}))
	defer server.Close()

	api := newPetApiForMock(t, server)

	for _, bad := range []string{"abc\r\ndef", "abc\ndef", "abc\rdef", "abc\x00def"} {
		injected := bad
		err := api.DeletePet(context.Background(), int64(1), &options.DeletePetOptions{ApiKey: &injected})
		if err == nil {
			t.Fatalf("expected DeletePet to fail closed for cookie value %q", bad)
		}
		if !errors.Is(err, {{packageName}}.ErrInvalidCookie) {
			t.Errorf("expected ErrInvalidCookie for %q, got: %v", bad, err)
		}
		want := "invalid cookie: cookie value for 'api_key' contains characters forbidden by RFC 6265"
		if err.Error() != want {
			t.Errorf("cookie error for %q = %q, want %q", bad, err.Error(), want)
		}
	}
	if called {
		t.Error("expected no HTTP request to be sent when the cookie value is rejected")
	}
}

// F840: a cookie value is sent raw when every character is a legal RFC 6265
// cookie-octet (a value the caller percent-encoded stays as written), and the
// call fails before sending when one is not.
func TestBhvOperations030_PetApi_CookieParamIsSentRawOrRefusedBeforeSending(t *testing.T) {
	t.Parallel()
	var sawCookie string
	var hits int
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		sawCookie = r.Header.Get("Cookie")
		hits++
		w.WriteHeader(200)
	}))
	defer server.Close()
	api := newPetApiForMock(t, server)

	for _, ok := range []string{"abc123", "a%20b%3Bc", "a=b", "x/y:z"} {
		value := ok
		sawCookie = ""
		if err := api.DeletePet(context.Background(), int64(1), &options.DeletePetOptions{ApiKey: &value}); err != nil {
			t.Fatalf("expected %q to be accepted, got %v", ok, err)
		}
		if sawCookie != "api_key="+ok {
			t.Errorf("expected the value sent raw, got %q for %q", sawCookie, ok)
		}
	}
	sent := hits
	for _, bad := range []string{"a b", "a;b", "a,b", `a"b`, `a\b`, "caf\u00e9"} {
		value := bad
		err := api.DeletePet(context.Background(), int64(1), &options.DeletePetOptions{ApiKey: &value})
		if !errors.Is(err, {{packageName}}.ErrInvalidCookie) {
			t.Errorf("expected ErrInvalidCookie for %q, got %v", bad, err)
		}
	}
	if hits != sent {
		t.Errorf("expected no request for an illegal cookie value, %d were sent", hits-sent)
	}
}

