	t.Parallel()
	var gotAuth string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		gotAuth = r.Header.Get("Authorization")
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(`{}`))
	}))
	defer server.Close()
	bearer, _ := auth.NewPetStoreBearerAuthenticator(server.URL, "bearer-token")
	client, err := {{packageName}}.New{{clientClassName}}WithCredentials(server.URL, {{packageName}}.Credentials{PetStoreBearer: bearer}, nil)
	if err != nil {
		t.Fatal(err)
	}
	defer func() { _ = client.Close() }()

	_, _ = client.Store.GetInventory(context.Background())
	if gotAuth != "" {
		t.Errorf("expected no credential on a security-free operation, got %q", gotAuth)
	}
}

