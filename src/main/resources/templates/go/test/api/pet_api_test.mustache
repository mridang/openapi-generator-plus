func TestBhvOperations032_PetApi_DeprecatedOptionsFieldCarriesADeprecatedParagraph(t *testing.T) {
	t.Parallel()
	path := "../pkg/options/find_pets_by_status_options.go"
	file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ParseComments)
	if err != nil {
		t.Fatalf("failed to parse %s: %v", path, err)
	}
	found := false
	ast.Inspect(file, func(node ast.Node) bool {
		field, ok := node.(*ast.Field)
		if !ok || len(field.Names) == 0 || field.Names[0].Name != "Status" {
			return true
		}
		found = true
		doc := field.Doc.Text()
		if !strings.Contains(doc, "Status values that need to be considered for filter") {
			t.Errorf("expected the Status description to stay in the field doc, got %q", doc)
		}
		if !hasDeprecatedParagraph(doc) {
			t.Errorf("expected the Status field doc to have a Deprecated: paragraph, got %q", doc)
		}
		return false
	})
	if !found {
		t.Fatalf("field Status not found in %s", path)
	}
}

// A oneOf request body goes on the wire as the variant that was decoded, with
// its own fields and no wrapper around them.
func TestBhvOperations024_PetApi_AddPetTreatmentSendsTheChosenVariantAsTheBody(t *testing.T) {
	t.Parallel()
	var body string
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		raw, _ := io.ReadAll(r.Body)
		body = string(raw)
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(200)
		_, _ = w.Write([]byte(`{"drugName":"Amoxicillin","dosage":"250mg"}`))
	}))
	defer server.Close()

	var treatment models.PetTreatment
	if err := json.Unmarshal([]byte(`{"drugName":"Amoxicillin","dosage":"250mg"}`), &treatment); err != nil {
		t.Fatalf("failed to build the request body: %v", err)
	}
	api := newPetApiForMock(t, server)
	result, err := api.AddPetTreatment(context.Background(), int64(7), treatment, nil)
	if err != nil {
		t.Fatalf("AddPetTreatment failed: %v", err)
	}
	if result == nil {
		t.Fatal("expected a decoded treatment")
	}
	var sent map[string]any
	if err := json.Unmarshal([]byte(body), &sent); err != nil {
		t.Fatalf("expected a JSON request body, got %q: %v", body, err)
	}
	if sent["drugName"] != "Amoxicillin" || sent["dosage"] != "250mg" {
		t.Errorf("expected the variant's fields at the top level, got %v", sent)
	}
}

