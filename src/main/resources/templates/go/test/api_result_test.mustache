func TestBhvResults003_ApiResult_ExposesStatusCodeDataRawBodyAndHeaders(t *testing.T) {
	t.Parallel()
	data := "payload"
	headers := map[string]string{"Content-Type": "application/json"}

	result := {{packageName}}.NewApiResult[string](200, &data, `{"ok":true}`, headers)

	if result == nil {
		t.Fatal("expected non-nil ApiResult")
	}
	if result.StatusCode != 200 {
		t.Errorf("StatusCode = %d, want 200", result.StatusCode)
	}
	if result.Data == nil {
		t.Fatal("expected non-nil Data")
	}
	if *result.Data != "payload" {
		t.Errorf("Data = %q, want %q", *result.Data, "payload")
	}
	if result.RawBody != `{"ok":true}` {
		t.Errorf("RawBody = %q, want %q", result.RawBody, `{"ok":true}`)
	}
	if result.Headers["Content-Type"] != "application/json" {
		t.Errorf("Headers[Content-Type] = %q, want %q", result.Headers["Content-Type"], "application/json")
	}
}

func TestBhvResults001_ApiResult_NilDataForNoContentResponse(t *testing.T) {
	t.Parallel()
	// A 204 No Content response carries no deserialized body, so Data is nil
	// while the status, raw body, and headers are still populated.
	result := {{packageName}}.NewApiResult[string](204, nil, "", map[string]string{})

	if result.StatusCode != 204 {
		t.Errorf("StatusCode = %d, want 204", result.StatusCode)
	}
	if result.Data != nil {
		t.Errorf("Data = %v, want nil for a no-content response", result.Data)
	}
	if result.RawBody != "" {
		t.Errorf("RawBody = %q, want empty", result.RawBody)
	}
	if len(result.Headers) != 0 {
		t.Errorf("Headers = %v, want empty", result.Headers)
	}
}

func TestApiResult_HoldsStructData(t *testing.T) {
	t.Parallel()
	// ApiResult is generic over the deserialized body type, so it must carry
	// arbitrary struct payloads, not just primitives.
	type payload struct {
		ID   int
		Name string
	}
	data := payload{ID: 7, Name: "rex"}

	result := {{packageName}}.NewApiResult[payload](201, &data, "", map[string]string{"Location": "/resources/7"})

	if result.StatusCode != 201 {
		t.Errorf("StatusCode = %d, want 201", result.StatusCode)
	}
	if result.Data == nil {
		t.Fatal("expected non-nil Data")
	}
	if result.Data.ID != 7 || result.Data.Name != "rex" {
		t.Errorf("Data = %+v, want {ID:7 Name:rex}", *result.Data)
	}
	if result.Headers["Location"] != "/resources/7" {
		t.Errorf("Headers[Location] = %q, want %q", result.Headers["Location"], "/resources/7")
	}
}

