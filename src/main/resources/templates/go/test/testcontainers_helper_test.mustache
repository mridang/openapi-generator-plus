{{>api_info}}
package {{packageName}}_test

import (
	"context"
	"fmt"
	"os"
	"path/filepath"
	"testing"
	"time"

	"github.com/testcontainers/testcontainers-go"
	"github.com/testcontainers/testcontainers-go/wait"
)

var (
	proxyURL         string
	chasmURL         string
	chasmHTTPURL     string
	chasmHTTPSURL    string
	chasmInternalHTTPURL  string
	chasmInternalHTTPSURL string
	caCertPath       string
)

func TestMain(m *testing.M) {
	ctx := context.Background()
	fixturesDir, err := filepath.Abs(filepath.Join("..", "testdata"))
	if err != nil {
		fmt.Fprintf(os.Stderr, "failed to resolve fixtures dir: %v\n", err)
		os.Exit(1)
	}

	// Create shared network with a unique name to avoid conflicts
	networkName := fmt.Sprintf("proxy-network-go-%d", time.Now().UnixNano())
	network, err := testcontainers.GenericNetwork(ctx, testcontainers.GenericNetworkRequest{
		NetworkRequest: testcontainers.NetworkRequest{
			Name: networkName,
		},
	})
	if err != nil {
		fmt.Fprintf(os.Stderr, "failed to create network: %v\n", err)
		os.Exit(1)
	}

	caCertPath = filepath.Join(fixturesDir, "certs", "ca.pem")

	// Start Squid container
	squidConfPath := filepath.Join(fixturesDir, "proxy", "squid.conf")

	squidReq := testcontainers.ContainerRequest{
		Image:        "ubuntu/squid:5.2-22.04_beta",
		ExposedPorts: []string{"3128/tcp"},
		Files: []testcontainers.ContainerFile{
			{HostFilePath: squidConfPath, ContainerFilePath: "/etc/squid/squid.conf"},
		},
		Networks: []string{networkName},
		WaitingFor: wait.ForListeningPort("3128/tcp").WithStartupTimeout(120 * time.Second),
	}

	squidContainer, err := testcontainers.GenericContainer(ctx, testcontainers.GenericContainerRequest{
		ContainerRequest: squidReq,
		Started:          true,
	})
	if err != nil {
		fmt.Fprintf(os.Stderr, "failed to start Squid: %v\n", err)
		os.Exit(1)
	}

	time.Sleep(3 * time.Second)

	squidHost, _ := squidContainer.Host(ctx)
	squidPort, _ := squidContainer.MappedPort(ctx, "3128/tcp")
	proxyURL = fmt.Sprintf("http://%s:%s", squidHost, squidPort.Port())

	// Start Chasm container
	specPath := filepath.Join(fixturesDir, "openapi.yaml")
	chasmCertPath := filepath.Join(fixturesDir, "certs", "server.pem")
	chasmKeyPath := filepath.Join(fixturesDir, "certs", "server-key.pem")

	chasmReq := testcontainers.ContainerRequest{
		Image:        "mridang/chasm:1.3.0",
		ExposedPorts: []string{"4010/tcp", "8443/tcp"},
		Files: []testcontainers.ContainerFile{
			{HostFilePath: specPath, ContainerFilePath: "/openapi.yaml", FileMode: 0o644},
			{HostFilePath: chasmCertPath, ContainerFilePath: "/certs/cert.pem", FileMode: 0o644},
			{HostFilePath: chasmKeyPath, ContainerFilePath: "/certs/key.pem", FileMode: 0o644},
		},
		Cmd: []string{
			"mock", "/openapi.yaml", "--host", "0.0.0.0",
			"--tls-cert", "/certs/cert.pem",
			"--tls-key", "/certs/key.pem",
			"--tls-port", "8443",
		},
		Networks:       []string{networkName},
		NetworkAliases: map[string][]string{networkName: {"chasm"}},
		WaitingFor:     wait.ForLog("Listening on").WithStartupTimeout(120 * time.Second),
	}

	chasmContainer, err := testcontainers.GenericContainer(ctx, testcontainers.GenericContainerRequest{
		ContainerRequest: chasmReq,
		Started:          true,
	})
	if err != nil {
		fmt.Fprintf(os.Stderr, "failed to start Chasm: %v\n", err)
		os.Exit(1)
	}

	chasmHost, _ := chasmContainer.Host(ctx)
	chasmPort, _ := chasmContainer.MappedPort(ctx, "4010/tcp")
	chasmHTTPSPort, _ := chasmContainer.MappedPort(ctx, "8443/tcp")
	chasmURL = fmt.Sprintf("http://%s:%s", chasmHost, chasmPort.Port())
	chasmHTTPURL = fmt.Sprintf("http://%s:%s", chasmHost, chasmPort.Port())
	chasmHTTPSURL = fmt.Sprintf("https://%s:%s", chasmHost, chasmHTTPSPort.Port())
	chasmInternalHTTPURL = "http://chasm:4010"
	chasmInternalHTTPSURL = "https://chasm:8443"

	// Run tests
	code := m.Run()

	// Cleanup
	_ = chasmContainer.Terminate(ctx)
	_ = squidContainer.Terminate(ctx)
	_ = network.Remove(ctx)

	os.Exit(code)
}
