	}
	if got, want := attributeMap(histogram.DataPoints[0].Attributes.ToSlice()), attributeMap(span.Attributes()); fmt.Sprint(got) != fmt.Sprint(want) {
		t.Errorf("expected the span's attributeMap %v, got %v", want, got)
	}
}

