const otelPetBody = `{"id":1,"name":"Test","photoUrls":[]}`

// otelStubClient is the transport of these tests: it records the headers of each
// send and answers from a script (the last reply repeats).
type otelStubClient struct {
	mu      sync.Mutex
	sent    []map[string]string
	replies []otelStubReply
}

type otelStubReply struct {
	status int
	body   string
	err    error
}

func (c *otelStubClient) SendRequest(method, url string, headers map[string]string, body any) (*{{packageName}}.ApiHttpResponse, error) {
	return c.SendRequestWithOptions(method, url, headers, body, nil)
}

func (c *otelStubClient) SendRequestWithOptions(method, url string, headers map[string]string, body any, opts *{{packageName}}.RequestOptions) (*{{packageName}}.ApiHttpResponse, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	copied := make(map[string]string, len(headers))
	for k, v := range headers {
		copied[k] = v
	}
	c.sent = append(c.sent, copied)
	reply := c.replies[min(len(c.sent)-1, len(c.replies)-1)]
	if reply.err != nil {
		return nil, reply.err
	}
	return &{{packageName}}.ApiHttpResponse{
		StatusCode: reply.status,
		Body:       reply.body,
		Headers:    map[string]string{"content-type": "application/json"},
	}, nil
}

func (c *otelStubClient) Close() error { return nil }

// otelHarness is a hook on in-memory providers and an API that uses it.
type otelHarness struct {
	spans  *tracetest.SpanRecorder
	reader *sdkmetric.ManualReader
	tracer *sdktrace.TracerProvider
	hook   {{packageName}}.CallHook
	stub   *otelStubClient
	api    *{{packageName}}.PetApi
}

func newOtelHarness(t *testing.T, replies ...otelStubReply) *otelHarness {
	t.Helper()
	h := &otelHarness{
		spans:  tracetest.NewSpanRecorder(),
		reader: sdkmetric.NewManualReader(),
		stub:   &otelStubClient{replies: replies},
	}
	h.tracer = sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(h.spans))
	meters := sdkmetric.NewMeterProvider(sdkmetric.WithReader(h.reader))
	h.hook = otelhook.New(
		otelhook.WithTracerProvider(h.tracer),
		otelhook.WithMeterProvider(meters),
		otelhook.WithPropagator(propagation.TraceContext{}),
	)
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080").CallHook(h.hook).Build()
	h.api = {{packageName}}.NewPetApi(h.stub, config, nil, {{packageName}}.Credentials{})
	return h
}

func (h *otelHarness) get(t *testing.T) error {
	t.Helper()
	_, err := h.api.GetPetById(context.Background(), int64(1), nil)
	return err
}

func (h *otelHarness) span(t *testing.T) sdktrace.ReadOnlySpan {
	t.Helper()
	ended := h.spans.Ended()
	if len(ended) != 1 {
		t.Fatalf("expected one span, got %d", len(ended))
	}
	return ended[0]
}

func attributeMap(kvs []attribute.KeyValue) map[string]string {
	out := map[string]string{}
	for _, kv := range kvs {
		out[string(kv.Key)] = kv.Value.String()
	}
	return out
}

func (h *otelHarness) metrics(t *testing.T) (metricdata.ResourceMetrics, map[string]metricdata.Metrics) {
	t.Helper()
	var rm metricdata.ResourceMetrics
	if err := h.reader.Collect(context.Background(), &rm); err != nil {
		t.Fatal(err)
	}
	byName := map[string]metricdata.Metrics{}
	for _, scope := range rm.ScopeMetrics {
		for _, m := range scope.Metrics {
			byName[m.Name] = m
		}
	}
	return rm, byName
}

func otelOkReply() otelStubReply { return otelStubReply{status: 200, body: otelPetBody} }

func TestBhvTelemetry001_OtelHook_TheSpanIsNamedWithTheSpecOperationIdAndHasKindClient(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelOkReply())
	if err := h.get(t); err != nil {
		t.Fatal(err)
	}
	span := h.span(t)
	if span.Name() != "getPetById" || span.SpanKind() != trace.SpanKindClient {
		t.Errorf("expected a client span named getPetById, got %q %v", span.Name(), span.SpanKind())
	}
}

func TestBhvTelemetry002_OtelHook_A2xxSetsTheRequestAttributesAndLeavesTheSpanStatusUnset(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelOkReply())
	if err := h.get(t); err != nil {
		t.Fatal(err)
	}
	span := h.span(t)
	got := attributeMap(span.Attributes())
	want := map[string]string{
		"http.request.method":       "GET",
		"url.template":              "/pet/{petId}",
		"server.address":            "127.0.0.1",
		"http.response.status_code": "200",
	}
	if fmt.Sprint(got) != fmt.Sprint(want) {
		t.Errorf("expected %v, got %v", want, got)
	}
	if span.Status().Code != codes.Unset {
		t.Errorf("expected an unset status, got %v", span.Status().Code)
	}
}

func TestBhvTelemetry003_OtelHook_A4xxOr5xxSetsErrorTypeToTheStatusAndMarksTheSpanAsAnError(t *testing.T) {
	t.Parallel()
	for _, status := range []int{404, 503} {
		h := newOtelHarness(t, otelStubReply{status: status, body: `{"message":"x"}`})
		if err := h.get(t); err == nil {
			t.Fatalf("expected an error for %d", status)
		}
		span := h.span(t)
		if got := attributeMap(span.Attributes())["error.type"]; got != fmt.Sprint(status) {
			t.Errorf("expected error.type %d, got %q", status, got)
		}
		if span.Status().Code != codes.Error {
			t.Errorf("expected an error status for %d, got %v", status, span.Status().Code)
		}
	}
}

func TestBhvTelemetry004_OtelHook_ErrorTypeIsATokenForTheTimeoutNetworkDecodeCancelAndAnyOtherError(t *testing.T) {
	t.Parallel()
	cases := map[string]otelStubReply{
		"timeout":             {err: apierrors.NewNetworkTimeoutError("timed out", nil)},
		"network_error":       {err: apierrors.NewNetworkError("refused", nil)},
		"serialization_error": {status: 200, body: `{"id": [1`},
		"cancelled":           {err: fmt.Errorf("request cancelled: %w", context.Canceled)},
		"_OTHER":              {err: errors.New("boom")},
	}
	for want, reply := range cases {
		h := newOtelHarness(t, reply)
		if err := h.get(t); err == nil {
			t.Fatalf("expected an error for %s", want)
		}
		span := h.span(t)
		if got := attributeMap(span.Attributes())["error.type"]; got != want {
			t.Errorf("expected error.type %q, got %q", want, got)
		}
		if span.Status().Code != codes.Error {
			t.Errorf("expected an error status for %s, got %v", want, span.Status().Code)
		}
	}
}

