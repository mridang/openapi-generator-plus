// The core trace context is registered here as well, so the test also proves
// that the header ends up naming the client span; the registration is global,
// hence the test does not run in parallel.
func TestBhvTelemetry006_OtelHook_TheSpanIsAChildOfTheCallersSpanAndTheTraceparentSentNamesTheClientSpan(t *testing.T) {
	{{packageName}}.SetTraceContextPropagator(func(ctx context.Context, headers map[string]string) {
		propagation.TraceContext{}.Inject(ctx, propagation.MapCarrier(headers))
	})
	t.Cleanup(func() { {{packageName}}.SetTraceContextPropagator(nil) })
	h := newOtelHarness(t, otelOkReply())
	parentContext, parent := h.tracer.Tracer("caller").Start(context.Background(), "parent")

	if _, err := h.api.GetPetById(parentContext, int64(1), nil); err != nil {
		t.Fatal(err)
	}
	parent.End()

	var client sdktrace.ReadOnlySpan
	for _, span := range h.spans.Ended() {
		if span.Name() == "getPetById" {
			client = span
		}
	}
	if client == nil || client.Parent().SpanID() != parent.SpanContext().SpanID() {
		t.Fatalf("expected the client span to be a child of the caller's span")
	}
	count := 0
	for name, value := range h.stub.sent[0] {
		if strings.EqualFold(name, "traceparent") {
			count++
			if !strings.Contains(value, client.SpanContext().SpanID().String()) {
				t.Errorf("expected the traceparent to name the client span, got %q", value)
			}
		}
	}
	if count != 1 {
		t.Errorf("expected one traceparent, got %d", count)
	}
}

func TestBhvTelemetry007_OtelHook_ACallRetriedByTheTransportRecordsOneSpanAndOneCount(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelOkReply())
	// The hook sits above the transport: however many sends happen below it, the
	// call is one. A replay after a 401 is the retry the stub can show.
	h.api = {{packageName}}.NewPetApi(&otelReplayClient{otelStubClient: h.stub}, {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080").CallHook(h.hook).Build(), nil, {{packageName}}.Credentials{})
	if err := h.get(t); err != nil {
		t.Fatal(err)
	}
	h.span(t)
	_, byName := h.metrics(t)
	sum := byName["http.client.request.count"].Data.(metricdata.Sum[int64])
	if len(sum.DataPoints) != 1 || sum.DataPoints[0].Value != 1 {
		t.Errorf("expected one count, got %+v", sum.DataPoints)
	}
	if got := len(h.stub.sent); got != 2 {
		t.Errorf("expected the transport to send twice, got %d", got)
	}
}

// otelReplayClient sends every request twice and returns the second answer, the way a
// transport that retries does.
type otelReplayClient struct{ *otelStubClient }

func (c *otelReplayClient) SendRequestWithOptions(method, url string, headers map[string]string, body any, opts *{{packageName}}.RequestOptions) (*{{packageName}}.ApiHttpResponse, error) {
	_, _ = c.otelStubClient.SendRequestWithOptions(method, url, headers, body, opts)
	return c.otelStubClient.SendRequestWithOptions(method, url, headers, body, opts)
}

func TestBhvTelemetry008_OtelHook_TheRequestCountIsIncrementedOncePerCallWithTheAttributesOfTheSpan(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelStubReply{status: 404, body: `{}`})
	callerContext, caller := h.tracer.Tracer("caller").Start(context.Background(), "caller")
	_, _ = h.api.GetPetById(callerContext, int64(1), nil)
	caller.End()
	var span sdktrace.ReadOnlySpan
	for _, ended := range h.spans.Ended() {
		if ended.Name() == "getPetById" {
			span = ended
		}
	}
	if span == nil {
		t.Fatal("expected the client span")
	}
	_, byName := h.metrics(t)
	count := byName["http.client.request.count"]
	sum := count.Data.(metricdata.Sum[int64])
	if count.Unit != "{request}" || len(sum.DataPoints) != 1 || sum.DataPoints[0].Value != 1 {
		t.Fatalf("expected one count in {request}, got %+v", count)
	}
	if got, want := attributeMap(sum.DataPoints[0].Attributes.ToSlice()), attributeMap(span.Attributes()); fmt.Sprint(got) != fmt.Sprint(want) {
		t.Errorf("expected the span's attributeMap %v, got %v", want, got)
	}
	// The count is recorded in the caller's context, so its exemplar names the caller's span.
	want := caller.SpanContext().SpanID()
	if exemplars := sum.DataPoints[0].Exemplars; len(exemplars) != 1 || !bytes.Equal(exemplars[0].SpanID, want[:]) {
		t.Errorf("expected one exemplar naming the caller's span %s, got %+v", want, exemplars)
	}
}

func TestBhvTelemetry009_OtelHook_TheDurationHistogramRecordsOneValueInSecondsWithTheAttributesOfTheSpan(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelOkReply())
	if err := h.get(t); err != nil {
		t.Fatal(err)
	}
	span := h.span(t)
