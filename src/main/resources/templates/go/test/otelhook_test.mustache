// The global providers are replaced here, so the tests that do it run one after
// the other.
func TestBhvTelemetry011_OtelHook_AProviderHandedToTheAdapterIsUsedInsteadOfTheGlobalOne(t *testing.T) {
	global := tracetest.NewSpanRecorder()
	otel.SetTracerProvider(sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(global)))
	t.Cleanup(func() { otel.SetTracerProvider(noop.NewTracerProvider()) })
	h := newOtelHarness(t, otelOkReply())

	if err := h.get(t); err != nil {
		t.Fatal(err)
	}
	h.span(t)
	if got := len(global.Ended()); got != 0 {
		t.Errorf("expected the global provider unused, got %d spans", got)
	}

	stub := &otelStubClient{replies: []otelStubReply{otelOkReply()}}
	fromGlobal := otelhook.New(otelhook.WithPropagator(propagation.TraceContext{}))
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080").CallHook(fromGlobal).Build()
	if _, err := {{packageName}}.NewPetApi(stub, config, nil, {{packageName}}.Credentials{}).GetPetById(context.Background(), int64(1), nil); err != nil {
		t.Fatal(err)
	}
	if got := len(global.Ended()); got != 1 {
		t.Errorf("expected the global provider used when none is handed over, got %d spans", got)
	}
}

func TestBhvTelemetry012_OtelHook_WithNoProviderConfiguredTheAdapterDoesNothingAndTheCallIsUnchanged(t *testing.T) {
	otel.SetTracerProvider(noop.NewTracerProvider())
	stub := &otelStubClient{replies: []otelStubReply{otelOkReply()}}
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080").CallHook(otelhook.New()).Build()
	api := {{packageName}}.NewPetApi(stub, config, nil, {{packageName}}.Credentials{})

	pet, err := api.GetPetById(context.Background(), int64(1), nil)

	if err != nil || pet == nil || pet.Name != "Test" {
		t.Fatalf("expected the unchanged result, got %v, %v", pet, err)
	}
	for name := range stub.sent[0] {
		if strings.EqualFold(name, "traceparent") {
			t.Errorf("expected no traceparent without a provider, got %v", stub.sent[0])
		}
	}
}

// countingTracerProvider counts the End calls of the spans it starts.
type countingTracerProvider struct {
	embedded.TracerProvider
	inner trace.TracerProvider
	ends  *atomic.Int32
}

func (p countingTracerProvider) Tracer(name string, opts ...trace.TracerOption) trace.Tracer {
	return countingTracer{inner: p.inner.Tracer(name, opts...), ends: p.ends}
}

type countingTracer struct {
	embedded.Tracer
	inner trace.Tracer
	ends  *atomic.Int32
}

func (c countingTracer) Start(ctx context.Context, name string, opts ...trace.SpanStartOption) (context.Context, trace.Span) {
	ctx, span := c.inner.Start(ctx, name, opts...)
	return ctx, countingSpan{Span: span, ends: c.ends}
}

type countingSpan struct {
	trace.Span
	ends *atomic.Int32
}

func (s countingSpan) End(opts ...trace.SpanEndOption) {
	s.ends.Add(1)
	s.Span.End(opts...)
}

func TestBhvTelemetry013_OtelHook_TheSpanEndsExactlyOnceAlsoWhenTheCallFails(t *testing.T) {
	t.Parallel()
	for _, reply := range []otelStubReply{otelOkReply(), {err: apierrors.NewNetworkError("refused", nil)}, {status: 500, body: `{}`}} {
		var ends atomic.Int32
		tracer := countingTracerProvider{inner: sdktrace.NewTracerProvider(), ends: &ends}
		hook := otelhook.New(otelhook.WithTracerProvider(tracer), otelhook.WithMeterProvider(sdkmetric.NewMeterProvider()))
		config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080").CallHook(hook).Build()
		api := {{packageName}}.NewPetApi(&otelStubClient{replies: []otelStubReply{reply}}, config, nil, {{packageName}}.Credentials{})

		_, _ = api.GetPetById(context.Background(), int64(1), nil)

		if got := ends.Load(); got != 1 {
			t.Errorf("expected the span to end once for %+v, got %d", reply, got)
		}
	}
}

func TestBhvTelemetry014_OtelHook_NoAttributeCarriesAQueryStringAHeaderValueOrACredential(t *testing.T) {
	t.Parallel()
	h := newOtelHarness(t, otelStubReply{status: 200, body: `[]`})
	config := {{packageName}}.NewConfigurationBuilder().BaseURL("http://127.0.0.1:8080/base").DefaultHeader("X-Custom", "header-value-1").CallHook(h.hook).Build()
	api := {{packageName}}.NewPetApi(h.stub, config, otelBearer{}, {{packageName}}.Credentials{})
	status := options.FindPetsByStatusStatusSold

	if _, err := api.FindPetsByStatus(context.Background(), &options.FindPetsByStatusOptions{Status: &status}); err != nil {
		t.Fatal(err)
	}

	span := h.span(t)
	_, byName := h.metrics(t)
	var all []string
	for k, v := range attributeMap(span.Attributes()) {
		all = append(all, k+"="+v)
	}
	for _, m := range byName {
		switch data := m.Data.(type) {
		case metricdata.Sum[int64]:
			for _, point := range data.DataPoints {
				for k, v := range attributeMap(point.Attributes.ToSlice()) {
					all = append(all, k+"="+v)
				}
			}
		case metricdata.Histogram[float64]:
			for _, point := range data.DataPoints {
				for k, v := range attributeMap(point.Attributes.ToSlice()) {
					all = append(all, k+"="+v)
				}
			}
		}
	}
	for _, text := range all {
		for _, forbidden := range []string{"?", "sold", "header-value-1", "secret-credential"} {
			if strings.Contains(text, forbidden) {
				t.Errorf("attribute %q carries %q", text, forbidden)
			}
		}
	}
}

// otelBearer is an authenticator whose credential must never reach an attribute.
type otelBearer struct{}

func (otelBearer) Host() string                    { return "" }
func (otelBearer) AuthHeaders() map[string]string  { return map[string]string{"Authorization": "Bearer secret-credential"} }
func (otelBearer) QueryParams() map[string]string  { return nil }
func (otelBearer) CookieParams() map[string]string { return nil }
