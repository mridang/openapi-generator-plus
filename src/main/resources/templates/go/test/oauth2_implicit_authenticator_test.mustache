package {{packageName}}_test

import (
	"strings"
	"testing"

	"{{packageName}}/pkg/auth/oauth"
)

func createImplicitAuthenticator() *oauth.OAuth2ImplicitAuthenticator {
	return oauth.NewOAuth2ImplicitAuthenticator(
		"https://api.example.com",
		"my-client-id",
		"https://auth.example.com/authorize",
		[]string{"read", "write"},
	)
}

func TestOAuth2Implicit_BuildsAuthorizationUrlWithResponseTypeToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	url := auth.BuildAuthorizationURL("")

	if !strings.Contains(url, "response_type=token") {
		t.Errorf("expected URL to contain response_type=token, got %q", url)
	}
	if !strings.HasPrefix(url, "https://auth.example.com/authorize?") {
		t.Errorf("expected URL to start with authorization endpoint, got %q", url)
	}
}

func TestOAuth2Implicit_BuildsAuthorizationUrlWithClientId(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	url := auth.BuildAuthorizationURL("")

	if !strings.Contains(url, "client_id=my-client-id") {
		t.Errorf("expected URL to contain client_id=my-client-id, got %q", url)
	}
}

func TestOAuth2Implicit_BuildsAuthorizationUrlWithScopes(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	url := auth.BuildAuthorizationURL("")

	if !strings.Contains(url, "scope=read") {
		t.Errorf("expected URL to contain scope with read, got %q", url)
	}
}

func TestOAuth2Implicit_BuildsAuthorizationUrlWithState(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	url := auth.BuildAuthorizationURL("my-state")

	if !strings.Contains(url, "state=my-state") {
		t.Errorf("expected URL to contain state=my-state, got %q", url)
	}
}

func TestOAuth2Implicit_GetAuthHeadersReturnsBearerAfterSetAccessToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	auth.SetAccessToken("implicit-tok")

	headers := auth.AuthHeaders()

	if headers["Authorization"] != "Bearer implicit-tok" {
		t.Errorf("expected Authorization 'Bearer implicit-tok', got %q", headers["Authorization"])
	}
}

func TestOAuth2Implicit_ThrowsWhenAccessTokenNotSet(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	defer func() {
		if r := recover(); r == nil {
			t.Fatal("expected panic when access token not set")
		}
	}()

	auth.AuthHeaders()
}

func TestOAuth2Implicit_GetHostReturnsConfiguredHost(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	if auth.Host() != "https://api.example.com" {
		t.Errorf("expected host 'https://api.example.com', got %q", auth.Host())
	}
}
