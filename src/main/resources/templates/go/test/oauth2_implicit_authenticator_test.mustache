// The printed form names the non-secret fields.
func TestBhvAuthoauthtwoimplicit011_OAuth2ImplicitAuthenticator_ReprShowsTheNonSecretFields(t *testing.T) {
	t.Parallel()
	repr := createImplicitAuthenticator().String()
	for _, want := range []string{
		`host: "https://api.example.com"`,
		`clientID: "my-client-id"`,
		`authorizationURL: "https://auth.example.com/authorize"`,
		`scopes: ["read" "write"]`,
	} {
