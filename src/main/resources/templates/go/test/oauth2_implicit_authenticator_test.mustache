func TestOAuth2Implicit_GetAuthHeadersReturnsBearerAfterSetAccessToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("implicit-tok"); err != nil {
		t.Fatalf("unexpected error from SetAccessToken: %v", err)
	}

	headers := auth.AuthHeaders()

	if headers["Authorization"] != "Bearer implicit-tok" {
		t.Errorf("expected Authorization 'Bearer implicit-tok', got %q", headers["Authorization"])
	}
}

// A request made before SetAccessToken is a wrong call order: the sentinel is
// returned, never a panic, and AuthHeaders degrades to an empty map.
func TestOAuth2Implicit_ReturnsErrAccessTokenNotSetBeforeSetAccessToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	headers, err := auth.AuthHeadersOrError()
	if !errors.Is(err, oauth.ErrAccessTokenNotSet) {
		t.Fatalf("expected ErrAccessTokenNotSet, got %v", err)
	}
	if headers != nil {
		t.Errorf("expected no headers, got %v", headers)
	}
	if got := auth.AuthHeaders(); len(got) != 0 {
		t.Errorf("expected AuthHeaders to be empty before SetAccessToken, got %v", got)
	}
}

// F-A5-04: a token that would inject a header is rejected with
// ErrInvalidAccessToken, never a panic, and the previous token is kept.
func TestOAuth2Implicit_SetAccessTokenRejectsInvalidToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	for _, bad := range []string{"tok\r\nInjected: yes", "ñoño", "tok\x00"} {
		if err := auth.SetAccessToken(bad); !errors.Is(err, oauth.ErrInvalidAccessToken) {
			t.Errorf("expected ErrInvalidAccessToken for %q, got %v", bad, err)
		}
	}
	if _, err := auth.AuthHeadersOrError(); !errors.Is(err, oauth.ErrAccessTokenNotSet) {
		t.Errorf("an invalid token must not be stored, got %v", err)
	}
}

func TestOAuth2ImplicitRedactsSecret(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("implicit-tok"); err != nil {
		t.Fatalf("unexpected error from SetAccessToken: %v", err)
	}
	for _, s := range []string{auth.String(), fmt.Sprintf("%v", auth), fmt.Sprintf("%+v", auth)} {
		if strings.Contains(s, "implicit-tok") {
			t.Errorf("expected access token to be redacted, got %q", s)
		}
		if !strings.Contains(s, "***") {
			t.Errorf("expected redaction marker '***', got %q", s)
		}
	}
}

func TestOAuth2Implicit_GetHostReturnsConfiguredHost(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	if auth.Host() != "https://api.example.com" {
		t.Errorf("expected host 'https://api.example.com', got %q", auth.Host())
	}
}
