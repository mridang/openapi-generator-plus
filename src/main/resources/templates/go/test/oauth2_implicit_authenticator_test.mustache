func TestBhvAuthoauthtwoimplicit007_OAuth2ImplicitAuthenticator_GetAuthHeadersReturnsBearerAfterSetAccessToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("implicit-tok"); err != nil {
		t.Fatalf("unexpected error from SetAccessToken: %v", err)
	}

	headers := auth.AuthHeaders()

	if headers["Authorization"] != "Bearer implicit-tok" {
		t.Errorf("expected Authorization 'Bearer implicit-tok', got %q", headers["Authorization"])
	}
}

// A request made before SetAccessToken is a wrong call order: the sentinel is
// returned, never a panic, and AuthHeaders degrades to an empty map.
func TestBhvAuthoauthtwoimplicit012_OAuth2ImplicitAuthenticator_ThrowsWhenAccessTokenNotSet(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()

	headers, err := auth.AuthHeadersOrError()
	if !errors.Is(err, oauth.ErrAccessTokenNotSet) {
		t.Fatalf("expected ErrAccessTokenNotSet, got %v", err)
	}
	if !strings.Contains(err.Error(), "oauth2 implicit: must set the access token before making API requests") {
		t.Errorf("expected harmonized not-set message, got %v", err)
	}
	if headers != nil {
		t.Errorf("expected no headers, got %v", headers)
	}
	if got := auth.AuthHeaders(); len(got) != 0 {
		t.Errorf("expected AuthHeaders to be empty before SetAccessToken, got %v", got)
	}
}

// A non-ASCII access token is refused with the RFC 7230 message.
// An access token may contain a horizontal tab (RFC 7230 §3.2.6 allows it in a
// field value), and the Bearer header carries it unchanged.
func TestBhvAuthoauthtwoimplicit016_OAuth2ImplicitAuthenticator_SetAccessTokenAcceptsATab(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("tok\tvalue"); err != nil {
		t.Fatalf("expected a token with a tab to be accepted, got %v", err)
	}
	if got, want := auth.AuthHeaders()["Authorization"], "Bearer tok\tvalue"; got != want {
		t.Errorf("expected %q, got %q", want, got)
	}
}

func TestBhvAuthoauthtwoimplicit014_OAuth2ImplicitAuthenticator_SetAccessTokenRejectsNonAsciiWithTheRfc7230Message(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("caf\u00e9"); !errors.Is(err, oauth.ErrInvalidAccessToken) {
		t.Fatalf("expected ErrInvalidAccessToken, got %v", err)
	} else if want := "access token must contain only printable ASCII characters (RFC 7230 §3.2.6)"; err.Error() != want {
		t.Errorf("expected message %q, got %q", want, err.Error())
	}
}

// F-A5-04: a token that would inject a header is rejected with
// ErrInvalidAccessToken, never a panic, and the previous token is kept.
func TestBhvAuthoauthtwoimplicit013_OAuth2ImplicitAuthenticator_SetAccessTokenRejectsInvalidToken(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	for _, bad := range []string{"tok\r\nInjected: yes", "ñoño", "tok\x00"} {
		if err := auth.SetAccessToken(bad); !errors.Is(err, oauth.ErrInvalidAccessToken) {
			t.Errorf("expected ErrInvalidAccessToken for %q, got %v", bad, err)
		} else if want := "access token must contain only printable ASCII characters (RFC 7230 §3.2.6)"; err.Error() != want {
			t.Errorf("expected message %q for %q, got %q", want, bad, err.Error())
		}
	}
	if _, err := auth.AuthHeadersOrError(); !errors.Is(err, oauth.ErrAccessTokenNotSet) {
		t.Errorf("an invalid token must not be stored, got %v", err)
	}
}

func TestBhvAuthoauthtwoimplicit010_OAuth2ImplicitAuthenticator_RedactsSecret(t *testing.T) {
	t.Parallel()
	auth := createImplicitAuthenticator()
	if err := auth.SetAccessToken("implicit-tok"); err != nil {
		t.Fatalf("unexpected error from SetAccessToken: %v", err)
	}
	for _, s := range []string{auth.String(), fmt.Sprintf("%v", auth), fmt.Sprintf("%+v", auth), fmt.Sprintf("%#v", auth)} {
		if strings.Contains(s, "implicit-tok") {
