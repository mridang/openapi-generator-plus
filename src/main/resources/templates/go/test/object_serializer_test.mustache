// DeserializationErrorWrappingTests

func TestDeserializationError_TruncatedJsonReturnsSerializationError(t *testing.T) {
	var result map[string]interface{}
	err := {{packageName}}.Deserialize([]byte("{"), &result)
	if err == nil {
		t.Fatal("expected error for truncated JSON")
	}
	if _, ok := err.(*{{packageName}}.SerializationError); !ok {
		t.Errorf("expected *SerializationError, got %T: %v", err, err)
	}
}

func TestDeserializationError_InvalidJsonReturnsSerializationError(t *testing.T) {
	var result map[string]interface{}
	err := {{packageName}}.Deserialize([]byte(`"hello"`), &result)
	if err == nil {
		t.Fatal("expected error for invalid JSON for map target")
	}
	if _, ok := err.(*{{packageName}}.SerializationError); !ok {
		t.Errorf("expected *SerializationError, got %T: %v", err, err)
	}
}

func TestDeserializationError_ErrorHasCause(t *testing.T) {
	var result map[string]interface{}
	err := {{packageName}}.Deserialize([]byte("{"), &result)
	if err == nil {
		t.Fatal("expected error for truncated JSON")
	}
	serErr, ok := err.(*{{packageName}}.SerializationError)
	if !ok {
		t.Fatalf("expected *SerializationError, got %T", err)
	}
	if serErr.Cause == nil {
		t.Error("SerializationError should have a non-nil Cause")
	}
}

func TestSerialize_IncludesFieldsSetToDefaultValues(t *testing.T) {
	id := int64(0)
	name := ""
	category := models.Category{Id: &id, Name: &name}
	data, err := {{packageName}}.Serialize(category)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if !strings.Contains(string(data), "\"id\":0") {
		t.Errorf("serialized JSON should include id=0, got: %s", string(data))
	}
	if !strings.Contains(string(data), "\"name\":\"\"") {
		t.Errorf("serialized JSON should include empty name, got: %s", string(data))
	}
}
