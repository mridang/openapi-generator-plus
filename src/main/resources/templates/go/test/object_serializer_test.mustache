func TestSerialize_MapToJSON(t *testing.T) {
	input := map[string]interface{}{
		"name": "Fido",
		"age":  3,
	}

	data, err := {{packageName}}.Serialize(input)
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if len(data) == 0 {
		t.Fatal("expected non-empty serialized data")
	}

	var parsed map[string]interface{}
	if err := json.Unmarshal(data, &parsed); err != nil {
		t.Fatalf("failed to parse serialized JSON: %v", err)
	}
	if parsed["name"] != "Fido" {
		t.Errorf("expected name 'Fido', got %v", parsed["name"])
	}
}

