func TestSerialize_InvalidType(t *testing.T) {
	// Channels cannot be serialized to JSON
	ch := make(chan int)
	_, err := {{packageName}}.Serialize(ch)
	if err == nil {
		t.Fatal("expected error for non-serializable type")
	}
}

