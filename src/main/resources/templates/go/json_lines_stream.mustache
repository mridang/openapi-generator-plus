package {{packageName}}

import (
	"errors"
	"fmt"
	"io"
	"iter"
	"strings"
	"sync/atomic"
)

// JsonLinesStream is the body of a JSON Lines response, decoded one item per
// line as it arrives. An operation whose success response is JSON Lines
// (application/x-ndjson, application/jsonl, application/jsonlines) returns one
// from its <Operation>Stream method.
//
// Range over All to read the items; leaving the loop early, or reaching its end,
// closes the stream and releases the connection. Blank lines are skipped, CRLF
// line ends and a last line without a line end are accepted. A line that does not
// decode, and a line longer than the limit (WithMaxEventBytes, 1 MiB), end the
// stream with a *SerializationError that names the line. A failure after the
// headers is a *StreamError, a silence longer than the idle timeout a
// *NetworkTimeoutError. Close is idempotent, and closing the client cancels the
// stream.
//
// String shows the status code and the number of lines read, never the headers,
// the URL or the data.
type JsonLinesStream[T any] struct {
	source     *ApiStreamResponse
	lines      *lineReader
	decode     func(string) (T, error)
	method     string
	path       string
	lineNumber atomic.Int64
	done       bool
	closed     atomic.Bool
}

func newJsonLinesStream[T any](source *ApiStreamResponse, decode func(string) (T, error), maxLineBytes int, method, path string) *JsonLinesStream[T] {
	return &JsonLinesStream[T]{
		source: source,
		lines:  newLineReader(source.Body, maxLineBytes),
		decode: decode,
		method: method,
		path:   path,
	}
}

// StatusCode returns the HTTP status code of the response.
func (s *JsonLinesStream[T]) StatusCode() int { return s.source.StatusCode }

// Headers returns the response headers with lower-cased names. Go has no
// immutable map, so callers must not mutate it.
func (s *JsonLinesStream[T]) Headers() map[string]string { return s.source.Headers }

// All returns the items of the stream in order. The error of a failed stream is
// the last value; the sequence ends after it.
func (s *JsonLinesStream[T]) All() iter.Seq2[T, error] {
	return func(yield func(T, error) bool) {
		defer func() { _ = s.Close() }()
		for {
			item, ok, err := s.next()
			if err != nil {
				var zero T
				yield(zero, err)
				return
			}
			if !ok || !yield(item, nil) {
				return
			}
		}
	}
}

func (s *JsonLinesStream[T]) next() (item T, ok bool, err error) {
	var zero T
	if s.done || s.closed.Load() {
		return zero, false, nil
	}
	for {
		line, more, readErr := s.lines.readLine()
		if readErr != nil {
			s.done = true
			if tooLong, isLong := isTooLong(readErr); isLong {
				return zero, false, s.serializationFailure(fmt.Sprintf("line %d of the JSON Lines response is too long: %s", s.lineNumber.Load()+1, tooLong.message), tooLong)
			}
			if errors.Is(readErr, io.ErrClosedPipe) {
				return zero, false, nil
			}
			return zero, false, readErr
		}
		if !more {
			s.done = true
			return zero, false, nil
		}
		number := s.lineNumber.Add(1)
		if strings.TrimSpace(line) == "" {
			continue
		}
		decoded, decodeErr := s.decode(line)
		if decodeErr != nil {
			s.done = true
			return zero, false, s.serializationFailure(fmt.Sprintf("line %d of the JSON Lines response does not decode: %s", number, decodeErr.Error()), decodeErr)
		}
		return decoded, true, nil
	}
}

func (s *JsonLinesStream[T]) serializationFailure(message string, cause error) error {
	failure := newSerializationError(message, cause)
	failure.AttachResponse(s.source.StatusCode, s.source.Headers, "", s.method, s.path)
	return failure
}

// Close closes the stream and aborts the connection; later calls do nothing and
// return nil.
func (s *JsonLinesStream[T]) Close() error {
	if s.closed.Swap(true) {
		return nil
	}
	_ = s.source.Body.Close()
	return nil
}

// String describes the stream by its status code and the lines read so far.
func (s *JsonLinesStream[T]) String() string {
	return fmt.Sprintf("JsonLinesStream{statusCode=%d, linesRead=%d}", s.source.StatusCode, s.lineNumber.Load())
}

// GoString is String for the %#v verb, which would otherwise show the headers.
func (s *JsonLinesStream[T]) GoString() string { return s.String() }
