package models

import (
	"bytes"
	"encoding/json"
)

// marshalJSON marshals a value to compact JSON with HTML escaping turned off.
//
// json.Marshal always rewrites '<', '>' and '&' as unicode escapes, and
// encoding/json only compacts (never un-escapes) the output of a Marshaler, so
// a model that delegates to json.Marshal would put the escaped form on the wire
// even though the request serializer disables escaping. Every model and Set
// MarshalJSON goes through this helper so those bytes go out literally, like
// the other SDKs. Encoder.Encode appends a newline, which is trimmed to match
// json.Marshal's output.
func marshalJSON(value any) ([]byte, error) {
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(value); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}
