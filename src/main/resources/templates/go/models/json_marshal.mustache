package models

import (
	"bytes"
	"encoding/json"
	"strings"
)

// marshalJSON marshals a value to compact JSON with HTML escaping turned off.
//
// json.Marshal always rewrites '<', '>' and '&' as unicode escapes, and
// encoding/json only compacts (never un-escapes) the output of a Marshaler, so
// a model that delegates to json.Marshal would put the escaped form on the wire
// even though the request serializer disables escaping. Every model and Set
// MarshalJSON goes through this helper so those bytes go out literally, like
// the other SDKs. Encoder.Encode appends a newline, which is trimmed to match
// json.Marshal's output.
func marshalJSON(value any) ([]byte, error) {
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(value); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}

// dropMiscasedKeys removes the top-level keys of a JSON object that differ from
// a declared property name only in letter case.
//
// encoding/json falls back to a case-insensitive match when no struct tag
// matches exactly, so {"NAME":"x"} would populate a field tagged "name" and a
// later {"NAME":...} would overwrite an earlier exact {"name":...}. The other
// SDKs match the exact wire name and treat any other spelling as an unknown
// key. Decoding the filtered object instead keeps that contract; a key that is
// exactly a declared name always survives. Anything that is not a JSON object
// is returned unchanged for the caller's own decode to reject.
func dropMiscasedKeys(data []byte, known ...string) []byte {
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(data, &raw); err != nil || raw == nil {
		return data
	}
	exact := make(map[string]bool, len(known))
	for _, name := range known {
		exact[name] = true
	}
	dropped := false
	for key := range raw {
		if exact[key] {
			continue
		}
		for _, name := range known {
			if strings.EqualFold(key, name) {
				delete(raw, key)
				dropped = true
				break
			}
		}
	}
	if !dropped {
		return data
	}
	filtered, err := json.Marshal(raw)
	if err != nil {
		return data
	}
	return filtered
}
