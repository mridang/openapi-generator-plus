package models

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"regexp"

	jsonv2 "github.com/go-json-experiment/json"
	"github.com/go-json-experiment/json/jsontext"
	"{{packageName}}/pkg/internal/exactdecimal"
	"{{packageName}}/pkg/internal/protoduration"
)

// marshalJSON marshals a value to compact JSON with HTML escaping turned off.
//
// json.Marshal always rewrites '<', '>' and '&' as unicode escapes, and
// encoding/json only compacts (never un-escapes) the output of a Marshaler, so
// a model that delegates to json.Marshal would put the escaped form on the wire
// even though the request serializer disables escaping. Every model and Set
// MarshalJSON goes through this helper so those bytes go out literally, like
// the other SDKs. Encoder.Encode appends a newline, which is trimmed to match
// json.Marshal's output.
func marshalJSON(value any) ([]byte, error) {
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(value); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}

// withoutDeclaredKeys returns extras without the entries whose key equals a
// declared property's wire name, so a caller-built model never writes the same
// JSON key twice: the declared property's value wins. The caller's map is not
// modified; it is copied only when a colliding key is present.
func withoutDeclaredKeys[V any](extras map[string]V, declared ...string) map[string]V {
	result := extras
	copied := false
	for _, key := range declared {
		if _, ok := result[key]; !ok {
			continue
		}
		if !copied {
			result = make(map[string]V, len(extras))
			for k, v := range extras {
				result[k] = v
			}
			copied = true
		}
		delete(result, key)
	}
	return result
}

// decodeOptions are the JSON v2 options every model decode runs with. A key
// that appears twice keeps its last value and invalid UTF-8 inside a string is
// replaced rather than refused, as encoding/json did, and a time.Duration is
// read from its protobuf-JSON string ("3600s") in the same pass.
var decodeOptions = jsonv2.JoinOptions(
	jsontext.AllowDuplicateNames(true),
	jsontext.AllowInvalidUTF8(true),
	jsonv2.WithUnmarshalers(jsonv2.UnmarshalFunc(protoduration.DecodeValue)),
)

// unmarshalModel decodes data into a model through its UnmarshalJSONFrom, so
// the encoding/json entry point (UnmarshalJSON) and the JSON v2 one apply the
// same checks and return the same errors. Anything after the one JSON value is
// refused.
func unmarshalModel(data []byte, model jsonv2.UnmarshalerFrom) error {
	dec := jsontext.NewDecoder(bytes.NewReader(data), decodeOptions)
	if err := model.UnmarshalJSONFrom(dec); err != nil {
		return err
	}
	if _, err := dec.ReadToken(); err != io.EOF {
		if err == nil {
			err = errors.New("unexpected data after the top-level JSON value")
		}
		return err
	}
	return nil
}

// unmarshalValue decodes data into target with the model decode options: a
// model through unmarshalModel, anything else (a list, a map, a scalar, a
// union) through JSON v2.
func unmarshalValue(data []byte, target any) error {
	if model, ok := target.(jsonv2.UnmarshalerFrom); ok {
		return unmarshalModel(data, model)
	}
	return jsonv2.Unmarshal(data, target, decodeOptions)
}

// decodeValue decodes the next JSON value of dec into out.
func decodeValue[T any](dec *jsontext.Decoder, out *T) error {
	return jsonv2.UnmarshalDecode(dec, out, decodeOptions)
}

// decodeChecked reads the next JSON value of dec, hands it to check under the
// property's wire name and then decodes it into out. The value is read once
// from the stream; check sees its JSON text.
func decodeChecked[T any](dec *jsontext.Decoder, out *T, key string, check func(key string, value []byte) error) error {
	value, err := dec.ReadValue()
	if err != nil {
		return err
	}
	if err := check(key, value); err != nil {
		return err
	}
	return jsonv2.Unmarshal(value, out, decodeOptions)
}

// readObject reads one JSON object from dec and calls field with each key, in
// document order, with the value next on the stream; field must consume that
// value. Keys match the declared wire names exactly: a key that differs only
// in letter case is a different key. A null reads as an object with no keys,
// so the caller's checks for required keys still run. Any other JSON value is
// refused, naming the model.
func readObject(dec *jsontext.Decoder, model string, field func(key string) error) error {
	switch kind := dec.PeekKind(); kind {
	case 'n':
		_, err := dec.ReadToken()
		return err
	case '{':
	case '"', '0', 't', 'f', '[':
		return fmt.Errorf("cannot unmarshal a JSON %s into %s: expected an object", jsonKindName(kind), model)
	default:
		_, err := dec.ReadToken()
		return err
	}
	if _, err := dec.ReadToken(); err != nil {
		return err
	}
	for dec.PeekKind() != '}' {
		name, err := dec.ReadToken()
		if err != nil {
			return err
		}
		if err := field(name.String()); err != nil {
			return err
		}
	}
	_, err := dec.ReadToken()
	return err
}

// jsonKindName names a JSON kind as an error message reads it.
func jsonKindName(kind jsontext.Kind) string {
	switch kind {
	case '"':
		return "string"
	case '0':
		return "number"
	case 't', 'f':
		return "boolean"
	case '[':
		return "array"
	default:
		return kind.String()
	}
}

// readDiscriminator returns the string under the discriminator key name of
// the JSON object data, reading only the top level of the object. The key
// matches exactly, so a differently cased key is not the discriminator; a
// missing key or a null gives the empty string, and the last of several wins.
func readDiscriminator(data []byte, model, name string) (string, error) {
	dec := jsontext.NewDecoder(bytes.NewReader(data), decodeOptions)
	value := ""
	err := readObject(dec, model, func(key string) error {
		if key != name {
			return dec.SkipValue()
		}
		if dec.PeekKind() == 'n' {
			_, err := dec.ReadToken()
			return err
		}
		return decodeValue(dec, &value)
	})
	return value, err
}

// jsonString returns the text of a JSON string value, and false for any other
// JSON value, which the decode that follows accepts or rejects.
func jsonString(value []byte) (string, bool) {
	if jsontext.Value(value).Kind() != '"' {
		return "", false
	}
	var text string
	if jsonv2.Unmarshal(value, &text, decodeOptions) != nil {
		return "", false
	}
	return text, true
}

// checkDecimalNumber rejects a `type: number` decimal that is not a bare JSON
// number, and checkDecimalString a `type: string` one that is not a JSON
// string holding a plain decimal number.
func checkDecimalNumber(key string, value []byte) error {
	return exactdecimal.CheckValue(key, value, false)
}

func checkDecimalString(key string, value []byte) error {
	return exactdecimal.CheckValue(key, value, true)
}

// ipv4Text and ipv6Text are the plain text of an address: dotted decimal with
// no leading zero for IPv4, hexadecimal groups (and the dotted tail of an
// embedded IPv4 address) for IPv6. netip.ParseAddr alone also accepts a zone
// id, which the wire form does not allow.
var (
	ipv4Text = regexp.MustCompile(`^(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(?:\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$`)
	ipv6Text = regexp.MustCompile(`^[0-9A-Fa-f:.]+$`)
)

// checkIPv4 and checkIPv6 reject a format:ipv4 or format:ipv6 value under key
// that is not the plain text of an address of that family: a prefix length, a
// zone id, brackets, surrounding whitespace, a leading zero and an address of
// the other family are all refused. A null or non-string value is left to the
// decode that follows.
func checkIPv4(key string, value []byte) error {
	return checkIP(key, value, false)
}

func checkIPv6(key string, value []byte) error {
	return checkIP(key, value, true)
}

func checkIP(key string, value []byte, v6 bool) error {
	text, ok := jsonString(value)
	if !ok {
		return nil
	}
	if v6 && !ipv4Text.MatchString(text) && ipv6Text.MatchString(text) {
		return nil
	}
	if !v6 && ipv4Text.MatchString(text) {
		return nil
	}
	family := 4
	if v6 {
		family = 6
	}
	return fmt.Errorf("field %q is not the plain text of an IPv%d address: %q", key, family, text)
}

// canonicalUuid matches the canonical text of a UUID: 32 hexadecimal digits in
// the 8-4-4-4-12 grouping. The uuid package also parses braced, urn:uuid: and
// unhyphenated spellings, which the wire form does not allow.
var canonicalUuid = regexp.MustCompile(`^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$`)

// checkUuid rejects a format:uuid value under key that is not in canonical
// form. A null or non-string value is left to the decode that follows.
func checkUuid(key string, value []byte) error {
	text, ok := jsonString(value)
	if !ok {
		return nil
	}
	if !canonicalUuid.MatchString(text) {
		return fmt.Errorf("field %q is not a canonical UUID: %q", key, text)
	}
	return nil
}

// absoluteURI matches an absolute RFC 3986 URI: a scheme, ':' and then no
// whitespace or control character. http, ftp, mailto and urn are all valid;
// a relative reference has no scheme and does not match.
var absoluteURI = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9+.-]*:[^\s\x00-\x1f\x7f]*$`)

// checkAbsoluteURI rejects a format:uri value under key that is not an
// absolute URI. The value itself is kept byte-for-byte; only its shape is
// checked. A null or non-string value is left to the decode that follows.
func checkAbsoluteURI(key string, value []byte) error {
	text, ok := jsonString(value)
	if !ok {
		return nil
	}
	if !absoluteURI.MatchString(text) {
		return fmt.Errorf("field %q is not an absolute URI: %q", key, text)
	}
	return nil
}
