{{>api_info}}
package {{packageName}}

import errors_pkg "{{packageName}}/pkg/errors"

// The whole SDK error tree, declared in the errors package and re-exported
// here so every error type can be named from the package root:
// errors.As(err, new(*NotFoundError)) works from either package.
type (
	// {{errorPrefix}}Error is the branded root every SDK error satisfies.
	{{errorPrefix}}Error = errors_pkg.{{errorPrefix}}Error
	// ApiError is an HTTP-level failure.
	ApiError = errors_pkg.ApiError
	// ClientError is an HTTP 4xx failure.
	ClientError = errors_pkg.ClientError
	// BadRequestError is an HTTP 400 failure.
	BadRequestError = errors_pkg.BadRequestError
	// UnauthorizedError is an HTTP 401 failure.
	UnauthorizedError = errors_pkg.UnauthorizedError
	// ForbiddenError is an HTTP 403 failure.
	ForbiddenError = errors_pkg.ForbiddenError
	// NotFoundError is an HTTP 404 failure.
	NotFoundError = errors_pkg.NotFoundError
	// ConflictError is an HTTP 409 failure.
	ConflictError = errors_pkg.ConflictError
	// PaymentRequiredError is an HTTP 402 failure.
	PaymentRequiredError = errors_pkg.PaymentRequiredError
	// MethodNotAllowedError is an HTTP 405 failure.
	MethodNotAllowedError = errors_pkg.MethodNotAllowedError
	// RequestTimeoutError is an HTTP 408 failure.
	RequestTimeoutError = errors_pkg.RequestTimeoutError
	// GoneError is an HTTP 410 failure.
	GoneError = errors_pkg.GoneError
	// PayloadTooLargeError is an HTTP 413 failure.
	PayloadTooLargeError = errors_pkg.PayloadTooLargeError
	// UnsupportedMediaTypeError is an HTTP 415 failure.
	UnsupportedMediaTypeError = errors_pkg.UnsupportedMediaTypeError
	// LockedError is an HTTP 423 failure.
	LockedError = errors_pkg.LockedError
	// NotImplementedError is an HTTP 501 failure.
	NotImplementedError = errors_pkg.NotImplementedError
	// BadGatewayError is an HTTP 502 failure.
	BadGatewayError = errors_pkg.BadGatewayError
	// ServiceUnavailableError is an HTTP 503 failure.
	ServiceUnavailableError = errors_pkg.ServiceUnavailableError
	// GatewayTimeoutError is an HTTP 504 failure.
	GatewayTimeoutError = errors_pkg.GatewayTimeoutError
	// UnprocessableEntityError is an HTTP 422 failure.
	UnprocessableEntityError = errors_pkg.UnprocessableEntityError
	// TooManyRequestsError is an HTTP 429 failure.
	TooManyRequestsError = errors_pkg.TooManyRequestsError
	// ServerError is an HTTP 5xx failure.
	ServerError = errors_pkg.ServerError
	// InternalServerError is an HTTP 500 failure.
	InternalServerError = errors_pkg.InternalServerError
	// NetworkError is a request that produced no HTTP response.
	NetworkError = errors_pkg.NetworkError
	// NetworkTimeoutError is a request that timed out.
	NetworkTimeoutError = errors_pkg.NetworkTimeoutError
	// StreamError is a response body that failed after its headers arrived.
	StreamError = errors_pkg.StreamError
	// PaginationError is a paged list that cannot be followed safely.
	PaginationError = errors_pkg.PaginationError
	// SerializationError is a value that could not be encoded or decoded.
	SerializationError = errors_pkg.SerializationError
	// OAuth2ServerError is a non-2xx answer from the OAuth2 token endpoint.
	OAuth2ServerError = errors_pkg.OAuth2ServerError
	// OAuth2TokenError is a 2xx answer from the OAuth2 token endpoint that could not be used.
	OAuth2TokenError = errors_pkg.OAuth2TokenError
	// ErrorFactory builds the error of one declared error schema for a response.
	ErrorFactory = errors_pkg.ErrorFactory
{{#errorSchemas}}
	// {{className}} is the error for a response whose body is a {{schemaName}}.
	{{className}} = errors_pkg.{{className}}
{{/errorSchemas}}
)

{{#hasErrorSchemas}}
// The factories of the error schemas the operations declare, one per schema.
var (
{{#errorSchemas}}
	// New{{className}}FromResponse builds a {{className}} from a response, or the status error when the body does not match.
	New{{className}}FromResponse = errors_pkg.New{{className}}FromResponse
{{/errorSchemas}}
)

{{/hasErrorSchemas}}
// FromResponseWith is FromResponse for an operation that declares error
// responses: it picks the factory for the status that arrived.
var FromResponseWith = errors_pkg.FromResponseWith


// FromResponse is the one status-to-error mapping, re-exported so the whole
// error surface — the types above and the factory that builds them — can be
// reached from the package root.
var FromResponse = errors_pkg.FromResponse
