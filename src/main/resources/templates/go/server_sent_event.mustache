package {{packageName}}

import "fmt"

// ServerSentEvent is one event of an SseStream.
type ServerSentEvent[T any] struct {
	/* ID is the last event id when the event was dispatched; empty when the
	 * stream has set none. */
	ID string

	/* Event is the event name; "message" when the server named none. */
	Event string

	/* Data is the data field decoded as the schema of the operation, or the
	 * raw text when the operation declares none. */
	Data T

	/* Retry is the reconnection time, in milliseconds, last set by the server;
	 * nil when it set none. */
	Retry *int64

	/* Raw is the data field as the server sent it. */
	Raw string
}

// String describes the event by its name and id only, never its data.
func (e ServerSentEvent[T]) String() string {
	return fmt.Sprintf("ServerSentEvent{event=%s, id=%s}", e.Event, e.ID)
}
