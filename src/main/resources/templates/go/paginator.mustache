// Paginator is the items of a paged list, read lazily. The method that returns
// it sends no request: the first request goes out when you first read an item or
// a page, and each next request goes out only when you ask for more, so a break
// out of the loop sends nothing further and leaves nothing to close. Every page
// is an ordinary call of the matching WithHTTPInfo method, so the retries,
// timeouts, redirects, authentication, redaction, headers and call options of the
// method apply to each one.
//
// Range over Items for the items, or over Pages for the pages with their cursor
// and result. Each range starts again from the starting position, so two loops
// read the list twice. A failed page request is yielded as its SDK error after
// the items of the earlier pages were delivered and ends that iteration; a
// cursor equal to the one just sent is yielded as a *PaginationError after the
// items of the page that repeated it. Cancelling the context of the call aborts
// the page request in flight. There is no total limit and no collect-all: break
// out of the loop.
//
// The type parameter T is the item type and C is the type of the cursor request
// parameter (NoCursor for a list whose next page is a URL: a Link header or a body property).
type Paginator[T any, C comparable] struct {
	pages iter.Seq2[*Page[T, C], error]
}

// Pages returns the pages, each with its items, next cursor and result. Every
// range starts again at the starting position.
func (p *Paginator[T, C]) Pages() iter.Seq2[*Page[T, C], error] {
	return p.pages
}

// Items returns the items of every page in order. Every range starts again at
// the starting position.
func (p *Paginator[T, C]) Items() iter.Seq2[T, error] {
	return func(yield func(T, error) bool) {
		for page, err := range p.pages {
			if err != nil {
				var none T
				yield(none, err)
				return
			}
			for _, item := range page.Items {
				if !yield(item, nil) {
					return
				}
			}
		}
	}
}

// pageResult is the result of a page as the Page carries it, with the decoded
// body behind Data.
func pageResult[B any](result *ApiResult[B]) *ApiResult[any] {
	erased := &ApiResult[any]{StatusCode: result.StatusCode, RawBody: result.RawBody, Headers: result.Headers}
	if result.Data != nil {
		decoded := any(*result.Data)
		erased.Data = &decoded
	}
	return erased
}

// pageItems reads the items of a decoded page: the property is a slice, or a
// pointer to one when it is optional.
func pageItems[T any](value any) []T {
	switch items := value.(type) {
	case []T:
		return items
	case *[]T:
		if items != nil {
			return *items
		}
	}
	return nil
}

// pageCursor reads the next cursor of a decoded page as the type of the cursor
// request parameter: the property is a value, or a pointer to one when it is
// optional, and an integer property converts to the integer type of the
// parameter. It returns nil for an absent cursor.
func pageCursor[C comparable](value any) *C {
	current := reflect.ValueOf(value)
	for current.IsValid() && current.Kind() == reflect.Pointer {
		if current.IsNil() {
			return nil
		}
		current = current.Elem()
	}
	var cursor C
	target := reflect.ValueOf(&cursor).Elem()
	if !current.IsValid() || !current.CanConvert(target.Type()) {
		return nil
	}
	if current.Kind() != target.Kind() && (!current.CanInt() || !target.CanInt()) {
		return nil
	}
	target.Set(current.Convert(target.Type()))
	return &cursor
}

// newCursorPaginator follows a cursor: start is the cursor of the first request
// (nil for the beginning of the list), fetch sends the request for a cursor and
// returns its result, items and next read a decoded page. next returns the cursor
// of the request after the one that sent sent (nil to send none) and ends the list
// when it returns nil. An absent, nil or empty next cursor ends the list; an empty
// page with a next cursor continues.
func newCursorPaginator[T any, C comparable, B any](start *C, requestPath string, fetch func(*C) (*ApiResult[B], error), items func(B) []T, next func(sent *C, body B) *C) *Paginator[T, C] {
	return &Paginator[T, C]{pages: func(yield func(*Page[T, C], error) bool) {
		sent := start
		for {
			result, err := fetch(sent)
			if err != nil {
				yield(nil, err)
				return
			}
			page := &Page[T, C]{Result: pageResult(result)}
			if result.Data != nil {
				page.Items = items(*result.Data)
				page.NextCursor = next(sent, *result.Data)
			}
			if text, isText := any(page.NextCursor).(*string); isText && text != nil && *text == "" {
				page.NextCursor = nil
			}
			repeated := page.NextCursor != nil && sent != nil && *page.NextCursor == *sent
			if !yield(page, nil) || page.NextCursor == nil {
				return
			}
			if repeated {
				/* The page itself is good: it was delivered, and the next read fails. */
				yield(nil, errors_pkg.NewPaginationError("the server returned the cursor that was just sent, so the list cannot advance", requestPath))
				return
			}
			sent = page.NextCursor
		}
	}}
}

// newOffsetPaginator follows an offset: start is the offset of the first request
// (nil to send none), and the next offset is the offset sent plus the items
// received. more reads the has_more flag of a decoded page, or is nil when the
// list does not declare one. A page with no items, or one whose flag is false,
// ends the list.
func newOffsetPaginator[T any, B any](start *int32, requestPath string, fetch func(*int32) (*ApiResult[B], error), items func(B) []T, more func(B) *bool) *Paginator[T, int32] {
	return newCursorPaginator(start, requestPath, fetch, items, func(sent *int32, body B) *int32 {
		count := len(items(body))
		if count == 0 || (more != nil && !pageMore(more(body))) {
			return nil
		}
		next := int32(count)
		if sent != nil {
			next += *sent
		}
		return &next
	})
}

// newPagePaginator counts pages: start is the page number of the first request
// (nil to send none, which the server answers as page 1), and each next request
// asks for the page after the one it sent. more and the end rules are those of
// newOffsetPaginator.
func newPagePaginator[T any, B any](start *int32, requestPath string, fetch func(*int32) (*ApiResult[B], error), items func(B) []T, more func(B) *bool) *Paginator[T, int32] {
	return newCursorPaginator(start, requestPath, fetch, items, func(sent *int32, body B) *int32 {
		if len(items(body)) == 0 || (more != nil && !pageMore(more(body))) {
			return nil
		}
		next := int32(1)
		if sent != nil {
			next = *sent
		}
		next++
		return &next
	})
}

// pageMore reports whether a page declares that the list goes on: a page that
// has no has_more flag declares nothing, so only a false flag ends the list.
func pageMore(flag *bool) bool {
	return flag == nil || *flag
}

// pageFlag reads the has_more flag of a decoded page: the property is a bool, or
// a pointer to one when it is optional. It returns nil when the list declares none.
func pageFlag(value any) *bool {
	current := reflect.ValueOf(value)
	for current.IsValid() && current.Kind() == reflect.Pointer {
		if current.IsNil() {
			return nil
		}
		current = current.Elem()
	}
	if !current.IsValid() || current.Kind() != reflect.Bool {
		return nil
	}
	flag := current.Bool()
	return &flag
}

// pageNextURL reads the next URL of a decoded page: the property is a string, or
// a pointer to one when it is optional. It reports false for an absent, nil or
// empty one.
func pageNextURL(value any) (string, bool) {
	next := pageCursor[string](value)
	if next == nil || *next == "" {
		return "", false
	}
	return *next, true
}

// newLinkPaginator follows the rel="next" link of the Link header: fetch sends
// the request for a URL (nil for the first page) and returns its result, items
// reads a decoded page. A next URL that leaves the scheme, host or port of
// baseURL is refused with a *PaginationError and nothing is sent to it.
func newLinkPaginator[T any, B any](baseURL, requestPath string, fetch func(*string) (*ApiResult[B], error), items func(B) []T) *Paginator[T, NoCursor] {
	return newNextURLPaginator(baseURL, requestPath, fetch, items, func(result *ApiResult[B]) (string, bool) {
		return linkNext(headerValue(result.Headers, "link"))
	})
}

// newNextURLPaginator follows the URL that nextURL reads from each page: fetch
// sends the request for a URL (nil for the first page) and returns its result,
// items reads a decoded page, and nextURL returns the next URL of a page, or false
// when the page names none. A next URL that leaves the scheme, host or port of
// baseURL is refused with a *PaginationError and nothing is sent to it.
func newNextURLPaginator[T any, B any](baseURL, requestPath string, fetch func(*string) (*ApiResult[B], error), items func(B) []T, nextURL func(*ApiResult[B]) (string, bool)) *Paginator[T, NoCursor] {
	return &Paginator[T, NoCursor]{pages: func(yield func(*Page[T, NoCursor], error) bool) {
		var current *string
		for {
			result, err := fetch(current)
			if err != nil {
				yield(nil, err)
				return
			}
			page := &Page[T, NoCursor]{Result: pageResult(result)}
			if result.Data != nil {
				page.Items = items(*result.Data)
			}
			link, found := nextURL(result)
			if !found {
				yield(page, nil)
				return
			}
			target, refusal := resolveLink(baseURL, current, link, requestPath)
			if !yield(page, nil) {
				return
			}
			if refusal == nil && current != nil && target == *current {
				refusal = errors_pkg.NewPaginationError("the server returned a next link to the page that was just read, so the list cannot advance", requestPath)
			}
			if refusal != nil {
				/* The page itself is good: it was delivered, and the next read fails. */
				yield(nil, refusal)
				return
			}
			current = &target
		}
	}}
}

// headerValue reads a response header by its lower-cased name.
func headerValue(headers map[string]string, name string) string {
	for key, value := range headers {
		if strings.EqualFold(key, name) {
			return value
		}
	}
	return ""
}

// resolveLink resolves a link against the page just read and refuses a scheme,
// host or port other than the client's. The error never holds a query string.
func resolveLink(baseURL string, current *string, link, requestPath string) (string, error) {
	base, err := url.Parse(baseURL)
	if err != nil {
		return "", errors_pkg.NewPaginationError("the base URL of the client is not a valid URL", requestPath)
	}
	from := base
	if current != nil {
		if parsed, parseErr := url.Parse(*current); parseErr == nil {
			from = parsed
		}
	}
	reference, err := url.Parse(strings.TrimSpace(link))
	if err != nil {
		return "", errors_pkg.NewPaginationError("the next link is not a valid URI", requestPath)
	}
	target := from.ResolveReference(reference)
	scheme := strings.ToLower(target.Scheme)
	if target.Hostname() == "" || (scheme != "http" && scheme != "https") || !sameOrigin(base, target) {
		return "", errors_pkg.NewPaginationError("the next link leaves the origin of the request and was not followed", requestPath)
	}
	return target.String(), nil
}
