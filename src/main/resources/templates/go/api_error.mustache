package errors

import (
	"bytes"
	"encoding/json"
	stderrors "errors"
	"fmt"
	"io"
	"strings"
	"unicode/utf8"

	jsonv2 "github.com/go-json-experiment/json"
	"github.com/go-json-experiment/json/jsontext"
	"{{packageName}}/pkg/internal/protoduration"
)

// errorBodyMaxJSONDepth caps how deeply an error-response JSON body may nest.
// The models decode recursively through the host call stack, so a malicious
// server could crash the process with a deeply-nested body (stack overflow ->
// DoS). This mirrors the maxJSONDepth guard the main package
// applies to success bodies; it is duplicated here because package errors is
// imported by the root package and so cannot import it back (import cycle).
const errorBodyMaxJSONDepth = 1000

// unmarshalErrorBody parses an error-response JSON body with the same
// nesting-depth cap the success path uses, so a non-2xx response can't be a DoS
// vector. A leading UTF-8 byte order mark is stripped, like the success path.
// Returns a *SerializationError if the depth limit is exceeded or parsing fails.
func unmarshalErrorBody(data []byte, target any) error {
	data = bytes.TrimPrefix(data, []byte{0xEF, 0xBB, 0xBF})
	if depth := errorBodyJSONDepth(data); depth > errorBodyMaxJSONDepth {
		return NewSerializationError(
			fmt.Sprintf("JSON nesting depth %d exceeds limit %d", depth, errorBodyMaxJSONDepth),
			nil,
		)
	}
	if err := jsonv2.Unmarshal(data, target, errorBodyDecodeOptions); err != nil {
		detail := err.Error()
		if stderrors.Is(err, io.ErrUnexpectedEOF) {
			detail = "unexpected end of JSON input"
		}
		return NewSerializationError(fmt.Sprintf("failed to deserialize JSON: %s", detail), err)
	}
	return nil
}

// errorBodyDecodeOptions are the JSON v2 options of the success path (a
// repeated key keeps its last value, invalid UTF-8 is replaced, a duration is
// read from its protobuf-JSON string), duplicated here for the same import
// cycle reason as errorBodyMaxJSONDepth.
var errorBodyDecodeOptions = jsonv2.JoinOptions(
	jsontext.AllowDuplicateNames(true),
	jsontext.AllowInvalidUTF8(true),
	jsonv2.WithUnmarshalers(jsonv2.UnmarshalFunc(protoduration.DecodeValue)),
)

// errorBodyJSONDepth returns the maximum `{`/`[` nesting depth in the JSON byte
// slice, skipping characters inside strings. A cheap pre-flight check run
// before encoding/json's recursive unmarshaller. (Byte-for-byte the same scan
// as the main package's jsonMaxDepth.)
func errorBodyJSONDepth(data []byte) int {
	depth := 0
	max := 0
	inString := false
	escaped := false
	for _, b := range data {
		if inString {
			if escaped {
				escaped = false
			} else if b == '\\' {
				escaped = true
			} else if b == '"' {
				inString = false
			}
			continue
		}
		switch b {
		case '"':
			inString = true
		case '{', '[':
			depth++
			if depth > max {
				max = depth
			}
		case '}', ']':
			if depth > 0 {
				depth--
			}
		}
	}
	return max
}

// ApiError is the base error for all API (transport-level) errors, including
// the HTTP status code, response headers, and response body. It satisfies the
// branded {{errorPrefix}}Error root, so every error this SDK returns shares a
// common ancestor.
//
// Its state is immutable: fields are unexported and set once at construction
// via NewApiError (or the status factory FromResponse). Callers
// read the state through the getter methods, so an error value handed to one
// caller can never be mutated out from under another.
type ApiError struct {
	statusCode      int
	msg             string
	responseBody    string
	responseHeaders map[string]string
	errorBody       any
	cause           error
	requestMethod   string
	requestPath     string
}

// NewApiError creates an ApiError. The state is fixed at construction and
// thereafter read-only via the getter methods.
func NewApiError(statusCode int, msg, responseBody string, responseHeaders map[string]string, errorBody any, cause error) *ApiError {
	return &ApiError{
		statusCode:      statusCode,
		msg:             msg,
		responseBody:    responseBody,
		responseHeaders: responseHeaders,
		errorBody:       errorBody,
		cause:           cause,
	}
}

// As lets errors.As match a subclass (for example a *NotFoundError or a
// *NetworkError) against *ApiError, so the Go hierarchy reads like the other
// SDKs: every HTTP-level failure is an *ApiError.
func (e *ApiError) As(target any) bool {
	if t, ok := target.(**ApiError); ok {
		*t = e
		return true
	}
	return false
}

// StatusCode returns the HTTP status code (0 for a failure before any response).
func (e *ApiError) StatusCode() int {
	return e.statusCode
}

// RequestMethod returns the HTTP method of the request this error answers, for
// example "GET", or an empty string when the error did not come from a request
// the SDK built.
func (e *ApiError) RequestMethod() string {
	return e.requestMethod
}

// RequestPath returns the path of the request this error answers without its
// query string, for example "/items/7", or an empty string when the error did
// not come from a request the SDK built.
func (e *ApiError) RequestPath() string {
	return e.requestPath
}

// AttachRequest records the method and the path (the query string and any
// fragment are cut off) of the request this error answers. The SDK calls it
// once, where it builds the error; a value that is already set is kept and a
// call with an empty method or path changes nothing.
func (e *ApiError) AttachRequest(method, path string) {
	if e.requestMethod != "" || e.requestPath != "" || method == "" || path == "" {
		return
	}
	if cut := strings.IndexAny(path, "?#"); cut >= 0 {
		path = path[:cut]
	}
	e.requestMethod = method
	e.requestPath = path
}

// Msg returns the error message.
func (e *ApiError) Msg() string {
	return e.msg
}

// ResponseBody returns the raw response body string, or an empty string when
// the transport produced no body.
func (e *ApiError) ResponseBody() string {
	return e.responseBody
}

// ResponseHeaders returns the response headers, or nil when the transport
// produced no headers (e.g. a send-phase failure before any response was
// received). nil is distinct from an empty (but present) header set.
func (e *ApiError) ResponseHeaders() map[string]string {
	return e.responseHeaders
}

// ErrorBody returns the deserialized error body, or nil if not available (for
// example when the response body is not JSON).
func (e *ApiError) ErrorBody() any {
	return e.errorBody
}

// Cause returns the underlying transport error, if any. Set when wrapping a
// network failure so callers can drill down via errors.Unwrap or errors.Is
// instead of losing the original error.
func (e *ApiError) Cause() error {
	return e.cause
}

// IsRetryable reports whether the client retries a request that fails with this
// error's status: 408, 409, 429 and every 5xx except 501. It looks at the status
// alone, so a failure with no response (status 0) is never reported as retryable
// here.
func (e *ApiError) IsRetryable() bool {
	return IsRetryableStatus(e.statusCode)
}

// IsRetryableStatus reports whether the client retries a request answered with
// this HTTP status: 408, 409, 429 and every 5xx except 501.
func IsRetryableStatus(status int) bool {
	switch status {
	case 408, 409, 429:
		return true
	case 501:
		return false
	default:
		return status >= 500 && status <= 599
	}
}

// RequestID returns the value of the x-request-id response header, matched
// without regard to case, or an empty string when the response carried none or
// the failure produced no response.
func (e *ApiError) RequestID() string {
	for name, value := range e.responseHeaders {
		if strings.EqualFold(name, "x-request-id") {
			return value
		}
	}
	return ""
}

// apiError gives the shared ApiError of any error in the tree, so a helper can
// set the request or the cause on it whichever level the value is.
func (e *ApiError) apiError() *ApiError {
	return e
}

// Unwrap returns the underlying cause, enabling errors.Is / errors.As
// to traverse the chain. Returns nil when ApiError was produced from a
// non-wrapped failure (e.g. a non-2xx HTTP response).
func (e *ApiError) Unwrap() error {
	return e.cause
}

// is{{errorPrefix}}Error brands ApiError, and every type embedding it, as a
// {{errorPrefix}}Error.
func (e *ApiError) is{{errorPrefix}}Error() {}

// maxRenderedBodyBytes is the most response-body bytes Error shows; the whole
// body stays on ResponseBody.
const maxRenderedBodyBytes = 1024

// renderedBody is the body as Error shows it: at most maxRenderedBodyBytes
// bytes (cut on a character boundary) followed by "... (N more bytes)", with
// every control character shown as \xNN so a hostile server can neither fill a
// log nor forge a line in it.
func renderedBody(body string) string {
	end := min(len(body), maxRenderedBodyBytes)
	for end > 0 && end < len(body) && !utf8.RuneStart(body[end]) {
		end--
	}
	var out strings.Builder
	for _, r := range body[:end] {
		if r < 0x20 || r == 0x7f {
			fmt.Fprintf(&out, "\\x%02X", r)
		} else {
			out.WriteRune(r)
		}
	}
	if end < len(body) {
		fmt.Fprintf(&out, "... (%d more bytes)", len(body)-end)
	}
	return out.String()
}

// isSecretResponseHeader reports whether the value of a response header must
// not be copied into an error text: the authorization, cookie and challenge
// headers and any name containing key, token or secret.
func isSecretResponseHeader(name string) bool {
	switch lower := strings.ToLower(name); lower {
	case "authorization", "proxy-authorization", "cookie", "set-cookie",
		"www-authenticate", "proxy-authenticate":
		return true
	default:
		return strings.Contains(lower, "key") || strings.Contains(lower, "token") ||
			strings.Contains(lower, "secret")
	}
}

// compactHeadersJSON renders headers as compact JSON with sorted keys and no
// HTML escaping, the form every SDK uses on the "Response headers:" line. The
// value of every credential-bearing header is shown as ***; ResponseHeaders
// keeps the real values.
func compactHeadersJSON(headers map[string]string) string {
	shown := make(map[string]string, len(headers))
	for name, value := range headers {
		if isSecretResponseHeader(name) {
			value = "***"
		}
		shown[name] = value
	}
	headers = shown
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(headers); err != nil {
		return fmt.Sprintf("%v", headers)
	}
	return strings.TrimSuffix(buf.String(), "\n")
}

// Error builds a human-readable error message from the stored attributes: the
// message, then the request method and path, the HTTP status code, response
// headers and response body where present.
func (e *ApiError) Error() string {
	msg := e.msg
	if msg == "" {
		msg = "Error message: the server returns an error"
	}
	if e.requestMethod != "" && e.requestPath != "" {
		msg += "\nRequest: " + e.requestMethod + " " + e.requestPath
	}
	if e.statusCode != 0 {
		msg += fmt.Sprintf("\nHTTP status code: %d", e.statusCode)
	}
	if len(e.responseHeaders) > 0 {
		msg += "\nResponse headers: " + compactHeadersJSON(e.responseHeaders)
	}
	if e.responseBody != "" {
		msg += "\nResponse body: " + renderedBody(e.responseBody)
	}
	return msg
}

// GetTypedErrorBody deserializes the raw response body into the given target
// value.
//
// Useful when the API returns a structured error body that you want to access
// in a strongly-typed way: pass a pointer to the generated model struct you
// expect (e.g. `var e MyErrorBody; apiErr.GetTypedErrorBody(&e)`). An empty
// body leaves the target untouched and reports no error; a malformed body
// returns a *SerializationError.
func (e *ApiError) GetTypedErrorBody(target any) error {
	if e.responseBody == "" {
		return nil
	}
	return unmarshalErrorBody([]byte(e.responseBody), target)
}

// NewNetworkError creates the error for a request that got no HTTP response:
// connection refused, DNS failure, TLS failure, or connection reset. The status
// code is always 0; the underlying error is kept as the cause, so errors.Is and
// errors.As still reach it.
func NewNetworkError(msg string, cause error) *NetworkError {
	return &NetworkError{ApiError: ApiError{msg: msg, cause: cause}}
}

// NewNetworkTimeoutError creates the error for a request that timed out. The
// status code is always 0; the underlying error is kept as the cause.
func NewNetworkTimeoutError(msg string, cause error) *NetworkTimeoutError {
	return &NetworkTimeoutError{NetworkError: NetworkError{ApiError: ApiError{msg: msg, cause: cause}}}
}

// NewStreamError creates the error for a response body that failed after its
// headers arrived (a reset, or a body shorter than its Content-Length). The
// status code is always 0; the underlying error is kept as the cause.
func NewStreamError(msg string, cause error) *StreamError {
	return &StreamError{NetworkError: NetworkError{ApiError: ApiError{msg: msg, cause: cause}}}
}

// FromResponse is the one status-to-error mapping in the SDK: the error a
// non-2xx response with this status returns. The API classes and the OpenID
// Connect discovery both use it, so this is the one place the mapping lives.
//
// Returns the status-specific subclass where there is one (for example
// *NotFoundError for 404), else *ClientError for any other 4xx, *ServerError for
// any other 5xx, and the bare *ApiError for everything else. The statusCode is
// the HTTP status code of the response, headers the response headers, and body
// the raw response body; a JSON body is also parsed into the error body.
func FromResponse(statusCode int, headers map[string]string, body string) error {
	var errorBody any
	if body != "" {
		// Depth-capped parse: a deeply-nested error body must not be able to
		// stack-overflow the process (see unmarshalErrorBody). On cap-exceed or
		// parse failure errorBody stays nil and the raw body is still retained.
		_ = unmarshalErrorBody([]byte(body), &errorBody)
	}
	base := newApiErrorBase(statusCode, headers, body)
	base.errorBody = errorBody

	if statusCode >= 400 && statusCode < 500 {
		clientErr := newClientErrorFromBase(base)
		switch statusCode {
		case 400:
			return &BadRequestError{ClientError: clientErr}
		case 401:
			return &UnauthorizedError{ClientError: clientErr}
		case 403:
			return &ForbiddenError{ClientError: clientErr}
		case 404:
			return &NotFoundError{ClientError: clientErr}
		case 409:
			return &ConflictError{ClientError: clientErr}
		case 422:
			return &UnprocessableEntityError{ClientError: clientErr}
		case 429:
			return &TooManyRequestsError{ClientError: clientErr}
		case 402:
			return &PaymentRequiredError{ClientError: clientErr}
		case 405:
			return &MethodNotAllowedError{ClientError: clientErr}
		case 408:
			return &RequestTimeoutError{ClientError: clientErr}
		case 410:
			return &GoneError{ClientError: clientErr}
		case 413:
			return &PayloadTooLargeError{ClientError: clientErr}
		case 415:
			return &UnsupportedMediaTypeError{ClientError: clientErr}
		case 423:
			return &LockedError{ClientError: clientErr}
		default:
			return &clientErr
		}
	}

	if statusCode >= 500 && statusCode < 600 {
		serverErr := newServerErrorFromBase(base)
		switch statusCode {
		case 500:
			return &InternalServerError{ServerError: serverErr}
		case 501:
			return &NotImplementedError{ServerError: serverErr}
		case 502:
			return &BadGatewayError{ServerError: serverErr}
		case 503:
			return &ServiceUnavailableError{ServerError: serverErr}
		case 504:
			return &GatewayTimeoutError{ServerError: serverErr}
		default:
			return &serverErr
		}
	}

	apiErr := newApiErrorFromBase(base)
	return &apiErr
}

// newApiErrorBase builds the ApiError state every error of a response shares,
// with the default message and no parsed body.
func newApiErrorBase(statusCode int, headers map[string]string, body string) ApiError {
	return ApiError{
		statusCode:      statusCode,
		msg:             fmt.Sprintf("API returned status code %d", statusCode),
		responseBody:    body,
		responseHeaders: headers,
	}
}

// newApiErrorFromBase, newClientErrorFromBase and newServerErrorFromBase wrap
// the shared state in the status family a typed error subclasses.
func newApiErrorFromBase(base ApiError) ApiError {
	return base
}

func newClientErrorFromBase(base ApiError) ClientError {
	return ClientError{ApiError: base}
}

func newServerErrorFromBase(base ApiError) ServerError {
	return ServerError{ApiError: base}
}

// ErrorFactory builds the error of one declared error schema for a response.
// An operation hands the factories of its own declared error responses to
// FromResponseWith, which picks the one for the status that arrived.
type ErrorFactory func(method, path string, statusCode int, headers map[string]string, body string) error

// FromResponseWith is FromResponse for an operation that declares error
// responses: factories maps a declared status ("404"), range ("4XX", "5XX") or
// "default" to the factory of its schema, and the first match wins in that
// order. A status with no factory, or a nil map, gives the plain status error.
// The method and path of the request are recorded on the result, the path
// without its query string.
func FromResponseWith(method, path string, statusCode int, headers map[string]string, body string, factories map[string]ErrorFactory) error {
	if len(factories) > 0 {
		keys := []string{fmt.Sprintf("%d", statusCode), fmt.Sprintf("%dXX", statusCode/100), "default"}
		for _, key := range keys {
			if factory, ok := factories[key]; ok && factory != nil {
				return factory(method, path, statusCode, headers, body)
			}
		}
	}
	return statusFallback(method, path, statusCode, headers, body, nil)
}

// statusFallback is the plain status error of a response with the request
// recorded and, when the body did not match its declared schema, the decoding
// failure as its cause. The raw body stays on the error.
func statusFallback(method, path string, statusCode int, headers map[string]string, body string, cause error) error {
	failure := FromResponse(statusCode, headers, body)
	if holder, ok := failure.(interface{ apiError() *ApiError }); ok {
		apiErr := holder.apiError()
		apiErr.cause = cause
		apiErr.AttachRequest(method, path)
	}
	return failure
}
