package errors

// StreamError is the error for a response body that failed after its headers
// arrived: a connection reset in the middle of the body, or a body that ends
// before its declared Content-Length. It is a NetworkError, so the status code
// is always 0 and the underlying error is kept as the cause; an idle timeout of
// a stream stays a *NetworkTimeoutError.
type StreamError struct {
	NetworkError
}

// As lets errors.As match a *StreamError against *NetworkError and *ApiError.
func (e *StreamError) As(target any) bool {
	if t, ok := target.(**StreamError); ok {
		*t = e
		return true
	}
	return e.NetworkError.As(target)
}
