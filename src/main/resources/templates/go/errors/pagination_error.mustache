{{>api_info}}
package errors

// PaginationError is returned when a paged list cannot be followed safely: the
// server returned the cursor that was just sent, so asking again would loop
// forever, or a Link header pointed to another origin, so following it would
// send the credentials there. It is not a network error and not an API error:
// it satisfies the branded {{errorPrefix}}Error root directly, and the items
// already delivered are complete and correct. A failed page request returns the
// SDK error of that failure instead.
type PaginationError struct {
	message     string
	requestPath string
}

// NewPaginationError creates a PaginationError. The message never holds a query
// string, and requestPath is the path of the request that returned the page,
// without its query.
func NewPaginationError(message, requestPath string) *PaginationError {
	return &PaginationError{message: message, requestPath: requestPath}
}

// Message returns what made the list impossible to follow.
func (e *PaginationError) Message() string {
	return e.message
}

// RequestPath returns the path of the request whose response could not be
// followed, without its query, or an empty string when it is not known.
func (e *PaginationError) RequestPath() string {
	return e.requestPath
}

// is{{errorPrefix}}Error brands PaginationError as a {{errorPrefix}}Error.
func (e *PaginationError) is{{errorPrefix}}Error() {}

// Error implements the error interface.
func (e *PaginationError) Error() string {
	return e.message
}
