package {{packageName}}

import (
	"fmt"
	"net/url"
	"reflect"
	"strings"
)

// serializeValue serializes a value for use in an HTTP request parameter.
//
// The serialization strategy depends on the location:
//   - path: scalar values are stringified and percent-encoded
//   - query: nil values are omitted (returns nil); collections are formatted
//     according to collectionFormat
//   - header: collections are joined with commas; nil values become empty strings
//   - any other location: nil values become empty strings, scalars are stringified
//
// Parameters:
//   - value: the value to serialize (may be nil)
//   - location: where the parameter appears: "path", "query", "header", or "cookie"
//   - schemaType: the OpenAPI schema type (currently unused, reserved for
//     future format-aware serialization)
//   - collectionFormat: the collection format: "multi", "csv", "ssv", "tsv",
//     or "pipes" (only relevant for query parameters)
//
// Returns the serialized value: a string, a []string (for "multi" query
// collections), or nil to omit the parameter.
func serializeValue(value any, location, schemaType, collectionFormat string) any {
	if value == nil {
		return serializeNil(location)
	}

	if items, ok := toStringSlice(value); ok {
		if location == "query" {
			switch collectionFormat {
			case "multi":
				return items
			case "ssv":
				return strings.Join(items, " ")
			case "tsv":
				return strings.Join(items, "\t")
			case "pipes":
				return strings.Join(items, "|")
			default:
				return strings.Join(items, ",")
			}
		}
		return strings.Join(items, ",")
	}

	strVal := stringify(value)
	if location == "path" {
		return encodePathSegment(strVal)
	}
	return strVal
}

// encodePathSegment percent-encodes a value for use as a URL path segment.
//
// Encodes characters that are not allowed in a URI path segment per RFC 3986,
// but preserves the sub-delimiters (including ";", "=", ",", ":", etc.) that
// OAS 3.0 matrix/label/simple styles use as structural separators in the
// styled value.
//
// The preserved set matches the canonical encoding used by Java, Node, C#,
// Swift, etc.: ; = , : @ ! $ & ' ( ) * +
//
// Returns the percent-encoded path segment.
func encodePathSegment(value string) string {
	if value == "" {
		return value
	}
	// url.PathEscape encodes everything except unreserved characters.
	// Restore the sub-delimiters that must be preserved in path segments.
	encoded := url.PathEscape(value)
	encoded = strings.ReplaceAll(encoded, "%3B", ";")
	encoded = strings.ReplaceAll(encoded, "%3D", "=")
	encoded = strings.ReplaceAll(encoded, "%2C", ",")
	encoded = strings.ReplaceAll(encoded, "%3A", ":")
	encoded = strings.ReplaceAll(encoded, "%40", "@")
	encoded = strings.ReplaceAll(encoded, "%21", "!")
	encoded = strings.ReplaceAll(encoded, "%24", "$")
	encoded = strings.ReplaceAll(encoded, "%26", "&")
	encoded = strings.ReplaceAll(encoded, "%27", "'")
	encoded = strings.ReplaceAll(encoded, "%28", "(")
	encoded = strings.ReplaceAll(encoded, "%29", ")")
	encoded = strings.ReplaceAll(encoded, "%2A", "*")
	encoded = strings.ReplaceAll(encoded, "%2B", "+")
	return encoded
}

// encodeQueryAllowingReserved percent-encodes a query value while leaving the
// RFC 3986 reserved characters literal (OAS allowReserved: true).
//
// Everything that is not RFC 3986 reserved or unreserved — spaces, control
// characters, non-ASCII — is still percent-encoded, so the result is always a
// valid URL query segment. Only the reserved set : / ? # [ ] @ ! $ & ' ( ) * +
// , ; = is restored after url.QueryEscape over-encodes it. url.QueryEscape
// emits "+" for a space, so it is normalised to "%20" first; a literal "+" in
// the value is already "%2B" at that point and is restored with the rest of the
// reserved set.
func encodeQueryAllowingReserved(value string) string {
	if value == "" {
		return value
	}
	encoded := url.QueryEscape(value)
	encoded = strings.ReplaceAll(encoded, "+", "%20")
	encoded = strings.ReplaceAll(encoded, "%3A", ":")
	encoded = strings.ReplaceAll(encoded, "%2F", "/")
	encoded = strings.ReplaceAll(encoded, "%3F", "?")
	encoded = strings.ReplaceAll(encoded, "%23", "#")
	encoded = strings.ReplaceAll(encoded, "%5B", "[")
	encoded = strings.ReplaceAll(encoded, "%5D", "]")
	encoded = strings.ReplaceAll(encoded, "%40", "@")
	encoded = strings.ReplaceAll(encoded, "%21", "!")
	encoded = strings.ReplaceAll(encoded, "%24", "$")
	encoded = strings.ReplaceAll(encoded, "%26", "&")
	encoded = strings.ReplaceAll(encoded, "%27", "'")
	encoded = strings.ReplaceAll(encoded, "%28", "(")
	encoded = strings.ReplaceAll(encoded, "%29", ")")
	encoded = strings.ReplaceAll(encoded, "%2A", "*")
	encoded = strings.ReplaceAll(encoded, "%2B", "+")
	encoded = strings.ReplaceAll(encoded, "%2C", ",")
	encoded = strings.ReplaceAll(encoded, "%3B", ";")
	encoded = strings.ReplaceAll(encoded, "%3D", "=")
	return encoded
}

// allowReservedValue wraps a query value so the query-string builder preserves
// RFC 3986 reserved characters (OAS allowReserved: true) instead of
// percent-encoding them. The wrapped value is a string, or a []string for an
// exploded parameter.
type allowReservedValue struct {
	value any
}

// maybeAllowReserved wraps value in an allowReservedValue when the parameter
// declares allowReserved: true; otherwise it returns value unchanged. A nil
// value is never wrapped, so it is still omitted from the query string.
func maybeAllowReserved(value any, allowReserved bool) any {
	if value == nil || !allowReserved {
		return value
	}
	return allowReservedValue{value: value}
}

// serializeDeepObject serializes a deepObject-style query parameter.
//
// Produces a map of flattened keys in the form paramName[key] to stringified
// values, suitable for inclusion in a query string. Accepts map[string]any,
// map[string]string, or pointers to these types.
//
// Parameters:
//   - paramName: the parameter name (e.g. "filter")
//   - value: the map value to serialize
//
// Returns a map of expanded keys to serialized values, or an empty map if value is nil.
func serializeDeepObject(paramName string, value any) map[string]string {
	result := make(map[string]string)
	if value == nil {
		return result
	}

	switch m := value.(type) {
	case map[string]any:
		for key, val := range m {
			result[fmt.Sprintf("%s[%s]", paramName, key)] = stringify(val)
		}
	case map[string]string:
		for key, val := range m {
			result[fmt.Sprintf("%s[%s]", paramName, key)] = val
		}
	case *map[string]any:
		if m != nil {
			for key, val := range *m {
				result[fmt.Sprintf("%s[%s]", paramName, key)] = stringify(val)
			}
		}
	case *map[string]string:
		if m != nil {
			for key, val := range *m {
				result[fmt.Sprintf("%s[%s]", paramName, key)] = val
			}
		}
	}
	return result
}

// requirePathParam returns ErrMissingRequiredParameter when a path parameter is
// nil or an empty string.
//
// Path parameters are required components of the URL — accepting an empty
// string would silently produce a malformed URL like `/resource//details`,
// which most servers route to 404 instead of surfacing the bug at the call
// site. A named string enum path param has its own dynamic type rather than
// string, so a plain `value.(string)` assertion misses an empty zero-value
// enum. Dereference any pointer and inspect the underlying kind via
// reflection so a string-kinded value of any named type is caught.
func requirePathParam(paramName string, value any) error {
	rv := reflect.ValueOf(value)
	if !rv.IsValid() {
		return fmt.Errorf("%w: path parameter '%s' must not be empty", ErrMissingRequiredParameter, paramName)
	}
	if rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return fmt.Errorf("%w: path parameter '%s' must not be empty", ErrMissingRequiredParameter, paramName)
		}
		rv = rv.Elem()
	}
	if rv.Kind() == reflect.String && rv.String() == "" {
		return fmt.Errorf("%w: path parameter '%s' must not be empty", ErrMissingRequiredParameter, paramName)
	}
	return nil
}

// serializeStyled serializes a value with OAS 3.0 parameter style formatting.
//
// Handles matrix, label, simple, form, spaceDelimited, and pipeDelimited
// styles. deepObject is handled separately by serializeDeepObject.
//
// Parameters:
//   - paramName: the parameter name
//   - value: the value to serialize (may be nil)
//   - location: where the parameter appears: "path", "query", "header", or "cookie"
//   - schemaType: the OpenAPI schema type
//   - collectionFormat: the collection format (may be empty)
//   - style: the OAS 3.0 parameter style (may be empty)
//   - explode: whether to explode arrays
//
// Returns the serialized value, or nil to omit the parameter.
func serializeStyled(paramName string, value any, location, schemaType, collectionFormat, style string, explode bool) any {
	if style == "" {
		return serializeValue(value, location, schemaType, collectionFormat)
	}

	items, isArray := toStringSlice(value)

	// For path styles, percent-encode each individual item BEFORE applying
	// the structural separators (";", "=", ".", ",") that the style defines.
	// This ensures reserved characters inside the value are escaped while
	// the style's structural punctuation remains literal.
	if location == "path" {
		encoded := make([]string, len(items))
		for i, item := range items {
			encoded[i] = encodePathSegment(item)
		}
		items = encoded
		if !isArray && value != nil {
			value = encodePathSegment(stringify(value))
		}
	}

	switch style {
	case "matrix":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			if explode {
				var parts []string
				for _, v := range items {
					parts = append(parts, fmt.Sprintf(";%s=%s", paramName, v))
				}
				return strings.Join(parts, "")
			}
			return fmt.Sprintf(";%s=%s", paramName, strings.Join(items, ","))
		}
		return fmt.Sprintf(";%s=%s", paramName, stringify(value))

	case "label":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			if explode {
				return "." + strings.Join(items, ".")
			}
			return "." + strings.Join(items, ",")
		}
		return "." + stringify(value)

	case "spaceDelimited":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			if explode {
				return items
			}
			return strings.Join(items, " ")
		}
		return stringify(value)

	case "pipeDelimited":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			if explode {
				return items
			}
			return strings.Join(items, "|")
		}
		return stringify(value)

	case "form":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			if explode {
				return items
			}
			return strings.Join(items, ",")
		}
		return stringify(value)

	case "simple":
		if value == nil {
			if location == "query" {
				return nil
			}
			return ""
		}
		if isArray {
			return strings.Join(items, ",")
		}
		return stringify(value)

	default:
		return serializeValue(value, location, schemaType, collectionFormat)
	}
}

// serializeNil returns the serialized form of a nil value: nil (omit the
// parameter) for a query parameter, an empty string for every other location.
func serializeNil(location string) any {
	if location == "query" {
		return nil
	}
	return ""
}

// toStringSlice attempts to convert a value to a []string.
//
// Returns the string slice and true if the conversion was successful.
//
// The fast-path type switches cover the common []string / []any shapes. For
// everything else — pointers to slices (e.g. *[]string for an OPTIONAL array
// parameter), and slices of named element types (e.g. []Color, *[]MyEnum) —
// it falls back to reflection: any pointer is dereferenced, and a slice or
// array of any element type is stringified per element. Without this, an
// optional array param arrives as *[]string and misses both type switch
// cases, falling through to %v debug formatting that emits garbage like
// `&[blue black]` into the query string instead of properly styled values.
func toStringSlice(value any) ([]string, bool) {
	switch v := value.(type) {
	case []string:
		return v, true
	case []any:
		items := make([]string, len(v))
		for i, item := range v {
			items[i] = stringify(item)
		}
		return items, true
	}

	rv := reflect.ValueOf(value)
	// Dereference a pointer (e.g. *[]string for an optional array param). A nil
	// pointer is not an array value, so report no slice.
	if rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return nil, false
		}
		rv = rv.Elem()
	}
	// Reflect over slices and arrays of arbitrary element types (named string
	// enums, typed scalars) that the type switch above cannot name. Each element
	// is stringified through the same per-element path as []any, so enum and
	// scalar elements encode identically whether boxed as []any or a typed slice.
	if rv.Kind() == reflect.Slice || rv.Kind() == reflect.Array {
		items := make([]string, rv.Len())
		for i := range rv.Len() {
			items[i] = stringify(rv.Index(i).Interface())
		}
		return items, true
	}

	return nil, false
}
