package oauth

import (
	"encoding/base64"
	"log"
	"net/url"
	"strings"

	"{{packageName}}/pkg/auth"
)

// OAuth2PasswordAuthenticator provides OAuth2 resource owner password credentials flow authentication.
//
// Implements HttpAwareAuthenticator so that token exchange requests use the
// shared ApiClient with the same transport configuration (proxy, TLS, timeouts)
// as regular API calls.
type OAuth2PasswordAuthenticator struct {
	auth.BaseAuthenticator
	host             string
	clientID         string
	clientSecret     string
	tokenURL         string
	refreshURL       string
	username         string
	password         string
	scopes           []string
	clientAuthMethod ClientAuthMethod
	tokenManager     *OAuth2TokenManager
}

// NewOAuth2PasswordAuthenticator creates a new password authenticator.
//
// If refreshURL is empty, the tokenURL is used for refresh requests.
// Use WithClientAuthMethod to switch to HTTP Basic authentication for the token request.
func NewOAuth2PasswordAuthenticator(host, clientID, clientSecret, tokenURL, username, password string, scopes []string, refreshURL string) *OAuth2PasswordAuthenticator {
	if refreshURL == "" {
		refreshURL = tokenURL
	}
	return &OAuth2PasswordAuthenticator{
		host:             host,
		clientID:         clientID,
		clientSecret:     clientSecret,
		tokenURL:         tokenURL,
		refreshURL:       refreshURL,
		username:         username,
		password:         password,
		scopes:           scopes,
		clientAuthMethod: ClientAuthMethodBody,
		tokenManager:     NewOAuth2TokenManager(),
	}
}

// WithClientAuthMethod sets how the client_id/client_secret are transmitted
// to the token endpoint. Returns the receiver to allow chaining.
func (a *OAuth2PasswordAuthenticator) WithClientAuthMethod(method ClientAuthMethod) *OAuth2PasswordAuthenticator {
	a.clientAuthMethod = method
	return a
}

// Host returns the API base URL.
func (a *OAuth2PasswordAuthenticator) Host() string {
	return a.host
}

// SetApiClient injects the shared API client for making token requests.
func (a *OAuth2PasswordAuthenticator) SetApiClient(client auth.ApiClient) {
	a.tokenManager.SetApiClient(client)
}

// AuthHeaders returns the Bearer authentication header with a valid access token.
func (a *OAuth2PasswordAuthenticator) AuthHeaders() map[string]string {
	var params map[string]string
	var tokenURL string
	var extraHeaders map[string]string
	if a.clientAuthMethod == ClientAuthMethodBasic {
		// RFC 6749 §2.3.1: form-urlencode the client_id and client_secret
		// separately before joining with ':' and base64-encoding.
		encodedID := url.QueryEscape(a.clientID)
		encodedSecret := url.QueryEscape(a.clientSecret)
		credentials := base64.StdEncoding.EncodeToString([]byte(encodedID + ":" + encodedSecret))
		extraHeaders = map[string]string{"Authorization": "Basic " + credentials}
	}

	if refreshToken := a.tokenManager.RefreshToken(); refreshToken != "" {
		params = map[string]string{
			"grant_type":    "refresh_token",
			"refresh_token": refreshToken,
		}
		tokenURL = a.refreshURL
	} else {
		params = map[string]string{
			"grant_type": "password",
			"username":   a.username,
			"password":   a.password,
		}
		if a.clientAuthMethod != ClientAuthMethodBasic {
			params["client_id"] = a.clientID
			params["client_secret"] = a.clientSecret
		}
		if len(a.scopes) > 0 {
			params["scope"] = strings.Join(a.scopes, " ")
		}
		tokenURL = a.tokenURL
	}

	token, err := a.tokenManager.GetAccessTokenWithHeaders(tokenURL, params, extraHeaders)
	if err != nil {
		log.Printf("oauth2 password token error: %v", err)
		return map[string]string{}
	}

	return map[string]string{
		"Authorization": "Bearer " + token,
	}
}
