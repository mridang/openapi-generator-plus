package oauth

import (
	"net/http"
	"strings"

	"{{packageName}}/auth"
)

// OAuth2PasswordAuthenticator provides OAuth2 resource owner password credentials flow authentication.
//
// Implements HttpAwareAuthenticator so that token exchange requests use the
// shared *http.Client with the same transport configuration (proxy, TLS, timeouts)
// as regular API calls.
type OAuth2PasswordAuthenticator struct {
	auth.BaseAuthenticator
	host         string
	clientID     string
	clientSecret string
	tokenURL     string
	refreshURL   string
	username     string
	password     string
	scopes       []string
	tokenManager *OAuth2TokenManager
}

// NewOAuth2PasswordAuthenticator creates a new password authenticator.
//
// If refreshURL is empty, the tokenURL is used for refresh requests.
func NewOAuth2PasswordAuthenticator(host, clientID, clientSecret, tokenURL, username, password string, scopes []string, refreshURL string) *OAuth2PasswordAuthenticator {
	if refreshURL == "" {
		refreshURL = tokenURL
	}
	return &OAuth2PasswordAuthenticator{
		host:         host,
		clientID:     clientID,
		clientSecret: clientSecret,
		tokenURL:     tokenURL,
		refreshURL:   refreshURL,
		username:     username,
		password:     password,
		scopes:       scopes,
		tokenManager: NewOAuth2TokenManager(),
	}
}

// Host returns the API base URL.
func (a *OAuth2PasswordAuthenticator) Host() string {
	return a.host
}

// SetHTTPClient injects the shared HTTP client for making token requests.
func (a *OAuth2PasswordAuthenticator) SetHTTPClient(client *http.Client) {
	a.tokenManager.SetHTTPClient(client)
}

// AuthHeaders returns the Bearer authentication header with a valid access token.
func (a *OAuth2PasswordAuthenticator) AuthHeaders() map[string]string {
	var params map[string]string
	var tokenURL string

	if refreshToken := a.tokenManager.RefreshToken(); refreshToken != "" {
		params = map[string]string{
			"grant_type":    "refresh_token",
			"refresh_token": refreshToken,
		}
		tokenURL = a.refreshURL
	} else {
		params = map[string]string{
			"grant_type":    "password",
			"client_id":     a.clientID,
			"client_secret": a.clientSecret,
			"username":      a.username,
			"password":      a.password,
		}
		if len(a.scopes) > 0 {
			params["scope"] = strings.Join(a.scopes, " ")
		}
		tokenURL = a.tokenURL
	}

	token, err := a.tokenManager.GetAccessToken(tokenURL, params)
	if err != nil {
		return map[string]string{}
	}

	return map[string]string{
		"Authorization": "Bearer " + token,
	}
}
