package oauth

import (
	"encoding/json"
	"fmt"
	"net/url"
	"sync"
	"time"

	"{{packageName}}/pkg/auth"
)

// OAuth2TokenManager manages OAuth2 token lifecycle: fetching, caching, and refreshing.
//
// Uses the shared ApiClient instance so that token exchange requests honour
// the same transport configuration (proxy, TLS, timeouts) as regular API calls.
type OAuth2TokenManager struct {
	mu           sync.Mutex
	apiClient    auth.ApiClient
	accessToken  string
	refreshToken string
	tokenExpiry  time.Time
}

// NewOAuth2TokenManager creates a new token manager.
//
// The ApiClient must be injected via SetApiClient before any token requests
// are made.
func NewOAuth2TokenManager() *OAuth2TokenManager {
	return &OAuth2TokenManager{}
}

// SetApiClient injects the shared API client for making token requests.
func (m *OAuth2TokenManager) SetApiClient(client auth.ApiClient) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.apiClient = client
}

// RefreshToken returns the current refresh token, if any.
func (m *OAuth2TokenManager) RefreshToken() string {
	m.mu.Lock()
	defer m.mu.Unlock()
	return m.refreshToken
}

// GetAccessToken returns a valid access token, fetching or refreshing as necessary.
//
// This method is synchronized to prevent concurrent token requests.
func (m *OAuth2TokenManager) GetAccessToken(tokenURL string, params map[string]string) (string, error) {
	m.mu.Lock()
	defer m.mu.Unlock()

	if m.accessToken != "" && !m.tokenExpiry.IsZero() && time.Now().Before(m.tokenExpiry) {
		return m.accessToken, nil
	}

	if err := m.fetchToken(tokenURL, params); err != nil {
		return "", err
	}
	return m.accessToken, nil
}

// SetAccessToken manually sets an access token, bypassing the token endpoint.
func (m *OAuth2TokenManager) SetAccessToken(token string) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.accessToken = token
	m.tokenExpiry = time.Time{}
}

func (m *OAuth2TokenManager) fetchToken(tokenURL string, params map[string]string) error {
	client := m.apiClient
	if client == nil {
		return fmt.Errorf("API client has not been injected. " +
			"Ensure the {{clientClassName}} constructor calls SetApiClient " +
			"on HttpAwareAuthenticator before making API requests")
	}

	values := url.Values{}
	for k, v := range params {
		values.Set(k, v)
	}

	headers := map[string]string{
		"Content-Type": "application/x-www-form-urlencoded",
	}

	resp, err := client.SendRequest("POST", tokenURL, headers, []byte(values.Encode()))
	if err != nil {
		return fmt.Errorf("token request failed: %w", err)
	}

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("token request failed with status %d", resp.StatusCode)
	}

	var parsed struct {
		AccessToken  string `json:"access_token"`
		RefreshToken string `json:"refresh_token"`
		ExpiresIn    int    `json:"expires_in"`
	}
	if err := json.Unmarshal([]byte(resp.Body), &parsed); err != nil {
		return fmt.Errorf("failed to parse token response: %w", err)
	}

	m.accessToken = parsed.AccessToken
	if parsed.RefreshToken != "" {
		m.refreshToken = parsed.RefreshToken
	}
	if parsed.ExpiresIn > 0 {
		m.tokenExpiry = time.Now().Add(time.Duration(parsed.ExpiresIn-30) * time.Second)
	}

	return nil
}
