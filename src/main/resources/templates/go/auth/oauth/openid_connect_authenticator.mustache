package oauth

import (
	"encoding/json"
	"fmt"
	"net/url"
	"regexp"
	"strconv"
	"strings"
	"sync"
	"time"

	"{{packageName}}/pkg/auth"
	errors_pkg "{{packageName}}/pkg/errors"
)

// defaultDiscoveryMaxAgeSeconds is the RFC 8414 recommended default max-age
// for OIDC discovery documents (1 day).
const defaultDiscoveryMaxAgeSeconds = 86400

// maxDiscoveryMaxAgeSeconds caps a server-supplied max-age at one year. A
// larger value would overflow time.Duration and wrap the expiry into the past.
const maxDiscoveryMaxAgeSeconds = 31_536_000

var maxAgePattern = regexp.MustCompile(`(?i)max-age=(\d+)`)

// parseDiscoveryMaxAge extracts the `max-age=<seconds>` value from a
// `Cache-Control` response header. Returns 86400 when the header is absent
// or does not contain a `max-age` directive. A larger value is clamped to one
// year.
func parseDiscoveryMaxAge(headers map[string]string) int {
	for k, v := range headers {
		if strings.EqualFold(k, "Cache-Control") {
			match := maxAgePattern.FindStringSubmatch(v)
			if len(match) >= 2 {
				if seconds, err := strconv.Atoi(match[1]); err == nil {
					return min(seconds, maxDiscoveryMaxAgeSeconds)
				}
			}
			return defaultDiscoveryMaxAgeSeconds
		}
	}
	return defaultDiscoveryMaxAgeSeconds
}

// OpenIdConnectAuthenticator is the authenticator for OpenID Connect.
//
// Fetches the OIDC discovery document to discover the authorization and
// token endpoints, then delegates to an OAuth2AuthorizationCodeAuthenticator.
//
// Implements HttpAwareAuthenticator so that both the discovery request and
// subsequent token exchange requests use the shared ApiClient with the same
// transport configuration (proxy, TLS, timeouts) as regular API calls.
type OpenIdConnectAuthenticator struct {
	auth.BaseAuthenticator
	host              string
	openIDConnectURL  string
	clientID          string
	clientSecret      string
	redirectURI       string
	scopes            []string
	apiClient         auth.ApiClient
	delegate          *OAuth2AuthorizationCodeAuthenticator
	discoveryExpiry   time.Time
	mu                sync.Mutex
}

// NewOpenIdConnectAuthenticator creates a new OpenID Connect authenticator.
func NewOpenIdConnectAuthenticator(host, openIDConnectURL, clientID, clientSecret, redirectURI string, scopes []string) *OpenIdConnectAuthenticator {
	return &OpenIdConnectAuthenticator{
		host:             host,
		openIDConnectURL: openIDConnectURL,
		clientID:         clientID,
		clientSecret:     clientSecret,
		redirectURI:      redirectURI,
		scopes:           withOpenIDScope(scopes),
	}
}

// withOpenIDScope puts "openid" first and drops any repeat: OpenID Connect Core 3.1.2.1
// requires the scope parameter to contain it.
func withOpenIDScope(scopes []string) []string {
	result := []string{"openid"}
	for _, s := range scopes {
		if s != "openid" {
			result = append(result, s)
		}
	}
	return result
}

// Host returns the API base URL.
func (a *OpenIdConnectAuthenticator) Host() string {
	return a.host
}

// String returns a string representation that redacts the client secret so
// credentials never leak into logs or stack traces (matching the other SDKs).
func (a *OpenIdConnectAuthenticator) String() string {
	return fmt.Sprintf("OpenIdConnectAuthenticator{host: %q, openIDConnectURL: %q, clientID: %q, clientSecret: ***, redirectURI: %q}", a.host, a.openIDConnectURL, a.clientID, a.redirectURI)
}

// GoString redacts the same secrets for the %#v verb. fmt ignores String()
// for %#v and would otherwise reflect over every unexported field, secrets
// included, into logs and test-failure output.
func (a *OpenIdConnectAuthenticator) GoString() string {
	return a.String()
}

// SetApiClient injects the shared API client for making discovery and token requests.
func (a *OpenIdConnectAuthenticator) SetApiClient(client auth.ApiClient) {
	a.mu.Lock()
	defer a.mu.Unlock()
	a.apiClient = client
}

// InvalidateAccessToken drops the cached access token of the current session
// and keeps the refresh token. It makes no discovery request: before the first
// discovery there is no token to drop.
func (a *OpenIdConnectAuthenticator) InvalidateAccessToken() {
	a.mu.Lock()
	delegate := a.delegate
	a.mu.Unlock()
	if delegate != nil {
		delegate.InvalidateAccessToken()
	}
}

// BuildAuthorizationURL builds the authorization URL using the discovered
// authorization endpoint.
func (a *OpenIdConnectAuthenticator) BuildAuthorizationURL(state string) (string, error) {
	delegate, err := a.resolveDelegate()
	if err != nil {
		return "", err
	}
	return delegate.BuildAuthorizationURL(state), nil
}

// ExchangeCode exchanges an authorization code for tokens using the
// discovered token endpoint.
func (a *OpenIdConnectAuthenticator) ExchangeCode(code string) error {
	// Reject an empty/whitespace code before fetching the discovery document or
	// hitting the token endpoint.
	if strings.TrimSpace(code) == "" {
		return ErrAuthCodeEmpty
	}
	delegate, err := a.resolveDelegate()
	if err != nil {
		return err
	}
	return delegate.ExchangeCode(code)
}

// AuthHeadersOrError returns the Bearer authentication header, or the error
// that prevented it: a failed discovery request, ErrAuthCodeNotExchanged, or a
// token-endpoint failure. base_api prefers this method, so the real error
// surfaces instead of an unauthenticated request.
func (a *OpenIdConnectAuthenticator) AuthHeadersOrError() (map[string]string, error) {
	delegate, err := a.resolveDelegate()
	if err != nil {
		return nil, err
	}
	return delegate.AuthHeadersOrError()
}

// AuthHeaders returns the Bearer authentication header, or an empty map when
// it cannot be obtained. Use AuthHeadersOrError to see why.
func (a *OpenIdConnectAuthenticator) AuthHeaders() map[string]string {
	headers, err := a.AuthHeadersOrError()
	if err != nil {
		return map[string]string{}
	}
	return headers
}

// resolveDelegate lazily resolves the delegate by fetching the OIDC discovery
// document using the injected API client. Honors the `Cache-Control: max-age=<seconds>`
// header from the discovery response; falls back to the RFC 8414 recommended
// default of 86400 seconds when absent.
//
// Once a delegate exists, a failed rediscovery keeps using it (stale-if-error)
// and retries after discoveryRetryDelay, so a brief outage of the discovery
// endpoint does not fail API calls whose cached endpoints and tokens are still
// valid. The first discovery has nothing to fall back on and returns its error.
func (a *OpenIdConnectAuthenticator) resolveDelegate() (*OAuth2AuthorizationCodeAuthenticator, error) {
	a.mu.Lock()
	defer a.mu.Unlock()

	if a.delegate != nil && time.Now().Before(a.discoveryExpiry) {
		return a.delegate, nil
	}

	delegate, err := a.discover()
	if err != nil && a.delegate != nil {
		a.discoveryExpiry = time.Now().Add(discoveryRetryDelay)
		return a.delegate, nil
	}
	return delegate, err
}

// discoveryRetryDelay is how long a failed rediscovery waits before the next
// attempt while the previous delegate keeps serving.
const discoveryRetryDelay = 30 * time.Second

// discover fetches the discovery document and replaces the delegate. The caller
// holds a.mu.
func (a *OpenIdConnectAuthenticator) discover() (*OAuth2AuthorizationCodeAuthenticator, error) {
	client := a.apiClient
	if client == nil {
		return nil, ErrApiClientNotInjected
	}

	headers := map[string]string{
		"Accept": "application/json",
	}

	/* Discovery is an HTTP call like any other: a transport failure is
	 * already a *NetworkError or *NetworkTimeoutError and is returned
	 * unchanged. */
	resp, err := client.SendRequest("GET", a.openIDConnectURL, headers, nil)
	if err != nil {
		return nil, err
	}

	/* A non-2xx discovery response (e.g. a 500 HTML error page) surfaces as
	 * the typed *ApiError for its status rather than a misleading "invalid
	 * JSON" parse failure downstream. */
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, errors_pkg.FromResponse(resp.StatusCode, resp.Headers, resp.Body)
	}

	var discovery struct {
		Issuer                any    `json:"issuer"`
		AuthorizationEndpoint string `json:"authorization_endpoint"`
		TokenEndpoint         string `json:"token_endpoint"`
	}
	if err := json.Unmarshal([]byte(resp.Body), &discovery); err != nil {
		return nil, errors_pkg.NewSerializationError("oidc discovery document is not valid JSON", err)
	}

	/* A discovery document missing authorization_endpoint or token_endpoint
	 * must fail loud. Building the delegate with empty endpoint URLs would
	 * silently produce malformed authorization/token requests against the
	 * wrong (empty) URL. An incomplete document is a *SerializationError. */
	if strings.TrimSpace(discovery.AuthorizationEndpoint) == "" {
		return nil, errors_pkg.NewSerializationError("oidc discovery document is missing 'authorization_endpoint'", nil)
	}
	if strings.TrimSpace(discovery.TokenEndpoint) == "" {
		return nil, errors_pkg.NewSerializationError("oidc discovery document is missing 'token_endpoint'", nil)
	}

	/* OpenID Connect Discovery 1.0 section 4.3 / RFC 8414 section 3.3: the
	 * issuer must equal the URL the document was fetched from, minus the
	 * well-known suffix, which is the defence against a document served for
	 * another issuer. A document with no issuer, or a discovery URL of another
	 * shape, is not rejected here. */
	const wellKnownSuffix = "/.well-known/openid-configuration"
	if issuer, ok := discovery.Issuer.(string); ok && strings.HasSuffix(a.openIDConnectURL, wellKnownSuffix) {
		expected := strings.TrimRight(strings.TrimSuffix(a.openIDConnectURL, wellKnownSuffix), "/")
		if strings.TrimRight(issuer, "/") != expected {
			return nil, errors_pkg.NewSerializationError("oidc discovery document issuer does not match the discovery URL", nil)
		}
	}
	/* The authorization code and the client secret travel to these endpoints:
	 * clear text is refused unless the host is a loopback address (RFC 8252
	 * section 8.3). */
	if !isSecureEndpoint(discovery.AuthorizationEndpoint) {
		return nil, errors_pkg.NewSerializationError("oidc discovery authorization_endpoint must use https", nil)
	}
	if !isSecureEndpoint(discovery.TokenEndpoint) {
		return nil, errors_pkg.NewSerializationError("oidc discovery token_endpoint must use https", nil)
	}

	fresh := NewOAuth2AuthorizationCodeAuthenticator(
		a.host, a.clientID, a.clientSecret,
		discovery.AuthorizationEndpoint,
		discovery.TokenEndpoint,
		a.redirectURI, a.scopes, "",
	)
	if a.delegate != nil {
		/* Rediscovery refreshes the endpoints only. The tokens already
		 * obtained, and the fact that the code was exchanged, belong to the
		 * user's session and must survive it. */
		fresh.tokenManager = a.delegate.tokenManager
		fresh.tokenExchanged.Store(a.delegate.tokenExchanged.Load())
		/* The PKCE verifier of a login that is still pending must survive
		 * too, or its code could no longer be exchanged. */
		fresh.setPKCEVerifier(a.delegate.currentPKCEVerifier())
	}
	a.delegate = fresh
	a.delegate.tokenManager.SetApiClient(client)
	a.discoveryExpiry = time.Now().Add(time.Duration(parseDiscoveryMaxAge(resp.Headers)) * time.Second)

	return a.delegate, nil
}

// isSecureEndpoint reports whether an endpoint may carry credentials: an https
// URL, or an http URL whose host is a loopback address.
func isSecureEndpoint(endpoint string) bool {
	parsed, err := url.Parse(endpoint)
	if err != nil {
		return false
	}
	switch strings.ToLower(parsed.Scheme) {
	case "https":
		return true
	case "http":
		host := strings.ToLower(parsed.Hostname())
		return host == "localhost" || strings.HasSuffix(host, ".localhost") ||
			host == "127.0.0.1" || host == "::1"
	default:
		return false
	}
}
