package {{packageName}}

// Credentials holds one optional authenticator for each security scheme of the
// API, named after the scheme. Leave a field nil for a scheme you do not use.
// Each operation uses the credential of the scheme its spec requires: of the
// schemes an operation accepts, the first one in spec order that has a
// credential here. An operation never sends the credential of a scheme it does
// not accept, and a call cannot override the scheme.
type Credentials struct {
{{#credentialSchemes}}
	/* {{fieldName}} authenticates the {{schemeId}} security scheme. */
	{{fieldName}} Authenticator
{{/credentialSchemes}}
}

// bySchemeId lists the credentials that are set, keyed by security scheme id.
func (c Credentials) bySchemeId() map[string]Authenticator {
	set := make(map[string]Authenticator)
{{#credentialSchemes}}
	if c.{{fieldName}} != nil {
		set["{{{schemeId}}}"] = c.{{fieldName}}
	}
{{/credentialSchemes}}
	return set
}
