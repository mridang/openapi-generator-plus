// BaseApi provides common functionality for all API classes.
type BaseApi struct {
	config         *Configuration
	apiClient      ApiClient
	headerSelector *HeaderSelector
	authenticator  Authenticator
}

// NewBaseApi creates a new BaseApi instance.
func NewBaseApi(apiClient ApiClient, config *Configuration, authenticator Authenticator) *BaseApi {
	if apiClient == nil {
		apiClient = NewDefaultApiClient(nil)
	}
	if config == nil {
		config = DefaultConfiguration()
	}
	return &BaseApi{
		config:         config,
		apiClient:      apiClient,
		headerSelector: NewHeaderSelector(),
		authenticator:  authenticator,
	}
}

// invokeApiParams holds parameters for the invokeApi call.
type invokeApiParams struct {
	method      string
	path        string
	queryParams map[string]any
	headerParams map[string]string
	body        any
	accepts     []string
	contentType string
	returnType  string
	auth        Authenticator
}

// invokeApiForResult dispatches an API request and returns the full result.
func (b *BaseApi) invokeApiForResult(params invokeApiParams) (*HttpResponse, error) {
	requestURL := params.path
	if !strings.HasPrefix(requestURL, "http://") && !strings.HasPrefix(requestURL, "https://") {
		requestURL = b.config.BaseURL() + params.path
	}

	/* Determine effective authenticator (per-request overrides instance-level) */
	effectiveAuth := params.auth
	if effectiveAuth == nil {
		effectiveAuth = b.authenticator
	}

	/* Merge authentication query params */
	if effectiveAuth != nil {
		authQueryParams := effectiveAuth.QueryParams()
		if params.queryParams == nil {
			params.queryParams = make(map[string]any)
		}
		for k, v := range authQueryParams {
			params.queryParams[k] = v
		}
	}

	/* Build query string */
	queryString := buildQueryString(params.queryParams)
	if queryString != "" {
		requestURL = requestURL + "?" + queryString
	}

	/* Select headers */
	isMultipart := params.contentType == "multipart/form-data"
	headers := b.headerSelector.SelectHeaders(params.accepts, params.contentType, isMultipart)

	/* Merge config default headers */
	for k, v := range b.config.DefaultHeaders() {
		headers[k] = v
	}

	/* Merge operation-specific headers */
	for k, v := range params.headerParams {
		headers[k] = v
	}

	/* Merge auth headers */
	if effectiveAuth != nil {
		/* oauth-cc-authheaders-error-swallow: prefer AuthHeadersOrError when the
		 * authenticator exposes it, so a token-fetch failure surfaces as the real
		 * OAuth error instead of being swallowed into an empty header map (which
		 * would send the request unauthenticated and produce a confusing 401). */
		authHeaders := effectiveAuth.AuthHeaders()
		if p, ok := effectiveAuth.(interface {
			AuthHeadersOrError() (map[string]string, error)
		}); ok {
			h, aerr := p.AuthHeadersOrError()
			if aerr != nil {
				return nil, aerr
			}
			authHeaders = h
		}
		for k, v := range authHeaders {
			headers[k] = v
		}
		/* Handle cookie params. RFC 6265 — don't URL-encode cookie name/value;
		 * most cookie parsers don't URL-decode, so `=` (base64 padding) would
		 * arrive as literal `%3D` and break JWT/session cookies. Validate and
		 * pass through raw instead. panic on invalid input — it's a
		 * programmer error. */
		cookies := effectiveAuth.CookieParams()
		if len(cookies) > 0 {
			var cookieParts []string
			for k, v := range cookies {
				if !isValidCookieName(k) {
					panic(fmt.Sprintf("Cookie name '%s' contains characters forbidden by RFC 6265", k))
				}
				if !isValidCookieValue(v) {
					panic(fmt.Sprintf("Cookie value for '%s' contains characters forbidden by RFC 6265", k))
				}
				cookieParts = append(cookieParts, fmt.Sprintf("%s=%s", k, v))
			}
			cookieStr := strings.Join(cookieParts, "; ")
			if existing, ok := headers["Cookie"]; ok {
				headers["Cookie"] = existing + "; " + cookieStr
			} else {
				headers["Cookie"] = cookieStr
			}
		}
	}

	/* Inject trace context */
	InjectTraceContext(headers)

	/* Serialize body -- multipart/form-data is handled here so that
	 * the boundary can be injected into the Content-Type header. */
	var serializedBody []byte
	if params.contentType == "multipart/form-data" && params.body != nil {
		formFields, ok := params.body.(map[string]any)
		if !ok {
			return nil, fmt.Errorf("multipart body must be map[string]any")
		}
		boundary := uuid.New().String()
		headers["Content-Type"] = "multipart/form-data; boundary=" + boundary
		var merr error
		serializedBody, merr = buildMultipartBody(formFields, boundary)
		if merr != nil {
			return nil, fmt.Errorf("failed to build multipart body: %w", merr)
		}
	} else {
		var err error
		serializedBody, err = serializeBody(params.body, params.contentType)
		if err != nil {
			return nil, fmt.Errorf("failed to serialize request body: %w", err)
		}
	}

	/* Drop Content-Type when there is no body (sending Content-Type without a
	 * body is semantically wrong and rejected by some servers). */
	if serializedBody == nil {
		delete(headers, "Content-Type")
	}

	/* Send request */
	response, err := b.apiClient.SendRequest(params.method, requestURL, headers, serializedBody)
	if err != nil {
		return nil, err
	}

	/* Check for errors */
	if response.StatusCode < 200 || response.StatusCode >= 300 {
		return nil, throwAPIError(response)
	}

	return response, nil
}

// invokeApi dispatches an API request and returns just the response.
func (b *BaseApi) invokeApi(params invokeApiParams) (*HttpResponse, error) {
	return b.invokeApiForResult(params)
}

func buildQueryString(queryParams map[string]any) string {
	if len(queryParams) == 0 {
		return ""
	}

	var parts []string
	for k, v := range queryParams {
		if v == nil {
			continue
		}
		encodedKey := url.QueryEscape(k)

		switch val := v.(type) {
		case []string:
			for _, item := range val {
				parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(item)))
			}
		case string:
			parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(val)))
		default:
			parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(Stringify(v))))
		}
	}

	return strings.Join(parts, "&")
}

func serializeBody(body any, contentType string) ([]byte, error) {
	if body == nil {
		return nil, nil
	}

	if contentType == "multipart/form-data" {
		/* Multipart is handled by invokeApiForResult before calling serializeBody */
		return nil, nil
	}

	if strings.HasPrefix(contentType, "image/") || contentType == "application/octet-stream" {
		if data, ok := body.([]byte); ok {
			return data, nil
		}
		if str, ok := body.(string); ok {
			return []byte(str), nil
		}
	}

	if contentType == "text/plain" {
		return []byte(fmt.Sprintf("%v", body)), nil
	}

	if contentType == "application/x-www-form-urlencoded" {
		if params, ok := body.(map[string]any); ok {
			values := url.Values{}
			for k, v := range params {
				values.Set(k, fmt.Sprintf("%v", v))
			}
			return []byte(values.Encode()), nil
		}
	}

	return Serialize(body)
}

/* buildMultipartBody constructs a multipart/form-data request body from
 * a map of form fields. Each value may be a string, number, boolean,
 * slice (repeated field), map (serialized as JSON part), or nil (skipped). */
func buildMultipartBody(formFields map[string]any, boundary string) ([]byte, error) {
	var buf strings.Builder
	writer := multipart.NewWriter(&buf)
	_ = writer.SetBoundary(boundary)

	for name, value := range formFields {
		if value == nil {
			continue
		}
		switch v := value.(type) {
		case []any:
			for _, item := range v {
				if err := writeMultipartField(writer, name, item); err != nil {
					return nil, err
				}
			}
		default:
			if err := writeMultipartField(writer, name, v); err != nil {
				return nil, err
			}
		}
	}
	writer.Close()
	return []byte(buf.String()), nil
}

func writeMultipartField(writer *multipart.Writer, name string, value any) error {
	if value == nil {
		return nil
	}
	switch v := value.(type) {
	case string:
		return writer.WriteField(name, v)
	case *os.File:
		if v == nil {
			return nil
		}
		fileName := filepath.Base(v.Name())
		part, err := createMultipartFilePart(writer, name, fileName)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		if _, err := v.Seek(0, io.SeekStart); err != nil {
			return fmt.Errorf("failed to rewind multipart file %q: %w", name, err)
		}
		_, err = io.Copy(part, v)
		return err
	case io.Reader:
		part, err := createMultipartFilePart(writer, name, name)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		_, err = io.Copy(part, v)
		return err
	case []byte:
		part, err := createMultipartFilePart(writer, name, name)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		_, err = part.Write(v)
		return err
	case map[string]any:
		return writeJSONMultipartPart(writer, name, v)
	default:
		/* multipart-object-part-contenttype-go: object/model/map form values are
		 * serialised as JSON, so the part must advertise
		 * Content-Type: application/json (matching the other 11 SDKs). Scalars
		 * keep the plain text-field encoding. */
		if isJSONObjectValue(v) {
			return writeJSONMultipartPart(writer, name, v)
		}
		return writer.WriteField(name, fmt.Sprintf("%v", v))
	}
}

/* isJSONObjectValue reports whether a multipart form value should be emitted as
 * a JSON part (with Content-Type: application/json) rather than a plain text
 * field — i.e. it is a struct, map, or pointer to one (an object/model), as
 * opposed to a scalar. */
func isJSONObjectValue(value any) bool {
	if value == nil {
		return false
	}
	rv := reflect.ValueOf(value)
	for rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return false
		}
		rv = rv.Elem()
	}
	switch rv.Kind() {
	case reflect.Struct, reflect.Map:
		return true
	default:
		return false
	}
}

/* writeJSONMultipartPart writes value as a JSON multipart part carrying an
 * explicit Content-Type: application/json header. multipart.Writer's
 * CreateFormField sets only Content-Disposition, which would leave the JSON
 * part to be treated as text/plain by content-type-dispatching servers, so the
 * part header is built manually here. */
func writeJSONMultipartPart(writer *multipart.Writer, name string, value any) error {
	jsonBytes, err := json.Marshal(value)
	if err != nil {
		return fmt.Errorf("failed to marshal multipart field %q as JSON: %w", name, err)
	}
	if err := ValidateMultipartFieldName(name); err != nil {
		return err
	}
	header := make(textproto.MIMEHeader)
	header.Set("Content-Disposition", fmt.Sprintf(`form-data; name="%s"`, escapeQuotes(name)))
	header.Set("Content-Type", "application/json")
	part, err := writer.CreatePart(header)
	if err != nil {
		return fmt.Errorf("failed to create multipart field %q: %w", name, err)
	}
	_, err = part.Write(jsonBytes)
	return err
}

/* decodeBinaryResponse decodes the transport's base64-encoded response body
 * back to its original raw bytes. The DefaultApiClient base64-encodes any
 * non-text response so that the body can be carried as a string in
 * HttpResponse; this helper reverses that encoding for callers that expect
 * a []byte return type. */
func decodeBinaryResponse(body string) ([]byte, error) {
	if body == "" {
		return []byte{}, nil
	}
	return base64.StdEncoding.DecodeString(body)
}

/* mimeTypeForFilename returns a Content-Type guess derived from the file
 * extension. Falls back to application/octet-stream when the extension is
 * unknown or absent. Used by multipart writers so that each file part
 * advertises a meaningful Content-Type rather than the generic default. */
func mimeTypeForFilename(filename string) string {
	ext := strings.ToLower(filepath.Ext(filename))
	switch ext {
	case ".png":
		return "image/png"
	case ".jpg", ".jpeg":
		return "image/jpeg"
	case ".gif":
		return "image/gif"
	case ".pdf":
		return "application/pdf"
	case ".json":
		return "application/json"
	case ".txt":
		return "text/plain"
	case ".html", ".htm":
		return "text/html"
	}
	if t := mime.TypeByExtension(ext); t != "" {
		return t
	}
	return "application/octet-stream"
}

/* createMultipartFilePart creates a multipart file part with a Content-Type
 * derived from the filename extension. multipart.Writer.CreateFormFile
 * always uses application/octet-stream which loses the per-part media type
 * for typed uploads (e.g. PNG, PDF). For non-ASCII filenames it emits an
 * RFC 5987 filename*= parameter alongside an ASCII fallback so that servers
 * receive the original filename intact rather than mangled UTF-8. */
func createMultipartFilePart(writer *multipart.Writer, fieldName, fileName string) (io.Writer, error) {
	if err := ValidateMultipartFilename(fileName); err != nil {
		return nil, err
	}
	header := make(textproto.MIMEHeader)
	header.Set("Content-Disposition",
		fmt.Sprintf(`form-data; name="%s"; %s`,
			escapeQuotes(fieldName), BuildFilenameDirective(fileName)))
	header.Set("Content-Type", mimeTypeForFilename(fileName))
	return writer.CreatePart(header)
}

/* escapeQuotes backslash-escapes characters that would otherwise terminate a
 * quoted-string in a multipart header. */
func escapeQuotes(s string) string {
	r := strings.NewReplacer("\\", "\\\\", `"`, `\"`)
	return r.Replace(s)
}

/* ValidateMultipartFilename rejects filenames that would allow Content-Disposition
 * header injection or smuggling. Returns an error if the filename contains
 * CR, LF, or NUL characters. */
func ValidateMultipartFilename(filename string) error {
	for _, c := range filename {
		if c == '\r' || c == '\n' || c == 0 {
			return fmt.Errorf("multipart filename must not contain CR, LF, or NUL characters")
		}
	}
	return nil
}

/* Gap W2: ValidateMultipartFieldName rejects multipart field names that
 * would allow Content-Disposition header injection. Returns an error if
 * the name contains CR, LF, or NUL characters. The caller still needs
 * to backslash-escape `"` and `\` via escapeQuotes when interpolating
 * the field name into a quoted-string parameter. */
func ValidateMultipartFieldName(name string) error {
	for _, c := range name {
		if c == '\r' || c == '\n' || c == 0 {
			return fmt.Errorf("multipart field name must not contain CR, LF, or NUL characters")
		}
	}
	return nil
}

/* BuildFilenameDirective builds the filename=... directive for a multipart part.
 * For ASCII-only filenames it emits filename="..." with quote/backslash escaping.
 * For non-ASCII filenames it additionally emits an RFC 5987
 * filename*=UTF-8''<percent-encoded> parameter alongside an ASCII fallback
 * (non-ASCII bytes replaced with '_'). */
func BuildFilenameDirective(filename string) string {
	escaped := escapeQuotes(filename)
	ascii := true
	for _, c := range filename {
		if c > 0x7F {
			ascii = false
			break
		}
	}
	if ascii {
		return fmt.Sprintf(`filename="%s"`, escaped)
	}
	var fallback strings.Builder
	for _, c := range filename {
		if c > 0x7F || c < 0x20 || c == 0x7F {
			fallback.WriteByte('_')
		} else {
			fallback.WriteRune(c)
		}
	}
	asciiFallback := escapeQuotes(fallback.String())
	encoded := rfc5987EncodeValue(filename)
	return fmt.Sprintf(`filename="%s"; filename*=UTF-8''%s`, asciiFallback, encoded)
}

/* rfc5987EncodeValue percent-encodes every byte that is not an RFC 3986 §2.3
 * unreserved character, producing the value-chars production of RFC 5987 §3.2.1. */
func rfc5987EncodeValue(s string) string {
	const hex = "0123456789ABCDEF"
	b := []byte(s)
	out := make([]byte, 0, len(b))
	for _, c := range b {
		isUnreserved := (c >= 'A' && c <= 'Z') ||
			(c >= 'a' && c <= 'z') ||
			(c >= '0' && c <= '9') ||
			c == '-' || c == '.' || c == '_' || c == '~'
		if isUnreserved {
			out = append(out, c)
		} else {
			out = append(out, '%', hex[c>>4], hex[c&0x0F])
		}
	}
	return string(out)
}

/* newEmptyBodyError builds the typed ApiError returned by a convenience
 * (non-WithHTTPInfo) method when a body-returning operation receives no
 * decodable body. convenience-empty-body-handling: the empty-body condition
 * must surface as a catchable, typed error instead of a silent nil/zero-value. */
func newEmptyBodyError(operationID string, statusCode int, rawBody string, headers map[string]string) error {
	return &ApiError{
		StatusCode:      statusCode,
		Msg:             fmt.Sprintf("expected a response body for %s but received none", operationID),
		ResponseBody:    rawBody,
		ResponseHeaders: headers,
	}
}

func throwAPIError(response *HttpResponse) error {
	code := response.StatusCode
	msg := fmt.Sprintf("API returned status code %d", code)
	body := response.Body

	var parsed any
	if body != "" {
		_ = json.Unmarshal([]byte(body), &parsed)
	}

	baseErr := &ApiError{
		StatusCode:      code,
		Msg:             msg,
		ResponseBody:    body,
		ResponseHeaders: response.Headers,
		ErrorBody:       parsed,
	}

	if code >= 400 && code < 500 {
		clientErr := &ClientError{ApiError: *baseErr}
		switch code {
		case 400:
			return &BadRequestError{ClientError: *clientErr}
		case 401:
			return &UnauthorizedError{ClientError: *clientErr}
		case 403:
			return &ForbiddenError{ClientError: *clientErr}
		case 404:
			return &NotFoundError{ClientError: *clientErr}
		case 409:
			return &ConflictError{ClientError: *clientErr}
		case 422:
			return &UnprocessableEntityError{ClientError: *clientErr}
		default:
			return clientErr
		}
	}

	if code >= 500 {
		serverErr := &ServerError{ApiError: *baseErr}
		switch code {
		case 500:
			return &InternalServerError{ServerError: *serverErr}
		default:
			return serverErr
		}
	}

	return baseErr
}

// isValidCookieName checks RFC 6265 cookie-name (RFC 7230 token).
func isValidCookieName(name string) bool {
	if name == "" {
		return false
	}
	for _, c := range name {
		ok := (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
			strings.ContainsRune("!#$%&'*+-.^_`|~", c)
		if !ok {
			return false
		}
	}
	return true
}

// isValidCookieValue checks RFC 6265 cookie-octet* validity.
func isValidCookieValue(value string) bool {
	for _, c := range value {
		ok := c == 0x21 ||
			(c >= 0x23 && c <= 0x2B) ||
			(c >= 0x2D && c <= 0x3A) ||
			(c >= 0x3C && c <= 0x5B) ||
			(c >= 0x5D && c <= 0x7E)
		if !ok {
			return false
		}
	}
	return true
}
