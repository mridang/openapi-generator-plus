package {{packageName}}

import (
	"encoding/json"
	"fmt"
	"io"
	"mime/multipart"
	"net/url"
	"os"
	"path/filepath"
	"strings"

	"github.com/google/uuid"

	. "{{packageName}}/pkg/errors"
)

// BaseApi provides common functionality for all API classes.
type BaseApi struct {
	config         *Configuration
	apiClient      ApiClient
	headerSelector *HeaderSelector
	authenticator  Authenticator
}

// NewBaseApi creates a new BaseApi instance.
func NewBaseApi(apiClient ApiClient, config *Configuration, authenticator Authenticator) *BaseApi {
	if apiClient == nil {
		apiClient = NewDefaultApiClient(nil)
	}
	if config == nil {
		config = DefaultConfiguration()
	}
	return &BaseApi{
		config:         config,
		apiClient:      apiClient,
		headerSelector: NewHeaderSelector(),
		authenticator:  authenticator,
	}
}

// invokeApiParams holds parameters for the invokeApi call.
type invokeApiParams struct {
	method      string
	path        string
	queryParams map[string]interface{}
	headerParams map[string]string
	body        interface{}
	accepts     []string
	contentType string
	returnType  string
	auth        Authenticator
}

// invokeApiForResult dispatches an API request and returns the full result.
func (b *BaseApi) invokeApiForResult(params invokeApiParams) (*HttpResponse, error) {
	requestURL := params.path
	if !strings.HasPrefix(requestURL, "http://") && !strings.HasPrefix(requestURL, "https://") {
		requestURL = b.config.BaseURL() + params.path
	}

	/* Determine effective authenticator (per-request overrides instance-level) */
	effectiveAuth := params.auth
	if effectiveAuth == nil {
		effectiveAuth = b.authenticator
	}

	/* Merge authentication query params */
	if effectiveAuth != nil {
		authQueryParams := effectiveAuth.QueryParams()
		if params.queryParams == nil {
			params.queryParams = make(map[string]interface{})
		}
		for k, v := range authQueryParams {
			params.queryParams[k] = v
		}
	}

	/* Build query string */
	queryString := buildQueryString(params.queryParams)
	if queryString != "" {
		requestURL = requestURL + "?" + queryString
	}

	/* Select headers */
	isMultipart := params.contentType == "multipart/form-data"
	headers := b.headerSelector.SelectHeaders(params.accepts, params.contentType, isMultipart)

	/* Merge config default headers */
	for k, v := range b.config.DefaultHeaders() {
		headers[k] = v
	}

	/* Merge operation-specific headers */
	for k, v := range params.headerParams {
		headers[k] = v
	}

	/* Merge auth headers */
	if effectiveAuth != nil {
		for k, v := range effectiveAuth.AuthHeaders() {
			headers[k] = v
		}
		/* Handle cookie params */
		cookies := effectiveAuth.CookieParams()
		if len(cookies) > 0 {
			var cookieParts []string
			for k, v := range cookies {
				cookieParts = append(cookieParts, fmt.Sprintf("%s=%s", url.QueryEscape(k), url.QueryEscape(v)))
			}
			cookieStr := strings.Join(cookieParts, "; ")
			if existing, ok := headers["Cookie"]; ok {
				headers["Cookie"] = existing + "; " + cookieStr
			} else {
				headers["Cookie"] = cookieStr
			}
		}
	}

	/* Inject trace context */
	InjectTraceContext(headers)

	/* Serialize body -- multipart/form-data is handled here so that
	 * the boundary can be injected into the Content-Type header. */
	var serializedBody []byte
	if params.contentType == "multipart/form-data" && params.body != nil {
		formFields, ok := params.body.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("multipart body must be map[string]interface{}")
		}
		boundary := uuid.New().String()
		headers["Content-Type"] = "multipart/form-data; boundary=" + boundary
		var merr error
		serializedBody, merr = buildMultipartBody(formFields, boundary)
		if merr != nil {
			return nil, fmt.Errorf("failed to build multipart body: %w", merr)
		}
	} else {
		var err error
		serializedBody, err = serializeBody(params.body, params.contentType)
		if err != nil {
			return nil, fmt.Errorf("failed to serialize request body: %w", err)
		}
	}

	/* Drop Content-Type when there is no body (sending Content-Type without a
	 * body is semantically wrong and rejected by some servers). */
	if serializedBody == nil {
		delete(headers, "Content-Type")
	}

	/* Send request */
	response, err := b.apiClient.SendRequest(params.method, requestURL, headers, serializedBody)
	if err != nil {
		return nil, err
	}

	/* Check for errors */
	if response.StatusCode < 200 || response.StatusCode >= 300 {
		return nil, throwAPIError(response)
	}

	return response, nil
}

// invokeApi dispatches an API request and returns just the response.
func (b *BaseApi) invokeApi(params invokeApiParams) (*HttpResponse, error) {
	return b.invokeApiForResult(params)
}

func buildQueryString(queryParams map[string]interface{}) string {
	if len(queryParams) == 0 {
		return ""
	}

	var parts []string
	for k, v := range queryParams {
		if v == nil {
			continue
		}
		encodedKey := url.QueryEscape(k)

		switch val := v.(type) {
		case []string:
			for _, item := range val {
				parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(item)))
			}
		case string:
			parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(val)))
		default:
			parts = append(parts, fmt.Sprintf("%s=%s", encodedKey, url.QueryEscape(Stringify(v))))
		}
	}

	return strings.Join(parts, "&")
}

func serializeBody(body interface{}, contentType string) ([]byte, error) {
	if body == nil {
		return nil, nil
	}

	if contentType == "multipart/form-data" {
		/* Multipart is handled by invokeApiForResult before calling serializeBody */
		return nil, nil
	}

	if strings.HasPrefix(contentType, "image/") || contentType == "application/octet-stream" {
		if data, ok := body.([]byte); ok {
			return data, nil
		}
		if str, ok := body.(string); ok {
			return []byte(str), nil
		}
	}

	if contentType == "text/plain" {
		return []byte(fmt.Sprintf("%v", body)), nil
	}

	if contentType == "application/x-www-form-urlencoded" {
		if params, ok := body.(map[string]interface{}); ok {
			values := url.Values{}
			for k, v := range params {
				values.Set(k, fmt.Sprintf("%v", v))
			}
			return []byte(values.Encode()), nil
		}
	}

	return Serialize(body)
}

/* buildMultipartBody constructs a multipart/form-data request body from
 * a map of form fields. Each value may be a string, number, boolean,
 * slice (repeated field), map (serialized as JSON part), or nil (skipped). */
func buildMultipartBody(formFields map[string]interface{}, boundary string) ([]byte, error) {
	var buf strings.Builder
	writer := multipart.NewWriter(&buf)
	_ = writer.SetBoundary(boundary)

	for name, value := range formFields {
		if value == nil {
			continue
		}
		switch v := value.(type) {
		case []interface{}:
			for _, item := range v {
				if err := writeMultipartField(writer, name, item); err != nil {
					return nil, err
				}
			}
		default:
			if err := writeMultipartField(writer, name, v); err != nil {
				return nil, err
			}
		}
	}
	writer.Close()
	return []byte(buf.String()), nil
}

func writeMultipartField(writer *multipart.Writer, name string, value interface{}) error {
	if value == nil {
		return nil
	}
	switch v := value.(type) {
	case string:
		return writer.WriteField(name, v)
	case *os.File:
		if v == nil {
			return nil
		}
		fileName := filepath.Base(v.Name())
		part, err := writer.CreateFormFile(name, fileName)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		if _, err := v.Seek(0, io.SeekStart); err != nil {
			return fmt.Errorf("failed to rewind multipart file %q: %w", name, err)
		}
		_, err = io.Copy(part, v)
		return err
	case io.Reader:
		part, err := writer.CreateFormFile(name, name)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		_, err = io.Copy(part, v)
		return err
	case []byte:
		part, err := writer.CreateFormFile(name, name)
		if err != nil {
			return fmt.Errorf("failed to create multipart file part %q: %w", name, err)
		}
		_, err = part.Write(v)
		return err
	case map[string]interface{}:
		jsonBytes, err := json.Marshal(v)
		if err != nil {
			return fmt.Errorf("failed to marshal multipart field %q as JSON: %w", name, err)
		}
		part, err := writer.CreateFormField(name)
		if err != nil {
			return fmt.Errorf("failed to create multipart field %q: %w", name, err)
		}
		_, err = part.Write(jsonBytes)
		return err
	default:
		return writer.WriteField(name, fmt.Sprintf("%v", v))
	}
}

func throwAPIError(response *HttpResponse) error {
	code := response.StatusCode
	msg := fmt.Sprintf("API returned status code %d", code)
	body := response.Body

	var parsed interface{}
	if body != "" {
		_ = json.Unmarshal([]byte(body), &parsed)
	}

	baseErr := &ApiError{
		StatusCode:      code,
		Msg:             msg,
		ResponseBody:    body,
		ResponseHeaders: response.Headers,
		ErrorBody:       parsed,
	}

	if code >= 400 && code < 500 {
		clientErr := &ClientError{ApiError: *baseErr}
		switch code {
		case 400:
			return &BadRequestError{ClientError: *clientErr}
		case 401:
			return &UnauthorizedError{ClientError: *clientErr}
		case 403:
			return &ForbiddenError{ClientError: *clientErr}
		case 404:
			return &NotFoundError{ClientError: *clientErr}
		case 409:
			return &ConflictError{ClientError: *clientErr}
		case 422:
			return &UnprocessableEntityError{ClientError: *clientErr}
		default:
			return clientErr
		}
	}

	if code >= 500 {
		serverErr := &ServerError{ApiError: *baseErr}
		switch code {
		case 500:
			return &InternalServerError{ServerError: *serverErr}
		default:
			return serverErr
		}
	}

	return baseErr
}
