package {{packageName}}

import (
	"bytes"
	"errors"
	"fmt"
	"io"
	"os"
	"sync/atomic"
)

// ErrBodyConsumed is returned when a single use BodySource is opened a second
// time. A single use body is read once, so it can be neither retried nor replayed
// across a redirect.
var ErrBodyConsumed = errors.New("the request body was already read and cannot be sent again")

// BodySource is the body of a raw binary request. An operation whose request
// body is binary takes one instead of buffering the bytes, so a large upload
// never has to fit in memory: the body is sent as it is read.
//
// A BodySource is replayable or single use. A replayable one (BodyFromBytes,
// BodyFromFile, BodyFromReadSeeker, BodyFromFactory) is read again for a retry
// after a 5xx, a 429 or a network error and for a 307 or 308 redirect. A single
// use one (BodyFromReader on a reader that cannot seek) is read once: it is never
// retried, the original error is returned unchanged, and a 307 or 308 is refused
// with "Refusing to replay a streamed request body". The SDK never buffers a body
// to make a replay possible.
//
// A known length goes out as Content-Length (bytes, a file, a seekable reader,
// or a length given with WithLength) and an unknown length is sent chunked.
//
// The SDK never closes a reader you pass in; it closes the files and the streams
// it opens itself (BodyFromFile, BodyFromFactory).
//
// String shows the kind and the length, never the content.
type BodySource struct {
	kind       string
	open       func() (io.ReadCloser, int64, error)
	length     int64
	replayable bool
}

// BodyFromBytes is a replayable body of in-memory bytes. The slice is not
// copied: do not change it until the call returns.
func BodyFromBytes(data []byte) *BodySource {
	return &BodySource{
		kind:       "bytes",
		length:     int64(len(data)),
		replayable: true,
		open: func() (io.ReadCloser, int64, error) {
			return io.NopCloser(bytes.NewReader(data)), int64(len(data)), nil
		},
	}
}

// BodyFromFile is a replayable body read from the file at path. The file is
// opened for every send and closed by the SDK; its size is the length.
func BodyFromFile(path string) *BodySource {
	return &BodySource{
		kind:       "file",
		length:     -1,
		replayable: true,
		open: func() (io.ReadCloser, int64, error) {
			file, err := os.Open(path)
			if err != nil {
				return nil, 0, err
			}
			info, err := file.Stat()
			if err != nil {
				_ = file.Close()
				return nil, 0, err
			}
			return file, info.Size(), nil
		},
	}
}

// BodyFromFactory is a replayable body made by a function that opens a fresh
// stream each time it is called. The SDK closes every stream it opens. The
// length is unknown (chunked) unless you give it with WithLength.
func BodyFromFactory(open func() (io.ReadCloser, error)) *BodySource {
	return &BodySource{
		kind:       "factory",
		length:     -1,
		replayable: true,
		open: func() (io.ReadCloser, int64, error) {
			stream, err := open()
			return stream, -1, err
		},
	}
}

// BodyFromReadSeeker is a replayable body read from the current position of r
// to its end. It is rewound to where it started before every send. The SDK never
// closes r.
func BodyFromReadSeeker(r io.ReadSeeker) *BodySource {
	start, startErr := r.Seek(0, io.SeekCurrent)
	length := int64(-1)
	if startErr == nil {
		if end, err := r.Seek(0, io.SeekEnd); err == nil && end >= start {
			length = end - start
		}
		_, startErr = r.Seek(start, io.SeekStart)
	}
	return &BodySource{
		kind:       "reader",
		length:     length,
		replayable: true,
		open: func() (io.ReadCloser, int64, error) {
			if startErr != nil {
				return nil, 0, fmt.Errorf("the request body cannot be rewound: %w", startErr)
			}
			if _, err := r.Seek(start, io.SeekStart); err != nil {
				return nil, 0, fmt.Errorf("the request body cannot be rewound: %w", err)
			}
			return io.NopCloser(r), length, nil
		},
	}
}

// BodyFromReader is a body read from r. A reader that can seek (an *os.File, a
// *bytes.Reader, a *strings.Reader) is replayable, exactly as BodyFromReadSeeker;
// any other reader is single use: it is read once and never retried. The SDK
// never closes r. The length is unknown (chunked) unless you give it with
// WithLength.
func BodyFromReader(r io.Reader) *BodySource {
	if seeker, ok := r.(io.ReadSeeker); ok {
		return BodyFromReadSeeker(seeker)
	}
	var used atomic.Bool
	return &BodySource{
		kind:       "once",
		length:     -1,
		replayable: false,
		open: func() (io.ReadCloser, int64, error) {
			if !used.CompareAndSwap(false, true) {
				return nil, 0, ErrBodyConsumed
			}
			return io.NopCloser(r), -1, nil
		},
	}
}

// WithLength returns a copy of the body that declares length bytes, so it is sent
// with Content-Length instead of chunked. The length must be the number of bytes
// the body delivers.
func (b *BodySource) WithLength(length int64) *BodySource {
	copied := *b
	copied.length = length
	inner := b.open
	copied.open = func() (io.ReadCloser, int64, error) {
		stream, _, err := inner()
		return stream, length, err
	}
	return &copied
}

// Replayable reports whether the body can be read again for a retry or a redirect.
func (b *BodySource) Replayable() bool { return b.replayable }

// Length is the number of bytes the body delivers, and false when it is not known
// before the body is opened (a file reports its size when it is opened).
func (b *BodySource) Length() (int64, bool) { return b.length, b.length >= 0 }

// Open opens the body for one send. It is for a custom ApiClient; the stream it
// returns must be closed. A single use body opens once and returns
// ErrBodyConsumed afterwards. The second result is the length, or -1 when it is
// not known.
func (b *BodySource) Open() (io.ReadCloser, int64, error) { return b.open() }

// String shows the kind and the length of the body, never its content.
func (b *BodySource) String() string {
	if b == nil {
		return "BodySource(none)"
	}
	use := "single use"
	if b.replayable {
		use = "replayable"
	}
	if b.length < 0 {
		return fmt.Sprintf("BodySource(%s, %s, length unknown)", b.kind, use)
	}
	return fmt.Sprintf("BodySource(%s, %s, length %d)", b.kind, use, b.length)
}
