package {{invokerPackage}}

import io.ktor.client.HttpClient
import io.ktor.client.request.*
import io.ktor.client.request.forms.*
import io.ktor.client.statement.*
import io.ktor.http.*

/**
 * Default implementation of [ApiClient] using Ktor.
 *
 * Applies transport-level settings from [TransportOptions]: TLS
 * verification, custom CA certificates, proxy routing, timeouts, redirect
 * handling, `User-Agent` injection, `X-Request-ID` injection,
 * and transport-level default headers.
 *
 * Header merge order (lowest to highest priority):
 * 1. [TransportOptions.defaultHeaders] -- transport-level defaults
 * 2. Caller-provided headers (from `BaseApi` -- includes config defaults, auth, operation headers)
 * 3. [TransportOptions.userAgent] -- injected if not already set
 * 4. [TransportOptions.injectRequestId] -- injected if not already set
 */
class DefaultApiClient internal constructor(
    private val httpClient: HttpClient,
    private val transportOptions: TransportOptions,
) : ApiClient {

    /**
     * Create a client with a pre-configured Ktor [HttpClient].
     *
     * Uses default [TransportOptions] for header injection settings.
     *
     * @param httpClient the Ktor client to use
     */
    constructor(httpClient: HttpClient) : this(httpClient, TransportOptions.builder().build())

    /**
     * Create a client configured from the given [TransportOptions].
     *
     * Applies proxy, custom CA certificate, TLS verification, timeout,
     * and redirect settings to the underlying Ktor client.
     *
     * @param transportOptions transport configuration to apply
     */
    constructor(transportOptions: TransportOptions) : this(
        buildPlatformHttpClient(transportOptions),
        transportOptions,
    )

    /**
     * Create a client with default transport settings.
     *
     * Equivalent to `DefaultApiClient(TransportOptions.builder().build())`.
     */
    constructor() : this(TransportOptions.builder().build())

    @Suppress("UNCHECKED_CAST")
    override suspend fun sendRequest(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
    ): ApiResponse {
        val mergedHeaders = mutableMapOf<String, String>()
        mergedHeaders.putAll(transportOptions.defaultHeaders)
        mergedHeaders.putAll(headers)

        if (transportOptions.userAgent != null && "User-Agent" !in mergedHeaders) {
            mergedHeaders["User-Agent"] = transportOptions.userAgent!!
        }
        if (transportOptions.injectRequestId && "X-Request-ID" !in mergedHeaders) {
            mergedHeaders["X-Request-ID"] = generateRequestId()
        }

        val response =
            try {
                httpClient.request(url) {
                    this.method = HttpMethod(method)
                    for ((key, value) in mergedHeaders) {
                        header(key, value)
                    }
                    buildRequestBody(this, method, body, mergedHeaders)
                }
            } catch (e: Exception) {
                throw ApiException(e.toString())
            }

        val responseHeaders = mutableMapOf<String, String>()
        response.headers.forEach { name, values ->
            responseHeaders[name] = values.joinToString(", ")
        }

        return ApiResponse(
            statusCode = response.status.value,
            body = response.bodyAsText(),
            headers = responseHeaders,
        )
    }

    private fun buildRequestBody(
        builder: HttpRequestBuilder,
        method: String,
        body: Any?,
        mergedHeaders: Map<String, String>,
    ) {
        when {
            body == null && method in listOf("POST", "PUT", "PATCH") ->
                builder.setBody(ByteArray(0))
            body == null -> {}
            body is Map<*, *> -> {
                @Suppress("UNCHECKED_CAST")
                val formFields = body as Map<String, Any?>
                builder.setBody(
                    MultiPartFormDataContent(
                        formData {
                            for ((fieldName, value) in formFields) {
                                when (value) {
                                    is List<*> ->
                                        value.forEach { item ->
                                            appendFormField(fieldName, item)
                                        }
                                    else -> appendFormField(fieldName, value)
                                }
                            }
                        },
                    ),
                )
            }
            body is ByteArray -> {
                builder.header(HttpHeaders.ContentType, ContentType.Application.OctetStream)
                builder.setBody(body)
            }
            else -> {
                val contentType = mergedHeaders["Content-Type"] ?: "application/json"
                builder.contentType(ContentType.parse(contentType))
                builder.setBody(body.toString())
            }
        }
    }

    private fun FormBuilder.appendFormField(
        fieldName: String,
        value: Any?,
    ) {
        when (value) {
            is ByteArray ->
                append(
                    fieldName,
                    value,
                    Headers.build {
                        append(HttpHeaders.ContentType, ContentType.Application.OctetStream.toString())
                        append(HttpHeaders.ContentDisposition, "filename=$fieldName")
                    },
                )
            null -> {}
            else -> append(fieldName, value.toString())
        }
    }
}

/** Generates a UUID v4 string without JVM-specific APIs. */
internal fun generateRequestId(): String {
    val rand = kotlin.random.Random.Default
    fun hex(n: Int) = n.toString(16).padStart(2, '0')
    val b = Array(16) { rand.nextInt(256) }
    b[6] = (b[6] and 0x0f) or 0x40
    b[8] = (b[8] and 0x3f) or 0x80
    return "${hex(b[0])}${hex(b[1])}${hex(b[2])}${hex(b[3])}-" +
        "${hex(b[4])}${hex(b[5])}-" +
        "${hex(b[6])}${hex(b[7])}-" +
        "${hex(b[8])}${hex(b[9])}-" +
        "${hex(b[10])}${hex(b[11])}${hex(b[12])}${hex(b[13])}${hex(b[14])}${hex(b[15])}"
}

/** Platform-specific [HttpClient] factory; configured with engine, TLS, proxy, and common plugins. */
internal expect fun buildPlatformHttpClient(options: TransportOptions): HttpClient
