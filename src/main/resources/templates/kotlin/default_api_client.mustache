/**
 * Default implementation of [ApiClient] using Ktor.
 *
 * Applies transport-level settings from [TransportOptions]: TLS
 * verification, custom CA certificates, proxy routing, timeouts, redirect
 * handling, `User-Agent` injection, `X-Request-ID` injection,
 * and transport-level default headers.
 *
 * Header merge order (lowest to highest priority):
 * 1. [TransportOptions.defaultHeaders] -- transport-level defaults
 * 2. Caller-provided headers (from `BaseApi` -- includes config defaults, auth, operation headers)
 * 3. [TransportOptions.userAgent] -- injected if not already set
 * 4. [TransportOptions.injectRequestId] -- injected if not already set
 */
class DefaultApiClient internal constructor(
    private val httpClient: HttpClient,
    private val transportOptions: TransportOptions,
) : ApiClient {

    internal companion object {
        /** What a read of a stream that [close] cancelled, and a new call after it, is told. */
        internal const val CLOSED_MESSAGE = "ApiClient has been closed and can no longer send requests"

        /**
         * Headers stripped from cross-origin redirect hops. Includes the
         * static set {Authorization, Cookie, Proxy-Authorization} plus any
         * `apiKey, in=header` names harvested from the OpenAPI document at
         * codegen time. Compared case-insensitively (entries are already
         * lowercased here).
         */
        internal val SENSITIVE_HEADER_NAMES: Set<String> = setOf(
            "authorization",
            "cookie",
            "proxy-authorization",{{#apiKeyHeaderNames}}
            "{{#lambda.kotlinString}}{{{lowerName}}}{{/lambda.kotlinString}}",{{/apiKeyHeaderNames}}
        )

        /**
         * Whether a header carries a credential and must not follow a cross-origin
         * redirect: a name in [SENSITIVE_HEADER_NAMES], or any name that contains
         * `key`, `token` or `secret`, whatever put the header there (a default
         * header or a custom authenticator).
         */
        internal fun isSensitiveHeader(name: String): Boolean {
            val lower = name.lowercase()
            return lower in SENSITIVE_HEADER_NAMES ||
                lower.contains("key") ||
                lower.contains("token") ||
                lower.contains("secret")
        }
    }

    /*
     * Ktor's CIO engine has no API for proxy basic-auth credentials, so
     * userinfo embedded in the proxy URL (`http://user:pass@host:port`) is
     * silently dropped. Extract it once at construction and inject it as a
     * Proxy-Authorization header on every outbound request below.
     */
    internal val proxyAuthHeader: String? = buildProxyAuthHeader(transportOptions.proxy)

    /*
     * Serializer used to render non-primitive multipart form parts to JSON.
     * It MUST be the same configured ObjectSerializer used elsewhere in the
     * SDK so that the contextual serializers (OffsetDateTime, BigDecimal,
     * Duration, Uuid, URI, ...) registered in its SerializersModule are
     * applied. A bare kotlinx-serialization Json instance lacks that module
     * and fails serializer lookup for any model carrying such a field,
     * corrupting the multipart part.
     */
    private val objectSerializer: ObjectSerializer = ObjectSerializer()

    /**
     * Tracks whether [close] has been called. Use-after-close is a wrong call
     * order, so it surfaces as [IllegalStateException] rather than a foreign
     * Ktor exception (or silently succeeding).
     */
    @Volatile
    private var closed: Boolean = false

    /** The requests that have been admitted and not yet finished; [close] waits for them. */
    private val inFlight = java.util.concurrent.atomic.AtomicInteger(0)

    /** Set once the transport has been released, so that it is released exactly once. */
    private val released = java.util.concurrent.atomic.AtomicBoolean(false)

    /** The streamed bodies that are open: [close] cancels each of them. */
    private val openStreams = java.util.concurrent.ConcurrentHashMap.newKeySet<StreamBody>()

    /** Holds the coroutines that keep a streamed response open after its call returned. */
    private val streamScope = kotlinx.coroutines.CoroutineScope(kotlinx.coroutines.SupervisorJob())

    /**
     * Create a client with a pre-configured Ktor [HttpClient].
     *
     * Uses default [TransportOptions] for header injection settings, without an
     * end-to-end timeout budget (the supplied client owns its own timeouts) and
     * without automatic retries, so a test sees exactly one request per call.
     *
     * Internal test-only seam: a Ktor [HttpClient] is an internal transport
     * type and must not appear in the public API. Production callers construct
     * via the [TransportOptions] constructor.
     *
     * @param httpClient the Ktor client to use
     */
    internal constructor(httpClient: HttpClient) : this(httpClient, TransportOptions.builder().timeout(null).maxRetries(0).build())

    /**
     * Create a client configured from the given [TransportOptions].
     *
     * Applies proxy, custom CA certificate, TLS verification, timeout,
     * and redirect settings to the underlying Ktor client.
     *
     * @param transportOptions transport configuration to apply
     */
    constructor(transportOptions: TransportOptions) : this(
        resolveHttpClient(transportOptions),
        transportOptions,
    )

    /**
     * Create a client with default transport settings.
     *
     * Equivalent to `DefaultApiClient(TransportOptions.builder().build())`.
     */
    constructor() : this(TransportOptions.builder().build())

    /**
     * Sends a token-endpoint request: it never follows a redirect and is never retried, so the
     * credentials in the body are sent once and never replayed to another origin.
     */
    override suspend fun sendTokenRequest(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
    ): ApiHttpResponse =
        kotlinx.coroutines.withContext(CallSettings(null, 0)) {
            sendRequest(method, url, headers, body, noRedirect = true)
        }

    /**
     * Pause between two attempts. Internal test seam: a test replaces it to run the backoff
     * without waiting; production code always suspends with [kotlinx.coroutines.delay], which
     * a cancelled caller interrupts.
     */
    internal var sleeper: suspend (Long) -> Unit = { kotlinx.coroutines.delay(it) }

    /** Source of the backoff jitter, a value in `[0, 1)`. Internal test seam. */
    internal var jitterSource: () -> Double = { java.util.concurrent.ThreadLocalRandom.current().nextDouble() }

    /**
     * Send an HTTP request and return the response, sending it again after a retryable failure.
     *
     * A network error that happened before a response, and a 408, 409, 429 or 5xx (except 501)
     * answer, is retried up to [TransportOptions.maxRetries] times. The wait before a retry is
     * the response's `Retry-After` (capped at 60 s) or 0.5 s doubling to 8 s with up to 25%
     * jitter. All attempts and waits share the one end-to-end [TransportOptions.timeout]: a wait
     * that would outlast what is left stops the retrying and the last outcome is reported.
     * A timeout is never retried. Every body this client sends is held in memory, so each retry
     * replays it; every retry is a fresh request whose headers are merged again.
     *
     * @param method HTTP method (GET, POST, PUT, DELETE, etc.)
     * @param url Fully qualified URL
     * @param headers HTTP headers
     * @param body Request body (serialized JSON string, ByteArray for binary, or
     *   `Map<String, Any?>` for multipart form data; may be null)
     * @param noRedirect when `true`, do not follow 3xx responses
     * @return ApiHttpResponse containing status code, body, and headers
     * @throws ApiException if the request fails
     */
    override suspend fun sendRequest(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
        noRedirect: Boolean,
    ): ApiHttpResponse {
        inFlight.incrementAndGet()
        if (closed) {
            finishRequest()
            throw IllegalStateException("ApiClient has been closed and can no longer send requests")
        }
        try {
            return sendWithRetries(method, url, headers, body, noRedirect, stream = false).buffered!!
        } finally {
            finishRequest()
        }
    }

    /**
     * Sends a request and returns once the response headers are accepted, with the body still
     * unread. The header phase is the one the buffered call runs (retries, redirects, the budget,
     * the header rules); the `timeout` stops at the headers, and the body is then bounded by the
     * idle timeout alone. The caller owns the returned body and must close it; closing aborts the
     * connection, and [close] cancels a body that is still open.
     */
    override suspend fun sendStreaming(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
    ): ApiStreamResponse {
        inFlight.incrementAndGet()
        if (closed) {
            finishRequest()
            throw IllegalStateException(CLOSED_MESSAGE)
        }
        var handedOver = false
        try {
            val sent = sendWithRetries(method, url, headers, body, noRedirect = false, stream = true)
            handedOver = true
            return sent.streamed!!
        } finally {
            if (!handedOver) {
                finishRequest()
            }
        }
    }

    /** Ends one admitted request; the last one out after [close] releases the transport. */
    private fun finishRequest() {
        if (inFlight.decrementAndGet() == 0 && closed) {
            releaseTransport()
        }
    }

    private fun releaseTransport() {
        if (released.compareAndSet(false, true)) {
            streamScope.cancel()
            httpClient.close()
        }
    }

    private suspend fun sendWithRetries(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
        noRedirect: Boolean,
        stream: Boolean,
    ): Sent {
        // `timeout` is one end-to-end budget for the whole call: every attempt, every redirect
        // hop, the body read and every wait between retries draw from it.
        val callSettings = kotlin.coroutines.coroutineContext[CallSettings]
        val budget = TimeoutBudget(callSettings?.timeout ?: transportOptions.timeout)
        /* A single-use body has been read to its end by the first request, so there is nothing to
         * send again: it is never retried and the first outcome is reported unchanged. */
        val maxRetries = if (body is BodySource && !body.isReplayable) 0 else callSettings?.maxRetries ?: transportOptions.maxRetries
        var attempt = 0
        while (true) {
            val response =
                try {
                    sendOnce(method, url, headers, body, noRedirect, budget, stream)
                } catch (e: NetworkTimeoutException) {
                    throw e
                } catch (e: NetworkException) {
                    // A dropped connection is retried only for an idempotent method, since the
                    // server may already have acted on a POST or PATCH. A TLS or certificate
                    // failure is never retried.
                    if (!RetryPolicy.isIdempotentMethod(method) || isTlsFailure(e)) throw e
                    val pause = retryPause(attempt, maxRetries, null, budget) ?: throw e
                    sleeper(pause)
                    attempt++
                    continue
                }
            val pause =
                if (RetryPolicy.isRetryableStatus(response.statusCode)) {
                    retryPause(attempt, maxRetries, response.headers["retry-after"], budget)
                } else {
                    null
                }
            if (pause == null) {
                return response
            }
            response.discard()
            sleeper(pause)
            attempt++
        }
    }

    /** True when a transport failure was a TLS handshake or certificate error anywhere in its causes. */
    private fun isTlsFailure(e: Throwable): Boolean {
        val causes = generateSequence(e) { it.cause }
        return causes.any { it is javax.net.ssl.SSLException }
    }

    /**
     * How long to wait before attempt number [attempt] + 1, or null when no retry is left or the
     * wait would outlast what remains of the end-to-end budget.
     */
    private fun retryPause(
        attempt: Int,
        maxRetries: Int,
        retryAfter: String?,
        budget: TimeoutBudget,
    ): Long? {
        if (attempt >= maxRetries) {
            return null
        }
        val pause = RetryPolicy.delayMillis(attempt, retryAfter, jitterSource())
        val remaining = budget.remainingMillis()
        return if (remaining != null && pause >= remaining) null else pause
    }

    /**
     * One attempt: merge the headers, send, follow redirects and then either read the whole
     * response, or (for a stream) stop at the headers and hand the body over unread.
     */
    private suspend fun sendOnce(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
        noRedirect: Boolean,
        budget: TimeoutBudget,
        stream: Boolean,
    ): Sent {
        val mergedHeaders = mutableMapOf<String, String>()
        /* The token POST (noRedirect) goes to the identity provider, another origin: the caller's
         * default headers (an API Authorization or key header) are not sent there (F860). */
        if (!noRedirect) {
            mergedHeaders.putAll(transportOptions.defaultHeaders)
        }
        for ((name, value) in headers) {
            // Header names are case-insensitive: a later layer replaces the earlier one.
            mergedHeaders.keys.removeAll { it.equals(name, ignoreCase = true) }
            mergedHeaders[name] = value
        }

        if (transportOptions.userAgent != null && !hasHeader(mergedHeaders, "User-Agent")) {
            mergedHeaders["User-Agent"] = transportOptions.userAgent!!
        }
        if (transportOptions.injectRequestId && !hasHeader(mergedHeaders, "X-Request-ID")) {
            mergedHeaders["X-Request-ID"] = generateRequestId()
        }
        if (!hasHeader(mergedHeaders, "Accept-Encoding")) {
            mergedHeaders["Accept-Encoding"] = supportedEncodings()
        }
        if (proxyAuthHeader != null) {
            mergedHeaders["Proxy-Authorization"] = proxyAuthHeader
        }
        for ((key, value) in mergedHeaders) {
            if (value.any { it == '\r' || it == '\n' || it == '\u0000' }) {
                throw IllegalArgumentException("Header '$key' contains a line break or NUL byte; the value is not shown")
            }
        }

        // Each hop is sent with what is left of the end-to-end budget, and a hop
        // is never started once the budget is spent.
        var hop =
            try {
                execute(stream, url, budget) {
                    this.method = HttpMethod(method)
                    for ((key, value) in mergedHeaders) {
                        if (body == null && key.equals("Content-Type", ignoreCase = true)) {
                            continue
                        }
                        header(key, value)
                    }
                    buildRequestBody(this, method, body, mergedHeaders)
                }
            } catch (e: Exception) {
                throw transportFailure(e)
            }
        try {

            // Redirects are ALWAYS handled manually so we can strip caller-supplied
            // sensitive headers (Authorization, Cookie, Proxy-Authorization) on cross-origin
            // hops AND preserve the original verb+body per RFC 7231. When
            // `maxRedirects` is null we cap at 20 hops to avoid pathological loops.
            // noRedirect=true (the OAuth2 token POST) means "do not follow
            // redirects; return the 3xx as-is" -- the loop is skipped and the first
            // 3xx surfaces verbatim. The token manager inspects and rejects the 3xx
            // itself, so a credential-bearing body is never silently replayed.
            if (transportOptions.followRedirects && !noRedirect) {
                var redirectsRemaining = transportOptions.maxRedirects ?: 20
                var currentUrl = url
                var currentHeaders: Map<String, String> = mergedHeaders.toMap()
                var currentMethod = method
                var currentBody: Any? = body

                while (isRedirectStatus(hop.response.status.value) && redirectsRemaining > 0) {
                    // An unusable Location (absent, empty, or one the RFC 3986
                    // resolver rejects) behaves exactly like a missing one: stop
                    // following and return the 3xx untouched. It is resolved BEFORE
                    // the redirect body is consumed so the returned response still
                    // carries its body.
                    val originalUri = java.net.URI(currentUrl)
                    val redirectUri =
                        usableRedirectLocation(originalUri, hop.response.headers[HttpHeaders.Location]) ?: break
                    try {
                        hop.discardBody() // consume redirect body to release the connection
                    } catch (e: Exception) {
                        throw transportFailure(e)
                    }
                    // Refuse non-HTTP(S) redirect schemes (javascript:, file:,
                    // data:, etc.). URI.resolve() preserves whatever scheme the
                    // server returned in Location, so a malicious or
                    // misconfigured server could otherwise steer the client at
                    // a local-file or scripting URL.
                    val redirectScheme = redirectUri.scheme
                    if (redirectScheme == null ||
                        (!redirectScheme.equals("http", ignoreCase = true) &&
                            !redirectScheme.equals("https", ignoreCase = true))
                    ) {
                        throw ApiException(
                            hop.response.status.value,
                            "Refusing to follow redirect to non-HTTP(S) URL: ${redactUrl(redirectUri.toString())}",
                            responseHeadersOf(hop.response),
                            null,
                        )
                    }
                    val sameOrigin = sameOrigin(originalUri, redirectUri)

                    val redirectHeaders = currentHeaders.toMutableMap()
                    if (!sameOrigin) {
                        val defaultNames = transportOptions.defaultHeaders.keys
                        val keysToRemove = redirectHeaders.keys
                            .filter { name -> isSensitiveHeader(name) || defaultNames.any { it.equals(name, ignoreCase = true) } }
                        keysToRemove.forEach { redirectHeaders.remove(it) }
                        // The SDK's own proxy credentials authenticate to the proxy,
                        // which is the same for every hop, so they are re-applied
                        // after the strip. Not on an https target: there the header
                        // would travel inside the TLS tunnel to an unrelated origin.
                        if (proxyAuthHeader != null && !"https".equals(redirectUri.scheme, ignoreCase = true)) {
                            redirectHeaders["Proxy-Authorization"] = proxyAuthHeader
                        }
                    }

                    // Refuse to replay a request body across an HTTPS->HTTP
                    // downgrade. 301, 302, 307 and 308 would carry the body to the
                    // plain-HTTP hop (303 drops it), so a TLS-protected payload
                    // (POST/PUT body) must not be silently re-sent in cleartext.
                    if (hop.response.status.value in setOf(301, 302, 307, 308) &&
                        currentBody != null &&
                        "https".equals(originalUri.scheme, ignoreCase = true) &&
                        "http".equals(redirectUri.scheme, ignoreCase = true)
                    ) {
                        throw ApiException(
                            hop.response.status.value,
                            "Refusing to replay request body across HTTPS->HTTP redirect: " +
                                "${redactUrl(currentUrl)} -> ${redactUrl(redirectUri.toString())}",
                            responseHeadersOf(hop.response),
                            null,
                        )
                    }

                    // Pick the follow-up method+body per RFC 9110 section 15.4.
                    // 307 + 308: preserve the original method and body.
                    // 303:       every method except HEAD becomes GET (body dropped).
                    // 301 + 302: only POST becomes GET (body dropped); every other
                    //            method keeps its method and body.
                    val statusCode = hop.response.status.value
                    val nextMethod: String
                    val nextBody: Any?
                    when {
                        statusCode == 303 && !currentMethod.equals("HEAD", ignoreCase = true) -> {
                            nextMethod = "GET"
                            nextBody = null
                        }
                        (statusCode == 301 || statusCode == 302) && currentMethod.equals("POST", ignoreCase = true) -> {
                            nextMethod = "GET"
                            nextBody = null
                        }
                        else -> {
                            nextMethod = currentMethod
                            nextBody = currentBody
                        }
                    }

                    if (nextBody is BodySource && !nextBody.isReplayable) {
                        /* The one stream was read to its end by the request that was just sent, so
                         * there is nothing to send again, and it is never buffered to make that
                         * possible. */
                        throw ApiException(
                            statusCode,
                            "Refusing to replay a streamed request body",
                            responseHeadersOf(hop.response),
                            null,
                        )
                    }

                    if (nextBody == null) {
                        redirectHeaders.keys
                            .filter {
                                it.equals("content-type", ignoreCase = true) ||
                                    it.equals("content-length", ignoreCase = true)
                            }
                            .toList()
                            .forEach { redirectHeaders.remove(it) }
                    }

                    currentUrl = redirectUri.toString()
                    currentHeaders = redirectHeaders
                    currentMethod = nextMethod
                    currentBody = nextBody

                    hop = try {
                        execute(stream, currentUrl, budget) {
                            this.method = HttpMethod(currentMethod)
                            for ((key, value) in redirectHeaders) {
                                if (nextBody == null && key.equals("Content-Type", ignoreCase = true)) {
                                    continue
                                }
                                header(key, value)
                            }
                            buildRequestBody(this, currentMethod, nextBody, redirectHeaders)
                        }
                    } catch (e: Exception) {
                        throw transportFailure(e)
                    }
                    redirectsRemaining--
                }

                // Redirect budget exhausted but the server is still returning a
                // 3xx: fail loud instead of silently handing the caller the last
                // redirect response as if it were a normal result.
                // A 3xx with no usable Location is returned as-is (D70): only a
                // response that could still be followed counts as exhaustion.
                if (isRedirectStatus(hop.response.status.value) &&
                    redirectsRemaining == 0 &&
                    usableRedirectLocation(java.net.URI(currentUrl), hop.response.headers[HttpHeaders.Location]) != null
                ) {
                    throw ApiException(
                        hop.response.status.value,
                        "Too many redirects (exceeded ${transportOptions.maxRedirects ?: 20})",
                        responseHeadersOf(hop.response),
                        null,
                    )
                }
            }
        } catch (e: Throwable) {
            hop.handle?.abort()
            throw e
        }

        // Response header keys are normalised to lowercase so
        // callers can look them up consistently regardless of the casing
        // the server used (HTTP header names are case-insensitive per
        // RFC 7230 section 3.2, and HTTP/2 mandates lowercase on the
        // wire). Repeated header lines (for example multiple Link or
        // Set-Cookie headers) are joined with ", " to preserve order
        // per RFC 7230 section 3.2.2. The joined form is not directly
        // parseable for Set-Cookie; callers needing structured cookie
        // access should use the Ktor HttpCookies plugin or read the raw
        // response.headers themselves.
        val responseHeaders = mutableMapOf<String, String>()
        hop.response.headers.forEach { name, values ->
            responseHeaders[name.lowercase(java.util.Locale.ROOT)] = values.joinToString(", ")
        }

        if (stream) {
            return Sent(null, openStream(method, url, hop, responseHeaders))
        }

        // Read the raw response body inside a try/catch so a post-headers
        // I/O failure (connection reset, read timeout, truncated transfer)
        // surfaces as the SDK's own error type rather than a raw Ktor
        // exception, matching how send-phase failures are wrapped.
        val maxResponseBytes = transportOptions.maxResponseBytes
        val wireBytes = try {
            if (maxResponseBytes != null) {
                readCappedBody(method, url, hop, responseHeaders, maxResponseBytes, budget)
            } else {
                hop.response.bodyAsBytes()
            }
        } catch (e: Exception) {
            throw transportFailure(e)
        }
        // Decode the Content-Encoding here, after the body has been read, so
        // a corrupt compressed body is told apart from an I/O failure: a
        // response did arrive, so it is an ApiException carrying the real
        // status, never a NetworkException.
        val contentEncoding = responseHeaders["content-encoding"] ?: ""
        val rawBytes = try {
            decodeContentEncoding(wireBytes, contentEncoding, maxResponseBytes ?: Long.MAX_VALUE)
        } catch (expected: BodyTooLarge) {
            /* D138: the decoded body passed the limit, and decoding stopped there. */
            throw ResponseTooLargeException(
                hop.response.status.value,
                responseHeaders,
                expected.limit,
                method,
                requestPathOf(url),
            )
        } catch (e: java.io.IOException) {
            throw ApiException(
                hop.response.status.value,
                "Failed to decompress $contentEncoding response body: $e",
                responseHeaders,
                e,
            )
        }
        val contentType = responseHeaders["content-type"] ?: ""
        val responseBody = if (isTextContentType(contentType)) {
            rawBytes.toString(charsetFor(contentType))
        } else {
            java.util.Base64.getEncoder().encodeToString(rawBytes)
        }
        /* D92: the returned headers describe the body the caller receives, so once the body was
         * decoded they no longer carry the Content-Encoding or the (encoded) Content-Length. */
        val decodedBody =
            wireBytes.isNotEmpty() && contentEncoding.trim().lowercase() !in listOf("", "identity")
        val returnedHeaders =
            if (decodedBody) {
                responseHeaders.filterKeys { !it.equals("content-encoding", true) && !it.equals("content-length", true) }
            } else {
                responseHeaders
            }
        return Sent(
            ApiHttpResponse(
                statusCode = hop.response.status.value,
                body = responseBody,
                headers = returnedHeaders,
            ),
            null,
        )
    }

    /**
     * Reads a buffered body held open by [execute], counting the bytes as they arrive (D138). A
     * declared Content-Length over [limit] fails before anything is read; otherwise the read stops
     * the moment the count passes [limit]. Either way the connection is dropped, never drained,
     * and the call fails with [ResponseTooLargeException]. The read draws on the end-to-end budget.
     */
    private suspend fun readCappedBody(
        method: String,
        url: String,
        hop: Hop,
        responseHeaders: Map<String, String>,
        limit: Long,
        budget: TimeoutBudget,
    ): ByteArray {
        val handle = hop.handle!!
        val status = hop.response.status.value
        var complete = false
        try {
            val tooLarge = {
                ResponseTooLargeException(status, responseHeaders, limit, method, requestPathOf(url))
            }
            val hasBody = !method.equals("HEAD", ignoreCase = true) && status != 204 && status != 304
            val declared = responseHeaders["content-length"]?.trim()?.toLongOrNull()
            if (hasBody && declared != null && declared > limit) {
                throw tooLarge()
            }
            val channel = hop.response.bodyAsChannel()
            val collected = java.io.ByteArrayOutputStream()
            val chunk = ByteArray(8192)
            val drain: suspend () -> Unit = {
                var total = 0L
                while (true) {
                    val count = channel.readAvailable(chunk, 0, chunk.size)
                    if (count < 0) {
                        break
                    }
                    total += count
                    if (total > limit) {
                        throw tooLarge()
                    }
                    collected.write(chunk, 0, count)
                }
            }
            val remaining = budget.remainingMillis()
            if (remaining == null) {
                drain()
            } else {
                try {
                    kotlinx.coroutines.withTimeout(maxOf(remaining, 1L)) { drain() }
                } catch (e: kotlinx.coroutines.TimeoutCancellationException) {
                    throw budget.bodyExpired(e)
                }
            }
            complete = true
            return collected.toByteArray()
        } finally {
            if (complete) {
                handle.finish()
            } else {
                handle.abort()
            }
        }
    }

    /**
     * Map a failure raised while sending a request or reading its response to
     * the SDK's error types.
     *
     * - A timeout becomes [NetworkTimeoutException].
     * - Coroutine cancellation is rethrown untouched, so `withTimeout` and
     *   scope cancellation keep working (structured concurrency).
     * - A caller mistake ([IllegalArgumentException], such as a multipart
     *   field name carrying CR/LF) and the SDK's own errors pass through.
     * - Any other failure (connection refused, DNS, TLS, reset) becomes
     *   [NetworkException]. The original exception is kept as the cause.
     */
    private fun transportFailure(e: Exception): Exception =
        when (e) {
            is io.ktor.client.plugins.HttpRequestTimeoutException,
            is io.ktor.client.network.sockets.ConnectTimeoutException,
            is io.ktor.client.network.sockets.SocketTimeoutException,
            is java.net.SocketTimeoutException,
            -> NetworkTimeoutException(redactUrlsInMessage(e.toString()), e)
            is kotlinx.coroutines.CancellationException -> e
            is java.nio.channels.UnresolvedAddressException -> NetworkException(redactUrlsInMessage(e.toString()), e)
            is IllegalArgumentException -> e
            is {{errorPrefix}}Exception -> e
            else -> NetworkException(redactUrlsInMessage(e.toString()), e)
        }

    private fun buildRequestBody(
        builder: HttpRequestBuilder,
        method: String,
        body: Any?,
        mergedHeaders: Map<String, String>,
    ) {
        when {
            body == null && method in listOf("POST", "PUT", "PATCH") ->
                builder.setBody(ByteArray(0))
            body == null -> {}
            body is Map<*, *> -> {
                val formFields = body as Map<String, Any?>
                val parts = MultipartWriter()
                for ((fieldName, value) in formFields) {
                    when (value) {
                        is List<*> ->
                            value.forEach { item ->
                                appendFormField(parts, fieldName, item)
                            }
                        else -> appendFormField(parts, fieldName, value)
                    }
                }
                builder.setBody(parts.build(declaredMultipartType(mergedHeaders["Content-Type"])))
            }
            body is ByteArray -> {
                // A type:string format:binary request body (e.g. an upload
                // with image/jpeg) must stream the raw bytes unchanged and keep
                // the DECLARED Content-Type. Do NOT force application/octet-stream
                // here -- that would discard the caller's declared media type
                // (image/jpeg, application/pdf, ...) and mislabel the payload.
                // The declared type was placed into mergedHeaders["Content-Type"]
                // by the calling operation; honour it, falling back to
                // application/octet-stream only when no type was declared.
                val contentType = mergedHeaders["Content-Type"] ?: ContentType.Application.OctetStream.toString()
                builder.contentType(ContentType.parse(contentType))
                builder.setBody(body)
            }
            body is BodySource -> {
                /* Sent as it is read, never buffered: a known length is a Content-Length, an
                 * unknown one is chunked. A replayable source is opened again for every send. */
                val contentType = ContentType.parse(mergedHeaders["Content-Type"] ?: ContentType.Application.OctetStream.toString())
                builder.contentType(contentType)
                val inMemory = body.bytesOrNull()
                if (inMemory != null) {
                    builder.setBody(inMemory)
                } else {
                    builder.setBody(BodySourceContent(body, contentType, body.length()))
                }
            }
            else -> {
                val contentType = mergedHeaders["Content-Type"] ?: "application/json"
                builder.contentType(ContentType.parse(contentType))
                builder.setBody(body.toString())
            }
        }
    }

    private fun appendFormField(
        parts: MultipartWriter,
        fieldName: String,
        value: Any?,
    ) {
        // Validate the field name on every branch (string, number,
        // boolean, JSON, binary) before it lands in Content-Disposition, so
        // CR/LF/NUL are rejected even when the value is not a ByteArray.
        validateMultipartFieldName(fieldName)
        when (value) {
            is ByteArray -> {
                validateMultipartFilename(fieldName)
                // Best-effort per-part MIME sniffing from the filename extension.
                // Servers that read per-part Content-Type (e.g. for image processing)
                // need this rather than a blanket application/octet-stream.
                parts.part(
                    fieldName,
                    buildFilenameDirective(fieldName),
                    contentTypeForFilename(fieldName).toString(),
                    value,
                )
            }
            null -> {}
            // Every primitive (string, number, boolean, enum, date, date-time,
            // duration, uri, uuid) is a plain text part carrying the canonical
            // stringify form; only an object or model becomes a JSON part.
            is String, is Number, is Boolean, is Enum<*>, is java.time.temporal.TemporalAccessor,
            is java.time.Duration, is java.net.URI,
            -> parts.part(fieldName, null, null, objectSerializer.stringify(value).toByteArray(Charsets.UTF_8))
            else -> if (value::class.qualifiedName == "kotlin.uuid.Uuid") {
                parts.part(fieldName, null, null, objectSerializer.stringify(value).toByteArray(Charsets.UTF_8))
            } else {
                // Serialize the object part through the SDK's configured
                // ObjectSerializer, NOT a bare Json instance: the configured
                // serializer carries the contextual SerializersModule
                // (OffsetDateTime, BigDecimal, Duration, Uuid, KtorUrl, ...),
                // so models with those field types render as real JSON. The
                // encoding exception is intentionally NOT swallowed into a
                // toString() fallback — that fallback emitted the data-class
                // toString() as the JSON part, silently corrupting the body.
                // A genuine serialization failure must surface, not produce
                // invalid JSON.
                val json = objectSerializer.serialize(value)
                parts.part(
                    fieldName,
                    null,
                    ContentType.Application.Json.toString(),
                    json.toByteArray(Charsets.UTF_8),
                )
            }
        }
    }

    /**
     * Closes the Ktor [HttpClient] this SDK built and releases its connection
     * pool / engine threads. A client supplied through
     * [TransportOptions.httpClient] is never closed: only the SDK's derived view
     * of it is released, and the caller's client and engine stay open.
     *
     * Closing is graceful and idempotent: requests already in flight finish and
     * the transport is released after the last of them, a new request fails with
     * [IllegalStateException], and closing again does nothing.
     */
    override fun close() {
        closed = true
        // A stream may never end (an event feed), so closing cancels it instead of waiting.
        for (stream in openStreams.toList()) {
            stream.cancel()
        }
        if (inFlight.get() == 0) {
            releaseTransport()
        }
    }

    /** Sends one request. A stream keeps the response open in a coroutine of [streamScope]. */
    private suspend fun execute(
        stream: Boolean,
        url: String,
        budget: TimeoutBudget,
        configure: HttpRequestBuilder.() -> Unit,
    ): Hop {
        /* D138: with maxResponseBytes the buffered body is read here, counted as it arrives, so
         * the response is held open like a stream's instead of being read whole by Ktor. */
        val capped = !stream && transportOptions.maxResponseBytes != null
        if (!stream && !capped) {
            return Hop(
                httpClient.request(url) {
                    budget.applyTo(this)
                    configure()
                },
                null,
            )
        }
        val ready = kotlinx.coroutines.CompletableDeferred<HttpResponse>()
        val release = kotlinx.coroutines.CompletableDeferred<Unit>()
        val job =
            streamScope.launch {
                try {
                    httpClient
                        .prepareRequest(url) {
                            if (capped) {
                                budget.applyTo(this)
                            } else {
                                budget.applyToStream(this, httpClient)
                            }
                            configure()
                        }.execute { response ->
                            ready.complete(response)
                            // Ktor frees the response when this block ends, so hold it open until
                            // the stream is closed or cancelled.
                            release.await()
                        }
                } catch (e: Throwable) {
                    ready.completeExceptionally(e)
                }
            }
        val handle = StreamHandle(job, release)
        try {
            val remaining = budget.remainingMillis()
            val response =
                if (remaining == null) {
                    ready.await()
                } else {
                    try {
                        kotlinx.coroutines.withTimeout(maxOf(remaining, 1L)) { ready.await() }
                    } catch (e: kotlinx.coroutines.TimeoutCancellationException) {
                        throw budget.expired(e)
                    }
                }
            return Hop(response, handle)
        } catch (e: Throwable) {
            handle.abort()
            throw e
        }
    }

    /**
     * Wraps the response of the header phase as a stream the client tracks: the status and the
     * headers are final, the body has not been read.
     */
    private suspend fun openStream(
        method: String,
        url: String,
        hop: Hop,
        responseHeaders: MutableMap<String, String>,
    ): ApiStreamResponse {
        val status = hop.response.status.value
        val handle = hop.handle!!
        val encoding = (responseHeaders["content-encoding"] ?: "").trim().lowercase()
        val identity = encoding.isEmpty() || encoding == "identity"
        val hasBody = !method.equals("HEAD", ignoreCase = true) && status != 204 && status != 304 && status >= 200
        val declared = responseHeaders["content-length"]?.trim().orEmpty()
        val declaredLength =
            if (hasBody && declared.isNotEmpty() && declared.length < 18 && declared.all { it in '0'..'9' }) {
                declared.toLong()
            } else {
                -1L
            }
        if (!identity) {
            try {
                requireDecoder(encoding)
            } catch (e: java.io.IOException) {
                handle.abort()
                throw ApiException(
                    status,
                    "Failed to decompress $encoding response body: $e",
                    responseHeaders,
                    e,
                )
            }
            /* D92: the headers describe the body the caller receives, so the wire encoding and
             * length of an encoded body go. */
            responseHeaders.remove("content-encoding")
            responseHeaders.remove("content-length")
        }
        val body =
            StreamBody(
                method,
                requestPathOf(url),
                status,
                responseHeaders,
                hop.response.bodyAsChannel(),
                handle,
                declaredLength,
                if (identity) null else encoding,
                idleTimeoutFor(kotlin.coroutines.coroutineContext[CallSettings]),
            )
        openStreams.add(body)
        if (closed) {
            openStreams.remove(body)
            handle.abort()
            throw IllegalStateException(CLOSED_MESSAGE)
        }
        return ApiStreamResponse(status, responseHeaders, body)
    }

    /**
     * The idle timeout of a stream: the one the call asked for, else the transport's. A call
     * that asks for `0` disables it.
     */
    private fun idleTimeoutFor(settings: CallSettings?): Long? {
        val asked = settings?.idleTimeout ?: return transportOptions.idleTimeout
        return if (asked == 0L) null else asked
    }

    /** The path of [url] without its query string or fragment. */
    private fun requestPathOf(url: String): String {
        val stripped = url.substringBefore('#').substringBefore('?')
        val path =
            try {
                java.net.URI(stripped).rawPath
            } catch (_: java.net.URISyntaxException) {
                null
            }
        return if (path.isNullOrEmpty()) "/" else path
    }

    /** Raised inside a read to say that the body stayed silent for the idle timeout. */
    private class IdleTimedOut : java.io.IOException("The response body stayed silent for the idle timeout")

    /**
     * An open streamed body, tracked by the client so [close] can cancel it. A read is bounded by
     * the idle timeout; a failure is raised as the SDK's own error, never as the raw error of the
     * HTTP engine. The body counts the wire bytes and refuses to end quietly before the declared
     * `Content-Length`; an encoded body is decoded as it is read.
     */
    private inner class StreamBody(
        private val method: String,
        private val path: String,
        private val status: Int,
        private val headers: Map<String, String>,
        private val channel: ByteReadChannel,
        private val handle: StreamHandle,
        private val declaredLength: Long,
        private val encoding: String?,
        private val idleMillis: Long?,
    ) : ApiStreamBody {
        private val released = java.util.concurrent.atomic.AtomicBoolean(false)

        @Volatile private var closed = false

        @Volatile private var cancelledByClient = false

        @Volatile private var wireFailure: Throwable? = null
        private var seen = 0L
        private var ended = false
        private var decoder: java.io.InputStream? = null
        private var emptyBody = false

        /** The wire bytes as a blocking stream, for a decoder that cannot suspend. */
        private val wire: java.io.PushbackInputStream =
            java.io.PushbackInputStream(
                object : java.io.InputStream() {
                    override fun read(): Int {
                        val one = ByteArray(1)
                        val count = read(one, 0, 1)
                        return if (count < 0) -1 else one[0].toInt() and 0xff
                    }

                    override fun read(
                        buffer: ByteArray,
                        offset: Int,
                        length: Int,
                    ): Int = kotlinx.coroutines.runBlocking { readWire(buffer, offset, length) }
                },
                1,
            )

        override suspend fun read(buffer: ByteArray): Int {
            if (buffer.isEmpty()) {
                return 0
            }
            check(!cancelledByClient) { CLOSED_MESSAGE }
            check(!closed) { "The stream is closed" }
            if (ended) {
                return -1
            }
            try {
                val count =
                    if (encoding == null) {
                        readWire(buffer, 0, buffer.size)
                    } else {
                        kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) { readDecoded(buffer) }
                    }
                if (count < 0) {
                    ended = true
                    finish()
                }
                return count
            } catch (failure: Throwable) {
                val translated = translate(failure)
                finish()
                throw translated
            }
        }

        private suspend fun readWire(
            buffer: ByteArray,
            offset: Int,
            length: Int,
        ): Int {
            val count =
                try {
                    if (idleMillis == null) {
                        channel.readAvailable(buffer, offset, length)
                    } else {
                        kotlinx.coroutines.withTimeoutOrNull(idleMillis) {
                            channel.readAvailable(buffer, offset, length)
                        } ?: throw IdleTimedOut()
                    }
                } catch (e: IdleTimedOut) {
                    throw e
                } catch (e: kotlinx.coroutines.CancellationException) {
                    throw e
                } catch (e: Throwable) {
                    wireFailure = e
                    throw e
                }
            if (count < 0) {
                if (declaredLength >= 0 && seen != declaredLength) {
                    val truncated = java.io.IOException("The body ended after $seen of $declaredLength bytes")
                    wireFailure = truncated
                    throw truncated
                }
                return -1
            }
            seen += count
            return count
        }

        /** Reads from the decoder, which is opened on the first read so an empty body needs none. */
        private fun readDecoded(buffer: ByteArray): Int {
            if (emptyBody) {
                return -1
            }
            var current = decoder
            if (current == null) {
                val first = wire.read()
                if (first < 0) {
                    emptyBody = true
                    return -1
                }
                wire.unread(first)
                current = openDecoder(encoding!!, wire)
                decoder = current
            }
            return current.read(buffer, 0, buffer.size)
        }

        /** The SDK's error for a failed read. */
        private fun translate(failure: Throwable): Throwable =
            when {
                cancelledByClient -> IllegalStateException(CLOSED_MESSAGE)
                closed -> IllegalStateException("The stream is closed")
                failure is IdleTimedOut ->
                    NetworkTimeoutException(
                        "The response body was silent for $idleMillis ms",
                        java.net.SocketTimeoutException("no data for $idleMillis ms"),
                        method,
                        path,
                    )
                failure is kotlinx.coroutines.CancellationException -> failure
                failure is IllegalStateException -> failure
                wireFailure == null && encoding != null ->
                    ApiException(
                        status,
                        "Failed to decompress $encoding response body: $failure",
                        headers,
                        failure,
                    )
                else ->
                    StreamException(
                        "The response body was cut off after $seen bytes: ${wireFailure ?: failure}",
                        failure,
                        method,
                        path,
                    )
            }

        /** Ends the body: aborts what is left of the connection and gives the client its slot back. */
        private fun finish() {
            handle.abort()
            if (released.compareAndSet(false, true)) {
                openStreams.remove(this)
                finishRequest()
            }
        }

        /** Called by [close] of the client: the next read raises the closed-client error. */
        fun cancel() {
            cancelledByClient = true
            finish()
        }

        override fun close() {
            closed = true
            finish()
        }
    }
}

/** One response of the header phase: the Ktor response and, for a stream, what keeps it open. */
private class Hop(
    val response: HttpResponse,
    val handle: StreamHandle?,
) {
    /** Reads a redirect's body to release its connection, or aborts a stream's. */
    suspend fun discardBody() {
        if (handle != null) {
            handle.abort()
        } else {
            response.bodyAsBytes()
        }
    }
}

/** Keeps a streamed response open until it is released, and aborts it on request. */
private class StreamHandle(
    private val job: kotlinx.coroutines.Job,
    private val release: kotlinx.coroutines.CompletableDeferred<Unit>,
) {
    /** Lets the response go and cancels the call, which closes the connection instead of draining it. */
    fun abort() {
        release.complete(Unit)
        job.cancel()
    }

    /** Lets a response whose body was read to its end go, so Ktor can release its connection. */
    fun finish() {
        release.complete(Unit)
    }
}

/** The outcome of one send: a buffered response, or a stream whose body has not been read. */
private class Sent(
    val buffered: ApiHttpResponse?,
    val streamed: ApiStreamResponse?,
) {
    val statusCode: Int get() = buffered?.statusCode ?: streamed!!.statusCode
    val headers: Map<String, String> get() = buffered?.headers ?: streamed!!.headers

    /** Drops a stream that will not be handed to the caller, such as the answer to a retried status. */
    fun discard() {
        streamed?.close()
    }
}

/** Fails when [encoding] names a codec this client cannot decode. */
private fun requireDecoder(encoding: String) {
    when (encoding) {
        "gzip", "x-gzip", "deflate" -> {}
        "br" -> requireCodecClass("br", "org.brotli.dec.BrotliInputStream")
        "zstd" -> requireCodecClass("zstd", "com.github.luben.zstd.ZstdInputStream")
        else -> throw java.io.IOException("Unsupported Content-Encoding '$encoding'")
    }
}

private fun requireCodecClass(
    encoding: String,
    className: String,
) {
    if (!isCodecClassPresent(className)) {
        throw java.io.IOException("Received a $encoding-encoded response but the $encoding library is unavailable")
    }
}

/** Opens the decoder of an encoded body over its wire bytes. */
private fun openDecoder(
    encoding: String,
    wire: java.io.InputStream,
): java.io.InputStream =
    when (encoding) {
        "gzip", "x-gzip" -> java.util.zip.GZIPInputStream(wire)
        "deflate" -> java.util.zip.InflaterInputStream(wire)
        else -> {
            val className = if (encoding == "br") "org.brotli.dec.BrotliInputStream" else "com.github.luben.zstd.ZstdInputStream"
            try {
                Class
                    .forName(className)
                    .getConstructor(java.io.InputStream::class.java)
                    .newInstance(wire) as java.io.InputStream
            } catch (e: java.lang.reflect.InvocationTargetException) {
                throw (e.cause as? java.io.IOException) ?: java.io.IOException("Failed to decode $encoding-encoded response", e)
            } catch (e: ReflectiveOperationException) {
                throw java.io.IOException("Received a $encoding-encoded response but the $encoding library is unavailable", e)
            }
        }
    }

/**
 * The timeout, retry count and stream idle timeout one call asks for in place of the client's own
 * [TransportOptions]. A generated API class puts it in the coroutine context of the request
 * (the per-call `timeout` and `maxRetries` of an operation's options, and the `idleTimeout` of a
 * stream call's [StreamOptions]), and [DefaultApiClient] reads it; another [ApiClient]
 * implementation keeps its own settings.
 */
internal class CallSettings(
    val timeout: Long?,
    val maxRetries: Int?,
    val idleTimeout: Long? = null,
) : kotlin.coroutines.AbstractCoroutineContextElement(Key) {
    internal companion object Key : kotlin.coroutines.CoroutineContext.Key<CallSettings>
}

/**
 * The content of a [BodySource] that is not held in memory: it is written to the connection piece
 * by piece as the source is read, so the body is never buffered. A known `contentLength` is sent as
 * `Content-Length`; `null` is sent chunked.
 */
private class BodySourceContent(
    private val source: BodySource,
    override val contentType: ContentType,
    override val contentLength: Long?,
) : OutgoingContent.WriteChannelContent() {
    override suspend fun writeTo(channel: ByteWriteChannel) {
        source.chunks().collect { piece ->
            channel.writeFully(piece)
            channel.flush()
        }
    }
}

/**
 * The end-to-end `timeout` of one [DefaultApiClient.sendRequest] call, measured
 * on a monotonic clock from the start of the call. Each hop is armed with the
 * remaining budget (connect, socket and request timers alike); once nothing is
 * left, the next hop is refused with [NetworkTimeoutException] without being
 * sent. A null timeout means no budget.
 */
internal class TimeoutBudget(private val timeoutMillis: Long?) {
    private val deadline: Long? = timeoutMillis?.let { System.nanoTime() + it * 1_000_000L }

    /** Milliseconds left, or null when there is no timeout. May be zero or negative once spent. */
    fun remainingMillis(): Long? = deadline?.let { (it - System.nanoTime()) / 1_000_000L }

    /** The error of an end-to-end timeout that ran out while the response headers were awaited. */
    fun expired(cause: Throwable): NetworkTimeoutException =
        NetworkTimeoutException(
            "Request timed out: no response headers within the $timeoutMillis ms timeout",
            java.net.SocketTimeoutException("end-to-end timeout of $timeoutMillis ms exhausted").also { it.initCause(cause) },
        )

    /** The error of an end-to-end timeout that ran out while a buffered body was being read. */
    fun bodyExpired(cause: Throwable): NetworkTimeoutException =
        NetworkTimeoutException(
            "Request timed out: the response body was not read within the $timeoutMillis ms timeout",
            java.net.SocketTimeoutException("end-to-end timeout of $timeoutMillis ms exhausted").also { it.initCause(cause) },
        )

    /**
     * Arms [builder] for a streamed call: only the connection is bounded here. The wait for the
     * headers is bounded by the caller, and neither the request nor the socket timer of the
     * engine is allowed to run on, because both would cut the body that follows the headers.
     */
    fun applyToStream(
        builder: HttpRequestBuilder,
        client: HttpClient,
    ) {
        val end = deadline
        val remaining = if (end == null) null else (end - System.nanoTime()) / 1_000_000L
        if (remaining != null && remaining <= 0) {
            throw NetworkTimeoutException(
                "Request timed out: the $timeoutMillis ms end-to-end timeout was spent before the next hop",
                java.net.SocketTimeoutException("end-to-end timeout of $timeoutMillis ms exhausted"),
            )
        }
        if (remaining == null && client.pluginOrNull(io.ktor.client.plugins.HttpTimeout) == null) {
            return
        }
        builder.timeout {
            requestTimeoutMillis = io.ktor.client.plugins.HttpTimeoutConfig.INFINITE_TIMEOUT_MS
            socketTimeoutMillis = io.ktor.client.plugins.HttpTimeoutConfig.INFINITE_TIMEOUT_MS
            if (remaining != null) {
                connectTimeoutMillis = remaining
            }
        }
    }

    /** Arms [builder] with the remaining budget, or throws when it is spent. */
    fun applyTo(builder: HttpRequestBuilder) {
        val end = deadline ?: return
        val remaining = (end - System.nanoTime()) / 1_000_000L
        if (remaining <= 0) {
            throw NetworkTimeoutException(
                "Request timed out: the $timeoutMillis ms end-to-end timeout was spent before the next hop",
                java.net.SocketTimeoutException("end-to-end timeout of $timeoutMillis ms exhausted"),
            )
        }
        builder.timeout {
            requestTimeoutMillis = remaining
            connectTimeoutMillis = remaining
            socketTimeoutMillis = remaining
        }
    }
}

/**
 * The rules of the automatic retries: which statuses are retried and how long to wait.
 *
 * The backoff starts at 0.5 s and doubles up to 8 s, and up to 25% of it is shaved off at random
 * so that many clients do not retry in step. A `Retry-After` header, as a number of seconds or an
 * HTTP date, replaces the backoff and is capped at 60 s.
 */
internal object RetryPolicy {
    private const val INITIAL_DELAY_MILLIS = 500L
    private const val MAX_DELAY_MILLIS = 8_000L
    private const val MAX_RETRY_AFTER_MILLIS = 60_000L
    private const val JITTER_SHARE = 0.25
    private val SECONDS = Regex("^[0-9]+(\\.[0-9]+)?$")

    /** True for GET, HEAD, OPTIONS, TRACE, PUT, DELETE and QUERY: safe to send again after a dropped connection. */
    fun isIdempotentMethod(method: String): Boolean =
        method.uppercase() in setOf("GET", "HEAD", "OPTIONS", "TRACE", "PUT", "DELETE", "QUERY")

    /** True for 408, 409, 429 and every 5xx except 501. */
    fun isRetryableStatus(status: Int): Boolean =
        status == 408 || status == 409 || status == 429 || (status in 500..599 && status != 501)

    /**
     * The wait in milliseconds before the retry that follows attempt number [attempt] (the first
     * attempt is 0). [jitter] is a value in `[0, 1)`; [retryAfter] is the raw header, if any.
     */
    fun delayMillis(
        attempt: Int,
        retryAfter: String?,
        jitter: Double,
        now: java.time.Instant = java.time.Instant.now(),
    ): Long {
        val requested = parseRetryAfter(retryAfter, now)
        if (requested != null) {
            return requested
        }
        val doubled = if (attempt >= 5) MAX_DELAY_MILLIS else minOf(INITIAL_DELAY_MILLIS shl attempt, MAX_DELAY_MILLIS)
        return (doubled * (1.0 - JITTER_SHARE * jitter)).toLong()
    }

    /** The `Retry-After` value in milliseconds, capped at 60 s, or null when absent or unusable. */
    fun parseRetryAfter(
        value: String?,
        now: java.time.Instant,
    ): Long? {
        val text = value?.trim()
        if (text.isNullOrEmpty()) {
            return null
        }
        if (SECONDS.matches(text)) {
            val seconds = text.toDouble()
            return if (seconds >= MAX_RETRY_AFTER_MILLIS / 1000.0) MAX_RETRY_AFTER_MILLIS else (seconds * 1000).toLong()
        }
        return try {
            val date = java.time.ZonedDateTime.parse(text, java.time.format.DateTimeFormatter.RFC_1123_DATE_TIME)
            java.time.Duration.between(now, date.toInstant()).toMillis().coerceIn(0L, MAX_RETRY_AFTER_MILLIS)
        } catch (_: java.time.format.DateTimeParseException) {
            null
        }
    }
}

/**
 * Writes a `multipart/form-data` body (RFC 7578) part by part. Each part
 * carries `Content-Disposition` and, for file and JSON parts, `Content-Type`,
 * and nothing else: no `Content-Transfer-Encoding` and no per-part
 * `Content-Length` (RFC 7578 section 4.7). The field name is written as
 * `name="..."` with `\` and `"` backslash-escaped. The whole body is
 * buffered so the request carries one `Content-Length`.
 */
internal class MultipartWriter {
    private val boundary = "----" + generateRequestId().replace("-", "")
    private val out = java.io.ByteArrayOutputStream()

    /** Appends one part; [filenameDirective] and [contentType] are omitted when null. */
    fun part(
        name: String,
        filenameDirective: String?,
        contentType: String?,
        content: ByteArray,
    ) {
        val escapedName = name.replace("\\", "\\\\").replace("\"", "\\\"")
        val head = StringBuilder()
        head.append("--").append(boundary).append("\r\n")
        head.append("Content-Disposition: form-data; name=\"").append(escapedName).append('"')
        if (filenameDirective != null) head.append("; ").append(filenameDirective)
        head.append("\r\n")
        if (contentType != null) head.append("Content-Type: ").append(contentType).append("\r\n")
        head.append("\r\n")
        out.write(head.toString().toByteArray(Charsets.UTF_8))
        out.write(content)
        out.write("\r\n".toByteArray(Charsets.UTF_8))
    }

    /** Closes the body and returns it as request content with the given multipart type. */
    fun build(type: ContentType): io.ktor.http.content.OutgoingContent {
        out.write("--$boundary--\r\n".toByteArray(Charsets.UTF_8))
        return io.ktor.http.content.ByteArrayContent(
            out.toByteArray(),
            type.withParameter("boundary", boundary),
        )
    }
}

/**
 * The multipart type a form body is sent as: the caller's declared multipart type when it is a
 * safe header value, otherwise `multipart/form-data`.
 */
internal fun declaredMultipartType(declared: String?): ContentType {
    val safe = declared != null && declared.none { it == '"' || it == '\r' || it == '\n' || it == '\u0000' }
    val parsed = if (safe) runCatching { ContentType.parse(declared!!) }.getOrNull() else null
    return if (parsed != null && parsed.contentType.equals("multipart", ignoreCase = true)) {
        ContentType(parsed.contentType, parsed.contentSubtype)
    } else {
        ContentType.MultiPart.FormData
    }
}

/** The response headers as a lower-cased map with comma-joined values. */
internal fun responseHeadersOf(response: HttpResponse): Map<String, String> {
    val copy = mutableMapOf<String, String>()
    response.headers.forEach { name, values ->
        copy[name.lowercase(java.util.Locale.ROOT)] = values.joinToString(", ")
    }
    return copy
}

/**
 * True for the statuses that carry a followable redirect: 301, 302, 303, 307 and
 * 308. Other 3xx codes (300 Multiple Choices, 304, 305, 306) are not redirects to
 * follow and surface to the caller as-is, as in the other SDKs.
 */
internal fun isRedirectStatus(status: Int): Boolean =
    status == 301 || status == 302 || status == 303 || status == 307 || status == 308

/** True when [className] is on the runtime classpath (optional codec libraries). */
internal fun isCodecClassPresent(className: String): Boolean =
    runCatching { Class.forName(className) }.isSuccess

/**
 * The Accept-Encoding value this client advertises. gzip and deflate are always
 * supported (JDK built-ins); br and zstd are advertised only when their optional
 * libraries (`org.brotli:dec`, `com.github.luben:zstd-jni`) are on the classpath,
 * so a server never sends a codec this client cannot decode. Matches java.
 */
internal fun supportedEncodings(): String = buildString {
    append("gzip, deflate")
    if (isCodecClassPresent("org.brotli.dec.BrotliInputStream")) append(", br")
    if (isCodecClassPresent("com.github.luben.zstd.ZstdInputStream")) append(", zstd")
}

/**
 * Decodes a response body according to its `Content-Encoding` header
 * (`gzip`, `x-gzip` and `deflate`; `br`/`zstd` when their optional libraries are
 * present). An empty body, an empty value and `identity` are returned unchanged;
 * any other value raises [java.io.IOException], as does a body that is not valid
 * for the declared encoding. br/zstd are reached
 * through reflection so the optional libraries can be `compileOnly` — an absent
 * library raises [java.io.IOException] rather than returning the body still
 * encoded (the codec is never advertised, so only a non-conformant server sends it).
 * The decoded bytes are counted as they are produced, and decoding stops with [BodyTooLarge]
 * as soon as they pass [limit] (D138), so a small body that inflates past it is never decoded
 * in full.
 */
internal fun decodeContentEncoding(
    data: ByteArray,
    contentEncoding: String,
    limit: Long = Long.MAX_VALUE,
): ByteArray {
    if (data.isEmpty()) return data
    return when (contentEncoding.trim().lowercase()) {
        "gzip", "x-gzip" ->
            java.util.zip.GZIPInputStream(data.inputStream()).use { readCapped(it, limit) }
        "deflate" ->
            java.util.zip.InflaterInputStream(data.inputStream()).use { readCapped(it, limit) }
        "br" -> decodeViaInputStream(data, "br", "org.brotli.dec.BrotliInputStream", limit)
        "zstd" -> decodeViaInputStream(data, "zstd", "com.github.luben.zstd.ZstdInputStream", limit)
        "", "identity" -> data
        // An unrecognised (or multi-value) Content-Encoding is a response the
        // client cannot honour; raise so the caller surfaces an ApiException
        // (matching csharp/elixir and the documented contract) instead of
        // returning the body still encoded.
        else -> throw java.io.IOException("Unsupported Content-Encoding '$contentEncoding'")
    }
}

/**
 * Decode [data] through an optional codec named [encoding] whose decompressing
 * `InputStream` class is [className] and wraps a source `InputStream`. Raises
 * [java.io.IOException] when the class is absent or fails to load, never returning
 * the still-encoded bytes.
 */
internal fun decodeViaInputStream(
    data: ByteArray,
    encoding: String,
    className: String,
    limit: Long = Long.MAX_VALUE,
): ByteArray {
    val unavailable = "Received a $encoding-encoded response but the $encoding library is unavailable"
    val cls = try {
        Class.forName(className)
    } catch (e: ClassNotFoundException) {
        throw java.io.IOException(unavailable, e)
    }
    return try {
        val stream = cls.getConstructor(java.io.InputStream::class.java)
            .newInstance(data.inputStream()) as java.io.InputStream
        stream.use { readCapped(it, limit) }
    } catch (e: ReflectiveOperationException) {
        throw java.io.IOException(unavailable, e)
    }
}

/**
 * Raised by [readCapped] when the decoded bytes pass `maxResponseBytes`; the client turns it into
 * [ResponseTooLargeException] with the response's status and headers.
 */
internal class BodyTooLarge(
    val limit: Long,
) : java.io.IOException("Response body exceeds the limit of $limit bytes")

/** Reads [input] to its end, failing with [BodyTooLarge] as soon as the bytes read pass [limit]. */
internal fun readCapped(
    input: java.io.InputStream,
    limit: Long,
): ByteArray {
    if (limit == Long.MAX_VALUE) {
        return input.readBytes()
    }
    val collected = java.io.ByteArrayOutputStream()
    val chunk = ByteArray(8192)
    var total = 0L
    while (true) {
        val count = input.read(chunk)
        if (count < 0) {
            break
        }
        total += count
        if (total > limit) {
            throw BodyTooLarge(limit)
        }
        collected.write(chunk, 0, count)
    }
    return collected.toByteArray()
}

/**
 * Builds a `Basic <base64>` Proxy-Authorization value from the userinfo
 * embedded in the proxy URL, or returns null when no credentials are
 * present. Percent-encoded userinfo is decoded before encoding.
 */
internal fun buildProxyAuthHeader(proxyUrl: String?): String? {
    if (proxyUrl == null) return null
    val uri = try {
        java.net.URI(proxyUrl)
    } catch (_: Exception) {
        return null
    }
    val rawUserInfo = uri.rawUserInfo ?: return null
    if (rawUserInfo.isEmpty()) return null
    // URLDecoder is form decoding and turns a literal '+' into a space; in a
    // URI userinfo '+' is a plain sub-delim (RFC 3986 section 3.2.1).
    val decoded = java.net.URLDecoder.decode(rawUserInfo.replace("+", "%2B"), Charsets.UTF_8)
    val encoded = java.util.Base64.getEncoder()
        .encodeToString(decoded.toByteArray(Charsets.UTF_8))
    return "Basic $encoded"
}

/**
 * Normalize a URI port, returning the default-port value (443 for https,
 * 80 for http) when the URI does not specify an explicit port. Used by
 * the same-origin redirect check so that `https://host/x` and
 * `https://host:443/x` compare equal — without this, a redirect that
 * only adds the implicit default port would incorrectly be treated as
 * cross-origin and strip sensitive headers (Authorization, Cookie,
 * Proxy-Authorization).
 */
internal fun effectivePort(uri: java.net.URI): Int {
    val port = uri.port
    if (port != -1) return port
    return if ("https".equals(uri.scheme, ignoreCase = true)) 443 else 80
}

/**
 * Decide whether two URIs share the same origin (scheme + host + effective
 * port) for forwarding sensitive headers across a redirect. The scheme MUST
 * match: redirecting from `https://host/x` to `http://host/x` is a TLS
 * downgrade and must drop the Authorization header.
 */
internal fun sameOrigin(originalUri: java.net.URI, redirectUri: java.net.URI): Boolean {
    return redirectUri.host != null &&
        redirectUri.scheme != null &&
        originalUri.scheme != null &&
        redirectUri.scheme.equals(originalUri.scheme, ignoreCase = true) &&
        redirectUri.host.equals(originalUri.host, ignoreCase = true) &&
        effectivePort(redirectUri) == effectivePort(originalUri)
}

/**
 * Resolve a Location header against the URL that produced it. java.net.URI
 * implements the RFC 2396 rules, which resolve a query-only reference such as
 * `?page=2`, or an empty one, against the base DIRECTORY (dropping the last
 * path segment); RFC 3986 keeps the base path (and, for an empty reference,
 * the base query). A fragment-only reference is already resolved the RFC 3986
 * way by java.net.URI, and every other reference form resolves identically
 * under both RFCs, so only the query-only and empty forms are handled here.
 */
internal fun resolveRedirectLocation(base: java.net.URI, location: String): java.net.URI {
    if (location.isEmpty()) {
        return java.net.URI(base.toString().substringBefore('#'))
    }
    if (location.startsWith("?")) {
        val baseWithoutQuery = base.toString().substringBefore('#').substringBefore('?')
        return java.net.URI(baseWithoutQuery + location)
    }
    return base.resolve(location)
}

/**
 * Resolve a Location header for following, or null when it is unusable: absent,
 * empty, or rejected by the reference resolver (`http://[bad`). The redirect
 * loop treats null exactly like a missing Location and returns the 3xx as-is.
 */
internal fun usableRedirectLocation(base: java.net.URI, location: String?): java.net.URI? {
    if (location.isNullOrEmpty()) return null
    return try {
        resolveRedirectLocation(base, location)
    } catch (_: IllegalArgumentException) {
        null
    } catch (_: java.net.URISyntaxException) {
        null
    }
}

/**
 * A URL as it may appear in an error message: the user information, query and
 * fragment are dropped, because a query-parameter API key is part of the query
 * and user information can carry a password.
 */
internal fun redactUrl(url: String): String =
    url.substringBefore('#').substringBefore('?').replace(urlUserInfo, "$1")

private val urlUserInfo = Regex("""^([a-zA-Z][a-zA-Z0-9+.-]*://)[^/?#@]*@""")

private val urlWithQuery = Regex("""(https?://[^\s?#,\]\)]*)[?#][^\s,\]\)]*""", RegexOption.IGNORE_CASE)

/**
 * [message] with the query and fragment of every http(s) URL in it removed. Ktor's timeout
 * exceptions print the request URL, which can hold a query-parameter API key (F861).
 */
internal fun redactUrlsInMessage(message: String): String = urlWithQuery.replace(message, "$1")

/** True when [headers] holds [name] under any ASCII letter case (RFC 9110 section 5.1). */
private fun hasHeader(
    headers: Map<String, String>,
    name: String,
): Boolean = headers.keys.any { it.equals(name, ignoreCase = true) }

/** Generates a UUID v4 string without JVM-specific APIs. */
internal fun generateRequestId(): String {
    val rand = kotlin.random.Random.Default
    fun hex(n: Int) = n.toString(16).padStart(2, '0')
    val b = Array(16) { rand.nextInt(256) }
    b[6] = (b[6] and 0x0f) or 0x40
    b[8] = (b[8] and 0x3f) or 0x80
    return "${hex(b[0])}${hex(b[1])}${hex(b[2])}${hex(b[3])}-" +
        "${hex(b[4])}${hex(b[5])}-" +
        "${hex(b[6])}${hex(b[7])}-" +
        "${hex(b[8])}${hex(b[9])}-" +
        "${hex(b[10])}${hex(b[11])}${hex(b[12])}${hex(b[13])}${hex(b[14])}${hex(b[15])}"
}

/**
 * Best-effort per-part MIME sniffing from a filename's extension. Falls back to
 * `application/octet-stream` for unknown or missing extensions. Used by the
 * multipart builder so that typed-file uploads (PNG, PDF, JSON) carry an
 * accurate per-part Content-Type rather than a blanket octet-stream.
 */
internal fun contentTypeForFilename(filename: String): ContentType {
    val dot = filename.lastIndexOf('.')
    if (dot < 0 || dot == filename.length - 1) return ContentType.Application.OctetStream
    val mime = when (filename.substring(dot + 1).lowercase()) {
        "png" -> "image/png"
        "jpg", "jpeg" -> "image/jpeg"
        "gif" -> "image/gif"
        "pdf" -> "application/pdf"
        "json" -> "application/json"
        else -> null
    } ?: return ContentType.Application.OctetStream
    return try {
        ContentType.parse(mime)
    } catch (_: Exception) {
        ContentType.Application.OctetStream
    }
}

/**
 * Parses the `charset=` parameter from a Content-Type header (e.g.
 * `text/plain; charset=ISO-8859-1`). Falls back to UTF-8 when the header is
 * absent, malformed, or names a charset unknown to the JVM. Never throws.
 */
internal fun charsetFor(contentType: String?): java.nio.charset.Charset {
    if (contentType.isNullOrEmpty()) return Charsets.UTF_8
    // Parameter names are case-insensitive and may have whitespace around '='
    // (RFC 9110 sections 5.6.6 and 8.3.1); only a parameter named exactly
    // `charset` counts, never one that merely ends in it (`xcharset`).
    val name =
        contentType.split(';').drop(1)
            .map { it.trim() }
            .firstNotNullOfOrNull { parameter ->
                val eq = parameter.indexOf('=')
                if (eq > 0 && parameter.substring(0, eq).trim().equals("charset", ignoreCase = true)) {
                    parameter.substring(eq + 1).trim().trim('"', '\'')
                } else {
                    null
                }
            }
    if (name.isNullOrEmpty()) return Charsets.UTF_8
    return try {
        java.nio.charset.Charset.forName(name)
    } catch (_: Exception) {
        Charsets.UTF_8
    }
}

/** Returns true if the content type represents text that can be decoded as UTF-8. */
internal fun isTextContentType(contentType: String): Boolean {
    val mediaType = contentType.split(';').first().trim().lowercase()
    if (mediaType.isEmpty()) return true
    if (mediaType.startsWith("text/")) return true
    return mediaType == "application/json" ||
        mediaType == "application/xml" ||
        mediaType == "application/javascript" ||
        mediaType.endsWith("+json") ||
        mediaType.endsWith("+xml")
}

/**
 * Rejects multipart form field names that would allow Content-Disposition
 * header injection or smuggling. Throws [IllegalArgumentException] when the
 * field name contains CR, LF, or NUL. Must be invoked on every branch of the
 * multipart builder (string, number, boolean, JSON, binary), not just the
 * binary path, because the name is interpolated directly into the
 * `Content-Disposition: form-data; name="..."` header.
 */
internal fun validateMultipartFieldName(fieldName: String?) {
    if (fieldName == null) return
    for (c in fieldName) {
        if (c == '\r' || c == '\n' || c == '\u0000') {
            throw IllegalArgumentException(
                "multipart field name must not contain CR, LF, or NUL characters"
            )
        }
    }
}

/**
 * Rejects multipart filenames that would allow Content-Disposition header
 * injection or smuggling. Throws [IllegalArgumentException] when the filename
 * contains CR, LF, or NUL.
 */
internal fun validateMultipartFilename(filename: String?) {
    if (filename == null) return
    for (c in filename) {
        if (c == '\r' || c == '\n' || c == '\u0000') {
            throw IllegalArgumentException(
                "multipart filename must not contain CR, LF, or NUL characters"
            )
        }
    }
}

/**
 * Builds the `filename=...` directive for a multipart Content-Disposition part.
 * For ASCII-only filenames emits `filename="..."` with quote/backslash escaping.
 * For non-ASCII filenames additionally emits an RFC 5987
 * `filename*=UTF-8''<percent-encoded>` parameter alongside an ASCII fallback
 * (each non-ASCII or control code point replaced with one `_`).
 */
internal fun buildFilenameDirective(filename: String): String {
    val escaped = filename.replace("\\", "\\\\").replace("\"", "\\\"")
    val ascii = filename.all { it.code <= 0x7F }
    if (ascii) {
        return "filename=\"$escaped\""
    }
    // One `_` per Unicode code point (not per UTF-16 unit), so a
    // supplementary character such as an emoji becomes a single `_`.
    val fallback = buildString {
        filename.codePoints().forEach { cp ->
            if (cp > 0x7F || cp < 0x20 || cp == 0x7F) {
                append('_')
            } else {
                appendCodePoint(cp)
            }
        }
    }.replace("\\", "\\\\").replace("\"", "\\\"")
    val encoded = rfc5987EncodeValue(filename)
    return "filename=\"$fallback\"; filename*=UTF-8''$encoded"
}

/**
 * Percent-encodes every byte that is not an RFC 3986 §2.3 unreserved character,
 * producing the value-chars production of RFC 5987 §3.2.1.
 */
internal fun rfc5987EncodeValue(s: String): String {
    val hex = "0123456789ABCDEF"
    val bytes = s.toByteArray(Charsets.UTF_8)
    val out = StringBuilder(bytes.size * 3)
    for (b in bytes) {
        val u = b.toInt() and 0xFF
        val isUnreserved = (u in 'A'.code..'Z'.code) ||
            (u in 'a'.code..'z'.code) ||
            (u in '0'.code..'9'.code) ||
            u == '-'.code || u == '.'.code || u == '_'.code || u == '~'.code
        if (isUnreserved) {
            out.append(u.toChar())
        } else {
            out.append('%').append(hex[u ushr 4]).append(hex[u and 0x0F])
        }
    }
    return out.toString()
}

/**
 * Picks the transport for [options]: the SDK's own client, or a derived view of the
 * caller-supplied one. The derived view shares the caller's engine (closing it never
 * closes that engine) and gets the SDK's defaults on top: redirects are handled by
 * [DefaultApiClient] itself, and the end-to-end timeout is armed when one is set.
 */
internal fun resolveHttpClient(options: TransportOptions): HttpClient {
    val supplied = options.httpClient ?: return buildPlatformHttpClient(options)
    return supplied.config {
        followRedirects = false
        if (options.timeout != null) {
            install(io.ktor.client.plugins.HttpTimeout) {
                requestTimeoutMillis = options.timeout.toLong()
                connectTimeoutMillis = options.timeout.toLong()
                socketTimeoutMillis = options.timeout.toLong()
            }
        }
    }
}

/** Platform-specific [HttpClient] factory; configured with engine, TLS, proxy, and common plugins. */
internal expect fun buildPlatformHttpClient(options: TransportOptions): HttpClient
