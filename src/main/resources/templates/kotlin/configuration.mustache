package {{invokerPackage}}

/**
 * API-level configuration for generated client classes.
 */
class Configuration private constructor(
    val baseUrl: String,
    val defaultHeaders: Map<String, String>
) {
    companion object {
        /** Create a new builder for constructing [Configuration] instances. */
        fun builder(): Builder = Builder()

        /**
         * Return a [Configuration] with default values.
         *
         * A fresh instance every call: the SDK keeps no process-wide default a
         * caller could swap out from under another caller.
         */
        fun defaultConfiguration(): Configuration = builder().build()
    }

    class Builder {
        private var baseUrl: String = "{{{basePath}}}"
        private val defaultHeaders: MutableMap<String, String> = mutableMapOf()

        fun baseUrl(baseUrl: String): Builder = apply { this.baseUrl = baseUrl }

        fun defaultHeader(name: String, value: String): Builder = apply {
            defaultHeaders[name] = value
        }

        fun defaultHeaders(headers: Map<String, String>): Builder = apply {
            defaultHeaders.putAll(headers)
        }

        fun server(serverConfig: ServerConfiguration, variables: Map<String, String>? = null): Builder = apply {
            this.baseUrl = serverConfig.getUrl(variables ?: emptyMap())
        }

        fun build(): Configuration = Configuration(baseUrl, defaultHeaders.toMap())
    }
}
