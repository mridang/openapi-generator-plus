root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.kt]
indent_size = 4
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_backing-property-naming = disabled

[*.kts]
indent_size = 4

[Makefile]
indent_style = tab
