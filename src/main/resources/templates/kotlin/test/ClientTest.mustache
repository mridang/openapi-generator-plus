    private fun publicMethodNames(methods: Array<java.lang.reflect.Method>): Set<String> =
        methods
            .filter { java.lang.reflect.Modifier.isPublic(it.modifiers) && !it.isSynthetic && !it.name.contains('$') }
            .map { it.name }
            .toSortedSet()

