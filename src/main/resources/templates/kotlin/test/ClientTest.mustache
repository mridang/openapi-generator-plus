    @Test
    @DisplayName("F857: a client given only a host sends no authentication header")
    fun clientWithNoCredentialSendsNoAuthenticationHeader() {
        var authorization: String? = "unset"
        val engine =
            MockEngine { request ->
                authorization = request.headers["Authorization"]
                respond("{}")
            }
        val client =
            {{clientClassName}}(
                "{{{basePath}}}",
                transportOptions = TransportOptions.builder().httpClient(HttpClient(engine)).build(),
            )

        runBlocking { client.store.getInventory() }

        assertNull(authorization)
    }

    @Test
    @DisplayName("Bearer rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)")
    fun bearerRejectsCrlfAndNonAscii() {
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("{{{basePath}}}", "tok\r\nInjected: yes")
        }
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("{{{basePath}}}", "ñoño")
        }
    }

    @Test
    @DisplayName("bearer-no-empty-token-guard: Bearer rejects empty/blank token")
    fun bearerRejectsEmptyOrBlankToken() {
        // An empty or whitespace-only token would emit a credential-less
        // "Authorization: Bearer " header (fail-open); reject it up front.
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("{{{basePath}}}", "")
        }
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("{{{basePath}}}", "   ")
        }
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("{{{basePath}}}", "\t")
        }
    }

    @Test
    @DisplayName("ApiKey header rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)")
    fun apiKeyHeaderRejectsCrlfAndNonAscii() {
        // ApiKeyAuthenticator's HEADER location must reject any value
        // outside printable ASCII + TAB to prevent both header injection
        // (\r\n) and silent UTF-8 mangling that varies per HTTP lib.
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator("{{{basePath}}}", "X-Api-Key", "abc\r\nInjected: yes", ApiKeyLocation.HEADER)
        }
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator("{{{basePath}}}", "X-Api-Key", "kéy", ApiKeyLocation.HEADER)
        }
        // Non-header locations accept arbitrary chars.
        assertNotNull(
            ApiKeyAuthenticator("{{{basePath}}}", "api_key", "kéy", ApiKeyLocation.QUERY).getQueryParams()
        )
    }

    @Test
    @DisplayName("ApiKey query location accepts non-ASCII characters")
    fun apiKeyQueryAcceptsNonAscii() {
        // The QUERY location is URL-encoded downstream, so it must accept a
        // non-ASCII key value verbatim and surface it through getQueryParams.
        assertEquals(
            mapOf("api_key" to "kéy"),
            ApiKeyAuthenticator("{{{basePath}}}", "api_key", "kéy", ApiKeyLocation.QUERY).getQueryParams()
        )
    }

    @Test
    @DisplayName("missing CA cert surfaces IllegalArgumentException, not raw JDK exception")
    fun missingCaCertThrowsIllegalArgumentException() {
        // A custom CA cert path that does not exist is a configuration mistake,
        // not an API failure. Construction must fail fast with
        // IllegalArgumentException rather than a raw FileNotFoundException.
        val transport =
            TransportOptions.builder()
                .caCertPath("/nonexistent/path/to/ca-cert.pem")
                .build()

        val ex =
            assertThrows(IllegalArgumentException::class.java) {
                {{clientClassName}}(authenticator, transport)
            }
        assertTrue(ex.message!!.contains("CA certificate"))
    }

    @Test
    @DisplayName("missing CA cert is rejected even when verifySsl is false")
    fun missingCaCertIsRejectedWhenVerifySslIsFalse() {
        val transport =
            TransportOptions.builder()
                .verifySsl(false)
                .caCertPath("/nonexistent/path/to/ca-cert.pem")
                .build()

        val ex =
            assertThrows(IllegalArgumentException::class.java) {
                {{clientClassName}}(authenticator, transport)
            }
        assertTrue(ex.message!!.contains("CA certificate"))
    }

    @Test
    @DisplayName("garbage CA cert surfaces IllegalArgumentException, not raw JDK exception")
    fun invalidCaCertThrowsIllegalArgumentException(@TempDir tempDir: Path) {
        // A readable file whose contents are not a valid PEM certificate must
        // also surface as IllegalArgumentException (wrapping the underlying
        // CertificateException), never a raw java.security.cert.CertificateException.
        val badCert = File(tempDir.toFile(), "bad-ca.pem")
        badCert.writeText("not a valid certificate")

        val transport =
            TransportOptions.builder()
                .caCertPath(badCert.absolutePath)
                .build()

        val ex =
            assertThrows(IllegalArgumentException::class.java) {
                {{clientClassName}}(authenticator, transport)
            }
        assertTrue(ex.message!!.contains("CA certificate"))
    }

    @Test
    @DisplayName("F824: a closed client rejects further requests")
    fun closedClientRejectsRequests() {
        val client = {{clientClassName}}(authenticator)
        client.close()

        val ex =
            assertThrows(IllegalStateException::class.java) {
                runBlocking { client.pet.getPetById(1L) }
            }
        assertTrue(ex.message!!.contains("closed"))
    }

    @Test
    @DisplayName("F824: closing the client never closes a caller-supplied transport")
    fun closingTheClientKeepsASuppliedTransportOpen() {
        val custom = HttpClient(MockEngine { respond("{}") })
        val client = {{clientClassName}}(authenticator, TransportOptions.builder().httpClient(custom).build())

        client.close()

        assertTrue(custom.coroutineContext[Job]!!.isActive)
        custom.close()
    }

    @Test
    @DisplayName("close is on the ApiClient contract: a custom transport without close can be closed")
    fun customTransportWithoutCloseCanBeClosedTwice() {
        val transport = object : ApiClient {
            override suspend fun sendRequest(
                method: String,
                url: String,
                headers: Map<String, String>,
                body: Any?,
                noRedirect: Boolean
            ): ApiHttpResponse = ApiHttpResponse(200, "{}", emptyMap())
        }

        transport.close()
        transport.close()

        assertEquals(200, runBlocking { transport.sendRequest("GET", "http://localhost/", emptyMap(), null).statusCode })
    }

