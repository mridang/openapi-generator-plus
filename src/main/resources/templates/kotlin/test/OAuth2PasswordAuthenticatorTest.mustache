    private fun <T> withEnvironment(values: Map<String, String>, body: () -> T): T {
        val saved = CredentialEnvironment.lookup
        CredentialEnvironment.lookup = { name -> values[name] }
        try {
            return body()
        } finally {
            CredentialEnvironment.lookup = saved
        }
    }

    @Test
    fun generatedSchemeWrapperReadsEveryCredentialFromItsOwnVariable() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok","expires_in":3600}""")
        val env = mapOf(
            "{{envVarPrefix}}_LEGACY_AUTH_CLIENT_ID" to "env-id",
            "{{envVarPrefix}}_LEGACY_AUTH_CLIENT_SECRET" to "env-" + "secret",
            "{{envVarPrefix}}_LEGACY_AUTH_USERNAME" to "env-user",
            "{{envVarPrefix}}_LEGACY_AUTH_PASSWORD" to "env-" + "pw",
        )
        val auth =
            withEnvironment(env) { LegacyAuthPasswordAuthenticator("https://api.example.com", username = "arg-user") }
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }
        assertTrue(client.lastBody!!.contains("username=arg-user"), client.lastBody)
        assertTrue(client.lastBody!!.contains("env-pw"), client.lastBody)
    }

    @Test
    fun bhvAuthoauthtwopassword012GeneratedSchemeWrapperFailsNamingTheVariableOfAMissingCredential() {
        val env = mapOf(
            "{{envVarPrefix}}_LEGACY_AUTH_CLIENT_ID" to "env-id",
            "{{envVarPrefix}}_LEGACY_AUTH_CLIENT_SECRET" to "x",
        )
        val ex = withEnvironment(env) {
            assertThrows(IllegalArgumentException::class.java) {
                LegacyAuthPasswordAuthenticator("https://api.example.com")
            }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_LEGACY_AUTH_USERNAME"), ex.message)
    }

