class OAuth2PasswordAuthenticatorTest {

    private class FakeApiClient : ApiClient {
        private val responses = LinkedList<ApiHttpResponse>()
        var lastBody: String? = null
            private set
        var lastUrl: String? = null
            private set
        var lastHeaders: Map<String, String> = emptyMap()
            private set

        fun enqueue(body: String, statusCode: Int = 200) {
            responses.add(ApiHttpResponse(statusCode, body, emptyMap()))
        }

        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean
        ): ApiHttpResponse {
            lastUrl = url
            lastHeaders = headers
            lastBody = body?.toString()
            return responses.poll() ?: throw IllegalStateException("No responses queued")
        }
    }

    private fun createAuthenticator(): OAuth2PasswordAuthenticator {
        return OAuth2PasswordAuthenticator(
            host = "https://api.example.com",
            clientId = "my-client-id",
            clientSecret = "my-client-secret",
            tokenUrl = "https://auth.example.com/token",
            refreshUrl = null,
            username = "testuser",
            password = "testpass",
            scopes = listOf("read", "write")
        )
    }

    @Test
    fun bhvAuthoauthtwopassword004InvalidateAccessTokenKeepsTheRefreshTokenForTheNextCall() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","refresh_token":"ref1","expires_in":3600}""")
        client.enqueue("""{"access_token":"tok2","expires_in":3600}""")
        val auth = createAuthenticator()
        auth.setApiClient(client)

        val first = runBlocking { auth.getAuthHeaders() }["Authorization"]
        auth.invalidateAccessToken()
        val second = runBlocking { auth.getAuthHeaders() }["Authorization"]

        assertEquals("Bearer tok1", first)
        assertEquals("Bearer tok2", second)
        assertTrue(client.lastBody!!.contains("grant_type=refresh_token"), client.lastBody)
        assertTrue(client.lastBody!!.contains("refresh_token=ref1"), client.lastBody)
    }

    @Test
    fun bhvAuthoauthtwopassword017RefreshUrlIsATrailingOptionalArgument() {
        // refreshUrl comes after scopes and defaults to null (like the
        // authorization-code authenticator and the other SDKs), so the required
        // arguments can be passed positionally without it.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","refresh_token":"r1","expires_in":0}""")
        client.enqueue("""{"access_token":"tok2","expires_in":3600}""")
        val auth = OAuth2PasswordAuthenticator(
            "https://api.example.com", "id", "secret",
            "https://auth.example.com/token", "user", "pw", listOf("read"),
            "https://auth.example.com/refresh")
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }
        assertEquals("https://auth.example.com/token", client.lastUrl)
        runBlocking { auth.getAuthHeaders() }
        assertEquals("https://auth.example.com/refresh", client.lastUrl)
    }

