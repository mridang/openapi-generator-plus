package {{invokerPackage}}

import {{invokerPackage}}.auth.oauth.OAuth2PasswordAuthenticator
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.Test
import java.util.LinkedList

class OAuth2PasswordAuthenticatorTest {

    private class FakeApiClient : ApiClient {
        private val responses = LinkedList<ApiResponse>()
        var lastBody: String? = null
            private set
        var lastUrl: String? = null
            private set

        fun enqueue(body: String, statusCode: Int = 200) {
            responses.add(ApiResponse(statusCode, body, emptyMap()))
        }

        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?
        ): ApiResponse {
            lastUrl = url
            lastBody = body?.toString()
            return responses.poll() ?: throw IllegalStateException("No responses queued")
        }
    }

    private fun createAuthenticator(): OAuth2PasswordAuthenticator {
        return OAuth2PasswordAuthenticator(
            host = "https://api.example.com",
            clientId = "my-client-id",
            clientSecret = "my-client-secret",
            tokenUrl = "https://auth.example.com/token",
            refreshUrl = null,
            username = "testuser",
            password = "testpass",
            scopes = listOf("read", "write")
        )
    }

    @Test
    fun sendsPasswordGrantType() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        auth.getAuthHeaders()

        assertNotNull(client.lastBody)
        assertTrue(client.lastBody!!.contains("grant_type=password"))
    }

    @Test
    fun sendsUsernameAndPassword() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        auth.getAuthHeaders()

        assertTrue(client.lastBody!!.contains("username=testuser"))
        assertTrue(client.lastBody!!.contains("password=testpass"))
    }

    @Test
    fun sendsClientIdAndSecret() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        auth.getAuthHeaders()

        assertTrue(client.lastBody!!.contains("client_id=my-client-id"))
        assertTrue(client.lastBody!!.contains("client_secret=my-client-secret"))
    }

    @Test
    fun returnsAuthorizationBearerHeader() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok-pwd","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        val headers = auth.getAuthHeaders()

        assertEquals("Bearer tok-pwd", headers["Authorization"])
    }

    @Test
    fun usesRefreshTokenOnSubsequentCalls() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","refresh_token":"ref1","expires_in":1}""")
        client.enqueue("""{"access_token":"tok2","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        // First call uses password grant
        auth.getAuthHeaders()
        // Second call should use refresh_token grant since token is expired
        auth.getAuthHeaders()

        assertTrue(client.lastBody!!.contains("grant_type=refresh_token"))
        assertTrue(client.lastBody!!.contains("refresh_token=ref1"))
    }

    @Test
    fun getHostReturnsConfiguredHost() {
        val auth = createAuthenticator()

        assertEquals("https://api.example.com", auth.getHost())
    }
}
