        fun sendsPostWithJsonBody() {
            val client = mockClient(body = "{\"method\":\"POST\",\"body\":\"key\"}")
            val apiClient = DefaultApiClient(client)
            var response: ApiResponse? = null
            runBlocking {
                response = apiClient.sendRequest(
