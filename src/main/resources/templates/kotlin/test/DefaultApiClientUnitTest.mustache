    @Nested
    @DisplayName("automatic retries")
    inner class AutomaticRetries {

        private val sleeps = mutableListOf<Long>()
        private val seenHeaders = mutableListOf<Headers>()
        private val seenBodies = mutableListOf<String>()
        private var requestCount = 0

        /* Each answer is a status code to respond with or a Throwable to fail with; the last one
         * repeats. The retry pause is recorded in `sleeps` and not waited for. */
        private fun retrying(
            answers: List<Any>,
            maxRetries: Int = 2,
            timeout: Long? = null,
            injectRequestId: Boolean = false,
            retryAfter: String? = null,
            jitter: Double = 0.0,
        ): DefaultApiClient {
            val engine =
                MockEngine { request ->
                    val answer = answers[minOf(requestCount, answers.size - 1)]
                    requestCount++
                    seenHeaders.add(request.headers)
                    seenBodies.add(String(request.body.toByteArray(), Charsets.UTF_8))
                    if (answer is Throwable) {
                        throw answer
                    }
                    respond(
                        content = "{}",
                        status = HttpStatusCode.fromValue(answer as Int),
                        headers =
                            if (retryAfter == null) {
                                headersOf("Content-Type", "application/json")
                            } else {
                                headersOf("Content-Type" to listOf("application/json"), "Retry-After" to listOf(retryAfter))
                            },
                    )
                }
            val httpClient =
                HttpClient(engine) {
                    followRedirects = false
                    install(io.ktor.client.plugins.HttpTimeout)
                }
            val transport =
                TransportOptions.builder()
                    .timeout(timeout)
                    .maxRetries(maxRetries)
                    .injectRequestId(injectRequestId)
                    .build()
            val apiClient = DefaultApiClient(httpClient, transport)
            apiClient.sleeper = { sleeps.add(it) }
            apiClient.jitterSource = { jitter }
            return apiClient
        }

        private fun get(
            apiClient: DefaultApiClient,
            headers: Map<String, String> = emptyMap(),
        ): ApiHttpResponse {
            return runBlocking { apiClient.sendRequest("GET", "http://localhost/items", headers, null) }
        }

        @Test
        @DisplayName("bhvRetries038 a 503 is sent again until it succeeds")
        fun aRetryableStatusIsSentAgain() {
            val apiClient = retrying(listOf(503, 503, 200))

            val response = get(apiClient)

            assertEquals(200, response.statusCode)
            assertEquals(3, requestCount)
            assertEquals(2, sleeps.size)
        }

        @Test
        @DisplayName("bhvRetries024 the last answer is returned once the retries are spent")
        fun theLastAnswerIsReturnedWhenRetriesAreSpent() {
            val apiClient = retrying(listOf(500))

            val response = get(apiClient)

            assertEquals(500, response.statusCode)
            assertEquals(3, requestCount, "the first attempt and two retries")
        }

        @Test
        @DisplayName("bhvRetries018 maxRetries 0 sends the request once")
        fun maxRetriesZeroDisablesRetries() {
            val apiClient = retrying(listOf(503, 200), maxRetries = 0)

            val response = get(apiClient)

            assertEquals(503, response.statusCode)
            assertEquals(1, requestCount)
            assertTrue(sleeps.isEmpty())
        }

        @Test
        @DisplayName("bhvRetries014 maxRetries bounds the number of retries")
        fun maxRetriesBoundsTheNumberOfRetries() {
            val apiClient = retrying(listOf(503), maxRetries = 4)

            get(apiClient)

            assertEquals(5, requestCount)
            assertEquals(4, sleeps.size)
        }

        @Test
        @DisplayName("bhvRetries021 retries exactly 408, 409, 429 and every 5xx but 501, and no other status")
        fun retryableStatusesAreRetried() {
            for (status in listOf(408, 409, 429, 500, 502, 503, 504, 599)) {
                requestCount = 0
                get(retrying(listOf(status), maxRetries = 1))
                assertEquals(2, requestCount, "status $status must be retried once")
            }
            for (status in listOf(200, 201, 301, 400, 401, 403, 404, 422, 501)) {
                requestCount = 0
                get(retrying(listOf(status)))
                assertEquals(1, requestCount, "status $status must not be retried")
            }
        }

        @Test
        @DisplayName("bhvRetries013 a network error before a response is retried")
        fun aNetworkErrorIsRetried() {
            val apiClient = retrying(listOf(java.io.IOException("connection reset"), 200))

