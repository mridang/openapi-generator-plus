        private fun redirectThenOk(
            status: HttpStatusCode,
            seen: MutableList<io.ktor.client.request.HttpRequestData>,
        ): MockEngine =
            MockEngine { req ->
                seen.add(req)
                if (seen.size == 1) {
                    respond(content = "", status = status, headers = headersOf("Location", "http://localhost/b"))
                } else {
                    respond(content = "{}", status = HttpStatusCode.OK, headers = headersOf("Content-Type", "application/json"))
                }
            }

        @Test
