class DefaultApiClientUnitTest {

    private fun mockClient(
        statusCode: HttpStatusCode = HttpStatusCode.OK,
        body: String = "{}",
        requestCapture: ((io.ktor.client.request.HttpRequestData) -> Unit)? = null,
    ): HttpClient {
        val engine =
            MockEngine { request ->
                requestCapture?.invoke(request)
                respond(
                    content = body,
                    status = statusCode,
                    headers = headersOf("Content-Type", "application/json"),
                )
            }
        return HttpClient(engine)
    }

    @Nested
    @DisplayName("User-Agent injection")
    inner class UserAgentInjection {

        @Test
        @DisplayName("injects custom User-Agent header")
        fun injectsCustomUserAgent() {
            var capturedUserAgent: String? = null
            val client =
                mockClient(requestCapture = { req ->
                    capturedUserAgent = req.headers["User-Agent"]
                })
            val transport =
                TransportOptions
                    .builder()
                    .userAgent("MyApp/1.0")
                    .build()
            val apiClient = DefaultApiClient(client, transport)
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
            }
            assertEquals("MyApp/1.0", capturedUserAgent)
        }

        @Test
        @DisplayName("injects default User-Agent when not explicitly set")
        fun injectsDefaultUserAgent() {
            var capturedUserAgent: String? = null
            val client =
                mockClient(requestCapture = { req ->
                    capturedUserAgent = req.headers["User-Agent"]
                })
            val apiClient = DefaultApiClient(client)
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
            }
            assertNotNull(capturedUserAgent)
            assertTrue(capturedUserAgent!!.isNotEmpty())
        }
    }

    @Nested
    @DisplayName("X-Request-ID injection")
    inner class RequestIdInjection {

        @Test
        @DisplayName("injects X-Request-ID when enabled")
        fun injectsRequestId() {
            var capturedRequestId: String? = null
            val client =
                mockClient(requestCapture = { req ->
                    capturedRequestId = req.headers["X-Request-ID"]
                })
            val transport =
                TransportOptions
                    .builder()
                    .injectRequestId(true)
                    .build()
            val apiClient = DefaultApiClient(client, transport)
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
            }
            assertNotNull(capturedRequestId)
            assertTrue(
                capturedRequestId!!.matches(
                    Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"),
                ),
            )
        }

        @Test
        @DisplayName("does not inject X-Request-ID when disabled")
        fun doesNotInjectRequestIdWhenDisabled() {
            var capturedRequestId: String? = null
            val client =
                mockClient(requestCapture = { req ->
                    capturedRequestId = req.headers["X-Request-ID"]
                })
            val transport =
                TransportOptions
                    .builder()
                    .injectRequestId(false)
                    .build()
            val apiClient = DefaultApiClient(client, transport)
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
            }
            assertNull(capturedRequestId)
        }

        @Test
        @DisplayName("does not override caller-provided X-Request-ID")
        fun doesNotOverrideCallerRequestId() {
            var capturedRequestId: String? = null
            val client =
                mockClient(requestCapture = { req ->
                    capturedRequestId = req.headers["X-Request-ID"]
                })
            val transport =
                TransportOptions
                    .builder()
                    .injectRequestId(true)
                    .build()
            val apiClient = DefaultApiClient(client, transport)
            val headers = mapOf("X-Request-ID" to "caller-provided-id")
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", headers, null)
            }
            assertEquals("caller-provided-id", capturedRequestId)
        }

        @Test
        @DisplayName("generates unique X-Request-ID per request")
        fun generatesUniqueRequestIds() {
            val ids = mutableListOf<String?>()
            val client =
                mockClient(requestCapture = { req ->
                    ids.add(req.headers["X-Request-ID"])
                })
            val transport =
                TransportOptions
                    .builder()
                    .injectRequestId(true)
                    .build()
            val apiClient = DefaultApiClient(client, transport)
            runBlocking {
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
                apiClient.sendRequest("GET", "http://localhost/test", emptyMap(), null)
            }
            assertEquals(2, ids.size)
            assertNotEquals(ids[0], ids[1])
        }
    }

    @Nested
    @DisplayName("multipart filename directive")
    inner class MultipartFilenameDirective {

        @Test
        @DisplayName("non-ASCII filename emits RFC 5987 filename* parameter")
        fun multipartFilenameNonAsciiEmitsRFC5987() {
            val directive = buildFilenameDirective("日本.pdf")
            assertTrue(directive.contains("filename*=UTF-8''"),
                "non-ASCII filename must emit RFC 5987 filename*= form, got: $directive")
            assertTrue(directive.contains("%E6%97%A5%E6%9C%AC"),
                "RFC 5987 value must be percent-encoded UTF-8, got: $directive")
            assertTrue(directive.startsWith("filename=\""),
                "must still include an ASCII fallback filename=\"...\", got: $directive")
        }

        @Test
        @DisplayName("ASCII-only filename omits the filename* parameter")
        fun multipartFilenameAsciiOnlyOmitsFilenameStar() {
            val directive = buildFilenameDirective("pet.png")
            assertEquals("filename=\"pet.png\"", directive)
            assertFalse(directive.contains("filename*="),
                "ASCII-only filename must not emit filename*=, got: $directive")
        }

        @Test
        @DisplayName("CRLF/NUL in filename throws IllegalArgumentException")
        fun multipartFilenameCRLFRejected() {
            for (bad in listOf("a\rb.pdf", "a\nb.pdf", "a\r\nb.pdf", "a\u0000b.pdf")) {
                assertThrows(IllegalArgumentException::class.java) {
                    validateMultipartFilename(bad)
                }
            }
            // ASCII filename does not throw
            validateMultipartFilename("pet.png")
        }
    }

