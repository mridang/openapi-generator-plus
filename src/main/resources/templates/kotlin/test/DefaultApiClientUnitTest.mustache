            val engine = MockEngine { _ ->
                attempts++
                respond("", HttpStatusCode.ServiceUnavailable)
            }
            val started = System.nanoTime()
            assertThrows(ApiException::class.java) {
                runBlocking {
                    DefaultApiClient(HttpClient(engine) { followRedirects = false })
