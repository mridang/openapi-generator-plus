            }
            assertThrows({{invokerPackage}}.errors.NetworkException::class.java) {
                runBlocking {
                    DefaultApiClient(HttpClient(queryEngine) { followRedirects = false }, TransportOptions.builder().timeout(null).maxRetries(2).build())
                        .sendRequest("QUERY", "http://localhost/search", emptyMap(), "{}")
