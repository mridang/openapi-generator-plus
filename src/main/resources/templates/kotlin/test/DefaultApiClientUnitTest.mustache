                }
                val apiClient = DefaultApiClient(HttpClient(engine) { followRedirects = false }, TransportOptions.builder().timeout(null).maxRetries(2).build())
                assertThrows({{invokerPackage}}.errors.NetworkException::class.java) {
                    runBlocking {
