import kotlin.coroutines.cancellation.CancellationException

/**
 * Tests for OpenTelemetryCallHook. Some tests register a global OpenTelemetry instance, so the
 * class runs isolated from every other test class.
 */
@Isolated
class OpenTelemetryCallHookTest {

    private class Telemetry {
        val exporter: InMemorySpanExporter = InMemorySpanExporter.create()
        val reader: InMemoryMetricReader = InMemoryMetricReader.create()
        private val tracerProvider =
            SdkTracerProvider.builder().addSpanProcessor(SimpleSpanProcessor.create(exporter)).build()
        private val meterProvider = SdkMeterProvider.builder().registerMetricReader(reader).build()
        val sdk: OpenTelemetrySdk =
            OpenTelemetrySdk.builder()
                .setTracerProvider(tracerProvider)
                .setMeterProvider(meterProvider)
                .setPropagators(ContextPropagators.create(W3CTraceContextPropagator.getInstance()))
                .build()

        fun spans(): List<SpanData> = exporter.finishedSpanItems

        fun metrics(): Collection<MetricData> = reader.collectAllMetrics()

        fun metric(name: String): MetricData = metrics().single { it.name == name }
    }

    private class Api(client: ApiClient, hook: CallHook?) : {{apiPackage}}.BaseApi(
        client,
        Configuration.builder().baseUrl("http://localhost:8080").callHook(hook).build(),
    ) {
        suspend fun call(
            queryParams: MutableMap<String, Any?> = mutableMapOf(),
            auth: Authenticator? = null,
        ): ApiHttpResponse =
            invokeApi(
                "get", "/items/7", queryParams, mutableMapOf(), null, arrayOf("application/json"), "application/json", auth,
                operationId = "getItem", urlTemplate = "/items/{id}",
            )
    }

    private class Replying(private val status: Int, private val replyBody: String = "{}") : BaseApiTest.CapturingApiClient() {
        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean,
        ): ApiHttpResponse {
            super.sendRequest(method, url, headers, body, noRedirect)
            return ApiHttpResponse(status, replyBody, mapOf("Content-Type" to "application/json"))
        }
    }

    private class Failing(private val failure: Throwable) : ApiClient {
        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean,
        ): ApiHttpResponse = throw failure
    }

    private fun runCall(client: ApiClient, hook: CallHook): Result<ApiHttpResponse> =
        runCatching { runBlocking { Api(client, hook).call() } }

    private fun attr(span: SpanData, key: String): Any? =
        span.attributes.asMap().entries.firstOrNull { it.key.key == key }?.value

    @Test
    @DisplayName("bhvTelemetry001 the span is named with the spec operation id and has kind client")
    fun theSpanIsNamedAfterTheOperation() {
        val telemetry = Telemetry()
        runCall(Replying(200), OpenTelemetryCallHook.create(telemetry.sdk))
        val span = telemetry.spans().single()
        assertEquals("getItem", span.name)
        assertEquals(SpanKind.CLIENT, span.kind)
    }

    @Test
    @DisplayName("bhvTelemetry002 a 2xx sets the method, template, server and status attributes and leaves the span status unset")
    fun aSuccessSetsTheAttributes() {
        val telemetry = Telemetry()
        runCall(Replying(200), OpenTelemetryCallHook.create(telemetry.sdk))
        val span = telemetry.spans().single()
        assertEquals(
            mapOf(
                "http.request.method" to "GET",
                "url.template" to "/items/{id}",
                "server.address" to "localhost",
                "http.response.status_code" to 200L,
            ),
            span.attributes.asMap().mapKeys { it.key.key },
        )
        assertEquals(StatusCode.UNSET, span.status.statusCode)
    }

    @Test
    @DisplayName("bhvTelemetry003 a 4xx or 5xx sets error.type to the status code as text and marks the span as an error")
    fun anErrorStatusMarksTheSpan() {
        for (status in listOf(404, 503)) {
            val telemetry = Telemetry()
            runCall(Replying(status), OpenTelemetryCallHook.create(telemetry.sdk))
            val span = telemetry.spans().single()
            assertEquals(status.toString(), attr(span, "error.type"))
            assertEquals(status.toLong(), attr(span, "http.response.status_code"))
            assertEquals(StatusCode.ERROR, span.status.statusCode)
        }
    }

    @Test
    @DisplayName("bhvTelemetry004 error.type is timeout, network_error, serialization_error, cancelled or _OTHER by the kind of error")
    fun errorTypeNamesTheKindOfError() {
        val cause = java.io.IOException("x")
        val cases =
            mapOf<String, Throwable>(
                "timeout" to NetworkTimeoutException("t", cause),
                "network_error" to NetworkException("n", cause),
                "serialization_error" to SerializationException("s"),
                "cancelled" to CancellationException("c"),
                "_OTHER" to IllegalStateException("o"),
            )
        for ((token, failure) in cases) {
            val telemetry = Telemetry()
            runCall(Failing(failure), OpenTelemetryCallHook.create(telemetry.sdk))
            val span = telemetry.spans().single()
            assertEquals(token, attr(span, "error.type"))
            assertEquals(StatusCode.ERROR, span.status.statusCode)
        }
    }

    @Test
    @DisplayName("bhvTelemetry005 a call with no response sets no http.response.status_code")
    fun noResponseNoStatusCode() {
        val telemetry = Telemetry()
        runCall(Failing(NetworkException("n", java.io.IOException("x"))), OpenTelemetryCallHook.create(telemetry.sdk))
        assertNull(attr(telemetry.spans().single(), "http.response.status_code"))
    }

    @Test
    @DisplayName("bhvTelemetry006 the span is a child of the active span and the traceparent sent names the client span, once")
    fun theClientSpanIsAChildAndNamedInTraceparent() {
        GlobalOpenTelemetry.resetForTest()
        val telemetry = Telemetry()
        try {
            val global =
                OpenTelemetrySdk.builder()
                    .setTracerProvider(
                        SdkTracerProvider.builder().addSpanProcessor(SimpleSpanProcessor.create(telemetry.exporter)).build(),
                    ).setPropagators(ContextPropagators.create(W3CTraceContextPropagator.getInstance()))
                    .buildAndRegisterGlobal()
            val parent = global.getTracer("test").spanBuilder("parent").startSpan()
            val client = Replying(200)
            parent.makeCurrent().use {
                runCall(client, OpenTelemetryCallHook.create())
            }
            parent.end()
            val clientSpan = telemetry.spans().single { it.name == "getItem" }
            assertEquals(parent.spanContext.spanId, clientSpan.parentSpanId)
            val sent = client.capturedHeaders.filterKeys { it.equals("traceparent", ignoreCase = true) }
            assertEquals(1, sent.size)
            assertTrue(sent.values.single().contains(clientSpan.spanId), sent.toString())
        } finally {
            GlobalOpenTelemetry.resetForTest()
        }
    }

    @Test
    @DisplayName("bhvTelemetry007 a call retried by the transport records one span and one count")
    fun aRetriedCallRecordsOnce() {
        val telemetry = Telemetry()
        var sends = 0
        val engine = MockEngine {
            sends++
            respond("{}", HttpStatusCode.fromValue(if (sends < 2) 503 else 200), headersOf("Content-Type", "application/json"))
        }
        val http = HttpClient(engine) {
            followRedirects = false
            install(io.ktor.client.plugins.HttpTimeout)
        }
        val transport = DefaultApiClient(http, TransportOptions.builder().maxRetries(2).build())
        transport.sleeper = { }
        runCall(transport, OpenTelemetryCallHook.create(telemetry.sdk))
        assertEquals(2, sends)
        assertEquals(1, telemetry.spans().size)
        assertEquals(1L, telemetry.metric("http.client.request.count").longSumData.points.single().value)
    }

    @Test
    @DisplayName("bhvTelemetry008 the request count is incremented once per call with the same attributes as the span")
    fun theCountMatchesTheSpan() {
        val telemetry = Telemetry()
        runCall(Replying(404), OpenTelemetryCallHook.create(telemetry.sdk))
        val metric = telemetry.metric("http.client.request.count")
        assertEquals("{request}", metric.unit)
        val point = metric.longSumData.points.single()
        assertEquals(1L, point.value)
        assertEquals(telemetry.spans().single().attributes.asMap(), point.attributes.asMap())
    }

    @Test
    @DisplayName("bhvTelemetry009 the duration histogram records one value in seconds per call with the same attributes as the span")
    fun theDurationIsRecordedInSeconds() {
        val telemetry = Telemetry()
        val slow = object : BaseApiTest.CapturingApiClient() {
            override suspend fun sendRequest(
                method: String,
                url: String,
                headers: Map<String, String>,
                body: Any?,
                noRedirect: Boolean,
            ): ApiHttpResponse {
                kotlinx.coroutines.delay(60)
                return super.sendRequest(method, url, headers, body, noRedirect)
            }
        }
        runCall(slow, OpenTelemetryCallHook.create(telemetry.sdk))
        val metric = telemetry.metric("http.client.request.duration")
        assertEquals("s", metric.unit)
        val point = metric.histogramData.points.single()
        assertEquals(1L, point.count)
        assertTrue(point.sum >= 0.05 && point.sum < 30.0, point.sum.toString())
        assertEquals(telemetry.spans().single().attributes.asMap(), point.attributes.asMap())
    }

    @Test
    @DisplayName("bhvTelemetry010 the instrumentation scope is named after the published package and carries the SDK version")
    fun theScopeNamesThePackage() {
        val telemetry = Telemetry()
        runCall(Replying(200), OpenTelemetryCallHook.create(telemetry.sdk))
        val span = telemetry.spans().single()
        assertEquals("{{artifactId}}", span.instrumentationScopeInfo.name)
        assertEquals("{{artifactVersion}}", span.instrumentationScopeInfo.version)
        for (metric in telemetry.metrics()) {
            assertEquals("{{artifactId}}", metric.instrumentationScopeInfo.name)
            assertEquals("{{artifactVersion}}", metric.instrumentationScopeInfo.version)
        }
    }

    @Test
    @DisplayName("bhvTelemetry011 a provider handed to the adapter is used instead of the global one")
    fun aGivenProviderBeatsTheGlobalOne() {
        GlobalOpenTelemetry.resetForTest()
        val globalTelemetry = Telemetry()
        val given = Telemetry()
        try {
            GlobalOpenTelemetry.set(globalTelemetry.sdk)
            runCall(Replying(200), OpenTelemetryCallHook.create(given.sdk))
            assertEquals(1, given.spans().size)
            assertTrue(globalTelemetry.spans().isEmpty())
            runCall(Replying(200), OpenTelemetryCallHook.create())
            assertEquals(1, globalTelemetry.spans().size)
        } finally {
            GlobalOpenTelemetry.resetForTest()
        }
    }

    @Test
    @DisplayName("bhvTelemetry012 with no provider configured the adapter does nothing and the call is unchanged")
    fun withoutAProviderNothingHappens() {
        GlobalOpenTelemetry.resetForTest()
        try {
            val client = Replying(200)
            val result = runCall(client, OpenTelemetryCallHook.create())
            assertEquals(200, result.getOrThrow().statusCode)
            assertTrue(client.capturedHeaders.keys.none { it.equals("traceparent", ignoreCase = true) })
            val noop = Replying(200)
            runCall(noop, OpenTelemetryCallHook.create(OpenTelemetry.noop()))
            assertTrue(noop.capturedHeaders.keys.none { it.equals("traceparent", ignoreCase = true) })
        } finally {
            GlobalOpenTelemetry.resetForTest()
        }
    }

    @Test
    @DisplayName("bhvTelemetry013 the span ends exactly once, also when the call throws")
    fun theSpanEndsOnceEvenOnAThrow() {
        val telemetry = Telemetry()
        val result = runCall(Failing(IllegalStateException("boom")), OpenTelemetryCallHook.create(telemetry.sdk))
        assertTrue(result.isFailure)
        val spans = telemetry.spans()
        assertEquals(1, spans.size)
        assertTrue(spans.single().hasEnded())
        assertEquals(1L, telemetry.metric("http.client.request.count").longSumData.points.single().value)
    }

    @Test
    @DisplayName("bhvTelemetry014 no attribute carries a query string, a header value or a credential")
    fun noAttributeLeaksTheRequest() {
        val telemetry = Telemetry()
        val secret = BaseApiTest.TestAuthenticator(mapOf("Authorization" to "Bearer s3cr3t"), emptyMap(), emptyMap())
        runBlocking {
            Api(Replying(200), OpenTelemetryCallHook.create(telemetry.sdk))
                .call(mutableMapOf("token" to "q-secret"), secret)
        }
        val keys = mutableSetOf<String>()
        val values = mutableListOf<String>()
        for (span in telemetry.spans()) {
            span.attributes.forEach { key: AttributeKey<*>, value: Any? ->
                keys.add(key.key)
                values.add(value.toString())
            }
        }
        for (metric in telemetry.metrics()) {
            val attributes =
                metric.longSumData.points.map { it.attributes } + metric.histogramData.points.map { it.attributes }
            for (attribute in attributes) {
                attribute.forEach { key: AttributeKey<*>, value: Any? ->
                    keys.add(key.key)
                    values.add(value.toString())
                }
            }
        }
        assertEquals(
            setOf("http.request.method", "url.template", "server.address", "http.response.status_code"),
            keys,
        )
        assertTrue(values.none { it.contains("s3cr3t") || it.contains("q-secret") || it.contains("?") }, values.toString())
    }
}
