    @Nested
    @DisplayName("custom httpClient")
    inner class CustomHttpClient {

        @Test
        @DisplayName("bhvOptions058 httpClient defaults to null and is kept when set")
        fun httpClientIsKept() {
            assertNull(TransportOptions.builder().build().httpClient)
            val custom = HttpClient(MockEngine { respondOk() })
            try {
                assertSame(custom, TransportOptions.builder().httpClient(custom).build().httpClient)
            } finally {
                custom.close()
            }
        }

        @Test
        @DisplayName("bhvLifecycle024 a supplied httpClient conflicts with the SDK proxy, caCertPath and verifySsl=false settings")
        fun httpClientConflictsWithSdkTransportSettings() {
            val custom = HttpClient(MockEngine { respondOk() })
            try {
                val proxy = assertThrows(IllegalArgumentException::class.java) {
                    TransportOptions.builder().httpClient(custom).proxy("http://proxy.example.com:8080").build()
                }
                assertTrue(proxy.message!!.contains("custom httpClient"))
                assertThrows(IllegalArgumentException::class.java) {
                    TransportOptions.builder().httpClient(custom).caCertPath("/tmp/ca.pem").build()
                }
                assertThrows(IllegalArgumentException::class.java) {
                    TransportOptions.builder().httpClient(custom).verifySsl(false).build()
                }
            } finally {
                custom.close()
            }
        }
    }

    @Nested
    @DisplayName("string forms")
    inner class StringForms {

        @Test
        @DisplayName("bhvOptions023 inspect masks the proxy password and sensitive default headers")
        fun toStringMasksProxyPasswordAndSensitiveHeaders() {
            val options = TransportOptions.builder()
                .proxy("http://svc:s3cret@proxy.example.com:3128")
                .defaultHeader("Proxy-Authorization", "Basic c2VjcmV0")
                .defaultHeader("X-Trace", "visible")
                .build()

            val text = options.toString()

            assertFalse(text.contains("s3cret"), text)
            assertFalse(text.contains("c2VjcmV0"), text)
            assertTrue(text.contains("proxy=http://***@proxy.example.com:3128"), text)
            assertTrue(text.contains("Proxy-Authorization=***"), text)
            assertTrue(text.contains("X-Trace=visible"), text)
        }
    }
}
