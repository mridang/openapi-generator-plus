    @Nested
    @DisplayName("redirect defaults")
    inner class RedirectDefaults {

        @Test
        @DisplayName("bhvOptions021 followRedirects defaults to true with null maxRedirects")
        fun followRedirectsDefaultsToTrueWithNullMaxRedirects() {
            val opts = TransportOptions.builder()
                .followRedirects(true)
                .build()

            assertTrue(opts.followRedirects)
            assertNull(opts.maxRedirects)
        }
    }

    @Nested
    @DisplayName("setting all fields")
    inner class SettingAllFields {

        @Test
        @DisplayName("bhvOptions017 builder sets all fields")
        fun builderSetsAllFields() {
            val opts = TransportOptions.builder()
                .verifySsl(false)
                .caCertPath("/path/to/ca.pem")
                .proxy("http://proxy:8080")
                .timeout(5000L)
                .followRedirects(false)
                .maxRedirects(3)
                .userAgent("TestAgent/1.0")
                .defaultHeader("X-Custom", "value")
                .injectRequestId(true)
                .build()

            assertFalse(opts.verifySsl)
            assertEquals("/path/to/ca.pem", opts.caCertPath)
            assertEquals("http://proxy:8080", opts.proxy)
            assertEquals(5000L, opts.timeout)
            assertFalse(opts.followRedirects)
            assertEquals(3, opts.maxRedirects)
            assertEquals("TestAgent/1.0", opts.userAgent)
            assertEquals(mapOf("X-Custom" to "value"), opts.defaultHeaders)
            assertTrue(opts.injectRequestId)
        }
    }

    @Nested
    @DisplayName("proxy validation")
    inner class ProxyValidation {

        @Test
        @DisplayName("bhvOptions024 invalid proxy URL throws exception")
        fun invalidProxyUrlThrowsException() {
            val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                TransportOptions.builder().proxy("not a valid url ^%$").build()
            }
            // A bad proxy URL is a configuration mistake, not an SDK error.
            assertFalse({{errorPrefix}}Exception::class.java.isInstance(ex))
        }

        @Test
        @DisplayName("bhvOptions013 an invalid proxy URL is accepted by the setter and rejected by build")
        fun invalidProxyUrlIsRejectedAtBuildNotInSetter() {
            val builder = TransportOptions.builder().proxy("proxy:3128")
            assertThrowsExactly(IllegalArgumentException::class.java) { builder.build() }
        }

        @Test
        @DisplayName("proxy scheme is matched case insensitively")
        fun proxySchemeIsMatchedCaseInsensitively() {
            assertEquals("http://proxy:3128", TransportOptions.builder().proxy("HTTP://proxy:3128").build().proxy)
            assertEquals("https://proxy:3128", TransportOptions.builder().proxy("Https://proxy:3128").build().proxy)
        }

        @Test
        @DisplayName("bhvOptions014 an upper-case non-http proxy scheme is still rejected")
        fun upperCaseNonHttpProxySchemeIsRejected() {
            val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                TransportOptions.builder().proxy("FTP://proxy:3128").build()
            }
            assertEquals("Invalid proxy URL (must use http or https scheme): FTP://proxy:3128", ex.message)
        }

        @Test
        @DisplayName("bhvOptions011 a proxy URL with no host is rejected")
        fun proxyUrlWithoutHostIsRejected() {
            for (proxy in listOf("http://@:3128", "http://user:pw@:3128", "http://:3128", "http://[]:3128", "http://")) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().proxy(proxy).build()
                }
                assertEquals("Invalid proxy URL (missing host): " + proxy.replace("user:pw@", "***@"), ex.message)
            }
        }

        @Test
        @DisplayName("bhvOptions008 a proxy URL error never carries the user-info")
        fun proxyUrlErrorMasksTheUserInfo() {
            val cases = mapOf(
                "socks5://svc:s3cret@proxy:1080" to "Invalid proxy URL (must use http or https scheme): socks5://***@proxy:1080",
                "svc:s3cret@proxy:3128" to "Invalid proxy URL (missing scheme): ***@proxy:3128",
                "http://svc:s3cret@[::1:3128" to "Invalid proxy URL (unterminated IPv6 literal): http://***@[::1:3128",
                "http://svc:s3cret@:3128" to "Invalid proxy URL (missing host): http://***@:3128",
            )
            for ((proxy, expected) in cases) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().proxy(proxy).build()
                }
                assertEquals(expected, ex.message)
                assertFalse(ex.message.orEmpty().contains("s3cret"))
            }
        }

        @Test
        @DisplayName("bhvOptions033 a non-positive timeout is rejected with the canonical message")
        fun nonPositiveTimeoutIsRejected() {
            for (invalid in listOf(-1L, 0L)) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().timeout(invalid)
                }
                assertEquals("Invalid timeout: must be a positive number of milliseconds (got $invalid)", ex.message)
            }
            assertNull(TransportOptions.builder().timeout(null).build().timeout)
        }

        @Test
        @DisplayName("bhvOptions047 a negative timeout is rejected at configuration")
        fun negativeTimeoutIsRejectedAtConfiguration() {
            val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                TransportOptions.builder().timeout(-1L)
            }
            assertEquals("Invalid timeout: must be a positive number of milliseconds (got -1)", ex.message)
        }

        @Test
        @DisplayName("bhvOptions045 a negative maxRedirects is rejected and zero is accepted")
        fun negativeMaxRedirectsIsRejected() {
            val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                TransportOptions.builder().maxRedirects(-1)
            }
            assertEquals("Invalid maxRedirects: must not be negative (got -1)", ex.message)
            assertEquals(0, TransportOptions.builder().maxRedirects(0).build().maxRedirects)
        }

        @Test
        @DisplayName("bhvOptions007 a negative maxRetries is rejected and zero turns retries off")
        fun negativeMaxRetriesIsRejected() {
            val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                TransportOptions.builder().maxRetries(-1)
            }
            assertEquals("Invalid maxRetries: must not be negative (got -1)", ex.message)
            assertEquals(0, TransportOptions.builder().maxRetries(0).build().maxRetries)
            assertEquals(5, TransportOptions.builder().maxRetries(5).build().maxRetries)
        }

        @Test
        @DisplayName("bhvOptions010 a proxy URL with an unterminated IPv6 literal is rejected")
        fun proxyUrlWithAnUnterminatedIpv6LiteralIsRejected() {
            for (proxy in listOf("http://[::1:3128", "http://user@[::1:3128")) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().proxy(proxy).build()
                }
                assertEquals("Invalid proxy URL (unterminated IPv6 literal): ${proxy.replace("user@", "***@")}", ex.message)
            }
        }

        @Test
        @DisplayName("bhvOptions009 a proxy URL with user-info, an IPv6 literal or a path is accepted")
        fun proxyUrlWithHostIsAccepted() {
            for (proxy in listOf("http://user:pw@proxy:3128", "http://user@proxy", "http://[::1]:3128", "http://proxy:3128/path?q=1")) {
                assertEquals(proxy, TransportOptions.builder().proxy(proxy).build().proxy)
            }
        }

        @Test
        @DisplayName("bhvOptions030 null proxy URL is accepted")
        fun nullProxyUrlIsAccepted() {
            val opts = TransportOptions.builder().proxy(null).build()
            assertNull(opts.proxy)
        }

        @Test
        @DisplayName("bhvOptions051 a proxy URL with a scheme other than http or https is rejected with its message")
        fun nonHttpProxySchemeIsRejected() {
            for (proxy in listOf("ftp://proxy:21", "socks5://proxy:1080")) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().proxy(proxy).build()
                }
                assertEquals("Invalid proxy URL (must use http or https scheme): $proxy", ex.message)
            }
        }

        @Test
        @DisplayName("bhvOptions044 the README names the builder proxy setter in its SOCKS section")
        fun readmeNamesTheBuilderProxySetter() {
            val readme = java.io.File("README.md").readText()
            assertTrue(
                readme.contains("`TransportOptions.builder().proxy(...)` accepts only `http://` and `https://` URLs.")
            )
            assertFalse(readme.contains("`TransportOptions.proxy()`"))
        }

        @Test
        @DisplayName("bhvOptions031 an empty or scheme-less proxy URL is rejected with its message")
        fun schemelessProxyUrlIsRejected() {
            for (proxy in listOf("", "proxy:3128", "not a valid url ^%$")) {
                val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                    TransportOptions.builder().proxy(proxy).build()
                }
                assertEquals("Invalid proxy URL (missing scheme): $proxy", ex.message)
            }
        }
    }

    @Nested
    @DisplayName("builder chaining")
    inner class BuilderChaining {

        @Test
        @DisplayName("bhvOptions015 builder methods return the same builder instance")
        fun builderMethodsReturnSameInstance() {
            val builder = TransportOptions.builder()

            assertSame(builder, builder.verifySsl(true))
            assertSame(builder, builder.caCertPath(null))
            assertSame(builder, builder.proxy(null))
            assertSame(builder, builder.timeout(null))
            assertSame(builder, builder.followRedirects(true))
            assertSame(builder, builder.maxRedirects(null))
            assertSame(builder, builder.userAgent(null))
            assertSame(builder, builder.defaultHeader("X-Key", "val"))
            assertSame(builder, builder.defaultHeaders(emptyMap()))
            assertSame(builder, builder.injectRequestId(false))
            assertSame(builder, builder.maxRetries(2))
        }
    }

    @Nested
    @DisplayName("multiple default headers")
    inner class MultipleDefaultHeaders {

        @Test
        @DisplayName("bhvOptions012 accumulates headers from defaultHeader calls")
        fun accumulatesHeadersFromDefaultHeaderCalls() {
            val opts = TransportOptions.builder()
                .defaultHeader("X-First", "one")
                .defaultHeader("X-Second", "two")
                .build()
            assertEquals(2, opts.defaultHeaders.size)
            assertEquals("one", opts.defaultHeaders["X-First"])
            assertEquals("two", opts.defaultHeaders["X-Second"])
        }

        @Test
        @DisplayName("bhvOptions028 merges headers from defaultHeaders call")
        fun mergesHeadersFromDefaultHeadersCall() {
            val opts = TransportOptions.builder()
                .defaultHeader("X-First", "one")
                .defaultHeaders(mapOf("X-Second" to "two", "X-Third" to "three"))
                .build()
            assertEquals(3, opts.defaultHeaders.size)
            assertEquals("one", opts.defaultHeaders["X-First"])
            assertEquals("two", opts.defaultHeaders["X-Second"])
            assertEquals("three", opts.defaultHeaders["X-Third"])
        }
    }

    @Nested
    @DisplayName("copy isolation")
    inner class CopyIsolation {

        @Test
        @DisplayName("bhvOptions029 modifying source map does not affect built options")
        fun modifyingSourceMapDoesNotAffectBuiltOptions() {
            val headers = mutableMapOf("X-Original" to "original")
            val opts = TransportOptions.builder()
                .defaultHeaders(headers)
                .build()

            headers["X-Added"] = "added"

            assertEquals(1, opts.defaultHeaders.size)
            assertEquals("original", opts.defaultHeaders["X-Original"])
            assertNull(opts.defaultHeaders["X-Added"])
        }

        @Test
        @DisplayName("bhvOptions016 builder produces independent instances")
        fun builderProducesIndependentInstances() {
            val builder = TransportOptions.builder().verifySsl(false)
            val first = builder.build()
            val second = builder.build()

            assertEquals(first.verifySsl, second.verifySsl)
            assertNotSame(first, second)
        }
    }

