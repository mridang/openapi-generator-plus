package {{invokerPackage}}

import {{invokerPackage}}.errors.{{errorPrefix}}Exception
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.DisplayName
import org.junit.jupiter.api.Test

class ServerConfigurationTest {

    @Test
    @DisplayName("bhvServers028 the generated server list cannot be changed after creation")
    fun generatedServerListCannotBeChanged() {
        val servers = Servers.ALL
        assertThrows(UnsupportedOperationException::class.java) {
            (servers as MutableList<ServerConfiguration>).add(servers[0])
        }
    }

    @Test
    @DisplayName("bhvServers010 getUrl substitutes variable defaults into the URL template")
    fun getUrlUsesVariableDefaults() {
        val server = ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            "Test server",
            mapOf(
                "env" to ServerVariable("api", null, listOf("api", "staging")),
                "version" to ServerVariable("v3", null, listOf("v2", "v3"))
            )
        )
        assertEquals("https://api.example.com/api/v3", server.getUrl())
    }

    @Test
    @DisplayName("bhvServers009 getUrl applies overrides over defaults")
    fun getUrlAppliesOverrides() {
        val server = ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            null,
            mapOf(
                "env" to ServerVariable("api", null, listOf("api", "staging")),
                "version" to ServerVariable("v3", null, listOf("v2", "v3"))
            )
        )
        assertEquals(
            "https://staging.example.com/api/v2",
            server.getUrl(mapOf("env" to "staging", "version" to "v2"))
        )
    }

    @Test
    @DisplayName("bhvServers005 getUrl does not expand a placeholder that a substituted value introduces")
    fun getUrlDoesNotReExpandSubstitutedPlaceholders() {
        val variables = listOf(
            mapOf(
                "env" to ServerVariable("{version}"),
                "version" to ServerVariable("v2")
            ),
            mapOf(
                "version" to ServerVariable("v2"),
                "env" to ServerVariable("{version}")
            )
        )
        for (declared in variables) {
            val server = ServerConfiguration("https://{env}.api.example.com/{version}", null, declared)
            assertEquals("https://{version}.api.example.com/v2", server.getUrl())
        }
    }

    @Test
    @DisplayName("bhvServers013 the third global server keeps its hostile text unchanged")
    fun theThirdGlobalServerKeepsItsHostileTextUnchanged() {
        val server = Servers.SERVER_2

        assertEquals("https://{tenant}.example.com/api", server.urlTemplate)
        assertEquals("Bob's \"sandbox\" & co: \$5 #{x} a*/b", server.description)
        val tenant = server.variables.getValue("tenant")
        assertEquals("o'neil", tenant.defaultValue)
        assertEquals("Tenant's \"id\"", tenant.description)
        assertEquals(listOf("o'neil", "a&b"), tenant.enumValues)
        assertEquals("https://o'neil.example.com/api", server.getUrl())
    }

    @Test
    @DisplayName("bhvServers011 getUrl with no variables returns the template verbatim")
    fun getUrlWithoutVariables() {
        val server = ServerConfiguration("https://api.example.com", null, emptyMap())
        assertEquals("https://api.example.com", server.getUrl())
    }

    @Test
    @DisplayName("bhvServers008 getUrl rejects a value outside the variable enum")
    fun getUrlRejectsInvalidEnumValue() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("api", null, listOf("api", "staging")))
        )
        val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
            server.getUrl(mapOf("env" to "invalid"))
        }
        // A server variable outside its enum is a caller mistake, not an SDK error.
        assertFalse({{errorPrefix}}Exception::class.java.isInstance(ex))
        assertTrue(ex.message!!.contains("Invalid value"))
    }

    @Test
    @DisplayName("bhvServers003 getUrl accepts an override that is within the enum")
    fun getUrlAcceptsValidEnumValue() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("api", null, listOf("api", "staging")))
        )
        assertEquals(
            "https://staging.example.com",
            server.getUrl(mapOf("env" to "staging"))
        )
    }

    @Test
    @DisplayName("bhvServers007 getUrl leaves an unknown placeholder in the template untouched")
    fun getUrlLeavesAnUnknownPlaceholderUntouched() {
        val server = ServerConfiguration(
            "https://{tenant}.example.com/{unknown}",
            null,
            mapOf("tenant" to ServerVariable("acme", null, emptyList()))
        )
        assertEquals("https://acme.example.com/{unknown}", server.getUrl())
    }

    @Test
    @DisplayName("bhvServers014 getUrl applies a free-form variable with no enum constraint")
    fun getUrlAcceptsUnconstrainedVariable() {
        val server = ServerConfiguration(
            "https://{tenant}.example.com",
            null,
            mapOf("tenant" to ServerVariable("acme", null, emptyList()))
        )
        assertEquals(
            "https://anything.example.com",
            server.getUrl(mapOf("tenant" to "anything"))
        )
    }

    @Test
    @DisplayName("bhvServers012 the enum rejection message names the value, the variable and the allowed values")
    fun getUrlRejectionMessageIsExact() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("api", null, listOf("api", "staging")))
        )
        val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
            server.getUrl(mapOf("env" to "dev"))
        }
        assertEquals("Invalid value 'dev' for server variable 'env'. Allowed values: [api, staging]", ex.message)
    }

    @Test
    @DisplayName("bhvServers004 a default outside the enum is rejected when no override is given")
    fun getUrlRejectsADefaultOutsideTheEnum() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("prod", null, listOf("api", "staging")))
        )
        val ex = assertThrowsExactly(IllegalArgumentException::class.java) { server.getUrl() }
        assertEquals("Invalid value 'prod' for server variable 'env'. Allowed values: [api, staging]", ex.message)
    }

    @Test
    @DisplayName("bhvServers001 a partial override keeps the other variables at their defaults")
    fun getUrlPartialOverrideKeepsOtherDefaults() {
        val server = ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            null,
            mapOf(
                "env" to ServerVariable("api", null, listOf("api", "staging")),
                "version" to ServerVariable("v3", null, listOf("v2", "v3"))
            )
        )
        assertEquals("https://staging.example.com/api/v3", server.getUrl(mapOf("env" to "staging")))
    }

    @Test
    @DisplayName("bhvServers002 a variable that appears twice in the template is replaced everywhere")
    fun getUrlReplacesEveryOccurrenceOfAVariable() {
        val server = ServerConfiguration(
            "https://{region}.example.com/{region}",
            null,
            mapOf("region" to ServerVariable("eu", null, emptyList()))
        )
        assertEquals("https://us.example.com/us", server.getUrl(mapOf("region" to "us")))
    }

    @Test
    @DisplayName("bhvServers006 the raw template, the description and the variables are exposed")
    fun exposesTemplateDescriptionAndVariables() {
        val variable = ServerVariable("api", "the environment", listOf("api"))
        val server = ServerConfiguration("https://{env}.example.com", "Production", mapOf("env" to variable))
        assertEquals("https://{env}.example.com", server.urlTemplate)
        assertEquals("Production", server.description)
        assertEquals(mapOf("env" to variable), server.variables)
    }

    @Test
    @DisplayName("bhvServers025 the variables map is a copy: later changes to the source map do not leak in")
    fun variablesAreCopiedAtConstruction() {
        val source = mutableMapOf("env" to ServerVariable("api", null, emptyList()))
        val server = ServerConfiguration("https://{env}.example.com", null, source)
        source["env"] = ServerVariable("changed", null, emptyList())
        assertEquals("https://api.example.com", server.getUrl())
    }

    @Test
    @DisplayName("bhvServers021 a server URL with special characters in its default and enum values resolves to the raw characters")
    fun specialCharactersInDefaultAndEnumValuesResolveRaw() {
        val server = ServerConfiguration(
            "https://{host}.example.com/{path}",
            null,
            mapOf(
                "host" to ServerVariable("a b&c", null, listOf("a b&c", "d?e#f")),
                "path" to ServerVariable("x'y(z)", null, emptyList())
            )
        )
        assertEquals("https://a b&c.example.com/x'y(z)", server.getUrl())
        assertEquals("https://d?e#f.example.com/x'y(z)", server.getUrl(mapOf("host" to "d?e#f")))
    }

    @Test
    @DisplayName("bhvServers023 a server variable value containing replacement patterns is substituted literally")
    fun replacementPatternsInValueAreSubstitutedLiterally() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("x", null, emptyList()))
        )
        val value = "$&-$1-\${name}-\\0"
        assertEquals("https://$value.example.com", server.getUrl(mapOf("env" to value)))
    }


    @Test
    fun bhvMisc278TemplatedServerUrlResolvesToEachVariableDefault() = runBlocking<Unit> {
        val server = ServerConfiguration(
            "https://{env}.example.com/api/{version}",
            null,
            mapOf(
                "env" to ServerVariable("api", null, listOf("api", "staging")),
                "version" to ServerVariable("v3", null, listOf("v2", "v3")),
            ),
        )
        assertEquals("https://api.example.com/api/v3", server.getUrl())
    }

    @Test
    @DisplayName("bhvMisc154 editing the variables map returned by a server configuration's accessor does not change the configuration")
    fun bhvMisc154EditingTheVariablesMapLeavesTheConfigurationUnchanged() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("api", null, emptyList())),
        )
        val view = server.variables as MutableMap<String, ServerVariable>
        view["env"] = ServerVariable("changed", null, emptyList())
        assertEquals("https://api.example.com", server.getUrl())
    }

    @Test
    @DisplayName("bhvMisc155 resolving a server URL with an enum server variable left unset is refused, naming the variable and its allowed values")
    fun bhvMisc155AnUnsetEnumVariableIsRefusedNamingItsValues() {
        val server = ServerConfiguration(
            "https://{env}.example.com",
            null,
            mapOf("env" to ServerVariable("qa", null, listOf("prod", "staging"))),
        )
        val ex = assertThrowsExactly(IllegalArgumentException::class.java) { server.getUrl() }
        assertTrue(ex.message!!.contains("'env'"), ex.message)
        assertTrue(ex.message!!.contains("[prod, staging]"), ex.message)
    }

    @Test
    @DisplayName("bhvMisc156 the list of all generated servers keeps the order in which they are declared")
    fun bhvMisc156TheListOfAllServersKeepsTheDeclaredOrder() {
        val declared = mutableListOf<ServerConfiguration>()
        while (true) {
            val getter = try {
                Servers::class.java.getMethod("getSERVER_${declared.size}")
            } catch (absent: NoSuchMethodException) {
                break
            }
            declared.add(getter.invoke(Servers) as ServerConfiguration)
        }
        assertEquals(declared, Servers.ALL)
    }

    @Test
    @DisplayName("bhvMisc157 a server built with explicit variable values resolves them into its URL")
    fun bhvMisc157ExplicitVariableValuesResolveIntoUrl() {
        val server = ServerConfiguration(
            urlTemplate = "https://{host}.example.com/v1",
            variables = mapOf("host" to ServerVariable(defaultValue = "api")),
        )
        assertEquals("https://eu.example.com/v1", server.getUrl(mapOf("host" to "eu")))
    }

    @Test
    @DisplayName("bhvMisc158 a server built with a fixed URL reports exactly that URL")
    fun bhvMisc158FixedUrlIsReportedUnchanged() {
        assertEquals("https://api.example.com/v1", ServerConfiguration(urlTemplate = "https://api.example.com/v1").getUrl())
    }


    @Test
    fun bhvMisc297TemplateVariablesAreReplacedWhenTheUrlIsBuilt() = runBlocking<Unit> {
