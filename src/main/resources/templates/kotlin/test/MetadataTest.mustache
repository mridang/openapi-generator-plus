class MetadataTest {

    private val json = Json {
        ignoreUnknownKeys = true
        encodeDefaults = false
        isLenient = true
        coerceInputValues = true
    }

    @Test
    @DisplayName("bhvModels008 serialize Metadata without contextual fields")
    fun testSerialize() {
        val metadata = Metadata()

        val jsonString = json.encodeToString(metadata)

        assertNotNull(jsonString)
    }

    @Test
    @DisplayName("bhvModels003 deserialize empty object")
    fun testDeserializeEmptyObject() {
        val jsonString = "{}"

        val metadata = json.decodeFromString<Metadata>(jsonString)

        assertNotNull(metadata)
    }

    @Test
    @DisplayName("additional properties are preserved")
    fun testAdditionalProperties() {
        val metadata = Metadata()
        metadata.additionalProperties["customField"] = "hello"
        metadata.additionalProperties["anotherField"] = "world"

        assertEquals("hello", metadata.additionalProperties["customField"])
        assertEquals("world", metadata.additionalProperties["anotherField"])
        assertEquals(2, metadata.additionalProperties.size)
    }

    @Test
    fun bhvModels012ToStringDumpsTheFieldsAndTheAdditionalPropertiesMap() {
        val metadata = Metadata()
        metadata.additionalProperties["customField"] = "hello"
        assertEquals("Metadata(createdAt=null, additionalProperties={customField=hello})", metadata.toString())
    }

    @Test
    @DisplayName("the additionalProperties bucket can be supplied at construction and copy() carries it")
    fun testAdditionalPropertiesConstructorParameterAndCopy() {
        val metadata = Metadata(additionalProperties = mutableMapOf<String, Any?>("k" to "v"))
        assertEquals("v", metadata.additionalProperties["k"])

        val copied = metadata.copy(createdAt = null)
        assertEquals("v", copied.additionalProperties["k"])
        assertEquals(metadata, copied)
    }

    @Test
    @DisplayName("bhvModels005 equals and hashCode include the additionalProperties bucket")
    fun testEqualsIncludesAdditionalProperties() {
        // The overflow bucket is a @Transient property in the class body, which
        // Kotlin's synthesized data-class equals/hashCode would exclude. Two
        // instances differing ONLY in their extra keys must compare unequal.
        val a = Metadata()
        a.additionalProperties["k"] = "v1"
        val b = Metadata()
        b.additionalProperties["k"] = "v2"
        assertNotEquals(a, b)

        val c = Metadata()
        c.additionalProperties["k"] = "v1"
        assertEquals(a, c)
        assertEquals(a.hashCode(), c.hashCode())
    }

    @Test
    @DisplayName("toString includes the additionalProperties bucket and its entries")
    fun testToStringIncludesAdditionalProperties() {
        val metadata = Metadata()
        metadata.additionalProperties["x"] = 1

        val text = metadata.toString()

        assertTrue(text.contains("additionalProperties={x=1}"), text)
    }

    @Test
    @DisplayName("bhvModels024 default values are null")
    fun testDefaultValues() {
        val metadata = Metadata()

        assertNull(metadata.createdAt)
    }

    @Test
    @DisplayName("bhvModels011 round-trip without contextual fields")
    fun testRoundTrip() {
        val original = Metadata()

        val jsonString = json.encodeToString(original)
        val deserialized = json.decodeFromString<Metadata>(jsonString)

        assertNotNull(deserialized)
        assertEquals(original.createdAt, deserialized.createdAt)
    }

    @Test
    @DisplayName("bhvModels004 deserializes additional string properties")
    fun testDeserializesAdditionalStringProperties() {
        val serializer = ObjectSerializer()

        val decoded = serializer.deserialize<Metadata>("{\"customField\":\"hello\"}")

        assertNotNull(decoded)
        assertEquals("hello", decoded!!.additionalProperties["customField"])
    }

    @Test
    @DisplayName("bhvModels009 additional property values come back as strings")
    fun testAdditionalPropertiesAreTypedAsString() {
        val serializer = ObjectSerializer()
        val original = Metadata()
        original.additionalProperties["key"] = "value"

        val decoded = serializer.deserialize<Metadata>(serializer.serialize(original))

        assertNotNull(decoded)
        assertInstanceOf(String::class.java, decoded!!.additionalProperties["key"])
        assertEquals("value", decoded.additionalProperties["key"])
    }

    @Test
    @DisplayName("bhvModels010 a declared property wins over a colliding additional property")
    fun testDeclaredPropertyWinsOverCollidingAdditionalProperty() {
        val serializer = ObjectSerializer()
        val metadata = Metadata(createdAt = OffsetDateTime.parse("2024-01-01T00:00:00Z"))
        metadata.additionalProperties["createdAt"] = "x"

        val encoded = serializer.serialize(metadata)

        assertEquals(1, Regex("\"createdAt\"").findAll(encoded).count(), encoded)
        assertFalse(encoded.contains("\"x\""), encoded)
    }

    @Test
    @DisplayName("bhvModels001 additional properties survive a full ObjectSerializer round-trip")
    fun testAdditionalPropertiesRoundTripThroughObjectSerializer() {
        // The on-the-wire round-trip must preserve free-form extras: the SDK's
        // ObjectSerializer (not a bare kotlinx Json) writes additionalProperties
        // out on serialize and re-collects undeclared JSON keys on deserialize.
        // The model's additionalProperties map is @Transient, so a plain Json
        // would drop them in both directions; this asserts the SDK does not.
        val serializer = ObjectSerializer()
        val original = Metadata()
        original.additionalProperties["customField"] = "hello"
        original.additionalProperties["count"] = 42L

        val encoded = serializer.serialize(original)
        // Extras must appear as real top-level JSON members, not a toString().
        assertTrue(encoded.contains("\"customField\""), "extra key must be on the wire: $encoded")
        assertTrue(encoded.contains("\"hello\""), "extra value must be on the wire: $encoded")

        val decoded = serializer.deserialize<Metadata>(encoded)
        assertNotNull(decoded)
        assertEquals("hello", decoded!!.additionalProperties["customField"])
        assertEquals(42L, decoded.additionalProperties["count"])
    }

    @Test
    @DisplayName("bhvModels002 manifest-description-missing: build.gradle.kts publishes a non-empty POM description")
    fun testBuildManifestHasDescription() {
        // The Maven POM produced for the published artifact must carry a
        // non-empty <description>, wired from the OpenAPI document's
        // description (or a generated fallback). Gradle runs tests with the
        // project root as the working directory.
        val buildFile = java.io.File("build.gradle.kts")
        assertTrue(buildFile.exists(), "build.gradle.kts must exist at the project root")
        val contents = buildFile.readText()
        val match = Regex("""description\.set\(\s*"((?:[^"\\]|\\.)*)"""").find(contents)
        assertNotNull(match, "build.gradle.kts must set a POM description")
        assertTrue(
            match!!.groupValues[1].isNotBlank(),
            "POM description must not be empty",
        )
    }

    @Test
    @DisplayName("bhvOperations032 deprecated operations and schemas carry the Kotlin @Deprecated marker")
    fun bhvOperations032DeprecationMarkersAreEmitted() {
        // F1155: reflection, so the test itself does not call a deprecated member.
        val api = Class.forName("{{apiPackage}}.PetApi")
        for (name in listOf("findPetsByStatus", "getPetById")) {
            val methods = api.declaredMethods.filter { it.name == name || it.name.startsWith("$name-") }
            assertTrue(methods.isNotEmpty(), "PetApi.$name must exist")
            assertTrue(methods.all { it.isAnnotationPresent(Deprecated::class.java) }, "PetApi.$name must be @Deprecated")
        }
        assertTrue(
            Class.forName("{{modelPackage}}.Tag").isAnnotationPresent(Deprecated::class.java),
            "the deprecated Tag schema must be @Deprecated",
        )
    }

    @Test
    @DisplayName("bhvOperations033 deprecation markers sit on every variant of a deprecated operation")
    fun bhvOperations033DeprecationMarkersSitOnEveryVariant() {
        // F1155: reflection, so the test itself does not call a deprecated member.
        val api = Class.forName("{{apiPackage}}.PetApi")
        for (name in listOf("findPetsByStatus", "getPetById")) {
            // The compiler's default-argument bridge (name$default) is synthetic and carries no source annotation.
            val variants = api.declaredMethods.filter { it.name.startsWith("${name}WithHttpInfo") && !it.isSynthetic }
            assertTrue(variants.isNotEmpty(), "PetApi.${name}WithHttpInfo must exist")
            assertTrue(
                variants.all { it.isAnnotationPresent(Deprecated::class.java) },
                "every variant of PetApi.$name must be @Deprecated",
            )
        }
    }

    @Test
    @DisplayName("bhvModels006 file header prints the info description without backslash-escaped quotes")
    fun testFileHeaderDescriptionIsUnescaped() {
        // F1156: the header comment of every generated source file renders the
        // info description; a quote must not reach it as a backslash-quote.
        val headers = java.io.File("src").walkTopDown()
            .filter { it.isFile && it.extension == "kt" }
            .map { file -> file.useLines { lines -> lines.take(3).toList() } }
            .filter { it.isNotEmpty() && it[0].startsWith("// ") }
            .toList()
        assertTrue(headers.isNotEmpty(), "generated sources must start with the header comment")
        for (header in headers) {
            for (line in header) {
                assertFalse(line.contains("\\\""), "header line must not contain a backslash-escaped quote: $line")
            }
        }
    }

    @Test
    @DisplayName("build.gradle.kts compiles, runs and lints the hand-written spec directory")
    fun testSpecDirectoryIsCompiledRunAndLinted() {
        assertTrue(java.io.File("src/spec/kotlin").isDirectory, "src/spec/kotlin must exist")
        val manifest = java.io.File("build.gradle.kts").readText()
        val testSources = Regex("""val jvmTest by getting \{\s*kotlin\.srcDirs\(([^)]*)\)""").find(manifest)
        assertNotNull(testSources, "build.gradle.kts must declare the jvmTest source directories")
        assertEquals(
            listOf("\"src/test/kotlin\"", "\"src/spec/kotlin\""),
            testSources!!.groupValues[1].split(",").map { it.trim() },
        )
        val lintSources = Regex("""detekt \{[^}]*source\.setFrom\(files\(([^)]*)\)\)""").find(manifest)
        assertNotNull(lintSources, "build.gradle.kts must declare the detekt sources")
        assertTrue(
            lintSources!!.groupValues[1].split(",").map { it.trim() }.contains("\"src/spec/kotlin\""),
            "detekt must lint src/spec/kotlin, got ${lintSources.groupValues[1]}",
        )
    }

    @Test
    @DisplayName("dev-dependency-drift: build.gradle.kts declares every dependency the generated tests need")
    fun testDeclaredDevDependenciesAreInTheProjectManifest() {
        // A generated test may import a package that only the generator knows
        // about, and every real client keep-lists its own build.gradle.kts, so
        // the two silently drift apart and the suite dies at compile time with
        // an unresolved import. The generator-owned manifest lists what the
        // generated tests need; this fails first, naming the file.
        val declared = java.io.File(".openapi-generator/DEV-DEPENDENCIES")
        assertTrue(
            declared.exists(),
            ".openapi-generator/DEV-DEPENDENCIES must exist at the project root",
        )
        val manifest = java.io.File("build.gradle.kts").readText()
        declared.readLines().map { it.trim() }.filter { it.isNotEmpty() }.forEach { entry ->
            val coordinate = entry.substringBefore(' ')
            assertTrue(
                manifest.contains("$coordinate:"),
                "build.gradle.kts does not declare $coordinate, which " +
                    ".openapi-generator/DEV-DEPENDENCIES lists as required by the generated " +
                    "tests. Add it to the jvmTest source set; the generator cannot edit a " +
                    "keep-listed manifest.",
            )
        }
    }

    @Test
    @DisplayName("bhvModels007 example-doc-null-pollution: generated models never emit a literal `Example: null` doc line")
    fun testNoNullExampleDocPollution() {
        // L1 regression: OpenAPI Generator supplies the literal string "null" as
        // a property's example when the spec declares none, and that string is
        // truthy in Mustache — so a bare example section would stamp a false
        // `Example: null` doc line onto nearly every property. The shared codegen
        // now nulls such a placeholder example, so the template's example section
        // is falsy and emits nothing for it. Scan every generated model source and
        // assert none contains the false doc text. Gradle runs tests with the
        // project root as the working directory.
        val modelPackagePath = "{{modelPackage}}".replace('.', '/')
        val modelDir = java.io.File("src/main/kotlin/$modelPackagePath")
        assertTrue(modelDir.isDirectory, "generated model directory must exist: ${modelDir.path}")
        val kotlinFiles = modelDir.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
        assertTrue(kotlinFiles.isNotEmpty(), "expected at least one generated model file")
        val offenders = kotlinFiles.filter { it.readText().contains("Example: `null`") }
        assertTrue(
            offenders.isEmpty(),
            "no generated model may carry a false `Example: null` doc line, found in: " +
                offenders.joinToString(", ") { it.name },
        )
    }

    @Test
    @DisplayName("generated sources carry spec prose raw, never HTML-escaped")
    fun testNoHtmlEntitiesInGeneratedSources() {
        val sourceDir = java.io.File("src/main/kotlin")
        assertTrue(sourceDir.isDirectory, "generated source directory must exist")
        val entity = Regex("&(?:[A-Za-z]+|#[0-9]+|#[xX][0-9A-Fa-f]+);")
        val offenders =
            sourceDir.walkTopDown()
                .filter { it.isFile && it.extension == "kt" }
                .flatMap { file -> file.readLines().filter { entity.containsMatchIn(it) }.map { "${file.name}: ${it.trim()}" } }
                .toList()
        assertEquals(emptyList<String>(), offenders)
    }

    @Test
