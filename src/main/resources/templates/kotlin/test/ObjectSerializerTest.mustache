    @Nested
    @DisplayName("DateTimeOffsetPreservationTests")
    inner class DateTimeOffsetPreservationTests {

        @Test
        @DisplayName("bhvSerializationobject174 UTC datetime serializes as the canonical wire string with a +00:00 offset")
        fun utcDateTimeSerializesWithOffset() {
            val dt = OffsetDateTime.parse("2024-01-01T12:30:45+00:00")
            val result = serializer.stringify(dt)
            assertEquals("2024-01-01T12:30:45.000+00:00", result)
        }

        @Test
        @DisplayName(
            "bhvSerializationobject107 datetime with +05:30 offset preserves offset in " +
                "serialized string",
        )
        fun positiveOffsetPreserved() {
            val dt = OffsetDateTime.parse("2024-01-01T12:30:45+05:30")
            val result = serializer.stringify(dt)
            assertEquals("2024-01-01T12:30:45.000+05:30", result)
        }

        @Test
        @DisplayName("bhvSerializationobject149 datetime with -08:00 offset preserves offset in serialized string")
        fun negativeOffsetPreserved() {
            val dt = OffsetDateTime.parse("2024-01-01T12:30:45-08:00")
            val result = serializer.stringify(dt)
            assertEquals("2024-01-01T12:30:45.000-08:00", result)
        }

        @Test
        @DisplayName("bhvSerializationobject046 date-time serialization preserves sub-second precision")
        fun subsecondsPreserved() {
            // The instant 2020-01-02T03:04:05.123Z carries millisecond sub-second
            // precision — 3 fractional digits, the cross-SDK common denominator.
            // The parameter wire form (stringify) must emit the fraction so the
            // decoder, which accepts it, is not handed a lossy whole-second value.
            val dt = OffsetDateTime.parse("2020-01-02T03:04:05.123Z")
            val result = serializer.stringify(dt)
            assertEquals("2020-01-02T03:04:05.123+00:00", result)
            // Lossless round-trip: re-parsing yields the same instant.
            val parsed = OffsetDateTime.parse(result)
            assertEquals(dt.toInstant(), parsed.toInstant(), "instant should match after round-trip: $result")
        }

        @Test
        @DisplayName("bhvSerializationobject044 date-only serializes as ISO 8601 date without time component")
        fun dateOnlySerializesAsDate() {
            val date = java.time.LocalDate.parse("2024-01-01")
            val result = serializer.stringify(date)
            assertEquals("2024-01-01", result)
        }

        @Test
        @DisplayName("bhvSerializationobject150 serialized datetime has a numeric offset, never Z")
        fun serializedDateTimeHasOffset() {
            val dt = OffsetDateTime.of(2024, 1, 1, 12, 30, 45, 0, ZoneOffset.UTC)
            val result = serializer.stringify(dt)
            assertEquals("2024-01-01T12:30:45.000+00:00", result)
            assertFalse(result.endsWith("Z"), "must not use the Z designator: $result")
        }

        @Test
        @DisplayName("bhvSerializationobject064 deserialize time as OffsetDateTime preserves the time portion and offset")
        fun deserializedDateTimePreservesTimeAndOffset() {
            val order = serializer.deserialize<{{modelPackage}}.Order>("{\"shipDate\":\"2024-01-15T10:30:00.123+05:30\"}")
            assertNotNull(order)
            assertEquals(java.time.LocalTime.of(10, 30, 0, 123_000_000), order!!.shipDate!!.toLocalTime())
            assertEquals(ZoneOffset.ofHoursMinutes(5, 30), order.shipDate!!.offset)
        }

        @Test
        @DisplayName("bhvSerializationobject144 round-trip: serialize then deserialize yields equivalent datetime")
        fun roundTripDateTime() {
            val original = OffsetDateTime.parse("2024-01-01T12:30:45+05:30")
            val serialized = serializer.stringify(original)
            val parsed = OffsetDateTime.parse(serialized)
            assertEquals(original.toInstant(), parsed.toInstant(), "instant should match after round-trip")
        }
    }

