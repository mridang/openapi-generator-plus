    @Nested
    @DisplayName("serialize")
    inner class SerializeTests {

        @Test
        @DisplayName("handles null")
        fun handlesNull() {
            val json = serializer.serialize(null)
            assertEquals("null", json)
        }

        @Test
        @DisplayName("handles string")
        fun handlesString() {
            val json = serializer.serialize("hello")
            assertEquals("\"hello\"", json)
        }

        @Test
        @DisplayName("includes fields explicitly set to default values")
        fun includesFieldsSetToDefaultValues() {
            val category = {{modelPackage}}.Category(id = 0L, name = "")
            val json = serializer.serialize(category)
            assertTrue(json.contains("\"id\":0"), "serialized JSON should include id=0, got: $json")
            assertTrue(json.contains("\"name\":\"\""), "serialized JSON should include empty name, got: $json")
        }

        @Test
        @DisplayName("omits fields explicitly set to null (Gap 13: discard nulls)")
        fun omitsNullFields() {
            val category = {{modelPackage}}.Category(id = null, name = "Dogs")
            val json = serializer.serialize(category)
            assertFalse(json.contains("\"id\""), "serialized JSON should NOT contain null id, got: $json")
            assertTrue(json.contains("\"name\":\"Dogs\""), "serialized JSON should include name, got: $json")
            assertFalse(json.contains("null"), "serialized JSON should not contain the literal 'null', got: $json")
        }

        @Test
        @DisplayName("emits non-null schema defaults on the wire (cross-SDK parity)")
        fun emitsSchemaDefaultsOnTheWire() {
            // A default-constructed model carries its schema defaults as kotlinx
            // constructor defaults (retries=3, mode=medium, label="untitled").
            // Every other SDK writes those values on the wire, so Kotlin must
            // too — a default Defaults() must NOT serialize to "{}".
            val json = serializer.serialize({{modelPackage}}.Defaults())
            assertTrue(json.contains("\"retries\":3"), "expected retries=3 default, got: $json")
            assertTrue(json.contains("\"mode\":\"medium\""), "expected mode=medium default, got: $json")
            assertTrue(json.contains("\"label\":\"untitled\""), "expected label default, got: $json")
        }

        @Test
        @DisplayName("omits an explicitly-nulled optional even when its default is non-null")
        fun omitsExplicitNullEvenWithNonNullDefault() {
            // label has a non-null schema default ("untitled"). Setting it to null
            // must omit the key entirely (parity with swift encodeIfPresent / go
            // omitempty / rust skip_serializing_if), not emit "label":null.
            val json = serializer.serialize({{modelPackage}}.Defaults(label = null))
            assertFalse(json.contains("\"label\""), "explicitly-nulled label must be omitted, got: $json")
            assertFalse(json.contains("null"), "no literal null should appear, got: $json")
            // The other defaulted fields still emit their values.
            assertTrue(json.contains("\"retries\":3"), "expected retries=3 default, got: $json")
        }
    }

