        @Test
        @DisplayName("free-form Any preserves a JSON null nested in an object as a real null")
        fun freeFormAnyNestedObjectNullStaysNull() {
            // Regression: a JSON null nested inside a free-form @Contextual Any
            // value was coerced to the literal string "null", indistinguishable
            // from a real string and re-serialized as a quoted "null".
            val edge = serializer.deserialize<{{modelPackage}}.EdgeCases>(
                "{\"freeFormAny\":{\"a\":null,\"b\":\"x\"}}")
            assertNotNull(edge)
            @Suppress("UNCHECKED_CAST")
            val map = edge!!.freeFormAny as Map<String, Any?>
            assertNull(map["a"], "nested JSON null must decode to a real Kotlin null, not \"null\"")
            assertEquals("x", map["b"])
        }

        @Test
        @DisplayName("free-form Any preserves a JSON null nested in an array as a real null")
        fun freeFormAnyNestedArrayNullStaysNull() {
            val edge = serializer.deserialize<{{modelPackage}}.EdgeCases>(
                "{\"freeFormAny\":[1,null,2]}")
            assertNotNull(edge)
            @Suppress("UNCHECKED_CAST")
            val list = edge!!.freeFormAny as List<Any?>
            assertEquals(3, list.size)
            assertEquals(1L, list[0])
            assertNull(list[1], "null array element must decode to a real Kotlin null, not \"null\"")
            assertEquals(2L, list[2])
        }

        @Test
        @DisplayName("ignores unknown JSON fields on deserialize (Gap 14: discard extras)")
        fun ignoresUnknownFieldsOnDeserialize() {
            val jsonWithExtras = "{\"id\":1,\"name\":\"Dogs\",\"unknownField\":\"x\",\"another\":42}"
            val result = serializer.deserialize<{{modelPackage}}.Category>(jsonWithExtras)
            assertNotNull(result)
            assertEquals(1L, result!!.id)
            assertEquals("Dogs", result.name)
        }

        @Test
        @DisplayName("BOM-tolerance: leading UTF-8 BOM is stripped before decode")
        fun leadingBomStrippedBeforeDecode() {
            // RFC 8259 §8.1 forbids a UTF-8 BOM at the start of JSON text, but
            // Windows-generated payloads often include one and kotlinx-
            // serialization rejects it. The serializer strips it silently for
            // parity with Java Jackson / C# System.Text.Json. The leading
            // ﻿ must not break the decode.
            val json = "﻿{\"id\":1,\"name\":\"Dogs\"}"
            val result = serializer.deserialize<{{modelPackage}}.Category>(json)
            assertNotNull(result)
            assertEquals(1L, result!!.id)
            assertEquals("Dogs", result.name)
        }

        @Test
        @DisplayName("Gap AJ: null on required non-nullable field throws")
        fun nullOnRequiredFieldThrows() {
            val json = "{\"name\":null,\"photoUrls\":[\"x\"]}"
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.Pet>(json)
            }
        }

        @Test
        @DisplayName("Gap AJ: missing required non-nullable field throws")
        fun missingRequiredFieldThrows() {
            val json = "{\"photoUrls\":[\"x\"]}"
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.Pet>(json)
            }
        }

        @Test
        @DisplayName("deserializes a self-referential model preserving the nested child")
        fun deserializesSelfReferentialModel() {
            // TreeNode is recursive ({ value, child: TreeNode? }). The decoder
            // must reconstruct the nested child as a typed TreeNode rather than
            // dropping it or leaving a raw map, and the absent grandchild must
            // come back as null.
            val json = "{\"value\":\"root\",\"child\":{\"value\":\"leaf\"}}"
            val top = serializer.deserialize<{{modelPackage}}.TreeNode>(json)
            assertNotNull(top)
            assertEquals("root", top!!._value)
            val child = top.child
            assertNotNull(child)
            assertEquals("leaf", child!!._value)
            assertNull(child.child)
        }

        @Test
        @DisplayName("deserialize applies schema default for absent field")
        fun deserializeAppliesSchemaDefaultForAbsentField() {
            // The Order.status field declares `default: placed` in the schema, so
            // a payload that omits "status" must populate it with the enum default
            // rather than leaving it null (default-on-deserialize parity).
            val json = "{\"id\":10,\"petId\":198772}"
            val order = serializer.deserialize<{{modelPackage}}.Order>(json)
            assertNotNull(order)
            assertEquals({{modelPackage}}.Order.StatusEnum.PLACED, order!!.status)
        }

        @Test
        @DisplayName("schema defaults apply only when the property is absent, not on explicit null")
        fun deserializeAppliesDefaultsOnlyWhenAbsent() {
            // The Defaults model declares retries=3 (non-enum scalar),
            // mode=medium (enum default that is not the first variant) and
            // label="untitled" (nullable string with a default). An absent
            // property is populated with its declared default; an explicit JSON
            // null is a provided value and must be preserved, never overwritten by
            // the default.
            val fromEmpty = serializer.deserialize<{{modelPackage}}.Defaults>("{}")
            assertNotNull(fromEmpty)
            assertEquals(3, fromEmpty!!.retries)
            assertEquals({{modelPackage}}.Defaults.ModeEnum.MEDIUM, fromEmpty.mode)
            assertEquals("untitled", fromEmpty.label)

            val fromNull = serializer.deserialize<{{modelPackage}}.Defaults>("{\"label\":null,\"retries\":7}")
            assertNotNull(fromNull)
            assertNull(fromNull!!.label)
            assertEquals(7, fromNull.retries)
        }

        @Test
        @DisplayName("primitive-type-coercion-lenient: unquoted scalar on a String field throws")
        fun unquotedScalarOnStringFieldThrows() {
            // isLenient=true accepts an unquoted bare literal as a string value
            // ({"name":Dogs}), coercing malformed JSON into a valid object and
            // masking the payload error. isLenient=false rejects it, matching
            // the strict parsers of the other SDKs.
            val json = "{\"name\":Dogs}"
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.Category>(json)
            }
        }

        @Test
        @DisplayName("primitive-type-coercion-lenient: unquoted number scalar on a String field throws")
        fun unquotedNumberScalarOnStringFieldThrows() {
            // Another isLenient=true coercion: a bare numeric token decoded into
            // a String field. Strict mode requires the value to be quoted.
            val json = "{\"name\":42}"
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.Category>(json)
            }
        }
    }

    @Nested
    @DisplayName("StrictPrimitiveCoercionTests")
    inner class StrictPrimitiveCoercionTests {

        @Test
        @DisplayName("quoted-scalar-into-numeric-field: {\"id\":\"42\"} on a Long field throws")
        fun quotedScalarIntoLongFieldThrows() {
            // Residual kotlinx gap: even with isLenient=false the parser would
            // silently coerce the quoted "42" into the numeric id. The strict
            // per-field serializer rejects a JSON string for a numeric field,
            // matching Jackson ALLOW_COERCION_OF_SCALARS=false on the Java SDK.
            val json = "{\"id\":\"42\",\"name\":\"Dogs\"}"
