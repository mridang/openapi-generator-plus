            // leaving raw JsonElements or collapsing the inner arrays.
            val item = {{modelPackage}}.StockItem(
                priority = {{modelPackage}}.Priority.NUMBER_3,
                matrix = listOf(listOf(1, 2), listOf(3, 4, 5)),
            )
            val json = serializer.serialize(item)
            val decoded = serializer.deserialize<{{modelPackage}}.StockItem>(json)
            assertNotNull(decoded)
            assertEquals(listOf(listOf(1, 2), listOf(3, 4, 5)), decoded!!.matrix)
        }

        @Test
        @DisplayName("bhvSerializationobject145 format:duration round-trips, including a negative and a sub-0.0001s magnitude")
        fun durationRoundTripsNegativeAndSmallMagnitude() {
            // EdgeCases.retryAfter is format:duration, wire-encoded as a
            // protobuf-JSON google.protobuf.Duration ("-?\\d+(\\.\\d{1,9})?s").
            // A negative duration keeps its sign, and a sub-0.0001s magnitude
            // (1 microsecond) must emit fixed-point digits, never scientific
            // notation.
            val negative = java.time.Duration.ofSeconds(-90)
            val negJson = serializer.serialize({{modelPackage}}.EdgeCases(retryAfter = negative))
            assertTrue(negJson.contains("\"retryAfter\":\"-90s\""), "negative duration must keep its sign, got: $negJson")
            val negDecoded = serializer.deserialize<{{modelPackage}}.EdgeCases>(negJson)
            assertNotNull(negDecoded)
            assertEquals(negative, negDecoded!!.retryAfter)

            // 1 microsecond = 0.000001s — well below 0.0001s. Must NOT render as
            // 1.0E-6 or similar.
            val tiny = java.time.Duration.ofNanos(1_000)
            val tinyJson = serializer.serialize({{modelPackage}}.EdgeCases(retryAfter = tiny))
            assertFalse(tinyJson.contains("E"), "duration must not use scientific notation, got: $tinyJson")
            assertFalse(tinyJson.contains("e-"), "duration must not use scientific notation, got: $tinyJson")
            val tinyDecoded = serializer.deserialize<{{modelPackage}}.EdgeCases>(tinyJson)
            assertNotNull(tinyDecoded)
            assertEquals(tiny, tinyDecoded!!.retryAfter)
        }

        @Test
        @DisplayName("format:duration past the ~292-year Long-nanosecond limit re-serializes instead of overflowing")
        fun durationBeyondNanoRangeRoundTrips() {
            // Regression for M3: the old encoder derived seconds from
            // Duration.toNanos(), which throws ArithmeticException once the
            // duration exceeds ~292 years (Long nanosecond overflow). parse()
            // accepts an arbitrarily large second count, so a value that
            // deserializes cleanly must also re-serialize. The encoder now uses
            // Duration.abs().seconds / .nano, which never overflows. Decode a
            // 10-billion-second duration (~317 years, beyond the toNanos range)
            // and assert the round-trip back to the wire form succeeds.
            val huge = "10000000000s"
            val decoded = serializer.deserialize<{{modelPackage}}.EdgeCases>(
                "{\"retryAfter\":\"$huge\"}")
            assertNotNull(decoded)
            assertEquals(java.time.Duration.ofSeconds(10_000_000_000L), decoded!!.retryAfter)
            // Re-serialize: this is the call that previously threw on toNanos().
            val reEncoded = serializer.serialize(decoded!!)
            assertTrue(
                reEncoded.contains("\"retryAfter\":\"$huge\""),
                "duration past the nanosecond range must re-serialize, got: $reEncoded")

            // The negative side of the range must survive too.
            val negHuge = "-10000000000s"
            val negDecoded = serializer.deserialize<{{modelPackage}}.EdgeCases>(
                "{\"retryAfter\":\"$negHuge\"}")
            assertNotNull(negDecoded)
            val negReEncoded = serializer.serialize(negDecoded!!)
            assertTrue(
                negReEncoded.contains("\"retryAfter\":\"$negHuge\""),
                "negative duration past the nanosecond range must re-serialize, got: $negReEncoded")
        }

        @Test
        @DisplayName("bhvSerializationobject054 a protobuf-JSON duration with fractional seconds decodes")
        fun fractionalProtobufDurationDecodes() {
            val edge = serializer.deserialize<{{modelPackage}}.EdgeCases>("{\"retryAfter\":\"1.5s\"}")
            assertEquals(java.time.Duration.ofMillis(1500), edge!!.retryAfter)
        }

        @Test
        @DisplayName("bhvSerializationobject106 a negative fractional protobuf-JSON duration decodes with its sign")
        fun negativeFractionalProtobufDurationDecodes() {
            val edge = serializer.deserialize<{{modelPackage}}.EdgeCases>("{\"retryAfter\":\"-1.5s\"}")
            assertEquals(java.time.Duration.ofMillis(-1500), edge!!.retryAfter)
        }

        @Test
        @DisplayName("bhvSerializationobject112 a protobuf-JSON duration of whole seconds parses")
        fun wholeSecondProtobufDurationParses() {
            val edge = serializer.deserialize<{{modelPackage}}.EdgeCases>("{\"retryAfter\":\"3600s\"}")
            assertEquals(java.time.Duration.ofHours(1), edge!!.retryAfter)
        }

        @Test
        @DisplayName("bhvSerializationobject073 a duration round-trips through a model body")
        fun durationRoundTripsThroughAModelBody() {
            val wire = serializer.serialize({{modelPackage}}.EdgeCases(retryAfter = java.time.Duration.ofSeconds(90)))
            assertTrue(wire.contains("\"retryAfter\":\"90s\""), "got: $wire")
            val decoded = serializer.deserialize<{{modelPackage}}.EdgeCases>(wire)
            assertEquals(java.time.Duration.ofSeconds(90), decoded!!.retryAfter)
        }

        @Test
        @DisplayName("bhvSerializationobject081 a duration field in a model body is written as whole protobuf seconds")
        fun durationFieldIsWrittenAsWholeSeconds() {
            val wire = serializer.serialize({{modelPackage}}.EdgeCases(retryAfter = java.time.Duration.ofHours(1)))
            assertTrue(wire.contains("\"retryAfter\":\"3600s\""), "got: $wire")
        }

        @Test
        @DisplayName("bhvSerializationobject080 format:duration that is malformed or overflows raises the SDK SerializationException")
        fun malformedOrOverflowingDurationRaisesSerializationException() {
            // Neither kotlinx's SerializationException nor a raw
            // NumberFormatException may escape: both become the SDK's own
            // SerializationException, which a catch on the SDK root sees.
            for (wire in listOf("90", "1.5m", "99999999999999999999s")) {
                val ex = assertThrowsExactly({{invokerPackage}}.errors.SerializationException::class.java) {
                    serializer.deserialize<{{modelPackage}}.EdgeCases>("{\"retryAfter\":\"$wire\"}")
                }
                assertTrue(ex is {{errorPrefix}}Exception, "must extend the SDK root, was: $ex")
            }
        }
    }

    @Nested
    @DisplayName("StrictModuleTests")
    inner class StrictModuleTests {

        @Test
        @DisplayName(
            "bhvSerializationobject058 deserialize rejects an undeclared key on an " +
                "unevaluatedProperties:false model",
        )
        fun deserializeRejectsUndeclaredKey() {
