                serializer.deserialize<{{modelPackage}}.StrictTag>(
                    "{\"id\":1,\"name\":\"x\",\"unexpected\":true}",
                )
            }
            assertTrue(ex.message!!.contains("unexpected"))
            assertTrue(ex.message!!.contains("unevaluatedProperties:false"))

            val ok = serializer.deserialize<{{modelPackage}}.StrictTag>(
                "{\"id\":1,\"name\":\"x\"}",
            )
            assertEquals("x", ok!!.name)
        }

        @Test
        @DisplayName("bhvSerializationobject047 declared keys decode on an unevaluatedProperties:false model")
        fun declaredKeysDecode() {
            val tag = serializer.deserialize<{{modelPackage}}.StrictTag>("{\"id\":7,\"name\":\"x\"}")
            assertNotNull(tag)
            assertEquals(7L, tag!!.id)
            assertEquals("x", tag.name)
        }

        @Test
        @DisplayName("bhvSerializationobject154 deserialize rejects an undeclared key on a strict model inside a list")
        fun deserializeRejectsUndeclaredKeyInList() {
            val ex = assertThrows(SerializationException::class.java) {
                serializer.deserialize<List<{{modelPackage}}.StrictTag>>(
                    "[{\"id\":1,\"name\":\"x\",\"unexpected\":true}]",
                )
            }
            assertTrue(ex.message!!.contains("unexpected"))
            assertTrue(ex.message!!.contains("unevaluatedProperties:false"))
        }

        @Test
        @DisplayName("bhvSerializationobject123 rejects a null value in a map of models")
        fun rejectsNullValueInMapOfModels() {
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<Map<String, {{modelPackage}}.Metadata>>("{\"k\":null}")
            }
        }

        @Test
        @DisplayName("bhvSerializationobject052 deserialize rejects an undeclared key on a strict model inside a map")
        fun deserializeRejectsUndeclaredKeyInMap() {
            val ex = assertThrows(SerializationException::class.java) {
                serializer.deserialize<Map<String, {{modelPackage}}.StrictTag>>(
                    "{\"a\":{\"id\":1,\"name\":\"x\",\"unexpected\":true}}",
                )
            }
            assertTrue(ex.message!!.contains("unexpected"))
        }

        // Mirrors a unevaluatedProperties:false model that carries a @Contextual
        // field (date-time / uuid / decimal / duration). The strict
        // decoder builds a STRICT Json (ignoreUnknownKeys = false); the M7
        // defect was that it built a BARE Json {} with no serializersModule, so a
        // @Contextual property had no serializer and decoding threw
        // "serializer not found". The fix reuses
        // ObjectSerializer.contextualSerializersModule. The fixture type
        // ContextualStrict is declared at file scope: Kotlin prohibits a
        // (non-inner) nested class inside a JUnit @Nested inner class.
        @Test
        @DisplayName("a bare strict Json without the contextual module fails on a @Contextual field")
        fun bareStrictJsonMissesContextualSerializer() {
            // Reproduces the M7 defect: ignoreUnknownKeys = false alone, with no
            // serializersModule, cannot resolve the @Contextual OffsetDateTime.
            val bare = kotlinx.serialization.json.Json {
                ignoreUnknownKeys = false
                isLenient = false
            }
            assertThrows(Exception::class.java) {
                bare.decodeFromString(
                    ContextualStrict.serializer(),
                    "{\"ts\":\"2024-01-01T00:00:00Z\"}",
                )
            }
        }

        @Test
        @DisplayName("a strict Json reusing the SDK contextual module decodes a @Contextual field")
        fun strictJsonWithSdkModuleDecodesContextual() {
            // The fix: the strict decoder copies ObjectSerializer.contextualSerializersModule
            // into the strict Json, so the @Contextual OffsetDateTime resolves and
            // the unknown-key rejection still applies.
            val strict = kotlinx.serialization.json.Json {
                ignoreUnknownKeys = false
                isLenient = false
                serializersModule = ObjectSerializer.contextualSerializersModule
            }
            val decoded = strict.decodeFromString(
                ContextualStrict.serializer(),
                "{\"ts\":\"2024-01-01T00:00:00Z\"}",
            )
            assertEquals(
                OffsetDateTime.parse("2024-01-01T00:00:00Z"),
                decoded.ts,
            )

            // The strict contract still rejects an undeclared key.
            assertThrows(Exception::class.java) {
                strict.decodeFromString(
                    ContextualStrict.serializer(),
                    "{\"ts\":\"2024-01-01T00:00:00Z\",\"extra\":1}",
                )
            }
        }
    }

    /*
     * Byte-array equality across the three shapes a property can take. Kotlin's
     * synthesized data-class equals/hashCode compare ByteArray by REFERENCE
     * identity, and a List<ByteArray> bottoms out in reference-equal elements,
     * so a model holding bytes would report two instances carrying the same
     * content as unequal — and would misbehave as a map or set key. The
     * generated overrides must route every byte-array shape through
     * contentEquals/contentHashCode.
     *
     * The MAP case is the one that regressed: the template once selected the
     * LIST branch for a map and emitted a Collection call (zip/size) on a Map,
     * which did not compile; the fix that restored compilation then silently
     * fell back to plain == on the values, i.e. reference identity again. A
     * test that only covered the bare array and the list passed throughout
     * both defects, which is why the map case is asserted explicitly below —
     * both for a differing VALUE (content comparison) and a differing KEY (the
     * map's own structural comparison).
     *
     * The fixture model carries all three deliberately: a bare ByteArray, a
     * list of them, and a map of them.
     */
    @Nested
    @DisplayName("generated equality compares decimals by value, not scale")
    inner class DecimalEquality {

        private fun petOf(weightKg: java.math.BigDecimal?): {{modelPackage}}.Pet =
            {{modelPackage}}.Pet(name = "fido", photoUrls = setOf("u"), weightKg = weightKg)

        @Test
        @DisplayName("1.5 and 1.50 are equal and hash alike")
        fun differentScalesAreEqual() {
            val a = petOf(java.math.BigDecimal("1.5"))
            val b = petOf(java.math.BigDecimal("1.50"))
            assertEquals(a, b)
            assertEquals(a.hashCode(), b.hashCode())
        }

        @Test
        @DisplayName("pets decoded from 1.5 and 1.50 are equal")
        fun decodedScalesAreEqual() {
            val a = serializer.deserialize<{{modelPackage}}.Pet>("{\"name\":\"f\",\"photoUrls\":[],\"weightKg\":1.5}")
            val b = serializer.deserialize<{{modelPackage}}.Pet>("{\"name\":\"f\",\"photoUrls\":[],\"weightKg\":1.50}")
            assertEquals(a, b)
            assertEquals(a.hashCode(), b.hashCode())
        }

        @Test
        @DisplayName("different values and null versus set are unequal")
        fun differentValuesAreUnequal() {
            assertNotEquals(petOf(java.math.BigDecimal("1.5")), petOf(java.math.BigDecimal("1.6")))
            assertNotEquals(petOf(java.math.BigDecimal("1.5")), petOf(null))
            assertNotEquals(petOf(null), petOf(java.math.BigDecimal("1.5")))
            assertEquals(petOf(null), petOf(null))
        }
    }

    @Nested
    @DisplayName("generated equality compares array content, not identity")
    inner class ByteArrayEquality {

        // Default arguments are re-evaluated on every call, so each invocation
        // hands back a vault whose arrays are FRESH objects. That is the whole
        // point: identity comparison cannot pass the first test below.
        private fun vaultOf(
            seal: ByteArray = byteArrayOf(1, 2, 3),
            shards: List<ByteArray> = listOf(byteArrayOf(4, 5), byteArrayOf(6)),
            labels: Map<String, ByteArray> = mapOf("first" to byteArrayOf(7, 8)),
        ): {{modelPackage}}.BinaryVault =
            {{modelPackage}}.BinaryVault(seal = seal, shards = shards, labels = labels)

        // The generated properties are nullable (`Map<String, ByteArray>?`),
        // so reading one back for an assertion needs a null check first. Assert
        // rather than silently default: a null here would mean the fixture
        // stopped populating the property and the test below would be vacuous.
        private fun labelsOf(vault: {{modelPackage}}.BinaryVault): Map<String, ByteArray> {
            val labels = vault.labels
            assertNotNull(labels, "fixture must populate labels")
            return labels!!
        }

        @Test
        @DisplayName("bhvSerializationobject090 instances holding equal content are equal though every array is distinct")
        fun equalContentDistinctArraysCompareEqual() {
            val left = vaultOf()
            val right = vaultOf()

            // Every array in the two models is a separate object, so identity
            // comparison would fail here on all three properties. This is the
            // load-bearing case.
            assertNotSame(left.seal, right.seal)
            assertNotSame(labelsOf(left)["first"], labelsOf(right)["first"])

            assertEquals(left, right, "models holding identical bytes must compare equal")
            assertEquals(
                left.hashCode(),
                right.hashCode(),
                "models that compare equal must hash equal, or they break as map keys",
            )
        }

        @Test
        @DisplayName("toString renders byte data by content, never an identity hash")
        fun toStringRendersBytesByContent() {
            val text = vaultOf().toString()

            assertTrue(text.contains("seal=[1, 2, 3]"), text)
            assertTrue(text.contains("shards=[[4, 5], [6]]"), text)
            assertTrue(text.contains("labels={first=[7, 8]}"), text)
            assertFalse(text.contains("[B@"), text)
        }

        @Test
        @DisplayName("bhvSerializationobject075 a differing byte in the bare array makes them unequal")
        fun differingBareArrayCompareUnequal() {
            val left = vaultOf()
            val right = vaultOf(seal = byteArrayOf(1, 2, 4))

            assertNotEquals(left, right)
        }

        @Test
        @DisplayName("bhvSerializationobject009 a differing byte inside the list makes them unequal")
        fun differingListElementCompareUnequal() {
            val left = vaultOf()
            val right = vaultOf(shards = listOf(byteArrayOf(4, 5), byteArrayOf(9)))

            assertNotEquals(left, right)
        }

        @Test
        @DisplayName("bhvSerializationobject005 a differing byte inside a map VALUE makes them unequal")
        fun differingMapValueCompareUnequal() {
            val left = vaultOf()
            val right = vaultOf(labels = mapOf("first" to byteArrayOf(7, 9)))

            // Reference-identity comparison of the map values would call these
            // EQUAL: the two maps have the same key set, and Map's own equals
            // compares values with ==, which for ByteArray stops at the array
            // reference and never looks at the bytes. Only a per-value
            // contentEquals distinguishes them.
            assertNotEquals(left, right)
        }

        @Test
        @DisplayName("a differing map KEY makes them unequal")
        fun differingMapKeyCompareUnequal() {
            val left = vaultOf()
            val right = vaultOf(labels = mapOf("second" to byteArrayOf(7, 8)))

            // The complement of the case above: identical value bytes under a
            // different key. A comparison that walked only the values (or that
            // looked up by the WRONG map's keys) would miss this.
            assertNotEquals(left, right)
        }
    }

    @Nested
    @DisplayName("CanonicalSerdeBehaviours")
    inner class CanonicalSerdeBehaviours {

        // NaN/Infinity on ENCODE must reject with the SDK's SerializationException
        // (RFC 8259 §6 has no such token). kotlinx-serialization's default
        // allowSpecialFloatingPointValues = false rejects non-finite floats,
        // which serialize() surfaces as the SDK's SerializationException.
        @Test
        @DisplayName("bhvSerializationobject153 serializing a non-finite double throws SerializationException")
        fun nonFiniteDoubleThrowsOnSerialize() {
            assertThrows(SerializationException::class.java) { serializer.serialize(Double.NaN) }
            assertThrows(SerializationException::class.java) {
                serializer.serialize(Double.POSITIVE_INFINITY)
            }
            assertThrows(SerializationException::class.java) {
                serializer.serialize(Double.NEGATIVE_INFINITY)
            }
        }

        // A bare JSON null body decoded to a model type returns null.
        @Test
        @DisplayName("bhvSerializationobject067 a literal null body deserializes to null")
        fun literalNullBodyDeserializesToNull() {
            assertNull(serializer.deserialize<{{modelPackage}}.Category>("null"))
        }

        // A format:byte model field (PetPassport.thumbnail) holding a
        // bad-alphabet base64 string is rejected: Base64ByteArraySerializer's
        // decoder throws rather than silently truncating, and the SDK surfaces
        // it as SerializationException.
        @Test
        @DisplayName("bhvSerializationobject094 invalid base64 in a byte field throws SerializationException")
        fun invalidBase64ByteFieldThrowsSerializationException() {
            assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.PetPassport>("{\"thumbnail\":\"!!!!\"}")
            }
        }

        @Test
        @DisplayName("a byte field accepts only padded standard-alphabet base64 without whitespace")
        fun byteFieldDecodeIsStrictBase64() {
            for (bad in listOf("dGVzdA", "dGVz dA==", "dGVz\\ndA==", "-_8=", "!!!!")) {
                assertThrowsExactly(SerializationException::class.java, {
                    serializer.deserialize<{{modelPackage}}.PetPassport>("{\"thumbnail\":\"$bad\"}")
                }, bad)
            }
            val decoded = serializer.deserialize<{{modelPackage}}.PetPassport>("{\"thumbnail\":\"dGVzdA==\"}")
            assertArrayEquals("test".toByteArray(Charsets.UTF_8), decoded!!.thumbnail)
        }

        @Test
        @DisplayName("bhvSerializationobject008 uri accepts absolute URIs, uri-reference accepts relative")
        fun uriFieldRequiresAnAbsoluteUri() {
            val good = listOf("urn:isbn:0451450523", "mailto:a@b.com", "ftp://x.org/f", "https://example.com/items/1")
            for (uri in good) {
                val json = "{\"name\":\"n\",\"photoUrls\":[],\"homepageUrl\":\"$uri\"}"
                assertNotNull(serializer.deserialize<{{modelPackage}}.Pet>(json)!!.homepageUrl, uri)
            }
            val https = "{\"name\":\"n\",\"photoUrls\":[],\"homepageUrl\":\"https://example.com/items/1\"}"
            assertEquals(
                "https://example.com/items/1",
                serializer.deserialize<{{modelPackage}}.Pet>(https)!!.homepageUrl.toString(),
            )
            for (uri in listOf("/relative", "not a uri", "")) {
                val json = "{\"name\":\"n\",\"photoUrls\":[],\"homepageUrl\":\"$uri\"}"
                assertThrowsExactly(SerializationException::class.java, {
                    serializer.deserialize<{{modelPackage}}.Pet>(json)
                }, uri)
            }
            val ref = "{\"name\":\"n\",\"photoUrls\":[],\"thumbnailRef\":\"/assets/thumb.png\"}"
            assertEquals("/assets/thumb.png", serializer.deserialize<{{modelPackage}}.Pet>(ref)!!.thumbnailRef)
        }

        @Test
        @DisplayName(
            "bhvSerializationobject017 readOnly and writeOnly " +
                "properties are decoded and encoded like any other",
        )
        fun readOnlyAndWriteOnlyPropertiesHaveNoWireEffect() {
            val decoded = serializer.deserialize<{{modelPackage}}.Account>("{\"id\":7,\"username\":\"u\"}")
            assertEquals(7L, decoded!!.id)
            val json = serializer.serialize({{modelPackage}}.Account(username = "u", password = "p"))
            assertTrue(json.contains("\"password\":\"p\""), json)
            val withPassword =
                serializer.deserialize<{{modelPackage}}.Account>("{\"id\":7,\"username\":\"u\",\"password\":\"p\"}")
            assertEquals("p", withPassword!!.password)
        }

        @Test
        @DisplayName("bhvSerializationobject014 a readOnly property is decoded from a response")
        fun readOnlyPropertyIsDecoded() {
            val decoded = serializer.deserialize<{{modelPackage}}.Account>("{\"id\":7,\"username\":\"u\"}")
            assertEquals(7L, decoded!!.id)
        }

        @Test
        @DisplayName("bhvSerializationobject018 a writeOnly property is serialized on the wire")
        fun writeOnlyPropertyIsSerialized() {
            val json = serializer.serialize({{modelPackage}}.Account(username = "u", password = "p"))
            assertTrue(json.contains("\"password\":\"p\""), json)
        }

        // A payload nested ~600 deep parses fine; ~1500 deep exceeds the 1000
        // MAX_JSON_DEPTH cap and is rejected.
        @Test
        @DisplayName("bhvSerializationobject051 deep JSON within the depth cap parses; past it is rejected")
        fun deepJsonDepthCap() {
            val within = "[".repeat(600) + "]".repeat(600)
            assertNotNull(serializer.parseToJsonElement(within))
            val beyond = "[".repeat(1500) + "]".repeat(1500)
            val ex = assertThrows(SerializationException::class.java) {
                serializer.parseToJsonElement(beyond)
            }
            assertEquals("JSON nesting depth 1500 exceeds limit 1000", ex.message)
        }

        @Test
        @DisplayName("bhvSerializationobject007 a format: password property is redacted in toString but still on the wire")
        fun passwordIsRedactedInToString() {
            val account = {{modelPackage}}.Account(username = "u", password = "hunter2")
            assertFalse(account.toString().contains("hunter2"), account.toString())
            assertTrue(account.toString().contains("password=***"), account.toString())
            assertTrue(serializer.serialize(account).contains("\"password\":\"hunter2\""))
        }

        @Test
        @DisplayName("bhvSerializationobject076 an enum member renders as its wire value, not its constant name")
        fun enumStringFormIsTheWireValue() {
            for (member in {{modelPackage}}.Color.entries) {
                assertEquals(member.value, member.toString())
                assertEquals(member.value, "$member")
            }
        }

        @Test
        @DisplayName(
            "bhvSerializationobject004 a malformed document is reported as Failed to " +
                "deserialize JSON with the detail",
        )
        fun malformedDocumentMessage() {
            val ex = assertThrows(SerializationException::class.java) {
                serializer.deserialize<{{modelPackage}}.Pet>("{not json")
            }
            assertTrue(ex.message!!.startsWith("Failed to deserialize JSON: "), ex.message)
            val parsed = assertThrows(SerializationException::class.java) {
                serializer.parseToJsonElement("{not json")
            }
            assertTrue(parsed.message!!.startsWith("Failed to deserialize JSON: "), parsed.message)
        }
    }
