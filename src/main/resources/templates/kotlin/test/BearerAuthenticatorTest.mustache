package {{invokerPackage}}.auth

import kotlinx.coroutines.runBlocking
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.DisplayName
import org.junit.jupiter.api.Test

class BearerAuthenticatorTest {

    @Test
    @DisplayName("bhvAuthbearer009 raw token is prefixed with Bearer")
    fun rawTokenIsPrefixedWithBearer() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "xyz")
        val headers = auth.getAuthHeaders()
        assertEquals("Bearer xyz", headers["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer003 already-prefixed token is not doubled")
    fun alreadyPrefixedTokenIsNotDoubled() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "Bearer xyz")
        val headers = auth.getAuthHeaders()
        assertEquals("Bearer xyz", headers["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer007 lowercase bearer prefix is stripped")
    fun lowercaseBearerPrefixIsStripped() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "bearer xyz")
        val headers = auth.getAuthHeaders()
        assertEquals("Bearer xyz", headers["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer008 mixed-case bearer prefix is stripped")
    fun mixedCaseBearerPrefixIsStripped() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "BeArEr xyz")
        val headers = auth.getAuthHeaders()
        assertEquals("Bearer xyz", headers["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer015 a token that merely begins with the word bearer is kept whole")
    fun lookalikeTokenIsKeptWhole() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "bearerxyz")
        assertEquals("Bearer bearerxyz", auth.getAuthHeaders()["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer004 a doubled Bearer prefix is stripped only once")
    fun doubledPrefixIsStrippedOnce() = runBlocking {
        val auth = BearerAuthenticator("https://api.example.com", "Bearer Bearer xyz")
        assertEquals("Bearer Bearer xyz", auth.getAuthHeaders()["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer016 a Unicode space is not blank, so the printable ASCII check rejects it")
    fun unicodeSpaceIsNotBlank() {
        for (space in listOf("\u00A0", "\u2003")) {
            val ex = assertThrows(IllegalArgumentException::class.java) {
                BearerAuthenticator("https://api.example.com", space)
            }
            assertEquals(
                "Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                ex.message
            )
        }
    }

    @Test
    @DisplayName("bhvAuthbearer005 empty token is rejected at construction")
    fun emptyTokenIsRejectedAtConstruction() {
        // An empty or whitespace-only token would emit a credential-less
        // "Authorization: Bearer " header (fail-open); reject it up front.
        val ex = assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("https://api.example.com", "")
        }
        assertTrue(ex.message!!.contains("Bearer token must not be empty"))
    }

    // No null-token test: the token parameter is non-nullable, so the Kotlin
    // compiler rejects passing a literal null at compile time. The empty +
    // whitespace cases here exercise the runtime guard.

    @Test
    @DisplayName("bhvAuthbearer017 whitespace-only token is rejected at construction")
    fun whitespaceOnlyTokenIsRejectedAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("https://api.example.com", "   ")
        }
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("https://api.example.com", "\t")
        }
    }

    @Test
    @DisplayName("form feed and vertical tab only tokens are rejected as empty")
    fun formFeedOnlyTokenIsRejectedAsEmpty() {
        for (blank in listOf("\u000C", "\u000B", " \t\r\n")) {
            val ex = assertThrows(IllegalArgumentException::class.java) {
                BearerAuthenticator("https://api.example.com", blank)
            }
            assertTrue(ex.message!!.contains("Bearer token must not be empty"))
        }
    }

    @Test
    @DisplayName("bhvAuthbearer012 Bearer rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)")
    fun bearerRejectsCrlfAndNonAscii() {
        // RFC 7230 §3.2.6 — reject CR/LF (header injection from tokens read
        // from .env / files with trailing newlines) and non-ASCII bytes that
        // different HTTP libs encode differently per language.
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("https://api.example.com", "tok\r\nInjected: yes")
        }
        assertThrows(IllegalArgumentException::class.java) {
            BearerAuthenticator("https://api.example.com", "ñoño")
        }
    }

    /**
     * The default toString() must mask the stored token: the secret value
     * must be absent and a *** redaction marker present.
     */
    @Test
    @DisplayName("bhvAuthbearer011 toString() redacts the token and shows ***")
    fun redactsSecret() {
        val auth = BearerAuthenticator("https://api.example.com", "xyz")
        val repr = auth.toString()
        assertFalse(repr.contains("token=xyz"))
        assertTrue(repr.contains("***"))
    }

    @Test
    @DisplayName("bhvAuthbearer001 the scheme wrapper prints its own class name with the token masked")
    fun schemeWrapperPrintsItsOwnNameWithTheTokenMasked() {
        val auth = PetStoreBearerAuthenticator("https://api.example.com", "xyz")
        assertEquals("PetStoreBearerAuthenticator(host=https://api.example.com, token=***)", auth.toString())
    }

    @Test
    fun bhvAuthbearer013RedactedReprShowsExactlyTheNonSecretFields() {
        val auth = BearerAuthenticator("https://api.example.com", "xyz")
        assertEquals("BearerAuthenticator(host=https://api.example.com, token=***)", auth.toString())
    }

    @Test
    fun bhvAuthbearer006GeneratedSchemeWrapperEmitsABearerHeaderAndMasksTheToken() = runBlocking {
        val auth = PetStoreBearerAuthenticator("https://api.example.com", "xyz")
        assertEquals("Bearer xyz", auth.getAuthHeaders()["Authorization"])
        assertEquals("PetStoreBearerAuthenticator(host=https://api.example.com, token=***)", auth.toString())
    }

    private fun <T> withEnvironment(values: Map<String, String>, body: () -> T): T {
        val saved = CredentialEnvironment.lookup
        CredentialEnvironment.lookup = { name -> values[name] }
        try {
            return body()
        } finally {
            CredentialEnvironment.lookup = saved
        }
    }

    @Test
    @DisplayName("bhvAuthbearer010 F862: with no token passed, {{envVarPrefix}}_TOKEN is read once at construction")
    fun tokenComesFromTheEnvironment() {
        val auth = withEnvironment(mapOf("{{envVarPrefix}}_TOKEN" to "from-env")) {
            BearerAuthenticator("https://api.example.com")
        }
        // The environment is read once: it is gone now, the token is not.
        assertEquals("Bearer from-env", runBlocking { auth.getAuthHeaders()["Authorization"] })
    }

    @Test
    @DisplayName("F862: an explicit token wins over the environment")
    fun explicitTokenWinsOverTheEnvironment() {
        val auth = withEnvironment(mapOf("{{envVarPrefix}}_TOKEN" to "from-env")) {
            BearerAuthenticator("https://api.example.com", "explicit")
        }
        assertEquals("Bearer explicit", runBlocking { auth.getAuthHeaders()["Authorization"] })
    }

    @Test
    @DisplayName("F862: an empty environment value counts as unset and a missing token fails at construction")
    fun missingTokenFailsAtConstruction() {
        val ex = withEnvironment(mapOf("{{envVarPrefix}}_TOKEN" to "")) {
            assertThrows(IllegalArgumentException::class.java) { BearerAuthenticator("https://api.example.com") }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_TOKEN"), ex.message)
    }

    @Test
    @DisplayName("bhvAuthbearer014 F862: a token provider is called on every request when no token and no variable is set")
    fun tokenProviderIsCalledOnEveryRequest() = runBlocking {
        var calls = 0
        val auth = withEnvironment(emptyMap()) {
            BearerAuthenticator("https://api.example.com", tokenProvider = { "rotating-" + (++calls) })
        }
        assertEquals("Bearer rotating-1", auth.getAuthHeaders()["Authorization"])
        assertEquals("Bearer rotating-2", auth.getAuthHeaders()["Authorization"])
        assertEquals(2, calls)
    }

    @Test
    @DisplayName("F862: the argument wins over the environment variable, which wins over the provider")
    fun precedenceIsArgumentThenEnvironmentThenProvider() = runBlocking {
        val provider: suspend () -> String = { "from-provider" }
        val env = mapOf("{{envVarPrefix}}_TOKEN" to "from-env")
        val explicit =
            withEnvironment(env) { BearerAuthenticator("https://api.example.com", "explicit", provider) }
        assertEquals("Bearer explicit", explicit.getAuthHeaders()["Authorization"])
        val fromEnv =
            withEnvironment(env) { BearerAuthenticator("https://api.example.com", tokenProvider = provider) }
        assertEquals("Bearer from-env", fromEnv.getAuthHeaders()["Authorization"])
        val fromProvider = withEnvironment(mapOf("{{envVarPrefix}}_TOKEN" to "")) {
            BearerAuthenticator("https://api.example.com", tokenProvider = provider)
        }
        assertEquals("Bearer from-provider", fromProvider.getAuthHeaders()["Authorization"])
    }

    @Test
    @DisplayName("bhvAuthbearer002 F862: a token the provider returns is validated like a static one")
    fun providerTokenIsValidated() {
        val auth =
            BearerAuthenticator("https://api.example.com", tokenProvider = { "bad\r\ntoken" })
        assertThrows(IllegalArgumentException::class.java) { runBlocking { auth.getAuthHeaders() } }
    }

    @Test
    @DisplayName("F862: a security scheme's authenticator reads the variable of its own scheme")
    fun schemeWrapperReadsItsOwnVariable() = runBlocking {
        val env = mapOf("{{envVarPrefix}}_PET_STORE_BEARER_TOKEN" to "from-env")
        val auth =
            withEnvironment(env) { PetStoreBearerAuthenticator("https://api.example.com") }
        assertEquals("Bearer from-env", auth.getAuthHeaders()["Authorization"])
        val other = withEnvironment(env) {
            assertThrows(IllegalArgumentException::class.java) { ServiceTokenAuthenticator("https://api.example.com") }
        }
        assertTrue(other.message!!.contains("{{envVarPrefix}}_SERVICE_TOKEN_TOKEN"), other.message)
    }

    @Test
    @DisplayName("F862: a scheme's authenticator takes the argument first, then the variable, then the provider")
    fun schemeWrapperPrecedence() = runBlocking {
        val provider: suspend () -> String = { "from-provider" }
        val env = mapOf("{{envVarPrefix}}_PET_STORE_BEARER_TOKEN" to "from-env")
        val explicit =
            withEnvironment(env) { PetStoreBearerAuthenticator("https://api.example.com", "explicit", provider) }
        assertEquals("Bearer explicit", explicit.getAuthHeaders()["Authorization"])
        val fromEnv =
            withEnvironment(env) { PetStoreBearerAuthenticator("https://api.example.com", tokenProvider = provider) }
        assertEquals("Bearer from-env", fromEnv.getAuthHeaders()["Authorization"])
        val empty = withEnvironment(mapOf("{{envVarPrefix}}_PET_STORE_BEARER_TOKEN" to "")) {
            PetStoreBearerAuthenticator("https://api.example.com", tokenProvider = provider)
        }
        assertEquals("Bearer from-provider", empty.getAuthHeaders()["Authorization"])
    }

    @Test
    @DisplayName("F862: a scheme's authenticator with no token, variable or provider fails naming its variable")
    fun schemeWrapperMissingTokenFails() {
        val ex = withEnvironment(mapOf("{{envVarPrefix}}_PET_STORE_BEARER_TOKEN" to "")) {
            assertThrows(IllegalArgumentException::class.java) { PetStoreBearerAuthenticator("https://api.example.com") }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_PET_STORE_BEARER_TOKEN"), ex.message)
    }
}
