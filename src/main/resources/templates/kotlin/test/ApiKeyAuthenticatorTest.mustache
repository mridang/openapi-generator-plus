    private fun <T> withEnvironment(values: Map<String, String>, body: () -> T): T {
        val saved = CredentialEnvironment.lookup
        CredentialEnvironment.lookup = { name -> values[name] }
        try {
            return body()
        } finally {
            CredentialEnvironment.lookup = saved
        }
    }

    @Test
    @DisplayName("bhvAuthapikey021 with no key passed, {{envVarPrefix}}_API_KEY is read once at construction, and a passed key wins")
    fun bhvAuthapikey021KeyComesFromTheEnvironmentAndAPassedKeyWins() = runBlocking {
        val auth = withEnvironment(mapOf("{{envVarPrefix}}_API_KEY" to "from-env")) {
            ApiKeyAuthenticator("https://api.example.com", "X-API-Key", location = ApiKeyLocation.HEADER)
        }
        assertEquals("from-env", auth.getAuthHeaders()["X-API-Key"])
        val explicit = withEnvironment(mapOf("{{envVarPrefix}}_API_KEY" to "from-env")) {
            ApiKeyAuthenticator("https://api.example.com", "X-API-Key", "explicit", ApiKeyLocation.HEADER)
        }
        assertEquals("explicit", explicit.getAuthHeaders()["X-API-Key"])
    }

    @Test
    @DisplayName("bhvSerializationobject187 F862: an explicit key wins over the environment, and a missing key fails at construction")
    fun explicitKeyWinsAndAMissingKeyFails() {
        val auth = withEnvironment(mapOf("{{envVarPrefix}}_API_KEY" to "from-env")) {
            ApiKeyAuthenticator("https://api.example.com", "api_key", "explicit", ApiKeyLocation.QUERY)
        }
        assertEquals("explicit", auth.getQueryParams()["api_key"])
        val ex = withEnvironment(emptyMap()) {
            assertThrows(IllegalArgumentException::class.java) {
                ApiKeyAuthenticator("https://api.example.com", "api_key", location = ApiKeyLocation.QUERY)
            }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_API_KEY"), ex.message)
    }

    @Test
    @DisplayName("bhvAuth005 F862: a key provider feeds the header, query and cookie locations on every request")
    fun keyProviderFeedsEveryLocation() = runBlocking {
        var calls = 0
        for (location in ApiKeyLocation.values()) {
            val auth = withEnvironment(emptyMap()) {
                ApiKeyAuthenticator(
                    "https://api.example.com", "k", location = location, apiKeyProvider = { "key-" + (++calls) },
                )
            }
            val headers = auth.getAuthHeaders()
            val seen =
                headers["k"] ?: auth.getQueryParams()["k"] ?: auth.getCookieParams()["k"]
            assertEquals("key-$calls", seen)
        }
        assertEquals(ApiKeyLocation.values().size, calls)
    }

    @Test
    @DisplayName("bhvAuthscheme009 a credential passed explicitly wins over its environment variable")
    fun precedenceIsArgumentThenEnvironmentThenProvider() = runBlocking {
        val provider: suspend () -> String = { "from-provider" }
        val env = mapOf("{{envVarPrefix}}_API_KEY" to "from-env")
        val explicit = withEnvironment(env) {
            ApiKeyAuthenticator("https://api.example.com", "k", "explicit", ApiKeyLocation.HEADER, provider)
        }
        assertEquals("explicit", explicit.getAuthHeaders()["k"])
        val fromEnv = withEnvironment(env) {
            ApiKeyAuthenticator("https://api.example.com", "k", location = ApiKeyLocation.HEADER, apiKeyProvider = provider)
        }
        assertEquals("from-env", fromEnv.getAuthHeaders()["k"])
        val fromProvider = withEnvironment(mapOf("{{envVarPrefix}}_API_KEY" to "")) {
            ApiKeyAuthenticator("https://api.example.com", "k", location = ApiKeyLocation.HEADER, apiKeyProvider = provider)
        }
        assertEquals("from-provider", fromProvider.getAuthHeaders()["k"])
    }

    @Test
    @DisplayName("F862: a security scheme's authenticator reads the variable of its own scheme")
    fun schemeWrapperReadsItsOwnVariable() = runBlocking {
        val env = mapOf("{{envVarPrefix}}_API_KEY_HEADER_API_KEY" to "from-env")
        val auth =
            withEnvironment(env) { ApiKeyHeaderAuthenticator("https://api.example.com") }
        assertEquals("from-env", auth.getAuthHeaders()["X-API-Key"])
        val explicit =
            withEnvironment(env) { ApiKeyHeaderAuthenticator("https://api.example.com", "explicit") }
        assertEquals("explicit", explicit.getAuthHeaders()["X-API-Key"])
        val other = withEnvironment(env) {
            assertThrows(IllegalArgumentException::class.java) { InternalApiKeyAuthenticator("https://api.example.com") }
        }
        assertTrue(other.message!!.contains("{{envVarPrefix}}_INTERNAL_API_KEY_API_KEY"), other.message)
    }

    @Test
    @DisplayName("F862: a scheme's authenticator uses its provider when neither argument nor variable is set")
    fun schemeWrapperFallsBackToItsProvider() = runBlocking {
        val auth = withEnvironment(mapOf("{{envVarPrefix}}_API_KEY_HEADER_API_KEY" to "")) {
            ApiKeyHeaderAuthenticator("https://api.example.com", apiKeyProvider = { "from-provider" })
        }
        assertEquals("from-provider", auth.getAuthHeaders()["X-API-Key"])
        val ex = withEnvironment(emptyMap()) {
            assertThrows(IllegalArgumentException::class.java) { ApiKeyHeaderAuthenticator("https://api.example.com") }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_API_KEY_HEADER_API_KEY"), ex.message)
    }

