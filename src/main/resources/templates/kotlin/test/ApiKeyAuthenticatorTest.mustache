    @Test
    fun bhvAuthapikey022KeyIsEmittedOnlyAtItsOwnLocation() = runBlocking {
        val header = ApiKeyAuthenticator("https://api.example.com", "X-API-Key", "k", ApiKeyLocation.HEADER)
        assertEquals(mapOf("X-API-Key" to "k"), header.getAuthHeaders())
        assertTrue(header.getQueryParams().isEmpty())
        assertTrue(header.getCookieParams().isEmpty())

        val query = ApiKeyAuthenticator("https://api.example.com", "api_key", "k", ApiKeyLocation.QUERY)
        assertTrue(query.getAuthHeaders().isEmpty())
        assertEquals(mapOf("api_key" to "k"), query.getQueryParams())
        assertTrue(query.getCookieParams().isEmpty())

        val cookie = ApiKeyAuthenticator("https://api.example.com", "SESSION_ID", "k", ApiKeyLocation.COOKIE)
        assertTrue(cookie.getAuthHeaders().isEmpty())
        assertTrue(cookie.getQueryParams().isEmpty())
        assertEquals(mapOf("SESSION_ID" to "k"), cookie.getCookieParams())
    }

