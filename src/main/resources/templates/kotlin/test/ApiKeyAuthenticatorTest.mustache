package {{invokerPackage}}.auth

import kotlinx.coroutines.runBlocking
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.DisplayName
import org.junit.jupiter.api.Test

class ApiKeyAuthenticatorTest {

    @Test
    @DisplayName("valid header key is exposed via getAuthHeaders")
    fun validHeaderKeyPasses() = runBlocking {
        val auth = ApiKeyAuthenticator(
            "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER
        )
        val headers = auth.getAuthHeaders()
        assertEquals("abc123", headers["X-API-Key"])
    }

    @Test
    @DisplayName("valid query key is exposed via getQueryParams")
    fun validQueryKeyPasses() {
        val auth = ApiKeyAuthenticator(
            "https://api.example.com", "api_key", "abc123", ApiKeyLocation.QUERY
        )
        val params = auth.getQueryParams()
        assertEquals("abc123", params["api_key"])
    }

    @Test
    @DisplayName("valid cookie key is exposed via getCookieParams")
    fun validCookieKeyPasses() {
        val auth = ApiKeyAuthenticator(
            "https://api.example.com", "session", "abc123", ApiKeyLocation.COOKIE
        )
        val params = auth.getCookieParams()
        assertEquals("abc123", params["session"])
    }

    @Test
    @DisplayName("empty header key throws at construction")
    fun emptyKeyHeaderThrowsAtConstruction() {
        val ex = assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "", ApiKeyLocation.HEADER
            )
        }
        assertTrue(ex.message!!.contains("must not be empty"))
    }

    @Test
    @DisplayName("empty query key throws at construction")
    fun emptyKeyQueryThrowsAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "", ApiKeyLocation.QUERY
            )
        }
    }

    @Test
    @DisplayName("empty cookie key throws at construction")
    fun emptyKeyCookieThrowsAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "session", "", ApiKeyLocation.COOKIE
            )
        }
    }

    @Test
    @DisplayName("whitespace-only key throws at construction")
    fun whitespaceOnlyKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "   ", ApiKeyLocation.HEADER
            )
        }
    }

    @Test
    @DisplayName("only ASCII whitespace counts as blank")
    fun onlyAsciiWhitespaceCountsAsBlank() {
        for (blank in listOf("\u000C", "\u000B", " \t\r\n")) {
            assertThrows(IllegalArgumentException::class.java) {
                ApiKeyAuthenticator(
                    "https://api.example.com", "api_key", blank, ApiKeyLocation.QUERY
                )
            }
        }
        for (valid in listOf("\u00A0", "\u2003")) {
            assertEquals(
                mapOf("api_key" to valid),
                ApiKeyAuthenticator(
                    "https://api.example.com", "api_key", valid, ApiKeyLocation.QUERY
                ).getQueryParams()
            )
        }
    }

    @Test
    @DisplayName("CR/LF in query key throws at construction")
    fun crlfInQueryKeyThrowsAtConstruction() {
        val ex = assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "abc\r\n", ApiKeyLocation.QUERY
            )
        }
        assertTrue(ex.message!!.contains("forbidden control"))
    }

    @Test
    @DisplayName("CR/LF in cookie key throws at construction")
    fun crlfInCookieKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "session", "abc\n", ApiKeyLocation.COOKIE
            )
        }
    }

    @Test
    @DisplayName("CR/LF in header key throws at construction")
    fun crlfInHeaderKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc\rdef", ApiKeyLocation.HEADER
            )
        }
    }

    @Test
    @DisplayName("ApiKey header rejects non-ASCII (RFC 7230 §3.2.6)")
    fun apiKeyHeaderRejectsNonAscii() {
        // The HEADER location must reject any value outside printable ASCII +
        // TAB to prevent silent UTF-8 mangling that varies per HTTP lib.
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyAuthenticator(
                "https://api.example.com", "X-Api-Key", "kéy", ApiKeyLocation.HEADER
            )
        }
    }

    @Test
    @DisplayName("ApiKey query location accepts non-ASCII characters")
    fun apiKeyQueryAcceptsNonAscii() {
        // The QUERY location is URL-encoded downstream, so it must accept a
        // non-ASCII key value verbatim and surface it through getQueryParams.
        assertEquals(
            mapOf("api_key" to "kéy"),
            ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "kéy", ApiKeyLocation.QUERY
            ).getQueryParams()
        )
    }

    /**
     * The default toString() must mask the stored API key: the secret value
     * must be absent and a *** redaction marker present.
     */
    @Test
    @DisplayName("toString() redacts the API key and shows ***")
    fun redactsSecret() {
        val auth = ApiKeyAuthenticator(
            "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER
        )
        val repr = auth.toString()
        assertFalse(repr.contains("abc123"))
        assertTrue(repr.contains("***"))
    }

    @Test
    fun redactedReprShowsExactlyTheNonSecretFields() {
        val auth = ApiKeyAuthenticator(
            "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.COOKIE
        )
        assertEquals(
            "ApiKeyAuthenticator(host=https://api.example.com, keyParamName=X-API-Key, apiKey=***, location=COOKIE)",
            auth.toString(),
        )
    }

    @Test
    fun generatedSchemeWrappersEmitTheirKeyAtTheirSpecLocation() = runBlocking {
        val header = ApiKeyHeaderAuthenticator("https://api.example.com", "k1")
        assertEquals(mapOf("X-API-Key" to "k1"), header.getAuthHeaders())
        assertTrue(header.getQueryParams().isEmpty())
        assertTrue(header.getCookieParams().isEmpty())

        val internal = InternalApiKeyAuthenticator("https://api.example.com", "k2")
        assertEquals(mapOf("X-Internal-Key" to "k2"), internal.getAuthHeaders())

        val query = ApiKeyQueryAuthenticator("https://api.example.com", "k3")
        assertEquals(mapOf("api_key" to "k3"), query.getQueryParams())
        assertTrue(query.getAuthHeaders().isEmpty())
        assertTrue(query.getCookieParams().isEmpty())

        val cookie = SessionCookieAuthenticator("https://api.example.com", "k4")
        assertEquals(mapOf("SESSION_ID" to "k4"), cookie.getCookieParams())
        assertTrue(cookie.getAuthHeaders().isEmpty())
        assertTrue(cookie.getQueryParams().isEmpty())
    }

    @Test
    fun generatedSchemeWrappersValidateEagerlyAndMaskTheKey() {
        assertThrows(IllegalArgumentException::class.java) {
            ApiKeyQueryAuthenticator("https://api.example.com", "")
        }
        assertThrows(IllegalArgumentException::class.java) {
            SessionCookieAuthenticator("https://api.example.com", "a\r\nb")
        }
        assertEquals(
            "SessionCookieAuthenticator(host=https://api.example.com, keyParamName=SESSION_ID, apiKey=***, location=COOKIE)",
            SessionCookieAuthenticator("https://api.example.com", "k4").toString(),
        )
    }

    private fun <T> withEnvironment(values: Map<String, String>, body: () -> T): T {
        val saved = CredentialEnvironment.lookup
        CredentialEnvironment.lookup = { name -> values[name] }
        try {
            return body()
        } finally {
            CredentialEnvironment.lookup = saved
        }
    }

    @Test
    @DisplayName("F862: with no key passed, {{credentialEnvPrefix}}_API_KEY is read once at construction")
    fun keyComesFromTheEnvironment() = runBlocking {
        val auth = withEnvironment(mapOf("{{credentialEnvPrefix}}_API_KEY" to "from-env")) {
            ApiKeyAuthenticator("https://api.example.com", "X-API-Key", location = ApiKeyLocation.HEADER)
        }
        assertEquals("from-env", auth.getAuthHeaders()["X-API-Key"])
    }

    @Test
    @DisplayName("F862: an explicit key wins over the environment, and a missing key fails at construction")
    fun explicitKeyWinsAndAMissingKeyFails() {
        val auth = withEnvironment(mapOf("{{credentialEnvPrefix}}_API_KEY" to "from-env")) {
            ApiKeyAuthenticator("https://api.example.com", "api_key", "explicit", ApiKeyLocation.QUERY)
        }
        assertEquals("explicit", auth.getQueryParams()["api_key"])
        val ex = withEnvironment(emptyMap()) {
            assertThrows(IllegalArgumentException::class.java) {
                ApiKeyAuthenticator("https://api.example.com", "api_key", location = ApiKeyLocation.QUERY)
            }
        }
        assertTrue(ex.message!!.contains("{{credentialEnvPrefix}}_API_KEY"), ex.message)
    }

    @Test
    @DisplayName("F862: a key provider feeds the header, query and cookie locations on every request")
    fun keyProviderFeedsEveryLocation() = runBlocking {
        var calls = 0
        for (location in ApiKeyLocation.values()) {
            val auth = ApiKeyAuthenticator(
                "https://api.example.com", "k", location = location, apiKeyProvider = { "key-" + (++calls) },
            )
            val headers = auth.getAuthHeaders()
            val seen = headers["k"] ?: auth.getQueryParams()["k"] ?: auth.getCookieParams()["k"]
            assertEquals("key-$calls", seen)
        }
        assertEquals(ApiKeyLocation.values().size, calls)
    }
}
