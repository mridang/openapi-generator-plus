class OAuth2TokenManagerTest {

    private class FakeApiClient : ApiClient {
        private val responses = LinkedList<ApiHttpResponse>()
        var lastBody: String? = null
            private set
        var lastUrl: String? = null
            private set
        var lastNoRedirect: Boolean? = null
            private set
        var lastHeaders: Map<String, String> = emptyMap()
            private set
        val bodies = mutableListOf<String?>()

        fun enqueue(body: String, statusCode: Int = 200) {
            responses.add(ApiHttpResponse(statusCode, body, emptyMap()))
        }

        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean
        ): ApiHttpResponse {
            lastUrl = url
            lastBody = body?.toString()
            bodies.add(lastBody)
            lastNoRedirect = noRedirect
            lastHeaders = headers
            return responses.poll() ?: throw IllegalStateException("No responses queued")
        }
    }

    private class HangingApiClient : ApiClient {
        var cancelled = false
            private set

        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean
        ): ApiHttpResponse {
            return try {
                kotlinx.coroutines.awaitCancellation()
            } finally {
                cancelled = true
            }
        }
    }

    @Test
    @DisplayName("bhvMisc172 a token request is sent once and not retried when the server answers 503")
    fun bhvMisc172TokenRequestIsNotRetriedOn503() {
        var attempts = 0
        val engine = MockEngine { _ ->
            attempts++
            respond("{\"error\":\"temporarily_unavailable\"}", HttpStatusCode.ServiceUnavailable, headersOf("Content-Type", "application/json"))
        }
        val manager = OAuth2TokenManager()
        manager.apiClient = DefaultApiClient(HttpClient(engine) { followRedirects = false }, TransportOptions.builder().timeout(null).maxRetries(2).build())
        assertThrows(OAuth2ServerException::class.java) {
            runBlocking {
                manager.getAccessToken("https://auth.example.com/token", mapOf("grant_type" to "client_credentials"))
            }
        }
        assertEquals(1, attempts)
    }

