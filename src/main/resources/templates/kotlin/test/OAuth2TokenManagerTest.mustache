    @Test
    fun invalidateAccessTokenTriggersSingleRefetchUnderConcurrency() {
        // After invalidation, 10 concurrent coroutines must coalesce into
        // exactly ONE additional network round-trip (single-flight), all
        // observing the same freshly fetched token.
        val networkCalls = AtomicInteger(0)
        val client = object : ApiClient {
            override suspend fun sendRequest(
                method: String,
                url: String,
                headers: Map<String, String>,
                body: Any?,
                noRedirect: Boolean
            ): ApiHttpResponse {
                val n = networkCalls.incrementAndGet()
                delay(50)
                return ApiHttpResponse(200, """{"access_token":"tok$n","expires_in":3600}""", emptyMap())
            }
        }
        val manager = OAuth2TokenManager()
        manager.apiClient = client

        val params = mapOf("grant_type" to "client_credentials")
        val tokenUrl = "https://auth.example.com/token"

        val first = runBlocking { manager.getAccessToken(tokenUrl, params) }
        assertEquals("tok1", first)
        assertEquals(1, networkCalls.get())

        manager.invalidateAccessToken()

        val tokens = runBlocking {
            coroutineScope {
                (1..10).map {
                    async { manager.getAccessToken(tokenUrl, params) }
                }.awaitAll()
            }
        }

        assertEquals(2, networkCalls.get(),
            "invalidate + concurrent callers must produce one refetch")
        assertTrue(tokens.all { it == "tok2" }, "all callers must observe the refreshed token")
    }

    @Test
    fun failedRefreshFallsBackToTheOriginalGrant() {
        // The refresh grant carries the cached refresh token and the client
        // credentials; when the endpoint rejects it, the manager re-runs the
        // original grant instead of surfacing the refresh error.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"old","refresh_token":"ref1","expires_in":1}""")
        client.enqueue("""{"error":"invalid_grant"}""", statusCode = 400)
        client.enqueue("""{"access_token":"new","expires_in":3600}""")

        val manager = OAuth2TokenManager()
        manager.apiClient = client

        val params = mapOf(
            "grant_type" to "authorization_code",
            "code" to "abc",
            "client_id" to "cid",
            "client_secret" to "sec",
        )
        val tokenUrl = "https://auth.example.com/token"

        assertEquals("old", runBlocking { manager.getAccessToken(tokenUrl, params) })
        assertEquals("new", runBlocking { manager.getAccessToken(tokenUrl, params) })

        assertEquals(3, client.bodies.size)
        val refresh = client.bodies[1]!!
        assertTrue(refresh.contains("grant_type=refresh_token"), refresh)
        assertTrue(refresh.contains("refresh_token=ref1"), refresh)
        assertTrue(refresh.contains("client_id=cid"), refresh)
        assertTrue(refresh.contains("client_secret=sec"), refresh)
        assertFalse(refresh.contains("code=abc"), refresh)
        val original = client.bodies[2]!!
        assertTrue(original.contains("grant_type=authorization_code"), original)
        assertTrue(original.contains("code=abc"), original)
        assertFalse(original.contains("refresh_token"), original)
    }

    @Test
    fun cancelledRefreshIsNotTreatedAsRefreshFailure() {
        // Coroutine cancellation during the refresh grant must reach the caller;
        // it is not a rejected refresh, so the original grant is not re-run.
        val calls = AtomicInteger(0)
        val manager = OAuth2TokenManager()
        manager.apiClient = object : ApiClient {
            override suspend fun sendRequest(
                method: String,
                url: String,
                headers: Map<String, String>,
                body: Any?,
                noRedirect: Boolean
            ): ApiHttpResponse {
                if (calls.incrementAndGet() == 1) {
                    return ApiHttpResponse(
                        200, """{"access_token":"old","refresh_token":"ref1","expires_in":1}""", emptyMap())
                }
                throw kotlinx.coroutines.CancellationException("stop")
            }
        }
        val params = mapOf("grant_type" to "authorization_code")
        val tokenUrl = "https://auth.example.com/token"

        val outcome = runBlocking {
            manager.getAccessToken(tokenUrl, params)
            try {
                manager.getAccessToken(tokenUrl, params)
                null
            } catch (e: kotlinx.coroutines.CancellationException) {
                e
            }
        }

        assertNotNull(outcome)
        assertEquals("stop", outcome!!.message)
        assertEquals(2, calls.get(), "the original grant must not be re-run after a cancelled refresh")
    }

    @Test
    fun tokenWithoutExpiresInIsCachedIndefinitely() {
        // No expires_in means the lifetime is unknown: the token is kept, so
        // the second call issues no second token request.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"forever"}""")

        val manager = OAuth2TokenManager()
        manager.apiClient = client

        val params = mapOf("grant_type" to "client_credentials")
        val tokenUrl = "https://auth.example.com/token"

        assertEquals("forever", runBlocking { manager.getAccessToken(tokenUrl, params) })
        assertEquals("forever", runBlocking { manager.getAccessToken(tokenUrl, params) })
        assertEquals(1, client.bodies.size)
    }

    @Test
    fun tokenBodyEncodesSpacesAsPlusAndKeepsOnlyRfc3986UnreservedLiteral() {
        // application/x-www-form-urlencoded body: a space is '+', '-._~' stay
        // literal and '*' '!' ''' '(' ')' are percent-encoded.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok","expires_in":3600}""")

        val manager = OAuth2TokenManager()
        manager.apiClient = client

        runBlocking {
            manager.getAccessToken(
                "https://auth.example.com/token",
                mapOf(
                    "grant_type" to "client_credentials",
                    "scope" to "read write",
                    "client_id" to "a-b._~c*d!e'f(g)h",
                ),
            )
        }

        assertEquals(
            "grant_type=client_credentials&scope=read+write&client_id=a-b._~c%2Ad%21e%27f%28g%29h",
            client.lastBody,
        )
    }

    @Test
    fun serverErrorMessageNamesTheStatusAndTheCodeAndDescriptionWhenPresent() {
        // Three message forms: raw body when the answer is not an OAuth2 error
        // object, the code alone, and the code with its description.
        val raw = oauth2ErrorFor("upstream exploded")
        assertEquals("Token request failed with status 400: upstream exploded", raw.message)

        val codeOnly = oauth2ErrorFor("""{"error":"invalid_grant"}""")
        assertEquals("Token request failed with status 400: invalid_grant", codeOnly.message)

        val full = oauth2ErrorFor(
            """{"error":"invalid_grant","error_description":"refresh token expired"}"""
        )
        assertEquals(
            "Token request failed with status 400: invalid_grant -- refresh token expired",
            full.message,
        )
    }
