package {{invokerPackage}}.auth.oauth

import {{invokerPackage}}.ApiClient
import {{invokerPackage}}.ApiHttpResponse
import {{invokerPackage}}.auth.CredentialEnvironment
import kotlinx.coroutines.runBlocking
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.Test
import java.util.LinkedList

class OAuth2ClientCredentialsAuthenticatorTest {

    private class FakeApiClient : ApiClient {
        private val responses = LinkedList<ApiHttpResponse>()
        var lastBody: String? = null
            private set
        var lastUrl: String? = null
            private set
        var lastHeaders: Map<String, String> = emptyMap()
            private set

        fun enqueue(body: String, statusCode: Int = 200) {
            responses.add(ApiHttpResponse(statusCode, body, emptyMap()))
        }

        override suspend fun sendRequest(
            method: String,
            url: String,
            headers: Map<String, String>,
            body: Any?,
            noRedirect: Boolean
        ): ApiHttpResponse {
            lastUrl = url
            lastHeaders = headers
            lastBody = body?.toString()
            return responses.poll() ?: throw IllegalStateException("No responses queued")
        }
    }

    private fun createAuthenticator(): OAuth2ClientCredentialsAuthenticator {
        return OAuth2ClientCredentialsAuthenticator(
            host = "https://api.example.com",
            clientId = "my-client-id",
            clientSecret = "my-client-secret",
            tokenUrl = "https://auth.example.com/token",
            scopes = listOf("read", "write")
        )
    }

    @Test
    fun bhvAuthoauthtwoclientcred005InvalidateAccessTokenMakesTheNextCallFetchANewToken() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")
        client.enqueue("""{"access_token":"tok2","expires_in":3600}""")
        val auth = createAuthenticator()
        auth.setApiClient(client)

        val first = runBlocking { auth.getAuthHeaders() }["Authorization"]
        val cached = runBlocking { auth.getAuthHeaders() }["Authorization"]
        auth.invalidateAccessToken()
        val second = runBlocking { auth.getAuthHeaders() }["Authorization"]

        assertEquals("Bearer tok1", first)
        assertEquals("Bearer tok1", cached)
        assertEquals("Bearer tok2", second)
    }

    @Test
    fun bhvAuthoauthtwoclientcred010SendsClientCredentialsGrantType() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        assertNotNull(client.lastBody)
        assertTrue(client.lastBody!!.contains("grant_type=client_credentials"))
    }

    @Test
    fun bhvAuthoauthtwoclientcred011SendsClientIdAndSecret() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        assertTrue(client.lastBody!!.contains("client_id=my-client-id"))
        assertTrue(client.lastBody!!.contains("client_secret=my-client-secret"))
    }

    @Test
    fun bhvAuthoauthtwoclientcred013SendsScopes() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        assertTrue(client.lastBody!!.contains("scope=read+write"), client.lastBody)
        assertFalse(client.lastBody!!.contains("scope=read%20write"), client.lastBody)
    }

    @Test
    fun bhvAuthoauthtwoclientcred008ReturnsAuthorizationBearerHeader() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok-abc","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        val headers = runBlocking { auth.getAuthHeaders() }

        assertEquals("Bearer tok-abc", headers["Authorization"])
    }

    @Test
    fun bhvAuthoauthtwoclientcred012SendsRequestToTokenUrl() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"tok1","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        assertEquals("https://auth.example.com/token", client.lastUrl)
    }

    @Test
    fun bhvAuthoauthtwoclientcred004GetHostReturnsConfiguredHost() {
        val auth = createAuthenticator()

        assertEquals("https://api.example.com", auth.getHost())
    }

    @Test
    fun bhvAuthoauthtwoclientcred015TokenFetchErrorIsSurfacedNotSwallowed() {
        // oauth-cc-authheaders-error-swallow: a failed client-credentials token
        // exchange must surface to the caller as a thrown error — NOT be
        // swallowed into an empty header map that would send the API request
        // unauthenticated and produce a confusing downstream 401.
        val client = FakeApiClient()
        client.enqueue("""{"error":"invalid_client"}""", statusCode = 401)

        val auth = createAuthenticator()
        auth.setApiClient(client)

        assertThrowsExactly({{invokerPackage}}.errors.OAuth2ServerException::class.java) {
            runBlocking { auth.getAuthHeaders() }
        }
    }

    @Test
    fun bhvAuthoauthtwoclientcred003CachesTokenAcrossCalls() {
        // The token manager caches the access token until expiry, so two
        // consecutive header requests reuse the same token and issue only a
        // single token request. Only one response is enqueued; a second token
        // fetch would poll() an empty queue and throw, proving single-flight.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"cached-cc-token","expires_in":3600}""")

        val auth = createAuthenticator()
        auth.setApiClient(client)

        val headers1 = runBlocking { auth.getAuthHeaders() }
        val headers2 = runBlocking { auth.getAuthHeaders() }

        assertEquals("Bearer cached-cc-token", headers1["Authorization"])
        assertEquals("Bearer cached-cc-token", headers2["Authorization"])
    }

    @Test
    fun bhvAuthoauthtwoclientcred002BasicAuthUrlEncodesClientIdAndSecret() {
        // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
        // client_id and client_secret MUST be application/x-www-form-
        // urlencoded BEFORE being joined with ':' and base64-encoded.
        // Verifies a client_id with `+` and a secret with `&` are encoded
        // (not raw) before the colon-join + base64.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"at","expires_in":3600}""")

        val auth = OAuth2ClientCredentialsAuthenticator(
            host = "https://api.example.com",
            clientId = "id+with/special",
            clientSecret = "secret&with=stuff",
            tokenUrl = "https://auth.example.com/token",
            scopes = listOf("read"),
            clientAuthMethod = ClientAuthMethod.BASIC
        )
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        val authHeader = client.lastHeaders["Authorization"]
        assertNotNull(authHeader)
        assertTrue(authHeader!!.startsWith("Basic "))
        val decoded = String(
            java.util.Base64.getDecoder().decode(authHeader.substring("Basic ".length)),
            Charsets.UTF_8
        )
        // Expected: form-urlencoded id ':' form-urlencoded secret
        assertEquals("id%2Bwith%2Fspecial:secret%26with%3Dstuff", decoded)
    }

    @Test
    fun bhvAuthoauthtwoclientcred007RedactsSecret() {
        val auth = createAuthenticator()
        val rendered = auth.toString()
        assertFalse(rendered.contains("my-client-secret"))
        assertTrue(rendered.contains("***"))
    }

    @Test
    fun bhvAuthoauthtwoclientcred014RedactedReprShowsExactlyTheNonSecretFields() {
        assertEquals(
            "OAuth2ClientCredentialsAuthenticator(host=https://api.example.com, clientId=my-client-id, " +
                "clientSecret=***, tokenUrl=https://auth.example.com/token, scopes=[read, write], " +
                "clientAuthMethod=BODY)",
            createAuthenticator().toString(),
        )
    }

    @Test
    fun bhvAuthoauthtwoclientcred001BasicAuthKeepsUnreservedCharactersLiteralAndEncodesTheRest() {
        // RFC 6749 section 2.3.1 plus the shared unreserved set: '-._~' stay
        // literal and '*' '!' ''' '(' ')' are percent-encoded in both parts.
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"at","expires_in":3600}""")

        val auth = OAuth2ClientCredentialsAuthenticator(
            host = "https://api.example.com",
            clientId = "id-._~*!'()",
            clientSecret = "sec-._~*!'()",
            tokenUrl = "https://auth.example.com/token",
            scopes = listOf("read"),
            clientAuthMethod = ClientAuthMethod.BASIC
        )
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }

        val authHeader = client.lastHeaders["Authorization"]!!
        val decoded = String(
            java.util.Base64.getDecoder().decode(authHeader.substring("Basic ".length)),
            Charsets.UTF_8
        )
        assertEquals("id-._~%2A%21%27%28%29:sec-._~%2A%21%27%28%29", decoded)
    }

    @Test
    fun bhvAuthoauthtwoclientcred009GeneratedSchemeWrapperSendsItsSpecScopesToItsTokenUrl() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"wrapped","expires_in":3600}""")

        val auth =
            MachineAuthClientCredentialsAuthenticator("https://api.example.com", "cid", "sec")
        auth.setApiClient(client)

        val headers = runBlocking { auth.getAuthHeaders() }

        assertEquals("Bearer wrapped", headers["Authorization"])
        assertEquals("https://auth.example.com/oauth/token", client.lastUrl)
        assertTrue(client.lastBody!!.contains("scope=pets%3Aread+pets%3Awrite"), client.lastBody)
    }

    private fun <T> withEnvironment(values: Map<String, String>, body: () -> T): T {
        val saved = CredentialEnvironment.lookup
        CredentialEnvironment.lookup = { name -> values[name] }
        try {
            return body()
        } finally {
            CredentialEnvironment.lookup = saved
        }
    }

    @Test
    fun generatedSchemeWrapperReadsItsCredentialsFromItsOwnVariables() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"from-env","expires_in":3600}""")
        val env = mapOf(
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_ID" to "env-id",
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_SECRET" to "env-" + "secret",
        )
        val auth =
            withEnvironment(env) { MachineAuthClientCredentialsAuthenticator("https://api.example.com") }
        auth.setApiClient(client)

        assertEquals("Bearer from-env", runBlocking { auth.getAuthHeaders() }["Authorization"])
        assertTrue(client.lastBody!!.contains("client_id=env-id"), client.lastBody)
    }

    @Test
    fun generatedSchemeWrapperPrefersTheArgumentToItsVariable() {
        val client = FakeApiClient()
        client.enqueue("""{"access_token":"explicit","expires_in":3600}""")
        val env = mapOf(
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_ID" to "env-id",
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_SECRET" to "env-" + "secret",
        )
        val auth =
            withEnvironment(env) { MachineAuthClientCredentialsAuthenticator("https://api.example.com", "arg-id") }
        auth.setApiClient(client)

        runBlocking { auth.getAuthHeaders() }
        assertTrue(client.lastBody!!.contains("client_id=arg-id"), client.lastBody)
    }

    @Test
    fun generatedSchemeWrapperTreatsAnEmptyVariableAsUnsetAndNamesTheMissingOne() {
        val env = mapOf(
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_ID" to "env-id",
            "{{envVarPrefix}}_MACHINE_AUTH_CLIENT_SECRET" to "",
        )
        val ex = withEnvironment(env) {
            assertThrows(IllegalArgumentException::class.java) {
                MachineAuthClientCredentialsAuthenticator("https://api.example.com")
            }
        }
        assertTrue(ex.message!!.contains("{{envVarPrefix}}_MACHINE_AUTH_CLIENT_SECRET"), ex.message)
        val missing = withEnvironment(emptyMap()) {
            assertThrows(IllegalArgumentException::class.java) {
                MachineAuthClientCredentialsAuthenticator("https://api.example.com")
            }
        }
        assertTrue(missing.message!!.contains("{{envVarPrefix}}_MACHINE_AUTH_CLIENT_ID"), missing.message)
    }
}
