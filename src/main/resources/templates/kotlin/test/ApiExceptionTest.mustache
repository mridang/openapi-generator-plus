    @Nested
    @DisplayName("wire error behaviours")
    inner class WireErrorBehaviours {

        @Test
        @DisplayName("bhvErrors072 an error body that starts with a byte order mark decodes the same as the body without it")
        fun bomPrefixedErrorBodyDecodesTheSame() {
            val objects = ObjectSerializer()
            val withBom = objects.deserialize<{{modelPackage}}.Pet>("﻿{\"name\":\"dog\",\"photoUrls\":[]}")
            val without = objects.deserialize<{{modelPackage}}.Pet>("{\"name\":\"dog\",\"photoUrls\":[]}")
            assertEquals(without, withBom)
        }

        @Test
        @DisplayName("bhvErrors073 an error body nested beyond common parser defaults is parsed and kept as structured data")
        fun deeplyNestedErrorBodyIsKeptAsStructuredData() {
            val deep = "[".repeat(200) + "]".repeat(200)
            val parsed = ObjectSerializer().parseToJsonElement(deep)
            assertTrue(parsed is kotlinx.serialization.json.JsonArray, parsed.toString().take(40))
        }

        @Test
        @DisplayName("bhvErrors074 an error that never received an HTTP response renders its text as the message alone")
        fun errorWithoutResponseRendersMessageAlone() {
            val ex = NetworkException("connection refused", java.io.IOException("refused"))
            assertEquals("connection refused", ex.message)
            assertEquals(0, ex.statusCode)
        }

        @Test
        @DisplayName("bhvErrors076 an error the SDK did not raise is not classified as one of the SDK errors, even when wrapped")
        fun foreignErrorIsNotClassifiedAsSdkError() {
            val wrapped = RuntimeException("outer", IllegalStateException("inner"))
            assertFalse(wrapped is {{invokerPackage}}.errors.{{errorPrefix}}Exception)
        }

        @Test
        @DisplayName("bhvErrors077 a URL written into diagnostics keeps scheme, host, port and path and drops query, userinfo and fragment")
        fun diagnosticUrlDropsQueryUserInfoAndFragment() {
            assertEquals(
                "https://api.example.com:8443/v1/items",
                redactUrl("https://user:secret@api.example.com:8443/v1/items?api_key=k#frag"),
            )
        }

        @Test
        @DisplayName("bhvErrors078 a transport failure message never shows the query string of the request URL")
        fun transportFailureMessageHidesTheQueryString() {
