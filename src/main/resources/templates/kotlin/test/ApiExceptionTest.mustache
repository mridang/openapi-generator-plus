class ApiExceptionTest {

    @Test
    fun bhvErrors004ExposesStatusCodeMessageBodyHeadersErrorBody() {
        val ex = ApiException(
            statusCode = 404,
            message = "not found",
            responseHeaders = mapOf("content-type" to "application/json"),
            responseBody = "{\"id\":7,\"name\":\"missing\"}",
            errorBody = null
        )

        assertEquals(404, ex.statusCode)
        assertEquals("{\"id\":7,\"name\":\"missing\"}", ex.responseBody)
        assertEquals("application/json", ex.responseHeaders?.get("content-type"))
        assertNull(ex.errorBody)
    }

    @Test
    fun bhvErrors021NullHeadersAndBodyMarkTransportNoResponse() {
        // apierror-responsebody-headers-nullable-split: null is distinct from an
        // empty header map / empty body so a pre-response transport failure can
        // be encoded.
        val ex = ApiException(
            statusCode = 0,
            message = "connection reset",
            responseHeaders = null,
            responseBody = null
        )

        assertNull(ex.responseHeaders)
        assertNull(ex.responseBody)
    }

    @Test
    fun bhvErrors019IsAnExceptionWithStatusInItsStringForm() {
        // message stays the detail message the exception was constructed with;
        // the response context is rendered by the string conversion, one
        // labelled field per line.
        val ex = ApiException(
            statusCode = 500,
            message = "boom",
            responseHeaders = mapOf("x-request-id" to "abc"),
            responseBody = "the body"
        )

        assertTrue(ex is Exception)
        assertTrue(ex is {{errorPrefix}}Exception)
        assertEquals("boom", ex.message)
        assertEquals(
            "boom" +
                "\nHTTP status code: 500" +
                "\nResponse headers: {\"x-request-id\":\"abc\"}" +
                "\nResponse body: the body",
            ex.toString(),
        )
    }

    @Test
    fun bhvErrors024RequestContextIsRenderedBetweenTheStatusAndTheHeaders() {
        val ex = ApiException(
            statusCode = 500,
            message = "boom",
            responseHeaders = mapOf("x-request-id" to "abc"),
            responseBody = "the body",
            requestMethod = "PUT",
            requestPath = "/items/3",
        )

        assertEquals("PUT", ex.requestMethod)
        assertEquals("/items/3", ex.requestPath)
        assertEquals(
            "boom" +
                "\nHTTP status code: 500" +
                "\nRequest: PUT /items/3" +
                "\nResponse headers: {\"x-request-id\":\"abc\"}" +
                "\nResponse body: the body",
            ex.toString(),
        )
    }

    @Test
    fun bhvErrors012NoRequestContextMeansNoRequestLine() {
        val ex = ApiException(statusCode = 500, message = "boom", responseHeaders = null, responseBody = null)

        assertNull(ex.requestMethod)
        assertNull(ex.requestPath)
        assertFalse(ex.toString().contains("Request:"), ex.toString())
    }

    @Test
    fun bhvErrors002EveryStatusExceptionCarriesTheRequestFromFromResponse() {
        for (status in listOf(400, 401, 403, 404, 409, 418, 422, 429, 500, 503, 302)) {
            val ex = ApiException.fromResponse(status, emptyMap(), null, "DELETE", "/items/3")

            assertEquals("DELETE", ex.requestMethod, "status $status")
            assertEquals("/items/3", ex.requestPath, "status $status")
        }
    }

    @Test
    fun networkExceptionsCarryTheRequestToo() {
        val cause = java.io.IOException("connection refused")
        val network = {{invokerPackage}}.errors.NetworkException("refused", cause, "GET", "/items")
        val timeout = {{invokerPackage}}.errors.NetworkTimeoutException("slow", cause, "GET", "/items")

        assertEquals("GET", network.requestMethod)
        assertEquals("/items", timeout.requestPath)
        assertTrue(timeout.toString().contains("\nRequest: GET /items"), timeout.toString())
    }

