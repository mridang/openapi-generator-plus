    @Test
    fun bhvErrors003StatusSpecificExceptionsKeepAnOptionalCause() {
        val cause = IllegalStateException("root")
        assertSame(cause, BadRequestException("bad", cause = cause).cause)
        assertSame(cause, NotFoundException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.PaymentRequiredException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.MethodNotAllowedException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.RequestTimeoutException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.GoneException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.PayloadTooLargeException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.UnsupportedMediaTypeException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.LockedException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.NotImplementedException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.BadGatewayException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.ServiceUnavailableException("gone", cause = cause).cause)
        assertSame(cause, {{invokerPackage}}.errors.GatewayTimeoutException("gone", cause = cause).cause)
        assertSame(cause, ClientException(418, "teapot", cause = cause).cause)
        assertSame(cause, ServerException(503, "down", cause = cause).cause)
        assertNull(NotFoundException("gone").cause)
    }

