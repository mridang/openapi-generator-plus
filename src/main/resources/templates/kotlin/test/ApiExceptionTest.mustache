    @Test
    fun statusErrorConstructorsDefaultTheResponseContextToNull() {
        val bad = BadRequestException()
        assertEquals(400, bad.statusCode)
        assertEquals("", bad.message)
        assertNull(bad.responseHeaders)
        assertNull(bad.responseBody)
        assertNull(bad.errorBody)

        val missing = NotFoundException("gone")
        assertEquals(404, missing.statusCode)
        assertNull(missing.responseHeaders)

        val client = ClientException(418, "teapot")
        assertEquals(418, client.statusCode)
        assertEquals("teapot", client.message)
        assertNull(client.responseHeaders)
        assertNull(client.responseBody)
        assertNull(client.errorBody)

        val server = ServerException(503, "down")
        assertEquals(503, server.statusCode)
        assertNull(server.responseHeaders)
    }

    @Test
    fun bhvErrors020NetworkExceptionsExtendApiExceptionWithStatusZero() {
        // No HTTP response arrived, so the status is 0 and the transport
        // failure is kept as the cause. Both sit under ApiException so an
        // existing catch on ApiException keeps catching them.
        val cause = java.io.IOException("connection refused")
        val network = {{invokerPackage}}.errors.NetworkException("connection refused", cause)
        val timeout = {{invokerPackage}}.errors.NetworkTimeoutException("timed out", cause)

        assertTrue(network is ApiException)
        assertEquals(0, network.statusCode)
        assertSame(cause, network.cause)
        assertTrue(timeout is {{invokerPackage}}.errors.NetworkException)
        assertTrue(timeout is ApiException)
        assertEquals(0, timeout.statusCode)
        assertSame(cause, timeout.cause)
    }

    @Test
    fun bhvErrors045OAuth2ErrorsAreRootedAtTheBrandedBaseNotAtApiException() {
        // The token endpoint errors are SDK errors, but they are not HTTP ApiExceptions.
        val server = {{invokerPackage}}.errors.OAuth2ServerException(400, "invalid_grant", null, null, "{}")
        val token = {{invokerPackage}}.errors.OAuth2TokenException("no access_token")

        assertTrue(server is {{errorPrefix}}Exception)
        assertTrue(token is {{errorPrefix}}Exception)
        assertFalse(ApiException::class.java.isInstance(server))
        assertFalse(ApiException::class.java.isInstance(token))
    }

