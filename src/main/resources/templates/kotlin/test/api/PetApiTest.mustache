        @Test
        @DisplayName("required-nested-param-validation: missing required query param fails loud")
        fun testGetPetByNameMissingRequiredQueryFailsLoud() {
            // required-nested-param-validation: `category` is a REQUIRED query
            // param carried in options. A null value (e.g. arriving via Java
            // interop, which bypasses Kotlin's compile-time null check) must
            // fail loud, never be silently dropped from the request. The
            // generated getPetByName emits a requireNotNull guard mirroring the
            // path/body checks; the non-null Options field is a second barrier.
            // Either way a null required param surfaces a RuntimeException.
            val config =
                Configuration
                    .builder()
                    .baseUrl("http://localhost")
                    .build()
            val api = PetApi(DefaultApiClient(), config)

            // forceNull() launders a null through an erased type parameter so it
            // reaches the required slot the way a null crosses the Java/Kotlin
            // boundary, rather than being rejected at a cast site in the test.
            assertThrows(RuntimeException::class.java) {
                runBlocking {
                    api.getPetByName("Rex", GetPetByNameOptions(category = forceNull()))
                }
            }
        }

        @Test
        @DisplayName("required-nested-param-validation: empty required string query param fails loud")
        fun testGetPetByNameEmptyRequiredQueryFailsLoud() {
            // required-nested-param-validation: a REQUIRED string param must be
            // rejected when it is the empty string, not just when it is null.
            // This mirrors go/rust/swift/elixir, which treat "" as missing for a
            // required string. The generated guard adds an isNotEmpty() check
            // alongside the requireNotNull, so an empty `category` fails loud.
            val config =
                Configuration
                    .builder()
                    .baseUrl("http://localhost")
                    .build()
            val api = PetApi(DefaultApiClient(), config)

            assertThrows(IllegalArgumentException::class.java) {
                runBlocking {
                    api.getPetByName("Rex", GetPetByNameOptions(category = ""))
                }
            }
        }

        @Test
        @DisplayName("per-call auth override on base method wins on the wire")
        fun testAddPetPerCallAuthOverride() {
            // Verify the auth argument on the BASE operation method (not just the
            // WithHttpInfo variant) is applied to the outgoing request. The
            // default header carries one token; the per-call authenticator
            // carries a different one and must win on the wire.
            var capturedAuth: String? = null
            val engine =
                MockEngine { request ->
                    capturedAuth = request.headers["Authorization"]
                    respond(
                        content = """{"id":1,"name":"x","photoUrls":[]}""",
                        status = HttpStatusCode.OK,
                        headers = headersOf("Content-Type", "application/json"),
                    )
                }
            val config =
                Configuration
                    .builder()
                    .baseUrl("http://localhost")
                    .defaultHeader("Authorization", "Bearer default-token")
                    .build()
            val api = PetApi(DefaultApiClient(HttpClient(engine)), config)
            val perCallAuth = PetStoreBearerAuthenticator("http://localhost", "per-call-token")

            val pet = Pet(name = "OverrideDog", photoUrls = setOf("http://example.com/p.jpg"))
            runBlocking { api.addPet(pet, AddPetOptions(auth = perCallAuth)) }

            assertEquals("Bearer per-call-token", capturedAuth)
        }

