        @Test
        @DisplayName("bhvOperations110 getOrderById picks the status-specific error class for each typed status route")
        fun testGetOrderByIdPicksTheStatusSpecificErrorClass() {
            val cases = listOf(
                400 to "BadRequestException",
                401 to "UnauthorizedException",
                403 to "ForbiddenException",
                409 to "ConflictException",
                418 to "ClientException",
                422 to "UnprocessableEntityException",
                502 to "BadGatewayException",
            )
            for ((status, expected) in cases) {
                val config = Configuration.builder().baseUrl("${getBaseUrl()}/test/status/$status").build()
                val typedApi = StoreApi(DefaultApiClient(TransportOptions.builder().maxRetries(0).build()), config)
                val ex = assertThrows(ApiException::class.java) { runBlocking { typedApi.getOrderById(1L) } }
                assertEquals(expected, ex.javaClass.simpleName, "status $status")
                assertEquals(status, ex.statusCode)
            }
        }

