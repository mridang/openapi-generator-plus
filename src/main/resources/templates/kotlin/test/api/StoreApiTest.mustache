        private fun capturingStoreApi(
            responseBody: String,
            status: HttpStatusCode = HttpStatusCode.OK,
            capture: (io.ktor.client.request.HttpRequestData, String) -> Unit = { _, _ -> },
        ): StoreApi {
            val engine =
                MockEngine { request ->
                    capture(request, String(request.body.toByteArray(), Charsets.UTF_8))
                    respond(
                        content = responseBody,
                        status = status,
                        headers = headersOf("Content-Type", "application/json"),
                    )
                }
            val config = Configuration.builder().baseUrl("http://localhost").build()
            return StoreApi(DefaultApiClient(HttpClient(engine)), config)
        }

