    @Nested
    @DisplayName("oneOf with format:byte variants - SetPetAvatarThumbnailRequest")
    inner class SetPetAvatarThumbnailRequestTests {

        // SetPetAvatarThumbnailRequest is a oneOf of [ a scalar format:byte value,
        // an array of format:byte values ]. format:byte means the value travels on
        // the wire as a base64 STRING. A reified serializer<ByteArray>() resolves
        // kotlinx's built-in ByteArraySerializer (a JSON int-array), so the wrapper
        // must route the byte variants through Base64ByteArraySerializer explicitly
        // on BOTH encode and decode -- this test pins that wire form.

        @Test
        @DisplayName("bhvUnions019 setPetAvatarThumbnail byte oneOf round-trips through base64")
        fun testScalarByteVariantRoundTripsThroughBase64() {
            val raw = byteArrayOf(0x01, 0x02, 0x03, 0x04)
            val request = SetPetAvatarThumbnailRequest(actualInstance = raw)

            val encoded = json.encodeToString(request)
            // The scalar byte variant must serialize to the base64 STRING
            // "AQIDBA==" -- NOT a JSON int-array [1,2,3,4], NOT raw/unencoded
            // bytes, NOT a [B@hash toString of the array.
            assertEquals("\"AQIDBA==\"", encoded)
            assertFalse(encoded.contains("[1,2,3,4]"))
            assertFalse(encoded.contains("[1, 2, 3, 4]"))

            // Round-trip: the base64 string must decode back to the SCALAR variant
            // holding exactly the original 4 bytes -- never element-by-element into
            // a List<ByteArray>.
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>(encoded)
            assertTrue(restored.actualInstance is ByteArray)
            assertArrayEquals(raw, restored.actualInstance as ByteArray)
        }

        @Test
        @DisplayName("bhvUnions022 setPetAvatarThumbnail array byte oneOf round-trips through base64")
        fun testArrayByteVariantRoundTripsThroughBase64() {
            val first = byteArrayOf(0x01)
            val second = byteArrayOf(0x02)
            val request = SetPetAvatarThumbnailRequest(actualInstance = listOf(first, second))

            val encoded = json.encodeToString(request)
            // The array variant must serialize to a JSON array of base64 STRINGS.
            assertEquals("[\"AQ==\",\"Ag==\"]", encoded)

            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>(encoded)
            @Suppress("UNCHECKED_CAST")
            val payloads = restored.actualInstance as List<ByteArray>
            assertEquals(2, payloads.size)
            assertArrayEquals(first, payloads[0])
            assertArrayEquals(second, payloads[1])
        }

        @Test
        @DisplayName("bhvUnions023 setPetAvatarThumbnail byte oneOf round-trips through base64")
        fun testScalarByteVariantDecodesAndReencodesTheSameBase64() {
            val wire = "\"AQIDBA==\""
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>(wire)
            assertTrue(restored.actualInstance is ByteArray)
            assertArrayEquals(byteArrayOf(0x01, 0x02, 0x03, 0x04), restored.actualInstance as ByteArray)
            assertEquals(wire, json.encodeToString(restored))
        }

        @Test
        @DisplayName("bhvUnions018 a base64 scalar string deserializes to the scalar variant, not a list")
        fun testScalarStringIsNotMisParsedAsList() {
            // Ordering guard: a lone base64 string must resolve to the scalar
            // ByteArray variant (one value), NOT be coerced element-by-element
            // into a List<ByteArray>.
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>("\"AQIDBA==\"")

            assertTrue(restored.actualInstance is ByteArray)
            assertFalse(restored.actualInstance is List<*>)
            assertArrayEquals(byteArrayOf(0x01, 0x02, 0x03, 0x04), restored.actualInstance as ByteArray)
        }

        @Test
        @DisplayName("bhvUnions025 tries variants in declaration order: an empty array is the byte variant, not the list")
        fun testVariantsAreTriedInDeclarationOrder() {
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>("[]")

            assertTrue(restored.actualInstance is ByteArray)
        }

        @Test
        @DisplayName("bhvUnions029 oneOf wrappers have value equality, comparing byte arrays by content")
        fun testOneOfValueEquality() {
            val first = SetPetAvatarThumbnailRequest(actualInstance = byteArrayOf(0x01, 0x02))
            val second = SetPetAvatarThumbnailRequest(actualInstance = byteArrayOf(0x01, 0x02))
            val other = SetPetAvatarThumbnailRequest(actualInstance = byteArrayOf(0x03))
            val lists =
                SetPetAvatarThumbnailRequest(actualInstance = listOf(byteArrayOf(0x01)))
            val sameLists =
                SetPetAvatarThumbnailRequest(actualInstance = listOf(byteArrayOf(0x01)))

            assertEquals(first, second)
            assertEquals(first.hashCode(), second.hashCode())
            assertNotEquals(first, other)
            assertEquals(lists, sameLists)
            assertEquals(lists.hashCode(), sameLists.hashCode())
            assertNotEquals(first, lists)
        }
    }

    @Nested
    @DisplayName("oneOf typed factories and accessors - ReserveStockResponse")
    inner class ReserveStockResponseAccessorTests {

        @Test
        @DisplayName("bhvUnions001 a factory wraps its variant and only its is accessor answers true")
        fun testFactoryWrapsItsVariant() {
            val reservation = Reservation(reservationId = 31L, quantity = 4)
            val union = ReserveStockResponse.fromReservation(reservation)

            assertSame(reservation, union.actualInstance)
            assertTrue(union.isReservation)
            assertFalse(union.isReservationReceipt)
        }

        @Test
        @DisplayName("bhvUnions034 an as accessor returns the variant, or null for the other one")
        fun testAsAccessorsReturnTheVariantOrNull() {
            val receipt =
                ReservationReceipt(receiptCode = "rcpt-77", expiresAt = java.time.OffsetDateTime.parse("2030-01-01T00:00:00Z"))
            val union = ReserveStockResponse.fromReservationReceipt(receipt)

            assertSame(receipt, union.asReservationReceipt())
            assertNull(union.asReservation())
        }

        @Test
        @DisplayName("a union built by a factory equals one built from the same variant by the constructor")
        fun testFactoryAndConstructorAgree() {
            val reservation = Reservation(reservationId = 31L, quantity = 4)

            assertEquals(ReserveStockResponse(reservation), ReserveStockResponse.fromReservation(reservation))
        }

        @Test
        @DisplayName("bhvUnions042 a union with no variant answers false and null to every accessor")
        fun testEmptyUnionAnswersNothing() {
            val union = ReserveStockResponse()

            assertFalse(union.isReservation)
            assertNull(union.asReservation())
            assertFalse(union.isReservationReceipt)
            assertNull(union.asReservationReceipt())
        }
    }

    @Nested
    @DisplayName("anyOf typed factories and accessors - PetTreatment")
    inner class PetTreatmentAccessorTests {

        @Test
        @DisplayName("a factory wraps its variant and only its is accessor answers true")
        fun testFactoryWrapsItsVariant() {
            val medication = Medication(drugName = "Amoxicillin", dosage = "500mg")
            val union = PetTreatment.fromMedication(medication)

            assertSame(medication, union.actualInstance)
            assertTrue(union.isMedication)
            assertFalse(union.isSurgery)
            assertSame(medication, union.asMedication())
            assertNull(union.asSurgery())
        }

        @Test
        @DisplayName("a payload that satisfies both variants answers true to both accessors")
        fun testBothRetainedVariantsAreReachable() {
            val union =
                json.decodeFromString<PetTreatment>(
                    """{"drugName":"Amoxicillin","dosage":"500mg","procedureName":"Spay","durationMinutes":45}""",
                )

            assertTrue(union.isMedication)
            assertTrue(union.isSurgery)
            assertEquals("Amoxicillin", union.asMedication()!!.drugName)
            assertEquals("Spay", union.asSurgery()!!.procedureName)
        }

        @Test
        @DisplayName("a union with no variant answers false and null to every accessor")
        fun testEmptyUnionAnswersNothing() {
            val union = PetTreatment()

            assertFalse(union.isMedication)
            assertNull(union.asMedication())
            assertFalse(union.isSurgery)
            assertNull(union.asSurgery())
        }
    }
