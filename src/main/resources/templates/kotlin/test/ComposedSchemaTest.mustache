package {{invokerPackage}}.models

import {{modelPackage}}.*
import kotlinx.serialization.json.Json
import kotlinx.serialization.encodeToString
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.DisplayName
import org.junit.jupiter.api.Nested
import org.junit.jupiter.api.Test

class ComposedSchemaTest {

    private val json = Json {
        ignoreUnknownKeys = true
        encodeDefaults = false
        isLenient = true
        coerceInputValues = true
    }

    @Nested
    @DisplayName("oneOf with discriminator - DryFood")
    inner class DryFoodTests {

        @Test
        @DisplayName("deserializes DryFood from JSON")
        fun testDeserializeDryFood() {
            val jsonString = """{"foodType":"dry","weightKg":2.5}"""

            val result = json.decodeFromString<DryFood>(jsonString)

            assertNotNull(result)
            assertEquals("dry", result.foodType)
            assertEquals(2.5, result.weightKg)
        }

        @Test
        @DisplayName("deserializes WetFood from JSON")
        fun testDeserializeWetFood() {
            val jsonString = """{"foodType":"wet","volumeMl":400}"""

            val result = json.decodeFromString<WetFood>(jsonString)

            assertNotNull(result)
            assertEquals("wet", result.foodType)
            assertEquals(400, result.volumeMl)
        }

        @Test
        @DisplayName("returns null for unknown discriminator value")
        fun testUnknownDiscriminator() {
            val jsonString = """{"foodType":"raw","calories":300}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("fails to deserialize when discriminator field is missing")
        fun testMissingDiscriminator() {
            val jsonString = """{"weightKg":2.5}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("fails to deserialize when discriminator value is empty")
        fun testEmptyDiscriminator() {
            // An empty discriminator value matches no listed subtype and must
            // not be silently routed; kotlinx fails the decode (null here).
            val jsonString = """{"foodType":"","weightKg":2.5}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("unknown discriminator error names the offending value")
        fun testUnknownDiscriminatorErrorNamesValue() {
            // The hand-written discriminator serializer surfaces the offending
            // value in its message, unlike kotlinx's built-in polymorphic decode.
            val jsonString = """{"foodType":"raw","calories":300}"""
            val ex = assertThrows(Exception::class.java) {
                json.decodeFromString<PetFood>(jsonString)
            }
            assertTrue(ex.message!!.contains("raw"))
        }

        @Test
        @DisplayName("serializes DryFood back to JSON")
        fun testSerializeDryFood() {
            val encodingJson = Json {
                ignoreUnknownKeys = true
                encodeDefaults = true
                isLenient = true
                coerceInputValues = true
            }
            val dryFood = DryFood(weightKg = 2.5)

            val jsonString = encodingJson.encodeToString(dryFood)

            assertNotNull(jsonString)
            assertTrue(jsonString.contains("\"foodType\":\"dry\""))
            assertTrue(jsonString.contains("2.5"))
        }
    }

    @Nested
    @DisplayName("anyOf - PetTreatment")
    inner class PetTreatmentTests {

        @Test
        @DisplayName("deserializes a matching variant into actualInstance")
        fun testDeserialize() {
            // The wrapper now resolves the bare payload against each declared
            // variant and stores the concrete match in actualInstance, instead
            // of silently decoding to an empty wrapper (the previous defect).
            val jsonString = """{"drugName":"Amoxicillin","dosage":"500mg"}"""

            val result = json.decodeFromString<PetTreatment>(jsonString)

            assertNotNull(result)
            assertTrue(result.actualInstance is Medication)
            assertEquals("Amoxicillin", (result.actualInstance as Medication).drugName)
        }

        @Test
        @DisplayName("deserializes the surgery variant into actualInstance")
        fun testDeserializeSurgery() {
            val jsonString = """{"procedureName":"Spay","durationMinutes":45}"""

            val result = json.decodeFromString<PetTreatment>(jsonString)

            assertNotNull(result)
            assertTrue(result.actualInstance is Surgery)
            assertEquals("Spay", (result.actualInstance as Surgery).procedureName)
        }

        @Test
        @DisplayName("round-trips a wrapped variant back to the bare payload")
        fun testWrapperSerializeRoundTrip() {
            val original = PetTreatment(
                actualInstance = Medication(drugName = "Amoxicillin", dosage = "500mg"))

            val encoded = json.encodeToString(original)
            // The wrapper emits the bare variant object, not an envelope.
            assertFalse(encoded.contains("actualInstance"))
            assertTrue(encoded.contains("Amoxicillin"))

            val restored = json.decodeFromString<PetTreatment>(encoded)
            assertTrue(restored.actualInstance is Medication)
            assertEquals("Amoxicillin", (restored.actualInstance as Medication).drugName)
        }

        @Test
        @DisplayName("constructs PetTreatment with medication instance")
        fun testConstructWithMedication() {
            val medication = Medication(drugName = "Amoxicillin", dosage = "500mg")
            val treatment = PetTreatment(actualInstance = medication)

            assertNotNull(treatment.actualInstance)
            assertTrue(treatment.actualInstance is Medication)
        }

        @Test
        @DisplayName("constructs PetTreatment with surgery instance")
        fun testConstructWithSurgery() {
            val surgery = Surgery(procedureName = "Spay", durationMinutes = 45)
            val treatment = PetTreatment(actualInstance = surgery)

            assertNotNull(treatment.actualInstance)
            assertTrue(treatment.actualInstance is Surgery)
        }

        @Test
        @DisplayName("serializes round-trip for anyOf")
        fun testSerializeRoundTrip() {
            // Round-trip the matched anyOf member: encode a Medication and
            // decode it back, asserting the payload survives intact.
            val original = Medication(drugName = "Amoxicillin", dosage = "500mg")
            val encoded = json.encodeToString(original)
            val restored = json.decodeFromString<Medication>(encoded)

            assertEquals(original.drugName, restored.drugName)
            assertEquals(original.dosage, restored.dosage)
        }

        @Test
        @DisplayName("anyOf with no matching variant throws")
        fun testNoMatchThrows() {
            // Neither Medication (requires drugName) nor Surgery (requires
            // procedureName) can decode this payload, so the wrapper fails loud
            // rather than yielding an empty actualInstance.
            val jsonString = """{"unrelatedKey":"value","anotherUnknown":123}"""
            assertThrows(Exception::class.java) {
                json.decodeFromString<PetTreatment>(jsonString)
            }
        }

        @Test
        @DisplayName("union variants decode strictly - a foreign key is not silently dropped onto the first variant")
        fun testStrictUnionDecodeRejectsForeignKeys() {
            // Regression for M6: the wrapper used to decode each variant with the
            // SDK's lenient Json (ignoreUnknownKeys = true). A payload carrying a
            // key that belongs to a LATER variant would silently lose that key and
            // mis-resolve to whichever variant is declared first (Medication here).
            // Strict variant decoding (ignoreUnknownKeys = false) rejects the
            // foreign key, so an ambiguous payload that names BOTH variants' fields
            // no longer collapses onto the first variant. Medication owns drugName;
            // procedureName is Surgery's required key. Under the old lenient path
            // this resolved to Medication (dropping procedureName); under strict
            // decoding neither variant matches the combined shape, so it fails loud.
            val ambiguous = """{"drugName":"Amoxicillin","procedureName":"Spay"}"""
            assertThrows(Exception::class.java) {
                json.decodeFromString<PetTreatment>(ambiguous)
            }

            // A clean, unambiguous payload for the SECOND-declared variant must
            // still resolve correctly — strict decoding does not regress genuine
            // single-variant matches.
            val cleanSurgery = """{"procedureName":"Spay","durationMinutes":45}"""
            val resolved = json.decodeFromString<PetTreatment>(cleanSurgery)
            assertTrue(resolved.actualInstance is Surgery)
            assertEquals("Spay", (resolved.actualInstance as Surgery).procedureName)
        }
    }

    @Nested
    @DisplayName("allOf - PetWithOwner")
    inner class PetWithOwnerTests {

        @Test
        @DisplayName("deserializes all properties from allOf composition")
        fun testDeserialize() {
            val jsonString =
                """{"name":"doggie","photoUrls":["http://example.com/photo.jpg"],""" +
                    """"ownerName":"John","ownerEmail":"john@example.com"}"""

            val result = json.decodeFromString<PetWithOwner>(jsonString)

            assertNotNull(result)
            assertEquals("doggie", result.name)
            assertEquals("John", result.ownerName)
            assertEquals("john@example.com", result.ownerEmail)
        }

        @Test
        @DisplayName("serializes PetWithOwner to JSON")
        fun testSerialize() {
            val petWithOwner = PetWithOwner(
                name = "doggie",
                photoUrls = setOf("http://example.com/photo.jpg"),
                ownerName = "John",
                ownerEmail = "john@example.com"
            )

            val jsonString = json.encodeToString(petWithOwner)

            assertNotNull(jsonString)
            assertTrue(jsonString.contains("doggie"))
            assertTrue(jsonString.contains("John"))
            assertTrue(jsonString.contains("john@example.com"))
        }

        @Test
        @DisplayName("round-trip preserves all fields")
        fun testRoundTrip() {
            val original = PetWithOwner(
                name = "doggie",
                photoUrls = setOf("http://example.com/photo.jpg"),
                ownerName = "John",
                ownerEmail = "john@example.com"
            )

            val jsonString = json.encodeToString(original)
            val deserialized = json.decodeFromString<PetWithOwner>(jsonString)

            assertEquals(original.name, deserialized.name)
            assertEquals(original.ownerName, deserialized.ownerName)
            assertEquals(original.ownerEmail, deserialized.ownerEmail)
        }
    }

    @Nested
    @DisplayName("oneOf with format:byte variants - SetPetAvatarThumbnailRequest")
    inner class SetPetAvatarThumbnailRequestTests {

        // SetPetAvatarThumbnailRequest is a oneOf of [ a scalar format:byte value,
        // an array of format:byte values ]. format:byte means the value travels on
        // the wire as a base64 STRING. A reified serializer<ByteArray>() resolves
        // kotlinx's built-in ByteArraySerializer (a JSON int-array), so the wrapper
        // must route the byte variants through Base64ByteArraySerializer explicitly
        // on BOTH encode and decode -- this test pins that wire form.

        @Test
        @DisplayName("setPetAvatarThumbnail byte oneOf round-trips through base64")
        fun testScalarByteVariantRoundTripsThroughBase64() {
            val raw = byteArrayOf(0x01, 0x02, 0x03, 0x04)
            val request = SetPetAvatarThumbnailRequest(actualInstance = raw)

            val encoded = json.encodeToString(request)
            // The scalar byte variant must serialize to the base64 STRING
            // "AQIDBA==" -- NOT a JSON int-array [1,2,3,4], NOT raw/unencoded
            // bytes, NOT a [B@hash toString of the array.
            assertEquals("\"AQIDBA==\"", encoded)
            assertFalse(encoded.contains("[1,2,3,4]"))
            assertFalse(encoded.contains("[1, 2, 3, 4]"))

            // Round-trip: the base64 string must decode back to the SCALAR variant
            // holding exactly the original 4 bytes -- never element-by-element into
            // a List<ByteArray>.
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>(encoded)
            assertTrue(restored.actualInstance is ByteArray)
            assertArrayEquals(raw, restored.actualInstance as ByteArray)
        }

        @Test
        @DisplayName("setPetAvatarThumbnail array byte oneOf round-trips through base64")
        fun testArrayByteVariantRoundTripsThroughBase64() {
            val first = byteArrayOf(0x01)
            val second = byteArrayOf(0x02)
            val request = SetPetAvatarThumbnailRequest(actualInstance = listOf(first, second))

            val encoded = json.encodeToString(request)
            // The array variant must serialize to a JSON array of base64 STRINGS.
            assertEquals("[\"AQ==\",\"Ag==\"]", encoded)

            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>(encoded)
            @Suppress("UNCHECKED_CAST")
            val payloads = restored.actualInstance as List<ByteArray>
            assertEquals(2, payloads.size)
            assertArrayEquals(first, payloads[0])
            assertArrayEquals(second, payloads[1])
        }

        @Test
        @DisplayName("a base64 scalar string deserializes to the scalar variant, not a list")
        fun testScalarStringIsNotMisParsedAsList() {
            // Ordering guard: a lone base64 string must resolve to the scalar
            // ByteArray variant (one value), NOT be coerced element-by-element
            // into a List<ByteArray>.
            val restored = json.decodeFromString<SetPetAvatarThumbnailRequest>("\"AQIDBA==\"")

            assertTrue(restored.actualInstance is ByteArray)
            assertFalse(restored.actualInstance is List<*>)
            assertArrayEquals(byteArrayOf(0x01, 0x02, 0x03, 0x04), restored.actualInstance as ByteArray)
        }
    }
}
