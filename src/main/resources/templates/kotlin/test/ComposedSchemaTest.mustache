    @Nested
    @DisplayName("oneOf with discriminator - DryFood")
    inner class DryFoodTests {

        @Test
        @DisplayName("bhvUnions012 deserializes DryFood from JSON")
        fun testDeserializeDryFood() {
            val jsonString = """{"foodType":"dry","weightKg":2.5}"""

            val result = json.decodeFromString<DryFood>(jsonString)

            assertNotNull(result)
            assertEquals("dry", result.foodType)
            assertEquals(2.5, result.weightKg)
        }

        @Test
        @DisplayName("bhvUnions013 deserializes WetFood from JSON")
        fun testDeserializeWetFood() {
            val jsonString = """{"foodType":"wet","volumeMl":400}"""

            val result = json.decodeFromString<WetFood>(jsonString)

            assertNotNull(result)
            assertEquals("wet", result.foodType)
            assertEquals(400, result.volumeMl)
        }

        @Test
        @DisplayName("bhvUnions016 returns null for unknown discriminator value")
        fun testUnknownDiscriminator() {
            val jsonString = """{"foodType":"raw","calories":300}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("bhvUnions015 fails to deserialize when discriminator field is missing")
        fun testMissingDiscriminator() {
            val jsonString = """{"weightKg":2.5}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("bhvUnions024 fails to deserialize when discriminator value is empty")
        fun testEmptyDiscriminator() {
            // An empty discriminator value matches no listed subtype and must
            // not be silently routed; kotlinx fails the decode (null here).
            val jsonString = """{"foodType":"","weightKg":2.5}"""

            val result = runCatching { json.decodeFromString<PetFood>(jsonString) }.getOrNull()
            assertNull(result)
        }

        @Test
        @DisplayName("bhvUnions026 unknown discriminator error names the offending value")
        fun testUnknownDiscriminatorErrorNamesValue() {
            // The hand-written discriminator serializer surfaces the offending
            // value in its message, unlike kotlinx's built-in polymorphic decode.
            val jsonString = """{"foodType":"raw","calories":300}"""
            val ex = assertThrows(Exception::class.java) {
                json.decodeFromString<PetFood>(jsonString)
            }
            assertTrue(ex.message!!.contains("raw"))
        }

        @Test
        @DisplayName("bhvUnions033 the SDK serializer reports an unknown, missing or empty discriminator as SerializationException")
        fun testBadDiscriminatorsSurfaceAsSdkSerializationException() {
            val serializer = {{invokerPackage}}.ObjectSerializer()
            for (payload in listOf(
                """{"foodType":"raw","calories":300}""",
                """{"weightKg":2.5}""",
                """{"foodType":"","weightKg":2.5}""",
            )) {
                val ex = assertThrowsExactly({{invokerPackage}}.errors.SerializationException::class.java) {
                    serializer.deserialize<PetFood>(payload)
                }
                assertTrue(ex.message!!.startsWith("Failed to deserialize JSON: "), ex.message)
                assertNotNull(ex.cause, "the library failure is kept as the cause: $payload")
            }
        }

        @Test
        @DisplayName("bhvUnions030 a subtype whose discriminator key is absent is filled with the mapping default")
        fun testAbsentDiscriminatorIsFilledWithItsDefault() {
            val result = json.decodeFromString<DryFood>("""{"weightKg":2.5}""")

            assertEquals("dry", result.foodType)
        }

        @Test
        @DisplayName("bhvUnions032 a oneOf wrapper built from a variant holds that variant and serializes it with its discriminator")
        fun testBuiltFromVariantSerializesWithItsDiscriminator() {
            val food = PetFood.fromDryFood(DryFood(weightKg = 2.5))

            assertTrue(food.isDryFood)
            assertEquals(2.5, food.asDryFood()?.weightKg)
            val encodingJson = Json { encodeDefaults = true }
            assertEquals("""{"foodType":"dry","weightKg":2.5}""", encodingJson.encodeToString(food))
        }

        @Test
        @DisplayName("bhvUnions035 a discriminator value not listed in the mapping fails to deserialize")
        fun testUnlistedDiscriminatorFailsToDeserialize() {
            val jsonString = """{"foodType":"freeze-dried","weightKg":1.5}"""

            assertThrowsExactly(kotlinx.serialization.SerializationException::class.java) {
                json.decodeFromString<PetFood>(jsonString)
            }
        }

        @Test
        @DisplayName("bhvUnions020 serializes DryFood back to JSON")
        fun testSerializeDryFood() {
            val encodingJson = Json {
                ignoreUnknownKeys = true
                encodeDefaults = true
                isLenient = true
                coerceInputValues = true
            }
            val dryFood = DryFood(weightKg = 2.5)

            val jsonString = encodingJson.encodeToString(dryFood)

            assertNotNull(jsonString)
            assertTrue(jsonString.contains("\"foodType\":\"dry\""))
            assertTrue(jsonString.contains("2.5"))
        }
    }

    @Nested
    @DisplayName("anyOf - PetTreatment")
    inner class PetTreatmentTests {

        @Test
        @DisplayName("bhvUnions003 deserializes a matching variant into actualInstance")
        fun testDeserialize() {
            // The wrapper now resolves the bare payload against each declared
            // variant and stores the concrete match in actualInstance, instead
            // of silently decoding to an empty wrapper (the previous defect).
            val jsonString = """{"drugName":"Amoxicillin","dosage":"500mg"}"""

            val result = json.decodeFromString<PetTreatment>(jsonString)

            assertNotNull(result)
            assertTrue(result.actualInstance is Medication)
            assertEquals("Amoxicillin", (result.actualInstance as Medication).drugName)
        }

        @Test
        @DisplayName("bhvUnions011 anyOf wrappers have value equality and a matching hash")
        fun testAnyOfValueEquality() {
            val payload = """{"drugName":"Amoxicillin","dosage":"500mg"}"""
            val first = json.decodeFromString<PetTreatment>(payload)
            val second = json.decodeFromString<PetTreatment>(payload)
            val other =
                json.decodeFromString<PetTreatment>("""{"procedureName":"Spay","durationMinutes":45}""")

            assertEquals(first, second)
            assertEquals(first.hashCode(), second.hashCode())
            assertNotEquals(first, other)
        }

        @Test
        @DisplayName("bhvUnions006 deserializes the surgery variant into actualInstance")
        fun testDeserializeSurgery() {
            val jsonString = """{"procedureName":"Spay","durationMinutes":45}"""

            val result = json.decodeFromString<PetTreatment>(jsonString)

            assertNotNull(result)
            assertTrue(result.actualInstance is Surgery)
            assertEquals("Spay", (result.actualInstance as Surgery).procedureName)
        }

        @Test
        @DisplayName("round-trips a wrapped variant back to the bare payload")
        fun testWrapperSerializeRoundTrip() {
            val original = PetTreatment(
                actualInstance = Medication(drugName = "Amoxicillin", dosage = "500mg"))

            val encoded = json.encodeToString(original)
            // The wrapper emits the bare variant object, not an envelope.
            assertFalse(encoded.contains("actualInstance"))
            assertTrue(encoded.contains("Amoxicillin"))

            val restored = json.decodeFromString<PetTreatment>(encoded)
            assertTrue(restored.actualInstance is Medication)
            assertEquals("Amoxicillin", (restored.actualInstance as Medication).drugName)
        }

        @Test
        @DisplayName("bhvUnions014 constructs PetTreatment with medication instance")
        fun testConstructWithMedication() {
            val medication = Medication(drugName = "Amoxicillin", dosage = "500mg")
            val treatment = PetTreatment(actualInstance = medication)

            assertNotNull(treatment.actualInstance)
            assertTrue(treatment.actualInstance is Medication)
        }

        @Test
        @DisplayName("bhvUnions037 constructs PetTreatment with surgery instance")
        fun testConstructWithSurgery() {
            val surgery = Surgery(procedureName = "Spay", durationMinutes = 45)
            val treatment = PetTreatment(actualInstance = surgery)

            assertNotNull(treatment.actualInstance)
            assertTrue(treatment.actualInstance is Surgery)
        }

        @Test
        @DisplayName("bhvUnions008 serializes round-trip for anyOf")
        fun testSerializeRoundTrip() {
            // Round-trip the matched anyOf member: encode a Medication and
            // decode it back, asserting the payload survives intact.
            val original = Medication(drugName = "Amoxicillin", dosage = "500mg")
            val encoded = json.encodeToString(original)
            val restored = json.decodeFromString<Medication>(encoded)

            assertEquals(original.drugName, restored.drugName)
            assertEquals(original.dosage, restored.dosage)
        }

        @Test
        @DisplayName("bhvUnions007 anyOf with no matching variant throws")
        fun testNoMatchThrows() {
            // Neither Medication (requires drugName) nor Surgery (requires
            // procedureName) can decode this payload, so the wrapper fails loud
            // rather than yielding an empty actualInstance.
            val jsonString = """{"unrelatedKey":"value","anotherUnknown":123}"""
            assertThrows(Exception::class.java) {
                json.decodeFromString<PetTreatment>(jsonString)
            }
        }

        @Test
        @DisplayName("bhvUnions009 anyOf retains all matching variants (medication and surgery) losslessly")
        fun testAnyOfRetainsAllMatchingVariantsLosslessly() {
            // PetTreatment is a non-discriminated anyOf documented as matching a
            // medication, a surgery, OR BOTH. A payload that satisfies BOTH
            // variants at once must retain BOTH — keeping only the first match
            // (the previous defect) would silently drop the surgery fields and
            // lose them on re-encode.
            val both =
                """{"drugName":"Amoxicillin","dosage":"250mg","procedureName":"Spay","durationMinutes":45}"""

            val result = json.decodeFromString<PetTreatment>(both)

            // BOTH variants are retained and accessible — not just the first.
            val medication = result.matchedInstances.filterIsInstance<Medication>().single()
            val surgery = result.matchedInstances.filterIsInstance<Surgery>().single()
            assertEquals("Amoxicillin", medication.drugName)
            assertEquals("250mg", medication.dosage)
            assertEquals("Spay", surgery.procedureName)
            assertEquals(45, surgery.durationMinutes)
            assertEquals(
                listOf(Medication::class, Surgery::class),
                result.matchedInstances.map { it!!::class },
            )

            // Re-serialize: the union of all retained variants' fields must
            // survive, so the co-satisfied payload round-trips with no drop.
            val encoded = json.encodeToString(result)
            assertTrue(encoded.contains("\"drugName\":\"Amoxicillin\""))
            assertTrue(encoded.contains("\"dosage\":\"250mg\""))
            assertTrue(encoded.contains("\"procedureName\":\"Spay\""))
            assertTrue(encoded.contains("\"durationMinutes\":45"))

            // Single-variant behaviour still works: a medication-only payload
            // retains only Medication, and a surgery-only payload only Surgery.
            val medOnly = json.decodeFromString<PetTreatment>(
                """{"drugName":"Amoxicillin","dosage":"500mg"}""")
            assertEquals(1, medOnly.matchedInstances.size)
            assertTrue(medOnly.actualInstance is Medication)
            assertEquals("Amoxicillin", (medOnly.actualInstance as Medication).drugName)

            val surgeryOnly = json.decodeFromString<PetTreatment>(
                """{"procedureName":"Spay","durationMinutes":45}""")
            assertEquals(1, surgeryOnly.matchedInstances.size)
            assertTrue(surgeryOnly.actualInstance is Surgery)
            assertEquals("Spay", (surgeryOnly.actualInstance as Surgery).procedureName)
        }

        @Test
        @DisplayName("bhvUnions010 shared-property collision keeps the last variant's value, emitted once")
        fun testSharedPropertyCollisionLastWins() {
            // anyOf-collision-last-wins: both Medication and Surgery declare
            // `notes`. When a PetTreatment retains both members with DIFFERENT
            // `notes` values, the merged encoding keeps the LAST-declared
            // member's value (Surgery) and emits `notes` exactly once — never a
            // duplicate JSON key.
            val treatment = PetTreatment(
                matchedInstances = listOf(
                    Medication(drugName = "Amoxicillin", notes = "from-medication"),
                    Surgery(procedureName = "Spay", notes = "from-surgery"),
                ),
            )

            val encoded = json.encodeToString(treatment)

            // Surgery is the later-declared member, so its `notes` wins.
            assertTrue(encoded.contains("from-surgery"))
            assertFalse(encoded.contains("from-medication"))
            // `notes` appears exactly once — no duplicate key.
            assertEquals(2, encoded.split("\"notes\"").size)
        }
    }

