    @Nested
    @DisplayName("unknown/empty style fallback")
    inner class FallbackTests {

        @Test
        @DisplayName("null style falls back to location-based serialization")
        fun nullStyleFallsBack() {
            assertEquals("5", ValueSerializer.serializeStyled("id", "5", "path", "string", null, null, false))
        }

        @Test
        @DisplayName("bhvSerializationparam035 empty style falls back to location-based serialization")
        fun emptyStyleFallsBack() {
            assertEquals("5", ValueSerializer.serializeStyled("id", "5", "path", "string", null, "", false))
        }

        @Test
        @DisplayName("bhvSerializationparam033 empty string path param throws IllegalArgumentException")
        fun emptyStringPathParamThrows() {
            // Gap W — empty-string path values silently produce
            // malformed URLs like `/resource//details`; reject at
            // serialization time so callers see the real error rather
            // than a downstream 404.
            assertThrows(IllegalArgumentException::class.java) {
                ValueSerializer.serializeStyled("id", "", "path", "string", null, "simple", false)
            }
        }
    }

    @Nested
    @DisplayName("allowReserved query encoding")
    inner class AllowReservedTests {

        @Test
        @DisplayName("bhvSerializationparam080 reserved characters are left literal, other characters still encoded")
        fun reservedCharsPreserved() {
            assertEquals("v1.0/beta:rc1", ValueSerializer.encodeQueryAllowingReserved("v1.0/beta:rc1"))
            // Space is illegal in a URL and must still be percent-encoded even
            // when reserved characters are preserved.
            assertEquals("a%20b:c", ValueSerializer.encodeQueryAllowingReserved("a b:c"))
        }

        @Test
        @DisplayName("bhvSerializationparam068 only the RFC 3986 query-legal reserved set stays literal; # [ ] are encoded")
        fun fragmentAndBracketsAreEncoded() {
            assertEquals(
                "a:b/c?d%5Be%5Df@g!h\$i&j'k(l)m*n+o,p;q=r~s%23t%20u",
                ValueSerializer.encodeQueryAllowingReserved("a:b/c?d[e]f@g!h\$i&j'k(l)m*n+o,p;q=r~s#t u"),
            )
        }

        @Test
        @DisplayName("bhvSerializationparam060 maybeAllowReserved wraps only when allowReserved is true")
        fun maybeAllowReservedWraps() {
            assertEquals("plain", ValueSerializer.maybeAllowReserved("plain", false))
            val wrapped = ValueSerializer.maybeAllowReserved("v1/beta", true)
            assertInstanceOf(ValueSerializer.AllowReservedValue::class.java, wrapped)
            assertEquals("v1/beta", (wrapped as ValueSerializer.AllowReservedValue).value)
            assertNull(ValueSerializer.maybeAllowReserved(null, true))
        }
    }

    @Nested
    @DisplayName("serializeContent - content: application/json parameters")
    inner class ContentParameterTests {

        private val model = {{modelPackage}}.EdgeCases(cutoff = java.time.LocalTime.of(10, 30, 0, 123_456_789))

        @Test
        @DisplayName("header carries the SDK JSON verbatim")
        fun headerCarriesTheJsonVerbatim() {
            assertEquals("{\"cutoff\":\"10:30:00.123\"}", ValueSerializer.serializeContent("p", model, "header"))
        }

        @Test
        @DisplayName("bhvSerializationparam071 path is segment-encoded once")
        fun pathIsSegmentEncoded() {
            assertEquals(
                "%7B%22cutoff%22:%2210:30:00.123%22%7D",
                ValueSerializer.serializeContent("p", model, "path"),
            )
        }

        @Test
        @DisplayName("cookie is fully percent-encoded")
        fun cookieIsPercentEncoded() {
            assertEquals(
                "%7B%22cutoff%22%3A%2210%3A30%3A00.123%22%7D",
                ValueSerializer.serializeContent("p", model, "cookie"),
            )
        }

        @Test
        @DisplayName("F833: cookie keeps only the unreserved set literal and encodes the rest as UTF-8")
        fun cookieKeepsOnlyTheUnreservedSetLiteral() {
            assertEquals(
                "%22a%20b~%2A%C3%A9%22",
                ValueSerializer.serializeContent("p", "a b~*\u00e9", "cookie"),
            )
            assertEquals(
                "%22%21%27%28%29%2C%2B%25-._~%22",
                ValueSerializer.serializeContent("p", "!'(),+%-._~", "cookie"),
            )
        }

        @Test
        @DisplayName("query returns the raw JSON for the query builder to encode")
        fun queryReturnsTheRawJson() {
            assertEquals("{\"cutoff\":\"10:30:00.123\"}", ValueSerializer.serializeContent("p", model, "query"))
        }

        @Test
        @DisplayName("absent value is null in a query and empty elsewhere")
        fun absentValue() {
            assertNull(ValueSerializer.serializeContent("p", null, "query"))
            assertEquals("", ValueSerializer.serializeContent("p", null, "header"))
        }
    }

    @Nested
    @DisplayName("style, allowReserved and date-time edge cases")
    inner class StyleAndReservedEdgeTests {

        @Test
        @DisplayName("bhvSerializationparam002 allow reserved leaves reserved chars literal but still encodes others")
        fun allowReservedLeavesReservedCharsLiteral() {
            assertEquals("a/b:c?d=e&f", ValueSerializer.encodeQueryAllowingReserved("a/b:c?d=e&f"))
            assertEquals("a%23b%20c", ValueSerializer.encodeQueryAllowingReserved("a#b c"))
        }

        @Test
        @DisplayName("bhvSerializationparam003 allow reserved still percent encodes non ascii")
        fun allowReservedStillPercentEncodesNonAscii() {
            assertEquals("%E6%97%A5%E6%9C%AC/%20%5B", ValueSerializer.encodeQueryAllowingReserved("日本/ ["))
        }

        @Test
        @DisplayName("bhvSerializationparam029 dot-segment path values raise IllegalArgumentException with no style")
        fun dotSegmentPathValueIsRejectedWithoutAStyle() {
            for (style in listOf<String?>(null, "")) {
                for (segment in listOf(".", "..")) {
                    val ex = assertThrowsExactly(IllegalArgumentException::class.java) {
                        ValueSerializer.serializeStyled("name", segment, "path", "string", null, style, false)
                    }
                    assertEquals("Path parameter 'name' must not be '.' or '..'", ex.message)
                }
            }
        }

        @Test
        @DisplayName("bhvSerializationparam034 empty string is preserved in the query and in form style")
        fun emptyStringIsPreservedInQueryAndFormStyle() {
            assertEquals("", ValueSerializer.serialize("", "query", "string", null))
            assertEquals("", ValueSerializer.serializeStyled("q", "", "query", "string", null, "form", true))
        }

        @Test
        @DisplayName("bhvSerializationparam048 a date-time parameter that is not format date keeps its time")
        fun dateTimeParameterKeepsItsTime() {
            val at = OffsetDateTime.of(2024, 1, 2, 3, 4, 5, 0, ZoneOffset.UTC)
            assertEquals("2024-01-02T03:04:05.000+00:00", ValueSerializer.serialize(at, "query", "string", null))
        }

        @Test
        @DisplayName("bhvSerializationparam053 label style encodes the value and joins exploded items with dots")
        fun labelStyleEncodesTheValue() {
            assertEquals(".a%20b", ValueSerializer.serializeStyled("id", "a b", "path", "string", null, "label", false))
            assertEquals(".a.b", ValueSerializer.serializeStyled("ids", listOf("a", "b"), "path", "array", null, "label", true))
        }

        @Test
        @DisplayName("bhvSerializationparam075 pipeDelimited array with explode true returns a list")
        fun pipeDelimitedArrayWithExplodeReturnsList() {
            assertEquals(
                listOf("a", "b"),
                ValueSerializer.serializeStyled("ids", listOf("a", "b"), "query", "array", null, "pipeDelimited", true),
            )
        }

        @Test
        @DisplayName("bhvSerializationparam078 a query value is not path-encoded")
        fun queryValueIsNotPathEncoded() {
            assertEquals("a b/c", ValueSerializer.serializeStyled("q", "a b/c", "query", "string", null, "form", false))
        }

        @Test
        @DisplayName("bhvSerializationparam083 a set expands exactly like a list")
        fun setExpandsLikeAList() {
            assertEquals(
                listOf("a", "b"),
                ValueSerializer.serializeStyled("ids", linkedSetOf("a", "b"), "query", "array", null, "form", true),
            )
            assertEquals(listOf("a", "b"), ValueSerializer.serialize(linkedSetOf("a", "b"), "query", "array", "multi"))
        }

