        @Test
        @DisplayName("makes HTTPS request with verifySsl=false")
        fun makesHttpsRequestWithVerifySslFalse() {
            val wiremockUrl = WireMockContainer.getHttpsUrl()
            val transport = TransportOptions.builder()
