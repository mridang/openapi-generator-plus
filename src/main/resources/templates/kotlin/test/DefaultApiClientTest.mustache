    @Nested
    @DisplayName("injected transport")
    inner class InjectedTransport {

        @Test
        @DisplayName("a caller-supplied HttpClient receives the request with the SDK user agent, and is never closed")
        fun callerSuppliedClientReceivesTheRequest() {
            var seenUserAgent: String? = null
            var seenUrl: String? = null
            val engine = MockEngine { req ->
                seenUserAgent = req.headers[HttpHeaders.UserAgent]
                seenUrl = req.url.toString()
                respond("ok", HttpStatusCode.OK, headersOf("Content-Type", "text/plain"))
            }
            val custom = HttpClient(engine)
            try {
                val transport = TransportOptions.builder().httpClient(custom).userAgent("sdk-agent/1").build()
                val apiClient = DefaultApiClient(transport)
                val response = runBlocking {
                    apiClient.sendRequest("GET", "https://h.example.com/v1/ping", emptyMap(), null)
                }
                assertEquals(200, response.statusCode)
                assertEquals("https://h.example.com/v1/ping", seenUrl)
                assertEquals("sdk-agent/1", seenUserAgent)
                apiClient.close()
                assertTrue(custom.isActive, "the SDK must not close a caller-supplied client")
                val again = runBlocking { custom.get("https://h.example.com/v1/ping") }
                assertEquals(HttpStatusCode.OK, again.status)
            } finally {
                custom.close()
            }
        }
    }

