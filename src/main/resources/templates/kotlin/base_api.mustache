package {{apiPackage}}

import {{invokerPackage}}.ApiClient
import {{invokerPackage}}.errors.ApiException
import {{invokerPackage}}.ApiHttpResponse
import {{invokerPackage}}.ApiResult
import {{invokerPackage}}.CallInfo
import {{invokerPackage}}.CallSettings
import {{invokerPackage}}.CallTracker
import {{invokerPackage}}.Configuration
import {{invokerPackage}}.DefaultApiClient
import {{invokerPackage}}.HeaderSelector
import {{invokerPackage}}.ObjectSerializer
import {{invokerPackage}}.TraceContextUtil
import {{invokerPackage}}.ValueSerializer
import {{invokerPackage}}.auth.Authenticator
import {{invokerPackage}}.auth.HttpAwareAuthenticator
import {{invokerPackage}}.auth.NoAuth
import io.ktor.http.encodeURLParameter
import kotlinx.coroutines.withContext

/**
 * Base class for all API classes. Provides the [invokeApi] method that
 * handles URL construction, header selection, body serialization, request
 * dispatch, and response error handling.
 */
abstract class BaseApi {

    /** The HTTP transport client used for sending requests. */
    protected val apiClient: ApiClient

    /** API-level configuration (base URL and default headers). */
    protected val config: Configuration

    /**
     * Serializer for request/response body conversion.
     *
     * Marked `@PublishedApi internal` rather than `protected`: it must stay out
     * of the public API ([ObjectSerializer] is internal transport machinery),
     * but the public inline [invokeApiForResult] and generated subclasses still
     * reference it, so it cannot be `private`.
     */
    @PublishedApi
    internal val objectSerializer: ObjectSerializer

    /**
     * Content negotiation logic for Accept and Content-Type headers.
     *
     * Marked `@PublishedApi internal` for the same reasons as [objectSerializer].
     */
    @PublishedApi
    internal val headerSelector: HeaderSelector

    /** Default authenticator used by an operation whose security schemes the client holds no credential for. */
    protected val authenticator: Authenticator?

    /** The credential of each security scheme, keyed by the scheme's name in the spec. */
    private val schemeAuthenticators: Map<String, Authenticator>

    /**
     * Create an API instance with the default configuration and default transport.
     */
    constructor() : this(Configuration.defaultConfiguration())

    /**
     * Create an API instance with the given configuration and default transport.
     *
     * @param config API-level configuration (base URL and default headers)
     */
    constructor(config: Configuration) : this(DefaultApiClient(), config)

    /**
     * Create an API instance with a custom API client and configuration.
     *
     * @param apiClient the HTTP transport client
     * @param config    API-level configuration (base URL and default headers)
     */
    constructor(apiClient: ApiClient, config: Configuration) : this(apiClient, config, null)

    /**
     * Create an API instance with a custom API client, configuration, and authenticator.
     *
     * @param apiClient     the HTTP transport client
     * @param config        API-level configuration (base URL and default headers)
     * @param authenticator default authenticator for operations no scheme credential covers
     */
    constructor(apiClient: ApiClient, config: Configuration, authenticator: Authenticator?) :
        this(apiClient, config, authenticator, emptyMap())

    /**
     * Create an API instance with a custom API client, configuration, default authenticator and
     * one credential per security scheme.
     *
     * @param apiClient            the HTTP transport client
     * @param config               API-level configuration (base URL and default headers)
     * @param authenticator        default authenticator for operations no scheme credential covers
     * @param schemeAuthenticators the credential of each security scheme, keyed by the scheme's
     *   name in the spec
     */
    constructor(
        apiClient: ApiClient,
        config: Configuration,
        authenticator: Authenticator?,
        schemeAuthenticators: Map<String, Authenticator>,
    ) {
        this.apiClient = apiClient
        this.config = config
        this.objectSerializer = ObjectSerializer()
        this.headerSelector = HeaderSelector()
        this.authenticator = authenticator
        this.schemeAuthenticators = schemeAuthenticators.toMap()
    }

    /**
     * The credential of the first of [schemeIds] this API holds one for, or `null` when it holds
     * none of them, which leaves the call to the default [authenticator]. An operation lists the
     * schemes its spec accepts in the order the spec names them, so the first one the client was
     * given a credential for wins.
     *
     * @param schemeIds the security schemes an operation accepts, in the spec's order
     * @return the credential to authenticate the call with, or `null`
     */
    protected fun schemeAuthenticator(vararg schemeIds: String): Authenticator? {
        for (schemeId in schemeIds) {
            val found = schemeAuthenticators[schemeId]
            if (found != null) {
                return found
            }
        }
        return null
    }

    /**
     * The credential for an operation whose security block lists alternative requirements. Each
     * group is one requirement: a group that names several schemes needs the credentials of all of
     * them and a request carries every one. The first group the client holds every credential of
     * wins, else the first group it holds at least one credential of; `null` when it holds none,
     * which leaves the call to the default [authenticator].
     *
     * @param groups the requirements, in the spec's order, each the scheme ids it needs together
     * @return the credential to authenticate the call with, or `null`
     */
    protected fun requirementAuthenticator(vararg groups: Array<String>): Authenticator? {
        var partial: List<Authenticator>? = null
        for (group in groups) {
            val held = group.mapNotNull { schemeAuthenticators[it] }
            if (held.isEmpty()) {
                continue
            }
            if (held.size == group.size) {
                return if (held.size == 1) held[0] else AllOfAuthenticator.of(held)
            }
            if (partial == null) {
                partial = held
            }
        }
        val rest = partial ?: return null
        return if (rest.size == 1) rest[0] else AllOfAuthenticator.of(rest)
    }

    /**
     * Invoke an API operation and return the raw response after error checking.
     *
     * Builds the full URL from the configured base URL and path, merges
     * authentication, configuration, and operation headers, serializes the
     * request body, sends the request via the API client, and checks the
     * response status code. Non-2xx responses throw the appropriate
     * [ApiException] subclass.
     *
     * @param method      HTTP method (GET, POST, PUT, DELETE, etc.)
     * @param path        URL path (with path params already substituted)
     * @param queryParams query parameters
     * @param headerParams custom header parameters
     * @param body        request body (model object or null)
     * @param accepts     acceptable response content types
     * @param contentType request content type
     * @param auth        the credential of the operation's security scheme, [NoAuth] for an unauthenticated operation, or null for the default authenticator
     * @param callTimeout optional end-to-end timeout in milliseconds for this call only
     * @param callHeaders optional headers for this call only; they replace a header of the same name
     * @param callMaxRetries optional number of retries for this call only; `0` disables them
     * @param errorSchemas the operation's error factories by declared status, or null
     * @param operationId the operation id exactly as written in the spec, told to the call hook
     * @param urlTemplate the spec path template of the operation, told to the call hook
     * @return ApiHttpResponse containing status code, body, and headers
     * @throws ApiException if the API call fails
     */
    protected suspend fun invokeApi(
        method: String,
        path: String,
        queryParams: MutableMap<String, Any?>,
        headerParams: MutableMap<String, String>,
        body: Any?,
        accepts: Array<String>,
        contentType: String,
        auth: Authenticator?,
        callTimeout: Long? = null,
        callHeaders: Map<String, String>? = null,
        callMaxRetries: Int? = null,
        errorSchemas: Map<String, {{invokerPackage}}.errors.ErrorFactory>? = null,
        operationId: String? = null,
        urlTemplate: String? = null,
    ): ApiHttpResponse {
        val tracker = newCallTracker()
        val response =
            invokeApiTracked(
                method, path, queryParams, headerParams, body, accepts, contentType, auth,
                callTimeout, callHeaders, callMaxRetries, errorSchemas, operationId, urlTemplate, tracker,
            )
        tracker.finishOk(response.statusCode, response.headers)
        return response
    }

    /** The tracker of one call: it runs the configured [{{invokerPackage}}.CallHook], if any. */
    @PublishedApi
    internal fun newCallTracker(): CallTracker = CallTracker(config.callHook)

    /**
     * The request pipeline of [invokeApi]. The hook is started once the headers are final; every
     * exit after that finishes it with the error, and the caller finishes it on success.
     */
    @PublishedApi
    internal suspend fun invokeApiTracked(
        method: String,
        path: String,
        queryParams: MutableMap<String, Any?>,
        headerParams: MutableMap<String, String>,
        body: Any?,
        accepts: Array<String>,
        contentType: String,
        auth: Authenticator?,
        callTimeout: Long? = null,
        callHeaders: Map<String, String>? = null,
        callMaxRetries: Int? = null,
        errorSchemas: Map<String, {{invokerPackage}}.errors.ErrorFactory>?,
        operationId: String?,
        urlTemplate: String?,
        tracker: CallTracker,
    ): ApiHttpResponse {
        require(callTimeout == null || callTimeout > 0) {
            "Invalid timeout: must be a positive number of milliseconds (got $callTimeout)"
        }
        require(callMaxRetries == null || callMaxRetries >= 0) {
            "Invalid maxRetries: must not be negative (got $callMaxRetries)"
        }
        val callStartedAt = System.nanoTime()
        var url = resolveUrl(path)

        /* Three-state auth resolution:
         *   - auth === NoAuth        -> the operation is declared `security: []`
         *                               (unauthenticated). Apply NO authenticator
         *                               and do NOT fall back to the client-level
         *                               one, so the client credential is never
         *                               leaked to an unauthenticated endpoint.
         *   - auth == null           -> the client holds no credential for any
         *                               scheme the operation accepts; fall back to
         *                               the client-level authenticator.
         *   - auth is a real value   -> the credential of the first scheme the
         *                               operation accepts that the client holds.
         */
        val effectiveAuth =
            when {
                auth === NoAuth -> null
                auth != null -> auth
                else -> this.authenticator
            }
        /* A scheme credential that makes HTTP calls of its own (an OAuth2 or OpenID
         * Connect flow) and was handed to an API class directly never went through
         * the client facade, so it has no transport yet. Hand it this API's, so its
         * token requests use the same proxy, TLS and timeout settings as the call
         * it authenticates. */
        if (auth != null && auth !== NoAuth && effectiveAuth is HttpAwareAuthenticator) {
            effectiveAuth.setApiClient(apiClient)
        }
        /* The auth headers are fetched first: an authenticator whose credential comes from a
         * provider refreshes it here, and its query and cookie values follow that refresh. */
        val authHeaders = effectiveAuth?.getAuthHeaders()
        if (effectiveAuth != null) {
            for ((key, value) in effectiveAuth.getQueryParams()) {
                queryParams[key] = value
            }
        }
        /* A deadline that the credential lookup already used up ends the call here, before the
         * transport is touched. */
        if (callTimeout != null && (System.nanoTime() - callStartedAt) / 1_000_000L >= callTimeout) {
            throw {{invokerPackage}}.errors.NetworkTimeoutException(
                "Request timed out: the $callTimeout ms end-to-end timeout was spent before the request was sent",
                java.net.SocketTimeoutException("end-to-end timeout of $callTimeout ms exhausted"),
            )
        }

        val query = buildQueryString(queryParams)
        if (query.isNotEmpty()) {
            url += "?$query"
        }

        val isMultipart = "multipart/form-data" == contentType
        val headers = headerSelector.selectHeaders(accepts, contentType, isMultipart)
        // A default header replaces a negotiated one of the same name in any letter case.
        headers.keys.removeAll { name -> config.defaultHeaders.keys.any { it.equals(name, ignoreCase = true) } }
        headers.putAll(config.defaultHeaders)
        headers.putAll(headerParams)
        if (effectiveAuth != null) {
            headers.putAll(authHeaders.orEmpty())
            val cookies = effectiveAuth.getCookieParams()
            if (cookies.isNotEmpty()) {
                // RFC 6265 — don't URL-encode cookie name/value; most cookie
                // parsers don't URL-decode, so `=` (base64 padding) would
                // arrive as literal `%3D` and break JWT/session cookies.
                // Validate and pass through raw instead.
                val cookieStr =
                    cookies.entries.joinToString("; ") { (name, value) ->
                        require(isValidCookieName(name)) {
                            "Cookie name '$name' contains characters forbidden by RFC 6265"
                        }
                        require(isValidCookieValue(value)) {
                            "Cookie value for '$name' contains characters outside the RFC 6265 cookie-octet set; percent-encode the value before passing it"
                        }
                        "$name=$value"
                    }
                val existing = headers["Cookie"]
                if (!existing.isNullOrEmpty()) {
                    headers["Cookie"] = "$existing; $cookieStr"
                } else {
                    headers["Cookie"] = cookieStr
                }
            }
        }
        TraceContextUtil.injectTraceContext(headers)
        if (callHeaders != null) {
            for ((name, value) in callHeaders) {
                // Header names are case-insensitive: the per-call header replaces any layer before it.
                headers.keys.removeAll { it.equals(name, ignoreCase = true) }
                headers[name] = value
            }
        }

        tracker.start({ callInfo(method, operationId, urlTemplate, url) }, headers)
        try {
            val requestBody: Any? =
                if (body != null) {
                    when {
                        (contentType.startsWith("image/") || "application/octet-stream" == contentType) &&
                            body is Map<*, *> -> {
                            // Raw-binary selection on an operation that ALSO declares a
                            // multipart content type. The operation assembled the body as
                            // a Map of form parts (the file plus optional metadata). A raw
                            // octet-stream/image request has no multipart envelope, so we
                            // must NOT forward that Map to the transport -- buildRequestBody
                            // dispatches on `body is Map<*, *>` and would emit a
                            // multipart/form-data body, contradicting the caller's explicit
                            // content-type selection. Send the single binary part's raw
                            // bytes instead; the text metadata parts have no place on the
                            // wire for a raw stream and are dropped.
                            extractBinaryPart(body)
                        }
                        body is ByteArray ||
                            contentType.startsWith("image/") ||
                            "application/octet-stream" == contentType -> body
                        "multipart/form-data" == contentType && body is Map<*, *> -> body
                        "text/plain" == contentType -> body.toString()
                        "application/x-www-form-urlencoded" == contentType && body is Map<*, *> -> {
                            val formParams = body as Map<String, Any?>
                            val parts = mutableListOf<String>()
                            for ((key, value) in formParams) {
                                // Optional/absent fields are passed as null and must be
                                // OMITTED from the wire body (parity rule 2), not encoded
                                // as the literal string "null".
                                if (value == null) continue
                                if (value is Collection<*>) {
                                    // Array fields explode into repeated keys —
                                    // `tags=a&tags=b` (parity rule 1) — rather than a
                                    // single bracket-mangled `tags=[a, b]` value.
                                    for (item in value) {
                                        if (item == null) continue
                                        requireFormScalar(key, item)
                                        parts.add("${encode(key)}=${encode(objectSerializer.stringify(item))}")
                                    }
                                } else {
                                    requireFormScalar(key, value)
                                    parts.add("${encode(key)}=${encode(objectSerializer.stringify(value))}")
                                }
                            }
                            parts.joinToString("&")
                        }
                        else -> objectSerializer.serialize(body)
                    }
                } else {
                    null
                }

            if (requestBody == null) {
                headers.remove("Content-Type")
            }

            val requestPath = requestPathOf(url)
            val callSettings =
                if (callTimeout != null || callMaxRetries != null) CallSettings(callTimeout, callMaxRetries) else null
            suspend fun send(sentHeaders: Map<String, String>): ApiHttpResponse =
                try {
                    if (callSettings != null) {
                        withContext(callSettings) { apiClient.sendRequest(method, url, sentHeaders, requestBody) }
                    } else {
                        apiClient.sendRequest(method, url, sentHeaders, requestBody)
                    }
                } catch (e: ApiException) {
                    // A failure the transport raised carries the request it belongs to.
                    if (e.requestMethod == null) {
                        e.requestMethod = method
                        e.requestPath = requestPath
                    }
                    throw e
                }

            var response = send(headers)

            if (response.statusCode == 401 && effectiveAuth is HttpAwareAuthenticator) {
                // A cached OAuth2 token the API no longer accepts must not outlive this answer.
                effectiveAuth.invalidateAccessToken()
                /* The request is replayed once with a freshly obtained token (a refresh grant first when
                 * a refresh token is held). A multipart body is not replayed, and a re-authentication
                 * that fails leaves the 401 as the answer. A second 401 is reported as usual. Only the
                 * OAuth2 and OpenID Connect authenticators take part: API key, basic and bearer
                 * credentials are static, so a new attempt could not change the outcome. */
                if (requestBody !is Map<*, *>) {
                    val freshAuthHeaders =
                        try {
                            effectiveAuth.getAuthHeaders()
                        } catch (_: {{invokerPackage}}.errors.{{errorPrefix}}Exception) {
                            null
                        }
                    if (freshAuthHeaders != null) {
                        val replayHeaders = headers.toMutableMap()
                        for (name in freshAuthHeaders.keys) {
                            replayHeaders.keys.removeAll { it.equals(name, ignoreCase = true) }
                        }
                        replayHeaders.putAll(freshAuthHeaders)
                        response = send(replayHeaders)
                    }
                }
            }
            if (response.statusCode < 200 || response.statusCode >= 300) {
                throw ApiException.fromResponse(
                    response.statusCode,
                    response.headers,
                    response.body,
                    method,
                    requestPath,
                    errorSchemas,
                )
            }

            return response
        } catch (e: Throwable) {
            tracker.finishError(e)
            throw e
        }
    }

    /** What the hook is told about the call: the operation, the method, the URL and its host. */
    private fun callInfo(
        method: String,
        operationId: String?,
        urlTemplate: String?,
        url: String,
    ): CallInfo {
        val stripped = url.substringBefore('#').substringBefore('?')
        val host =
            try {
                java.net.URI(stripped).host.orEmpty()
            } catch (_: java.net.URISyntaxException) {
                ""
            }
        return CallInfo(
            operationId.orEmpty(),
            method.uppercase(),
            urlTemplate.orEmpty(),
            stripped,
            host.removePrefix("[").removeSuffix("]").lowercase(),
        )
    }

    /**
     * The full URL of a request: [path] itself when it is absolute, else the configured base
     * URL followed by it.
     */
    private fun resolveUrl(path: String): String =
        if (path.startsWith("http://") || path.startsWith("https://")) {
            path
        } else {
            /* Strip trailing slash from baseUrl when path starts with `/`
             * so baseUrl='https://x/' + path='/y' produces 'https://x/y',
             * not 'https://x//y' which most servers route to 404. */
            val base = if (path.startsWith("/")) config.baseUrl.trimEnd('/') else config.baseUrl
            base + path
        }

    /**
     * The given decode failure of a response, carrying what is needed to diagnose it: the
     * response status, headers and raw body, and the request method and path without its query.
     *
     * @param failure the decode failure
     * @param response the response whose body could not be decoded
     * @param method the HTTP method of the request
     * @param path the URL path of the request
     * @return [failure], with the response and request context set
     */
    protected fun withResponseContext(
        failure: {{invokerPackage}}.errors.SerializationException,
        response: ApiHttpResponse,
        method: String,
        path: String,
    ): {{invokerPackage}}.errors.SerializationException {
        failure.statusCode = response.statusCode
        failure.responseHeaders = response.headers.toMap()
        failure.responseBody = response.body
        failure.requestMethod = method
        failure.requestPath = requestPathOf(resolveUrl(path))
        return failure
    }

    /**
     * The path of [url] without its query string or fragment, the path the failed request
     * is reported with.
     */
    private fun requestPathOf(url: String): String {
        val stripped = url.substringBefore('#').substringBefore('?')
        val path =
            try {
                java.net.URI(stripped).rawPath
            } catch (_: java.net.URISyntaxException) {
                null
            }
        return if (path.isNullOrEmpty()) "/" else path
    }

    /**
     * Invoke an API operation and return the full result including status code,
     * headers, and raw body alongside the deserialized data.
     *
     * Calls [invokeApi] to get the raw [ApiHttpResponse], then deserializes the
     * response body using the [ObjectSerializer] when a return type is expected.
     *
     * @param T the return type
     * @param method     HTTP method (GET, POST, PUT, DELETE, etc.)
     * @param path       URL path (with path params already substituted)
     * @param queryParams query parameters
     * @param headerParams custom header parameters
     * @param body       request body (model object or null)
     * @param accepts    acceptable response content types
     * @param contentType request content type
     * @param auth       optional authenticator for operation-specific auth
     * @param operation  the operation name (Class.operationId) used in error text
     * @param callTimeout optional end-to-end timeout in milliseconds for this call only
     * @param callHeaders optional headers for this call only; they replace a header of the same name
     * @param callMaxRetries optional number of retries for this call only; `0` disables them
     * @param decodeSuccess decodes a success body by the actual status code, for an operation
     *   whose 2xx responses carry different schemas; when null the body is decoded as [T]
     * @param errorSchemas the operation's error factories by declared status (`404`, `4XX`,
     *   `default`), or null when it declares none
     * @param operationId the operation id exactly as written in the spec, told to the call hook
     * @param urlTemplate the spec path template of the operation, told to the call hook
     * @return ApiResult containing deserialized data, status code, raw body, and headers
     * @throws ApiException if the API call fails
     */
    protected suspend inline fun <reified T> invokeApiForResult(
        method: String,
        path: String,
        queryParams: MutableMap<String, Any?>,
        headerParams: MutableMap<String, String>,
        body: Any?,
        accepts: Array<String>,
        contentType: String,
        auth: Authenticator?,
        operation: String,
        callTimeout: Long? = null,
        callHeaders: Map<String, String>? = null,
        callMaxRetries: Int? = null,
        noinline decodeSuccess: ((Int, String) -> T?)? = null,
        errorSchemas: Map<String, {{invokerPackage}}.errors.ErrorFactory>? = null,
        operationId: String? = null,
        urlTemplate: String? = null,
    ): ApiResult<T> {
        val tracker = newCallTracker()
        val response =
            invokeApiTracked(
                method, path, queryParams, headerParams, body, accepts, contentType, auth,
                callTimeout, callHeaders, callMaxRetries, errorSchemas, operationId, urlTemplate, tracker,
            )
        val responseContentType =
            response.headers.entries
                .firstOrNull { it.key.equals("content-type", ignoreCase = true) }
                ?.value ?: ""
        // A void operation (T is Unit) never decodes its body: any success body,
        // JSON or not, is ignored rather than cast or deserialized into Unit.
        val data: T? =
            try {
                try {
                    if (response.body.isNotEmpty() && decodeSuccess != null) {
                        // Several 2xx responses with different schemas: the status code, not the
                        // shape of the body, says which variant this body is.
                        decodeSuccess(response.statusCode, response.body)
                    } else if (response.body.isNotEmpty() && T::class != Unit::class) {
                        if (T::class == ByteArray::class) {
                            // Binary return types must never be JSON-deserialized, even
                            // when the negotiated response Content-Type is JSON (an
                            // operation whose Accept set includes application/json can
                            // still receive raw image bytes). Recover the raw bytes the
                            // way the transport encoded them:
                            //   * application/json: a top-level `format: byte` value is a
                            //     JSON string literal ("dGVzdC1pbWFnZQ==") — JSON-parse to
                            //     strip the quotes/escapes, then base64-decode the inner
                            //     string to the raw bytes. Returning the quoted literal's
                            //     UTF-8 bytes (with the `"`) or the un-decoded base64 text
                            //     would both be wrong.
                            //   * other text content types: the transport keeps the body
                            //     as a decoded string, so the raw bytes are its UTF-8.
                            //   * binary content types: base64-encoded by the transport.
                            if (headerSelector.isJsonMime(responseContentType)) {
                                val document = response.body.trimStart()
                                if (document.startsWith("{") || document.startsWith("[")) {
                                    // A JSON document (content negotiation answered the
                                    // binary operation with its application/json variant):
                                    // the caller gets its raw bytes.
                                    response.body.toByteArray(Charsets.UTF_8) as T
                                } else {
                                    val inner = objectSerializer.deserialize<String>(response.body) ?: ""
                                    try {
                                        java.util.Base64.getDecoder().decode(inner) as T
                                    } catch (e: IllegalArgumentException) {
                                        throw {{invokerPackage}}.errors.SerializationException(
                                            "Invalid base64 value for a format: byte response", e)
                                    }
                                }
                            } else if (isTextResponseContentType(responseContentType)) {
                                response.body.toByteArray(Charsets.UTF_8) as T
                            } else {
                                java.util.Base64.getDecoder().decode(response.body) as T
                            }
                        } else if (responseContentType.isNotEmpty() &&
                            !headerSelector.isJsonMime(responseContentType)
                        ) {
                            // A non-JSON success body is returned verbatim only for a
                            // String return type with a text-class Content-Type; any
                            // other return type is a serialization error rather than
                            // an unchecked cast.
                            if (T::class == String::class && isTextResponseContentType(responseContentType)) {
                                response.body as T
                            } else if (T::class == String::class) {
                                // A binary content type reaches us as the transport's base64
                                // carrier text; the caller gets the decoded body (D107).
                                try {
                                    String(java.util.Base64.getDecoder().decode(response.body), Charsets.UTF_8) as T
                                } catch (e: IllegalArgumentException) {
                                    throw {{invokerPackage}}.errors.SerializationException(
                                        "Invalid base64 body for a binary response", e)
                                }
                            } else {
                                throw {{invokerPackage}}.errors.SerializationException(
                                    "Unexpected response Content-Type '" +
                                        responseContentType.substringBefore(';').trim() +
                                        "' for " + operation + ": expected a JSON body")
                            }
                        } else {
                            objectSerializer.deserialize<T>(response.body)
                        }
                    } else {
                        null
                    }
                } catch (e: {{invokerPackage}}.errors.SerializationException) {
                    throw withResponseContext(e, response, method, path)
                }
            } catch (e: Throwable) {
                tracker.finishError(e)
                throw e
            }
        tracker.finishOk(response.statusCode, response.headers)
        // The result owns a read-only copy: mutating the map the transport handed over
        // must never change what the caller already holds, and the caller cannot change it.
        return ApiResult(
            response.statusCode,
            data,
            response.body,
            java.util.Collections.unmodifiableMap(LinkedHashMap(response.headers)),
        )
    }

    /**
     * Extract the single binary payload from a form-style body Map when a
     * raw-binary content-type (application/octet-stream or an image type) was
     * selected for an operation that also declares multipart/form-data.
     *
     * The API layer always builds a form Map keyed by the operation's
     * declared parts. For a raw-binary upload only the binary part travels on
     * the wire — the auxiliary string parts (classification, notes, ...) belong
     * to the multipart variant and are dropped. This returns the first
     * binary-typed value (`ByteArray`) so the transport sends its raw bytes
     * under the selected Content-Type rather than a multipart envelope.
     *
     * @param formBody the form-style body Map
     * @return the binary part suitable for raw transmission
     * @throws IllegalArgumentException if no binary part is present
     */
    private fun extractBinaryPart(formBody: Map<*, *>): Any {
        for (value in formBody.values) {
            if (value is ByteArray) {
                return value
            }
        }
        throw IllegalArgumentException(
            "No binary payload found in request body for raw octet-stream upload",
        )
    }

    /**
     * Returns true if the value is a valid RFC 6265 cookie name (token).
     * Allowed chars: ALPHA / DIGIT / "!#$%&'*+-.^_`|~".
     *
     * Visible to generated API subclasses so that operation-level cookie
     * parameters can be validated with the exact same RFC 6265 rule the
     * auth-provided cookie path uses, rather than being interpolated into the
     * Cookie header unchecked.
     *
     * @param name the cookie name to validate
     * @return true when the name is a valid RFC 6265 token
     */
    protected fun isValidCookieName(name: String): Boolean {
        if (name.isEmpty()) return false
        return name.all { c ->
            c in 'A'..'Z' || c in 'a'..'z' || c in '0'..'9' || c in "!#$%&'*+-.^_`|~"
        }
    }

    /**
     * Returns true if the value is a valid RFC 6265 cookie value (cookie-octet*).
     * Allowed: %x21 / %x23-2B / %x2D-3A / %x3C-5B / %x5D-7E.
     * Excludes whitespace, DQUOTE, comma, semicolon, backslash, controls.
     * Empty value is allowed.
     *
     * Visible to generated API subclasses so that operation-level cookie
     * parameters can be validated with the exact same RFC 6265 rule the
     * auth-provided cookie path uses. This is what makes a CR/LF or
     * control-char value fail closed instead of being smuggled into the Cookie
     * request header (header injection).
     *
     * @param value the cookie value to validate
     * @return true when the value contains only valid cookie-octets
     */
    protected fun isValidCookieValue(value: String): Boolean {
        return value.all { c ->
            val code = c.code
            code == 0x21 || code in 0x23..0x2B || code in 0x2D..0x3A
                    || code in 0x3C..0x5B || code in 0x5D..0x7E
        }
    }

    /**
     * Mirror of the transport's text/binary content-type classification. The
     * transport base64-encodes the response body for binary content types and
     * leaves text content types (including JSON) as a decoded string, so
     * binary return-type handling must apply the same rule to recover the raw
     * bytes.
     *
     * Marked `@PublishedApi internal` because the public inline
     * [invokeApiForResult] calls it; a `private` helper is not visible from an
     * inlined function body.
     *
     * @param contentType the response Content-Type header value (possibly empty)
     * @return true when the body was kept as decoded text by the transport
     */
    @PublishedApi
    internal fun isTextResponseContentType(contentType: String): Boolean {
        val mediaType =
            contentType
                .substringBefore(';')
                .trim()
                .lowercase()
        if (mediaType.isEmpty()) return true
        if (mediaType.startsWith("text/")) return true
        return mediaType == "application/json" ||
            mediaType == "application/xml" ||
            mediaType == "application/javascript" ||
            mediaType.endsWith("+json") ||
            mediaType.endsWith("+xml")
    }

    /**
     * Build a query string from query parameters.
     *
     * @param queryParams the query parameters
     * @return encoded query string
     */
    private fun buildQueryString(queryParams: Map<String, Any?>): String {
        if (queryParams.isEmpty()) return ""
        val parts = mutableListOf<String>()
        for ((key, rawValue) in queryParams) {
            /* OAS allowReserved: a wrapped value keeps RFC 3986 reserved
             * characters literal instead of percent-encoding them. */
            var value = rawValue
            var allowReserved = false
            if (value is ValueSerializer.AllowReservedValue) {
                value = value.value
                allowReserved = true
            }
            if (value != null) {
                val encodedKey = encodeQuery(key)
                if (value is List<*>) {
                    for (item in value) {
                        parts.add("$encodedKey=${encodeQueryValue(item.toString(), allowReserved)}")
                    }
                } else {
                    parts.add("$encodedKey=${encodeQueryValue(value.toString(), allowReserved)}")
                }
            }
        }
        return parts.joinToString("&")
    }

    /**
     * Encode a query-parameter value, preserving RFC 3986 reserved characters
     * when the parameter declared `allowReserved: true`.
     *
     * @param value the value to encode
     * @param allowReserved whether reserved characters are left literal
     * @return the encoded value
     */
    private fun encodeQueryValue(value: String, allowReserved: Boolean): String =
        if (allowReserved) ValueSerializer.encodeQueryAllowingReserved(value) else encodeQuery(value)

    /**
     * URL-encode a string for an `application/x-www-form-urlencoded` body, where
     * a space is `+` (WHATWG form rules). Used by the form-body serializer.
     * Everything except RFC 3986 unreserved characters is percent-encoded, so
     * `&`, `=`, `+` and `#` in a key or value can never split or merge fields.
     *
     * @param value the string to encode
     * @return URL-encoded string
     */
    internal fun encode(value: String): String = value.encodeURLParameter(spaceToPlus = true)

    /**
     * Rejects a form-urlencoded field value that has no defined encoding. Only
     * scalars (and arrays of them) are encoded; a model or map would otherwise
     * reach the wire as its toString() text.
     */
    private fun requireFormScalar(
        key: String,
        value: Any,
    ) {
        val scalar =
            value is String || value is Number || value is Boolean || value is Char ||
                value is Enum<*> || value is java.time.temporal.TemporalAccessor ||
                value is java.time.Duration || value::class.qualifiedName == "kotlin.uuid.Uuid" ||
                value is java.net.URI || value is ByteArray
        if (!scalar) {
            throw {{invokerPackage}}.errors.SerializationException(
                "form-urlencoded field $key must be a scalar or array of scalars",
            )
        }
    }

    /**
     * URL-encode a string for a URI query component, where a space is `%20`
     * (RFC 3986), not `+`: a strict server reads `+` as a literal plus, and the
     * other SDKs encode query spaces as `%20` too. Everything except RFC 3986
     * unreserved characters is percent-encoded, so `&`, `=`, `+`, `#` and the
     * brackets of a deepObject key never alter the query structure.
     *
     * @param value the string to encode
     * @return URL-encoded string
     */
    internal fun encodeQuery(value: String): String = value.encodeURLParameter(spaceToPlus = false)
}

/** The credentials of every scheme one security requirement names together: all of them are sent. */
private open class AllOfAuthenticator(protected val parts: List<Authenticator>) : Authenticator {
    override fun getHost(): String = parts.first().getHost()

    override suspend fun getAuthHeaders(): Map<String, String> {
        val merged = LinkedHashMap<String, String>()
        for (part in parts) {
            merged.putAll(part.getAuthHeaders())
        }
        return merged
    }

    override fun getQueryParams(): Map<String, String> {
        val merged = LinkedHashMap<String, String>()
        for (part in parts) {
            merged.putAll(part.getQueryParams())
        }
        return merged
    }

    override fun getCookieParams(): Map<String, String> {
        val merged = LinkedHashMap<String, String>()
        for (part in parts) {
            merged.putAll(part.getCookieParams())
        }
        return merged
    }

    companion object {
        /** The composite of [parts]; one holding a token authenticator can drop a cached token on a 401. */
        fun of(parts: List<Authenticator>): Authenticator =
            if (parts.any { it is HttpAwareAuthenticator }) AllOfHttpAwareAuthenticator(parts) else AllOfAuthenticator(parts)
    }
}

private class AllOfHttpAwareAuthenticator(parts: List<Authenticator>) : AllOfAuthenticator(parts), HttpAwareAuthenticator {
    override fun setApiClient(apiClient: ApiClient) {
        for (part in parts) {
            if (part is HttpAwareAuthenticator) {
                part.setApiClient(apiClient)
            }
        }
    }

    override fun invalidateAccessToken() {
        for (part in parts) {
            if (part is HttpAwareAuthenticator) {
                part.invalidateAccessToken()
            }
        }
    }
}
