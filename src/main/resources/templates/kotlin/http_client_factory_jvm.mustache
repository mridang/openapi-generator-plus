package {{invokerPackage}}

import {{invokerPackage}}.errors.ApiException
import io.ktor.client.HttpClient
import io.ktor.client.engine.ProxyBuilder
import io.ktor.client.engine.cio.CIO
import io.ktor.client.plugins.HttpTimeout
import io.ktor.http.Url
import java.io.FileInputStream
import java.security.KeyStore
import java.security.cert.CertificateFactory
import java.security.cert.X509Certificate
import java.net.Socket
import javax.net.ssl.SSLEngine
import javax.net.ssl.TrustManagerFactory
import javax.net.ssl.X509ExtendedTrustManager
import javax.net.ssl.X509TrustManager

/*
 * Gap AM: when verifySsl=false we must skip BOTH certificate-chain
 * validation AND hostname identification (curl -k semantics). Ktor's
 * CIO engine unconditionally calls
 * `SSLEngine.setEndpointIdentificationAlgorithm("HTTPS")`, which
 * triggers hostname verification inside the JSSE handshake — and the
 * JSSE hostname check is only skipped when the trust manager is an
 * `X509ExtendedTrustManager` whose extended `checkServerTrusted`
 * overloads (the ones taking an `SSLEngine` / `Socket`) are no-ops.
 * Subclassing `X509TrustManager` alone causes JSSE to wrap us in an
 * adapter that still performs hostname verification, defeating the
 * "trust all" intent. So we extend the extended variant and override
 * every overload.
 */
private val TRUST_ALL_MANAGER =
    object : X509ExtendedTrustManager() {
        override fun checkClientTrusted(
            chain: Array<X509Certificate>,
            authType: String,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun checkClientTrusted(
            chain: Array<X509Certificate>,
            authType: String,
            socket: Socket?,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun checkClientTrusted(
            chain: Array<X509Certificate>,
            authType: String,
            engine: SSLEngine?,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun checkServerTrusted(
            chain: Array<X509Certificate>,
            authType: String,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun checkServerTrusted(
            chain: Array<X509Certificate>,
            authType: String,
            socket: Socket?,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun checkServerTrusted(
            chain: Array<X509Certificate>,
            authType: String,
            engine: SSLEngine?,
        ) {
            // Accepts every certificate, which is the point of verifySsl=false.
        }

        override fun getAcceptedIssuers(): Array<X509Certificate> = emptyArray()
    }

internal actual fun buildPlatformHttpClient(options: TransportOptions): HttpClient =
    HttpClient(CIO) {
        followRedirects = false
        engine {
            if (options.proxy != null) {
                proxy = ProxyBuilder.http(Url(options.proxy!!))
            }
            https {
                if (!options.verifySsl) {
                    trustManager = TRUST_ALL_MANAGER
                } else if (options.caCertPath != null) {
                    trustManager = loadCaCertTrustManager(options.caCertPath!!)
                }
            }
        }

        // Response bodies are decoded by DefaultApiClient itself, not by
        // Ktor's ContentEncoding plugin: the client must tell a corrupt
        // Content-Encoding body (a response arrived, ApiException with its
        // status) from an I/O failure while reading it (NetworkException).

        if (options.timeout != null) {
            install(HttpTimeout) {
                requestTimeoutMillis = options.timeout.toLong()
                connectTimeoutMillis = options.timeout.toLong()
                socketTimeoutMillis = options.timeout.toLong()
            }
        }

        // Gap T1: redirects are ALWAYS handled manually in DefaultApiClient.sendRequest
        // so that sensitive headers (Authorization, Cookie, Proxy-Authorization)
        // are stripped on cross-origin hops. Ktor's stock HttpRedirect plugin does
        // not strip credentials cross-origin, so we never install it here.
    }

private fun loadCaCertTrustManager(caCertPath: String): X509TrustManager =
    try {
        val cf = CertificateFactory.getInstance("X.509")
        val caCert =
            FileInputStream(caCertPath).use { fis ->
                cf.generateCertificate(fis) as X509Certificate
            }
        val trustStore = KeyStore.getInstance(KeyStore.getDefaultType())
        trustStore.load(null, null)
        trustStore.setCertificateEntry("ca", caCert)
        val tmf = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm())
        tmf.init(trustStore)
        tmf.trustManagers[0] as X509TrustManager
    } catch (e: java.io.IOException) {
        // A missing/unreadable/unparseable CA cert is a configuration mistake, not
        // an API failure: raise IllegalArgumentException (cause preserved) at
        // construction so TLS pinning never silently falls back to the system store.
        throw IllegalArgumentException("failed to read or parse CA certificate from $caCertPath: $e", e)
    } catch (e: java.security.GeneralSecurityException) {
        throw IllegalArgumentException("failed to read or parse CA certificate from $caCertPath: $e", e)
    }
