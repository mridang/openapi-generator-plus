package {{invokerPackage}}

import io.ktor.client.HttpClient
import io.ktor.client.plugins.HttpRedirect
import io.ktor.client.plugins.pluginOrNull

/**
 * Immutable HTTP transport configuration for [DefaultApiClient].
 *
 * Controls low-level HTTP behavior such as TLS verification, proxy routing,
 * timeouts, redirect handling, and automatic header injection. These settings
 * are independent of API-level concerns (base URL, authentication headers)
 * which belong in [Configuration].
 *
 * This class is immutable and thread-safe. Use [builder] to create instances:
 * ```
 * val transport = TransportOptions.builder()
 *     .verifySsl(false)
 *     .proxy("http://proxy.example.com:8080")
 *     .timeout(5000)
 *     .userAgent("MyApp/1.0")
 *     .build()
 * ```
 *
 * @property verifySsl Whether TLS certificate verification is enabled: `true` if the client
 *   verifies server certificates (default), `false` to accept any certificate.
 * @property caCertPath Path to a custom CA certificate bundle for TLS verification. When set
 *   together with `verifySsl=true`, the client trusts certificates signed by this CA in addition
 *   to (or instead of) the system trust store. `null` uses the system default.
 * @property proxy HTTP or HTTPS proxy URL for all outbound requests, for example
 *   `"http://proxy.corp.example.com:3128"`. `null` means direct connections.
 * @property timeout End-to-end request timeout in milliseconds. Covers the entire request
 *   lifecycle: connection, TLS handshake, sending the request body, and reading the response.
 *   Defaults to 60000 ms (60 seconds) when the builder does not set a value. `null` means no
 *   timeout.
 * @property followRedirects Whether the client follows HTTP 3xx redirects automatically: `true` to
 *   follow redirects (default), `false` to return the redirect response as-is.
 * @property maxRedirects Maximum number of consecutive redirects to follow. Only meaningful when
 *   [followRedirects] is `true`. `null` uses the HTTP client's built-in default.
 * @property userAgent Custom `User-Agent` header value. When set, this value is sent as the
 *   `User-Agent` header on every request unless the caller explicitly provides one. `null` omits it.
 * @property defaultHeaders Transport-level default headers included in every request. These headers
 *   have the *lowest* priority: API-level headers from [Configuration.defaultHeaders],
 *   operation-specific headers, and authentication headers all take precedence.
 * @property injectRequestId Whether to auto-inject an `X-Request-ID` header with a unique UUID on
 *   every request. Useful for distributed tracing and log correlation. The header is only injected
 *   if the caller has not already set one.
 * @property httpClient Optional caller-supplied Ktor [HttpClient]. When set, the SDK sends every
 *   request through it, keeps its own timeout, redirect, user-agent and header defaults applied on
 *   top, and never closes it: the caller owns its lifecycle. It cannot be combined with
 *   [proxy], [caCertPath] or `verifySsl=false`; configure those on the supplied client instead.
 *   `null` makes the SDK build its own client.
 * @property maxRetries How many times a failed request is sent again after the first attempt:
 *   `2` by default, `0` turns retries off. A request is retried after a network error that
 *   happened before a response arrived and after a 408, 409, 429 or 5xx (except 501) answer,
 *   waiting 0.5 s doubling to 8 s with up to 25% jitter, or the server's `Retry-After` (capped at
 *   60 s). Retries never extend [timeout]: they share its one end-to-end budget.
 * @property idleTimeout The longest a streamed response body may stay silent, in milliseconds.
 *   Applies only to a call that returns a stream (a binary operation): [timeout] stops at the
 *   response headers, and this value bounds the gap between two reads of the body. A stalled
 *   body raises [{{invokerPackage}}.errors.NetworkTimeoutException]. A buffered call is
 *   unaffected. Defaults to 60000 ms (60 seconds); `null` means the idle timeout is disabled.
 * @property maxResponseBytes The most bytes the default client reads for a buffered response
 *   body. Both the bytes on the wire and the decompressed bytes (gzip, deflate, br, zstd) count
 *   against it, for a success or an error body and for every redirect hop that is read. A body
 *   that passes it raises [{{invokerPackage}}.errors.ResponseTooLargeException] as soon as the
 *   limit is crossed, and the connection is dropped. A streamed response is read by the caller
 *   and is not bounded by it. `null` (the default) means no limit.
 */
class TransportOptions private constructor(
    val verifySsl: Boolean,
    val caCertPath: String?,
    val proxy: String?,
    val timeout: Long?,
    val followRedirects: Boolean,
    val maxRedirects: Int?,
    val userAgent: String?,
    val defaultHeaders: Map<String, String>,
    val injectRequestId: Boolean,
    val httpClient: HttpClient?,
    val maxRetries: Int,
    val idleTimeout: Long?,
    val maxResponseBytes: Long?,
) {
    companion object {
        /* The proxy URL with any user-info replaced by `***@`, so an error message or a string
         * form never carries the proxy credentials (D79). */
        internal fun maskUserInfo(url: String): String {
            val schemeEnd = url.indexOf("://")
            val start = if (schemeEnd == -1) 0 else schemeEnd + 3
            val authorityEnd = url.indexOfAny(charArrayOf('/', '?', '#'), start).let { if (it == -1) url.length else it }
            val at = url.lastIndexOf('@', authorityEnd - 1)
            return if (at <= start) url else url.substring(0, start) + "***@" + url.substring(at + 1)
        }

        /**
         * Create a new builder for constructing [TransportOptions] instances.
         *
         * @return a new builder with sensible defaults
         */
        fun builder(): Builder = Builder()
    }

    /**
     * Builder for creating immutable [TransportOptions] instances.
     *
     * All fields have sensible defaults:
     * - `verifySsl` - `true`
     * - `followRedirects` - `true`
     * - `injectRequestId` - `false`
     * - `timeout` - `60000` (60 seconds)
     * - `maxRetries` - `2`
     * - `idleTimeout` - `60000` (60 seconds)
     * - `maxResponseBytes` - `null` (no limit)
     * - `userAgent` - a package-specific default string
     * - All other fields - `null` or empty
     */
    class Builder {
        private var verifySsl: Boolean = true
        private var caCertPath: String? = null
        private var proxy: String? = null
        private var timeout: Long? = 60000L
        private var followRedirects: Boolean = true
        private var maxRedirects: Int? = null
        private var userAgent: String? = "{{userAgentDefault}}"
        private val defaultHeaders: MutableMap<String, String> = mutableMapOf()
        private var injectRequestId: Boolean = false
        private var httpClient: HttpClient? = null
        private var maxRetries: Int = 2
        private var idleTimeout: Long? = 60_000L
        private var maxResponseBytes: Long? = null

        /**
         * Enable or disable TLS certificate verification.
         *
         * @param verifySsl `true` to verify (default), `false` to skip
         * @return this builder
         */
        fun verifySsl(verifySsl: Boolean): Builder = apply { this.verifySsl = verifySsl }

        /**
         * Set the path to a custom CA certificate bundle.
         *
         * @param caCertPath file path to a PEM-encoded CA certificate, or `null`
         * @return this builder
         */
        fun caCertPath(caCertPath: String?): Builder = apply { this.caCertPath = caCertPath }

        /**
         * Set the HTTP/HTTPS proxy URL.
         *
         * @param proxy proxy URL (e.g. `"http://proxy:3128"`)
         * @return this builder (the URL is validated by [build], not here)
         */
        fun proxy(proxy: String?): Builder = apply { this.proxy = proxy }

        /**
         * Set the end-to-end request timeout in milliseconds.
         *
         * @param timeout timeout in milliseconds, or `null` for no timeout
         * @return this builder
         */
        fun timeout(timeout: Long?): Builder = apply {
            require(timeout == null || timeout > 0) {
                "Invalid timeout: must be a positive number of milliseconds (got $timeout)"
            }
            this.timeout = timeout
        }

        /**
         * Enable or disable automatic redirect following.
         *
         * @param followRedirects `true` to follow (default), `false` to stop
         * @return this builder
         */
        fun followRedirects(followRedirects: Boolean): Builder =
            apply { this.followRedirects = followRedirects }

        /**
         * Set the maximum number of redirects to follow.
         *
         * @param maxRedirects maximum redirect hops (not negative), or `null` for client default
         * @return this builder
         */
        fun maxRedirects(maxRedirects: Int?): Builder = apply {
            require(maxRedirects == null || maxRedirects >= 0) {
                "Invalid maxRedirects: must not be negative (got $maxRedirects)"
            }
            this.maxRedirects = maxRedirects
        }

        /**
         * Set a custom User-Agent header value.
         *
         * @param userAgent the user agent string, or `null` to omit
         * @return this builder
         */
        fun userAgent(userAgent: String?): Builder = apply { this.userAgent = userAgent }

        /**
         * Add a single transport-level default header.
         *
         * @param name header name
         * @param value header value
         * @return this builder
         */
        fun defaultHeader(
            name: String,
            value: String,
        ): Builder = apply { defaultHeaders[name] = value }

        /**
         * Add multiple transport-level default headers.
         *
         * @param headers map of header names to values
         * @return this builder
         */
        fun defaultHeaders(headers: Map<String, String>): Builder =
            apply { defaultHeaders.putAll(headers) }

        /**
         * Enable or disable automatic `X-Request-ID` header injection.
         *
         * @param injectRequestId `true` to inject, `false` to skip (default)
         * @return this builder
         */
        fun injectRequestId(injectRequestId: Boolean): Builder =
            apply { this.injectRequestId = injectRequestId }

        /**
         * Use a caller-supplied Ktor [HttpClient] as the transport.
         *
         * The SDK layers its timeout, redirect policy, user agent and default
         * headers on top of it and never closes it. It conflicts with
         * [proxy], [caCertPath] and `verifySsl(false)`, which configure the
         * SDK's own client: [build] rejects the combination.
         *
         * @param httpClient the client to send requests through, or `null` for the SDK's own
         * @return this builder
         */
        fun httpClient(httpClient: HttpClient?): Builder = apply { this.httpClient = httpClient }

        /**
         * Set how many times a failed request is sent again.
         *
         * A request is retried after a network error that happened before a response and after a
         * 408, 409, 429 or 5xx (except 501) answer. The wait is 0.5 s doubling to 8 s with up to
         * 25% jitter, or the response's `Retry-After` (seconds or an HTTP date, capped at 60 s).
         * Every retry is a fresh request and all retries share the one end-to-end [timeout].
         *
         * @param maxRetries retries after the first attempt (not negative); `0` disables them
         * @return this builder
         */
        fun maxRetries(maxRetries: Int): Builder = apply {
            require(maxRetries >= 0) {
                "Invalid maxRetries: must not be negative (got $maxRetries)"
            }
            this.maxRetries = maxRetries
        }

        /**
         * Set the longest a streamed response body may stay silent, in milliseconds.
         *
         * @param idleTimeout the gap in milliseconds (positive), or `0` or `null` to disable it;
         *   the default is `60000`
         * @return this builder
         */
        fun idleTimeout(idleTimeout: Long?): Builder = apply {
            require(idleTimeout == null || idleTimeout >= 0) {
                "Invalid idleTimeout: must not be negative (got $idleTimeout)"
            }
            this.idleTimeout = if (idleTimeout == null || idleTimeout == 0L) null else idleTimeout
        }

        /**
         * Set the most bytes the default client reads for a buffered response body.
         *
         * See [TransportOptions.maxResponseBytes] for what is counted.
         *
         * @param maxResponseBytes the limit in bytes (positive), or `null` for no limit
         * @return this builder
         * @throws IllegalArgumentException if [maxResponseBytes] is not positive
         */
        fun maxResponseBytes(maxResponseBytes: Long?): Builder = apply {
            require(maxResponseBytes == null || maxResponseBytes > 0) {
                "Invalid maxResponseBytes: must be a positive number of bytes (got $maxResponseBytes)"
            }
            this.maxResponseBytes = maxResponseBytes
        }

        private fun canonicalProxy(proxy: String?): String? {
            if (proxy == null) {
                return null
            }
            val schemeEnd = proxy.indexOf("://")
            if (schemeEnd == -1) {
                throw IllegalArgumentException("Invalid proxy URL (missing scheme): ${maskUserInfo(proxy)}")
            }
            // RFC 3986 schemes are case-insensitive: accept HTTP:// and
            // keep the lower-case form.
            val scheme = proxy.substring(0, schemeEnd).lowercase()
            if (scheme !in listOf("http", "https")) {
                throw IllegalArgumentException(
                    "Invalid proxy URL (must use http or https scheme): ${maskUserInfo(proxy)}",
                )
            }
            /* The host is what follows the optional user-info and precedes the
             * port: `http://@:3128` has the user-info `` and no host at all. */
            val authority = proxy.substring(schemeEnd + 3).split("/", "?", "#").first()
            val hostAndPort = authority.substringAfterLast('@')
            val host =
                if (hostAndPort.startsWith("[")) {
                    // An IPv6 literal must be closed by a bracket.
                    if (!hostAndPort.contains(']')) {
                        throw IllegalArgumentException(
                            "Invalid proxy URL (unterminated IPv6 literal): ${maskUserInfo(proxy)}",
                        )
                    }
                    hostAndPort.substringBefore(']').removePrefix("[")
                } else {
                    hostAndPort.substringBefore(':')
                }
            if (host.isEmpty()) {
                throw IllegalArgumentException("Invalid proxy URL (missing host): ${maskUserInfo(proxy)}")
            }
            return scheme + proxy.substring(schemeEnd)
        }

        /**
         * Build and return an immutable [TransportOptions] instance.
         *
         * @return the configured transport options
         * @throws IllegalArgumentException if the proxy URL is not a valid http or https URL, or if
         *   a custom [httpClient] is combined with a proxy, a CA certificate path or
         *   `verifySsl(false)`, or if it follows redirects itself
         */
        fun build(): TransportOptions {
            val canonical = canonicalProxy(proxy)
            require(httpClient == null || (canonical == null && caCertPath == null && verifySsl)) {
                "A custom httpClient cannot be combined with proxy, caCertPath or verifySsl=false: " +
                    "configure the supplied client instead"
            }
            require(httpClient?.pluginOrNull(HttpRedirect) == null) {
                "A custom httpClient must not follow redirects: build it with followRedirects = false, " +
                    "the SDK manages redirects itself"
            }
            return TransportOptions(
                verifySsl,
                caCertPath,
                canonical,
                timeout,
                followRedirects,
                maxRedirects,
                userAgent,
                defaultHeaders.toMap(),
                injectRequestId,
                httpClient,
                maxRetries,
                idleTimeout,
                maxResponseBytes,
            )
        }
    }

    /**
     * A redacted string form: the proxy password is replaced by `***` and a default header
     * that carries a credential (see [DefaultApiClient.isSensitiveHeader]) prints as `***`
     * (S15, D73, D79). The HTTP client is not printed.
     *
     * @return the string form with the credentials masked
     */
    override fun toString(): String {
        val headers = defaultHeaders.entries.joinToString(", ", "{", "}") { (name, value) ->
            "$name=" + if (DefaultApiClient.isSensitiveHeader(name)) "***" else value
        }
        return "TransportOptions(verifySsl=$verifySsl, caCertPath=$caCertPath, " +
            "proxy=${proxy?.let { maskUserInfo(it) }}, timeout=$timeout, " +
            "followRedirects=$followRedirects, maxRedirects=$maxRedirects, userAgent=$userAgent, " +
            "defaultHeaders=$headers, injectRequestId=$injectRequestId, maxRetries=$maxRetries, " +
            "idleTimeout=$idleTimeout, maxResponseBytes=$maxResponseBytes)"
    }
}
