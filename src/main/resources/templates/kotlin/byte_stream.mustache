package {{invokerPackage}}

import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.flow
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong

/**
 * The body of a binary response, read as it arrives. An operation whose success response is
 * binary returns one instead of buffering the bytes, so a large download never has to fit in
 * memory.
 *
 * Read it with [read] into your own buffer, collect it piece by piece with [chunks], or take every
 * byte with [readAll]. It also carries the [statusCode] and the lower-cased response [headers].
 *
 * [close] is idempotent and aborts the connection instead of draining the rest of the body, so
 * close the stream (`use { }`) when you stop early. A failure after the headers surfaces from a
 * read as a [{{invokerPackage}}.errors.StreamException]; a stall longer than the transport's
 * `idleTimeout` is a [{{invokerPackage}}.errors.NetworkTimeoutException]. Closing the client
 * cancels the streams still open: their next read raises [IllegalStateException].
 *
 * [toString] shows the status code and the number of bytes delivered, never the headers, the
 * URL or the content.
 *
 * @property statusCode the HTTP status code of the response
 * @property headers the response headers, lower-cased names, repeated values joined by `", "`
 */
class ByteStream(
    val statusCode: Int,
    headers: Map<String, String>,
    private val source: ApiStreamBody,
) : AutoCloseable {
    val headers: Map<String, String> = java.util.Collections.unmodifiableMap(LinkedHashMap(headers))

    private val delivered = AtomicLong()
    private val closed = AtomicBoolean()

    /**
     * Reads up to `buffer.size` bytes and suspends until at least one is available.
     *
     * @param buffer where the bytes go
     * @return the number of bytes read, or `-1` when the body has ended
     * @throws IllegalStateException when the stream was closed
     */
    suspend fun read(buffer: ByteArray): Int {
        check(!closed.get()) { "The stream is closed" }
        val count = source.read(buffer)
        if (count > 0) {
            delivered.addAndGet(count.toLong())
        }
        return count
    }

    /**
     * The rest of the body as a cold [Flow] of pieces, in order. Collecting it reads the body
     * once; the stream is closed when the collection ends, whether it read to the end, stopped
     * early or failed.
     *
     * @return the pieces of the body
     */
    fun chunks(): Flow<ByteArray> =
        flow {
            this@ByteStream.use {
                val buffer = ByteArray(CHUNK_SIZE)
                while (true) {
                    val count = read(buffer)
                    if (count < 0) {
                        break
                    }
                    emit(buffer.copyOf(count))
                }
            }
        }

    /**
     * Reads every remaining byte and closes the stream, so the call leaves nothing open.
     *
     * @return the remaining bytes, in order
     * @throws IllegalStateException when the stream was closed before
     */
    suspend fun readAll(): ByteArray =
        this.use {
            val all = java.io.ByteArrayOutputStream()
            val buffer = ByteArray(CHUNK_SIZE)
            while (true) {
                val count = read(buffer)
                if (count < 0) {
                    break
                }
                all.write(buffer, 0, count)
            }
            all.toByteArray()
        }

    /** Closes the stream and aborts the connection; later calls do nothing. */
    override fun close() {
        if (closed.compareAndSet(false, true)) {
            source.close()
        }
    }

    /**
     * Describes the stream by its status code and the bytes delivered so far.
     *
     * @return the redacted description
     */
    override fun toString(): String = "ByteStream(statusCode=$statusCode, bytesDelivered=${delivered.get()})"

    private companion object {
        const val CHUNK_SIZE = 8192
    }
}
