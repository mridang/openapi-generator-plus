package {{invokerPackage}}.auth.oauth

import {{invokerPackage}}.errors.ApiException
import {{invokerPackage}}.ApiClient
import {{invokerPackage}}.errors.OAuth2TokenException
import {{invokerPackage}}.errors.SerializationException
import {{invokerPackage}}.auth.HttpAwareAuthenticator
import java.security.SecureRandom
import java.time.Instant
import java.util.Base64
import java.util.concurrent.atomic.AtomicReference
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive
import kotlinx.serialization.json.doubleOrNull
import kotlinx.serialization.json.jsonObject

/** Longest discovery cache lifetime honoured (one year). */
private const val MAX_DISCOVERY_MAX_AGE_SECONDS: Long = 31_536_000L

/** Clock skew allowed when checking the expiry of an id_token. */
private const val ID_TOKEN_CLOCK_SKEW_SECONDS: Long = 60L

private val NONCE_RANDOM = SecureRandom()

/**
 * Authenticator for OpenID Connect.
 *
 * Fetches the OIDC discovery document to discover the authorization and
 * token endpoints, then delegates to an [OAuth2AuthorizationCodeAuthenticator].
 *
 * Each authorization URL carries a fresh `nonce`. The code exchange validates
 * the claims of the `id_token` in the token response: the nonce of the
 * authorization URL, the discovered issuer, the client id in the audience and
 * an expiry that has not passed (60 seconds of clock skew are allowed). The
 * signature of the id_token is not verified.
 *
 * Implements [HttpAwareAuthenticator] so that both the discovery
 * request and subsequent token exchange requests use the shared
 * [ApiClient] with the same transport configuration (proxy, TLS,
 * timeouts) as regular API calls.
 *
 * @param host API base URL
 * @param openIdConnectUrl OIDC discovery document URL
 * @param clientId OAuth2 client ID
 * @param clientSecret OAuth2 client secret
 * @param redirectUri redirect URI registered with the provider
 * @param scopes requested scopes
 */
open class OpenIdConnectAuthenticator(
    private val host: String,
    private val openIdConnectUrl: String,
    private val clientId: String,
    private val clientSecret: String,
    private val redirectUri: String,
    scopes: List<String>
) : HttpAwareAuthenticator {

    /** OpenID Connect Core 3.1.2.1: the scope parameter must contain `openid`. */
    private val scopes: List<String> = listOf("openid") + scopes.filter { it != "openid" }

    private val json = Json { ignoreUnknownKeys = true }

    @Volatile
    private var apiClient: ApiClient? = null

    @Volatile
    private var delegate: OAuth2AuthorizationCodeAuthenticator? = null

    @Volatile
    private var discoveryExpiry: Instant = Instant.EPOCH

    /** The issuer named by the last discovery document. */
    @Volatile
    private var discoveredIssuer: String? = null

    /** The nonce of the last authorization URL built, until the code exchange uses it. */
    private val pendingNonce = AtomicReference<String?>(null)

    /* Single-flight discovery: concurrent callers that find the document
     * missing or stale wait here and re-check, so one GET serves them all. */
    private val discoveryLock = Mutex()

    /**
     * Inject the shared API client used for discovery and token requests.
     *
     * @param apiClient the shared API client instance
     */
    override fun setApiClient(apiClient: ApiClient) {
        this.apiClient = apiClient
    }

    override fun invalidateAccessToken() {
        delegate?.invalidateAccessToken()
    }

    /**
     * Lazily resolve the delegate by fetching the OIDC discovery document.
     *
     * Honors the `Cache-Control: max-age=<seconds>` header from the discovery
     * response and re-fetches when the cached document is stale. Defaults to
     * the RFC 8414 recommended max-age of 86400 seconds (1 day) when the
     * header is absent or unparseable.
     *
     * @return the resolved authorization code authenticator
     */
    private suspend fun resolveDelegate(): OAuth2AuthorizationCodeAuthenticator {
        val fresh = delegate
        if (fresh != null && Instant.now().isBefore(discoveryExpiry)) {
            return fresh
        }
        return discoveryLock.withLock { discoverLocked() }
    }

    /**
     * Fetch the discovery document and install the delegate; runs under
     * [discoveryLock]. A failed fetch leaves the previous delegate and its
     * expiry untouched, so the error propagates and the next call retries.
     */
    private suspend fun discoverLocked(): OAuth2AuthorizationCodeAuthenticator {
        val cached = delegate
        if (cached != null && Instant.now().isBefore(discoveryExpiry)) {
            return cached
        }

        val client = apiClient ?: throw IllegalStateException(
            "ApiClient has not been injected. " +
                "Ensure the {{clientClassName}} constructor calls setApiClient() " +
                "on HttpAwareAuthenticator before making API requests."
        )

        /* Discovery is an HTTP call like any other: a transport failure
         * propagates unchanged as NetworkException / NetworkTimeoutException. */
        val headers = mapOf("Accept" to "application/json")
        /* The discovery document lives on the identity provider's host: sent as a no-redirect
         * request, it neither carries the transport's default headers (an API Authorization or
         * key header) nor follows a redirect to some other host (F860). */
        val response = client.sendRequest("GET", openIdConnectUrl, headers, null, noRedirect = true)
        /* Guard the HTTP status before parsing: a 5xx/4xx discovery
         * response is typically an HTML/text error page, which would
         * otherwise surface as a confusing "invalid JSON" error instead
         * of the real "discovery failed" condition. */
        if (response.statusCode < 200 || response.statusCode >= 300) {
            throw ApiException.fromResponse(
                response.statusCode,
                response.headers,
                response.body,
                "GET",
                discoveryPath(),
            )
        }

        val discovery = try {
            json.parseToJsonElement(response.body).jsonObject
        } catch (_: IllegalArgumentException) {
            /* kotlinx.serialization.SerializationException extends
             * IllegalArgumentException, as does .jsonObject on a non-object.
             * Neither the message nor the cause is kept: the parser quotes a
             * "JSON input" excerpt of the body. */
            throw SerializationException("OIDC discovery document is not a JSON object")
        }
        val authorizationEndpoint = requireEndpoint(discovery, "authorization_endpoint")
        val tokenEndpoint = requireEndpoint(discovery, "token_endpoint")

        /* OpenID Connect Discovery 1.0 section 4.3 / RFC 8414 section 3.3: the issuer in the
         * document must be identical to the URL the document was discovered under, and the
         * endpoints must not downgrade to cleartext (client secret, code and refresh token
         * travel to them, so clear text is allowed only to a loopback host). */
        val expectedIssuer = openIdConnectUrl.removeSuffix("/.well-known/openid-configuration").trimEnd('/')
        val issuer = (discovery["issuer"] as? kotlinx.serialization.json.JsonPrimitive)
            ?.takeIf { it.isString }
            ?.content
        if (issuer == null || issuer.trimEnd('/') != expectedIssuer) {
            throw SerializationException("OIDC discovery issuer does not match the discovery URL")
        }
        for ((field, endpoint) in listOf("authorization_endpoint" to authorizationEndpoint, "token_endpoint" to tokenEndpoint)) {
            if (!isSecureOrLoopback(endpoint)) {
                throw SerializationException("OIDC discovery '$field' must use https")
            }
        }

        /* Rediscovery refreshes the endpoints only: the replacement delegate is
         * built around the previous delegate's token manager, so the exchanged
         * session (tokens and the exchanged flag) survives it. */
        val resolved = OAuth2AuthorizationCodeAuthenticator(
            host = host,
            clientId = clientId,
            clientSecret = clientSecret,
            authorizationUrl = authorizationEndpoint,
            tokenUrl = tokenEndpoint,
            redirectUri = redirectUri,
            scopes = scopes,
            refreshUrl = null,
            tokenManager = cached?.tokenManager ?: OAuth2TokenManager(),
        )
        resolved.setApiClient(client)
        /* The PKCE verifier of an authorization URL already handed out must survive rediscovery,
         * or the code that comes back could not be exchanged. */
        resolved.pkceVerifier = cached?.pkceVerifier
        this.delegate = resolved
        this.discoveredIssuer = issuer
        this.discoveryExpiry = Instant.now().plusSeconds(parseMaxAge(response.headers))
        return resolved
    }

    /** The path of the discovery URL, the path a failed discovery request is reported with. */
    private fun discoveryPath(): String =
        try {
            java.net.URI(openIdConnectUrl).rawPath?.takeIf { it.isNotEmpty() } ?: "/"
        } catch (_: java.net.URISyntaxException) {
            "/"
        }

    /**
     * Extract a required endpoint URL from the discovery document, validating
     * that it is present and non-empty.
     *
     * @param discovery the parsed discovery document
     * @param field the discovery field name (e.g. `token_endpoint`)
     * @return the endpoint URL
     * @throws SerializationException if the field is absent, null, not a
     *   string, or empty
     */
    private fun requireEndpoint(
        discovery: kotlinx.serialization.json.JsonObject,
        field: String,
    ): String {
        val primitive = discovery[field] as? kotlinx.serialization.json.JsonPrimitive
        if (primitive == null || !primitive.isString || primitive.content.isEmpty()) {
            throw SerializationException("OIDC discovery document is missing '$field'")
        }
        return primitive.content
    }

    /**
     * Whether a discovered endpoint may carry the client secret and the code: https, or
     * clear text to a loopback host (RFC 8252 section 8.3), as the other eleven SDKs allow.
     */
    private fun isSecureOrLoopback(url: String): Boolean {
        if (url.startsWith("https://", ignoreCase = true)) {
            return true
        }
        if (!url.startsWith("http://", ignoreCase = true)) {
            return false
        }
        val host = try {
            java.net.URI(url).host
        } catch (_: IllegalArgumentException) {
            null
        }
        return host != null &&
            (host.equals("localhost", ignoreCase = true) || host == "127.0.0.1" || host == "[::1]")
    }

    /**
     * Parse `Cache-Control: max-age=<seconds>` from response headers.
     *
     * @param headers the response headers
     * @return the parsed max-age in seconds, at most one year so a huge value
     *   cannot overflow the expiry instant, or 86400 (RFC 8414 default) if
     *   the header is absent or does not contain a `max-age` directive
     */
    private fun parseMaxAge(headers: Map<String, String>): Long {
        val cacheControl = headers.entries
            .firstOrNull { it.key.equals("Cache-Control", ignoreCase = true) }
            ?.value
            ?: return 86400L
        val match = Regex("max-age=(\\d+)", RegexOption.IGNORE_CASE).find(cacheControl)
            ?: return 86400L
        return match.groupValues[1].toBigInteger().min(MAX_DISCOVERY_MAX_AGE_SECONDS.toBigInteger()).toLong()
    }

    /**
     * Build the authorization URL using the discovered authorization endpoint.
     *
     * @param state CSRF state parameter
     * @return the authorization URL
     */
    suspend fun buildAuthorizationUrl(state: String? = null): String {
        val url = resolveDelegate().buildAuthorizationUrl(state)
        /* OpenID Connect Core 3.1.2.1: a fresh nonce binds the id_token to this
         * request; the exchange checks it once. */
        val nonce = newNonce()
        pendingNonce.set(nonce)
        return "$url&nonce=$nonce"
    }

    /**
     * Exchange an authorization code for tokens using the discovered token endpoint.
     *
     * @param code the authorization code from the callback
     */
    suspend fun exchangeCode(code: String) {
        val current = resolveDelegate()
        val nonce = pendingNonce.getAndSet(null)
        val issuer = discoveredIssuer
        current.exchangeCode(code) { idToken -> validateIdToken(idToken, nonce, issuer) }
    }

    /**
     * Validate the claims of the id_token of a code exchange (OpenID Connect
     * Core 3.1.3.7): the nonce of the authorization URL when one was sent, the
     * discovered issuer, the client id in the audience and the expiry. A
     * response without an id_token is not checked. The payload is decoded
     * without verifying the signature.
     *
     * @throws OAuth2TokenException when a claim does not hold
     */
    private fun validateIdToken(idToken: String?, nonce: String?, issuer: String?) {
        if (idToken == null) {
            return
        }
        val claims = decodeIdToken(idToken)
        if (nonce != null && stringClaim(claims["nonce"]) != nonce) {
            throw OAuth2TokenException("The id_token nonce does not match the authorization request")
        }
        val iss = stringClaim(claims["iss"])
        if (issuer == null || iss != issuer) {
            throw OAuth2TokenException("The id_token issuer does not match the discovered issuer")
        }
        if (!audienceContains(claims["aud"])) {
            throw OAuth2TokenException("The id_token audience does not contain the client id")
        }
        val exp = (claims["exp"] as? JsonPrimitive)?.takeIf { !it.isString }?.doubleOrNull
            ?: throw OAuth2TokenException("The id_token is malformed")
        if (Instant.now().epochSecond >= exp + ID_TOKEN_CLOCK_SKEW_SECONDS) {
            throw OAuth2TokenException("The id_token has expired")
        }
    }

    /** The claims of a compact JWS: the second segment, base64url-decoded JSON. */
    private fun decodeIdToken(idToken: String): JsonObject {
        val parts = idToken.split('.')
        if (parts.size != 3) {
            throw OAuth2TokenException("The id_token is malformed")
        }
        return try {
            json.parseToJsonElement(String(Base64.getUrlDecoder().decode(parts[1]), Charsets.UTF_8)).jsonObject
        } catch (_: IllegalArgumentException) {
            /* Bad base64url, bad JSON and a payload that is not an object all land here. */
            throw OAuth2TokenException("The id_token is malformed")
        }
    }

    private fun stringClaim(claim: JsonElement?): String? =
        (claim as? JsonPrimitive)?.takeIf { it.isString }?.content

    private fun audienceContains(aud: JsonElement?): Boolean =
        when (aud) {
            is JsonArray -> aud.any { stringClaim(it) == clientId }
            else -> stringClaim(aud) == clientId
        }

    /** A fresh nonce: 32 random bytes as unpadded base64url, 43 characters. */
    private fun newNonce(): String {
        val bytes = ByteArray(32)
        NONCE_RANDOM.nextBytes(bytes)
        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes)
    }

    override fun getHost(): String = host

    override suspend fun getAuthHeaders(): Map<String, String> {
        return resolveDelegate().getAuthHeaders()
    }

    /**
     * Returns a string representation that redacts the client secret so
     * credentials never leak into logs or stack traces (matching the other
     * SDKs).
     *
     * @return a redacted string representation
     */
    override fun toString(): String =
        "${this::class.simpleName}(host=$host, openIdConnectUrl=$openIdConnectUrl, clientId=$clientId, " +
            "clientSecret=***, redirectUri=$redirectUri, scopes=$scopes)"
}
