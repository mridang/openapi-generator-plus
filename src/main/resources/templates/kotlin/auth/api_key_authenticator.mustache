package {{invokerPackage}}.auth

/**
 * Authenticator for API key authentication. Supports sending the key
 * as a header, query parameter, or cookie.
 *
 * The key is [apiKey], or whatever [apiKeyProvider] returns on every
 * request, for a key that rotates, or else the environment variable `{{envVarPrefix}}_API_KEY` (read
 * once, here; an empty value counts as unset; a provider that is passed wins over it). When none of
 * them is given, building the authenticator
 * fails.
 *
 * @param host the base URL of the API
 * @param keyParamName the name of the header, query parameter, or cookie carrying the key
 * @param apiKey the API key value
 * @param location where the API key is sent on each request
 * @param apiKeyProvider returns the current API key on each request
 * @throws IllegalArgumentException if there is no key, or it is not a valid value for its location
 */
open class ApiKeyAuthenticator internal constructor(
    private val host: String,
    private val keyParamName: String,
    apiKey: String?,
    private val location: ApiKeyLocation,
    private val apiKeyProvider: (suspend () -> String)?,
    environmentVariable: String,
) : BaseAuthenticator() {

    /**
     * Creates an authenticator that reads `{{envVarPrefix}}_API_KEY` when no key is passed.
     *
     * @param host the base URL of the API
     * @param keyParamName the name of the header, query parameter, or cookie carrying the key
     * @param apiKey the API key value
     * @param location where the API key is sent on each request
     * @param apiKeyProvider returns the current API key on each request
     * @throws IllegalArgumentException if there is no key, or it is not a valid value for its location
     */
    constructor(
        host: String,
        keyParamName: String,
        apiKey: String? = null,
        location: ApiKeyLocation,
        apiKeyProvider: (suspend () -> String)? = null,
    ) : this(host, keyParamName, apiKey, location, apiKeyProvider, "{{envVarPrefix}}_API_KEY")

    private val apiKey: String? =
        if (apiKeyProvider != null) {
            require(apiKey == null) { "Pass either apiKey or apiKeyProvider, not both" }
            null
        } else {
            apiKey ?: CredentialEnvironment.read(environmentVariable) ?: throw IllegalArgumentException(
                "An API key for '$keyParamName' is required: pass one, pass an apiKeyProvider or set $environmentVariable"
            )
        }

    init {
        this.apiKey?.let { validateKey(it) }
    }

    private fun validateKey(apiKey: String) {
        // Validation applies to ALL locations: empty/whitespace API keys
        // are always a programmer error; CR/LF/NUL would either inject
        // HTTP headers (HEADER location) or break URL/cookie construction
        // (QUERY/COOKIE — even though URL-encoded later, trapping at
        // construction surfaces the bug clearly). RFC 7230 §3.2.6 printable-
        // ASCII rule still applies to HEADER values.
        if (apiKey.all { c -> c == ' ' || c in '\t'..'\r' }) {
            throw IllegalArgumentException(
                "API key value for '$keyParamName' must not be empty"
            )
        }
        if (apiKey.any { c -> c == '\r' || c == '\n' || c == '\u0000' }) {
            throw IllegalArgumentException(
                "API key value for '$keyParamName' contains forbidden control characters (CR/LF/NUL)"
            )
        }
        if (location == ApiKeyLocation.HEADER &&
            apiKey.any { c -> c != '\t' && (c.code < 0x20 || c.code >= 0x7F) }
        ) {
            throw IllegalArgumentException(
                "API key for header '$keyParamName' must contain only printable ASCII characters (RFC 7230 §3.2.6)"
            )
        }
    }

    override fun getHost(): String = host

    /* The key of this request: the provider's current value, or the one fixed at construction. The
     * query and cookie accessors are not suspending, so a provider's value is fetched by
     * getAuthHeaders (which runs first on every request) and kept for them. */
    @Volatile
    private var current: String? = this.apiKey

    private suspend fun currentKey(): String {
        val provider = apiKeyProvider
        if (this.apiKey == null && provider != null) {
            val fresh = provider.invoke()
            validateKey(fresh)
            current = fresh
        }
        return requireNotNull(current)
    }

    override suspend fun getAuthHeaders(): Map<String, String> {
        val key = currentKey()
        return if (location == ApiKeyLocation.HEADER) mapOf(keyParamName to key) else emptyMap()
    }

    override fun getQueryParams(): Map<String, String> =
        if (location == ApiKeyLocation.QUERY) mapOf(keyParamName to requireNotNull(current)) else emptyMap()

    override fun getCookieParams(): Map<String, String> =
        if (location == ApiKeyLocation.COOKIE) mapOf(keyParamName to requireNotNull(current)) else emptyMap()

    /**
     * Returns a string representation that redacts the API key so credentials
     * never leak into logs or stack traces (matching the other SDKs).
     *
     * @return a redacted string representation
     */
    override fun toString(): String =
        "${this::class.simpleName}(host=$host, keyParamName=$keyParamName, apiKey=***, location=$location)"
}
