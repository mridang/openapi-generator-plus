package {{invokerPackage}}.auth

import java.util.Base64

/**
 * Authenticator for HTTP Basic authentication.
 *
 * Each credential is the first of: the argument, the environment variable
 * `{{credentialEnvPrefix}}_USERNAME` or `{{credentialEnvPrefix}}_PASSWORD` (read once, here; an empty
 * value counts as unset). When one is missing, building the authenticator fails.
 *
 * @param host the base URL of the API
 * @param username the Basic auth user-id
 * @param password the Basic auth password
 * @throws IllegalArgumentException if a credential is missing or malformed
 */
open class BasicAuthenticator(
    private val host: String,
    username: String? = null,
    password: String? = null,
) : BaseAuthenticator() {

    private val username: String =
        username ?: CredentialEnvironment.read("USERNAME") ?: throw IllegalArgumentException(
            "A Basic auth username is required: pass one or set ${CredentialEnvironment.variable("USERNAME")}"
        )

    private val password: String =
        password ?: CredentialEnvironment.read("PASSWORD") ?: throw IllegalArgumentException(
            "A Basic auth password is required: pass one or set ${CredentialEnvironment.variable("PASSWORD")}"
        )

    init {
        // Validate eagerly at construction so a malformed credential surfaces
        // where it is supplied rather than lazily at first request.
        // RFC 7617 §2 — user-id MUST NOT contain ':' (it is the field
        // separator) and neither user-id nor password may carry CR/LF/NUL
        // (header-injection / smuggling vectors common when credentials
        // are read from .env files or interactive prompts).
        if (this.username.any { c -> c == '\r' || c == '\n' || c == '\u0000' }) {
            throw IllegalArgumentException(
                "Basic auth username must not contain CR, LF, or NUL characters"
            )
        }
        if (this.username.contains(':')) {
            throw IllegalArgumentException(
                "Basic auth username must not contain ':' (RFC 7617 §2)"
            )
        }
        if (this.password.any { c -> c == '\r' || c == '\n' || c == '\u0000' }) {
            throw IllegalArgumentException(
                "Basic auth password must not contain CR, LF, or NUL characters"
            )
        }
    }

    override fun getHost(): String = host

    override suspend fun getAuthHeaders(): Map<String, String> {
        val credentials = Base64.getEncoder().encodeToString("$username:$password".toByteArray())
        return mapOf("Authorization" to "Basic $credentials")
    }

    /**
     * Returns a string representation that redacts the password so credentials
     * never leak into logs or stack traces (matching the other SDKs).
     *
     * @return a redacted string representation
     */
    override fun toString(): String =
        "${this::class.simpleName}(host=$host, username=$username, password=***)"
}
