package {{invokerPackage}}.errors

import {{invokerPackage}}.ObjectSerializer
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive

/**
 * Exception thrown when an API call fails.
 */
open class ApiException : {{errorPrefix}}Exception {
    /** The HTTP status code. */
    val statusCode: Int

    /** The HTTP response headers, if available. */
    val responseHeaders: Map<String, String>?

    /** The raw HTTP response body, if available. */
    val responseBody: String?

    /** The deserialized error body as stored by the constructor, or null if not available. */
    private val decodedErrorBody: Any?

    /** The deserialized error body, or null if not available. */
    open val errorBody: Any?
        get() = decodedErrorBody

    /** The HTTP method of the request that failed (for example `GET`), or null when it is not known. */
    var requestMethod: String?
        internal set

    /** The path of the request that failed, without its query string, or null when it is not known. */
    var requestPath: String?
        internal set

    /**
     * Construct an exception with a detail message and no response context.
     *
     * @param message the detail message
     */
    constructor(message: String) : super(message) {
        this.statusCode = 0
        this.responseHeaders = null
        this.responseBody = null
        this.decodedErrorBody = null
        this.requestMethod = null
        this.requestPath = null
    }

    /**
     * Construct an exception that preserves the underlying transport cause.
     *
     * Used when a send/read failure (connection reset, read timeout,
     * DNS failure) is wrapped: the original exception is retained as the
     * [cause] so callers can inspect the root error
     * rather than only a stringified message.
     *
     * @param message the detail message
     * @param cause the underlying transport exception
     * @param requestMethod the HTTP method of the request that failed, if known
     * @param requestPath the path of the request that failed, without its query string, if known
     */
    constructor(
        message: String,
        cause: Throwable,
        requestMethod: String? = null,
        requestPath: String? = null
    ) : super(message, cause) {
        this.statusCode = 0
        this.responseHeaders = null
        this.responseBody = null
        this.decodedErrorBody = null
        this.requestMethod = requestMethod
        this.requestPath = requestPath
    }

    /**
     * Construct an exception for a response that arrived but could not be
     * used, such as a body whose Content-Encoding cannot be decoded.
     *
     * The status code is the real status of the response that arrived,
     * and the underlying failure is kept as the [cause].
     *
     * @param statusCode the HTTP status code of the response that arrived
     * @param message the detail message
     * @param cause the underlying failure
     */
    constructor(statusCode: Int, message: String, cause: Throwable) : super(message, cause) {
        this.statusCode = statusCode
        this.responseHeaders = null
        this.responseBody = null
        this.decodedErrorBody = null
        this.requestMethod = null
        this.requestPath = null
    }

    /**
     * Construct an exception for a response that arrived but could not be used, keeping its
     * real headers and the failure that made it unusable.
     *
     * @param statusCode the HTTP status code
     * @param message the detail message
     * @param responseHeaders the HTTP response headers
     * @param cause the underlying failure
     */
    constructor(
        statusCode: Int,
        message: String,
        responseHeaders: Map<String, String>?,
        cause: Throwable
    ) : super(message, cause) {
        this.statusCode = statusCode
        this.responseHeaders = responseHeaders?.toMap()
        this.responseBody = null
        this.decodedErrorBody = null
        this.requestMethod = null
        this.requestPath = null
    }

    /**
     * Construct an exception with full response context.
     *
     * @param statusCode the HTTP status code
     * @param message the detail message
     * @param responseHeaders the HTTP response headers, if available
     * @param responseBody the raw HTTP response body, if available
     * @param errorBody the deserialized error body, if available
     * @param cause the underlying failure, if any
     * @param requestMethod the HTTP method of the request that failed, if known
     * @param requestPath the path of the request that failed, without its query string, if known
     */
    constructor(
        statusCode: Int,
        message: String,
        responseHeaders: Map<String, String>?,
        responseBody: String?,
        errorBody: Any? = null,
        cause: Throwable? = null,
        requestMethod: String? = null,
        requestPath: String? = null
    ) : super(message, cause) {
        this.statusCode = statusCode
        // Defensive immutable copy so the stored headers cannot be mutated by
        // the caller after construction.
        this.responseHeaders = responseHeaders?.toMap()
        this.responseBody = responseBody
        this.decodedErrorBody = errorBody
        this.requestMethod = requestMethod
        this.requestPath = requestPath
    }

    companion object {
        /**
         * Map an HTTP response that was not a success to the exception for its status.
         *
         * 400, 401, 402, 403, 404, 405, 408, 409, 410, 413, 415, 422, 423 and 429 map to their named [ClientException]
         * subclasses and any other 4xx to [ClientException]; 500, 501, 502, 503 and 504
         * map to their named [ServerException] subclasses and any other 5xx to [ServerException];
         * any other status maps to `ApiException` itself. A JSON body is decoded
         * and exposed through [errorBody]; a body that is not JSON leaves
         * the error body `null`.
         *
         * @param statusCode the HTTP status code of the response
         * @param responseHeaders the HTTP response headers, if available
         * @param responseBody the raw HTTP response body, if available
         * @param requestMethod the HTTP method of the request that failed, if known
         * @param requestPath the path of the request that failed, without its query string, if known
         * @param errorSchemas the operation's error factories by declared status (`404`, `4XX`, `default`),
         *   or null; the factory for the exact status, then the range, then `default` builds the
         *   exception of its error schema
         * @return the exception for the status; the caller throws it
         */
        @JvmStatic
        @JvmOverloads
        fun fromResponse(
            statusCode: Int,
            responseHeaders: Map<String, String>?,
            responseBody: String?,
            requestMethod: String? = null,
            requestPath: String? = null,
            errorSchemas: Map<String, ErrorFactory>? = null,
        ): ApiException {
            if (errorSchemas != null) {
                val factory =
                    errorSchemas[statusCode.toString()]
                        ?: (if (statusCode in 400..499) errorSchemas["4XX"] else null)
                        ?: (if (statusCode in 500..599) errorSchemas["5XX"] else null)
                        ?: errorSchemas["default"]
                if (factory != null) {
                    return factory.create(requestMethod, requestPath, statusCode, responseHeaders, responseBody)
                }
            }
            return build(statusCode, responseHeaders, responseBody, requestMethod, requestPath, null)
        }

        /**
         * The status exception for a response whose body did not match its declared error
         * schema: the exception [fromResponse] gives, with the decoding failure as its cause.
         *
         * @param statusCode the HTTP status code of the response
         * @param responseHeaders the HTTP response headers, if available
         * @param responseBody the raw HTTP response body, if available
         * @param requestMethod the HTTP method of the request that failed, if known
         * @param requestPath the path of the request that failed, without its query string, if known
         * @param cause why the body could not be decoded
         * @return the status exception, carrying the raw body and the cause
         */
        @JvmStatic
        fun statusFallback(
            statusCode: Int,
            responseHeaders: Map<String, String>?,
            responseBody: String?,
            requestMethod: String?,
            requestPath: String?,
            cause: Throwable,
        ): ApiException = build(statusCode, responseHeaders, responseBody, requestMethod, requestPath, cause)

        private fun build(
            statusCode: Int,
            responseHeaders: Map<String, String>?,
            responseBody: String?,
            requestMethod: String?,
            requestPath: String?,
            cause: Throwable?,
        ): ApiException {
            val message = "API returned status code $statusCode"
            // kotlinx reads a bare token such as <html> as a non-string primitive
            // even with isLenient off, so only a real JSON number, true, false or
            // null counts as a JSON body here.
            val jsonLiteral = Regex("true|false|null|-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?")
            val errorBody: Any? =
                if (responseBody.isNullOrEmpty()) {
                    null
                } else {
                    try {
                        // Route through ObjectSerializer so the nesting-depth
                        // cap refuses a deeply-nested error payload before it
                        // can recurse through the call stack.
                        ObjectSerializer().parseToJsonElement(responseBody)
                            .takeIf { it !is JsonPrimitive || it.isString || jsonLiteral.matches(it.content) }
                    } catch (_: SerializationException) {
                        null
                    }
                }
            return when (statusCode) {
                400 -> BadRequestException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                401 -> UnauthorizedException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                403 -> ForbiddenException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                404 -> NotFoundException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                409 -> ConflictException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                422 -> UnprocessableEntityException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                429 -> TooManyRequestsException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                402 -> PaymentRequiredException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                405 -> MethodNotAllowedException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                408 -> RequestTimeoutException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                410 -> GoneException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                413 -> PayloadTooLargeException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                415 -> UnsupportedMediaTypeException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                423 -> LockedException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                in 400..499 -> ClientException(statusCode, message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                500 -> InternalServerErrorException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                501 -> NotImplementedException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                502 -> BadGatewayException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                503 -> ServiceUnavailableException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                504 -> GatewayTimeoutException(message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                in 500..599 -> ServerException(statusCode, message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
                else -> ApiException(statusCode, message, responseHeaders, responseBody, errorBody, cause, requestMethod, requestPath)
            }
        }
    }

    /**
     * Whether repeating the request can succeed: the status is 408, 409, 429 or a 5xx other than
     * 501, the statuses the client itself retries.
     */
    val isRetryable: Boolean
        get() = statusCode == 408 || statusCode == 409 || statusCode == 429 ||
            (statusCode in 500..599 && statusCode != 501)

    /** The request id the server sent in the `x-request-id` response header, or null when it is absent. */
    val requestId: String?
        get() = responseHeaders?.entries?.firstOrNull { it.key.equals("x-request-id", ignoreCase = true) }?.value

    /**
     * Deserialize the raw response body into the given type.
     *
     * Useful when the API returns a structured error body that you want to
     * access in a strongly-typed way.
     *
     * @param T the type to deserialize the error body into
     * @return the deserialized error body, or null if the body is empty
     */
    inline fun <reified T> getTypedErrorBody(): T? {
        val body = responseBody
        if (body.isNullOrEmpty()) {
            return null
        }
        return ObjectSerializer().deserialize<T>(body)
    }

    /**
     * Render the error as the message followed by whatever response context
     * was captured, one labelled field per line.
     *
     * [message] is deliberately not overridden: it keeps returning the detail
     * message the exception was constructed with.
     *
     * @return the human-readable rendering of this exception
     */
    override fun toString(): String {
        val detail = message
        val rendered = StringBuilder(
            if (detail.isNullOrEmpty()) "Error message: the server returns an error" else detail,
        )
        if (statusCode != 0) {
            rendered.append("\nHTTP status code: ").append(statusCode)
        }
        if (requestMethod != null && requestPath != null) {
            rendered.append("\nRequest: ").append("$requestMethod $requestPath")
        }
        val headers = responseHeaders
        if (!headers.isNullOrEmpty()) {
            rendered.append("\nResponse headers: ").append(compactJson(maskCredentialHeaders(headers)))
        }
        val body = responseBody
        if (!body.isNullOrEmpty()) {
            rendered.append("\nResponse body: ").append(renderBody(body))
        }
        return rendered.toString()
    }
}

/** The most body bytes the rendered form shows; the full body stays on [ApiException.responseBody]. */
private const val MAX_RENDERED_BODY_BYTES = 1024

/** Response headers whose value is a credential or a cookie, whatever else their name says. */
private val CREDENTIAL_HEADER_NAMES: Set<String> =
    setOf(
        "authorization",
        "proxy-authorization",
        "cookie",
        "set-cookie",
        "www-authenticate",
        "proxy-authenticate",
    )

/** The headers with every credential-bearing value replaced by `***`. */
private fun maskCredentialHeaders(headers: Map<String, String>): Map<String, String> =
    headers.mapValues { (name, value) ->
        val lower = name.lowercase(java.util.Locale.ROOT)
        if (lower in CREDENTIAL_HEADER_NAMES || "key" in lower || "token" in lower || "secret" in lower) {
            "***"
        } else {
            value
        }
    }

/**
 * The body as shown in the rendered form: at most [MAX_RENDERED_BODY_BYTES] UTF-8 bytes (never
 * cut inside a character) followed by `... (N more bytes)`, with every control character
 * written as `\xNN` so a hostile server cannot forge log lines.
 */
private fun renderBody(body: String): String {
    val bytes = body.toByteArray(Charsets.UTF_8)
    var end = minOf(bytes.size, MAX_RENDERED_BODY_BYTES)
    while (end < bytes.size && end > 0 && (bytes[end].toInt() and 0xC0) == 0x80) {
        end--
    }
    val shown = String(bytes, 0, end, Charsets.UTF_8)
    val escaped = StringBuilder(shown.length)
    for (c in shown) {
        if (c.code < 0x20 || c.code == 0x7F) {
            escaped.append("\\x").append(c.code.toString(16).uppercase().padStart(2, '0'))
        } else {
            escaped.append(c)
        }
    }
    if (end < bytes.size) {
        escaped.append("... (").append(bytes.size - end).append(" more bytes)")
    }
    return escaped.toString()
}

/** The headers as one compact JSON object with sorted keys, the same text in every SDK. */
private fun compactJson(headers: Map<String, String>): String =
    JsonObject(headers.toSortedMap().mapValues { JsonPrimitive(it.value) }).toString()
