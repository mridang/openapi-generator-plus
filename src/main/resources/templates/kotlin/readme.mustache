    client.{{#jsonLinesStreamGroup}}{{clientPropertyName}}{{/jsonLinesStreamGroup}}.{{vendorExtensions.op.streamMethodName}}({{#vendorExtensions.op.signatureArgsNoServer}}{{^-first}}, {{/-first}}{{paramName}}{{/vendorExtensions.op.signatureArgsNoServer}}).use { feed ->
