package {{invokerPackage}}.errors

/**
 * Exception for a response body that failed after its headers arrived: the connection was reset,
 * or the body ended before its declared length. A [NetworkException], so the status code is
 * always 0; the headers had arrived, but the body the caller was promised did not. The
 * underlying failure is kept as the cause. An idle stall is a [NetworkTimeoutException] and a
 * body that cannot be decoded is a [SerializationException], not this.
 *
 * @param message the error message
 * @param cause the underlying failure
 * @param requestMethod the HTTP method of the request whose body failed, if known
 * @param requestPath the path of the request whose body failed, without its query string, if known
 */
class StreamException(
    message: String,
    cause: Throwable,
    requestMethod: String? = null,
    requestPath: String? = null,
) : NetworkException(message, cause, requestMethod, requestPath)
