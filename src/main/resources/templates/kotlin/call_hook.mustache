package {{invokerPackage}}

import {{invokerPackage}}.errors.ApiException
import {{invokerPackage}}.errors.SerializationException

/**
 * One small hook around every operation call.
 *
 * [start] runs once per call, after the request headers are final and before the body is
 * encoded, and can read and replace any header in the map it is given. The [CallObserver] it
 * returns is told how the call ended. A call with no hook set behaves exactly as before.
 *
 * The hook runs inline on the coroutine that makes the call, so it must not block. An error
 * thrown by [start] reaches the caller unchanged, nothing is sent and [CallObserver.finish] is
 * not called. An error thrown by [CallObserver.finish] is swallowed. A hook never changes the
 * result or the error of a call.
 */
fun interface CallHook {
    /**
     * Called once per operation call, however many sends happen inside it.
     *
     * @param info what is being called
     * @param headers the request headers that will be sent; edits are kept for every send of the call
     * @return the observer to tell how the call ended, or `null` to observe nothing
     */
    fun start(info: CallInfo, headers: MutableMap<String, String>): CallObserver?

    companion object {
        /**
         * A hook that starts [hooks] in the order given and finishes their observers in the
         * reverse order. A hook that returns no observer is skipped.
         *
         * @param hooks the hooks to run
         * @return the combined hook
         */
        fun chain(vararg hooks: CallHook): CallHook = ChainedCallHook(hooks.toList())
    }
}

/** Told how a call ended; created by [CallHook.start]. */
fun interface CallObserver {
    /**
     * Called exactly once for every call whose [CallHook.start] returned this observer.
     *
     * @param outcome how the call ended
     */
    fun finish(outcome: CallOutcome)
}

/**
 * What a call is about.
 *
 * @property operationId the operation id exactly as written in the spec
 * @property method the upper-case HTTP method
 * @property urlTemplate the spec path template of the operation, without the server base path
 * @property url the request URL without its query string and fragment
 * @property serverAddress the lower-case host of the request URL, without port and without the
 *   brackets of an IPv6 literal
 */
data class CallInfo(
    val operationId: String,
    val method: String,
    val urlTemplate: String,
    val url: String,
    val serverAddress: String,
)

/**
 * How a call ended.
 *
 * @property statusCode the HTTP status code, or 0 when no response arrived
 * @property headers the lower-cased read-only response headers, or `null` when no response arrived
 * @property error the very error the caller receives, or `null` on success
 */
data class CallOutcome(
    val statusCode: Int,
    val headers: Map<String, String>?,
    val error: Throwable?,
)

private class ChainedCallHook(private val hooks: List<CallHook>) : CallHook {
    override fun start(info: CallInfo, headers: MutableMap<String, String>): CallObserver? {
        val observers = ArrayList<CallObserver>(hooks.size)
        for (hook in hooks) {
            val observer = hook.start(info, headers)
            if (observer != null) {
                observers.add(observer)
            }
        }
        if (observers.isEmpty()) {
            return null
        }
        return CallObserver { outcome ->
            for (observer in observers.asReversed()) {
                try {
                    observer.finish(outcome)
                } catch (_: Exception) {
                    // A failing observer never stops the others from finishing.
                }
            }
        }
    }
}

/**
 * Runs the hook of one call: starts it once and finishes its observer exactly once. Not part of
 * the public API; the base API class uses it on every exit path.
 */
@PublishedApi
internal class CallTracker(private val hook: CallHook?) {
    private var observer: CallObserver? = null

    /** Starts the hook; an error it throws propagates and leaves nothing to finish. */
    fun start(info: () -> CallInfo, headers: MutableMap<String, String>) {
        val active = hook ?: return
        observer = active.start(info(), headers)
    }

    /** Finishes with the response that arrived and no error. */
    fun finishOk(statusCode: Int, headers: Map<String, String>) {
        finish(CallOutcome(statusCode, lowerCased(headers), null))
    }

    /** Finishes with [error], taking the status and headers from it when a response arrived. */
    fun finishError(error: Throwable) {
        val status: Int
        val headers: Map<String, String>?
        when (error) {
            is ApiException -> {
                status = error.statusCode
                headers = error.responseHeaders
            }
            is SerializationException -> {
                status = error.statusCode
                headers = error.responseHeaders
            }
            else -> {
                status = 0
                headers = null
            }
        }
        if (status > 0) {
            finish(CallOutcome(status, headers?.let { lowerCased(it) }, error))
        } else {
            finish(CallOutcome(0, null, error))
        }
    }

    private fun finish(outcome: CallOutcome) {
        val active = observer ?: return
        observer = null
        try {
            active.finish(outcome)
        } catch (_: Exception) {
            // An error thrown by finish never replaces the result or the error of the call.
        }
    }

    private fun lowerCased(headers: Map<String, String>): Map<String, String> {
        val copy = LinkedHashMap<String, String>()
        for ((name, value) in headers) {
            copy[name.lowercase()] = value
        }
        return java.util.Collections.unmodifiableMap(copy)
    }
}
