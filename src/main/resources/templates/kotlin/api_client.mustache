/**
 * Interface for API HTTP transport. Extends [AutoCloseable] so callers can
 * use try-with-resources / Kotlin's `use { }` to release the underlying
 * connection pool deterministically.
 */
interface ApiClient : AutoCloseable {
    /**
     * Send an HTTP request and return the parsed response.
     *
     * @param noRedirect when true, the implementation MUST NOT follow 307/308
     *   redirects and MUST throw an [ApiException] if the server returns one.
     *   Used by the OAuth2 token endpoint POST so credentials in the body are
     *   never silently replayed to a redirect target. Defaults to false.
     */
    suspend fun sendRequest(
        method: String,
        url: String,
        headers: Map<String, String>,
        body: Any?,
        noRedirect: Boolean = false,
    ): ApiResponse

    /**
     * Releases resources held by the underlying HTTP client. Default
     * implementation is a no-op; implementations that own a pooled client
     * should override and dispose of it.
     */
    override fun close() {
        // No-op by default.
    }
}
