package {{invokerPackage}}

import {{invokerPackage}}.errors.ApiException
import {{invokerPackage}}.errors.NetworkException
import {{invokerPackage}}.errors.SerializationException
import {{invokerPackage}}.errors.StreamException
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.flow
import java.util.Locale
import java.util.concurrent.atomic.AtomicLong

/**
 * The events of a server-sent events response, parsed as they arrive (WHATWG HTML, "Server-sent
 * events"), with automatic reconnecting.
 *
 * Collect [events], which reads the connection and closes the stream when the collection ends, or
 * take the events one by one with [next]. [close] is idempotent and aborts the connection, so close
 * the stream (`use { }`) when you stop early.
 *
 * When the connection ends, fails or stays silent for the idle timeout, the stream asks again with
 * a fresh request (headers rebuilt, so a refreshed token is the one sent) that carries the last
 * event id in `Last-Event-ID`. It waits the server's `retry` value, else `Retry-After` on 429, 502,
 * 503 and 504, else the `reconnectDelay` doubling to 30 seconds with jitter, and gives up after
 * `maxReconnects` consecutive failures without an event by raising the last failure. It never
 * reconnects after a `204`, a status other than 408, 429 and 5xx, a response that is not
 * `text/event-stream`, a cancellation or the closing of the client. An event named `error` raises
 * an [ApiException] with the response status and the data as its body. [toString] shows the status
 * code, the events delivered and the last event id, never the data.
 *
 * @param T the type of the `data` field (`String` for a plain payload)
 */
class SseStream<T> private constructor(
    private val opener: suspend (String) -> ByteStream,
    private val decoder: ((String) -> T?)?,
    private val terminator: String?,
    given: StreamOptions,
    hasBody: Boolean,
    private val method: String,
    private val path: String,
    first: ByteStream,
    private var lastEventId: String,
) : AutoCloseable {
    private val maxReconnects: Int = given.maxReconnects ?: if (hasBody) 0 else DEFAULT_MAX_RECONNECTS
    private val reconnectDelay: Long = given.reconnectDelay ?: DEFAULT_RECONNECT_DELAY_MILLIS
    private val maxEventBytes: Int = given.maxEventBytes ?: DEFAULT_MAX_EVENT_BYTES

    @Volatile private var current: ByteStream = first
    private var parser = SseParser(first, maxEventBytes, lastEventId)
    private var serverRetry: Long? = null

    @Volatile private var consecutive = 0
    private val delivered = AtomicLong()

    @Volatile private var done = false

    /** The HTTP status code of the current connection. */
    val statusCode: Int
        get() = current.statusCode

    /** The lower-cased headers of the current connection. */
    val headers: Map<String, String>
        get() = current.headers

    /**
     * The remaining events as a cold [Flow]. Collecting it reads the connection, reconnecting as
     * described above; the stream is closed when the collection ends, whether it read to the end,
     * stopped early or failed.
     *
     * @return the events, in order
     */
    fun events(): Flow<ServerSentEvent<T>> =
        flow {
            try {
                while (true) {
                    emit(next() ?: break)
                }
            } finally {
                close()
            }
        }

    /**
     * Reads the next event, suspending until it has arrived and reconnecting when the connection
     * was lost.
     *
     * @return the event, or `null` once the stream has ended or was closed
     * @throws ApiException for an event named `error`, a status that is not retried, or the last
     *   failure after `maxReconnects` reconnects
     * @throws SerializationException for a payload that does not decode or an event that is too long
     */
    suspend fun next(): ServerSentEvent<T>? {
        if (done) {
            return null
        }
        val event =
            try {
                advance()
            } catch (cancelled: CancellationException) {
                finish()
                throw cancelled
            } catch (error: Throwable) {
                finish()
                throw error
            }
        if (event == null) {
            finish()
        }
        return event
    }

    private suspend fun advance(): ServerSentEvent<T>? {
        if (current.statusCode == NO_CONTENT) {
            return null
        }
        while (!done) {
            var raw: RawEvent? = null
            var lost: ApiException? = null
            try {
                raw = parser.next()
            } catch (tooLong: TooLongException) {
                throw failure("An event of the stream is too long: ${tooLong.message}", tooLong)
            } catch (network: NetworkException) {
                lost = network
            } catch (cancelled: CancellationException) {
                throw cancelled
            } catch (closed: IllegalStateException) {
                if (done) {
                    return null
                }
                throw closed
            }
            lastEventId = parser.lastEventId
            serverRetry = parser.retry
            if (raw != null) {
                consecutive = 0
                return deliver(raw)
            }
            if (done || !reconnect(lost)) {
                return null
            }
        }
        return null
    }

    @Suppress("UNCHECKED_CAST")
    private fun deliver(raw: RawEvent): ServerSentEvent<T>? {
        if (raw.event == "error") {
            throw ApiException(current.statusCode, "The server sent an error event", current.headers, raw.data)
        }
        if (terminator != null && terminator == raw.data) {
            return null
        }
        val data: T? =
            if (decoder == null) {
                raw.data as T
            } else {
                try {
                    decoder.invoke(raw.data)
                } catch (error: SerializationException) {
                    throw failure("The data of an event does not decode: ${error.message}", error)
                }
            }
        delivered.incrementAndGet()
        return ServerSentEvent(raw.id, raw.event, data, raw.retry, raw.data)
    }

    /**
     * Re-establishes the connection after it was lost.
     *
     * @param failure why it was lost, or `null` when it ended cleanly
     * @return `true` when a new connection is open, `false` when the stream ends
     */
    private suspend fun reconnect(failure: ApiException?): Boolean {
        var cause = failure
        while (true) {
            current.close()
            if (maxReconnects == 0) {
                if (cause != null) {
                    throw cause
                }
                return false
            }
            if (maxReconnects > 0 && consecutive >= maxReconnects) {
                throw cause
                    ?: StreamException(
                        "The event stream ended and was not re-established after $maxReconnects reconnects",
                        java.io.IOException("end of stream"),
                        method,
                        path,
                    )
            }
            consecutive++
            val wait =
                reconnectWaitMillis(
                    consecutive,
                    reconnectDelay,
                    serverRetry,
                    retryAfterOf(cause),
                    java.util.concurrent.ThreadLocalRandom.current().nextDouble(),
                )
            if (wait > 0) {
                kotlinx.coroutines.delay(wait)
            }
            try {
                val next = connectTo(opener, lastEventId, method, path)
                current = next
                parser = SseParser(next, maxEventBytes, lastEventId)
                return next.statusCode != NO_CONTENT
            } catch (network: NetworkException) {
                cause = network
            } catch (status: ApiException) {
                if (!isRetriable(status.statusCode)) {
                    throw status
                }
                cause = status
            }
        }
    }

    private fun failure(
        message: String,
        cause: Throwable,
    ): SerializationException {
        val error = SerializationException(message, cause)
        error.statusCode = current.statusCode
        error.responseHeaders = current.headers
        error.requestMethod = method
        error.requestPath = path
        return error
    }

    private fun finish() {
        done = true
        current.close()
    }

    /** Closes the stream and aborts the connection; later calls do nothing. */
    override fun close() {
        done = true
        current.close()
    }

    override fun toString(): String = "SseStream(statusCode=${current.statusCode}, eventsDelivered=${delivered.get()}, lastEventId=$lastEventId)"

    companion object {
        private const val MAX_RECONNECT_DELAY_MILLIS = 30_000L
        private const val DEFAULT_MAX_RECONNECTS = 5
        private const val DEFAULT_RECONNECT_DELAY_MILLIS = 1000L
        private const val DEFAULT_MAX_EVENT_BYTES = 1024 * 1024
        private const val MAX_DOUBLINGS = 20
        private const val JITTER_SHARE = 0.25
        private const val NO_CONTENT = 204

        /**
         * Opens the first connection of an event stream; a failure of that request is raised here.
         *
         * @param T the data type
         * @param opener sends one request with the given last event id (`""` for none) and returns
         *   its open body, or raises the typed error of a failed status
         * @param decoder decodes the `data` field, or `null` to hand it over as a string
         * @param terminator a `data` value that ends the stream and is not delivered, or `null`
         * @param options the call's settings, or `null`
         * @param hasBody whether the request has a body, which turns reconnecting off by default
         * @param method the HTTP method, for errors
         * @param path the request path, for errors
         * @return the open stream
         */
        suspend fun <T> open(
            opener: suspend (String) -> ByteStream,
            decoder: ((String) -> T?)?,
            terminator: String?,
            options: StreamOptions?,
            hasBody: Boolean,
            method: String,
            path: String,
        ): SseStream<T> {
            val given = options ?: StreamOptions()
            val lastEventId = given.lastEventId ?: ""
            val first = connectTo(opener, lastEventId, method, path)
            return SseStream(opener, decoder, terminator, given, hasBody, method, path, first, lastEventId)
        }

        /** Sends the request and checks that the answer is an event stream. */
        private suspend fun connectTo(
            opener: suspend (String) -> ByteStream,
            lastEventId: String,
            method: String,
            path: String,
        ): ByteStream {
            val stream = opener(lastEventId)
            if (stream.statusCode == NO_CONTENT) {
                return stream
            }
            val type = stream.headers["content-type"] ?: ""
            if (!type.lowercase(Locale.ROOT).startsWith("text/event-stream")) {
                stream.close()
                val error =
                    SerializationException(
                        "Unexpected response Content-Type '${type.substringBefore(';').trim()}' for $path: " +
                            "expected text/event-stream",
                    )
                error.statusCode = stream.statusCode
                error.responseHeaders = stream.headers
                error.requestMethod = method
                error.requestPath = path
                throw error
            }
            return stream
        }

        private fun isRetriable(status: Int): Boolean = status == 408 || status == 429 || status in 500..599

        private fun retryAfterOf(failure: ApiException?): Long? {
            if (failure == null || failure is NetworkException) {
                return null
            }
            val status = failure.statusCode
            if (status != 429 && status != 502 && status != 503 && status != 504) {
                return null
            }
            val value = failure.responseHeaders?.entries?.firstOrNull { it.key.equals("retry-after", ignoreCase = true) }?.value
            return RetryPolicy.parseRetryAfter(value, java.time.Instant.now())
        }

        /**
         * How long to wait before reconnect number [attempt] (1 for the first): the server's
         * `retry` value, else `Retry-After`, else [base] doubling to 30 seconds, reduced by up to 25%
         * of jitter.
         *
         * @param attempt the consecutive reconnect number, from 1
         * @param base the first delay in milliseconds
         * @param serverRetry the last `retry` value of the stream, or `null`
         * @param retryAfter the `Retry-After` of the failure in milliseconds, or `null`
         * @param jitterSample a uniform random value in `[0, 1)`
         * @return the wait in milliseconds
         */
        internal fun reconnectWaitMillis(
            attempt: Int,
            base: Long,
            serverRetry: Long?,
            retryAfter: Long?,
            jitterSample: Double,
        ): Long {
            if (serverRetry != null) {
                return serverRetry
            }
            if (retryAfter != null) {
                return retryAfter
            }
            val doubled =
                if (base >= MAX_RECONNECT_DELAY_MILLIS) {
                    MAX_RECONNECT_DELAY_MILLIS
                } else {
                    minOf(MAX_RECONNECT_DELAY_MILLIS, base shl minOf(attempt - 1, MAX_DOUBLINGS))
                }
            return (doubled * (1.0 - JITTER_SHARE * jitterSample)).toLong()
        }
    }
}
