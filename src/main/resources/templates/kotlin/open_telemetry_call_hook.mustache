package {{invokerPackage}}

import {{invokerPackage}}.errors.NetworkException
import {{invokerPackage}}.errors.NetworkTimeoutException
import {{invokerPackage}}.errors.SerializationException
import io.opentelemetry.api.GlobalOpenTelemetry
import io.opentelemetry.api.OpenTelemetry
import io.opentelemetry.api.common.AttributeKey
import io.opentelemetry.api.common.Attributes
import io.opentelemetry.api.metrics.DoubleHistogram
import io.opentelemetry.api.metrics.LongCounter
import io.opentelemetry.api.trace.SpanKind
import io.opentelemetry.api.trace.StatusCode
import io.opentelemetry.api.trace.Tracer
import io.opentelemetry.context.Context
import io.opentelemetry.context.propagation.TextMapPropagator
import kotlin.coroutines.cancellation.CancellationException

/**
 * A [CallHook] that records one span, one request count and one duration value per call with
 * OpenTelemetry. It is built on the OpenTelemetry API package only; the package is an optional
 * dependency of this SDK, so add `io.opentelemetry:opentelemetry-api` yourself before you use
 * this class.
 *
 * The span is named with the operation id, has kind client and is a child of the span that is
 * active when the call starts. The hook injects `traceparent` itself, naming the client span as
 * the parent, so what the server sees is one `traceparent` header.
 *
 * Attributes: `http.request.method`, `url.template`, `server.address`, and, when they apply,
 * `http.response.status_code` and `error.type`. No query string, header value or credential is
 * ever recorded. The instruments are the counter `http.client.request.count` (unit `{request}`)
 * and the histogram `http.client.request.duration` (unit `s`); the histogram's own count equals
 * the counter. Both record one value per call, however many sends the transport made.
 *
 * Without a configured provider the OpenTelemetry API does nothing, and neither does this hook.
 */
class OpenTelemetryCallHook private constructor(openTelemetry: OpenTelemetry) : CallHook {
    private val tracer: Tracer =
        openTelemetry.tracerProvider
            .tracerBuilder(SCOPE_NAME)
            .setInstrumentationVersion(SCOPE_VERSION)
            .build()
    private val propagator: TextMapPropagator = openTelemetry.propagators.textMapPropagator
    private val requestCount: LongCounter
    private val requestDuration: DoubleHistogram

    init {
        val meter =
            openTelemetry.meterProvider
                .meterBuilder(SCOPE_NAME)
                .setInstrumentationVersion(SCOPE_VERSION)
                .build()
        requestCount =
            meter
                .counterBuilder("http.client.request.count")
                .setUnit("{request}")
                .build()
        requestDuration =
            meter
                .histogramBuilder("http.client.request.duration")
                .setUnit("s")
                .build()
    }

    override fun start(info: CallInfo, headers: MutableMap<String, String>): CallObserver? {
        val parent = Context.current()
        val span =
            tracer
                .spanBuilder(info.operationId)
                .setSpanKind(SpanKind.CLIENT)
                .setParent(parent)
                .setAttribute(METHOD, info.method)
                .setAttribute(URL_TEMPLATE, info.urlTemplate)
                .setAttribute(SERVER_ADDRESS, info.serverAddress)
                .startSpan()
        propagator.inject(parent.with(span), headers) { carrier, key, value -> carrier?.put(key, value) }
        val began = System.nanoTime()
        return CallObserver { outcome ->
            val attributes = attributesOf(info, outcome)
            span.setAllAttributes(attributes)
            if (outcome.statusCode >= HTTP_ERROR_FLOOR || outcome.error != null) {
                span.setStatus(StatusCode.ERROR)
            }
            requestCount.add(1, attributes)
            requestDuration.record((System.nanoTime() - began) / NANOS_PER_SECOND, attributes)
            span.end()
        }
    }

    private fun attributesOf(info: CallInfo, outcome: CallOutcome): Attributes {
        val builder =
            Attributes
                .builder()
                .put(METHOD, info.method)
                .put(URL_TEMPLATE, info.urlTemplate)
                .put(SERVER_ADDRESS, info.serverAddress)
        if (outcome.statusCode > 0) {
            builder.put(STATUS_CODE, outcome.statusCode.toLong())
        }
        val errorType = errorTypeOf(outcome)
        if (errorType != null) {
            builder.put(ERROR_TYPE, errorType)
        }
        return builder.build()
    }

    private fun errorTypeOf(outcome: CallOutcome): String? {
        if (outcome.statusCode >= HTTP_ERROR_FLOOR) {
            return outcome.statusCode.toString()
        }
        return when (outcome.error) {
            null -> null
            is NetworkTimeoutException -> "timeout"
            is NetworkException -> "network_error"
            is SerializationException -> "serialization_error"
            is CancellationException -> "cancelled"
            else -> "_OTHER"
        }
    }

    companion object {
        private const val SCOPE_NAME = "{{artifactId}}"
        private const val SCOPE_VERSION = "{{artifactVersion}}"
        private const val HTTP_ERROR_FLOOR = 400
        private const val NANOS_PER_SECOND = 1_000_000_000.0
        private val METHOD = AttributeKey.stringKey("http.request.method")
        private val URL_TEMPLATE = AttributeKey.stringKey("url.template")
        private val SERVER_ADDRESS = AttributeKey.stringKey("server.address")
        private val STATUS_CODE = AttributeKey.longKey("http.response.status_code")
        private val ERROR_TYPE = AttributeKey.stringKey("error.type")

        /**
         * A hook that records through the global OpenTelemetry instance. Create it after the
         * application registered its provider.
         *
         * @return the hook
         */
        @JvmStatic
        fun create(): OpenTelemetryCallHook = create(GlobalOpenTelemetry.get())

        /**
         * A hook that records through the given OpenTelemetry instance instead of the global one.
         *
         * @param openTelemetry the tracer provider, meter provider and propagators to use
         * @return the hook
         */
        @JvmStatic
        fun create(openTelemetry: OpenTelemetry): OpenTelemetryCallHook = OpenTelemetryCallHook(openTelemetry)
    }
}
