 * // Default transport
 * const client = new {{clientClassName}}(authenticator);
 *
 * // Custom transport (proxy, timeouts, etc.)
 * const transport = TransportOptions.builder()
 *   .proxy('http://proxy:3128')
 *   .timeout(5000)
 *   .build();
 * const client = new {{clientClassName}}(authenticator, transport);
 *
 * // Custom fetch (the caller owns it; the SDK never closes it)
 * const injected = TransportOptions.builder().fetch(myFetch).build();
 *
 * // Client-level cancellation
 * const controller = new AbortController();
 * const cancellable = new {{clientClassName}}(authenticator, undefined, { signal: controller.signal });
 * ```
