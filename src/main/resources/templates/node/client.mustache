  static withAuthenticator(
    authenticator: Authenticator,
    transportOptions?: TransportOptions,
    clientOptions?: {{clientClassName}}Options,
  ): {{clientClassName}} {
    return new {{clientClassName}}(authenticator, transportOptions, clientOptions ?? {});
  }
