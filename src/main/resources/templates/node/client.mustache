/**
 * Unified entry point for all API services.
 *
 * Takes an {@link Authenticator} (or one optional credential per security
 * scheme, see {@link {{clientClassName}}Credentials}) and optionally
 * {@link TransportOptions}, then exposes each API group as a typed property.
 * If a credential implements `HttpAwareAuthenticator`, the shared `ApiClient`
 * is injected so that authentication HTTP calls (token exchange, discovery)
 * use the same transport configuration as regular API calls.
 *
 * Usage:
 *
 * ```typescript
 * // One authenticator for every operation
 * const client = new {{clientClassName}}(authenticator);
 *
 * // One credential per security scheme, named after the scheme
 * const bySchemes = new {{clientClassName}}({ {{#clientSchemes}}{{#-first}}{{{paramName}}}: schemeAuthenticator{{/-first}}{{/clientSchemes}}{{^hasClientSchemes}}authenticator{{/hasClientSchemes}} });
 *
 * // Custom transport (proxy, timeouts, etc.)
 * const transport = TransportOptions.builder()
 *   .proxy('http://proxy:3128')
 *   .timeout(5000)
 *   .build();
 * const client = new {{clientClassName}}(authenticator, transport);
 *
 * // Custom fetch (the caller owns it; the SDK never closes it)
 * const injected = TransportOptions.builder().fetch(myFetch).build();
 *
 * // Client-level cancellation
 * const controller = new AbortController();
 * const cancellable = new {{clientClassName}}(authenticator, undefined, { signal: controller.signal });
 * ```
 */
export class {{clientClassName}} implements {{clientClassName}}Interface {
  private readonly ownedClient: DefaultApiClient;

