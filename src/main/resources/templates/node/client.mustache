/**
 * Client-level options for {{clientClassName}}.
 *
 * - `signal` -- cancels every call made through the client when it fires. It
 *   is merged with the per-call `signal` of each operation (either one
 *   cancels the call) and raises the signal's reason (an `AbortError` by
 *   default), never a timeout error.
 */
export interface {{clientClassName}}Options {
  readonly signal?: AbortSignal;
}

/**
 * The credentials of a {{clientClassName}}: one optional credential for each
 * security scheme of the API, named after the scheme, and an optional default
 * `authenticator`.
 *
 * An operation uses the credential of the first scheme in its own security
 * requirement that the client holds, so it always uses the scheme its spec
 * names and a call cannot pick another one. When the client holds a credential
 * for none of an operation's schemes, the operation uses `authenticator` if
 * one is given and is otherwise sent without a credential. At least one
 * credential is required, and the base URL comes from the first one given,
 * `authenticator` first.
 */
export interface {{clientClassName}}Credentials {
  /** Default credential, used by an operation that no scheme credential matches. */
  readonly authenticator?: Authenticator;
{{#clientSchemes}}
  /** Credential for the `{{{schemeId}}}` security scheme, for example a `{{className}}`. */
  readonly {{paramName}}?: Authenticator;
{{/clientSchemes}}
}

/**
 * The security schemes of the API in the order the spec declares them: the
 * credential's name on {@link {{clientClassName}}Credentials}, then the scheme's name in the spec.
 */
const SCHEMES: ReadonlyArray<readonly [Exclude<keyof {{clientClassName}}Credentials, 'authenticator'>, string]> = [
{{#clientSchemes}}
  ['{{{paramName}}}', '{{{schemeId}}}'],
{{/clientSchemes}}
];

/** Whether the first constructor argument is a single authenticator. */
function isAuthenticator(value: Authenticator | {{clientClassName}}Credentials): value is Authenticator {
  return typeof (value as Partial<Authenticator>).getHost === 'function';
}

