/**
 * An HTTP response whose body has not been read yet: the status code, the
 * lower-cased headers and the open body. It is what
 * `ApiClient.sendStreaming` resolves to. The caller owns the body and
 * must close it; closing aborts the connection instead of draining it.
 *
 * A non-2xx response is returned like any other, with its body open; a caller
 * that does not want it reads a bounded part with {@link readBounded} or
 * closes it.
 */
export class ApiStreamResponse {
  /** The HTTP status code. */
  readonly statusCode: number;

  /** The response headers, lower-cased (frozen). */
  readonly headers: Readonly<Record<string, string>>;

  /** The open response body, decoded when the server compressed it. */
  readonly body: ReadableStream<Uint8Array>;

  /**
   * Wraps an open response body.
   *
   * @param statusCode the HTTP status code
   * @param headers the response headers, lower-cased
   * @param body the open response body
   */
  constructor(statusCode: number, headers: Readonly<Record<string, string>>, body: ReadableStream<Uint8Array>) {
    this.statusCode = statusCode;
    this.headers = Object.freeze({ ...headers });
    this.body = body;
  }

  /**
   * Reads at most `maxBytes` of the body and closes it, so the same typed
   * error as a buffered call can be raised from the bytes. A body that fails
   * while it is read yields the bytes that arrived before the failure.
   *
   * @param maxBytes the most bytes to read
   * @returns the bytes read, at most `maxBytes`
   */
  async readBounded(maxBytes: number): Promise<Buffer> {
    const chunks: Uint8Array[] = [];
    let total = 0;
    const reader = this.body.getReader();
    try {
      while (total < maxBytes) {
        const { done, value } = await reader.read();
        if (done) {
          break;
        }
        chunks.push(value);
        total += value.byteLength;
      }
    } catch {
      /* the part that arrived is what the error carries */
    } finally {
      await reader.cancel().catch(() => undefined);
    }
    return Buffer.concat(chunks).subarray(0, maxBytes);
  }

  /** Closes the body, which aborts the connection. Never throws and can be called again. */
  async close(): Promise<void> {
    if (this.body.locked) {
      return;
    }
    await this.body.cancel().catch(() => undefined);
  }

  /**
   * Describes the response by its status only; the headers and the body are never shown.
   *
   * @returns the status
   */
  toString(): string {
    return `ApiStreamResponse{statusCode=${this.statusCode}}`;
  }

  toJSON(): Record<string, unknown> {
    return { statusCode: this.statusCode };
  }

  [Symbol.for('nodejs.util.inspect.custom')](): string {
    return this.toString();
  }
}
