{{>api_info}}

import { ApiError } from './api-error{{importFileExtension}}';
import type { ApiErrorOptions } from './api-error{{importFileExtension}}';
import { ClientError } from './client-error{{importFileExtension}}';

/**
 * Exception for HTTP 400 Bad Request.
 */
export class BadRequestError<T = unknown> extends ClientError<T> {
  constructor(
    message: string = '',
    responseHeaders: Record<string, string> | null = null,
    responseBody: string | null = null,
    errorBody: T | null = null,
    options?: ApiErrorOptions
  ) {
    super(400, message, responseHeaders, responseBody, errorBody, options);
    this.name = 'BadRequestError';
  }
}

ApiError.registerStatusError(
  400,
  (_statusCode, message, headers, body, errorBody, options) =>
    new BadRequestError(message, headers, body, errorBody, options)
);
