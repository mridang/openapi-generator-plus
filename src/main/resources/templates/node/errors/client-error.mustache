{{>api_info}}

import { ApiError } from './api-error{{importFileExtension}}';

/**
 * Exception for HTTP 4xx client errors.
 */
export class ClientError<T = unknown> extends ApiError<T> {
  constructor(
    statusCode: number,
    message: string,
    responseHeaders: Record<string, string> | null = null,
    responseBody: string | null = null,
    errorBody: T | null = null,
    options?: { cause?: unknown }
  ) {
    super(statusCode, message, responseHeaders, responseBody, errorBody, options);
    this.name = 'ClientError';
  }
}

ApiError.registerStatusError(
  4,
  (statusCode, message, headers, body, errorBody) =>
    new ClientError(statusCode, message, headers, body, errorBody),
  true
);
