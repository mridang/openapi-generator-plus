import { NetworkError } from './network-error{{importFileExtension}}';
import type { ApiErrorOptions } from './api-error{{importFileExtension}}';

/**
 * Error for a response body that failed after its headers arrived: the
 * connection was reset, or the body ended before its declared
 * `Content-Length`. A {@link NetworkError}, so the status code is always `0`;
 * the headers had arrived, but the body the caller was promised did not. The
 * underlying failure is kept as `cause`. An idle stall is a
 * `NetworkTimeoutError` and a body that cannot be decoded is an `ApiError`
 * with the real status, not this.
 */
export class StreamError extends NetworkError {
  constructor(message: string, options?: ApiErrorOptions) {
    super(message, options);
    this.name = 'StreamError';
  }
}
