 * branded {@link {{errorPrefix}}Error} root so it shares a common `instanceof
 * {{errorPrefix}}Error` ancestor with the transport-level {@link ApiError} hierarchy.
 */
export class SerializationError extends {{errorPrefix}}Error {
  public readonly cause?: Error;

  constructor(message: string, cause?: Error) {
    super(message);
    this.name = 'SerializationError';
