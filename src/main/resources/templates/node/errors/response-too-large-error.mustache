import { ApiError } from './api-error{{importFileExtension}}';
import type { ApiErrorOptions } from './api-error{{importFileExtension}}';

/**
 * Error for a buffered response whose body, as received or once
 * decompressed, passed `TransportOptions.maxResponseBytes`. A response
 * did arrive, so it carries the real status code and the response headers;
 * the body is empty because the client stopped reading it. It is never
 * retried.
 */
export class ResponseTooLargeError extends ApiError {
  /** The limit in bytes the body passed. */
  public readonly limit: number;

  constructor(
    limit: number,
    statusCode: number,
    responseHeaders: Record<string, string> | null = null,
    options?: ApiErrorOptions
  ) {
    super(statusCode, `Response body exceeds the limit of ${limit} bytes`, responseHeaders, '', null, options);
    this.name = 'ResponseTooLargeError';
    this.limit = limit;
  }

  /** Repeating the request returns the same oversized body, so it is never retryable. */
  override get isRetryable(): boolean {
    return false;
  }
}
