{{>api_info}}

import { ApiError } from './api-error{{importFileExtension}}';
import { ClientError } from './client-error{{importFileExtension}}';

/**
 * Exception for HTTP 401 Unauthorized.
 */
export class UnauthorizedError<T = unknown> extends ClientError<T> {
  constructor(
    message: string,
    responseHeaders: Record<string, string> | null = {},
    responseBody: string | null = null,
    errorBody: T | null = null
  ) {
    super(401, message, responseHeaders, responseBody, errorBody);
    this.name = 'UnauthorizedError';
  }
}

ApiError.registerStatusError(
  401,
  (_statusCode, message, headers, body, errorBody) =>
    new UnauthorizedError(message, headers, body, errorBody)
);
