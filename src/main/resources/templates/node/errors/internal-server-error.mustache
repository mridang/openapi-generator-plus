{{>api_info}}

import { ApiError } from './api-error{{importFileExtension}}';
import { ServerError } from './server-error{{importFileExtension}}';

/**
 * Exception for HTTP 500 Internal Server Error.
 */
export class InternalServerError<T = unknown> extends ServerError<T> {
  constructor(
    message: string,
    responseHeaders: Record<string, string> | null = {},
    responseBody: string | null = null,
    errorBody: T | null = null
  ) {
    super(500, message, responseHeaders, responseBody, errorBody);
    this.name = 'InternalServerError';
  }
}

ApiError.registerStatusError(
  500,
  (_statusCode, message, headers, body, errorBody) =>
    new InternalServerError(message, headers, body, errorBody)
);
