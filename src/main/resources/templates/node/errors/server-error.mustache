{{>api_info}}

import { ApiError } from './api-error{{importFileExtension}}';

/**
 * Exception for HTTP 5xx server errors.
 */
export class ServerError<T = unknown> extends ApiError<T> {
  constructor(
    statusCode: number,
    message: string,
    responseHeaders: Record<string, string> | null = {},
    responseBody: string | null = null,
    errorBody: T | null = null
  ) {
    super(statusCode, message, responseHeaders, responseBody, errorBody);
    this.name = 'ServerError';
  }
}

ApiError.registerStatusError(
  5,
  (statusCode, message, headers, body, errorBody) =>
    new ServerError(statusCode, message, headers, body, errorBody),
  true
);
