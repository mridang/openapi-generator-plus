import { OAuth2AuthorizationCodeAuthenticator } from '../src/auth/oauth/oauth2-auth-code-authenticator{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiResponse } from '../src/api-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responseBody = '';
  responseStatus = 200;

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    return {
      statusCode: this.responseStatus,
      body: this.responseBody,
      headers: { 'content-type': 'application/json' }
    };
  }
}

describe('OAuth2AuthorizationCodeAuthenticator', () => {
  let authenticator: OAuth2AuthorizationCodeAuthenticator;
  let mockClient: MockApiClient;

  beforeEach(() => {
    authenticator = new OAuth2AuthorizationCodeAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'my-client-secret',
      'https://auth.example.com/authorize',
      'https://auth.example.com/token',
      'https://myapp.example.com/callback',
      ['read', 'write']
    );
    mockClient = new MockApiClient();
    authenticator.setApiClient(mockClient);
  });

  test('builds authorization URL with required params', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('https://auth.example.com/authorize?');
    expect(url).toContain('client_id=my-client-id');
    expect(url).toContain('redirect_uri=' + encodeURIComponent('https://myapp.example.com/callback'));
    expect(url).toContain('scope=read+write');
    expect(url).toContain('response_type=code');
  });

  test('builds authorization URL with state', () => {
    const url = authenticator.buildAuthorizationUrl('csrf-state-123');
    expect(url).toContain('state=csrf-state-123');
  });

  test('exchanges code with correct grant type', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-123',
      refresh_token: 'refresh-token-456',
      expires_in: 3600
    });

    await authenticator.exchangeCode('my-auth-code');

    expect(mockClient.lastMethod).toBe('POST');
    expect(mockClient.lastUrl).toBe('https://auth.example.com/token');
    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('authorization_code');
    expect(params.get('code')).toBe('my-auth-code');
    expect(params.get('client_id')).toBe('my-client-id');
    expect(params.get('client_secret')).toBe('my-client-secret');
  });

  test('includes refresh token on refresh', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-123',
      refresh_token: 'refresh-token-456',
      expires_in: 1
    });

    await authenticator.exchangeCode('my-auth-code');

    // Force token expiry
    const originalNow = Date.now;
    Date.now = () => originalNow() + 120_000;

    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-789',
      expires_in: 3600
    });

    const headers = await authenticator.getAuthHeadersAsync();

    Date.now = originalNow;
    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('refresh_token');
    expect(params.get('refresh_token')).toBe('refresh-token-456');
    expect(headers['Authorization']).toBe('Bearer access-token-789');
  });

  test('throws before exchange code called', async () => {
    await expect(authenticator.getAuthHeadersAsync()).rejects.toThrow();
  });

  test('getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });
});
