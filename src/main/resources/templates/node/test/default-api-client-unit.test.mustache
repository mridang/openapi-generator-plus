    const whole = new Blob(['body-bytes']);

    await client.sendRequest('POST', 'http://api.example/up', {}, { file: part });
    await client.sendRequest('PUT', 'http://api.example/up', { 'Content-Type': 'application/octet-stream' }, whole as unknown as Buffer);

    expect(await part.text()).toBe('part-bytes');
    expect(await whole.text()).toBe('body-bytes');
  });

  it('bhv misc 036 a Blob is still readable after a failed call', async () => {
    global.fetch = (async () => {
      throw new TypeError('fetch failed');
    }) as unknown as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    const part = new Blob(['part-bytes']);

    await client.sendRequest('POST', 'http://api.example/up', {}, { file: part }).catch(() => undefined);

    expect(await part.text()).toBe('part-bytes');
  });
});

describe('automatic retries (TransportOptions.maxRetries)', () => {
  type Step = Response | Error;
  let delays: number[];
  let calls: Array<{ headers: Record<string, string>; body?: unknown }>;

  /* Every backoff wait is recorded and skipped, so the schedule is checked without sleeping. */
  beforeEach(() => {
    delays = [];
    calls = [];
    jest.spyOn(globalThis, 'setTimeout').mockImplementation(((handler: () => void, ms?: number) => {
      delays.push(ms ?? 0);
      handler();
      return 0 as unknown as NodeJS.Timeout;
    }) as unknown as typeof setTimeout);
  });
  afterEach(() => {
    jest.restoreAllMocks();
  });

  /* A client whose fetch plays the steps in order and repeats the last one. */
  function clientPlaying(steps: Step[], configure: (builder: ReturnType<typeof TransportOptions.builder>) => void = () => undefined): DefaultApiClient {
    const scripted = (async (_url: unknown, init?: { headers?: Record<string, string>; body?: unknown }) => {
      calls.push({ headers: { ...(init?.headers ?? {}) }, body: init?.body });
      const step = steps[Math.min(calls.length, steps.length) - 1]!;
      if (step instanceof Error) {
        throw step;
      }
      return step.clone();
    }) as unknown as typeof fetch;
    const builder = TransportOptions.builder().fetch(scripted);
    configure(builder);
    return new DefaultApiClient(builder.build());
  }

  const reply = (status: number, headers: Record<string, string> = {}): Response => new Response('body', { status, headers });
  const send = (client: DefaultApiClient, options?: Parameters<DefaultApiClient['sendRequest']>[4]) =>
    client.sendRequest('GET', 'http://api.example/items', {}, null, options);

  it('bhv retries 024 retries twice by default and then returns the last response', async () => {
    const response = await send(clientPlaying([reply(503)]));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(3);
    expect(TransportOptions.builder().build().maxRetries).toBe(2);
  });

  it('bhv misc 296 a failed request is retried twice by default, so three requests reach the wire', async () => {
    await send(clientPlaying([new TypeError('fetch failed')])).catch(() => undefined);

    expect(calls).toHaveLength(3);
  });

  it('bhv retries 021 retries exactly the retryable statuses and returns the success that follows', async () => {
    for (const status of [408, 409, 429, 500, 502, 503, 504, 599]) {
      calls = [];
      const response = await send(clientPlaying([reply(status), reply(200)]));

      expect(response.statusCode).toBe(200);
      expect(calls).toHaveLength(2);
    }
  });

  it('bhv retries 007 does not replay other statuses', async () => {
    for (const status of [400, 401, 404, 422, 501]) {
      calls = [];
      const response = await send(clientPlaying([reply(status)]));

      expect(response.statusCode).toBe(status);
      expect(calls).toHaveLength(1);
    }
  });

  it('bhv retries 003 a multipart body is not retried after a 503', async () => {
    const response = await clientPlaying([reply(503), reply(200)]).sendRequest(
      'POST', 'http://api.example/items', {}, { 'avatar.png': Buffer.from([0x89]) });
    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 019 every call gets its own retry count and budget', async () => {
    const client = clientPlaying([reply(503)]);
    await send(client);
    await send(client);
    expect(calls).toHaveLength(6);
  });

  it('bhv retries 044 with request ids supplied, every retry is sent with an identifier that differs from the attempts before it', async () => {
    calls = [];
    const client = clientPlaying(
      [reply(503), reply(503), reply(200)],
      (builder) => builder.injectRequestId(true).maxRetries(2),
    );

    await send(client);

    const ids = calls.map((call) => call.headers['X-Request-ID']);
    expect(ids).toHaveLength(3);
    expect(new Set(ids).size).toBe(3);
  });

  it('bhv retries 018 maxRetries(0) disables retries', async () => {
    const response = await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(0)));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 014 a per-call maxRetries of 0 disables the retries the transport allows', async () => {
    const response = await send(clientPlaying([reply(503)]), { maxRetries: 0 });

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 004 a per-call maxRetries replaces the transport count in both directions', async () => {
    await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(0)), { maxRetries: 3 });
    expect(calls).toHaveLength(4);

    calls = [];
    await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(5)), { maxRetries: 1 });
    expect(calls).toHaveLength(2);
  });

  it('bhv langnode 076 a per-call timeout of null lifts the transport deadline for the backoff wait', async () => {
    const response = await send(
      clientPlaying([reply(503, { 'Retry-After': '5' }), reply(200)], (builder) => builder.timeout(1000)),
      { timeout: null }
    );

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
  });

  it('bhv retries 049 maxRetries(n) caps the attempts at n + 1', async () => {
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(4).timeout(null)));

    expect(calls).toHaveLength(5);
  });

  it('bhv retries 027 backs off from 0.5 s doubling to 8 s with up to 25% jitter taken off', async () => {
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(6).timeout(null)));

    expect(delays).toHaveLength(6);
    delays.forEach((delay, index) => {
      const base = Math.min(500 * 2 ** index, 8000);
      expect(delay).toBeGreaterThanOrEqual(base * 0.75);
      expect(delay).toBeLessThanOrEqual(base);
    });
    expect(Math.max(...delays)).toBeLessThanOrEqual(8000);
  });

  it('bhv retries 041 starts the backoff at 0.5 s, doubles it up to 8 s and takes up to 25% off', async () => {
    jest.spyOn(Math, 'random').mockReturnValue(0);
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(6).timeout(null)));
    expect(delays).toEqual([500, 1000, 2000, 4000, 8000, 8000]);

    delays = [];
    jest.spyOn(Math, 'random').mockReturnValue(1);
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(6).timeout(null)));
    expect(delays).toEqual([375, 750, 1500, 3000, 6000, 6000]);
  });

  it('bhv retries 030 the jitter takes at most a quarter off the first delay', async () => {
    jest.spyOn(Math, 'random').mockReturnValue(1);
    await send(clientPlaying([reply(503), reply(200)]));
    expect(delays).toEqual([375]);
  });

  it('bhv retries 038 a 503 is sent again until it succeeds', async () => {
    const response = await send(clientPlaying([reply(503), reply(503), reply(200)]));

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(3);
  });

  it('bhv retries 032 a stream body is never retried', async () => {
    const stream = new ReadableStream<Uint8Array>({
      start(controller) {
        controller.enqueue(new Uint8Array([1, 2, 3]));
        controller.close();
      }
    });
    const response = await clientPlaying([reply(503), reply(200)]).sendRequest(
      'POST', 'http://api.example/items', {}, stream as unknown as Buffer);

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 034 a string body is sent again unchanged on every retry', async () => {
    await clientPlaying([reply(503), reply(503), reply(200)]).sendRequest(
      'POST', 'http://api.example/items', {}, '{"x":1}');

    expect(calls.map((call) => call.body)).toEqual(['{"x":1}', '{"x":1}', '{"x":1}']);
  });

  it('bhv retries 026 waits for a Retry-After given in seconds', async () => {
    await send(clientPlaying([reply(429, { 'Retry-After': '3' }), reply(200)]));

    expect(delays).toEqual([3000]);
  });

  it('bhv retries 022 waits for a Retry-After given as an HTTP date', async () => {
    const at = new Date(Date.now() + 30_000).toUTCString();

    await send(clientPlaying([reply(503, { 'Retry-After': at }), reply(200)], (builder) => builder.timeout(null)));

    expect(delays).toHaveLength(1);
    expect(delays[0]!).toBeGreaterThan(28_000);
    expect(delays[0]!).toBeLessThanOrEqual(30_000);
  });

  it('bhv retries 050 a Retry-After given as an HTTP date waits the time left until that date, then retries', async () => {
    const at = new Date(Date.now() + 10_000).toUTCString();

    await send(clientPlaying([reply(503, { 'Retry-After': at }), reply(200)], (builder) => builder.timeout(null)));

    expect(delays).toHaveLength(1);
    expect(delays[0]!).toBeGreaterThan(8_000);
    expect(delays[0]!).toBeLessThanOrEqual(10_000);
  });

  it('bhv retries 023 caps a Retry-After at 60 s', async () => {
    await send(clientPlaying([reply(503, { 'Retry-After': '3600' }), reply(200)], (builder) => builder.timeout(null)));

    expect(delays).toEqual([60_000]);
  });

  it('bhv retries 029 falls back to the backoff when Retry-After is not understood', async () => {
    await send(clientPlaying([reply(503, { 'Retry-After': 'soon' }), reply(200)]));

    expect(delays).toHaveLength(1);
    expect(delays[0]!).toBeGreaterThanOrEqual(375);
    expect(delays[0]!).toBeLessThanOrEqual(500);
  });

  it('bhv retries 047 every attempt and wait stays within the caller timeout, and a wait that would overrun it is not taken', async () => {
    const response = await send(
      clientPlaying([reply(503, { 'Retry-After': '1' }), reply(503, { 'Retry-After': '1' }), reply(200)], (builder) => builder.timeout(5000)),
    );

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(3);
    expect(delays).toEqual([1000, 1000]);

    calls.length = 0;
    delays.length = 0;
    const overrun = await send(clientPlaying([reply(503, { 'Retry-After': '5' }), reply(200)], (builder) => builder.timeout(1000)));

    expect(overrun.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
    expect(delays).toEqual([]);
  });

  it('bhv retries 025 never extends the end-to-end timeout: a wait longer than what is left ends the retries', async () => {
    const response = await send(clientPlaying([reply(503, { 'Retry-After': '5' }), reply(200)], (builder) => builder.timeout(1000)));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
    expect(delays).toEqual([]);
  });

  it('bhv retries 013 retries a network error that happened before any response', async () => {
    const response = await send(clientPlaying([new TypeError('fetch failed'), reply(200)]));

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
  });

  it('bhv retries 033 reports the last network error once the retries are spent', async () => {
    const error = await send(clientPlaying([new TypeError('fetch failed')])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkError);
    expect(calls).toHaveLength(3);
  });

  it('bhv errors 043 does not retry a failure while reading the body of a response that arrived', async () => {
    const broken = new Response('', { status: 200 });
    Object.defineProperty(broken, 'arrayBuffer', { value: () => Promise.reject(new TypeError('terminated')) });
    Object.defineProperty(broken, 'clone', { value: () => broken });

    const error = await send(clientPlaying([broken as Response])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkError);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 042 does not retry a timeout', async () => {
    const timeout = Object.assign(new Error('timed out'), { name: 'TimeoutError' });

    const error = await send(clientPlaying([timeout])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkTimeoutError);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 039 builds every retry as a fresh request with the authentication headers asked for again', async () => {
    let issued = 0;
    const client = clientPlaying([reply(503), reply(200)], (builder) => builder.injectRequestId(true));

    await send(client, {
      refreshAuthHeaders: async () => ({ authorization: `Bearer token-${++issued}` })
    });

    expect(issued).toBe(1);
    expect(calls).toHaveLength(2);
    expect(calls[0]!.headers['Authorization'] ?? calls[0]!.headers['authorization']).toBeUndefined();
    expect(calls[1]!.headers['authorization']).toBe('Bearer token-1');
    expect(calls[1]!.headers['X-Request-ID']).toBeDefined();
    expect(calls[1]!.headers['X-Request-ID']).not.toBe(calls[0]!.headers['X-Request-ID']);
  });

  it.each([-1, 1.5, Number.NaN])('bhv langnode 080 maxRetries(%p) is rejected', (value) => {
    expect(() => TransportOptions.builder().maxRetries(value)).toThrow(TypeError);
  });
});

describe('automatic retries and cancellation', () => {
  it('bhv retries 028 a caller signal that fires while waiting to retry stops the call with its own reason', async () => {
    const controller = new AbortController();
    let calls = 0;
    const scripted = (async () => {
      calls += 1;
      return new Response('', { status: 503, headers: { 'Retry-After': '5' } });
    }) as unknown as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(scripted).build());
    setTimeout(() => controller.abort(), 50);

    const error = await client
      .sendRequest('GET', 'http://api.example/items', {}, null, { signal: controller.signal })
      .catch((e: unknown) => e);

    expect((error as Error).name).toBe('AbortError');
    expect(calls).toBe(1);
  });
});

describe('DefaultApiClient misc transport behaviours', () => {
  async function localServer(handler: http.RequestListener): Promise<{ url: string; close: () => Promise<void> }> {
    const srv = http.createServer(handler);
    await new Promise<void>((resolve) => srv.listen(0, '127.0.0.1', resolve));
    const port = (srv.address() as net.AddressInfo).port;
    return {
      url: `http://127.0.0.1:${port}`,
      close: () => new Promise<void>((resolve) => { srv.closeAllConnections(); srv.close(() => resolve()); }),
    };
  }

  async function recordingProxy(seen: Array<string | undefined>): Promise<{ url: string; close: () => Promise<void> }> {
    const proxy = http.createServer((_req, res) => {
      res.writeHead(405);
      res.end();
    });
    proxy.on('connect', (req, clientSocket, head) => {
      seen.push(req.headers['proxy-authorization']);
      const target = new URL(`http://${req.url!}`);
      const upstream = net.connect(Number(target.port), target.hostname, () => {
        clientSocket.write('HTTP/1.1 200 Connection Established\r\n\r\n');
        upstream.write(head);
        clientSocket.pipe(upstream);
        upstream.pipe(clientSocket);
      });
      clientSocket.on('error', () => upstream.destroy());
      upstream.on('error', () => clientSocket.destroy());
    });
    await new Promise<void>((resolve) => proxy.listen(0, '127.0.0.1', resolve));
    const port = (proxy.address() as net.AddressInfo).port;
    return {
      url: `http://127.0.0.1:${port}`,
      close: () => new Promise<void>((resolve) => { proxy.closeAllConnections(); proxy.close(() => resolve()); }),
    };
  }

  it('bhv misc 031 a proxy URL without user information sends no proxy credential', async () => {
    const seen: Array<string | undefined> = [];
    const proxy = await recordingProxy(seen);
    const client = new DefaultApiClient(TransportOptions.builder().proxy(proxy.url).build());
    try {
      const response = await client.sendRequest('GET', `${baseUrl}/echo`, {}, null);
      expect(response.statusCode).toBe(200);
      expect(seen).toEqual([undefined]);
    } finally {
      await client.close();
      await proxy.close();
    }
  });

  it('bhv misc 032 the raw response exposes status, body and headers under public names', async () => {
    const local = await localServer((_req, res) => {
      res.writeHead(201, { 'Content-Type': 'text/plain', 'X-Raw': 'yes' });
      res.end('raw-body');
    });
    try {
      const client = new DefaultApiClient(TransportOptions.builder().build());
      const response = await client.sendRequest('GET', `${local.url}/x`, {}, null);
      expect(response.statusCode).toBe(201);
      expect(response.body).toBe('raw-body');
      expect(response.headers['x-raw']).toBe('yes');
    } finally {
      await local.close();
    }
  });

  it('bhv misc 037 an undecoded body keeps its Content-Length header', async () => {
    const local = await localServer((_req, res) => {
      res.writeHead(200, { 'Content-Type': 'text/plain', 'Content-Length': '5' });
      res.end('hello');
    });
    try {
      const client = new DefaultApiClient(TransportOptions.builder().build());
      const response = await client.sendRequest('GET', `${local.url}/x`, {}, null);
      expect(response.headers['content-length']).toBe('5');
    } finally {
      await local.close();
    }
  });

  it('bhv misc 038 with no CA certificate configured, a server certificate outside the platform store is refused', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    await expect(client.sendRequest('GET', `${process.env['CHASM_HTTPS_URL']!}/test/echo`, {}, null)).rejects.toThrow();
  });

  it.each([
    ['gzip', ''],
    ['gzip', '0'],
    ['deflate', ''],
    ['deflate', '0'],
  ])('bhv misc 039 a well-formed %s stream of %p is returned as its content, not treated as corrupt', async (encoding, content) => {
    const plain = Buffer.from(content, 'utf-8');
    const wire = encoding === 'gzip' ? zlib.gzipSync(plain) : zlib.deflateSync(plain);
    const out = await DefaultApiClient.ensureDecoded(wire, encoding);
    expect(out.toString('utf-8')).toBe(content);
  });

  it('bhv misc 040 response header names are returned in lower case', async () => {
    const local = await localServer((_req, res) => {
      res.writeHead(200, { 'X-Custom-Thing': 'v' });
      res.end();
    });
    try {
      const client = new DefaultApiClient(TransportOptions.builder().build());
      const response = await client.sendRequest('GET', `${local.url}/x`, {}, null);
      expect(response.headers['x-custom-thing']).toBe('v');
    } finally {
      await local.close();
    }
  });

  it('bhv misc 041 a request with a non-standard method is sent with its body intact', async () => {
    let method = '';
    let received = '';
    const local = await localServer((req, res) => {
      method = req.method ?? '';
      const chunks: Buffer[] = [];
      req.on('data', (chunk: Buffer) => chunks.push(chunk));
      req.on('end', () => {
        received = Buffer.concat(chunks).toString('utf-8');
        res.writeHead(200);
        res.end();
      });
    });
    try {
      const client = new DefaultApiClient(TransportOptions.builder().build());
      await client.sendRequest('PURGE', `${local.url}/x`, { 'Content-Type': 'text/plain' }, Buffer.from('payload'));
      expect(method).toBe('PURGE');
      expect(received).toBe('payload');
    } finally {
      await local.close();
    }
  });

  it('bhv misc 042 a custom fetch with verification disabled is refused at build, naming the setting', () => {
    const customFetch = (async () => new Response('')) as unknown as typeof fetch;
    expect(() => TransportOptions.builder().fetch(customFetch).verifySsl(false).build()).toThrow(/verifySsl\(false\)/);
  });

  it('bhv misc 043 an explicitly cleared user agent is omitted from the request', async () => {
    const local = await localServer((req, res) => {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ userAgent: req.headers['user-agent'] ?? null }));
    });
    try {
      const client = new DefaultApiClient(TransportOptions.builder().userAgent(null).build());
      const response = await client.sendRequest('GET', `${local.url}/x`, {}, null);
      expect(JSON.parse(response.body)).toEqual({ userAgent: null });
    } finally {
      await local.close();
    }
  });

  it('bhv misc 044 a body that declares gzip but lacks the gzip signature is returned as its plain body', async () => {
    const plain = Buffer.from('{"userId":1}', 'utf-8');
    const out = await DefaultApiClient.ensureDecoded(plain, 'gzip');
    expect(out.toString('utf-8')).toBe('{"userId":1}');
  });
});
