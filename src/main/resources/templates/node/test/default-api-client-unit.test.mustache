/*
 * Gap 3.1: cross-origin redirects must strip the classic credential
 * headers AND the common API-key header names. The allowlist is exposed
 * as SENSITIVE_HEADER_NAMES so callers can audit it.
 */
describe('SENSITIVE_HEADER_NAMES allowlist', () => {
  it('bhv transport 057 includes the classic credential carriers', () => {
    expect(SENSITIVE_HEADER_NAMES.has('authorization')).toBe(true);
    expect(SENSITIVE_HEADER_NAMES.has('cookie')).toBe(true);
    expect(SENSITIVE_HEADER_NAMES.has('proxy-authorization')).toBe(true);
  });

  /*
   * node-hardcoded-redirect-strip-list: the stripped set must be derived
   * from the spec's apiKey-in-header security schemes ({{#apiKeyHeaderNames}}{{name}}{{^-last}}, {{/-last}}{{/apiKeyHeaderNames}})
   * rather than a hardcoded SaaS-provider list. Every apiKey-in-header
   * scheme this spec declares must be present; query/cookie apiKeys are NOT
   * header credentials and must be absent.
   */
  it('bhv transport 056 includes the spec-declared apiKey-in-header names', () => {
{{#apiKeyHeaderNames}}
    expect(SENSITIVE_HEADER_NAMES.has('{{nameLower}}')).toBe(true);
{{/apiKeyHeaderNames}}
  });

  it('lists the spec-declared apiKey-in-header names in its comment with no dangling separator', () => {
    const own = fs.readFileSync(path.join(process.cwd(), 'test', 'default-api-client-unit.test.ts'), 'utf8');
    const listed = new RegExp('security schemes \\(([^)]*)\\)').exec(own);

    expect(listed?.[1]).toBe([{{#apiKeyHeaderNames}}'{{name}}'{{^-last}}, {{/-last}}{{/apiKeyHeaderNames}}].join(', '));
  });

  it('does NOT include hardcoded SaaS-provider key names absent from the spec', () => {
    // These were in the old static list but are not declared by any
    // apiKey-in-header scheme in this spec, so they must no longer be stripped.
    expect(SENSITIVE_HEADER_NAMES.has('x-functions-key')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('x-amz-security-token')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('ocp-apim-subscription-key')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('cf-access-client-secret')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('fastly-key')).toBe(false);
  });

  it('entries are lowercase so case-insensitive matching works on Set.has', () => {
    for (const name of SENSITIVE_HEADER_NAMES) {
      expect(name).toBe(name.toLowerCase());
    }
  });

  it('does not include non-credential headers', () => {
    expect(SENSITIVE_HEADER_NAMES.has('content-type')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('accept')).toBe(false);
    expect(SENSITIVE_HEADER_NAMES.has('user-agent')).toBe(false);
  });
});

/*
 * Gap 3.1: end-to-end check that the cross-origin redirect loop actually
 * strips an API-key header (in addition to Authorization). Two loopback
 * servers on different ports count as different origins.
 */
describe('cross-origin redirect strips API-key headers', () => {
  let srcServer: http.Server;
  let dstServer: http.Server;
  let srcUrl: string;
  let dstUrl: string;
  let lastReceivedHeaders: Record<string, string | string[] | undefined> = {};

  beforeAll(async () => {
    dstServer = http.createServer((req, res) => {
      lastReceivedHeaders = req.headers;
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('{"ok":true}');
    });
    await new Promise<void>(resolve => dstServer.listen(0, '127.0.0.1', resolve));
    const dstPort = (dstServer.address() as { port: number }).port;
    dstUrl = `http://127.0.0.1:${dstPort}`;

    srcServer = http.createServer((_req, res) => {
      res.writeHead(302, { Location: `${dstUrl}/landing` });
      res.end();
    });
    await new Promise<void>(resolve => srcServer.listen(0, '127.0.0.1', resolve));
    const srcPort = (srcServer.address() as { port: number }).port;
    srcUrl = `http://127.0.0.1:${srcPort}`;
  });

  afterAll(async () => {
    await new Promise<void>(resolve => srcServer.close(() => resolve()));
    await new Promise<void>(resolve => dstServer.close(() => resolve()));
  });

  it('bhv redirects 012 cross-origin redirect strips Authorization and Cookie', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      { Authorization: 'Bearer secret', Cookie: 'session=xyz', Accept: 'application/json' },
      null,
    );
    expect(lastReceivedHeaders['authorization']).toBeUndefined();
    expect(lastReceivedHeaders['cookie']).toBeUndefined();
    expect(lastReceivedHeaders['accept']).toBe('application/json');
  });

  it('bhv redirects 011 strips Authorization, the spec-declared apiKey headers, and Cookie on cross-origin 302', async () => {
    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      {
        Authorization: 'Bearer secret',
{{#apiKeyHeaderNames}}
        '{{name}}': 'k-12345',
{{/apiKeyHeaderNames}}
        Cookie: 'session=xyz',
        'Proxy-Authorization': 'Basic abc',
        Accept: 'application/json',
      },
      null,
    );
    // The classic credential carriers are always stripped on a cross-origin hop.
    expect(lastReceivedHeaders['authorization']).toBeUndefined();
    expect(lastReceivedHeaders['cookie']).toBeUndefined();
    expect(lastReceivedHeaders['proxy-authorization']).toBeUndefined();
{{#hasApiKeyHeaderNames}}
    // The spec's apiKey-in-header scheme names are also stripped; they are
    // derived from the spec at codegen time, so a spec without such schemes
    // renders this block empty and asserts nothing here.
{{#apiKeyHeaderNames}}
    expect(lastReceivedHeaders['{{nameLower}}']).toBeUndefined();
{{/apiKeyHeaderNames}}
{{/hasApiKeyHeaderNames}}
    // Non-sensitive headers should still be forwarded.
    expect(lastReceivedHeaders['accept']).toBe('application/json');
  });

  it('bhv redirects 025 strips a default header and an authenticator header the fixed list does not know on cross-origin 302', async () => {
    const transport = TransportOptions.builder()
      .followRedirects(true)
      .defaultHeaders({ 'X-Tenant-Token': 'tenant-secret' })
      .build();
    const client = new DefaultApiClient(transport);
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      { 'X-Custom-Auth': 'custom-secret', 'X-Correlation-Id': 'corr-1' },
      null,
      { credentialHeaderNames: ['X-Custom-Auth'] },
    );
    expect(lastReceivedHeaders['x-tenant-token']).toBeUndefined();
    expect(lastReceivedHeaders['x-custom-auth']).toBeUndefined();
    expect(lastReceivedHeaders['x-correlation-id']).toBe('corr-1');
  });

  it('bhv redirects 024 same-origin redirect keeps Authorization and Cookie', async () => {
    let landed: Record<string, string | string[] | undefined> = {};
    const same = http.createServer((req, res) => {
      if (req.url === '/start') {
        res.writeHead(302, { Location: '/landing' });
        res.end();
        return;
      }
      landed = req.headers;
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('{"ok":true}');
    });
    await new Promise<void>(resolve => same.listen(0, '127.0.0.1', resolve));
    try {
      const sameUrl = `http://127.0.0.1:${(same.address() as { port: number }).port}`;
      const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
      await client.sendRequest('GET', `${sameUrl}/start`, { Authorization: 'Bearer secret', Cookie: 'session=xyz' }, null);
      expect(landed['authorization']).toBe('Bearer secret');
      expect(landed['cookie']).toBe('session=xyz');
    } finally {
      await new Promise<void>(resolve => same.close(() => resolve()));
    }
  });

  it('bhv redirects 013 keeps Authorization and Cookie on a same-origin redirect', async () => {
    let landed: Record<string, string | string[] | undefined> = {};
    const same = http.createServer((req, res) => {
      if (req.url === '/start') {
        res.writeHead(302, { Location: '/landing' });
        res.end();
        return;
      }
      landed = req.headers;
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('{"ok":true}');
    });
    await new Promise<void>(resolve => same.listen(0, '127.0.0.1', resolve));
    try {
      const sameUrl = `http://127.0.0.1:${(same.address() as { port: number }).port}`;
      const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
      await client.sendRequest(
        'GET',
        `${sameUrl}/start`,
        { Authorization: 'Bearer secret', Cookie: 'session=xyz', Accept: 'application/json' },
        null,
      );
      expect(landed['authorization']).toBe('Bearer secret');
      expect(landed['cookie']).toBe('session=xyz');
      expect(landed['accept']).toBe('application/json');
    } finally {
      await new Promise<void>(resolve => same.close(() => resolve()));
    }
  });
});

/*
 * The origin comparison behind the strip: scheme, host and effective port,
 * so an explicit default port is the same origin as an implicit one and
 * credentials are not wrongly dropped.
 */
describe('redirect origin comparison', () => {
  const sameOrigin = (a: string, b: string): boolean =>
    (DefaultApiClient as unknown as { sameOrigin(a: string, b: string): boolean }).sameOrigin(a, b);

  it.each([
    ['https://api.example.com/a', 'https://api.example.com:443/b'],
    ['https://api.example.com:443/a', 'https://api.example.com/b'],
    ['http://api.example.com/a', 'http://api.example.com:80/b'],
    ['https://API.example.com/a', 'https://api.example.com/b']
  ])('%s and %s are the same origin', (a, b) => {
    expect(sameOrigin(a, b)).toBe(true);
  });

  it.each([
    ['https://api.example.com/a', 'https://api.example.com:8443/b'],
    ['https://api.example.com/a', 'http://api.example.com/b'],
    ['http://api.example.com/a', 'https://api.example.com:80/b'],
    ['https://api.example.com/a', 'https://other.example.com/b']
  ])('%s and %s are different origins', (a, b) => {
    expect(sameOrigin(a, b)).toBe(false);
  });
});

/*
 * Gap 3.2: per-request noRedirect option must suppress redirect following
 * even when the transport globally has followRedirects=true.
 */
describe('SendRequestOptions.noRedirect', () => {
  let srv: http.Server;
  let baseUrlLocal: string;

  beforeAll(async () => {
    srv = http.createServer((req, res) => {
      if (req.url === '/redirect') {
        res.writeHead(307, { Location: '/final' });
        res.end();
        return;
      }
      if (req.url === '/permanent') {
        res.writeHead(308, { Location: '/final' });
        res.end();
        return;
      }
      if (req.url === '/final') {
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end('{"final":true}');
        return;
      }
      res.writeHead(404);
      res.end();
    });
    await new Promise<void>(resolve => srv.listen(0, '127.0.0.1', resolve));
    const port = (srv.address() as { port: number }).port;
    baseUrlLocal = `http://127.0.0.1:${port}`;
  });

  afterAll(async () => {
    await new Promise<void>(resolve => srv.close(() => resolve()));
  });

  it('follows 307 by default', async () => {
    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest('POST', `${baseUrlLocal}/redirect`, {}, 'body');
    expect(response.statusCode).toBe(200);
    expect(response.body).toContain('final');
  });

  it('bhv redirects 022 returns the 308 verbatim when noRedirect is true', async () => {
    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      `${baseUrlLocal}/permanent`,
      {},
      'body',
      { noRedirect: true },
    );
    expect(response.statusCode).toBe(308);
    expect(response.headers['location']).toBe('/final');
  });

  it('bhv redirects 008 a redirect is returned, not followed, when redirects are disabled', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(false).build());
    const response = await client.sendRequest('GET', `${baseUrlLocal}/redirect`, {}, null);
    expect(response.statusCode).toBe(307);
    expect(response.headers['location']).toBe('/final');
  });

  it('bhv redirects 015 a per-call noRedirect returns the 307 and does not follow it', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    const response = await client.sendRequest('GET', `${baseUrlLocal}/redirect`, {}, null, { noRedirect: true });
    expect(response.statusCode).toBe(307);
  });

  it('bhv redirects 021 surfaces the 307 untouched when noRedirect=true', async () => {
    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      `${baseUrlLocal}/redirect`,
      {},
      'body',
      { noRedirect: true },
    );
    expect(response.statusCode).toBe(307);
    expect(response.headers['location']).toBe('/final');
  });
});

/*
 * Gap 3.3: HTTPS -> HTTP body replay must be refused with a loud error,
 * never silently downgraded. We can't easily spin up HTTPS in this unit
 * test, but we CAN spin up an HTTP server that pretends to be HTTPS by
 * issuing a 307 to a plain-HTTP target — and assert that the client
 * refuses if the *current* URL it would replay from is https://. To do
 * this we point at an https URL backed by a fake undici dispatcher? No:
 * simpler — use a real HTTP -> HTTP server pair and assert the inverse
 * (replay IS allowed across HTTP -> HTTP), and use a constructed URL
 * mock to assert the guard fires.
 *
 * The straightforward integration check below exercises the guard
 * through a synthetic Location pointing from an https:// origin to
 * an http:// target. We accomplish this by intercepting fetch.
 */
describe('HTTPS -> HTTP body replay guard', () => {
  const originalFetch = global.fetch;

  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('bhv retries 020 refuses to replay POST body when redirected from HTTPS to HTTP', async () => {
    let call = 0;
    // First call: pretend the user posted to https://secure.example/token
    //             and the server responds with a 307 to http://evil/steal
    // The redirect-follow path inspects currentUrl.protocol === 'https:'
    // and nextParsed.protocol === 'http:' to decide whether to refuse.
    global.fetch = (async (): Promise<Response> => {
      call++;
      if (call === 1) {
        return new Response(null, {
          status: 307,
          headers: { Location: 'http://evil.example/steal' },
        });
      }
      // If the guard fails, we'd be called a second time. Make that loud.
      return new Response('SHOULD NOT REACH', { status: 200 });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    await expect(
      client.sendRequest(
        'POST',
        'https://secure.example/token',
        { 'Content-Type': 'application/x-www-form-urlencoded' },
        'grant_type=client_credentials&client_secret=topsecret',
      ),
    ).rejects.toBeInstanceOf(ApiError);
    expect(call).toBe(1);
  });

  it('bhv redirects 019 refuses with the canonical message and masks query values in it', async () => {
    global.fetch = (async (): Promise<Response> =>
      new Response(null, {
        status: 307,
        headers: { Location: 'http://evil.example/steal?api_key=SECRET' },
      })) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    const error = await client
      .sendRequest('POST', 'https://secure.example/items?api_key=SECRET', {}, 'body')
      .catch((e: unknown) => e);

    expect((error as ApiError).message).toBe(
      'Refusing to replay request body across HTTPS->HTTP redirect: '
        + 'https://secure.example/items?api_key=*** -> http://evil.example/steal?api_key=***',
    );
    expect((error as ApiError).responseHeaders).toHaveProperty('location');
  });

  it('bhv retries 016 allows HTTPS -> HTTPS replay (no downgrade)', async () => {
    let call = 0;
    global.fetch = (async (): Promise<Response> => {
      call++;
      if (call === 1) {
        return new Response(null, {
          status: 307,
          headers: { Location: 'https://other.example/final' },
        });
      }
      return new Response('{"ok":true}', {
        status: 200,
        headers: { 'Content-Type': 'application/json' },
      });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      'https://secure.example/token',
      { 'Content-Type': 'application/x-www-form-urlencoded' },
      'grant_type=client_credentials',
    );
    expect(response.statusCode).toBe(200);
    expect(call).toBe(2);
  });

  it('allows HTTP -> HTTP replay (no TLS to begin with, no downgrade)', async () => {
    let call = 0;
    global.fetch = (async (): Promise<Response> => {
      call++;
      if (call === 1) {
        return new Response(null, {
          status: 307,
          headers: { Location: 'http://other.example/final' },
        });
      }
      return new Response('{"ok":true}', {
        status: 200,
        headers: { 'Content-Type': 'application/json' },
      });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      'http://insecure.example/token',
      {},
      'grant_type=client_credentials',
    );
    expect(response.statusCode).toBe(200);
    expect(call).toBe(2);
  });

  it('allows HTTPS -> HTTP when the redirect status forces an empty body (303)', async () => {
    let call = 0;
    global.fetch = (async (): Promise<Response> => {
      call++;
      if (call === 1) {
        return new Response(null, {
          status: 303,
          headers: { Location: 'http://other.example/landing' },
        });
      }
      return new Response('{"ok":true}', {
        status: 200,
        headers: { 'Content-Type': 'application/json' },
      });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      'https://secure.example/start',
      { 'Content-Type': 'application/json' },
      '{"x":1}',
    );
    expect(response.statusCode).toBe(200);
    expect(call).toBe(2);
  });
});

describe('redirect method rewriting (RFC 9110 section 15.4)', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  test.each([
    [301, 'POST', 'GET', false],
    [302, 'POST', 'GET', false],
    [301, 'PUT', 'PUT', true],
    [302, 'PATCH', 'PATCH', true],
    [302, 'DELETE', 'DELETE', true],
    [303, 'POST', 'GET', false],
    [303, 'PUT', 'GET', false],
    [303, 'DELETE', 'GET', false],
    [303, 'HEAD', 'HEAD', false],
    [307, 'PUT', 'PUT', true],
    [308, 'DELETE', 'DELETE', true],
  ])('%i on %s follows with %s (body kept: %s)', async (status, method, expectedMethod, bodyKept) => {
    const calls: Array<{ method: unknown; body: unknown }> = [];
    global.fetch = (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push({ method: init?.method, body: init?.body });
      if (calls.length === 1) {
        return new Response(null, { status, headers: { Location: 'https://secure.example/next' } });
      }
      return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    const response = await client.sendRequest(
      method,
      'https://secure.example/start',
      { 'Content-Type': 'application/json' },
      '{"x":1}',
    );

    expect(response.statusCode).toBe(200);
    expect(calls[1].method).toBe(expectedMethod);
    if (bodyKept) {
      expect(calls[1].body).toBeDefined();
    } else {
      expect(calls[1].body ?? null).toBeNull();
    }
  });

  it('bhv retries 017 refuses to replay a PUT body across an https to http 302 downgrade', async () => {
    global.fetch = (async (): Promise<Response> =>
      new Response(null, { status: 302, headers: { Location: 'http://other.example/x' } })) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await expect(
      client.sendRequest('PUT', 'https://secure.example/start', {}, '{"x":1}'),
    ).rejects.toThrow(/Refusing to replay request body across HTTPS->HTTP redirect/);
  });
});

