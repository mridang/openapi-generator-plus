/*
 * Gap 3.1: end-to-end check that the cross-origin redirect loop actually
 * strips an API-key header (in addition to Authorization). Two loopback
 * servers on different ports count as different origins.
 */
describe('cross-origin redirect strips API-key headers', () => {
  let srcServer: http.Server;
  let dstServer: http.Server;
  let srcUrl: string;
  let dstUrl: string;
  let lastReceivedHeaders: Record<string, string | string[] | undefined> = {};

  beforeAll(async () => {
    dstServer = http.createServer((req, res) => {
      lastReceivedHeaders = req.headers;
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('{"ok":true}');
    });
    await new Promise<void>(resolve => dstServer.listen(0, '127.0.0.1', resolve));
    const dstPort = (dstServer.address() as { port: number }).port;
    dstUrl = `http://127.0.0.1:${dstPort}`;

    srcServer = http.createServer((_req, res) => {
      res.writeHead(302, { Location: `${dstUrl}/landing` });
      res.end();
    });
    await new Promise<void>(resolve => srcServer.listen(0, '127.0.0.1', resolve));
    const srcPort = (srcServer.address() as { port: number }).port;
    srcUrl = `http://127.0.0.1:${srcPort}`;
  });

  afterAll(async () => {
    await new Promise<void>(resolve => srcServer.close(() => resolve()));
    await new Promise<void>(resolve => dstServer.close(() => resolve()));
  });

  it('bhv redirects 012 cross-origin redirect strips Authorization and Cookie', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      { Authorization: 'Bearer secret', Cookie: 'session=xyz', Accept: 'application/json' },
      null,
    );
    expect(lastReceivedHeaders['authorization']).toBeUndefined();
    expect(lastReceivedHeaders['cookie']).toBeUndefined();
    expect(lastReceivedHeaders['accept']).toBe('application/json');
  });

  it('bhv redirects 052 a cross-origin redirect removes Authorization, Cookie, Proxy-Authorization and a secret-named header', async () => {
    const client = new DefaultApiClient(
      TransportOptions.builder().followRedirects(true).defaultHeaders({ 'X-Client-Secret': 'shh' }).build(),
    );
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      {
        Authorization: 'Bearer secret',
        Cookie: 'session=xyz',
        'Proxy-Authorization': 'Basic c2VjcmV0',
        Accept: 'application/json',
      },
      null,
    );
    expect(lastReceivedHeaders['authorization']).toBeUndefined();
    expect(lastReceivedHeaders['cookie']).toBeUndefined();
    expect(lastReceivedHeaders['proxy-authorization']).toBeUndefined();
    expect(lastReceivedHeaders['x-client-secret']).toBeUndefined();
    expect(lastReceivedHeaders['accept']).toBe('application/json');
  });

  it('bhv redirects 011 strips Authorization, the spec-declared apiKey headers, and Cookie on cross-origin 302', async () => {
    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      {
        Authorization: 'Bearer secret',
{{#apiKeyHeaderNames}}
        '{{name}}': 'k-12345',
{{/apiKeyHeaderNames}}
        Cookie: 'session=xyz',
        'Proxy-Authorization': 'Basic abc',
        Accept: 'application/json',
      },
      null,
    );
    // The classic credential carriers are always stripped on a cross-origin hop.
    expect(lastReceivedHeaders['authorization']).toBeUndefined();
    expect(lastReceivedHeaders['cookie']).toBeUndefined();
    expect(lastReceivedHeaders['proxy-authorization']).toBeUndefined();
{{#hasApiKeyHeaderNames}}
    // The spec's apiKey-in-header scheme names are also stripped; they are
    // derived from the spec at codegen time, so a spec without such schemes
    // renders this block empty and asserts nothing here.
{{#apiKeyHeaderNames}}
    expect(lastReceivedHeaders['{{nameLower}}']).toBeUndefined();
{{/apiKeyHeaderNames}}
{{/hasApiKeyHeaderNames}}
    // Non-sensitive headers should still be forwarded.
    expect(lastReceivedHeaders['accept']).toBe('application/json');
  });

  it('bhv redirects 025 strips a default header and an authenticator header the fixed list does not know on cross-origin 302', async () => {
    const transport = TransportOptions.builder()
      .followRedirects(true)
      .defaultHeaders({ 'X-Tenant-Token': 'tenant-secret' })
      .build();
    const client = new DefaultApiClient(transport);
    await client.sendRequest(
      'GET',
      `${srcUrl}/start`,
      { 'X-Custom-Auth': 'custom-secret', 'X-Correlation-Id': 'corr-1' },
      null,
      { credentialHeaderNames: ['X-Custom-Auth'] },
    );
    expect(lastReceivedHeaders['x-tenant-token']).toBeUndefined();
    expect(lastReceivedHeaders['x-custom-auth']).toBeUndefined();
    expect(lastReceivedHeaders['x-correlation-id']).toBe('corr-1');
  });

  it('bhv redirects 024 same-origin redirect keeps Authorization and Cookie', async () => {
    let landed: Record<string, string | string[] | undefined> = {};
    const same = http.createServer((req, res) => {
      if (req.url === '/start') {
