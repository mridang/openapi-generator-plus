describe('redirect method rewriting (RFC 9110 section 15.4)', () => {
  const originalFetch = global.fetch;

  /* The method the second hop is sent with, after a first hop answered with the given status. */
  const followedMethod = async (status: number, method: string): Promise<unknown> => {
    const seen: unknown[] = [];
    global.fetch = (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      seen.push(init?.method);
      if (seen.length === 1) {
        return new Response(null, { status, headers: { Location: 'https://secure.example/next' } });
      }
      return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest(method, 'https://secure.example/start', {}, '{"x":1}');
    return seen[1];
  };

  afterEach(() => {
    global.fetch = originalFetch;
  });

  test.each([
    [301, 'POST', 'GET', false],
    [302, 'POST', 'GET', false],
    [301, 'PUT', 'PUT', true],
    [302, 'PATCH', 'PATCH', true],
    [302, 'DELETE', 'DELETE', true],
    [303, 'POST', 'GET', false],
    [303, 'PUT', 'GET', false],
    [303, 'DELETE', 'GET', false],
    [303, 'HEAD', 'HEAD', false],
    [307, 'PUT', 'PUT', true],
    [308, 'DELETE', 'DELETE', true],
  ])('bhv langnode 079 %i on %s follows with %s (body kept: %s)', async (status, method, expectedMethod, bodyKept) => {
    const calls: Array<{ method: unknown; body: unknown }> = [];
    global.fetch = (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push({ method: init?.method, body: init?.body });
      if (calls.length === 1) {
        return new Response(null, { status, headers: { Location: 'https://secure.example/next' } });
      }
      return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    const response = await client.sendRequest(
      method,
      'https://secure.example/start',
      { 'Content-Type': 'application/json' },
      '{"x":1}',
    );

    expect(response.statusCode).toBe(200);
    expect(calls[1].method).toBe(expectedMethod);
    if (bodyKept) {
      expect(calls[1].body).toBeDefined();
    } else {
      expect(calls[1].body ?? null).toBeNull();
    }
  });

  it('bhv redirects 029 rewrites a PUT to GET only on a 303 and keeps it on a 307', async () => {
    expect(await followedMethod(307, 'PUT')).toBe('PUT');
    expect(await followedMethod(303, 'PUT')).toBe('GET');
  });

  it('bhv redirects 048 a 301 or 302 turns a POST into a GET, and PUT, PATCH, DELETE, HEAD and GET keep their method', async () => {
    for (const status of [301, 302]) {
      expect(await followedMethod(status, 'POST')).toBe('GET');
    }
    for (const method of ['PUT', 'PATCH', 'DELETE', 'HEAD', 'GET']) {
      expect(await followedMethod(301, method)).toBe(method);
    }
  });

  it('bhv redirects 050 the follow-up method of 301, 302, 303, 307 and 308 matches the RFC 9110 table', async () => {
    expect(await followedMethod(301, 'POST')).toBe('GET');
    expect(await followedMethod(302, 'POST')).toBe('GET');
    expect(await followedMethod(303, 'POST')).toBe('GET');
    expect(await followedMethod(307, 'POST')).toBe('POST');
    expect(await followedMethod(308, 'POST')).toBe('POST');
    expect(await followedMethod(307, 'PUT')).toBe('PUT');
    expect(await followedMethod(308, 'PUT')).toBe('PUT');
    expect(await followedMethod(303, 'HEAD')).toBe('HEAD');
  });

  it('bhv redirects 051 a 303 turns a follow-up request into a GET, except that a HEAD request stays HEAD', async () => {
    expect(await followedMethod(303, 'DELETE')).toBe('GET');
    expect(await followedMethod(303, 'HEAD')).toBe('HEAD');
  });

  it('bhv redirects 053 Authorization is removed when the scheme changes between https and http on the same host, either way', async () => {
    const pairs: Array<[string, string]> = [
      ['https://secure.example/start', 'http://secure.example/next'],
      ['http://secure.example/start', 'https://secure.example/next'],
    ];
    for (const [start, next] of pairs) {
      const seen: Array<Record<string, string>> = [];
      global.fetch = (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
        seen.push({ ...(init?.headers as Record<string, string>) });
        if (seen.length === 1) {
          return new Response(null, { status: 302, headers: { Location: next } });
        }
        return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
      }) as typeof fetch;
      const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());

      await client.sendRequest('GET', start, { Authorization: 'Bearer secret' }, null);

      expect(seen[0]!['Authorization']).toBe('Bearer secret');
      expect(seen[1]!['Authorization']).toBeUndefined();
    }
  });

  it('bhv redirects 036 a 303 turns every method except HEAD into GET', async () => {
    for (const method of ['POST', 'PUT', 'PATCH', 'DELETE']) {
      expect(await followedMethod(303, method)).toBe('GET');
    }
    expect(await followedMethod(303, 'HEAD')).toBe('HEAD');
  });

  it('bhv retries 017 refuses to replay a PUT body across an https to http 302 downgrade', async () => {
    global.fetch = (async (): Promise<Response> =>
      new Response(null, { status: 302, headers: { Location: 'http://other.example/x' } })) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await expect(
      client.sendRequest('PUT', 'https://secure.example/start', {}, '{"x":1}'),
    ).rejects.toThrow(/Refusing to replay request body across HTTPS->HTTP redirect/);
  });
});

