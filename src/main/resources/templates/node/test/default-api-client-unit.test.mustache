  });

  it('bhv transport 040 sends the request through the supplied fetch with the SDK defaults on top', async () => {
    const calls: Array<{ url: string; init: Record<string, unknown> }> = [];
    const customFetch = (async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push({ url: String(input), init: (init ?? {}) as Record<string, unknown> });
