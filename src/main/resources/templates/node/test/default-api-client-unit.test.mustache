// Canonical behaviors #4 and #5, end-to-end through sendRequest: the
// assembled multipart/form-data body must (a) advertise each file part's
// Content-Type from its filename extension and (b) carry a non-ASCII field
// name as raw UTF-8 bytes (never '?'-mangled or stripped). A local server
// captures the exact request bytes so the assertions check the wire form.
describe('DefaultApiClient multipart wire form (canonical behaviors #4, #5)', () => {
  function captureRawBody(): Promise<{
    url: string;
    getBody: () => Buffer;
    close: () => void;
  }> {
    return new Promise((resolve) => {
      let chunks: Buffer[] = [];
      const srv = http.createServer((req, res) => {
        chunks = [];
        req.on('data', (chunk: Buffer) => chunks.push(chunk));
        req.on('end', () => {
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end('{"ok":true}');
        });
      });
      srv.listen(0, '127.0.0.1', () => {
        const addr = srv.address() as { port: number };
        resolve({
          url: `http://127.0.0.1:${addr.port}/upload`,
          getBody: () => Buffer.concat(chunks),
          close: () => srv.close(),
        });
      });
    });
  }

  it('bhv serializationwire 037 file part Content-Type is derived from the filename extension', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      // The field name doubles as the filename for Buffer parts, so the
      // extension on the field name drives the per-part Content-Type.
      await client.sendRequest('POST', url, {}, { 'avatar.png': Buffer.from([0x89, 0x50, 0x4e, 0x47]) });
      const body = getBody().toString('binary');
      expect(body).toContain('Content-Type: image/png');
    } finally {
      close();
    }
  });

  it('bhv serializationwire 048 primitive parts are plain text in the stringify form and only an object is a JSON part', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      await client.sendRequest('POST', url, {}, {
        flag: true,
        count: 3,
        when: new Date(Date.UTC(2024, 0, 15, 10, 30, 0)),
        colour: 'red',
        payload: { label: 'sample' },
      });
      const body = getBody().toString('utf-8');
      const part = (name: string) => body.split('\r\n--').find((p) => p.includes(`name="${name}"`))!;
      expect(part('flag')).toMatch(/name="flag"\r\n\r\ntrue$/);
      expect(part('count')).toMatch(/name="count"\r\n\r\n3$/);
      expect(part('when')).toMatch(/name="when"\r\n\r\n2024-01-15T10:30:00\.000\+00:00$/);
      expect(part('colour')).toMatch(/name="colour"\r\n\r\nred$/);
      for (const name of ['flag', 'count', 'when', 'colour']) {
        expect(part(name)).not.toContain('Content-Type');
      }
      expect(part('payload')).toContain('name="payload"\r\nContent-Type: application/json\r\n\r\n{"label":"sample"}');
    } finally {
      close();
    }
  });

  it.each([
    ['multipart/mixed', 'multipart/mixed; boundary='],
    ['multipart/related', 'multipart/related; boundary='],
    ['Multipart/Related; type="application/json"', 'multipart/Related; boundary='],
  ])('a declared %s content type keeps its subtype with the SDK boundary', async (declared, expectedPrefix) => {
    let contentType: string | undefined;
    const srv = http.createServer((req, res) => {
      contentType = req.headers['content-type'];
      req.resume();
      req.on('end', () => {
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end('{"ok":true}');
      });
    });
    await new Promise<void>((resolve) => srv.listen(0, '127.0.0.1', resolve));
    try {
      const port = (srv.address() as { port: number }).port;
      await new DefaultApiClient().sendRequest(
        'POST',
        `http://127.0.0.1:${port}/upload`,
        { 'Content-Type': declared },
        { note: 'hello' },
      );
      expect(contentType!.startsWith(expectedPrefix)).toBe(true);
      expect(contentType).not.toContain('form-data');
    } finally {
      srv.close();
    }
  });

  it('#4 unknown file extension falls back to application/octet-stream', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      await client.sendRequest('POST', url, {}, { 'data.xyzzy': Buffer.from([0x00, 0x01, 0x02]) });
      const body = getBody().toString('binary');
      expect(body).toContain('Content-Type: application/octet-stream');
    } finally {
      close();
    }
  });

  it('bhv serializationwire 049 raw-bytes part with no extension reuses the field name as filename and falls back to application/octet-stream', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      // Field name "file" has no extension: the field name doubles as the
      // filename and the per-part Content-Type falls back to octet-stream.
      await client.sendRequest('POST', url, {}, { file: Buffer.from([0x00, 0x01, 0x02]) });
      const body = getBody().toString('binary');
      expect(body).toContain('name="file"; filename="file"');
      expect(body).toContain('Content-Type: application/octet-stream');
    } finally {
      close();
    }
  });

  it('bhv serializationwire 061 a multipart filename with an embedded quote is backslash-escaped', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      await client.sendRequest('POST', url, {}, { 'a"b.png': Buffer.from([0x89, 0x50, 0x4e, 0x47]) });
      const body = getBody().toString('binary');
      expect(body).toContain('filename="a\\"b.png"');
    } finally {
      close();
    }
  });

  it('bhv serializationwire 045 a model part is written with wire property names and the date-time format', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      await client.sendRequest('POST', url, {}, {
        edge: new EdgeCases({ n2fa: true }),
        stamp: { at: new Date(Date.UTC(2024, 0, 15, 10, 30, 0)) },
      });
      const body = getBody().toString('utf-8');
      expect(body).toContain('"2fa":true');
      expect(body).not.toContain('n2fa');
      expect(body).toContain('"at":"2024-01-15T10:30:00.000+00:00"');
    } finally {
      close();
    }
  });

  it('bhv serializationwire 046 non-ASCII field name is preserved as UTF-8 in the part header', async () => {
    const { url, getBody, close } = await captureRawBody();
    try {
      const client = new DefaultApiClient();
      await client.sendRequest('POST', url, {}, { café: 'crème' });
      const body = getBody();
      // The field name must appear verbatim as UTF-8 bytes — not '?'-mangled
      // (latin1 lossy encode) and not stripped.
      expect(body.toString('utf-8')).toContain('name="café"');
      const cafeUtf8 = Buffer.from('café', 'utf-8');
      expect(body.includes(cafeUtf8)).toBe(true);
    } finally {
      close();
    }
  });
});

