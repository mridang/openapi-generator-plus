    expect(calls[0].init['keepalive']).toBe(true);
    expect(calls[0].init['method']).toBe('GET');
    expect(calls[0].init['redirect']).toBe('manual');
    expect(calls[0].init['signal']).toBeInstanceOf(AbortSignal);
    expect((calls[0].init['headers'] as Record<string, string>)['User-Agent']).toBe('custom-agent/1.0');
    expect((calls[0].init['headers'] as Record<string, string>)['X-Test']).toBe('1');
    await client.close();
  });

  it('bhv lifecycle 038 a caller-supplied fetch with no close operation is valid, and closing repeatedly succeeds while requests are sent', async () => {
    let called = 0;
    const customFetch = (async (): Promise<Response> => {
      called++;
      return new Response('{}');
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).build());

    await client.sendRequest('GET', 'http://example.invalid/', {}, null);
    await client.sendRequest('GET', 'http://example.invalid/', {}, null);
    await expect(client.close()).resolves.toBeUndefined();
    await expect(client.close()).resolves.toBeUndefined();

    expect(called).toBe(2);
  });

  it('bhv redirects 037 a redirect to the explicit default port of the same origin keeps the Authorization header', async () => {
    const calls: Array<Record<string, unknown>> = [];
    const customFetch = (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push((init ?? {}) as Record<string, unknown>);
      if (calls.length === 1) {
        return new Response(null, { status: 302, headers: { Location: 'http://api.example.com:80/landing' } });
      }
      return new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).followRedirects(true).build());
    const response = await client.sendRequest(
      'GET',
      'http://api.example.com/start',
      { Authorization: 'Bearer secret' },
      null,
    );
    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
    const landed = calls[1]!['headers'] as Record<string, string>;
    const authorization = Object.entries(landed).find(([k]) => k.toLowerCase() === 'authorization');
    expect(authorization?.[1]).toBe('Bearer secret');
    await client.close();
