      });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest(
      'POST',
      'http://insecure.example/token',
      {},
      'grant_type=client_credentials',
    );
    expect(response.statusCode).toBe(200);
    expect(call).toBe(2);
  });

  it('bhv redirects 038 a 307 or 308 redirect keeps the method and sends the original body with its Content-Type', async () => {
    const calls: Array<{ url: string; init: RequestInit }> = [];
    global.fetch = (async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push({ url: String(input), init: init ?? {} });
