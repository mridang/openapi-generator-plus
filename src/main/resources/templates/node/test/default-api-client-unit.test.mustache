describe('DefaultApiClient CA certificate fail-fast', () => {
  it('bhv errors 083 an unreadable CA certificate path fails at construction with an error that names the path', () => {
    const missing = path.join(os.tmpdir(), 'no-such-ca-errors-083.pem');
    expect(() => new DefaultApiClient(TransportOptions.builder().caCertPath(missing).build())).toThrow(missing);
  });

  it('bhv errors 098 a missing CA certificate names the certificate and wraps the not-found cause', () => {
    const missing = path.join(os.tmpdir(), 'no-such-ca-errors-098.pem');
    let caught: unknown;
    try {
      new DefaultApiClient(TransportOptions.builder().caCertPath(missing).build());
    } catch (e) {
      caught = e;
    }
    expect((caught as Error).message).toContain(missing);
    expect(((caught as Error).cause as { code?: string }).code).toBe('ENOENT');
  });

  it('bhv errors 041 throws TypeError at construction for a non-existent caCertPath', () => {
    // ca-cert-fail-fast: an explicitly configured CA certificate path that
    // cannot be read or parsed must fail fast at construction with a
    // TypeError rather than silently falling back to the system trust store
    // (security theater).
    const transport = TransportOptions.builder().caCertPath('/nonexistent/ca.pem').build();
    let caught: unknown;
    try {
      new DefaultApiClient(transport);
    } catch (e) {
      caught = e;
    }
    expect((caught as Error).constructor).toBe(TypeError);
    expect(caught).not.toBeInstanceOf({{errorPrefix}}Error);
    expect((caught as Error).message).toMatch(/^failed to read CA certificate from "\/nonexistent\/ca\.pem": \S/);
    expect(((caught as Error).cause as Error).message).toMatch(/ENOENT/);
  });

  it('bhv transport 048 throws TypeError for a nonexistent caCertPath even when verifySsl is false', () => {
    const transport = TransportOptions.builder().caCertPath('/nonexistent/ca.pem').verifySsl(false).build();
    expect(() => new DefaultApiClient(transport)).toThrow(TypeError);
    expect(() => new DefaultApiClient(transport)).toThrow(/^failed to read CA certificate from "\/nonexistent\/ca\.pem": /);
  });

  it('bhv transport 077 reads a directory as a failed read, not as a certificate', () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ca-cert-'));
    try {
      const transport = TransportOptions.builder().caCertPath(dir).build();
      expect(() => new DefaultApiClient(transport)).toThrow(TypeError);
      expect(() => new DefaultApiClient(transport)).toThrow(`failed to read CA certificate from "${dir}": `);
    } finally {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  });

  it('bhv langnode 062 an empty caCertPath file is a failed parse', () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ca-cert-'));
    const empty = path.join(dir, 'empty.pem');
    fs.writeFileSync(empty, '');
    try {
      const transport = TransportOptions.builder().caCertPath(empty).build();
      expect(() => new DefaultApiClient(transport)).toThrow(
        `failed to parse CA certificate from "${empty}": no PEM blocks found or unparseable`
      );
    } finally {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  });

  it('bhv errors 039 throws TypeError at construction for a caCertPath that is not a PEM certificate', () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ca-cert-'));
    const garbage = path.join(dir, 'garbage.pem');
    fs.writeFileSync(garbage, 'this is not a certificate');
    try {
      const transport = TransportOptions.builder().caCertPath(garbage).build();
      expect(() => new DefaultApiClient(transport)).toThrow(TypeError);
      expect(() => new DefaultApiClient(transport)).toThrow(
        `failed to parse CA certificate from "${garbage}": no PEM blocks found or unparseable`
      );
    } finally {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  });
});

describe('DefaultApiClient transport-failure responseHeaders', () => {
  // node-transport-failure-headers-empty-not-null: a transport-phase failure
  // produces no response headers, so the thrown ApiError must carry
  // responseHeaders === null (the documented "no headers" sentinel), not an
  // empty {} that would be indistinguishable from a real header-less response.
  it('bhv langnode 063 connection failure throws NetworkError with null responseHeaders', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    // Port 1 has no listener on the loopback interface; the connect attempt
    // fails before any response is received.
    let caught: ApiError | undefined;
    try {
      await client.sendRequest('GET', 'http://127.0.0.1:1/never', {}, null);
    } catch (e) {
      caught = e as ApiError;
    } finally {
      await client.close();
    }
    expect(caught!.constructor).toBe(NetworkError);
    expect(caught).not.toBeInstanceOf(NetworkTimeoutError);
    expect(caught).toBeInstanceOf(ApiError);
    expect(caught!.statusCode).toBe(0);
    expect(caught!.responseHeaders).toBeNull();
    expect((caught!.cause as Error).name).toBe('TypeError');
  });

  it('bhv errors 077 a URL in diagnostics keeps only the path of the request', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    let caught: ApiError | undefined;
    try {
      await client.sendRequest('GET', 'http://user:pass@127.0.0.1:1/never?token=abc#frag', {}, null);
    } catch (e) {
      caught = e as ApiError;
    } finally {
      await client.close();
    }
    expect(caught!.requestPath).toBe('/never');
    expect(caught!.toString()).toContain('Request: GET /never');
    expect(caught!.toString()).not.toContain('user:pass');
    expect(caught!.toString()).not.toContain('token');
    expect(caught!.toString()).not.toContain('frag');
  });

  it('bhv errors 078 a network failure message and its cause never show the query string', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    let caught: ApiError | undefined;
    try {
      await client.sendRequest('GET', 'http://127.0.0.1:1/never?token=secretvalue', {}, null);
    } catch (e) {
      caught = e as ApiError;
    } finally {
      await client.close();
    }
    expect(caught).toBeInstanceOf(NetworkError);
    expect(caught!.message).not.toContain('secretvalue');
    expect(String((caught!.cause as Error | undefined)?.message ?? '')).not.toContain('secretvalue');
    expect(caught!.toString()).not.toContain('secretvalue');
  });

  it('bhv errors 057 a network failure error carries the request method and path', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    let caught: ApiError | undefined;
    try {
      await client.sendRequest('DELETE', 'http://127.0.0.1:1/items/7?force=1', {}, null);
    } catch (e) {
      caught = e as ApiError;
    } finally {
      await client.close();
    }
    expect(caught).toBeInstanceOf(NetworkError);
    expect(caught!.requestMethod).toBe('DELETE');
    expect(caught!.requestPath).toBe('/items/7');
  });

  it('bhv transport 070 a per-call timeout bounds the request deadline, not the transport timeout', async () => {
    const slow = http.createServer(() => {
      /* never respond */
    });
    await new Promise<void>(resolve => slow.listen(0, '127.0.0.1', resolve));
    const port = (slow.address() as { port: number }).port;
    const client = new DefaultApiClient(TransportOptions.builder().timeout(60000).maxRetries(0).build());
    const started = Date.now();
    let caught: unknown;
    try {
      await client.sendRequest('GET', `http://127.0.0.1:${port}/slow`, {}, null, { timeout: 50 });
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
      slow.closeAllConnections();
      await new Promise<void>(resolve => slow.close(() => resolve()));
    }
    expect((caught as Error).constructor).toBe(NetworkTimeoutError);
    expect(Date.now() - started).toBeLessThan(5000);
  });

  it('bhv transport 071 one configured timeout bounds the wait for the response headers', async () => {
    const slow = http.createServer(() => {
      /* never respond */
    });
    await new Promise<void>(resolve => slow.listen(0, '127.0.0.1', resolve));
    const port = (slow.address() as { port: number }).port;
    const client = new DefaultApiClient(TransportOptions.builder().timeout(50).maxRetries(0).build());
    const started = Date.now();
    let caught: unknown;
    try {
      await client.sendRequest('GET', `http://127.0.0.1:${port}/slow`, {}, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
      slow.closeAllConnections();
      await new Promise<void>(resolve => slow.close(() => resolve()));
    }
    expect((caught as Error).constructor).toBe(NetworkTimeoutError);
    expect(Date.now() - started).toBeLessThan(5000);
  });

  it('bhv transport 072 an unrelated connection failure is not raised as the timeout error', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().timeout(5000).maxRetries(0).build());
    let caught: unknown;
    try {
      await client.sendRequest('GET', 'http://127.0.0.1:1/never', {}, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
    }
    expect(caught).toBeInstanceOf(NetworkError);
    expect(caught).not.toBeInstanceOf(NetworkTimeoutError);
  });

  it('bhv transport 031 an undici phase timeout throws NetworkTimeoutError', async () => {
    /* The client sets one deadline of its own, `AbortSignal.timeout`, which
     * rejects with a DOMException named TimeoutError. undici times the
     * connect, headers and body phases separately and reports each as a
     * TypeError whose cause carries a UND_ERR_*_TIMEOUT code, so the same
     * expired deadline would surface as NetworkError or NetworkTimeoutError
     * depending on which timer fired first. It is a timeout either way. */
    const originalFetch = global.fetch;
    for (const code of [
      'UND_ERR_CONNECT_TIMEOUT',
      'UND_ERR_HEADERS_TIMEOUT',
      'UND_ERR_BODY_TIMEOUT',
    ]) {
      global.fetch = (async (): Promise<Response> => {
        throw new TypeError('fetch failed', {
          cause: Object.assign(new Error('timeout'), { code }),
        });
      }) as typeof fetch;
      const client = new DefaultApiClient();
      let caught: unknown;
      try {
        await client.sendRequest('GET', 'http://example.com/slow', {}, null);
      } catch (e) {
        caught = e;
      } finally {
        await client.close();
      }
      expect((caught as Error).constructor).toBe(NetworkTimeoutError);
      expect(caught).toBeInstanceOf(NetworkError);
      expect((caught as NetworkTimeoutError).statusCode).toBe(0);
    }
    global.fetch = originalFetch;
  });

  it('bhv transport 028 a per-call timeout replaces the transport timeout', async () => {
    const slow = http.createServer(() => {
      /* never respond */
    });
    await new Promise<void>(resolve => slow.listen(0, '127.0.0.1', resolve));
    const port = (slow.address() as { port: number }).port;
    const client = new DefaultApiClient(TransportOptions.builder().timeout(60000).maxRetries(0).build());
    let caught: unknown;
    try {
      await client.sendRequest('GET', `http://127.0.0.1:${port}/slow`, {}, null, { timeout: 50 });
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
      slow.closeAllConnections();
      await new Promise<void>(resolve => slow.close(() => resolve()));
    }
    expect((caught as Error).constructor).toBe(NetworkTimeoutError);
  });

  it('bhv transport 058 a request that exceeds the timeout throws NetworkTimeoutError', async () => {
    const slow = http.createServer(() => {
      /* never respond */
    });
    await new Promise<void>(resolve => slow.listen(0, '127.0.0.1', resolve));
    const port = (slow.address() as { port: number }).port;
    const client = new DefaultApiClient(TransportOptions.builder().timeout(50).build());
    let caught: unknown;
    try {
      await client.sendRequest('GET', `http://127.0.0.1:${port}/slow`, {}, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
      slow.closeAllConnections();
      await new Promise<void>(resolve => slow.close(() => resolve()));
    }
    expect((caught as Error).constructor).toBe(NetworkTimeoutError);
    expect(caught).toBeInstanceOf(NetworkError);
    expect((caught as NetworkTimeoutError).statusCode).toBe(0);
  });

  it('bhv langnode 064 using a closed client throws the invalid-state Error', async () => {
    // A wrong call order is a programming error, not an SDK error.
    const client = new DefaultApiClient();
    await client.close();
    let caught: unknown;
    try {
      await client.sendRequest('GET', `${baseUrl}/echo`, {}, null);
    } catch (e) {
      caught = e;
    }
    expect((caught as Error).constructor).toBe(Error);
    expect(caught).not.toBeInstanceOf({{errorPrefix}}Error);
  });

  it('bhv errors 040 a malformed request URL throws TypeError, not NetworkError', async () => {
    const client = new DefaultApiClient();
    let caught: unknown;
    try {
      await client.sendRequest('GET', 'not a url', {}, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
    }
    // fetch's TypeError may come from another realm, so match it by name.
    expect((caught as Error).name).toBe('TypeError');
    expect(caught).not.toBeInstanceOf(NetworkError);
    expect(caught).not.toBeInstanceOf({{errorPrefix}}Error);
  });

  it('bhv headers 031 a header value with CR/LF throws TypeError, not NetworkError', async () => {
    const client = new DefaultApiClient();
    let caught: unknown;
    try {
      await client.sendRequest('GET', `${baseUrl}/echo`, { 'X-Bad': 'a\r\nInjected: yes' }, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
    }
    // fetch's TypeError may come from another realm, so match it by name.
    expect((caught as Error).name).toBe('TypeError');
    expect(caught).not.toBeInstanceOf(NetworkError);
    expect(caught).not.toBeInstanceOf({{errorPrefix}}Error);
  });

  it('bhv transport 030 a corrupt gzip body throws ApiError with the real status, not NetworkError', async () => {
    // The body arrives with its status and headers but the fetch layer
    // cannot decompress it: a response that could not be used.
    const client = new DefaultApiClient();
    let caught: unknown;
    try {
      await client.sendRequest('GET', `${baseUrl}/bad-gzip`, {}, null);
    } catch (e) {
      caught = e;
    } finally {
      await client.close();
    }
    expect((caught as Error).constructor).toBe(ApiError);
    expect(caught).not.toBeInstanceOf(NetworkError);
    expect((caught as ApiError).statusCode).toBe(502);
    // A response arrived, so its headers are kept: null would mean that none did.
    expect((caught as ApiError).responseHeaders).not.toBeNull();
  });
});

describe('DefaultApiClient.decodeBody charset handling', () => {
  it('bhv serializationwire 032 decodes ISO-8859-1 when declared via Content-Type charset', () => {
    const buf = Buffer.from([0xE9]);
    expect(
      DefaultApiClient.decodeBody(buf, 'text/plain; charset=ISO-8859-1')
    ).toBe('é');
  });

  it('bhv serializationwire 034 defaults to UTF-8 when no charset is declared', () => {
    const buf = Buffer.from([0xC3, 0xA9]);
    expect(DefaultApiClient.decodeBody(buf, 'text/plain')).toBe('é');
  });

  it('bhv serializationwire 035 falls back to UTF-8 when an unknown charset is declared', () => {
    const buf = Buffer.from([0xC3, 0xA9]);
    expect(() =>
      DefaultApiClient.decodeBody(buf, 'text/plain; charset=not-a-real-charset')
    ).not.toThrow();
    expect(
      DefaultApiClient.decodeBody(buf, 'text/plain; charset=not-a-real-charset')
    ).toBe('é');
  });

  it('bhv serialization 055 handles quoted charset values', () => {
    const buf = Buffer.from([0xE9]);
    expect(
      DefaultApiClient.decodeBody(buf, 'text/plain; charset="ISO-8859-1"')
    ).toBe('é');
  });

  it('bhv serializationwire 033 decodes a windows-1252 body, mapping 0x80 to the euro sign', () => {
    expect(DefaultApiClient.decodeBody(Buffer.from([0x80]), 'text/plain; charset=windows-1252')).toBe('€');
  });

  it('bhv serializationwire 031 decodes a BOM-less utf-16 body as big-endian (RFC 2781)', () => {
    // "Log" encoded UTF-16 big-endian, no BOM: 00 4c 00 6f 00 67.
    // Node's TextDecoder maps the bare 'utf-16' label to little-endian,
    // which would mis-decode these bytes. An HTTP client resolving the
    // IANA charset UTF-16 with no BOM must default to big-endian.
    const buf = Buffer.from([0x00, 0x4c, 0x00, 0x6f, 0x00, 0x67]);
    expect(DefaultApiClient.decodeBody(buf, 'text/plain; charset=utf-16')).toBe(
      'Log'
    );
    // Same bytes read little-endian would NOT be "Log" -- proves the
    // big-endian choice rather than an accidental round-trip.
    expect(new TextDecoder('utf-16le').decode(buf)).not.toBe('Log');
  });

  it('bhv serializationwire 054 decodes a little-endian BOM utf-16 body as little-endian', () => {
    // FF FE then "AB" little-endian: a bare utf-16 label must honour the BOM.
    const buf = Buffer.from([0xff, 0xfe, 0x41, 0x00, 0x42, 0x00]);
    expect(DefaultApiClient.decodeBody(buf, 'text/plain; charset=utf-16')).toBe('AB');
  });

  it('bhv serializationwire 030 decodes a big-endian BOM utf-16 body as big-endian', () => {
    const buf = Buffer.from([0xfe, 0xff, 0x00, 0x41, 0x00, 0x42]);
    expect(DefaultApiClient.decodeBody(buf, 'text/plain; charset=utf-16')).toBe('AB');
  });
});

