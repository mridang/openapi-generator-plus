let server: http.Server;
let baseUrl: string;

beforeAll(async () => {
  server = http.createServer((req, res) => {
    if (req.url === '/not-found') {
      res.writeHead(404);
      res.end('not found');
      return;
    }

    if (req.url === '/bad-gzip') {
      // Advertise gzip but send bytes that are not a gzip stream.
      res.writeHead(502, { 'Content-Type': 'application/json', 'Content-Encoding': 'gzip' });
      res.end(Buffer.from('this is definitely not gzip', 'utf-8'));
      return;
    }

    if (req.url === '/vendor-json') {
      const response = JSON.stringify({ format: 'vendor' });
      res.writeHead(200, {
        'Content-Type': 'application/vnd.api+json',
      });
      res.end(response);
      return;
    }

    if (req.url === '/multi-header') {
      res.writeHead(200, { 'X-Custom-Value': ['val1', 'val2'] });
      res.end('ok');
      return;
    }

    if (req.url === '/echo-headers') {
      const response = JSON.stringify(
        Object.fromEntries(
          Object.entries(req.headers).map(([k, v]) => [
            k,
            Array.isArray(v) ? v.join(', ') : v ?? '',
          ])
        )
      );
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(response);
      return;
    }

    let body = '';
    req.on('data', (chunk: Buffer) => (body += chunk.toString()));
    req.on('end', () => {
      const response = JSON.stringify({ method: req.method, body });
      res.writeHead(200, {
        'Content-Type': 'application/json',
        'X-Test-Header': 'test-value',
      });
      res.end(response);
    });
  });

  await new Promise<void>(resolve => {
    server.listen(0, '127.0.0.1', resolve);
  });

  const addr = server.address() as { port: number };
  baseUrl = `http://127.0.0.1:${addr.port}`;
});

afterAll(async () => {
  await new Promise<void>(resolve => server.close(() => resolve()));
});

