});

describe('SendRequestOptions.signal', () => {
  it('bhv transport 068 a call whose signal has already fired raises the cancellation and sends no request', async () => {
    let called = 0;
    const customFetch = (async (): Promise<Response> => {
      called++;
      return new Response('{}');
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).build());
    const controller = new AbortController();
    controller.abort();
    try {
      await expect(
        client.sendRequest('GET', 'http://example.invalid/never', {}, null, { signal: controller.signal })
      ).rejects.toMatchObject({ name: 'AbortError' });
      expect(called).toBe(0);
    } finally {
      await client.close();
    }
  });

  it('bhv transport 069 the cancellation signal reaches the transport request and aborting the call aborts it', async () => {
    let transportSignal: AbortSignal | undefined;
    let started!: () => void;
    const ready = new Promise<void>(resolve => {
      started = resolve;
    });
    const customFetch = ((_input: string | URL | Request, init?: RequestInit): Promise<Response> =>
      new Promise<Response>((_resolve, reject) => {
        transportSignal = init?.signal ?? undefined;
        transportSignal?.addEventListener('abort', () => reject(transportSignal?.reason));
        started();
      })) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).timeout(60000).build());
    const controller = new AbortController();
    const pending = client
      .sendRequest('GET', 'http://example.invalid/slow', {}, null, { signal: controller.signal })
      .catch((e: unknown) => e);
    await ready;
    expect(transportSignal).toBeInstanceOf(AbortSignal);
    controller.abort();
    expect(transportSignal!.aborted).toBe(true);
    expect((await pending as Error).name).toBe('AbortError');
    await client.close();
  });

  it('bhv transport 060 cancelling an in-flight call aborts the request without reporting a timeout', async () => {
    const customFetch = ((_input: string | URL | Request, init?: RequestInit): Promise<Response> =>
      new Promise<Response>((_resolve, reject) => {
        if (init?.signal?.aborted) {
          reject(init.signal.reason);
          return;
        }
        init?.signal?.addEventListener('abort', () => reject(init.signal?.reason));
      })) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).timeout(60000).build());
    const controller = new AbortController();
    const pending = client
      .sendRequest('GET', 'http://example.invalid/slow', {}, null, { signal: controller.signal })
      .catch((e: unknown) => e);
    controller.abort();
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
    expect(error).not.toBeInstanceOf(NetworkTimeoutError);
    expect(error).not.toBeInstanceOf(NetworkError);
    await client.close();
  });
});

describe('the client keeps no ambient state between requests', () => {
