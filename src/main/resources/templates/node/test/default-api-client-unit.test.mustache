/*
 * An intermediate 3xx body is never read, so the client must cancel it or
 * undici keeps the connection busy until the body is garbage collected.
 */
describe('redirect responses release their body', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  function redirectWithTrackedBody(location: string, label: string, cancelled: string[]): Response {
    const body = new ReadableStream<Uint8Array>({
      start(controller) {
        controller.enqueue(new TextEncoder().encode('moved'));
      },
      cancel() {
        cancelled.push(label);
      },
    });
    return new Response(body, { status: 302, headers: { Location: location } });
  }

  it('bhv redirects 017 cancels the body of each redirect it follows', async () => {
    const cancelled: string[] = [];
    let call = 0;
    global.fetch = (async (): Promise<Response> => {
      call++;
      if (call === 1) return redirectWithTrackedBody('http://api.example/b', 'first', cancelled);
      if (call === 2) return redirectWithTrackedBody('http://api.example/c', 'second', cancelled);
      return new Response('done', { status: 200 });
    }) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    const response = await client.sendRequest('GET', 'http://api.example/a', {}, null);

    expect(response.statusCode).toBe(200);
    expect(cancelled).toEqual(['first', 'second']);
  });

  it('bhv transport 064 the intermediate response of a refused HTTPS to HTTP redirect is released', async () => {
    const cancelled: string[] = [];
    global.fetch = (async (): Promise<Response> => {
      const body = new ReadableStream<Uint8Array>({
        start(controller) {
          controller.enqueue(new TextEncoder().encode('moved'));
        },
        cancel() {
          cancelled.push('downgrade');
        },
      });
      return new Response(body, { status: 307, headers: { Location: 'http://evil.example/steal' } });
    }) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client
      .sendRequest('POST', 'https://secure.example/token', { 'Content-Type': 'text/plain' }, 'grant=refused')
      .catch((e: unknown) => e);

    expect(cancelled).toEqual(['downgrade']);
  });

  it('bhv redirects 014 cancels the body of a redirect it refuses to follow', async () => {
    const cancelled: string[] = [];
    global.fetch = (async (): Promise<Response> =>
      redirectWithTrackedBody('file:///etc/passwd', 'refused', cancelled)) as typeof fetch;

    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest('GET', 'http://api.example/a', {}, null).catch((e: unknown) => e);

    expect(cancelled).toEqual(['refused']);
  });

  it('bhv redirects 018 cancels every body, the last one included, when the redirect budget is exhausted', async () => {
    const cancelled: string[] = [];
    let call = 0;
    global.fetch = (async (): Promise<Response> => {
      call++;
      return redirectWithTrackedBody(`http://api.example/hop${call}`, `hop${call}`, cancelled);
    }) as typeof fetch;

    const client = new DefaultApiClient(
      TransportOptions.builder().followRedirects(true).maxRedirects(2).build(),
    );
    await client.sendRequest('GET', 'http://api.example/a', {}, null).catch((e: unknown) => e);

    expect(cancelled).toEqual(['hop1', 'hop2', 'hop3']);
  });
});

/*
 * T-D1: exhausting the redirect budget must throw "too many redirects",
 * not silently return the last 3xx response as if it were normal.
 */
describe('redirect exhaustion throws', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('bhv redirects 046 a chain within the limit is followed to its target and one past it raises too-many-redirects', async () => {
    let n = 0;
    global.fetch = (async (): Promise<Response> => {
      n++;
      if (n <= 2) {
        return new Response(null, { status: 302, headers: { Location: `http://api.example/hop${n}` } });
      }
      return new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    const within = await new DefaultApiClient(TransportOptions.builder().followRedirects(true).maxRedirects(3).build()).sendRequest(
      'GET', 'http://api.example/start', {}, null
    );
    expect(within.statusCode).toBe(200);
    expect(n).toBe(3);

    n = 0;
    const error = await new DefaultApiClient(TransportOptions.builder().followRedirects(true).maxRedirects(1).build())
      .sendRequest('GET', 'http://api.example/start', {}, null)
      .catch((caught: unknown) => caught);
    expect((error as ApiError).statusCode).toBe(302);
    expect((error as ApiError).message).toContain('Too many redirects (exceeded 1)');
  });

  it('bhv redirects 047 a refused redirect and a followed redirect in parallel requests do not change each other', async () => {
    global.fetch = (async (input: string | URL | Request): Promise<Response> => {
      const url = String(input);
      if (url.includes('loop')) {
        return new Response(null, { status: 302, headers: { Location: url } });
      }
      if (url.includes('moved')) {
        return new Response(null, { status: 302, headers: { Location: 'http://api.example/final' } });
      }
      return new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).maxRedirects(3).build());

    const [looping, moved] = await Promise.allSettled([
      client.sendRequest('GET', 'http://api.example/loop', {}, null),
      client.sendRequest('GET', 'http://api.example/moved', {}, null),
    ]);

    expect(looping.status).toBe('rejected');
    expect(moved).toMatchObject({ status: 'fulfilled', value: { statusCode: 200 } });
  });

  it('bhv redirects 054 a redirect chain that runs past the timeout budget fails, and the budget is shared across hops', async () => {
    const chain = (redirects: number): typeof fetch => {
      let n = 0;
      return (async (_input: string | URL | Request, init?: RequestInit): Promise<Response> =>
        new Promise((resolve, reject) => {
          const timer = setTimeout(() => {
            n++;
            resolve(
              n <= redirects
                ? new Response(null, { status: 302, headers: { Location: `http://api.example/hop${n}` } })
                : new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } }),
            );
          }, 300);
          init?.signal?.addEventListener('abort', () => {
            clearTimeout(timer);
            reject(init.signal!.reason);
          });
        })) as typeof fetch;
    };
    const build = () => new DefaultApiClient(TransportOptions.builder().followRedirects(true).maxRedirects(10).timeout(1000).build());

    global.fetch = chain(2);
    const within = await build().sendRequest('GET', 'http://api.example/start', {}, null);
    expect(within.statusCode).toBe(200);

    global.fetch = chain(4);
    const error = await build().sendRequest('GET', 'http://api.example/start', {}, null).catch((caught: unknown) => caught);
    expect((error as Error).constructor).toBe(NetworkTimeoutError);
  });

  it('bhv redirects 026 throws an ApiError once maxRedirects is exceeded', async () => {
    let n = 0;
    global.fetch = (async (): Promise<Response> => {
      n++;
      // Always redirect onward so the budget is exhausted.
      return new Response(null, {
        status: 302,
        headers: { Location: `http://api.example/hop${n}` },
      });
    }) as typeof fetch;

    const transport = TransportOptions.builder()
      .followRedirects(true)
      .maxRedirects(3)
      .build();
    const client = new DefaultApiClient(transport);
    const error = await client
      .sendRequest('GET', 'http://api.example/start', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(ApiError);
    expect((error as ApiError).statusCode).toBe(302);
    expect((error as ApiError).message).toContain('Too many redirects (exceeded 3)');
    expect((error as ApiError).responseHeaders).toHaveProperty('location');
  });

  it('bhv redirects 023 returns the last 3xx when the budget is used up and it has no Location', async () => {
    let n = 0;
    global.fetch = (async (): Promise<Response> => {
      n++;
      if (n === 1) {
        return new Response(null, { status: 302, headers: { Location: 'http://api.example/b' } });
      }
      return new Response('terminal', { status: 302 });
    }) as typeof fetch;

    const transport = TransportOptions.builder().followRedirects(true).maxRedirects(1).build();
    const client = new DefaultApiClient(transport);
    const response = await client.sendRequest('GET', 'http://api.example/a', {}, null);
    expect(response.statusCode).toBe(302);
  });
});

/*
 * T-D4: use-after-close is a wrong call order, so it throws the
 * invalid-state built-in Error rather than a foreign undici exception or
 * silently succeeding.
 */
describe('use-after-close', () => {
  it('bhv lifecycle 023 throws the invalid-state Error when sendRequest is called after close()', async () => {
    const client = new DefaultApiClient();
    await client.close();
    const error = await client
      .sendRequest('GET', 'http://api.example/x', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(Error);
    expect(error).not.toBeInstanceOf(ApiError);
    expect((error as Error).message).toBe(
      'ApiClient has been closed and can no longer send requests'
    );
  });
});

/*
 * F1078: close() is graceful and idempotent. A request already running
 * finishes, a request issued afterwards fails with the one closed-client
 * error, and the transport the SDK created is released when the last running
 * request completes. A transport the caller supplied is never touched.
 */
describe('graceful close', () => {
  const closedMessage = 'ApiClient has been closed and can no longer send requests';

  function slowServer(): Promise<{ url: string; arrived: Promise<void>; answer: () => void; stop: () => Promise<void> }> {
    return new Promise((resolve) => {
      let arrived!: () => void;
      const arrivedPromise = new Promise<void>((done) => {
        arrived = done;
      });
      let pending: http.ServerResponse | undefined;
      const slow = http.createServer((_req, res) => {
        pending = res;
        arrived();
      });
      slow.listen(0, '127.0.0.1', () => {
        resolve({
          url: `http://127.0.0.1:${(slow.address() as { port: number }).port}/slow`,
          arrived: arrivedPromise,
          answer: () => {
            pending?.writeHead(200, { 'Content-Type': 'text/plain' });
            pending?.end('late');
          },
          stop: async () => {
            slow.closeAllConnections();
            await new Promise<void>((done) => slow.close(() => done()));
          },
        });
      });
    });
  }

  it('bhv lifecycle 043 a request after close fails with the closed-client error and never reaches the network', async () => {
    let fetched = 0;
    const originalFetch = global.fetch;
    global.fetch = (async (): Promise<Response> => {
      fetched++;
      return new Response('{}');
    }) as typeof fetch;
    try {
      const client = new DefaultApiClient(TransportOptions.builder().build());
      await client.close();
      await expect(client.sendRequest('GET', 'https://example.invalid/x', {}, null)).rejects.toThrow(
        'ApiClient has been closed and can no longer send requests'
      );
      expect(fetched).toBe(0);
    } finally {
      global.fetch = originalFetch;
    }
  });

  it('bhv lifecycle 044 a request in flight when the client closes still completes after its retry', async () => {
    let calls = 0;
    const originalFetch = global.fetch;
    global.fetch = (async (): Promise<Response> => {
      calls++;
      if (calls === 1) {
        return new Response(null, { status: 503 });
      }
      return new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    try {
      const client = new DefaultApiClient(TransportOptions.builder().maxRetries(1).build());
      const running = client.sendRequest('GET', 'https://example.invalid/x', {}, null);
      await client.close();
      const response = await running;
      expect(response.statusCode).toBe(200);
      expect(calls).toBe(2);
    } finally {
      global.fetch = originalFetch;
    }
  });

  it('bhv lifecycle 021 lets a request that is already running finish', async () => {
    const slow = await slowServer();
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    try {
      const pending = client.sendRequest('GET', slow.url, {}, null);
      await slow.arrived;
      await client.close();
      slow.answer();

      const response = await pending;

      expect(response.statusCode).toBe(200);
      expect(response.body).toBe('late');
    } finally {
      await slow.stop();
    }
  });

  it('bhv lifecycle 037 releases the transport the SDK created only when the last running request completes', async () => {
    const slow = await slowServer();
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).maxRedirects(2).build());
    const dispatcher = (client as unknown as { dispatcher: { closed: boolean } }).dispatcher;
    try {
      const pending = client.sendRequest('GET', slow.url, {}, null);
      await slow.arrived;
      await client.close();

      expect(dispatcher.closed).toBe(false);

      slow.answer();
      await pending;

      expect(dispatcher.closed).toBe(true);
    } finally {
      await slow.stop();
    }
  });

  it('bhv lifecycle 022 releases the transport at once when no request is running, and a second close() is a no-op', async () => {
    const client = new DefaultApiClient(TransportOptions.builder().maxRedirects(2).build());
    const dispatcher = (client as unknown as { dispatcher: { closed: boolean } }).dispatcher;

    await client.close();

    expect(dispatcher.closed).toBe(true);
    await expect(client.close()).resolves.toBeUndefined();
  });

  it('bhv lifecycle 019 a request issued while the last one is finishing fails with the closed-client error', async () => {
    const slow = await slowServer();
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    try {
      const pending = client.sendRequest('GET', slow.url, {}, null);
      await slow.arrived;
      await client.close();

      await expect(client.sendRequest('GET', slow.url, {}, null)).rejects.toThrow(new Error(closedMessage));

      slow.answer();
      await pending;
    } finally {
      await slow.stop();
    }
  });

  it('bhv langnode 074 cancels a running request through its own signal, never through close()', async () => {
    const slow = await slowServer();
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    const controller = new AbortController();
    try {
      const pending = client
        .sendRequest('GET', slow.url, {}, null, { signal: controller.signal })
        .catch((e: unknown) => e);
      await slow.arrived;
      await client.close();
      controller.abort();

      const error = await pending;

      expect((error as Error).name).toBe('AbortError');
    } finally {
      await slow.stop();
    }
  });

  it('bhv lifecycle 020 never closes a fetch the caller supplied, however many times it closes', async () => {
    let called = 0;
    const customFetch = (async (): Promise<Response> => {
      called++;
      return new Response('{}');
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).build());

    await client.sendRequest('GET', 'http://example.invalid/', {}, null);
    await client.close();
    await client.close();

    expect(called).toBe(1);
    expect(await customFetch('http://example.invalid/')).toBeInstanceOf(Response);
  });
});

