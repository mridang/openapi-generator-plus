});

/*
 * Canonical scenario AL — Content-Encoding lie. A server advertises
 * `Content-Encoding: gzip` but the body is NOT a valid gzip stream. The
 * client MUST surface the SDK's ApiError (no crash, no corrupt-byte
 * passthrough), matching java/python/ruby/go/php/rust/elixir which wrap the
 * decompression failure.
 *
 * On the real-network path undici decodes Content-Encoding transparently and
 * throws on a malformed stream (already wrapped as ApiError by the body-read
 * catch). This unit test pins the behaviour deterministically by mocking
 * `fetch` to return a body that carries the gzip magic bytes (0x1F 0x8B) --
 * so it claims AND looks like gzip -- but is not a decodable gzip stream.
 * RED before the fix (the undecoded bytes were base64'd and returned), GREEN
 * after (DefaultApiClient.ensureDecoded gunzips, fails, and throws ApiError).
 */
describe('Content-Encoding lie surfaces ApiError (canonical AL)', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('bhv transport 034 throws ApiError when Content-Encoding: gzip body is not valid gzip', async () => {
    // gzip magic prefix + garbage tail: declares gzip, looks like gzip, but
    // is not a valid gzip stream.
    const lyingBody = Buffer.concat([
      Buffer.from([0x1f, 0x8b]),
      Buffer.from('this is not a valid gzip stream', 'utf-8'),
    ]);
    global.fetch = (async (): Promise<Response> => {
      return new Response(lyingBody, {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          'Content-Encoding': 'gzip',
        },
      });
    }) as typeof fetch;

    const client = new DefaultApiClient();
    const error = await client
      .sendRequest('GET', 'http://api.example/lie', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(ApiError);
    expect(error).not.toBeInstanceOf(NetworkError);
    expect((error as ApiError).statusCode).toBe(200);
  });

  it('decodes a genuinely gzip-encoded body that the fetch layer left compressed', async () => {
    // ensureDecoded is exercised directly: a valid gzip stream still on the
    // wire is decompressed rather than passed through as base64. It is async
    // because the shared base decodes via the Web-standard DecompressionStream
    // so the gzip-lie guard runs on every runtime.
    const valid = zlib.gzipSync(Buffer.from('{"userId":1}', 'utf-8'));
    const out = await DefaultApiClient.ensureDecoded(valid, 'gzip');
    expect(out.toString('utf-8')).toBe('{"userId":1}');
  });

  it('leaves an already-decoded body untouched (no double-decode)', async () => {
    // When the fetch layer has already decoded the body the gzip magic is gone,
    // so ensureDecoded must pass the plaintext through unchanged.
    const decoded = Buffer.from('{"userId":1}', 'utf-8');
    const out = await DefaultApiClient.ensureDecoded(decoded, 'gzip');
    expect(out.toString('utf-8')).toBe('{"userId":1}');
  });

  it('throws ApiError directly from ensureDecoded on invalid gzip bytes', async () => {
    const lyingBody = Buffer.concat([
      Buffer.from([0x1f, 0x8b]),
      Buffer.from('garbage', 'utf-8'),
    ]);
    await expect(
      DefaultApiClient.ensureDecoded(lyingBody, 'gzip')
    ).rejects.toThrow(ApiError);
  });

  it('bhv transport 035 decompresses a zlib-wrapped deflate response', async () => {
    const body = zlib.deflateSync(Buffer.from('{"userId":1}', 'utf-8'));
    const srv = http.createServer((_req, res) => {
      res.writeHead(200, { 'Content-Type': 'application/json', 'Content-Encoding': 'deflate' });
      res.end(body);
    });
    await new Promise<void>(resolve => srv.listen(0, '127.0.0.1', resolve));
    try {
      const port = (srv.address() as { port: number }).port;
      const client = new DefaultApiClient();
      const response = await client.sendRequest('GET', `http://127.0.0.1:${port}/deflate`, {}, null);
      expect(response.body).toBe('{"userId":1}');
    } finally {
      await new Promise<void>(resolve => srv.close(() => resolve()));
    }
  });

  it('bhv transport 027 a decoded body drops the Content-Encoding and Content-Length headers', async () => {
    const body = zlib.gzipSync(Buffer.from('{"userId":1}', 'utf-8'));
    const srv = http.createServer((_req, res) => {
      res.writeHead(200, {
        'Content-Type': 'application/json',
        'Content-Encoding': 'gzip',
        'Content-Length': String(body.length),
      });
      res.end(body);
    });
    await new Promise<void>(resolve => srv.listen(0, '127.0.0.1', resolve));
    const client = new DefaultApiClient();
    try {
      const port = (srv.address() as { port: number }).port;
      const response = await client.sendRequest('GET', `http://127.0.0.1:${port}/gzip`, {}, null);
      expect(response.body).toBe('{"userId":1}');
      expect(response.headers).not.toHaveProperty('content-encoding');
      expect(response.headers).not.toHaveProperty('content-length');
      expect(response.headers['content-type']).toBe('application/json');
    } finally {
      await client.close();
      await new Promise<void>(resolve => srv.close(() => resolve()));
    }
  });

  it('bhv transport 037 passes an empty body declared gzip through as empty, not an error', async () => {
    // A zero-byte body still declared `Content-Encoding: gzip` has nothing to
    // inflate and no gzip magic: ensureDecoded must return it unchanged rather
    // than rejecting on the absent gzip stream.
    const out = await DefaultApiClient.ensureDecoded(Buffer.alloc(0), 'gzip');
    expect(out.length).toBe(0);
  });

  it('bhv transport 033 passes a body declared Content-Encoding: identity through unchanged', async () => {
    global.fetch = (async (): Promise<Response> => {
      return new Response('{"userId":1}', {
        status: 200,
        headers: { 'Content-Type': 'application/json', 'Content-Encoding': 'identity' },
      });
    }) as typeof fetch;

    const client = new DefaultApiClient();
    const response = await client.sendRequest('GET', 'http://api.example/identity', {}, null);
    expect(response.statusCode).toBe(200);
    expect(response.body).toBe('{"userId":1}');
    const direct = await DefaultApiClient.ensureDecoded(Buffer.from('{"userId":1}', 'utf-8'), 'identity');
    expect(direct.toString('utf-8')).toBe('{"userId":1}');
  });
});

describe('injected fetch (TransportOptions.fetch)', () => {
  it('bhv transport 040 sends the request through the supplied fetch with the SDK defaults on top', async () => {
    const calls: Array<{ url: string; init: Record<string, unknown> }> = [];
    const customFetch = (async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
      calls.push({ url: String(input), init: (init ?? {}) as Record<string, unknown> });
      return new Response('{"ok":true}', { status: 200, headers: { 'Content-Type': 'application/json' } });
    }) as typeof fetch;
    const client = new DefaultApiClient(
      TransportOptions.builder()
        .fetch(customFetch)
        .fetchOptions({ keepalive: true, method: 'DELETE' })
        .userAgent('custom-agent/1.0')
        .build()
    );
    const response = await client.sendRequest('GET', 'http://example.invalid/thing', { 'X-Test': '1' }, null);
    expect(response.statusCode).toBe(200);
    expect(response.body).toBe('{"ok":true}');
    expect(calls).toHaveLength(1);
    expect(calls[0].url).toBe('http://example.invalid/thing');
    expect(calls[0].init['keepalive']).toBe(true);
    expect(calls[0].init['method']).toBe('GET');
    expect(calls[0].init['redirect']).toBe('manual');
    expect(calls[0].init['signal']).toBeInstanceOf(AbortSignal);
    expect((calls[0].init['headers'] as Record<string, string>)['User-Agent']).toBe('custom-agent/1.0');
    expect((calls[0].init['headers'] as Record<string, string>)['X-Test']).toBe('1');
    await client.close();
  });

  it('does not touch the supplied fetch when the client is closed', async () => {
    let called = 0;
    const customFetch = (async (): Promise<Response> => {
      called++;
      return new Response('{}');
    }) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).build());
    await client.close();
    await expect(client.sendRequest('GET', 'http://example.invalid/', {}, null)).rejects.toThrow();
    expect(called).toBe(0);
  });
});

describe('SendRequestOptions.signal', () => {
  it('rejects with the AbortError, not a timeout, when the signal fires', async () => {
    const customFetch = ((_input: string | URL | Request, init?: RequestInit): Promise<Response> =>
      new Promise<Response>((_resolve, reject) => {
        if (init?.signal?.aborted) {
          reject(init.signal.reason);
          return;
        }
        init?.signal?.addEventListener('abort', () => reject(init.signal?.reason));
      })) as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(customFetch).timeout(60000).build());
    const controller = new AbortController();
    const pending = client
      .sendRequest('GET', 'http://example.invalid/slow', {}, null, { signal: controller.signal })
      .catch((e: unknown) => e);
    controller.abort();
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
    expect(error).not.toBeInstanceOf(NetworkTimeoutError);
    expect(error).not.toBeInstanceOf(NetworkError);
    await client.close();
  });
});

describe('the client keeps no ambient state between requests', () => {
  const originalFetch = global.fetch;
  const proxyVariables = ['HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy'];
  const savedEnvironment = new Map<string, string | undefined>();
  afterEach(() => {
    global.fetch = originalFetch;
    for (const name of proxyVariables) {
      const saved = savedEnvironment.get(name);
      if (saved === undefined) {
        delete process.env[name];
      } else {
        process.env[name] = saved;
      }
    }
    savedEnvironment.clear();
  });

  it('bhv retries 015 a Set-Cookie response header is not replayed on the next request', async () => {
    const seen: Array<Record<string, string>> = [];
    global.fetch = (async (_url: unknown, init: { headers: Record<string, string> }) => {
      seen.push(init.headers);
      const headers = new Headers();
      headers.append('set-cookie', 'sid=abc; Path=/');
      return new Response('{}', { status: 200, headers });
    }) as unknown as typeof fetch;
    const client = new DefaultApiClient();

    await client.sendRequest('GET', 'http://api.example/first', {}, null);
    await client.sendRequest('GET', 'http://api.example/second', {}, null);

    expect(seen).toHaveLength(2);
    expect(Object.keys(seen[1]!).map((name) => name.toLowerCase())).not.toContain('cookie');
  });

  it('bhv transport 046 ambient proxy variables are ignored; only TransportOptions.proxy is a proxy source', async () => {
    for (const name of proxyVariables) {
      savedEnvironment.set(name, process.env[name]);
      process.env[name] = 'http://127.0.0.1:9';
    }
    let seenInit: Record<string, unknown> | undefined;
    global.fetch = (async (_url: unknown, init: Record<string, unknown>) => {
      seenInit = init;
      return new Response('{}', { status: 200 });
    }) as unknown as typeof fetch;

    await new DefaultApiClient().sendRequest('GET', 'http://api.example/x', {}, null);

    expect(seenInit).toBeDefined();
    expect(seenInit!['dispatcher']).toBeUndefined();
  });

  it('bhv transport 009 ignores ambient proxy environment variables when no proxy is configured', async () => {
    for (const name of proxyVariables) {
      savedEnvironment.set(name, process.env[name]);
      process.env[name] = 'http://127.0.0.1:9';
    }
    const urls: string[] = [];
    let seenInit: Record<string, unknown> | undefined;
    global.fetch = (async (url: unknown, init: Record<string, unknown>) => {
      urls.push(String(url));
      seenInit = init;
      return new Response('{}', { status: 200 });
    }) as unknown as typeof fetch;

    await new DefaultApiClient().sendRequest('GET', 'http://api.example/x', {}, null);

    expect(urls).toEqual(['http://api.example/x']);
    expect(seenInit).toBeDefined();
    expect(seenInit!['dispatcher']).toBeUndefined();
  });
});

describe('proxy URL credentials route through the proxy', () => {
  it('bhv transport 001 a proxy URL with embedded basic-auth credentials routes through proxy', async () => {
    const userinfo = ['user', 'pass'].join(':');
    const seen: Array<string | undefined> = [];
    /* undici's ProxyAgent tunnels every request with CONNECT, even to an http target, so the proxy answers CONNECT and pipes the tunnel to the local server. */
    const proxy = http.createServer((_req, res) => {
      res.writeHead(405);
      res.end();
    });
    proxy.on('connect', (req, clientSocket, head) => {
      seen.push(req.headers['proxy-authorization']);
      const target = new URL(`http://${req.url!}`);
      const upstream = net.connect(Number(target.port), target.hostname, () => {
        clientSocket.write('HTTP/1.1 200 Connection Established\r\n\r\n');
        upstream.write(head);
        clientSocket.pipe(upstream);
        upstream.pipe(clientSocket);
      });
      clientSocket.on('error', () => upstream.destroy());
      upstream.on('error', () => clientSocket.destroy());
    });
    await new Promise<void>(resolve => proxy.listen(0, '127.0.0.1', resolve));
    const port = (proxy.address() as { port: number }).port;
    const client = new DefaultApiClient(
      TransportOptions.builder().proxy(`http://${userinfo}@127.0.0.1:${port}`).build(),
    );
    try {
      const response = await client.sendRequest('GET', `${baseUrl}/echo`, {}, null);
      expect(response.statusCode).toBe(200);
      expect(seen).toEqual([`Basic ${Buffer.from(userinfo, 'utf-8').toString('base64')}`]);
    } finally {
      await client.close();
      proxy.closeAllConnections();
      await new Promise<void>(resolve => proxy.close(() => resolve()));
    }
  });
});

describe('caller-supplied upload handles are left untouched', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('a Blob sent as a multipart part or as the whole body is still readable afterwards', async () => {
    global.fetch = (async () => new Response('{}', { status: 200 })) as unknown as typeof fetch;
    const client = new DefaultApiClient();
    const part = new Blob(['part-bytes']);
    const whole = new Blob(['body-bytes']);

    await client.sendRequest('POST', 'http://api.example/up', {}, { file: part });
    await client.sendRequest('PUT', 'http://api.example/up', { 'Content-Type': 'application/octet-stream' }, whole as unknown as Buffer);

    expect(await part.text()).toBe('part-bytes');
    expect(await whole.text()).toBe('body-bytes');
  });

  it('a Blob is still readable after a failed call', async () => {
    global.fetch = (async () => {
      throw new TypeError('fetch failed');
    }) as unknown as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    const part = new Blob(['part-bytes']);

    await client.sendRequest('POST', 'http://api.example/up', {}, { file: part }).catch(() => undefined);

    expect(await part.text()).toBe('part-bytes');
  });
});

describe('automatic retries (TransportOptions.maxRetries)', () => {
  type Step = Response | Error;
  let delays: number[];
  let calls: Array<{ headers: Record<string, string> }>;

  /* Every backoff wait is recorded and skipped, so the schedule is checked without sleeping. */
  beforeEach(() => {
    delays = [];
    calls = [];
    jest.spyOn(globalThis, 'setTimeout').mockImplementation(((handler: () => void, ms?: number) => {
      delays.push(ms ?? 0);
      handler();
      return 0 as unknown as NodeJS.Timeout;
    }) as unknown as typeof setTimeout);
  });
  afterEach(() => {
    jest.restoreAllMocks();
  });

  /* A client whose fetch plays the steps in order and repeats the last one. */
  function clientPlaying(steps: Step[], configure: (builder: ReturnType<typeof TransportOptions.builder>) => void = () => undefined): DefaultApiClient {
    const scripted = (async (_url: unknown, init?: { headers?: Record<string, string> }) => {
      calls.push({ headers: { ...(init?.headers ?? {}) } });
      const step = steps[Math.min(calls.length, steps.length) - 1]!;
      if (step instanceof Error) {
        throw step;
      }
      return step.clone();
    }) as unknown as typeof fetch;
    const builder = TransportOptions.builder().fetch(scripted);
    configure(builder);
    return new DefaultApiClient(builder.build());
  }

  const reply = (status: number, headers: Record<string, string> = {}): Response => new Response('body', { status, headers });
  const send = (client: DefaultApiClient, options?: Parameters<DefaultApiClient['sendRequest']>[4]) =>
    client.sendRequest('GET', 'http://api.example/items', {}, null, options);

  it('bhv retries 024 retries twice by default and then returns the last response', async () => {
    const response = await send(clientPlaying([reply(503)]));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(3);
    expect(TransportOptions.builder().build().maxRetries).toBe(2);
  });

  it.each([408, 409, 429, 500, 502, 503, 504, 599])('bhv retries 021 retries a %i and returns the success that follows', async (status) => {
    const response = await send(clientPlaying([reply(status), reply(200)]));

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
  });

  it.each([400, 401, 404, 422, 501])('bhv retries 007 does not retry a %i', async (status) => {
    const response = await send(clientPlaying([reply(status)]));

    expect(response.statusCode).toBe(status);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 003 a multipart body is not retried after a 503', async () => {
    const response = await clientPlaying([reply(503), reply(200)]).sendRequest(
      'POST', 'http://api.example/items', {}, { 'avatar.png': Buffer.from([0x89]) });
    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 019 every call gets its own retry count and budget', async () => {
    const client = clientPlaying([reply(503)]);
    await send(client);
    await send(client);
    expect(calls).toHaveLength(6);
  });

  it('bhv retries 018 maxRetries(0) disables retries', async () => {
    const response = await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(0)));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 014 a per-call maxRetries of 0 disables the retries the transport allows', async () => {
    const response = await send(clientPlaying([reply(503)]), { maxRetries: 0 });

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
  });

  it('bhv retries 004 a per-call maxRetries replaces the transport count in both directions', async () => {
    await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(0)), { maxRetries: 3 });
    expect(calls).toHaveLength(4);

    calls = [];
    await send(clientPlaying([reply(503)], (builder) => builder.maxRetries(5)), { maxRetries: 1 });
    expect(calls).toHaveLength(2);
  });

  it('a per-call timeout of null lifts the transport deadline for the backoff wait', async () => {
    const response = await send(
      clientPlaying([reply(503, { 'Retry-After': '5' }), reply(200)], (builder) => builder.timeout(1000)),
      { timeout: null }
    );

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
  });

  it('maxRetries(n) caps the attempts at n + 1', async () => {
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(4).timeout(null)));

    expect(calls).toHaveLength(5);
  });

  it('bhv retries 027 backs off from 0.5 s doubling to 8 s with up to 25% jitter taken off', async () => {
    await send(clientPlaying([reply(500)], (builder) => builder.maxRetries(6).timeout(null)));

    expect(delays).toHaveLength(6);
    delays.forEach((delay, index) => {
      const base = Math.min(500 * 2 ** index, 8000);
      expect(delay).toBeGreaterThanOrEqual(base * 0.75);
      expect(delay).toBeLessThanOrEqual(base);
    });
    expect(Math.max(...delays)).toBeLessThanOrEqual(8000);
  });

  it('bhv retries 026 waits for a Retry-After given in seconds', async () => {
    await send(clientPlaying([reply(429, { 'Retry-After': '3' }), reply(200)]));

    expect(delays).toEqual([3000]);
  });

  it('bhv retries 022 waits for a Retry-After given as an HTTP date', async () => {
    const at = new Date(Date.now() + 30_000).toUTCString();

    await send(clientPlaying([reply(503, { 'Retry-After': at }), reply(200)], (builder) => builder.timeout(null)));

    expect(delays).toHaveLength(1);
    expect(delays[0]!).toBeGreaterThan(28_000);
    expect(delays[0]!).toBeLessThanOrEqual(30_000);
  });

  it('bhv retries 023 caps a Retry-After at 60 s', async () => {
    await send(clientPlaying([reply(503, { 'Retry-After': '3600' }), reply(200)], (builder) => builder.timeout(null)));

    expect(delays).toEqual([60_000]);
  });

  it('bhv retries 029 falls back to the backoff when Retry-After is not understood', async () => {
    await send(clientPlaying([reply(503, { 'Retry-After': 'soon' }), reply(200)]));

    expect(delays).toHaveLength(1);
    expect(delays[0]!).toBeGreaterThanOrEqual(375);
    expect(delays[0]!).toBeLessThanOrEqual(500);
  });

  it('bhv retries 025 never extends the end-to-end timeout: a wait longer than what is left ends the retries', async () => {
    const response = await send(clientPlaying([reply(503, { 'Retry-After': '5' }), reply(200)], (builder) => builder.timeout(1000)));

    expect(response.statusCode).toBe(503);
    expect(calls).toHaveLength(1);
    expect(delays).toEqual([]);
  });

  it('bhv retries 013 retries a network error that happened before any response', async () => {
    const response = await send(clientPlaying([new TypeError('fetch failed'), reply(200)]));

    expect(response.statusCode).toBe(200);
    expect(calls).toHaveLength(2);
  });

  it('reports the last network error once the retries are spent', async () => {
    const error = await send(clientPlaying([new TypeError('fetch failed')])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkError);
    expect(calls).toHaveLength(3);
  });

  it('bhv errors 043 does not retry a failure while reading the body of a response that arrived', async () => {
    const broken = new Response('', { status: 200 });
    Object.defineProperty(broken, 'arrayBuffer', { value: () => Promise.reject(new TypeError('terminated')) });
    Object.defineProperty(broken, 'clone', { value: () => broken });

    const error = await send(clientPlaying([broken as Response])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkError);
    expect(calls).toHaveLength(1);
  });

  it('does not retry a timeout', async () => {
    const timeout = Object.assign(new Error('timed out'), { name: 'TimeoutError' });

    const error = await send(clientPlaying([timeout])).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(NetworkTimeoutError);
    expect(calls).toHaveLength(1);
  });

  it('builds every retry as a fresh request with the authentication headers asked for again', async () => {
    let issued = 0;
    const client = clientPlaying([reply(503), reply(200)], (builder) => builder.injectRequestId(true));

    await send(client, {
      refreshAuthHeaders: async () => ({ authorization: `Bearer token-${++issued}` })
    });

    expect(issued).toBe(1);
    expect(calls).toHaveLength(2);
    expect(calls[0]!.headers['Authorization'] ?? calls[0]!.headers['authorization']).toBeUndefined();
    expect(calls[1]!.headers['authorization']).toBe('Bearer token-1');
    expect(calls[1]!.headers['X-Request-ID']).toBeDefined();
    expect(calls[1]!.headers['X-Request-ID']).not.toBe(calls[0]!.headers['X-Request-ID']);
  });

  it.each([-1, 1.5, Number.NaN])('maxRetries(%p) is rejected', (value) => {
    expect(() => TransportOptions.builder().maxRetries(value)).toThrow(TypeError);
  });
});

describe('automatic retries and cancellation', () => {
  it('bhv retries 028 a caller signal that fires while waiting to retry stops the call with its own reason', async () => {
    const controller = new AbortController();
    let calls = 0;
    const scripted = (async () => {
      calls += 1;
      return new Response('', { status: 503, headers: { 'Retry-After': '5' } });
    }) as unknown as typeof fetch;
    const client = new DefaultApiClient(TransportOptions.builder().fetch(scripted).build());
    setTimeout(() => controller.abort(), 50);

    const error = await client
      .sendRequest('GET', 'http://api.example/items', {}, null, { signal: controller.signal })
      .catch((e: unknown) => e);

    expect((error as Error).name).toBe('AbortError');
    expect(calls).toBe(1);
  });
});
