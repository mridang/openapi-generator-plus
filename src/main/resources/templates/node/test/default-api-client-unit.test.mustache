    expect(seenHeaders['Content-Type']).toBe('image/png');
  });
});

/*
 * response-body-read-error-not-wrapped: a failure during the post-headers
 * body read (connection reset / truncated body) must be wrapped in the
 * uniform ApiError type, not leak the raw fetch error.
 */
describe('body-read error is wrapped in NetworkError', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('bhv transport 032 wraps an arrayBuffer() rejection in NetworkError with the cause kept', async () => {
    global.fetch = (async (): Promise<Response> => {
      // A Response whose body read rejects, simulating a mid-stream reset.
      const resp = new Response('', { status: 200 });
      Object.defineProperty(resp, 'arrayBuffer', {
        value: () => Promise.reject(new TypeError('terminated')),
      });
      return resp;
    }) as typeof fetch;

    const client = new DefaultApiClient();
    const error = await client
      .sendRequest('GET', 'http://api.example/x', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(NetworkError);
    expect((error as NetworkError).statusCode).toBe(0);
    expect(((error as NetworkError).cause as Error).message).toBe('terminated');
  });

  describe('against a server that breaks the body after sending the headers', () => {
    let broken: http.Server;
    let brokenUrl: string;

    beforeAll(async () => {
      broken = http.createServer((req, res) => {
        res.writeHead(200, { 'Content-Type': 'text/plain', 'Content-Length': '100' });
        res.write('partial');
        if (req.url === '/truncated') {
          setTimeout(() => res.destroy(), 20);
        }
      });
      await new Promise<void>((resolve) => broken.listen(0, '127.0.0.1', resolve));
      brokenUrl = `http://127.0.0.1:${(broken.address() as { port: number }).port}`;
    });

    afterAll(async () => {
      broken.closeAllConnections();
      await new Promise<void>((resolve) => broken.close(() => resolve()));
    });

    it('bhv errors 038 a body truncated after the headers throws NetworkError with status 0', async () => {
      const client = new DefaultApiClient();
      const error = await client
        .sendRequest('GET', `${brokenUrl}/truncated`, {}, null)
        .catch((e: unknown) => e);
      await client.close();
      expect((error as Error).constructor).toBe(NetworkError);
      expect((error as NetworkError).statusCode).toBe(0);
      expect((error as NetworkError).cause).toBeDefined();
    });

    it('bhv transport 029 a body that stalls after the headers throws NetworkTimeoutError with status 0', async () => {
      const client = new DefaultApiClient(TransportOptions.builder().timeout(300).build());
      const error = await client
        .sendRequest('GET', `${brokenUrl}/stalled`, {}, null)
        .catch((e: unknown) => e);
      await client.close();
      expect((error as Error).constructor).toBe(NetworkTimeoutError);
      expect((error as NetworkTimeoutError).statusCode).toBe(0);
    });
  });
});

/*
 * Canonical scenario AL — Content-Encoding lie. A server advertises
 * `Content-Encoding: gzip` but the body is NOT a valid gzip stream. The
 * client MUST surface the SDK's ApiError (no crash, no corrupt-byte
 * passthrough), matching java/python/ruby/go/php/rust/elixir which wrap the
 * decompression failure.
 *
 * On the real-network path undici decodes Content-Encoding transparently and
 * throws on a malformed stream (already wrapped as ApiError by the body-read
 * catch). This unit test pins the behaviour deterministically by mocking
 * `fetch` to return a body that carries the gzip magic bytes (0x1F 0x8B) --
 * so it claims AND looks like gzip -- but is not a decodable gzip stream.
 * RED before the fix (the undecoded bytes were base64'd and returned), GREEN
 * after (DefaultApiClient.ensureDecoded gunzips, fails, and throws ApiError).
 */
describe('Content-Encoding lie surfaces ApiError (canonical AL)', () => {
  const originalFetch = global.fetch;
  afterEach(() => {
    global.fetch = originalFetch;
  });

  it('bhv transport 034 throws ApiError when Content-Encoding: gzip body is not valid gzip', async () => {
    // gzip magic prefix + garbage tail: declares gzip, looks like gzip, but
    // is not a valid gzip stream.
    const lyingBody = Buffer.concat([
      Buffer.from([0x1f, 0x8b]),
      Buffer.from('this is not a valid gzip stream', 'utf-8'),
    ]);
    global.fetch = (async (): Promise<Response> => {
      return new Response(lyingBody, {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          'Content-Encoding': 'gzip',
        },
      });
    }) as typeof fetch;

    const client = new DefaultApiClient();
    const error = await client
      .sendRequest('GET', 'http://api.example/lie', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(ApiError);
    expect(error).not.toBeInstanceOf(NetworkError);
    expect((error as ApiError).statusCode).toBe(200);
  });

  it('bhv transport 088 decodes a genuinely gzip-encoded body that the fetch layer left compressed', async () => {
    // ensureDecoded is exercised directly: a valid gzip stream still on the
    // wire is decompressed rather than passed through as base64. It is async
    // because the shared base decodes via the Web-standard DecompressionStream
    // so the gzip-lie guard runs on every runtime.
    const valid = zlib.gzipSync(Buffer.from('{"userId":1}', 'utf-8'));
    const out = await DefaultApiClient.ensureDecoded(valid, 'gzip');
    expect(out.toString('utf-8')).toBe('{"userId":1}');
  });

  it('bhv langnode 075 leaves an already-decoded body untouched (no double-decode)', async () => {
    // When the fetch layer has already decoded the body the gzip magic is gone,
    // so ensureDecoded must pass the plaintext through unchanged.
    const decoded = Buffer.from('{"userId":1}', 'utf-8');
    const out = await DefaultApiClient.ensureDecoded(decoded, 'gzip');
    expect(out.toString('utf-8')).toBe('{"userId":1}');
  });

  it('bhv transport 073 throws ApiError directly from ensureDecoded on invalid gzip bytes', async () => {
    const lyingBody = Buffer.concat([
      Buffer.from([0x1f, 0x8b]),
      Buffer.from('garbage', 'utf-8'),
    ]);
    await expect(
      DefaultApiClient.ensureDecoded(lyingBody, 'gzip')
    ).rejects.toThrow(ApiError);
  });

  it('bhv transport 035 decompresses a zlib-wrapped deflate response', async () => {
    const body = zlib.deflateSync(Buffer.from('{"userId":1}', 'utf-8'));
    const srv = http.createServer((_req, res) => {
      res.writeHead(200, { 'Content-Type': 'application/json', 'Content-Encoding': 'deflate' });
      res.end(body);
    });
    await new Promise<void>(resolve => srv.listen(0, '127.0.0.1', resolve));
    try {
      const port = (srv.address() as { port: number }).port;
      const client = new DefaultApiClient();
      const response = await client.sendRequest('GET', `http://127.0.0.1:${port}/deflate`, {}, null);
      expect(response.body).toBe('{"userId":1}');
    } finally {
      await new Promise<void>(resolve => srv.close(() => resolve()));
    }
  });

  it('bhv transport 027 a decoded body drops the Content-Encoding and Content-Length headers', async () => {
    const body = zlib.gzipSync(Buffer.from('{"userId":1}', 'utf-8'));
    const srv = http.createServer((_req, res) => {
      res.writeHead(200, {
        'Content-Type': 'application/json',
        'Content-Encoding': 'gzip',
        'Content-Length': String(body.length),
      });
      res.end(body);
    });
    await new Promise<void>(resolve => srv.listen(0, '127.0.0.1', resolve));
    const client = new DefaultApiClient();
    try {
      const port = (srv.address() as { port: number }).port;
      const response = await client.sendRequest('GET', `http://127.0.0.1:${port}/gzip`, {}, null);
      expect(response.body).toBe('{"userId":1}');
      expect(response.headers).not.toHaveProperty('content-encoding');
      expect(response.headers).not.toHaveProperty('content-length');
      expect(response.headers['content-type']).toBe('application/json');
    } finally {
      await client.close();
      await new Promise<void>(resolve => srv.close(() => resolve()));
    }
  });

  it('bhv transport 067 a successful response with no body is returned as a success with an empty body', async () => {
    const noBody = http.createServer((_req, res) => {
      res.writeHead(204);
      res.end();
    });
    await new Promise<void>(resolve => noBody.listen(0, '127.0.0.1', resolve));
    const port = (noBody.address() as { port: number }).port;
    const client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    try {
      const response = await client.sendRequest('DELETE', `http://127.0.0.1:${port}/gone`, {}, null);
      expect(response.statusCode).toBe(204);
      expect(response.body).toBe('');
    } finally {
      await client.close();
      noBody.closeAllConnections();
      await new Promise<void>(resolve => noBody.close(() => resolve()));
    }
  });

  it('bhv transport 037 passes an empty body declared gzip through as empty, not an error', async () => {
    // A zero-byte body still declared `Content-Encoding: gzip` has nothing to
    // inflate and no gzip magic: ensureDecoded must return it unchanged rather
    // than rejecting on the absent gzip stream.
    const out = await DefaultApiClient.ensureDecoded(Buffer.alloc(0), 'gzip');
    expect(out.length).toBe(0);
  });

  it('bhv transport 033 passes a body declared Content-Encoding: identity through unchanged', async () => {
    global.fetch = (async (): Promise<Response> => {
      return new Response('{"userId":1}', {
        status: 200,
        headers: { 'Content-Type': 'application/json', 'Content-Encoding': 'identity' },
      });
    }) as typeof fetch;

    const client = new DefaultApiClient();
    const response = await client.sendRequest('GET', 'http://api.example/identity', {}, null);
    expect(response.statusCode).toBe(200);
    expect(response.body).toBe('{"userId":1}');
    const direct = await DefaultApiClient.ensureDecoded(Buffer.from('{"userId":1}', 'utf-8'), 'identity');
    expect(direct.toString('utf-8')).toBe('{"userId":1}');
  });
});

describe('injected fetch (TransportOptions.fetch)', () => {
  it('bhv transport 081 a caller-supplied fetch receives the request URL and caller headers unchanged', async () => {
    const seen: Array<{ url: string; headers: Record<string, string> }> = [];
    const customFetch = (async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
