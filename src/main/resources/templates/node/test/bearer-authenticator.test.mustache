import * as util from 'node:util';
import { BearerAuthenticator } from '../src/auth/bearer-authenticator{{importFileExtension}}';

describe('BearerAuthenticator', () => {
  it('raw token is prefixed with Bearer', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'xyz');
    const headers = auth.getAuthHeaders();
    expect(headers['Authorization']).toBe('Bearer xyz');
  });

  it('already-prefixed token is not doubled', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'Bearer xyz');
    const headers = auth.getAuthHeaders();
    expect(headers['Authorization']).toBe('Bearer xyz');
  });

  it('lowercase bearer prefix is stripped', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'bearer xyz');
    const headers = auth.getAuthHeaders();
    expect(headers['Authorization']).toBe('Bearer xyz');
  });

  it.each(['BEARER xyz', 'BeArEr xyz'])('mixed-case prefix %p is stripped', (token) => {
    const auth = new BearerAuthenticator('https://api.example.com', token);
    expect(auth.getAuthHeaders()).toEqual({ Authorization: 'Bearer xyz' });
  });

  it('a token that merely begins with the word bearer is kept whole', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'bearerxyz');
    expect(auth.getAuthHeaders()).toEqual({ Authorization: 'Bearer bearerxyz' });
  });

  it('the prefix is stripped only once', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'Bearer Bearer xyz');
    expect(auth.getAuthHeaders()).toEqual({ Authorization: 'Bearer Bearer xyz' });
  });

  it('rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () => {
    expect(() => new BearerAuthenticator('https://api.example.com', 'tok\r\nInjected: yes')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('https://api.example.com', 'ñoño')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('https://api.example.com', 'ñoño')).toThrow(
      'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
    );
  });

  it('rejects an empty or whitespace token', () => {
    // bearer-no-empty-token-guard: an empty/whitespace token would emit a
    // bare "Authorization: Bearer " header that silently fails auth.
    expect(() => new BearerAuthenticator('https://api.example.com', '')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('https://api.example.com', '')).toThrow('Bearer token must not be empty');
    expect(() => new BearerAuthenticator('https://api.example.com', '   ')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('https://api.example.com', ' \t\n\v\f\r')).toThrow('Bearer token must not be empty');
  });

  it('a Unicode space is not blank, it fails the printable ASCII check instead', () => {
    expect(() => new BearerAuthenticator('https://api.example.com', '\u00a0')).toThrow(
      'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
    );
  });

  it('a scheme-specific subclass prints its own class name', () => {
    class PetStoreBearerAuthenticator extends BearerAuthenticator {}
    const auth = new PetStoreBearerAuthenticator('https://api.example.com', 'super-secret-token');
    expect(util.inspect(auth)).toBe('PetStoreBearerAuthenticator(host=https://api.example.com, token=***)');
  });

  it('the redacted representation shows exactly the host', () => {
    const auth = new BearerAuthenticator('https://api.example.com', 'super-secret-token');
    expect(util.inspect(auth)).toBe('BearerAuthenticator(host=https://api.example.com, token=***)');
    expect(JSON.parse(JSON.stringify(auth))).toEqual({ host: 'https://api.example.com', token: '***' });
  });

  it('redacts the secret from default string/inspect/JSON', () => {
    // authenticator-secret-in-default-string-repr: console.log / util.inspect
    // / JSON.stringify must never leak the live credential.
    const auth = new BearerAuthenticator('https://api.example.com', 'super-secret-token');
    expect(util.inspect(auth)).not.toContain('super-secret-token');
    expect(JSON.stringify(auth)).not.toContain('super-secret-token');
    expect(util.inspect(auth)).toContain('***');
  });
});
