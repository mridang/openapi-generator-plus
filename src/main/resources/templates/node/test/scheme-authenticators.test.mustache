{{>api_info}}

import { {{#perSchemeAuthImports}}{{name}}{{^-last}}, {{/-last}}{{/perSchemeAuthImports}} } from '../src/index{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiHttpResponse } from '../src/api-http-response{{importFileExtension}}';

describe('SchemeAuthenticators', () => {
  it('bhv langnode 100 every scheme authenticator is exported from the package entry point and extends its base', () => {
    for (const [_name, cls, base] of [
{{#perSchemeAuthEntries}}
    ['{{className}}', {{className}}, {{baseClass}}],
{{/perSchemeAuthEntries}}
  ]) {
      expect(typeof cls).toBe('function');
      expect(Object.getPrototypeOf(cls)).toBe(base);
    }
  });

  it('bhv misc 073 a wrapper class exists for every declared scheme', () => {
    const wrappers: unknown[] = [
{{#perSchemeAuthEntries}}
      {{className}},
{{/perSchemeAuthEntries}}
    ];
    for (const wrapper of wrappers) {
      expect(typeof wrapper).toBe('function');
    }
  });

  const environmentSchemes: Array<[string, new (host: string, ...credentials: string[]) => unknown, string[]]> = [
{{#perSchemeAuthEntries}}
{{#envVars}}
    ['{{className}}', {{className}}, [{{{.}}}]],
{{/envVars}}
{{/perSchemeAuthEntries}}
  ];

  const withVariables = (variables: string[], values: Array<string | undefined>, body: () => void): void => {
    const saved = variables.map((variable) => process.env[variable]);
    try {
      variables.forEach((variable, index) => {
        const value = values[index];
        if (value === undefined) {
          delete process.env[variable];
        } else {
          process.env[variable] = value;
        }
      });
      body();
    } finally {
      variables.forEach((variable, index) => {
        const value = saved[index];
        if (value === undefined) {
          delete process.env[variable];
        } else {
          process.env[variable] = value;
        }
      });
    }
  };

  test('bhv authscheme 010 an empty bearer variable is treated as unset and fails naming the variable', () => {
    const bearer = environmentSchemes.find(([name]) => name.endsWith('BearerAuthenticator'));
    expect(bearer).toBeDefined();
    const [, cls, variables] = bearer!;
    withVariables(variables, variables.map(() => ''), () => {
      expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
    });
  });

  it('bhv authscheme 001 every scheme authenticator reads its own credential variables from the environment', () => {
    for (const [, cls, variables] of environmentSchemes) {
      withVariables(variables, variables.map((variable) => `value-${variable}`), () => {
        expect(() => new cls('https://api.example.com')).not.toThrow();
      });
    }
  });

  it('bhv langnode 099 every scheme authenticator fails when it is built and a variable is unset', () => {
    for (const [, cls, variables] of environmentSchemes) {
      withVariables(variables, variables.map(() => undefined), () => {
        expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
      });
    }
  });

  it('bhv auth 041 every scheme authenticator prefers the explicit credential over the variables', () => {
    for (const [, cls, variables] of environmentSchemes) {
      const invalid = 'bad\r\nvalue';
      withVariables(variables, variables.map(() => invalid), () => {
        expect(() => new cls('https://api.example.com')).toThrow(TypeError);
        expect(() => new cls('https://api.example.com', ...variables.map(() => 'explicit'))).not.toThrow();
      });
    }
  });

  it('bhv authscheme 002 every scheme authenticator needs no environment when every credential is passed explicitly', () => {
    for (const [, cls, variables] of environmentSchemes) {
      withVariables(variables, variables.map(() => undefined), () => {
        expect(() => new cls('https://api.example.com', ...variables.map(() => 'explicit'))).not.toThrow();
      });
    }
  });

  type SchemeWrapper = new (host: string, ...credentials: string[]) => unknown;
  const schemeWrappers: Array<[string, SchemeWrapper, { name: string }]> = [
{{#perSchemeAuthEntries}}
    ['{{className}}', {{className}}, {{baseClass}}],
{{/perSchemeAuthEntries}}
  ];

  const placeholders = (cls: { length: number }): string[] =>
    Array.from({ length: Math.max(cls.length - 1, 0) }, (_unused, index) => `value-${index}`);

  type Recorded = Array<{ url: string; body: string | Buffer | null }>;
  const recordingClient = (sent: Recorded): ApiClient => ({
    async sendRequest(
      _method: string,
      url: string,
      _headers: Record<string, string>,
      body: string | Buffer | null
    ): Promise<ApiHttpResponse> {
      sent.push({ url, body });
      return {
        statusCode: 200,
        body: JSON.stringify({ access_token: 'access-token', refresh_token: 'refresh-token', expires_in: 0 }),
        headers: { 'content-type': 'application/json' }
      };
    }
  });

  const expectEmptyVariableNamed = (className: string): void => {
    const entry = environmentSchemes.find(([name]) => name === className);
    if (entry === undefined) {
      throw new Error(`no environment scheme named ${className}`);
    }
    const [, cls, variables] = entry;
    withVariables(variables, variables.map(() => ''), () => {
      expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
    });
  };

  const schemeClassesOf = (base: string): string[] =>
    schemeWrappers.filter(([, , baseClass]) => baseClass.name === base).map(([name]) => name);

  it('bhv authscheme 003 a scheme authenticator fails at construction naming the variable when its environment variable is empty', () => {
    for (const [, cls, variables] of environmentSchemes) {
      withVariables(variables, variables.map(() => ''), () => {
        expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
      });
    }
  });

  it('bhv authscheme 004 the AdminBasic scheme authenticator treats an empty environment variable as unset and names it', () => {
    expectEmptyVariableNamed('AdminBasicAuthenticator');
  });

  it('bhv authscheme 005 the ApiKeyHeader scheme authenticator treats an empty environment variable as unset and names it', () => {
    expectEmptyVariableNamed('ApiKeyHeaderAuthenticator');
  });

  it('bhv authscheme 006 the ApiKeyQuery scheme authenticator treats an empty environment variable as unset and names it', () => {
    expectEmptyVariableNamed('ApiKeyQueryAuthenticator');
  });

  it('bhv authscheme 007 the SessionCookie scheme authenticator treats an empty environment variable as unset and names it', () => {
    expectEmptyVariableNamed('SessionCookieAuthenticator');
  });

  it('bhv authscheme 011 an empty environment variable for a bearer scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('BearerAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });

  it('bhv authscheme 012 an empty environment variable for the api key scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('ApiKeyAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });

  it('bhv authscheme 013 an empty environment variable for the client credentials scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('OAuth2ClientCredentialsAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });

  it('bhv authscheme 014 an empty environment variable for the password scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('OAuth2PasswordAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });

  it('bhv authscheme 015 an empty environment variable for the authorization code scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('OAuth2AuthorizationCodeAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });

  it('bhv authscheme 016 an empty environment variable for the implicit scheme credential is treated as unset and fails naming the variable', () => {
    const names = schemeClassesOf('OAuth2ImplicitAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });


  it('bhv misc 193 every scheme wrapper sends the same header as its base, and a Basic wrapper refuses a colon in the username as its base does', () => {
    for (const [, cls, base] of schemeWrappers.filter(([, , base]) => base.name === 'BasicAuthenticator')) {
      const wrapped = new cls('https://api.example.com', 'alice', 's3cret') as { getAuthHeaders(): Record<string, string> };
      const plain = new (base as unknown as SchemeWrapper)('https://api.example.com', 'alice', 's3cret') as { getAuthHeaders(): Record<string, string> };
      expect(wrapped.getAuthHeaders()).toEqual(plain.getAuthHeaders());
      expect(() => new cls('https://api.example.com', 'ali:ce', 's3cret')).toThrow(TypeError);
      expect(() => new (base as unknown as SchemeWrapper)('https://api.example.com', 'ali:ce', 's3cret')).toThrow(TypeError);
    }
    for (const [, cls, base] of schemeWrappers.filter(([, , base]) => base.name === 'BearerAuthenticator')) {
      const wrapped = new cls('https://api.example.com', 'Bearer abc-123') as { getAuthHeaders(): Record<string, string> };
      const plain = new (base as unknown as SchemeWrapper)('https://api.example.com', 'Bearer abc-123') as { getAuthHeaders(): Record<string, string> };
      expect(wrapped.getAuthHeaders()).toEqual(plain.getAuthHeaders());
    }
  });

  it('bhv misc 208 an empty environment variable for an implicit credential fails with the unset message', () => {
    const names = schemeClassesOf('OAuth2ImplicitAuthenticator').filter((name) => environmentSchemes.some(([known]) => known === name));
    expect(names.length).toBeGreaterThan(0);
    for (const name of names) {
      expectEmptyVariableNamed(name);
    }
  });
  it('bhv authbasic 002 every Basic scheme authenticator emits a basic header and masks the password', () => {
    for (const [, cls] of schemeWrappers.filter(([, , base]) => base.name === 'BasicAuthenticator')) {
      const auth = new cls('https://api.example.com', 'alice', 's3cret') as { getAuthHeaders(): Record<string, string> };
      expect(auth.getAuthHeaders()).toEqual({ Authorization: `Basic ${Buffer.from('alice:s3cret').toString('base64')}` });
      expect(JSON.stringify(auth)).not.toContain('s3cret');
    }
  });

  it('bhv authbearer 006 every Bearer scheme authenticator emits a bearer header and masks the token', () => {
    for (const [, cls] of schemeWrappers.filter(([, , base]) => base.name === 'BearerAuthenticator')) {
      const auth = new cls('https://api.example.com', 'abc-123') as { getAuthHeaders(): Record<string, string> };
      expect(auth.getAuthHeaders()).toEqual({ Authorization: 'Bearer abc-123' });
      expect(JSON.stringify(auth)).not.toContain('abc-123');
    }
  });

  it('bhv authoauthtwoclientcred 009 every client credentials scheme authenticator sends the spec scopes to the spec token URL', async () => {
    for (const [, cls] of schemeWrappers.filter(([, , base]) => base.name === 'OAuth2ClientCredentialsAuthenticator')) {
      const sent: Recorded = [];
      const auth = new cls('https://api.example.com', ...placeholders(cls)) as unknown as {
        setApiClient(client: ApiClient): void;
        getAuthHeadersAsync(): Promise<Record<string, string>>;
        tokenUrl: string;
        scopes: readonly string[];
      };
      auth.setApiClient(recordingClient(sent));

      await auth.getAuthHeadersAsync();

      expect(sent.map((call) => call.url)).toEqual([auth.tokenUrl]);
      expect(new URLSearchParams(String(sent[0]!.body)).get('scope')).toBe(auth.scopes.join(' '));
    }
  });

  it('bhv authoauthtwopassword 012 every password scheme authenticator sends the spec scopes and urls', async () => {
    for (const [, cls] of schemeWrappers.filter(([, , base]) => base.name === 'OAuth2PasswordAuthenticator')) {
      const sent: Recorded = [];
      const auth = new cls('https://api.example.com', ...placeholders(cls)) as unknown as {
        setApiClient(client: ApiClient): void;
        getAuthHeadersAsync(): Promise<Record<string, string>>;
        tokenUrl: string;
        refreshUrl: string;
        scopes: readonly string[];
      };
      auth.setApiClient(recordingClient(sent));

      await auth.getAuthHeadersAsync();
      const originalNow = Date.now;
      Date.now = () => originalNow() + 120_000;
      try {
        await auth.getAuthHeadersAsync();
      } finally {
        Date.now = originalNow;
      }

      expect(sent.map((call) => call.url)).toEqual([auth.tokenUrl, auth.refreshUrl]);
      expect(new URLSearchParams(String(sent[0]!.body)).get('scope')).toBe(auth.scopes.join(' '));
    }
  });
});
