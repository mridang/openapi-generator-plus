{{>api_info}}

import { {{#perSchemeAuthImports}}{{name}}{{^-last}}, {{/-last}}{{/perSchemeAuthImports}} } from '../src/index{{importFileExtension}}';

describe('SchemeAuthenticators', () => {
  it.each([
{{#perSchemeAuthEntries}}
    ['{{className}}', {{className}}, {{baseClass}}],
{{/perSchemeAuthEntries}}
  ])('%s is exported from the package entry point and extends its base', (_name, cls, base) => {
    expect(typeof cls).toBe('function');
    expect(Object.getPrototypeOf(cls)).toBe(base);
  });

  const environmentSchemes: Array<[string, new (host: string, ...credentials: string[]) => unknown, string[]]> = [
{{#perSchemeAuthEntries}}
{{#envVars}}
    ['{{className}}', {{className}}, [{{{.}}}]],
{{/envVars}}
{{/perSchemeAuthEntries}}
  ];

  const withVariables = (variables: string[], values: Array<string | undefined>, body: () => void): void => {
    const saved = variables.map((variable) => process.env[variable]);
    try {
      variables.forEach((variable, index) => {
        const value = values[index];
        if (value === undefined) {
          delete process.env[variable];
        } else {
          process.env[variable] = value;
        }
      });
      body();
    } finally {
      variables.forEach((variable, index) => {
        const value = saved[index];
        if (value === undefined) {
          delete process.env[variable];
        } else {
          process.env[variable] = value;
        }
      });
    }
  };

  for (const [name, cls, variables] of environmentSchemes) {
    it(`${name} reads its own credential variables from the environment`, () => {
      withVariables(variables, variables.map((variable) => `value-${variable}`), () => {
        expect(() => new cls('https://api.example.com')).not.toThrow();
      });
    });

    it(`${name} fails when it is built and a variable is unset`, () => {
      withVariables(variables, variables.map(() => undefined), () => {
        expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
      });
    });

    it(`${name} treats an empty variable as unset`, () => {
      withVariables(variables, variables.map(() => ''), () => {
        expect(() => new cls('https://api.example.com')).toThrow(variables[0]);
      });
    });

    it(`${name} prefers the explicit credential over the variables`, () => {
      const invalid = 'bad\r\nvalue';
      withVariables(variables, variables.map(() => invalid), () => {
        expect(() => new cls('https://api.example.com')).toThrow(TypeError);
        expect(() => new cls('https://api.example.com', ...variables.map(() => 'explicit'))).not.toThrow();
      });
    });
  }
});
