import * as fs from 'node:fs';
import * as path from 'node:path';
import * as util from 'node:util';
import { {{errorPrefix}}Error } from '../src/errors/index{{importFileExtension}}';
import { TransportOptions } from '../src/transport-options{{importFileExtension}}';

const directOptions = {
  verifySsl: true,
  caCertPath: null,
  proxy: null,
  timeout: 10000,
  followRedirects: true,
  maxRedirects: null,
  userAgent: null,
  defaultHeaders: {},
  injectRequestId: false,
};

describe('TransportOptions', () => {
  test('bhv options 043 verifySsl defaults to true', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.verifySsl).toBe(true);
  });

  test('bhv options 018 caCertPath defaults to null', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.caCertPath).toBeNull();
  });

  test('bhv options 032 proxy defaults to null', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.proxy).toBeNull();
  });

  test('bhv options 039 timeout defaults to 10000 milliseconds', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.timeout).toBe(10000);
  });

  test('bhv options 020 followRedirects defaults to true', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.followRedirects).toBe(true);
  });

  test('bhv options 025 maxRedirects defaults to null', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.maxRedirects).toBeNull();
  });

  test('bhv options 026 maxRetries defaults to 2', () => {
    expect(TransportOptions.builder().build().maxRetries).toBe(2);
    expect(new TransportOptions({ ...directOptions }).maxRetries).toBe(2);
  });

  test('bhv options 027 maxRetries is set by the builder and by the constructor, 0 disabling retries', () => {
    expect(TransportOptions.builder().maxRetries(5).build().maxRetries).toBe(5);
    expect(TransportOptions.builder().maxRetries(0).build().maxRetries).toBe(0);
    expect(new TransportOptions({ ...directOptions, maxRetries: 3 }).maxRetries).toBe(3);
  });

  test('bhv options 007 a negative maxRetries is rejected', () => {
    for (const value of [-1, 0.5, Number.NaN, Number.POSITIVE_INFINITY]) {
      expect(() => TransportOptions.builder().maxRetries(value)).toThrow(
        `Invalid maxRetries: must be a non-negative integer (got ${value})`
      );
      expect(() => new TransportOptions({ ...directOptions, maxRetries: value })).toThrow(TypeError);
    }
  });

  test('bhv options 041 userAgent defaults to non-empty string', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.userAgent).toBeTruthy();
  });

  test('bhv options 042 the default userAgent names the published package, its version and the language', () => {
    const pkg = JSON.parse(fs.readFileSync(path.resolve(__dirname, '..', 'package.json'), 'utf-8')) as {
      name: string;
      version: string;
    };
    expect(TransportOptions.builder().build().userAgent).toBe(`${pkg.name}/${pkg.version} (node)`);
  });

  test('bhv options 019 defaultHeaders defaults to empty map', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.defaultHeaders).toEqual({});
  });

  test('bhv options 022 injectRequestId defaults to false', () => {
    const opts = TransportOptions.builder().build();
    expect(opts.injectRequestId).toBe(false);
  });

  test('bhv options 017 builder sets all fields', () => {
    const opts = TransportOptions.builder()
      .verifySsl(false)
      .caCertPath('/path/to/ca.pem')
      .proxy('http://proxy:8080')
      .timeout(5000)
      .followRedirects(false)
      .maxRedirects(3)
      .userAgent('TestAgent/1.0')
      .defaultHeader('X-Custom', 'value')
      .injectRequestId(true)
      .build();

    expect(opts.verifySsl).toBe(false);
    expect(opts.caCertPath).toBe('/path/to/ca.pem');
    expect(opts.proxy).toBe('http://proxy:8080');
    expect(opts.timeout).toBe(5000);
    expect(opts.followRedirects).toBe(false);
    expect(opts.maxRedirects).toBe(3);
    expect(opts.userAgent).toBe('TestAgent/1.0');
    expect(opts.defaultHeaders).toEqual({ 'X-Custom': 'value' });
    expect(opts.injectRequestId).toBe(true);
  });

  test('bhv options 021 followRedirects defaults to true with null maxRedirects', () => {
    const opts = TransportOptions.builder()
      .followRedirects(true)
      .build();

    expect(opts.followRedirects).toBe(true);
    expect(opts.maxRedirects).toBeNull();
  });

  test('bhv options 033 rejects a non-positive timeout with the canonical message', () => {
    expect(() => TransportOptions.builder().timeout(-1)).toThrow(
      new TypeError('Invalid timeout: must be a positive number of milliseconds (got -1)')
    );
    expect(() => TransportOptions.builder().timeout(0)).toThrow(TypeError);
  });

  test('bhv options 008 a proxy URL error never carries the user-info', () => {
    const proxy = 'ftp://user:hunter2@proxy.example.com:21';
    expect(() => TransportOptions.builder().proxy(proxy)).toThrow(TypeError);
    let message = '';
    try {
      TransportOptions.builder().proxy(proxy);
    } catch (e) {
      message = (e as Error).message;
    }
    expect(message).not.toContain('hunter2');
  });

  test('bhv options 024 invalid proxy URL throws error', () => {
    let caught: unknown;
    try {
      TransportOptions.builder().proxy('not-a-valid-url');
    } catch (e) {
      caught = e;
    }
    expect((caught as Error).constructor).toBe(TypeError);
    expect(caught).not.toBeInstanceOf({{errorPrefix}}Error);
  });

  test('bhv options 051 a proxy URL with a scheme other than http or https throws TypeError', () => {
    expect(() => {
      TransportOptions.builder().proxy('ftp://proxy.example.com');
    }).toThrow(TypeError);
  });

  test('bhv options 046 constructing directly with a non-http proxy scheme is rejected with TypeError', () => {
    const construct = () => new TransportOptions({ ...directOptions, proxy: 'ftp://proxy.example.com' });
    expect(construct).toThrow(TypeError);
    expect(construct).toThrow('Invalid proxy URL (must use http or https scheme): ftp://proxy.example.com');
  });

  test('bhv options 045 a negative maxRedirects is rejected at configuration', () => {
    expect(() => TransportOptions.builder().maxRedirects(-1)).toThrow(TypeError);
    expect(() => new TransportOptions({ ...directOptions, maxRedirects: -1 })).toThrow(
      'Invalid maxRedirects: must be a non-negative integer (got -1)'
    );
  });

  test('bhv options 047 a negative timeout is rejected at configuration', () => {
    expect(() => TransportOptions.builder().timeout(-1)).toThrow(TypeError);
  });

  test('bhv options 013 constructing directly with an unparseable proxy URL throws TypeError', () => {
    const construct = () => new TransportOptions({ ...directOptions, proxy: 'not-a-valid-url' });
    expect(construct).toThrow(TypeError);
    expect(construct).toThrow('Invalid proxy URL (unparseable): not-a-valid-url');
  });

  test('bhv options 031 proxy URL that is empty, has no host or has a bad scheme is rejected with TypeError and the exact message', () => {
    const rows: Array<[string, string, string]> = [
    ['an empty string', '', 'Invalid proxy URL (unparseable): '],
    ['a scheme without a host', 'http://', 'Invalid proxy URL (unparseable): http://'],
    ['a socks scheme', 'socks5://proxy.example.com:1080', 'Invalid proxy URL (must use http or https scheme): socks5://proxy.example.com:1080'],
    ['an ftp scheme', 'ftp://proxy.example.com:21', 'Invalid proxy URL (must use http or https scheme): ftp://proxy.example.com:21']
    ];
    for (const [, proxy, message] of rows) {
      expect(() => TransportOptions.builder().proxy(proxy)).toThrow(TypeError);
      expect(() => TransportOptions.builder().proxy(proxy)).toThrow(message);
    }
  });

  test('bhv options 011 a proxy URL with no host is rejected', () => {
    expect(() => TransportOptions.builder().proxy('http://')).toThrow(TypeError);
    expect(() => new TransportOptions({ ...directOptions, proxy: 'http://' })).toThrow(
      'Invalid proxy URL (unparseable): http://'
    );
  });

  test.each([
    ['a socks scheme', 'socks5://u:p@h:1', 'Invalid proxy URL (must use http or https scheme): socks5://***@h:1'],
    ['an unparseable value', 'http://u:p@', 'Invalid proxy URL (unparseable): http://***@']
  ])('bhv options 008 the proxy error for %s never prints the userinfo', (_label, proxy, message) => {
    expect(() => TransportOptions.builder().proxy(proxy)).toThrow(message);
    expect(() => new TransportOptions({ ...directOptions, proxy })).toThrow(message);
  });

  test('bhv options 009 a proxy URL with an IPv6 literal host is accepted and kept verbatim', () => {
    expect(TransportOptions.builder().proxy('http://[::1]:3128').build().proxy).toBe('http://[::1]:3128');
    expect(new TransportOptions({ ...directOptions, proxy: 'http://[::1]:3128' }).proxy).toBe('http://[::1]:3128');
  });

  test('bhv options 010 a proxy URL with an unterminated IPv6 literal is rejected', () => {
    expect(() => TransportOptions.builder().proxy('http://[::1:3128')).toThrow(TypeError);
    expect(() => TransportOptions.builder().proxy('http://[::1:3128')).toThrow(
      'Invalid proxy URL (unparseable): http://[::1:3128'
    );
  });

  test('bhv options 014 an upper-case proxy scheme is accepted', () => {
    expect(TransportOptions.builder().proxy('HTTP://proxy.example.com:8080').build().proxy).toBe(
      'HTTP://proxy.example.com:8080'
    );
  });

  test('bhv options 067 constructing directly with a valid or absent proxy succeeds', () => {
    expect(new TransportOptions({ ...directOptions, proxy: 'http://proxy:8080' }).proxy).toBe('http://proxy:8080');
    expect(new TransportOptions({ ...directOptions, proxy: null }).proxy).toBeNull();
  });

  test('bhv options 030 null proxy URL is accepted', () => {
    const opts = TransportOptions.builder()
      .proxy(null)
      .build();
    expect(opts.proxy).toBeNull();
  });

  test('bhv options 060 the static builder entry point carries the values set on it and the defaults of a direct build', () => {
    const built = TransportOptions.builder().timeout(5000).build();
    const direct = new TransportOptions({ ...directOptions, timeout: 5000 });
    expect(built.timeout).toBe(5000);
    expect(built.verifySsl).toBe(direct.verifySsl);
    expect(built.maxRetries).toBe(direct.maxRetries);
    expect(built.toString()).toBe(direct.toString());
  });

  test('bhv options 061 a user agent set on transport options is kept as given, and none leaves it unset', () => {
    expect(TransportOptions.builder().userAgent('my-agent/2.0').build().userAgent).toBe('my-agent/2.0');
    expect(TransportOptions.builder().userAgent(null).build().userAgent).toBeNull();
  });

  test('bhv options 015 builder methods return the same builder instance', () => {
    const builder = TransportOptions.builder();

    expect(builder.verifySsl(true)).toBe(builder);
    expect(builder.caCertPath(null)).toBe(builder);
    expect(builder.proxy(null)).toBe(builder);
    expect(builder.timeout(null)).toBe(builder);
    expect(builder.followRedirects(true)).toBe(builder);
    expect(builder.maxRedirects(null)).toBe(builder);
    expect(builder.maxRetries(2)).toBe(builder);
    expect(builder.userAgent(null)).toBe(builder);
    expect(builder.defaultHeader('X-Key', 'val')).toBe(builder);
    expect(builder.defaultHeaders({})).toBe(builder);
    expect(builder.injectRequestId(false)).toBe(builder);
  });

  test('bhv options 012 accumulates headers from defaultHeader calls', () => {
    const opts = TransportOptions.builder()
      .defaultHeader('X-First', 'one')
      .defaultHeader('X-Second', 'two')
      .build();

    expect(Object.keys(opts.defaultHeaders)).toHaveLength(2);
    expect(opts.defaultHeaders['X-First']).toBe('one');
    expect(opts.defaultHeaders['X-Second']).toBe('two');
  });

  test('bhv options 028 merges headers from defaultHeaders call', () => {
    const opts = TransportOptions.builder()
      .defaultHeader('X-First', 'one')
      .defaultHeaders({ 'X-Second': 'two', 'X-Third': 'three' })
      .build();

    expect(Object.keys(opts.defaultHeaders)).toHaveLength(3);
    expect(opts.defaultHeaders['X-First']).toBe('one');
    expect(opts.defaultHeaders['X-Second']).toBe('two');
    expect(opts.defaultHeaders['X-Third']).toBe('three');
  });

  test('bhv options 029 modifying source map does not affect built options', () => {
    const headers: Record<string, string> = { 'X-Original': 'original' };

    const opts = TransportOptions.builder()
      .defaultHeaders(headers)
      .build();

    headers['X-Added'] = 'added';

    expect(Object.keys(opts.defaultHeaders)).toHaveLength(1);
    expect(opts.defaultHeaders['X-Original']).toBe('original');
    expect(opts.defaultHeaders['X-Added']).toBeUndefined();
  });

  test('bhv options 016 builder produces independent instances', () => {
    const builder = TransportOptions.builder().verifySsl(false);
    const first = builder.build();
    const second = builder.build();

    expect(first.verifySsl).toBe(second.verifySsl);
    expect(first).not.toBe(second);
  });

  describe('TimeoutConfigTests', () => {
    test('bhv options 038 timeout defaults to 10 seconds (10000 ms)', () => {
      // Default TransportOptions sets a 10-second timeout for cross-language parity.
      const opts = TransportOptions.builder().build();
      expect(opts.timeout).toBe(10000);
    });

    test('bhv options 037 timeout default may be overridden to null for no timeout', () => {
      const opts = TransportOptions.builder().timeout(null).build();
      expect(opts.timeout).toBeNull();
    });

    test('bhv options 036 setting timeout to 5000 is accessible', () => {
      const opts = TransportOptions.builder().timeout(5000).build();
      expect(opts.timeout).toBe(5000);
    });

    test('bhv options 040 timeout field is named exactly timeout', () => {
      // Verify via the property that the field is named 'timeout'
      // (not e.g. 'connectionTimeout' or 'timeoutIntervalForRequest').
      const opts = TransportOptions.builder().timeout(1000).build();
      expect(opts.timeout).not.toBeNull();
      expect(opts.timeout).toBe(1000);
    });
  });

  test('bhv options 035 setting proxy URL is preserved on read-back', () => {
    const opts = TransportOptions.builder()
      .proxy('http://proxy.example.com:8080')
      .build();
    expect(opts.proxy).toBe('http://proxy.example.com:8080');
  });

  test('bhv options 034 setting proxy is supported on all platforms', () => {
    // Proxy configuration must not throw on any Node.js platform.
    expect(() => {
      TransportOptions.builder().proxy('http://proxy.example.com:8080').build();
    }).not.toThrow();
  });

  describe('string representation', () => {
    const secretHeaders = {
      Authorization: 'Bearer top-secret',
      'Proxy-Authorization': 'Basic abc',
      Cookie: 'sid=top-secret',
      'X-Api-Key': 'top-secret',
      'X-Auth-Token': 'top-secret',
      'X-Client-Secret': 'top-secret',
      'X-Trace': 'visible',
    };

      test('bhv options 023 inspect masks the proxy password and sensitive default headers', () => {
      const renders: Array<[string, (o: TransportOptions) => string]> = [
    ['toString', (o: TransportOptions) => o.toString()],
      ['JSON', (o: TransportOptions) => JSON.stringify(o)],
      ['inspect', (o: TransportOptions) => util.inspect(o)],
      ];
      for (const [, render] of renders) {
        const opts = new TransportOptions({
          ...directOptions,
          proxy: 'http://user:hunter2@proxy.example.com:8080',
          defaultHeaders: secretHeaders,
        });
        const text = render(opts);
        expect(text).not.toContain('hunter2');
        expect(text).not.toContain('top-secret');
        expect(text).not.toContain('Basic abc');
        expect(text).toContain('proxy.example.com');
        expect(text).toContain('visible');
        expect(text).toContain('***');
      }
    });

    test('bhv options 066 a proxy without a password is printed unchanged', () => {
      const opts = new TransportOptions({ ...directOptions, proxy: 'http://proxy.example.com:8080' });
      expect(opts.toString()).toContain('http://proxy.example.com:8080');
    });
  });

  test('bhv options 063 a built options object cannot have its fields changed', () => {
    const opts = TransportOptions.builder().timeout(5000).build();
    expect(() => {
      (opts as { timeout: number | null }).timeout = 1;
    }).toThrow(TypeError);
    expect(opts.timeout).toBe(5000);
  });

  describe('custom fetch', () => {
    const customFetch = (async () => new Response('{}')) as typeof fetch;

    test('bhv options 059 fetch and fetchOptions default to null', () => {
      const opts = TransportOptions.builder().build();
      expect(opts.fetch).toBeNull();
      expect(opts.fetchOptions).toBeNull();
    });

    test('the builder stores the supplied fetch and fetchOptions', () => {
      const opts = TransportOptions.builder().fetch(customFetch).fetchOptions({ keepalive: true }).build();
      expect(opts.fetch).toBe(customFetch);
      expect(opts.fetchOptions).toEqual({ keepalive: true });
    });

    test('bhv options 058 a supplied fetch is kept as the same instance on the built options', () => {
      expect(TransportOptions.builder().fetch(customFetch).build().fetch).toBe(customFetch);
    });

    test('bhv lifecycle 024 a custom fetch combined with a proxy, a custom CA or disabled TLS verification fails fast', () => {
      const combinations: Array<[string, ReturnType<typeof TransportOptions.builder>]> = [
        ['a proxy', TransportOptions.builder().proxy('http://proxy.example.com:8080')],
        ['a custom CA certificate', TransportOptions.builder().caCertPath('/etc/ca.pem')],
        ['disabled TLS verification', TransportOptions.builder().verifySsl(false)],
      ];
      for (const [, builder] of combinations) {
        expect(() => builder.fetch(customFetch).build()).toThrow(TypeError);
      }
    });

    test('bhv transport 078 a custom fetch is refused at construction when a proxy is also configured', () => {
      expect(() => TransportOptions.builder().fetch(customFetch).proxy('http://127.0.0.1:3128').build()).toThrow(TypeError);
    });

    test('bhv options 064 the printable form shows the configured maximum number of retries', () => {
      expect(TransportOptions.builder().maxRetries(5).build().toString()).toContain('"maxRetries":5');
    });

    test('bhv options 065 the printable form never includes the fetch function or option values', () => {
      const opts = TransportOptions.builder().fetch(customFetch).fetchOptions({ credentials: 'secret-mode' }).build();
      expect(opts.toString()).not.toContain('secret-mode');
    });
  });
});
