    const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }));

    await testable.call('GET', '/items', {}, {}, null,
      ['application/json'], 'application/json', null, oauth);

    expect(seen.map((request) => request.url)).toEqual([
      'https://auth.example.com/token',
      'https://api.example.com/items',
    ]);
    expect(seen[1]!.headers['Authorization']).toBe('Bearer per-call-token');
