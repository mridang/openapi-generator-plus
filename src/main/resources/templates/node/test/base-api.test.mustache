  test('bhv serializationwire 014 form-urlencoded body rejects a nested object field with SerializationError', async () => {
    const bodies: Array<[string, unknown]> = [
      ['a nested map', { location: { lat: 1.5 } }],
      ['an array of objects', { location: [{ lat: 1.5 }] }],
    ];
    for (const [, body] of bodies) {
      const client = new CapturingApiClient();
      const config = new Configuration({ baseUrl: 'http://localhost' });
      const testApi = new TestableApi(client, config);
      await expect(
        testApi.call('POST', '/test/echo', {}, {}, body,
          ['application/json'], 'application/x-www-form-urlencoded', null),
      ).rejects.toThrow(new SerializationError('form-urlencoded field location must be a scalar or array of scalars'));
      expect(client.capturedBody).toBeNull();
    }
  });

  test('bhv serializationwire 011 a null optional form field is omitted', async () => {
    const client = new CapturingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    await testApi.call('POST', '/test/echo', {}, {}, { name: 'a', tag: null },
      ['application/json'], 'application/x-www-form-urlencoded', null);
    expect(client.capturedBody).toBe('name=a');
  });

  test('bhv serializationwire 013 form-urlencoded body keeps a well-formed surrogate pair', async () => {
    const client = new CapturingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    await testApi.call('POST', '/test/echo', {}, {}, { name: '😀' },
      ['application/json'], 'application/x-www-form-urlencoded', null);
    expect(client.capturedBody).toBe('name=%F0%9F%98%80');
  });

  test('bhv operations 014 passes binary body as-is', async () => {
    const client = new CapturingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const buf = Buffer.from([0x01, 0x02, 0x03]);
    await testApi.call('POST', '/test/echo', {}, {}, buf,
      ['application/json'], 'application/octet-stream', null);
    expect(client.capturedBody).toBeDefined();
  });

  // Optional request-content-type selector. setPetAvatar declares THREE
  // request content-types (image/jpeg, image/png, application/json). Without a
  // selector the operation collapses to the first declared type and the others
  // are unreachable. The new OPTIONAL trailing `contentType` parameter lets the
  // caller pick among the declared types; omitting it keeps the first declared
  // type (image/jpeg) for backward compatibility. image/jpeg and image/png
  // share the same raw-binary body, so the same payload is reused for both.
  test('bhv operations 071 setPetAvatar honours the selected request content type', async () => {
    const payload = Buffer.from([0xFF, 0xD8, 0xFF, 0xE0]);

    // (1) No selector -> first declared content-type (image/jpeg), unchanged.
    const defaultClient = new CapturingApiClient();
    const defaultApi = new PetApi(
      defaultClient,
      new Configuration({ baseUrl: 'http://localhost' }),
    );
    try {
      await defaultApi.setPetAvatar(1, payload);
    } catch {
      // setPetAvatar returns void; the capturing client returns '{}' so nothing
      // should throw, but stay capture-only regardless.
    }
    expect(defaultClient.capturedHeaders['Content-Type']).toBe('image/jpeg');

    // (2) Selector set to image/png with the same bytes -> image/png header.
    const pngClient = new CapturingApiClient();
    const pngApi = new PetApi(
      pngClient,
      new Configuration({ baseUrl: 'http://localhost' }),
    );
    try {
      await pngApi.setPetAvatar(1, payload, 'image/png');
    } catch {
      // capture-only, as above.
    }
    expect(pngClient.capturedHeaders['Content-Type']).toBe('image/png');
    expect(pngClient.capturedHeaders['Content-Type']).not.toBe('image/jpeg');
  });

  // Octet-stream raw-body parity. uploadPetDocument declares TWO request
  // content-types: multipart/form-data AND application/octet-stream. The
  // multipart variant carries the binary file plus scalar companion fields
  // (documentType, notes); the octet-stream variant is a single raw binary
  // body. Selecting application/octet-stream MUST send the file's RAW bytes
  // with Content-Type: application/octet-stream — never a multipart envelope,
  // never a boundary, never base64. The bug this guards against: the operation
  // always assembled a formBody Record, and the transport turns any plain
  // object into multipart regardless of the chosen Content-Type, so an
  // octet-stream selection silently degraded to multipart/form-data. The
  // CapturingApiClient records exactly what BaseApi hands the transport, so we
  // assert on the body's runtime type (Buffer vs Record) and the header.
  test('uploadPetDocument sends raw bytes when application/octet-stream is selected', async () => {
    const payload = Buffer.from([0x25, 0x50, 0x44, 0x46, 0x2d]); // "%PDF-"

    // (1) application/octet-stream -> RAW bytes, octet-stream Content-Type.
    const rawClient = new CapturingApiClient();
    const rawApi = new PetApi(
      rawClient,
      new Configuration({ baseUrl: 'http://localhost' }),
    );
    await rawApi.uploadPetDocument(
      1,
      { file: payload },
      'application/octet-stream',
    );
    // The wire body is the raw Buffer, byte-for-byte — not a Record, not
    // multipart, not base64.
    expect(Buffer.isBuffer(rawClient.capturedBody)).toBe(true);
    expect(Buffer.from(rawClient.capturedBody as Buffer)).toEqual(payload);
    // The declared octet-stream Content-Type reaches the transport intact.
    expect(rawClient.capturedHeaders['Content-Type']).toBe(
      'application/octet-stream',
    );
    // Hard negative: no multipart envelope leaked through. A multipart body
    // would arrive as a plain Record (object), and the per-part boundary
    // markers / Content-Disposition lines would appear once encoded.
    expect(
      typeof rawClient.capturedBody === 'object' &&
        !Buffer.isBuffer(rawClient.capturedBody),
    ).toBe(false);
    const rawAsText = Buffer.from(rawClient.capturedBody as Buffer).toString(
      'latin1',
    );
    expect(rawAsText).not.toContain('Content-Disposition');
    expect(rawAsText).not.toContain('boundary');
    expect(rawAsText).not.toContain('form-data');

    // (2) Over-correction guard: selecting multipart/form-data (and omitting
    // the selector, which defaults to the first declared type) must still
    // build a multipart body. At the BaseApi boundary that is a plain Record
    // of the form fields; the transport encodes it into a multipart envelope
    // with a generated boundary downstream.
    const multipartClient = new CapturingApiClient();
    const multipartApi = new PetApi(
      multipartClient,
      new Configuration({ baseUrl: 'http://localhost' }),
    );
    await multipartApi.uploadPetDocument(
      1,
      { file: payload, documentType: 'health_certificate', notes: 'annual' },
      'multipart/form-data',
    );
    expect(Buffer.isBuffer(multipartClient.capturedBody)).toBe(false);
    expect(typeof multipartClient.capturedBody).toBe('object');
    const multipartBody = multipartClient.capturedBody as Record<
      string,
      unknown
    >;
    expect(multipartBody['file']).toBeDefined();
    expect(multipartBody['documentType']).toBe('health_certificate');
    expect(multipartBody['notes']).toBe('annual');

    // (3) Default (selector omitted) -> first declared type, also multipart.
    const defaultClient = new CapturingApiClient();
    const defaultApi = new PetApi(
      defaultClient,
      new Configuration({ baseUrl: 'http://localhost' }),
    );
    await defaultApi.uploadPetDocument(1, { file: payload });
    expect(Buffer.isBuffer(defaultClient.capturedBody)).toBe(false);
    expect(typeof defaultClient.capturedBody).toBe('object');
  });
});

describe('BaseApi content-type deserialization guard', () => {
  test('bhv serializationwire 025 skips JSON deserialization when Content-Type is text/plain', async () => {
    const client = new CapturingApiClient();
    client.responseBody = 'hello';
    client.responseHeaders = { 'content-type': 'text/plain' };
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const result = await testApi.call('GET', '/test/echo', {}, {}, null,
      ['text/plain'], 'application/json',
      (json) => json as string, undefined, 'string');
    expect(result).toBe('hello');
  });

  test('bhv errors 035 rejects a text/plain body for a model return with a SerializationError naming the Content-Type', async () => {
    const client = new CapturingApiClient();
    client.responseBody = 'hello';
    client.responseHeaders = { 'content-type': 'text/plain' };
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const error = await testApi
      .call('GET', '/test/echo', {}, {}, null,
        ['application/json'], 'application/json',
        (json) => json as { id: number }, undefined, 'model')
      .catch((e: unknown) => e);
    expect(error).toBeInstanceOf(SerializationError);
    expect((error as SerializationError).message).toBe(
      "Unexpected response Content-Type 'text/plain' for TestableApi.testOperation: expected a JSON body"
    );
  });

  test('bhv errors 054 an unexpected content type error names the operation rather than the HTTP verb', async () => {
    const client = new CapturingApiClient();
    client.responseBody = 'hello';
    client.responseHeaders = { 'content-type': 'text/plain' };
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const error = await testApi
      .call('GET', '/test/echo', {}, {}, null, ['application/json'], 'application/json', (json) => json as { id: number }, undefined, 'model')
      .catch((e: unknown) => e);
    expect((error as Error).message).toContain('for TestableApi.testOperation:');
    expect((error as Error).message).not.toContain('GET');
  });

  test('bhv errors 205 a response body that cannot be decoded raises an error carrying the status, headers, raw body and request', async () => {
    const client = new CapturingApiClient();
    client.responseStatus = 203;
    client.responseBody = 'hello';
    client.responseHeaders = { 'content-type': 'text/plain', 'x-request-id': 'req-1' };
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const error = await testApi
      .call('GET', '/test/echo', { page: '2' }, {}, null,
        ['application/json'], 'application/json',
        (json) => json as { id: number }, undefined, 'model')
      .catch((e: unknown) => e);
    expect(error).toBeInstanceOf(SerializationError);
    const decode = error as SerializationError;
    expect(decode.statusCode).toBe(203);
    expect(decode.responseHeaders).toEqual({ 'content-type': 'text/plain', 'x-request-id': 'req-1' });
    expect(decode.responseBody).toBe('hello');
    expect(decode.requestMethod).toBe('GET');
    expect(decode.requestPath).toBe('/test/echo');
    expect(decode.message).toContain("Unexpected response Content-Type 'text/plain'");
  });

  test('bhv serializationwire 005 deserializes vendor JSON MIME types like application/problem+json', async () => {
    const client = new CapturingApiClient();
    client.responseBody = '{"title":"Not Found"}';
    client.responseHeaders = { 'content-type': 'application/problem+json' };
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    const result = await testApi.call('GET', '/test/echo', {}, {}, null,
      ['application/json'], 'application/json',
      (json) => json as { title: string });
    expect(result).toBeDefined();
    expect((result as { title: string }).title).toBe('Not Found');
  });
});

