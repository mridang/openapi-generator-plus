  test('bhv serialization 009 a value that cannot be serialized raises SerializationError before any request', async () => {
    const client = new CapturingApiClient();
    const testApi = new TestableApi(client, new Configuration({ baseUrl: 'http://localhost' }));
    await expect(
      testApi.call('POST', '/test/echo', {}, {}, { count: BigInt(1) },
        ['application/json'], 'application/json', null),
    ).rejects.toThrow(SerializationError);
    expect(client.capturedUrl).toBe('');
