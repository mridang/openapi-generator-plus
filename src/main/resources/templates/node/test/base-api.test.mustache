  test('bhv serialization 007 a literal plus sign is sent as %2B and non-ASCII text as UTF-8 bytes', async () => {
    const client = new CapturingApiClient();
    const testApi = new TestableApi(client, new Configuration({ baseUrl: 'http://localhost' }));
    await testApi.call('POST', '/test/echo', {}, {}, { q: 'a+bé' },
