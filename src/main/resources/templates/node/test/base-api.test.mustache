  describe('a 401 on an OAuth2 call', () => {
    const tokenUrl = 'https://auth.example.com/token';

    /* A token endpoint that issues tok-1, tok-2, ... and an API that accepts only the latest token. */
    function renewingServer(apiStatus: (authorization: string | undefined) => number) {
      const seen: Array<{ url: string; authorization: string | undefined }> = [];
      let issued = 0;
      const stub: ApiClient = {
        async sendRequest(_method, url, headers): Promise<ApiHttpResponse> {
          seen.push({ url, authorization: headers['Authorization'] });
          if (url === tokenUrl) {
            issued += 1;
            return {
              statusCode: 200,
              body: JSON.stringify({ access_token: `tok-${issued}`, expires_in: 3600 }),
              headers: { 'content-type': 'application/json' }
            };
          }
          return { statusCode: apiStatus(headers['Authorization']), body: '{}', headers: { 'content-type': 'application/json' } };
        }
      };
      return { seen, stub };
    }

    /* The client injects its transport into the authenticator it was built
     * with; the test does the same with its stub. */
    const oauth = (stub: ApiClient) => {
      const authenticator = new OAuth2ClientCredentialsAuthenticator(
        'https://api.example.com', 'client-id', 'client-secret', tokenUrl, []);
      authenticator.setApiClient(stub);
      return authenticator;
    };

    test('bhv retries 001 drops the cached token and replays the request once with the new one', async () => {
      const { seen, stub } = renewingServer((authorization) => (authorization === 'Bearer tok-1' ? 401 : 200));
      const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }), oauth(stub));

      await testable.call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null);

      expect(seen).toEqual([
        { url: tokenUrl, authorization: undefined },
        { url: 'https://api.example.com/items', authorization: 'Bearer tok-1' },
        { url: tokenUrl, authorization: undefined },
        { url: 'https://api.example.com/items', authorization: 'Bearer tok-2' }
      ]);
    });

    test('bhv retries 008 reports a second 401 as the usual Unauthorized error after exactly one replay', async () => {
      const { seen, stub } = renewingServer(() => 401);
      const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }), oauth(stub));

      const error = await testable
        .call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null)
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(UnauthorizedError);
      expect(seen.filter((request) => request.url !== tokenUrl)).toHaveLength(2);
    });

    test('bhv retries 002 a bearer authenticator never replays a 401', async () => {
      const seen: Array<string | undefined> = [];
      const stub: ApiClient = {
        async sendRequest(_method, _url, headers): Promise<ApiHttpResponse> {
          seen.push(headers['Authorization']);
          return { statusCode: 401, body: '{}', headers: { 'content-type': 'application/json' } };
        }
      };
      const testable = new TestableApi(
        stub,
        new Configuration({ baseUrl: 'https://api.example.com' }),
        new BearerAuthenticator('https://api.example.com', 'fixed')
      );

      const error = await testable
        .call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null)
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(UnauthorizedError);
      expect(seen).toHaveLength(1);
    });

    test('bhv retries 006 does not replay a multipart body', async () => {
      const { seen, stub } = renewingServer(() => 401);
      const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }), oauth(stub));

      const error = await testable
        .call('POST', '/items', {}, {}, { field: 'value' }, ['application/json'], 'multipart/form-data', null)
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(UnauthorizedError);
      expect(seen.map((request) => request.url)).toEqual([tokenUrl, 'https://api.example.com/items']);
    });

    test('bhv authintegration 001 keeps the 401 when the new token cannot be obtained', async () => {
      let tokenCalls = 0;
      const stub: ApiClient = {
        async sendRequest(_method, url): Promise<ApiHttpResponse> {
          if (url === tokenUrl) {
            tokenCalls += 1;
            return tokenCalls === 1
              ? { statusCode: 200, body: JSON.stringify({ access_token: 'tok-1', expires_in: 3600 }), headers: {} }
              : { statusCode: 400, body: JSON.stringify({ error: 'invalid_client' }), headers: {} };
          }
          return { statusCode: 401, body: '{}', headers: { 'content-type': 'application/json' } };
        }
      };
      const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }), oauth(stub));

      const error = await testable
        .call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null)
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(UnauthorizedError);
    });

    test.each([
      ['bearer', () => new BearerAuthenticator('https://api.example.com', 'fixed')],
      ['api key', () => new ApiKeyAuthenticator('https://api.example.com', 'X-Key', 'fixed', ApiKeyLocation.HEADER)]
    ])('is never replayed for a %s authenticator', async (_name, make) => {
      let calls = 0;
      const stub: ApiClient = {
        async sendRequest() {
          calls += 1;
          return { statusCode: 401, body: '{}', headers: { 'content-type': 'application/json' } };
        }
      };
      const testable = new TestableApi(stub, new Configuration({ baseUrl: 'https://api.example.com' }), make());

      const error = await testable
        .call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null)
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(UnauthorizedError);
      expect(calls).toBe(1);
    });
  });

  /*
   * AUTH-APPLIED (Wave A1): a CONFIGURED authenticator must actually be
   * applied to the outbound request of a secured operation. This is the
   * regression guard for the Elixir bug where a configured authenticator
   * was silently dropped, so the credential never reached the wire.
   *
   * Unlike the stub-based `forwards auth headers` test above, this uses the
   * REAL BearerAuthenticator and goes through the mock echo server, which
   * reflects the received request headers back in its JSON body. We assert
   * the echoed Authorization header carries the exact Bearer credential.
   */
  test('bhv authintegration 006 configured Bearer authenticator credential reaches the outbound request', async () => {
    const auth = new BearerAuthenticator(chasmUrl, 'secret-token-123');
    const result = await api().call('GET', '/test/echo', {}, {}, null,
      ['application/json'], 'application/json',
      (json) => json as { headers: Record<string, string> }, auth);
    expect(result).toBeDefined();
    expect((result as { headers: Record<string, string> }).headers['authorization'])
      .toBe('Bearer secret-token-123');
  });

  test('bhv authintegration 018 a configured client authenticator is applied to a secured operation', async () => {
    const clientAuth = new BearerAuthenticator(chasmUrl, 'client-token-456');
    const configured = new TestableApi(
      new DefaultApiClient(TransportOptions.builder().maxRetries(0).build()),
      new Configuration({ baseUrl: chasmUrl }),
      clientAuth
    );
    const result = await configured.call('GET', '/test/echo', {}, {}, null,
      ['application/json'], 'application/json',
      (json) => json as { headers: Record<string, string> });
    expect((result as { headers: Record<string, string> }).headers['authorization'])
      .toBe('Bearer client-token-456');
  });

  test('bhv authintegration 019 an invalid auth cookie fails the call before any request is sent', async () => {
    const capturing = new CapturingApiClient();
    const auth = new TestAuthenticator({}, {}, { session: 'a;b' });
    const error = await new TestableApi(capturing, new Configuration({ baseUrl: 'https://api.example.com' }))
      .call('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null, auth)
      .catch((e: unknown) => e);
    expect(error).toBeInstanceOf(TypeError);
    expect(capturing.capturedUrl).toBe('');
  });
});

