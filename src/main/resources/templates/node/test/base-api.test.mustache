    const testApi = new TestableApi(client, config);
    await testApi.call('POST', '/test/echo', {}, {}, { nickname: "a~b*c!d'e(f)g" },
      ['application/json'], 'application/x-www-form-urlencoded', null);
    expect(client.capturedBody).toBe('nickname=a~b%2Ac%21d%27e%28f%29g');
  });

  test.each([
    ['a value', { name: 'a\uD800b' }],
    ['a key', { 'k\uDC00': 'v' }],
    ['an array item', { names: ['ok', 'a\uD800'] }],
  ])('form-urlencoded body rejects a lone surrogate in %s with URIError', async (_label, body) => {
    const client = new CapturingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config);
    await expect(
      testApi.call('POST', '/test/echo', {}, {}, body,
        ['application/json'], 'application/x-www-form-urlencoded', null),
