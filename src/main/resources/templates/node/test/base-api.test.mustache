class CapturingApiClient implements ApiClient {
  capturedUrl = '';
  capturedHeaders: Record<string, string> = {};
  capturedBody: string | Buffer | Record<string, unknown> | null = null;
  responseBody = '{}';
  responseStatus = 200;
  responseHeaders: Record<string, string> = { 'content-type': 'application/json' };
  async sendRequest(method: string, url: string, headers: Record<string, string>, body: string | Buffer | Record<string, unknown> | null): Promise<ApiHttpResponse> {
    this.capturedUrl = url;
    this.capturedHeaders = headers;
    this.capturedBody = body;
    return { statusCode: this.responseStatus, body: this.responseBody, headers: this.responseHeaders };
  }
}

class TestableApi extends BaseApi {
  constructor(
    apiClient?: ApiClient,
    config?: Configuration,
    authenticator?: Authenticator | null,
    schemeAuthenticators?: Readonly<Record<string, Authenticator>> | null
  ) {
    super(apiClient, config, authenticator, schemeAuthenticators);
  }

  resolve(schemes: readonly string[]): Authenticator | undefined {
    return this.resolveSchemeAuth(schemes);
  }

  async call<T>(
    method: string,
    path: string,
    queryParams: Record<string, unknown>,
    headerParams: Record<string, string>,
    body: unknown,
    accepts: string[],
    contentType: string,
    returnType: ((json: unknown) => T) | null,
    auth?: Authenticator | null,
    returnKind?: 'model' | 'string' | 'binary'
  ): Promise<T | void> {
    return this.invokeApi(
      method, path, queryParams, headerParams, body,
      accepts, contentType, returnType, auth, false, returnKind, 'testOperation');
  }

  async callForResult<T>(
    method: string,
    path: string,
    queryParams: Record<string, unknown>,
    headerParams: Record<string, string>,
    body: unknown,
    accepts: string[],
    contentType: string,
    returnType: ((json: unknown) => T) | null,
    auth?: Authenticator | null,
    requestOptions?: RequestOptions,
    operationId?: string,
    urlTemplate?: string
  ): Promise<ApiResult<T>> {
    return this.invokeApiForResult(
      method, path, queryParams, headerParams, body,
      accepts, contentType, returnType, auth, false, undefined, '', requestOptions, undefined, operationId, urlTemplate);
  }
}

class TestAuthenticator implements Authenticator {
  constructor(
    private headers: Record<string, string> = {},
    private queryParams: Record<string, string> = {},
    private cookies: Record<string, string> = {}
  ) {}

  getHost(): string { return ''; }
  getAuthHeaders(): Record<string, string> { return this.headers; }
  getAuthHeadersAsync(): Promise<Record<string, string>> { return Promise.resolve(this.headers); }
  getQueryParams(): Record<string, string> { return this.queryParams; }
  getCookieParams(): Record<string, string> { return this.cookies; }
}

const chasmUrl = process.env.CHASM_HTTP_URL!;

function api(): TestableApi {
  const config = new Configuration({ baseUrl: chasmUrl });
  return new TestableApi(new DefaultApiClient(TransportOptions.builder().maxRetries(0).build()), config);
}

/* The first request to a freshly started container can fail with a connection
 * error before its port is serving. Warm the connection up once, retrying, so
 * no test below observes that cold start. */
beforeAll(async () => {
  for (let attempt = 0; attempt < 10; attempt++) {
    try {
      await fetch(`${chasmUrl}/test/status/404`);
      return;
    } catch {
      await new Promise((resolve) => setTimeout(resolve, 200));
    }
  }
}, 30_000);

describe('BaseApi', () => {
  const cases: [number, new (...args: never[]) => ApiError][] = [
    [400, BadRequestError],
    [401, UnauthorizedError],
    [403, ForbiddenError],
    [404, NotFoundError],
    [409, ConflictError],
    [422, UnprocessableEntityError],
    [429, TooManyRequestsError],
    [418, ClientError],
    [500, InternalServerError],
    [502, BadGatewayError]
  ];

  test.each(cases)('bhv errors 037 status %i throws correct exception', async (status, ErrorClass) => {
    try {
      await api().call('GET', `/test/status/${status}`, {}, {}, null,
        ['application/json'], 'application/json', null);
      fail('Expected error not thrown');
    } catch (e) {
      expect(e).toBeInstanceOf(ErrorClass);
      expect((e as Error).constructor).toBe(ErrorClass);
      expect((e as ApiError).statusCode).toBe(status);
      expect((e as ApiError).responseBody).toBeTruthy();
    }
  });

  test('bhv errors 071 a 401 response surfaces as an UnauthorizedError', async () => {
    const error = await api()
      .call('GET', '/test/status/401', {}, {}, null, ['application/json'], 'application/json', null)
      .then(() => undefined, (e: unknown) => e);

    expect((error as Error).constructor).toBe(UnauthorizedError);
    expect((error as ApiError).statusCode).toBe(401);
  });
});

