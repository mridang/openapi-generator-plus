describe('request cancellation against the slow endpoint', () => {
  const slow = (testApi: TestableApi, requestOptions?: RequestOptions): Promise<unknown> =>
    testApi
      .callForResult('GET', `${chasmUrl}/test/slow`, {}, {}, null, ['application/json'], 'application/json', null, undefined, requestOptions)
      .catch((e: unknown) => e);

  test('a per-call signal aborts the in-flight request with an AbortError', async () => {
    const controller = new AbortController();
    const testApi = new TestableApi(new DefaultApiClient(), Configuration.defaultConfiguration());
    const pending = slow(testApi, { signal: controller.signal });
    setTimeout(() => controller.abort(), 100);
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
    expect(error).not.toBeInstanceOf(NetworkTimeoutError);
  }, 15000);

  test('bhv auth 013 cancelling a call reports the cancellation without waiting for the token endpoint', async () => {
    class StalledBearer extends BearerAuthenticator {
      override getAuthHeadersAsync(): Promise<Record<string, string>> {
        return new Promise<Record<string, string>>(() => undefined);
      }
    }
    const controller = new AbortController();
    const testApi = new TestableApi(
      new DefaultApiClient(),
      Configuration.defaultConfiguration(),
      new StalledBearer('http://localhost', 'token-013')
    );
    const pending = slow(testApi, { signal: controller.signal });
    setTimeout(() => controller.abort(), 100);
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
  }, 15000);

  test('an already aborted per-call signal rejects without waiting', async () => {
    const testApi = new TestableApi(new DefaultApiClient(), Configuration.defaultConfiguration());
    const error = await slow(testApi, { signal: AbortSignal.abort() });
    expect((error as Error).name).toBe('AbortError');
  });

  test('a client-level signal aborts the in-flight request with an AbortError', async () => {
    const controller = new AbortController();
    const config = Configuration.builder().signal(controller.signal).build();
    const testApi = new TestableApi(new DefaultApiClient(), config);
    const pending = slow(testApi);
    setTimeout(() => controller.abort(), 100);
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
    expect(error).not.toBeInstanceOf(NetworkTimeoutError);
  }, 15000);

  test('either the client-level or the per-call signal cancels the merged request', async () => {
    const clientController = new AbortController();
    const callController = new AbortController();
    const config = Configuration.builder().signal(clientController.signal).build();
    const testApi = new TestableApi(new DefaultApiClient(), config);
    const pending = slow(testApi, { signal: callController.signal });
    setTimeout(() => callController.abort(), 100);
    const error = await pending;
    expect((error as Error).name).toBe('AbortError');
    expect(clientController.signal.aborted).toBe(false);
  }, 15000);

  test('the timeout still raises NetworkTimeoutError when no signal fires', async () => {
    const transport = TransportOptions.builder().timeout(300).build();
    const testApi = new TestableApi(new DefaultApiClient(transport), Configuration.defaultConfiguration());
    const error = await slow(testApi, { signal: new AbortController().signal });
    expect(error).toBeInstanceOf(NetworkTimeoutError);
  }, 15000);
});

class RecordingApiClient implements ApiClient {
  statusCode = 200;
  method = '';
  url = '';
  headers: Record<string, string> = {};
  sendOptions: SendRequestOptions | undefined;
  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    _body: string | Buffer | Record<string, unknown> | null,
    options?: SendRequestOptions
  ): Promise<ApiHttpResponse> {
    this.method = method;
    this.url = url;
    this.headers = { ...headers };
    this.sendOptions = options;
    return { statusCode: this.statusCode, body: '{}', headers: { 'content-type': 'application/json' } };
  }
}

describe('BaseApi error request context', () => {
  const fail = async (client: RecordingApiClient, method: string, path: string, baseUrl = 'http://localhost'): Promise<ApiError> => {
    const testApi = new TestableApi(client, new Configuration({ baseUrl }));
    try {
      await testApi.callForResult(method, path, { page: '2' }, {}, null, ['application/json'], 'application/json', null);
    } catch (e) {
      return e as ApiError;
    }
    throw new Error('expected the call to fail');
  };

  test('bhv errors 036 the error carries the method and the path without the query string', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 404;
    const err = await fail(client, 'GET', '/items/7');
    expect(err).toBeInstanceOf(NotFoundError);
    expect(err.requestMethod).toBe('GET');
    expect(err.requestPath).toBe('/items/7');
    expect(client.url).toBe('http://localhost/items/7?page=2');
  });

  test('bhv errors 027 the path keeps the base path of the server and drops the host', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 500;
    const err = await fail(client, 'POST', '/items', 'https://api.example.com/v3');
    expect(err.requestMethod).toBe('POST');
    expect(err.requestPath).toBe('/v3/items');
  });

  test('bhv errors 026 the rendered request line never carries the query string', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 404;
    const err = await fail(client, 'GET', '/items/7');
    expect(err.requestPath).not.toContain('?');
    expect(err.toString()).toContain('\nRequest: GET /items/7\n');
    expect(err.toString()).not.toContain('page=2');
  });

  test('bhv errors 048 418 throws ClientError', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 418;
    const err = await fail(client, 'GET', '/items/7');
    expect(err).toBeInstanceOf(ClientError);
  });

  test('a relative base URL gives the path without the query string', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 418;
    const err = await fail(client, 'PUT', '/items/7', '/api/v3');
    expect(err.requestPath).toBe('/api/v3/items/7');
  });

  test('the rendered message names the request', async () => {
    const client = new RecordingApiClient();
    client.statusCode = 503;
    const err = await fail(client, 'DELETE', '/items/7');
    expect(err.toString()).toBe('API returned status code 503\nHTTP status code: 503\nRequest: DELETE /items/7\nResponse headers: {"content-type":"application/json"}\nResponse body: {}');
  });
});

describe('BaseApi per-call request options', () => {
  const send = async (client: RecordingApiClient, requestOptions?: RequestOptions, config?: Configuration, headerParams: Record<string, string> = {}): Promise<void> => {
    const testApi = new TestableApi(client, config ?? new Configuration({ baseUrl: 'http://localhost' }));
    await testApi.callForResult('GET', '/items', {}, headerParams, null, ['application/json'], 'application/json', null, undefined, requestOptions);
  };

  test('without per-call options the transport defaults apply', async () => {
    const client = new RecordingApiClient();
    await send(client);
    expect(client.sendOptions?.timeout).toBeUndefined();
    expect(client.sendOptions?.maxRetries).toBeUndefined();
  });

  test('bhv retries 009 timeout and maxRetries reach the transport', async () => {
    const client = new RecordingApiClient();
    await send(client, { timeout: 250, maxRetries: 0 });
    expect(client.sendOptions?.timeout).toBe(250);
    expect(client.sendOptions?.maxRetries).toBe(0);
  });

  test('bhv options 053 per-call options take effect on that one call only', async () => {
    const client = new RecordingApiClient();
    await send(client, { timeout: 250, maxRetries: 0 });
    expect(client.sendOptions?.timeout).toBe(250);
    await send(client);
    expect(client.sendOptions?.timeout).toBeUndefined();
    expect(client.sendOptions?.maxRetries).toBeUndefined();
  });

  test('bhv options 055 a call without per-call options leaves the client default headers in force', async () => {
    const client = new RecordingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost', defaultHeaders: { 'X-Region': 'default' } });
    await send(client, undefined, config);
    expect(client.headers['X-Region']).toBe('default');
    expect(client.sendOptions?.timeout).toBeUndefined();
  });

  test('bhv options 056 a per-call timeout of zero or less, or a negative retry count, is refused before any request is sent', async () => {
    const client = new RecordingApiClient();
    await expect(send(client, { timeout: 0 })).rejects.toThrow(/Invalid timeout/);
    await expect(send(client, { maxRetries: -1 })).rejects.toThrow(/Invalid maxRetries/);
    expect(client.url).toBe('');
  });

  test('bhv options 057 a per-call timeout below one millisecond is refused', async () => {
    await expect(send(new RecordingApiClient(), { timeout: 0.5 })).rejects.toThrow(/Invalid timeout/);
  });

  test('bhv transport 002 a null timeout reaches the transport as no timeout', async () => {
    const client = new RecordingApiClient();
    await send(client, { timeout: null });
    expect(client.sendOptions?.timeout).toBeNull();
  });

  test.each([[0], [-1], [Number.NaN]])('a timeout of %s is refused', async (timeout) => {
    await expect(send(new RecordingApiClient(), { timeout })).rejects.toThrow(/Invalid timeout/);
  });

  test.each([[-1], [1.5], [Number.NaN]])('maxRetries of %s is refused', async (maxRetries) => {
    await expect(send(new RecordingApiClient(), { maxRetries })).rejects.toThrow(/Invalid maxRetries/);
  });

  test('bhv authintegration 011 the call is not sent when an option is refused', async () => {
    const client = new RecordingApiClient();
    await expect(send(client, { maxRetries: -1 })).rejects.toThrow(TypeError);
    expect(client.url).toBe('');
  });

  test('bhv operations 158 per-call headers are sent', async () => {
    const client = new RecordingApiClient();
    await send(client, { headers: { 'X-Trace-Id': 'abc' } });
    expect(client.headers['X-Trace-Id']).toBe('abc');
  });

  test('bhv operations 001 a per-call header replaces a default or operation header of the same name, whatever its case', async () => {
    const client = new RecordingApiClient();
    const config = new Configuration({ baseUrl: 'http://localhost', defaultHeaders: { 'X-Region': 'default' } });
    await send(client, { headers: { 'x-region': 'call', 'x-op': 'call' } }, config, { 'X-Op': 'operation' });
    expect(client.headers['x-region']).toBe('call');
    expect(client.headers['X-Region']).toBeUndefined();
    expect(client.headers['x-op']).toBe('call');
    expect(client.headers['X-Op']).toBeUndefined();
  });

  test('bhv retries 005 per-call headers never replace the authentication headers', async () => {
    const client = new RecordingApiClient();
    const testApi = new TestableApi(client, new Configuration({ baseUrl: 'http://localhost' }), new TestAuthenticator({ Authorization: 'Bearer real' }));
    await testApi.callForResult('GET', '/items', {}, {}, null, ['application/json'], 'application/json', null, undefined, { headers: { Authorization: 'Bearer spoofed' } });
    expect(client.headers['Authorization']).toBe('Bearer real');
  });

  test('per-call header names are treated as credential headers on a redirect', async () => {
    const client = new RecordingApiClient();
    await send(client, { headers: { 'X-Call-Token': 'abc' } });
    expect(client.sendOptions?.credentialHeaderNames).toContain('X-Call-Token');
  });

  test('a per-call header with a non-string value is refused', async () => {
    const headers = { 'X-Count': 3 } as unknown as Record<string, string>;
    await expect(send(new RecordingApiClient(), { headers })).rejects.toThrow(/Invalid per-call header/);
  });
});

/*
 * OpenTelemetry is loaded the way trace-context-util loads it (see the note in
 * trace-context-util.test), so a span started here is the one the SDK reads.
 */
const traceLoadModule: (id: string) => unknown =
  typeof require === 'function'
    ? require
    : (
        globalThis as unknown as {
          process: {
            getBuiltinModule: (id: string) => {
              createRequire: (path: string) => (id: string) => unknown;
            };
            cwd: () => string;
          };
        }
      ).process
        .getBuiltinModule('node:module')
        .createRequire(`${process.cwd()}/`);

const { context: otelContext, propagation: otelPropagation } = traceLoadModule(
  '@opentelemetry/api',
) as typeof import('@opentelemetry/api');
const { AsyncLocalStorageContextManager } = traceLoadModule(
  '@opentelemetry/context-async-hooks',
) as typeof import('@opentelemetry/context-async-hooks');
const { W3CTraceContextPropagator } = traceLoadModule(
  '@opentelemetry/core',
) as typeof import('@opentelemetry/core');
const { BasicTracerProvider, InMemorySpanExporter, SimpleSpanProcessor } = traceLoadModule(
  '@opentelemetry/sdk-trace-base',
) as typeof import('@opentelemetry/sdk-trace-base');

class SlowAuthenticator extends TestAuthenticator {
  async getAuthHeadersAsync(): Promise<Record<string, string>> {
    await new Promise<void>((resolve) => setTimeout(resolve, 20));
    return {};
  }
}

describe('BaseApi trace context', () => {
  const tracer = new BasicTracerProvider({
    spanProcessors: [new SimpleSpanProcessor(new InMemorySpanExporter())],
  }).getTracer('base-api-trace-test');

  beforeAll(() => {
    otelContext.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());
    otelPropagation.setGlobalPropagator(new W3CTraceContextPropagator());
  });

  afterAll(() => {
    otelContext.disable();
    otelPropagation.disable();
  });

  const traceparentOf = (span: { spanContext(): { traceId: string; spanId: string; traceFlags: number } }): string => {
    const spanContext = span.spanContext();
    return `00-${spanContext.traceId}-${spanContext.spanId}-${spanContext.traceFlags.toString(16).padStart(2, '0')}`;
  };

  const callEcho = async (client: CapturingApiClient, auth?: Authenticator): Promise<void> => {
    const config = new Configuration({ baseUrl: 'http://localhost' });
    const testApi = new TestableApi(client, config, auth);
    await testApi.call('GET', '/test/echo', {}, {}, null, ['application/json'], 'application/json', null);
  };

  test('bhv tracing 013 an operation sends the traceparent of the span active in the caller context', async () => {
    const client = new CapturingApiClient();
    await tracer.startActiveSpan('caller', async (span) => {
      await callEcho(client);
      expect(client.capturedHeaders['traceparent']).toBe(traceparentOf(span));
      span.end();
    });
  });

  test('bhv tracing 014 the span still reaches traceparent when building the headers first waits on the credentials', async () => {
    const client = new CapturingApiClient();
    await tracer.startActiveSpan('caller', async (span) => {
      await callEcho(client, new SlowAuthenticator());
      expect(client.capturedHeaders['traceparent']).toBe(traceparentOf(span));
      span.end();
    });
  });

  test('bhv tracing 015 concurrent operations each send the traceparent of their own caller span', async () => {
    const results = await Promise.all(
      [0, 1, 2, 3].map((index) =>
        tracer.startActiveSpan(`caller-${index}`, async (span) => {
          const client = new CapturingApiClient();
          await callEcho(client, new SlowAuthenticator());
          span.end();
          return { sent: client.capturedHeaders['traceparent'], expected: traceparentOf(span) };
        }),
      ),
    );
    for (const { sent, expected } of results) {
      expect(sent).toBe(expected);
    }
    expect(new Set(results.map((result) => result.sent)).size).toBe(4);
  });

  test('bhv tracing 016 an operation with no active span sends no traceparent after an earlier call had one', async () => {
    const client = new CapturingApiClient();
    await tracer.startActiveSpan('caller', async (span) => {
      await callEcho(client);
      span.end();
    });
    expect(client.capturedHeaders['traceparent']).toBeDefined();
    await callEcho(client);
    expect(client.capturedHeaders['traceparent']).toBeUndefined();
  });
});

describe('BaseApi call hook', () => {
  const base = 'https://api.example.com';
  const json = { 'content-type': 'application/json' };

  interface Sent {
    method: string;
    url: string;
    headers: Record<string, string>;
  }

  /* A transport that records every send and answers from a script, the last step repeating. */
  function scripted(...steps: Array<{ status: number; body?: string; headers?: Record<string, string> } | Error>): { client: ApiClient; sent: Sent[] } {
    const sent: Sent[] = [];
    const client: ApiClient = {
      async sendRequest(method, url, headers): Promise<ApiHttpResponse> {
        sent.push({ method, url, headers: { ...headers } });
        const step = steps[Math.min(sent.length, steps.length) - 1]!;
        if (step instanceof Error) {
          throw step;
        }
        return { statusCode: step.status, body: step.body ?? '{}', headers: step.headers ?? json };
      }
    };
    return { client, sent };
  }

  /* A hook that records what it is told and optionally edits the headers. */
  function recording(edit: (headers: Record<string, string>) => void = () => undefined) {
    const seen = {
      infos: [] as CallInfo[],
      headers: [] as Array<Record<string, string>>,
      outcomes: [] as CallOutcome[],
      order: [] as string[]
    };
    const hook: CallHook = {
      start(info, headers) {
        seen.infos.push(info);
        seen.headers.push({ ...headers });
        seen.order.push('start');
        edit(headers);
        return {
          finish(outcome) {
            seen.outcomes.push(outcome);
            seen.order.push('finish');
          }
        };
      }
    };
    return { hook, seen };
  }

  function hooked(client: ApiClient, hook: CallHook | undefined, baseUrl = base, authenticator?: Authenticator): TestableApi {
    return new TestableApi(client, new Configuration({ baseUrl, callHook: hook }), authenticator);
  }

  const get = (testable: TestableApi, path = '/items/7', options?: RequestOptions, returnType: ((json: unknown) => unknown) | null = null, query: Record<string, unknown> = {}) =>
    testable.callForResult('GET', path, query, {}, null, ['application/json'], 'application/json', returnType, undefined, options, 'getItem', '/items/{id}');

  test('bhv hooks 001 without a hook a call sends the same headers and returns the same result', async () => {
    const { client, sent } = scripted({ status: 200, body: '{"n":1}' });

    const result = await get(hooked(client, undefined), '/items/7', undefined, (j) => j);

    expect(sent[0]!.headers).toEqual({ Accept: 'application/json' });
    expect(result.statusCode).toBe(200);
    expect(result.data).toEqual({ n: 1 });
  });

  test('bhv hooks 002 start gets the spec operation id, the upper-case method, the url template and the url', async () => {
    const { client } = scripted({ status: 200 });
    const { hook, seen } = recording();

    await hooked(client, hook).callForResult('get', '/items/7', { a: 1 }, {}, null, ['application/json'], 'application/json', null, undefined, undefined, 'getItem', '/items/{id}');

    expect(seen.infos).toEqual([
      { operationId: 'getItem', method: 'GET', urlTemplate: '/items/{id}', url: 'https://api.example.com/items/7', serverAddress: 'api.example.com' }
    ]);
    expect(seen.order).toEqual(['start', 'finish']);
  });

  test.each([
    ['https://API.Example.com:8443', 'api.example.com'],
    ['http://[::1]:8080', '::1'],
    ['http://[2001:db8::1]', '2001:db8::1']
  ])('bhv hooks 003 serverAddress of %s is the host without port or brackets', async (baseUrl, expected) => {
    const { client } = scripted({ status: 200 });
    const { hook, seen } = recording();

    await get(hooked(client, hook, baseUrl));

    expect(seen.infos[0]!.serverAddress).toBe(expected);
  });

  test('bhv hooks 004 a header the hook sets reaches the transport', async () => {
    const { client, sent } = scripted({ status: 200 });
    const { hook } = recording((headers) => {
      headers['X-Hook'] = 'one';
    });

    await get(hooked(client, hook));

    expect(sent[0]!.headers['X-Hook']).toBe('one');
  });

  test('bhv hooks 005 start sees the final header set and can replace one', async () => {
    const { client, sent } = scripted({ status: 200 });
    const { hook, seen } = recording((headers) => {
      headers['Authorization'] = 'Bearer swapped';
    });
    const config = new Configuration({ baseUrl: base, callHook: hook, defaultHeaders: { 'X-Default': 'd' } });
    const testable = new TestableApi(client, config, new TestAuthenticator({ Authorization: 'Bearer real' }));

    await get(testable);

    expect(seen.headers[0]).toMatchObject({ 'X-Default': 'd', Authorization: 'Bearer real', Accept: 'application/json' });
    expect(sent[0]!.headers['Authorization']).toBe('Bearer swapped');
  });

  test('bhv hooks 011 finish gets the status, the lower-cased headers and no error on a 2xx', async () => {
    const { client } = scripted({ status: 204, headers: { 'X-Request-Id': 'abc' } });
    const { hook, seen } = recording();

    await get(hooked(client, hook));

    expect(seen.outcomes).toEqual([{ statusCode: 204, headers: { 'x-request-id': 'abc' }, error: null }]);
    expect(Object.isFrozen(seen.outcomes[0]!.headers)).toBe(true);
  });

  test('bhv hooks 012 finish gets the status, the headers and the same typed error the caller receives', async () => {
    const { client } = scripted({ status: 404, headers: { 'X-Trace': 't' } });
    const { hook, seen } = recording();

    const error = await get(hooked(client, hook)).catch((e: unknown) => e);

    expect(error).toBeInstanceOf(NotFoundError);
    expect(seen.outcomes).toHaveLength(1);
    expect(seen.outcomes[0]!.statusCode).toBe(404);
    expect(seen.outcomes[0]!.headers).toEqual({ 'x-trace': 't' });
    expect(seen.outcomes[0]!.error).toBe(error);
  });

  test('bhv hooks 013 finish gets status 0, null headers and the network error when no response arrived', async () => {
    const failure = new NetworkError('connection refused');
    const { client } = scripted(failure);
    const { hook, seen } = recording();

    await expect(get(hooked(client, hook))).rejects.toBe(failure);

    expect(seen.outcomes).toEqual([{ statusCode: 0, headers: null, error: failure }]);
  });

  test('bhv hooks 014 finish gets the timeout error, never the cancellation error', async () => {
    const failure = new NetworkTimeoutError('timed out');
    const { client } = scripted(failure);
    const { hook, seen } = recording();

    await expect(get(hooked(client, hook))).rejects.toBe(failure);

    expect(seen.outcomes[0]!.error).toBe(failure);
    expect(seen.outcomes[0]!.error).toBeInstanceOf(NetworkTimeoutError);
  });

  test('bhv hooks 015 finish gets the cancellation and the call rethrows it, never as the timeout error', async () => {
    const controller = new AbortController();
    const client: ApiClient = {
      sendRequest: (_method, _url, _headers, _body, options) =>
        new Promise<ApiHttpResponse>((_resolve, reject) => {
          options?.signal?.addEventListener('abort', () => reject(options.signal!.reason));
          controller.abort();
        })
    };
    const { hook, seen } = recording();

    const error = await get(hooked(client, hook), '/items/7', { signal: controller.signal }).catch((e: unknown) => e);

    expect((error as Error).name).toBe('AbortError');
    expect(error).not.toBeInstanceOf(NetworkTimeoutError);
    expect(seen.outcomes).toHaveLength(1);
    expect(seen.outcomes[0]!.error).toBe(error);
    expect(seen.outcomes[0]!.statusCode).toBe(0);
  });

  test('bhv hooks 016 finish gets the SerializationError, with the status that arrived, when the response cannot be decoded', async () => {
    const { client } = scripted({ status: 200, body: 'not json' });
    const { hook, seen } = recording();

    const error = await get(hooked(client, hook), '/items/7', undefined, (j) => j).catch((e: unknown) => e);

    expect(error).toBeInstanceOf(SerializationError);
    expect(seen.outcomes).toHaveLength(1);
    expect(seen.outcomes[0]!.statusCode).toBe(200);
    expect(seen.outcomes[0]!.error).toBe(error);
  });

  test('bhv hooks 017 finish is called when the request body cannot be encoded and nothing is sent', async () => {
    const { client, sent } = scripted({ status: 200 });
    const { hook, seen } = recording();

    const error = await hooked(client, hook)
      .callForResult('POST', '/items', {}, {}, { nested: { a: 1 } }, ['application/json'], 'application/x-www-form-urlencoded', null)
      .catch((e: unknown) => e);

    expect(error).toBeInstanceOf(SerializationError);
    expect(sent).toHaveLength(0);
    expect(seen.outcomes).toEqual([{ statusCode: 0, headers: null, error }]);
  });

  test('bhv hooks 018 an error thrown by start reaches the caller unchanged, nothing is sent and finish is not called', async () => {
    const { client, sent } = scripted({ status: 200 });
    const failure = new Error('refused by the hook');
    let finished = 0;
    const hook: CallHook = {
      start() {
        throw failure;
      }
    };
    const observed: CallHook = { start: () => ({ finish: () => void finished++ }) };

    await expect(get(hooked(client, chain(observed, hook)))).rejects.toBe(failure);

    expect(sent).toHaveLength(0);
    expect(finished).toBe(0);
  });

  test('bhv hooks 019 an error thrown by finish is swallowed and the caller still gets its result or its own error', async () => {
    const throwing: CallHook = {
      start: () => ({
        finish() {
          throw new Error('observer failed');
        }
      })
    };
    const ok = scripted({ status: 200, body: '{"n":1}' });
    const result = await get(hooked(ok.client, throwing), '/items/7', undefined, (j) => j);
    expect(result.data).toEqual({ n: 1 });

    const missing = scripted({ status: 404 });
    await expect(get(hooked(missing.client, throwing))).rejects.toBeInstanceOf(NotFoundError);
  });

  test('bhv hooks 021 the url given to the hook never carries the query string or the fragment', async () => {
    const { client } = scripted({ status: 200 });
    const { hook, seen } = recording();

    await get(hooked(client, hook), '/items/7#frag', undefined, null, { a: 1, b: 'x y' });

    expect(seen.infos[0]!.url).toBe('https://api.example.com/items/7');
    expect(JSON.stringify(seen.infos[0])).not.toContain('a=1');
    expect(JSON.stringify(seen.infos[0])).not.toContain('frag');
  });

  describe('through the default transport', () => {
    let delays: number[];
    beforeEach(() => {
      delays = [];
      jest.spyOn(globalThis, 'setTimeout').mockImplementation(((handler: () => void, ms?: number) => {
        delays.push(ms ?? 0);
        handler();
        return 0 as unknown as NodeJS.Timeout;
      }) as unknown as typeof setTimeout);
    });
    afterEach(() => {
      jest.restoreAllMocks();
    });

    /* A transport whose fetch plays the statuses in order, the last one repeating, and records every request. */
    function playing(...statuses: number[]): { client: DefaultApiClient; requests: Array<Record<string, string>> } {
      const requests: Array<Record<string, string>> = [];
      const stub = (async (_url: unknown, init?: { headers?: Record<string, string> }) => {
        requests.push({ ...(init?.headers ?? {}) });
        const status = statuses[Math.min(requests.length, statuses.length) - 1]!;
        return new Response('{}', { status, headers: json });
      }) as unknown as typeof fetch;
      return { client: new DefaultApiClient(TransportOptions.builder().fetch(stub).build()), requests };
    }

    test('bhv hooks 006 a header the hook sets is on every send of the call, retries included', async () => {
      const { client, requests } = playing(503, 503, 200);
      const { hook } = recording((headers) => {
        headers['X-Hook'] = 'one';
      });

      await get(hooked(client, hook));

      expect(requests).toHaveLength(3);
      expect(requests.map((request) => request['X-Hook'])).toEqual(['one', 'one', 'one']);
    });

    test('bhv hooks 008 a call retried by the transport calls start once and finish once', async () => {
      const { client, requests } = playing(503, 200);
      const { hook, seen } = recording();

      await get(hooked(client, hook));

      expect(requests).toHaveLength(2);
      expect(seen.order).toEqual(['start', 'finish']);
      expect(seen.outcomes[0]!.statusCode).toBe(200);
    });

    test('bhv hooks 010 a hook on the configuration fires when the caller supplied the transport', async () => {
      const supplied = TransportOptions.builder()
        .fetch((async () => new Response('{}', { status: 200, headers: json })) as unknown as typeof fetch)
        .build();
      const { hook, seen } = recording();

      await get(hooked(new DefaultApiClient(supplied), hook));

      expect(seen.order).toEqual(['start', 'finish']);
    });
  });

  describe('a 401 on an OAuth2 call', () => {
    const tokenUrl = 'https://auth.example.com/token';

    function renewing(): { stub: ApiClient; seen: Array<{ url: string; headers: Record<string, string> }>; oauth: OAuth2ClientCredentialsAuthenticator } {
      const seen: Array<{ url: string; headers: Record<string, string> }> = [];
      let issued = 0;
      const stub: ApiClient = {
        async sendRequest(_method, url, headers): Promise<ApiHttpResponse> {
          seen.push({ url, headers: { ...headers } });
          if (url === tokenUrl) {
            issued += 1;
            return { statusCode: 200, body: JSON.stringify({ access_token: `tok-${issued}`, expires_in: 3600 }), headers: json };
          }
          return { statusCode: headers['Authorization'] === 'Bearer tok-2' ? 200 : 401, body: '{}', headers: json };
        }
      };
      const oauth = new OAuth2ClientCredentialsAuthenticator('https://api.example.com', 'client-id', 'client-secret', tokenUrl, []);
      oauth.setApiClient(stub);
      return { stub, seen, oauth };
    }

    test('bhv hooks 006 a header the hook sets is on the replay after a 401', async () => {
      const { stub, seen, oauth } = renewing();
      const { hook, seen: calls } = recording((headers) => {
        headers['X-Hook'] = 'one';
      });

      await get(hooked(stub, hook, base, oauth));

      const api = seen.filter((request) => request.url !== tokenUrl);
      expect(api).toHaveLength(2);
      expect(api.map((request) => request.headers['X-Hook'])).toEqual(['one', 'one']);
      expect(calls.order).toEqual(['start', 'finish']);
    });

    test('bhv hooks 007 the fresh authentication headers of a replay still replace a hook header of the same name', async () => {
      const { stub, seen, oauth } = renewing();
      const { hook } = recording((headers) => {
        headers['Authorization'] = 'Bearer from-hook';
      });

      await get(hooked(stub, hook, base, oauth));

      const api = seen.filter((request) => request.url !== tokenUrl);
      expect(api[0]!.headers['Authorization']).toBe('Bearer from-hook');
      expect(api[1]!.headers['Authorization']).toBe('Bearer tok-2');
    });
  });

  test('bhv hooks 009 the plain and the WithHttpInfo variant of an operation call the hook once each', async () => {
    const { client } = scripted({ status: 200, body: '{"id":1,"name":"x","photoUrls":[]}' });
    const { hook, seen } = recording();
    const operations = new PetApi(client, new Configuration({ baseUrl: base, callHook: hook }));

    await operations.getPetById(1);
    expect(seen.order).toEqual(['start', 'finish']);
    await operations.getPetByIdWithHttpInfo(1);

    expect(seen.order).toEqual(['start', 'finish', 'start', 'finish']);
    expect(seen.infos.map((info) => [info.operationId, info.urlTemplate, info.url])).toEqual([
      ['getPetById', '/pet/{petId}', 'https://api.example.com/pet/1'],
      ['getPetById', '/pet/{petId}', 'https://api.example.com/pet/1']
    ]);
  });
});
