    await testApi.call('POST', '/test/echo', {}, {}, 'hello',
      ['application/json'], 'text/plain', null);
    const contentType = Object.entries(client.capturedHeaders)
      .find(([k]) => k.toLowerCase() === 'content-type')?.[1];
