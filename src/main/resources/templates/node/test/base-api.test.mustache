  test('bhv authintegration 002 a per-call OAuth2 authenticator is given the API client of the call', async () => {
    const seen: Array<{ url: string; headers: Record<string, string> }> = [];
    const stub: ApiClient = {
      async sendRequest(_method, url, headers) {
        seen.push({ url, headers });
        const body = url === 'https://auth.example.com/token'
          ? JSON.stringify({ access_token: 'per-call-token', expires_in: 3600 })
          : '{}';
        return { statusCode: 200, body, headers: { 'content-type': 'application/json' } };
      },
    };
    const oauth = new OAuth2ClientCredentialsAuthenticator(
