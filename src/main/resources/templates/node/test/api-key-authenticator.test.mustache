import * as util from 'node:util';
import { ApiKeyAuthenticator } from '../src/auth/api-key-authenticator{{importFileExtension}}';
import { ApiKeyLocation } from '../src/auth/api-key-location{{importFileExtension}}';
import { ApiKeyHeaderAuthenticator, ApiKeyQueryAuthenticator, InternalApiKeyAuthenticator, SessionCookieAuthenticator } from '../src/index{{importFileExtension}}';

describe('ApiKeyAuthenticator', () => {
  it('bhv authapikey 014 valid HEADER key produces the header', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc123', ApiKeyLocation.HEADER);
    expect(auth.getAuthHeaders()).toEqual({ 'X-Api-Key': 'abc123' });
  });

  it('bhv authapikey 015 valid QUERY key produces the query param', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'api_key', 'abc123', ApiKeyLocation.QUERY);
    expect(auth.getQueryParams()).toEqual({ api_key: 'abc123' });
  });

  it('bhv authapikey 013 valid COOKIE key produces the cookie param and nothing else', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', 'abc123', ApiKeyLocation.COOKIE);
    expect(auth.getCookieParams()).toEqual({ SESSION_ID: 'abc123' });
    expect(auth.getAuthHeaders()).toEqual({});
    expect(auth.getQueryParams()).toEqual({});
  });

  it('bhv auth 016 a scheme-specific subclass prints its own class name', () => {
    class PetStoreApiKeyAuthenticator extends ApiKeyAuthenticator {}
    const auth = new PetStoreApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc123', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).toMatch(/^PetStoreApiKeyAuthenticator\(host=https:\/\/api\.example\.com, /);
    expect(util.inspect(auth)).not.toContain('abc123');
  });

  it('bhv authapikey 005 rejects an empty key at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', '', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', '   ', ApiKeyLocation.HEADER)).toThrow(TypeError);
  });

  it('bhv authapikey 008 HEADER location rejects a non-ASCII key and CR/LF (RFC 7230 §3.2.6)', () => {
    // HEADER location must reject anything outside printable ASCII +
    // TAB to prevent header injection (\r\n) and silent UTF-8 mangling.
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc\r\nInjected: yes', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'kéy', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'kéy', ApiKeyLocation.HEADER)).toThrow(
      "API key for header 'X-Api-Key' must contain only printable ASCII characters (RFC 7230 §3.2.6)"
    );
  });

  it('bhv authapikey 009 QUERY location accepts a non-ASCII key, and so does COOKIE', () => {
    const queryAuth = new ApiKeyAuthenticator('https://api.example.com', 'api_key', 'kéy', ApiKeyLocation.QUERY);
    expect(queryAuth.getQueryParams()).toEqual({ api_key: 'kéy' });
    const cookieAuth = new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', 'kéy', ApiKeyLocation.COOKIE);
    expect(cookieAuth.getCookieParams()).toEqual({ SESSION_ID: 'kéy' });
  });

  it('bhv authapikey 002 a CR or LF in a cookie key throws at construction', () => {
    for (const value of ['abc\rdef', 'abc\ndef']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', value, ApiKeyLocation.COOKIE)).toThrow(TypeError);
    }
  });

  it('bhv authapikey 003 a CR or LF in a query key throws at construction', () => {
    for (const value of ['abc\rdef', 'abc\ndef']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'api_key', value, ApiKeyLocation.QUERY)).toThrow(TypeError);
    }
  });

  it('bhv authapikey 018 a CR in a header key throws at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc\rdef', ApiKeyLocation.HEADER)).toThrow(TypeError);
  });

  it('bhv authapikey 004 an empty cookie key throws at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', '', ApiKeyLocation.COOKIE)).toThrow(
      "API key value for 'SESSION_ID' must not be empty"
    );
  });

  it('bhv authapikey 006 an empty query key throws at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'api_key', '', ApiKeyLocation.QUERY)).toThrow(
      "API key value for 'api_key' must not be empty"
    );
  });

  it('bhv authapikey 017 a whitespace-only key throws at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'api_key', '   ', ApiKeyLocation.QUERY)).toThrow(
      "API key value for 'api_key' must not be empty"
    );
  });

  it('bhv authapikey 011 a key made only of ASCII whitespace such as a vertical tab is rejected', () => {
    for (const location of [ApiKeyLocation.QUERY, ApiKeyLocation.COOKIE]) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'key', '\v', location)).toThrow(
        "API key value for 'key' must not be empty"
      );
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'key', ' \t\n\v\f\r', location)).toThrow(
        "API key value for 'key' must not be empty"
      );
    }
  });

  it('bhv auth 006 an API key sent in a header is keyed by the declared header name', () => {
    const auth = new ApiKeyHeaderAuthenticator('https://api.example.com', 'abc123');
    expect(Object.keys(auth.getAuthHeaders())).toEqual(['X-API-Key']);
  });

  it('bhv authapikey 016 a valid query key passes and is emitted nowhere else', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'api_key', 'abc123', ApiKeyLocation.QUERY);
    expect(auth.getQueryParams()).toEqual({ api_key: 'abc123' });
    expect(auth.getAuthHeaders()).toEqual({});
    expect(auth.getCookieParams()).toEqual({});
  });

  it('bhv authapikey 022 a key is emitted only at its own location and not at the other two', () => {
    const header = new ApiKeyAuthenticator('https://api.example.com', 'k', 'v', ApiKeyLocation.HEADER);
    expect(header.getAuthHeaders()).toEqual({ k: 'v' });
    expect(header.getQueryParams()).toEqual({});
    expect(header.getCookieParams()).toEqual({});
    const query = new ApiKeyAuthenticator('https://api.example.com', 'k', 'v', ApiKeyLocation.QUERY);
    expect(query.getQueryParams()).toEqual({ k: 'v' });
    expect(query.getAuthHeaders()).toEqual({});
    expect(query.getCookieParams()).toEqual({});
  });

  it('bhv authapikey 023 a cookie key accepts a non-ASCII value', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', 'kéy', ApiKeyLocation.COOKIE);
    expect(auth.getCookieParams()).toEqual({ SESSION_ID: 'kéy' });
  });

  it('bhv authapikey 019 every API-key wrapper rejects an empty key at construction', () => {
    for (const Wrapper of [ApiKeyHeaderAuthenticator, InternalApiKeyAuthenticator, ApiKeyQueryAuthenticator, SessionCookieAuthenticator]) {
      expect(() => new Wrapper('https://api.example.com', '')).toThrow(TypeError);
    }
  });

  it('bhv authapikey 020 every API-key wrapper redacts its key in the inspected form', () => {
    for (const Wrapper of [ApiKeyHeaderAuthenticator, InternalApiKeyAuthenticator, ApiKeyQueryAuthenticator, SessionCookieAuthenticator]) {
      const auth = new Wrapper('https://api.example.com', 'topsecret');
      expect(util.inspect(auth)).not.toContain('topsecret');
      expect(util.inspect(auth)).toContain('***');
    }
  });

  it('bhv authapikey 025 every generated API-key wrapper masks the key and shows its declared name in its debug output', () => {
    for (const [Wrapper, keyName] of [
      [ApiKeyHeaderAuthenticator, 'X-API-Key'],
      [InternalApiKeyAuthenticator, 'X-Internal-Key'],
      [ApiKeyQueryAuthenticator, 'api_key'],
      [SessionCookieAuthenticator, 'SESSION_ID'],
    ] as const) {
      const auth = new Wrapper('https://api.example.com', 'topsecret-025');
      expect(util.inspect(auth)).toContain(keyName);
      expect(util.inspect(auth)).toContain('***');
      expect(util.inspect(auth)).not.toContain('topsecret-025');
    }
  });

  it('bhv authapikey 026 does not leak its key in its default debug output', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'key-secret-026', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).not.toContain('key-secret-026');
    expect(String(auth)).not.toContain('key-secret-026');
  });

  it('bhv authapikey 007 generated scheme wrappers emit their key at their spec location', () => {
    const wrappers: Array<[new (host: string, key: string) => ApiKeyAuthenticator, ApiKeyLocation, string]> = [
      [ApiKeyHeaderAuthenticator, ApiKeyLocation.HEADER, 'X-API-Key'],
      [InternalApiKeyAuthenticator, ApiKeyLocation.HEADER, 'X-Internal-Key'],
      [ApiKeyQueryAuthenticator, ApiKeyLocation.QUERY, 'api_key'],
      [SessionCookieAuthenticator, ApiKeyLocation.COOKIE, 'SESSION_ID']
    ];
    for (const [Wrapper, location, keyName] of wrappers) {
      const auth = new Wrapper('https://api.example.com', 'abc123');
      expect(auth.getAuthHeaders()).toEqual(location === ApiKeyLocation.HEADER ? { [keyName]: 'abc123' } : {});
      expect(auth.getQueryParams()).toEqual(location === ApiKeyLocation.QUERY ? { [keyName]: 'abc123' } : {});
      expect(auth.getCookieParams()).toEqual(location === ApiKeyLocation.COOKIE ? { [keyName]: 'abc123' } : {});
    }
  });

  it.each([
    [ApiKeyLocation.HEADER, 'X-Api-Key'],
    [ApiKeyLocation.QUERY, 'api_key'],
    [ApiKeyLocation.COOKIE, 'SESSION_ID']
  ])('%s location rejects CR, LF and NUL', (location, name) => {
    for (const value of ['abc\rdef', 'abc\ndef', 'abc\0def']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(TypeError);
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(
        `API key value for '${name}' contains forbidden control characters (CR/LF/NUL)`
      );
    }
  });

  it.each([
    [ApiKeyLocation.HEADER, 'X-Api-Key'],
    [ApiKeyLocation.QUERY, 'api_key'],
    [ApiKeyLocation.COOKIE, 'SESSION_ID']
  ])('%s location rejects an empty or whitespace key with the exact message', (location, name) => {
    for (const value of ['', '   ', ' \t\n\v\f\r']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(
        `API key value for '${name}' must not be empty`
      );
    }
  });

  it('bhv authapikey 001 a Unicode space is not blank and is a valid query key', () => {
    for (const value of ['\u00a0', '\u2003']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'api_key', value, ApiKeyLocation.QUERY)).not.toThrow();
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', value, ApiKeyLocation.COOKIE)).not.toThrow();
    }
  });

  it('bhv authapikey 012 the redacted representation shows the host, key name and location', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'key-secret-xyz', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).toBe(
      'ApiKeyAuthenticator(host=https://api.example.com, keyParamName=X-Api-Key, apiKey=***, location=header)'
    );
    expect(JSON.parse(JSON.stringify(auth))).toEqual({
      host: 'https://api.example.com',
      keyParamName: 'X-Api-Key',
      apiKey: '***',
      location: 'header'
    });
  });

  it('bhv authapikey 010 redacts the secret from default string/inspect/JSON', () => {
    // authenticator-secret-in-default-string-repr: console.log / util.inspect
    // / JSON.stringify must never leak the live credential.
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'key-secret-xyz', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).not.toContain('key-secret-xyz');
    expect(JSON.stringify(auth)).not.toContain('key-secret-xyz');
    expect(util.inspect(auth)).toContain('***');
  });

  describe('credential resolution', () => {
    const variable = '{{envVarPrefix}}_API_KEY';
    const saved = process.env[variable];
    afterEach(() => {
      if (saved === undefined) {
        delete process.env[variable];
      } else {
        process.env[variable] = saved;
      }
    });

    it('bhv authapikey 021 reads the key from the environment when none is passed', () => {
      process.env[variable] = 'from-env';
      const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', undefined, ApiKeyLocation.HEADER);
      expect(auth.getAuthHeaders()).toEqual({ 'X-Api-Key': 'from-env' });
    });

    it('bhv serializationobject 187 an explicit key wins over the environment', () => {
      process.env[variable] = 'from-env';
      const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'explicit', ApiKeyLocation.HEADER);
      expect(auth.getAuthHeaders()).toEqual({ 'X-Api-Key': 'explicit' });
    });

    it.each([undefined, ''])('fails when it is built with no key and the variable is %p', (value) => {
      if (value === undefined) {
        delete process.env[variable];
      } else {
        process.env[variable] = value;
      }
      expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', undefined, ApiKeyLocation.HEADER)).toThrow(
        new TypeError(`API key for 'X-Api-Key' is required: pass it explicitly or set ${variable}`)
      );
    });
  });
});
