import * as util from 'node:util';
import { ApiKeyAuthenticator } from '../src/auth/api-key-authenticator{{importFileExtension}}';
import { ApiKeyLocation } from '../src/auth/api-key-location{{importFileExtension}}';

describe('ApiKeyAuthenticator', () => {
  it('valid HEADER key produces the header', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc123', ApiKeyLocation.HEADER);
    expect(auth.getAuthHeaders()).toEqual({ 'X-Api-Key': 'abc123' });
  });

  it('valid QUERY key produces the query param', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'api_key', 'abc123', ApiKeyLocation.QUERY);
    expect(auth.getQueryParams()).toEqual({ api_key: 'abc123' });
  });

  it('valid COOKIE key produces the cookie param and nothing else', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', 'abc123', ApiKeyLocation.COOKIE);
    expect(auth.getCookieParams()).toEqual({ SESSION_ID: 'abc123' });
    expect(auth.getAuthHeaders()).toEqual({});
    expect(auth.getQueryParams()).toEqual({});
  });

  it('a scheme-specific subclass prints its own class name', () => {
    class PetStoreApiKeyAuthenticator extends ApiKeyAuthenticator {}
    const auth = new PetStoreApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc123', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).toMatch(/^PetStoreApiKeyAuthenticator\(host=https:\/\/api\.example\.com, /);
    expect(util.inspect(auth)).not.toContain('abc123');
  });

  it('rejects an empty key at construction', () => {
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', '', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', '   ', ApiKeyLocation.HEADER)).toThrow(TypeError);
  });

  it('HEADER rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () => {
    // HEADER location must reject anything outside printable ASCII +
    // TAB to prevent header injection (\r\n) and silent UTF-8 mangling.
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'abc\r\nInjected: yes', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'kéy', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'kéy', ApiKeyLocation.HEADER)).toThrow(
      "API key for header 'X-Api-Key' must contain only printable ASCII characters (RFC 7230 §3.2.6)"
    );
    // Non-header locations accept non-ASCII (but see the control-character test below).
    const queryAuth = new ApiKeyAuthenticator('https://api.example.com', 'api_key', 'kéy', ApiKeyLocation.QUERY);
    expect(queryAuth.getQueryParams()).toEqual({ api_key: 'kéy' });
    const cookieAuth = new ApiKeyAuthenticator('https://api.example.com', 'SESSION_ID', 'kéy', ApiKeyLocation.COOKIE);
    expect(cookieAuth.getCookieParams()).toEqual({ SESSION_ID: 'kéy' });
  });

  it.each([
    [ApiKeyLocation.HEADER, 'X-Api-Key'],
    [ApiKeyLocation.QUERY, 'api_key'],
    [ApiKeyLocation.COOKIE, 'SESSION_ID']
  ])('%s location rejects CR, LF and NUL', (location, name) => {
    for (const value of ['abc\rdef', 'abc\ndef', 'abc\0def']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(TypeError);
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(
        `API key value for '${name}' contains forbidden control characters (CR/LF/NUL)`
      );
    }
  });

  it.each([
    [ApiKeyLocation.HEADER, 'X-Api-Key'],
    [ApiKeyLocation.QUERY, 'api_key'],
    [ApiKeyLocation.COOKIE, 'SESSION_ID']
  ])('%s location rejects an empty or whitespace key with the exact message', (location, name) => {
    for (const value of ['', '   ']) {
      expect(() => new ApiKeyAuthenticator('https://api.example.com', name, value, location)).toThrow(
        `API key value for '${name}' must not be empty`
      );
    }
  });

  it('the redacted representation shows the host, key name and location', () => {
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'key-secret-xyz', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).toBe(
      'ApiKeyAuthenticator(host=https://api.example.com, keyParamName=X-Api-Key, apiKey=***, location=header)'
    );
    expect(JSON.parse(JSON.stringify(auth))).toEqual({
      host: 'https://api.example.com',
      keyParamName: 'X-Api-Key',
      apiKey: '***',
      location: 'header'
    });
  });

  it('redacts the secret from default string/inspect/JSON', () => {
    // authenticator-secret-in-default-string-repr: console.log / util.inspect
    // / JSON.stringify must never leak the live credential.
    const auth = new ApiKeyAuthenticator('https://api.example.com', 'X-Api-Key', 'key-secret-xyz', ApiKeyLocation.HEADER);
    expect(util.inspect(auth)).not.toContain('key-secret-xyz');
    expect(JSON.stringify(auth)).not.toContain('key-secret-xyz');
    expect(util.inspect(auth)).toContain('***');
  });
});
