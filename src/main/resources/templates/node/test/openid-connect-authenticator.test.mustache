import { createHash } from 'node:crypto';
import * as util from 'node:util';
import { OpenIdConnectAuthenticator } from '../src/auth/oauth/openid-connect-authenticator{{importFileExtension}}';
import { InternalServerError, NotFoundError } from '../src/errors/index{{importFileExtension}}';
import { NetworkError } from '../src/errors/network-error{{importFileExtension}}';
import { SerializationError } from '../src/errors/serialization-error{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiHttpResponse } from '../src/api-http-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responses: ApiHttpResponse[] = [];
  callCount = 0;

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiHttpResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    const response = this.responses[this.callCount] ?? {
      statusCode: 200,
      body: '{}',
      headers: { 'content-type': 'application/json' }
    };
    this.callCount++;
    return response;
  }
}

describe('OpenIdConnectAuthenticator', () => {
  let authenticator: OpenIdConnectAuthenticator;
  let mockClient: MockApiClient;

  beforeEach(() => {
    authenticator = new OpenIdConnectAuthenticator(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my-client-id',
      'my-client-secret',
      'https://myapp.example.com/callback',
      ['openid', 'profile']
    );
    mockClient = new MockApiClient();
    authenticator.setApiClient(mockClient);
  });

  test('the synchronous getAuthHeaders throws instead of returning unauthenticated headers', () => {
    expect(() => authenticator.getAuthHeaders()).toThrow(
      'OAuth2 authenticators require async token exchange; use getAuthHeadersAsync() instead.'
    );
  });

  test('client secret is not leaked in default string representation', () => {
    // client-secret-leak-in-default-repr: console.log / util.inspect /
    // JSON.stringify must never expose the stored OAuth2 client secret.
    expect(util.inspect(authenticator)).not.toContain('my-client-secret');
    expect(JSON.stringify(authenticator)).not.toContain('my-client-secret');
    expect(util.inspect(authenticator)).toContain('***');
  });

  it('bhv authoidc 019 redacts secret', () => {
    expect(util.inspect(authenticator)).not.toContain('my-client-secret');
    expect(JSON.stringify(authenticator)).not.toContain('my-client-secret');
    expect(util.inspect(authenticator)).toContain('***');
    expect(JSON.stringify(authenticator)).toContain('***');
  });

  test('bhv authoidc 002 builds authorization URL from discovery', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    const url = await authenticator.buildAuthorizationUrl();

    expect(url).toContain('https://auth.example.com/authorize?');
    expect(url).toContain('client_id=my-client-id');
    expect(url).toContain('response_type=code');
  });

  describe('PKCE and token renewal', () => {
    const discoveryResponse = (cacheControl = 'max-age=0'): ApiHttpResponse => ({
      statusCode: 200,
      body: JSON.stringify({
        authorization_endpoint: 'https://auth.example.com/authorize',
        token_endpoint: 'https://auth.example.com/token'
      }),
      headers: { 'content-type': 'application/json', 'Cache-Control': cacheControl }
    });
    const tokenResponse = (accessToken: string): ApiHttpResponse => ({
      statusCode: 200,
      body: JSON.stringify({ access_token: accessToken, refresh_token: 'ref1', expires_in: 3600 }),
      headers: { 'content-type': 'application/json' }
    });

    test('bhv authoidc 021 the verifier survives rediscovery and no nonce is sent', async () => {
      mockClient.responses = [discoveryResponse(), discoveryResponse(), tokenResponse('tok1')];
      const originalNow = Date.now;
      let query: URLSearchParams;
      try {
        query = new URL(await authenticator.buildAuthorizationUrl()).searchParams;
        Date.now = () => originalNow() + 1000;
        await authenticator.exchangeCode('my-auth-code');
      } finally {
        Date.now = originalNow;
      }

      expect(mockClient.callCount).toBe(3);
      expect(query.get('code_challenge_method')).toBe('S256');
      expect(query.has('nonce')).toBe(false);
      const verifier = new URLSearchParams(mockClient.lastBody as string).get('code_verifier');
      expect(verifier).toMatch(/^[A-Za-z0-9_-]{43}$/);
      expect(createHash('sha256').update(verifier!).digest('base64url')).toBe(query.get('code_challenge'));
    });

    test('bhv authoidc 015 invalidateAccessToken keeps the refresh token and renews through it', async () => {
      mockClient.responses = [discoveryResponse('max-age=3600'), tokenResponse('tok1'), tokenResponse('tok2')];
      await authenticator.exchangeCode('my-auth-code');
      expect((await authenticator.getAuthHeadersAsync())['Authorization']).toBe('Bearer tok1');

      authenticator.invalidateAccessToken();
      const headers = await authenticator.getAuthHeadersAsync();

      expect(headers['Authorization']).toBe('Bearer tok2');
      const params = new URLSearchParams(mockClient.lastBody as string);
      expect(params.get('grant_type')).toBe('refresh_token');
      expect(params.get('refresh_token')).toBe('ref1');
    });
  });

  test.each([
    [[], 'openid'],
    [['profile'], 'openid profile'],
    [['openid'], 'openid'],
    [['OpenID'], 'openid OpenID']
  ] as Array<[string[], string]>)('the openid scope is always requested for scopes %j', async (scopes, expected) => {
    const oidc = new OpenIdConnectAuthenticator(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my-client-id',
      'my-client-secret',
      'https://myapp.example.com/callback',
      scopes
    );
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];
    oidc.setApiClient(mockClient);

    const url = await oidc.buildAuthorizationUrl();

    expect(new URL(url).searchParams.get('scope')).toBe(expected);
  });

  test('bhv authoidc 010 fetches discovery document', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await authenticator.buildAuthorizationUrl();

    expect(mockClient.lastMethod).toBe('GET');
    expect(mockClient.lastUrl).toBe('https://auth.example.com/.well-known/openid-configuration');
  });

  test('bhv authoidc 017 obtains token after code exchange', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      },
      {
        statusCode: 200,
        body: JSON.stringify({
          access_token: 'oidc-access-token',
          expires_in: 3600
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await authenticator.exchangeCode('my-auth-code');

    // The second call should have been to the token endpoint
    expect(mockClient.lastUrl).toBe('https://auth.example.com/token');
    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('authorization_code');
    expect(params.get('code')).toBe('my-auth-code');
  });

  test('bhv authoidc 013 getAuthHeaders returns Bearer after exchange', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      },
      {
        statusCode: 200,
        body: JSON.stringify({
          access_token: 'oidc-tok',
          expires_in: 3600
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await authenticator.exchangeCode('oidc-code');
    const headers = await authenticator.getAuthHeadersAsync();

    expect(headers['Authorization']).toBe('Bearer oidc-tok');
  });

  test.each([
    [404, NotFoundError],
    [500, InternalServerError]
  ])('throws on a non-2xx (%i) discovery response instead of mis-parsing it', async (status, errorClass) => {
    // oauth-oidc-discovery-no-status-check: a non-2xx answer (e.g. a 500
    // HTML error page) must surface as the same status-specific error an
    // API call would throw, not a downstream "invalid JSON".
    mockClient.responses = [
      {
        statusCode: status,
        body: '<html><body>Error</body></html>',
        headers: { 'content-type': 'text/html' }
      }
    ];

    const error = await authenticator.buildAuthorizationUrl().catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(errorClass);
    expect((error as NotFoundError).statusCode).toBe(status);
  });

  test('bhv authoidc 016 throws SerializationError when the discovery document is not JSON', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: '<html>not json</html>',
        headers: { 'content-type': 'text/html' }
      }
    ];

    const error = await authenticator.buildAuthorizationUrl().catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(SerializationError);
  });

  test('bhv authoidc 028 throws when no ApiClient injected', async () => {
    const auth = new OpenIdConnectAuthenticator(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my-client-id',
      'my-client-secret',
      'https://myapp.example.com/callback',
      ['openid', 'profile']
    );

    const error = await auth.buildAuthorizationUrl().catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(Error);
  });

  test('bhv authoidc 014 getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });

  test('bhv authoidc 011 fetches discovery document only once', async () => {
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({
          authorization_endpoint: 'https://auth.example.com/authorize',
          token_endpoint: 'https://auth.example.com/token'
        }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await authenticator.buildAuthorizationUrl();
    await authenticator.buildAuthorizationUrl();

    // The cached discovery document must be reused; only one GET is made.
    expect(mockClient.callCount).toBe(1);
  });

  test('bhv authoidc 006 a transport failure during discovery reaches the caller unchanged', async () => {
    const failure = new NetworkError('connection refused');
    const failing: ApiClient = {
      async sendRequest(): Promise<ApiHttpResponse> {
        throw failure;
      }
    };
    authenticator.setApiClient(failing);

    await expect(authenticator.buildAuthorizationUrl()).rejects.toBe(failure);
  });

  describe('discovery cache lifetime', () => {
    const discovery = (authorizationEndpoint: string, cacheControl?: string): ApiHttpResponse => ({
      statusCode: 200,
      body: JSON.stringify({
        authorization_endpoint: authorizationEndpoint,
        token_endpoint: 'https://auth.example.com/token'
      }),
      headers: cacheControl === undefined
        ? { 'content-type': 'application/json' }
        : { 'content-type': 'application/json', 'Cache-Control': cacheControl }
    });

    async function urlsAfter(seconds: number, cacheControl?: string): Promise<[string, string]> {
      mockClient.responses = [
        discovery('https://auth.example.com/authorize-1', cacheControl),
        discovery('https://auth.example.com/authorize-2', cacheControl)
      ];
      const originalNow = Date.now;
      try {
        const first = await authenticator.buildAuthorizationUrl();
        Date.now = () => originalNow() + seconds * 1000;
        const second = await authenticator.buildAuthorizationUrl();
        return [first, second];
      } finally {
        Date.now = originalNow;
      }
    }

    test('bhv authoidc 003 the document is cached until its Cache-Control max-age elapses', async () => {
      const [first, second] = await urlsAfter(59, 'public, max-age=60');

      expect(first).toContain('https://auth.example.com/authorize-1?');
      expect(second).toContain('https://auth.example.com/authorize-1?');
      expect(mockClient.callCount).toBe(1);
    });

    test('the document is fetched again once max-age has elapsed', async () => {
      const [first, second] = await urlsAfter(61, 'public, max-age=60');

      expect(first).toContain('https://auth.example.com/authorize-1?');
      expect(second).toContain('https://auth.example.com/authorize-2?');
      expect(mockClient.callCount).toBe(2);
    });

    test('bhv authoidc 001 a max-age beyond one year is clamped to one year', async () => {
      const [, second] = await urlsAfter(31_536_001, 'max-age=99999999999');

      expect(second).toContain('https://auth.example.com/authorize-2?');
      expect(mockClient.callCount).toBe(2);
    });

    test('max-age=0 is fetched again on the next use', async () => {
      const [, second] = await urlsAfter(1, 'max-age=0');

      expect(second).toContain('https://auth.example.com/authorize-2?');
      expect(mockClient.callCount).toBe(2);
    });

    const tokenResponse = (accessToken: string): ApiHttpResponse => ({
      statusCode: 200,
      body: JSON.stringify({ access_token: accessToken, expires_in: 3600 }),
      headers: { 'content-type': 'application/json' }
    });

    test('bhv authoidc 020 rediscovery after max-age expiry keeps the exchanged session', async () => {
      mockClient.responses = [
        discovery('https://auth.example.com/authorize-1', 'max-age=0'),
        tokenResponse('session-token'),
        discovery('https://auth.example.com/authorize-2', 'max-age=0'),
        discovery('https://auth.example.com/authorize-3', 'max-age=0')
      ];

      await authenticator.exchangeCode('first-code');
      const headers = await authenticator.getAuthHeadersAsync();
      const url = await authenticator.buildAuthorizationUrl();

      expect(headers['Authorization']).toBe('Bearer session-token');
      expect(url).toContain('https://auth.example.com/authorize-3?');
      expect(mockClient.callCount).toBe(4);
    });

    test('bhv authoidc 009 a failed rediscovery keeps the previous session and the next call retries', async () => {
      mockClient.responses = [
        discovery('https://auth.example.com/authorize-1', 'max-age=0'),
        tokenResponse('session-token'),
        { statusCode: 500, body: 'down', headers: { 'content-type': 'text/plain' } },
        discovery('https://auth.example.com/authorize-2', 'max-age=0')
      ];

      await authenticator.exchangeCode('first-code');
      const error = await authenticator.getAuthHeadersAsync().catch((e: unknown) => e);
      const headers = await authenticator.getAuthHeadersAsync();

      expect((error as Error).constructor).toBe(InternalServerError);
      expect(headers['Authorization']).toBe('Bearer session-token');
      expect(mockClient.callCount).toBe(4);
    });

    test('concurrent callers on a cold authenticator share one discovery request', async () => {
      let open: () => void = () => undefined;
      const gate = new Promise<void>((resolve) => {
        open = resolve;
      });
      let discoveries = 0;
      const gated: ApiClient = {
        async sendRequest(): Promise<ApiHttpResponse> {
          discoveries++;
          await gate;
          return discovery('https://auth.example.com/authorize-1');
        }
      };
      authenticator.setApiClient(gated);

      const pending = [1, 2, 3, 4, 5].map(() => authenticator.buildAuthorizationUrl());
      open();
      const urls = await Promise.all(pending);

      expect(discoveries).toBe(1);
      expect(urls.every((url) => url.startsWith('https://auth.example.com/authorize-1?'))).toBe(true);
    });

    test.each([
      [86399, 1],
      [86401, 2]
    ])('without Cache-Control the document is cached for a day (%i seconds later: %i fetches)', async (seconds, fetches) => {
      await urlsAfter(seconds);

      expect(mockClient.callCount).toBe(fetches);
    });
  });

  // oauth-oidc-missing-endpoint-guard: a discovery document missing the
  // authorization/token endpoint should fail loudly rather than build a
  // delegate with an undefined endpoint URL.
  test('bhv authoidc 025 throws when discovery is missing authorization_endpoint', async () => {
    // getDelegate() now guards the discovery document: an absent
    // authorization_endpoint surfaces a clear discovery error rather than
    // building a delegate with an `undefined` endpoint URL.
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({ token_endpoint: 'https://auth.example.com/token' }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await expect(authenticator.buildAuthorizationUrl()).rejects.toThrow(
      "OIDC discovery document is missing 'authorization_endpoint'"
    );
    await expect(authenticator.buildAuthorizationUrl()).rejects.toBeInstanceOf(SerializationError);
  });

  test('bhv authoidc 026 throws when discovery is missing token_endpoint', async () => {
    // getDelegate() now guards the discovery document: an absent
    // token_endpoint surfaces a clear discovery error rather than building a
    // delegate with an `undefined` endpoint URL.
    mockClient.responses = [
      {
        statusCode: 200,
        body: JSON.stringify({ authorization_endpoint: 'https://auth.example.com/authorize' }),
        headers: { 'content-type': 'application/json' }
      }
    ];

    await expect(authenticator.buildAuthorizationUrl()).rejects.toThrow(
      "OIDC discovery document is missing 'token_endpoint'"
    );
    await expect(authenticator.buildAuthorizationUrl()).rejects.toBeInstanceOf(SerializationError);
  });

  const discoveryDocument = (fields: Record<string, unknown>): ApiHttpResponse[] => [
    { statusCode: 200, body: JSON.stringify(fields), headers: { 'content-type': 'application/json' } }
  ];

  test.each(['https://other.example.com', 'https://auth.example.com/tenant'])(
    'discovery rejects an issuer %s that is not the discovery URL prefix',
    async (issuer) => {
      mockClient.responses = discoveryDocument({
        issuer,
        authorization_endpoint: 'https://auth.example.com/authorize',
        token_endpoint: 'https://auth.example.com/token'
      });

      const error = await authenticator.buildAuthorizationUrl().catch((e: unknown) => e);
      expect(error).toBeInstanceOf(SerializationError);
      expect((error as Error).message).toBe('OIDC discovery document issuer does not match the discovery URL');
    }
  );

  test.each(['https://auth.example.com', 'https://auth.example.com/'])(
    'discovery accepts the issuer %s, ignoring a trailing slash',
    async (issuer) => {
      mockClient.responses = discoveryDocument({
        issuer,
        authorization_endpoint: 'https://auth.example.com/authorize',
        token_endpoint: 'https://auth.example.com/token'
      });

      const url = await authenticator.buildAuthorizationUrl();
      expect(url.startsWith('https://auth.example.com/authorize?')).toBe(true);
    }
  );

  test.each([
    ['authorization_endpoint', 'http://auth.example.com/authorize', 'https://auth.example.com/token'],
    ['token_endpoint', 'https://auth.example.com/authorize', 'http://auth.example.com/token'],
    ['token_endpoint', 'https://auth.example.com/authorize', 'not a url']
  ])('discovery refuses a clear-text or unparseable %s', async (field, authorizationEndpoint, tokenEndpoint) => {
    mockClient.responses = discoveryDocument({
      authorization_endpoint: authorizationEndpoint,
      token_endpoint: tokenEndpoint
    });

    const error = await authenticator.buildAuthorizationUrl().catch((e: unknown) => e);
    expect(error).toBeInstanceOf(SerializationError);
    expect((error as Error).message).toBe(`OIDC discovery document field must be an https URL: ${field}`);
  });

  test.each(['http://localhost:9000', 'http://127.0.0.1:9000', 'http://[::1]:9000'])(
    'discovery accepts the loopback endpoints on %s',
    async (origin) => {
      mockClient.responses = discoveryDocument({
        authorization_endpoint: `${origin}/authorize`,
        token_endpoint: `${origin}/token`
      });

      const url = await authenticator.buildAuthorizationUrl();
      expect(url.startsWith(`${origin}/authorize?`)).toBe(true);
    }
  );

  test('a discovery URL that is not https is refused before any request is sent', async () => {
    const insecure = new OpenIdConnectAuthenticator(
      'https://api.example.com',
      'http://auth.example.com/.well-known/openid-configuration',
      'my-client-id',
      'my-client-secret',
      'https://myapp.example.com/callback',
      []
    );
    insecure.setApiClient(mockClient);

    await expect(insecure.buildAuthorizationUrl()).rejects.toThrow('OIDC discovery URL must use https');
    expect(mockClient.callCount).toBe(0);
  });

  test('bhv authoidc 023 the redacted representation shows exactly the agreed non-secret fields', () => {
    expect(util.inspect(authenticator)).toBe(
      'OpenIdConnectAuthenticator(host=https://api.example.com, clientId=my-client-id, clientSecret=***)'
    );
    expect(JSON.parse(JSON.stringify(authenticator))).toEqual(
      { host: 'https://api.example.com', clientId: 'my-client-id', clientSecret: '***' }
    );
  });
});
