import { OAuth2ClientCredentialsAuthenticator } from '../src/auth/oauth/oauth2-client-credentials-authenticator{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiResponse } from '../src/api-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responseBody = '';
  responseStatus = 200;

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    return {
      statusCode: this.responseStatus,
      body: this.responseBody,
      headers: { 'content-type': 'application/json' }
    };
  }
}

describe('OAuth2ClientCredentialsAuthenticator', () => {
  let authenticator: OAuth2ClientCredentialsAuthenticator;
  let mockClient: MockApiClient;

  beforeEach(() => {
    authenticator = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'my-client-secret',
      'https://auth.example.com/token',
      ['read', 'write']
    );
    mockClient = new MockApiClient();
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-123',
      expires_in: 3600
    });
    authenticator.setApiClient(mockClient);
  });

  test('sends client credentials grant type', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('client_credentials');
  });

  test('sends client id and secret', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('client_id')).toBe('my-client-id');
    expect(params.get('client_secret')).toBe('my-client-secret');
  });

  test('sends scopes', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('scope')).toBe('read write');
  });

  test('returns authorization bearer header', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'tok-abc',
      expires_in: 3600
    });

    const headers = await authenticator.getAuthHeadersAsync();

    expect(headers['Authorization']).toBe('Bearer tok-abc');
  });

  test('sends request to token URL', async () => {
    await authenticator.getAuthHeadersAsync();

    expect(mockClient.lastUrl).toBe('https://auth.example.com/token');
  });

  test('getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });
});
