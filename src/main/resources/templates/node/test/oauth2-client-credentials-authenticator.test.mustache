import * as util from 'node:util';
import { OAuth2ClientCredentialsAuthenticator } from '../src/auth/oauth/oauth2-client-credentials-authenticator{{importFileExtension}}';
import { ClientAuthMethod } from '../src/auth/oauth/client-auth-method{{importFileExtension}}';
import { OAuth2ServerError } from '../src/errors/oauth2-server-error{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiHttpResponse } from '../src/api-http-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responseBody = '';
  responseStatus = 200;

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiHttpResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    return {
      statusCode: this.responseStatus,
      body: this.responseBody,
      headers: { 'content-type': 'application/json' }
    };
  }
}

describe('OAuth2ClientCredentialsAuthenticator', () => {
  let authenticator: OAuth2ClientCredentialsAuthenticator;
  let mockClient: MockApiClient;

  beforeEach(() => {
    authenticator = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'my-client-secret',
      'https://auth.example.com/token',
      ['read', 'write']
    );
    mockClient = new MockApiClient();
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-123',
      expires_in: 3600
    });
    authenticator.setApiClient(mockClient);
  });

  test('bhv langnode 090 the synchronous getAuthHeaders throws instead of returning unauthenticated headers', () => {
    expect(() => authenticator.getAuthHeaders()).toThrow(
      'OAuth2 authenticators require async token exchange; use getAuthHeadersAsync() instead.'
    );
  });

  test('bhv authoauthtwoclientcred 016 the token request body uses a fixed parameter order', async () => {
    await authenticator.getAuthHeadersAsync();
    expect(mockClient.lastBody).toBe(
      'grant_type=client_credentials&client_id=my-client-id&client_secret=my-client-secret&scope=read+write'
    );
  });

  test('bhv authoauthtwoclientcred 010 sends client credentials grant type', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('client_credentials');
  });

  test('bhv authoauthtwoclientcred 005 invalidateAccessToken makes the next call fetch a new token', async () => {
    const first = await authenticator.getAuthHeadersAsync();
    mockClient.responseBody = JSON.stringify({ access_token: 'access-token-456', expires_in: 3600 });
    expect(await authenticator.getAuthHeadersAsync()).toEqual(first);

    authenticator.invalidateAccessToken();
    const second = await authenticator.getAuthHeadersAsync();

    expect(first['Authorization']).toBe('Bearer access-token-123');
    expect(second['Authorization']).toBe('Bearer access-token-456');
  });

  test('bhv authoauthtwoclientcred 011 sends client id and secret', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('client_id')).toBe('my-client-id');
    expect(params.get('client_secret')).toBe('my-client-secret');
  });

  test('bhv authoauthtwoclientcred 013 sends scopes', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('scope')).toBe('read write');
  });

  test('bhv authoauthtwoclientcred 008 returns authorization bearer header', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'tok-abc',
      expires_in: 3600
    });

    const headers = await authenticator.getAuthHeadersAsync();

    expect(headers['Authorization']).toBe('Bearer tok-abc');
  });

  test('bhv authoauthtwoclientcred 012 sends request to token URL', async () => {
    await authenticator.getAuthHeadersAsync();

    expect(mockClient.lastUrl).toBe('https://auth.example.com/token');
  });

  test('bhv authoauthtwoclientcred 004 getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });

  it('bhv authoauthtwoclientcred 007 redacts secret', () => {
    expect(util.inspect(authenticator)).not.toContain('my-client-secret');
    expect(JSON.stringify(authenticator)).not.toContain('my-client-secret');
    expect(util.inspect(authenticator)).toContain('***');
    expect(JSON.stringify(authenticator)).toContain('***');
  });

  test('bhv authoauthtwoclientcred 015 token fetch error is surfaced not swallowed', async () => {
    // oauth-cc-authheaders-error-swallow: a failed client-credentials token
    // exchange must surface to the caller as a thrown error — NOT be
    // swallowed into an empty header map that would send the API request
    // unauthenticated and produce a confusing downstream 401.
    mockClient.responseStatus = 401;
    mockClient.responseBody = JSON.stringify({ error: 'invalid_client' });

    await expect(authenticator.getAuthHeadersAsync()).rejects.toBeInstanceOf(OAuth2ServerError);
    await expect(authenticator.getAuthHeadersAsync()).rejects.toMatchObject({
      statusCode: 401,
      code: 'invalid_client'
    });
  });

  test('bhv misc 198 a new grant without expires_in clears the expiry of the previous token', async () => {
    const sendSpy = jest.spyOn(mockClient, 'sendRequest');
    mockClient.responseBody = JSON.stringify({ access_token: 'expiring-cc-token', expires_in: 0 });
    expect(await authenticator.getAuthHeadersAsync()).toEqual({ Authorization: 'Bearer expiring-cc-token' });

    mockClient.responseBody = JSON.stringify({ access_token: 'open-cc-token' });
    expect(await authenticator.getAuthHeadersAsync()).toEqual({ Authorization: 'Bearer open-cc-token' });
    expect(await authenticator.getAuthHeadersAsync()).toEqual({ Authorization: 'Bearer open-cc-token' });
    expect(sendSpy).toHaveBeenCalledTimes(2);
  });
  test('bhv authoauthtwoclientcred 003 caches token across calls', async () => {
    // The token manager caches the access token until expiry, so two
    // consecutive header requests reuse the same token and issue only a
    // single token request to the endpoint.
    mockClient.responseBody = JSON.stringify({
      access_token: 'cached-cc-token',
      expires_in: 3600
    });
    const sendSpy = jest.spyOn(mockClient, 'sendRequest');

    const headers1 = await authenticator.getAuthHeadersAsync();
    const headers2 = await authenticator.getAuthHeadersAsync();

    expect(headers1['Authorization']).toBe('Bearer cached-cc-token');
    expect(headers2['Authorization']).toBe('Bearer cached-cc-token');
    expect(sendSpy).toHaveBeenCalledTimes(1);
  });

  test('bhv authoauthtwoclientcred 002 basic auth url-encodes client id and secret', async () => {
    // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
    // client_id and client_secret MUST be application/x-www-form-
    // urlencoded BEFORE being joined with ':' and base64-encoded.
    const basicAuth = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'id+with/special',
      'secret&with=stuff',
      'https://auth.example.com/token',
      ['read'],
      ClientAuthMethod.Basic
    );
    const basicClient = new MockApiClient();
    basicClient.responseBody = JSON.stringify({
      access_token: 'at',
      expires_in: 3600
    });
    basicAuth.setApiClient(basicClient);

    await basicAuth.getAuthHeadersAsync();

    const authHeader = basicClient.lastHeaders['Authorization'];
    expect(authHeader).toBeDefined();
    expect(authHeader.startsWith('Basic ')).toBe(true);
    const decoded = Buffer.from(
      authHeader.substring('Basic '.length),
      'base64'
    ).toString('utf-8');
    expect(decoded).toBe('id%2Bwith%2Fspecial:secret%26with%3Dstuff');
  });

  test('bhv authoauthtwoclientcred 001 basic auth keeps the unreserved tilde literal and percent-encodes * ! \' ( )', async () => {
    // RFC 6749 §2.3.1 form-encoding keeps exactly "-._~" literal and
    // percent-encodes the sub-delimiters "* ! ' ( )".
    const basicAuth = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'a~b*c',
      "d!e'f(g)",
      'https://auth.example.com/token',
      ['read'],
      ClientAuthMethod.Basic
    );
    const basicClient = new MockApiClient();
    basicClient.responseBody = JSON.stringify({ access_token: 'at', expires_in: 3600 });
    basicAuth.setApiClient(basicClient);

    await basicAuth.getAuthHeadersAsync();

    const authHeader = basicClient.lastHeaders['Authorization'];
    const decoded = Buffer.from(authHeader.substring('Basic '.length), 'base64').toString('utf-8');
    expect(decoded).toBe('a~b%2Ac:d%21e%27f%28g%29');
  });

  test('bhv authoauthtwoclientcred 006 the request body keeps the tilde literal and percent-encodes * ! \' ( )', async () => {
    const bodyAuth = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'a~b*c',
      "d!e'f(g)",
      'https://auth.example.com/token',
      ['read']
    );
    const bodyClient = new MockApiClient();
    bodyClient.responseBody = JSON.stringify({ access_token: 'at', expires_in: 3600 });
    bodyAuth.setApiClient(bodyClient);

    await bodyAuth.getAuthHeadersAsync();

    const body = bodyClient.lastBody as string;
    expect(body).toContain('client_id=a~b%2Ac');
    expect(body).toContain('client_secret=d%21e%27f%28g%29');
  });

  test('bhv authoauthtwoclientcred 014 the redacted representation shows exactly the agreed non-secret fields', () => {
    expect(util.inspect(authenticator)).toBe(
      'OAuth2ClientCredentialsAuthenticator(host=https://api.example.com, clientId=my-client-id, clientSecret=***, tokenUrl=https://auth.example.com/token, scopes=[read, write], clientAuthMethod=body)'
    );
    expect(JSON.parse(JSON.stringify(authenticator))).toEqual(
      { host: 'https://api.example.com', clientId: 'my-client-id', clientSecret: '***' }
    );
  });
});

describe('OAuth2ClientCredentialsAuthenticator token URL', () => {
  it('bhv misc 063 the token request goes to the configured token URL', async () => {
    const client = new MockApiClient();
    client.responseBody = JSON.stringify({ access_token: 'at', expires_in: 3600 });
    const auth = new OAuth2ClientCredentialsAuthenticator(
      'https://api.example.com',
      'cid',
      'sec',
      'https://auth.example.com/oauth/token',
      ['read']
    );
    auth.setApiClient(client);

    await auth.getAuthHeadersAsync();

    expect(client.lastUrl).toBe('https://auth.example.com/oauth/token');
  });
});
