import * as http from 'node:http';
import { StoreApi } from '../../src/api/store-api{{importFileExtension}}';
import { Configuration } from '../../src/configuration{{importFileExtension}}';
import { Order, OrderStatusEnum } from '../../src/models/index{{importFileExtension}}';

const baseUrl = process.env.API_BASE_URL || 'http://localhost:4010';
const config = Configuration.builder()
  .baseUrl(baseUrl)
  .defaultHeader('Authorization', 'Bearer test-token')
  .build();
const api = new StoreApi(undefined, config);

describe('StoreApi', () => {
  beforeAll(async () => {
    for (let i = 0; i < 5; i++) {
      try {
        await fetch(baseUrl, { method: 'GET' });
        return;
      } catch {
        await new Promise(resolve => setTimeout(resolve, 500));
      }
    }
  });

  test('getInventory', async () => {
    const result = await api.getInventory();

    expect(result).toBeDefined();
    expect(typeof result).toBe('object');
  });

  test('placeOrder', async () => {
    const order: Order = {
      id: 1,
      petId: 12345,
      quantity: 1,
      shipDate: new Date(),
      status: OrderStatusEnum.Placed,
      complete: false,
    };

    const result = await api.placeOrder(order);

    expect(result).toBeDefined();
    expect(result.id).toBeDefined();
  });

  test('getInventoryWithHttpInfo', async () => {
    const result = await api.getInventoryWithHttpInfo();

    expect(result).toBeDefined();
    expect(result.statusCode).toBeGreaterThanOrEqual(200);
    expect(result.statusCode).toBeLessThan(300);
    expect(result.data).toBeDefined();
  });

  test('placeOrderWithHttpInfo', async () => {
    const order: Order = {
      id: 1,
      petId: 12345,
      quantity: 1,
      shipDate: new Date(),
      status: OrderStatusEnum.Placed,
      complete: false,
    };

    const result = await api.placeOrderWithHttpInfo(order);

    expect(result).toBeDefined();
    expect(result.statusCode).toBeGreaterThanOrEqual(200);
    expect(result.statusCode).toBeLessThan(300);
    expect(result.data).toBeDefined();
  });

  test('getOrderById', async () => {
    const result = await api.getOrderById(1);

    expect(result).toBeDefined();
    expect(result.id).toBeDefined();
  });

  test('getOrderByIdWithHttpInfo', async () => {
    const result = await api.getOrderByIdWithHttpInfo(1);

    expect(result).toBeDefined();
    expect(result.statusCode).toBeGreaterThanOrEqual(200);
    expect(result.statusCode).toBeLessThan(300);
    expect(result.data).toBeDefined();
  });

  test('deleteOrder', async () => {
    await api.deleteOrder(1);
  });
});

function createMockServer(status: number, contentType: string, body: string): Promise<{ api: StoreApi; server: http.Server; close: () => void }> {
  return new Promise((resolve) => {
    const server = http.createServer((_req, res) => {
      res.writeHead(status, { 'Content-Type': contentType });
      res.end(body);
    });
    server.listen(0, '127.0.0.1', () => {
      const addr = server.address() as { port: number };
      const mockConfig = Configuration.builder()
        .baseUrl(`http://127.0.0.1:${addr.port}`)
        .build();
      const mockApi = new StoreApi(undefined, mockConfig);
      resolve({ api: mockApi, server, close: () => server.close() });
    });
  });
}

describe('StoreApi error handling', () => {
  test('getOrderById 404 throws error', async () => {
    const { api: mockApi, close } = await createMockServer(404, 'application/json', '{"message":"Order not found"}');
    try {
      await expect(mockApi.getOrderById(99999)).rejects.toThrow();
    } finally {
      close();
    }
  });

  test('placeOrder 500 throws error', async () => {
    const { api: mockApi, close } = await createMockServer(500, 'application/json', '{"message":"Internal server error"}');
    try {
      const order: Order = {
        id: 1,
        petId: 12345,
        quantity: 1,
        shipDate: new Date(),
        status: OrderStatusEnum.Placed,
        complete: false,
      };
      await expect(mockApi.placeOrder(order)).rejects.toThrow();
    } finally {
      close();
    }
  });

  test('deleteOrder 404 throws error', async () => {
    const { api: mockApi, close } = await createMockServer(404, 'application/json', '{"message":"Order not found"}');
    try {
      await expect(mockApi.deleteOrder(99999)).rejects.toThrow();
    } finally {
      close();
    }
  });
});
