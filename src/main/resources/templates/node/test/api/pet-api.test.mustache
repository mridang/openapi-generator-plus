// Canonical form-urlencoded body behaviors (#1 array -> repeated keys,
// #2 optional null/absent -> omitted, #3 space -> '+'). setPetPreferences
// posts an application/x-www-form-urlencoded body; a local capturing server
// records the exact wire bytes so the assertions check the encoded form, not
// just a round-trip status.
describe('PetApi form-urlencoded body serialization', () => {
  function captureFormBody(): Promise<{
    api: PetApi;
    getCapture: () => { body: string; requestContentType: string | undefined };
    close: () => void;
  }> {
    return new Promise((resolve) => {
      let captured = { body: '', requestContentType: undefined as string | undefined };
      const server = http.createServer((req, res) => {
        let body = '';
        req.on('data', (chunk: Buffer) => (body += chunk.toString('utf-8')));
        req.on('end', () => {
          captured = { body, requestContentType: req.headers['content-type'] };
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end('{"code":200,"type":"ok","message":"saved"}');
        });
      });
      server.listen(0, '127.0.0.1', () => {
        const addr = server.address() as { port: number };
        const cfg = Configuration.builder()
          .baseUrl(`http://127.0.0.1:${addr.port}`)
          .build();
        resolve({
          api: new PetApi(undefined, cfg),
          getCapture: () => captured,
          close: () => server.close(),
        });
      });
    });
  }

  test('bhv operations 156 setPetPreferences sends its form fields in the declared order', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = { note: 'calm', nickname: 'Rex', tags: ['fast'] };
      await api.setPetPreferences(1, options);
      expect([...new URLSearchParams(getCapture().body).keys()]).toEqual(['nickname', 'tags', 'note']);
    } finally {
      close();
    }
  });

  // #1 — an array form field is emitted as repeated keys (tags=a&tags=b),
  // never a single comma-joined value (tags=a%2Cb).
  test('bhv serializationwire 053 an array form field emits repeated keys', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = { nickname: 'Rex', tags: ['fast', 'loyal'] };
      await api.setPetPreferences(1, options);
      const { body } = getCapture();
      expect(body).toContain('tags=fast');
      expect(body).toContain('tags=loyal');
      expect(body).not.toContain('tags=fast%2Cloyal');
      expect(body).not.toContain('tags=fast,loyal');
    } finally {
      close();
    }
  });

  // #2 — an optional field that is absent (or null) is omitted from the
  // body entirely, never serialized as the literal string "undefined"/"null".
  test('#2 absent optional form field is omitted', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = { nickname: 'Rex' };
      await api.setPetPreferences(1, options);
      const { body } = getCapture();
      expect(body).toContain('nickname=Rex');
      expect(body).not.toContain('note');
      expect(body).not.toContain('tags');
      expect(body).not.toContain('undefined');
      expect(body).not.toContain('null');
    } finally {
      close();
    }
  });

  // #3 — spaces in a form-body value are encoded as '+', not %20, the
  // canonical application/x-www-form-urlencoded encoding.
  test('bhv serializationwire 055 a space in a form value encodes as plus', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = { nickname: 'good boy', note: 'very fast' };
      await api.setPetPreferences(1, options);
      const { body, requestContentType } = getCapture();
      expect(requestContentType).toContain('application/x-www-form-urlencoded');
      expect(body).toContain('nickname=good+boy');
      expect(body).toContain('note=very+fast');
      expect(body).not.toContain('%20');
    } finally {
      close();
    }
  });

  // #4 — a `format: date` form field (renewalDate) is date-only on the wire:
  // renewalDate=2024-01-01, with no time component (java's LocalDate form).
  test('bhv operations 019 date-only form field serializes as YYYY-MM-DD', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = {
        nickname: 'Rex',
        renewalDate: new Date(Date.UTC(2024, 0, 1, 13, 45, 30)),
      };
      await api.setPetPreferences(1, options);
      const { body } = getCapture();
      const params = new URLSearchParams(body);
      expect(params.get('renewalDate')).toBe('2024-01-01');
      expect(body).not.toContain('T13');
      expect(body).not.toContain('%3A');
    } finally {
      close();
    }
  });

  test('bhv operations 075 set_pet_preferences serialises the date-time form field in the canonical form', async () => {
    const { api, getCapture, close } = await captureFormBody();
    try {
      const options: SetPetPreferencesOptions = {
        nickname: 'Rex',
        reminder: new Date(Date.UTC(2024, 0, 15, 10, 30, 0)),
      };
      await api.setPetPreferences(1, options);
      const { body } = getCapture();
      expect(body).toContain('reminder=2024-01-15T10%3A30%3A00.000%2B00%3A00');
      expect(body).not.toContain('%20');
    } finally {
      close();
    }
  });
});

// Cross-SDK multipart parity — addPetPhotos sends a multipart/form-data body
// whose `metadata` part is a PhotoMetadata MODEL serialized as JSON. That model
// part must be routed through the configured ObjectSerializer so it carries the
// WIRE property names (isPrimary, takenAt — never snake_case is_primary /
// taken_at) and the SDK's own date-time format. A local capturing server records
// the exact raw multipart bytes so the assertions inspect the on-the-wire JSON,
// not just a round-trip status.
describe('PetApi multipart model-part serialization', () => {
  function captureMultipartBody(): Promise<{
    api: PetApi;
    getCapture: () => { body: string; requestContentType: string | undefined };
    close: () => void;
  }> {
    return new Promise((resolve) => {
      let captured = { body: '', requestContentType: undefined as string | undefined };
      const server = http.createServer((req, res) => {
        const chunks: Buffer[] = [];
        req.on('data', (chunk: Buffer) => chunks.push(chunk));
        req.on('end', () => {
          captured = {
            body: Buffer.concat(chunks).toString('utf-8'),
            requestContentType: req.headers['content-type'],
          };
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end('[{"id":1,"url":"u"}]');
        });
      });
      server.listen(0, '127.0.0.1', () => {
        const addr = server.address() as { port: number };
        const cfg = Configuration.builder()
          .baseUrl(`http://127.0.0.1:${addr.port}`)
          .build();
        resolve({
          api: new PetApi(undefined, cfg),
          getCapture: () => captured,
          close: () => server.close(),
        });
      });
    });
  }

  test('model part uses wire property names and SDK date-time format', async () => {
    const { api, getCapture, close } = await captureMultipartBody();
    try {
      const files = [Buffer.from([0xFF, 0xD8, 0xFF])];
      const metadata = new PhotoMetadata({
        isPrimary: true,
        takenAt: new Date('2020-01-02T03:04:05.123Z'),
      });

      // The convenience method deserializes the response body, so wrap it the
      // same way the neighbouring capture tests do.
      try {
        await api.addPetPhotos(1, { files, metadata });
      } catch {
        // Deserialization of the canned response is irrelevant here; the
        // assertions below inspect the OUTGOING multipart body only.
      }

      const { body, requestContentType } = getCapture();
      expect(requestContentType).toContain('multipart/form-data');

      // Isolate the JSON `metadata` part from the multipart body.
      const metadataPart = body
        .split(/--[^\r\n]+\r\n/)
        .find((part) => part.includes('name="metadata"'));
      expect(metadataPart).toBeDefined();
      const jsonText = (metadataPart as string)
        .split('\r\n\r\n')[1]
        .replace(/\r\n[\s\S]*$/, '');
      const modelPart = JSON.parse(jsonText) as Record<string, unknown>;

      // Wire keys, not snake_case.
      expect(modelPart).toHaveProperty('isPrimary', true);
      expect(modelPart).toHaveProperty('takenAt');
      expect(Object.keys(modelPart)).not.toContain('is_primary');
      expect(Object.keys(modelPart)).not.toContain('taken_at');
      expect(jsonText).toContain('"isPrimary"');
      expect(jsonText).toContain('"takenAt"');
      expect(jsonText).not.toContain('is_primary');
      expect(jsonText).not.toContain('taken_at');

      // date-time carries the SDK's offset format (the equivalent of the
      // 2020-01-02T03:04:05.123Z input), not Date.toJSON()'s trailing `Z`.
      expect(modelPart.takenAt).toBe('2020-01-02T03:04:05.123+00:00');
    } finally {
      close();
    }
  });
});

// Cross-SDK content-type-selector parity — uploadPetDocument declares MULTIPLE
// request content types (multipart/form-data AND application/octet-stream).
// The per-call `requestContentType` argument MUST steer how the body is framed on the
// wire:
//   * multipart/form-data  -> a multipart/form-data envelope (boundary, parts)
//   * application/octet-stream -> the RAW file bytes verbatim, with no
//     multipart boundary, no Content-Disposition headers, and no base64
//     re-encoding — mirroring setPetAvatar's single-binary raw-Buffer path.
// A local capturing server records the exact outbound Content-Type and raw body
// bytes so the assertions inspect the on-the-wire framing, not just a 2xx.
describe('PetApi request content-type selector', () => {
  function captureRawBody(): Promise<{
    api: PetApi;
    getCapture: () => { body: Buffer; requestContentType: string | undefined };
    close: () => void;
  }> {
    return new Promise((resolve) => {
      let captured = {
        body: Buffer.alloc(0),
        requestContentType: undefined as string | undefined,
      };
      const server = http.createServer((req, res) => {
        const chunks: Buffer[] = [];
        req.on('data', (chunk: Buffer) => chunks.push(chunk));
        req.on('end', () => {
          captured = {
            body: Buffer.concat(chunks),
            requestContentType: req.headers['content-type'],
          };
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end('{"code":200,"type":"ok","message":"stored"}');
        });
      });
      server.listen(0, '127.0.0.1', () => {
        const addr = server.address() as { port: number };
        const cfg = Configuration.builder()
          .baseUrl(`http://127.0.0.1:${addr.port}`)
          .build();
        resolve({
          api: new PetApi(undefined, cfg),
          getCapture: () => captured,
          close: () => server.close(),
        });
      });
    });
  }

  // OCTET-STREAM-RAW-BODY: selecting application/octet-stream must send the
  // single binary part's RAW bytes as the request body — never a multipart
  // envelope and never base64.
  test('bhv operations 092 octet-stream selection sends raw bytes, not multipart', async () => {
    const { api, getCapture, close } = await captureRawBody();
    try {
      const fileBytes = Buffer.from([0x25, 0x50, 0x44, 0x46, 0x00, 0x01, 0x02, 0xFF]);
      const options: UploadPetDocumentOptions = { file: fileBytes };

      try {
        await api.uploadPetDocument(1, options, 'application/octet-stream');
      } catch {
        // The canned JSON response is irrelevant; the assertions below inspect
        // the OUTGOING request framing only.
      }

      const { body, requestContentType } = getCapture();

      // The outbound Content-Type is the selected raw binary type, with no
      // multipart boundary parameter.
      expect(requestContentType).toBe('application/octet-stream');
      expect(requestContentType).not.toContain('multipart/form-data');
      expect(requestContentType).not.toContain('boundary');

      // The body is the exact bytes handed in — byte-for-byte, no envelope.
      expect(Buffer.isBuffer(body)).toBe(true);
      expect(body.equals(fileBytes)).toBe(true);

      // Defensive: none of the multipart envelope markers leak into the body,
      // and the bytes are not base64-re-encoded.
      const bodyText = body.toString('latin1');
      expect(bodyText).not.toContain('Content-Disposition');
      expect(bodyText).not.toContain('name="file"');
      expect(bodyText).not.toContain('--');
      expect(bodyText).not.toBe(fileBytes.toString('base64'));
    } finally {
      close();
    }
  });

  // Over-correction guard: selecting multipart/form-data (the default) still
  // frames the body as a multipart/form-data envelope carrying the file part.
  test('bhv operations 094 multipart selection still sends a multipart envelope', async () => {
    const { api, getCapture, close } = await captureRawBody();
    try {
      const fileBytes = Buffer.from([0x25, 0x50, 0x44, 0x46, 0x00, 0x01, 0x02, 0xFF]);
      const options: UploadPetDocumentOptions = {
        file: fileBytes,
        documentType: UploadPetDocumentDocumentTypeEnum.HealthCertificate,
      };

      try {
        await api.uploadPetDocument(1, options, 'multipart/form-data');
      } catch {
        // Canned response irrelevant; inspecting the OUTGOING framing only.
      }

      const { body, requestContentType } = getCapture();
      expect(requestContentType).toContain('multipart/form-data');
      expect(requestContentType).toContain('boundary=');

      const bodyText = body.toString('latin1');
      expect(bodyText).toContain('Content-Disposition: form-data');
      expect(bodyText).toContain('name="file"');
    } finally {
      close();
    }
  });

  test('bhv operations 147 multipart parts are sent in declaration order', async () => {
    const { api, getCapture, close } = await captureRawBody();
    try {
      // The options are handed over in the reverse of the declared order.
      const options: UploadPetDocumentOptions = {
        notes: 'n',
        documentType: UploadPetDocumentDocumentTypeEnum.HealthCertificate,
        file: Buffer.from([0x25, 0x50, 0x44, 0x46]),
      };

      await api.uploadPetDocument(1, options, 'multipart/form-data').catch(() => undefined);

      const bodyText = getCapture().body.toString('latin1');
      const positions = ['file', 'documentType', 'notes'].map((name) => bodyText.indexOf(`name="${name}"`));
      expect(positions.every((position) => position >= 0)).toBe(true);
      expect([...positions].sort((a, b) => a - b)).toEqual(positions);
    } finally {
      close();
    }
  });

  test('bhv operations 072 setPetAvatar with the JSON selector sends the binary body verbatim', async () => {
    const { api, getCapture, close } = await captureRawBody();
    try {
      const bytes = Buffer.from([0xff, 0xd8, 0xff, 0xe0]);
      await api.setPetAvatar(1, bytes, 'application/json').catch(() => undefined);

      const { body, requestContentType } = getCapture();
      expect(requestContentType).toBe('application/json');
      expect(body.equals(bytes)).toBe(true);
    } finally {
      close();
    }
  });

  test('bhv operations 077 setPetAvatarThumbnail still sends a format:byte JSON body as base64', async () => {
    const { api, getCapture, close } = await captureRawBody();
    try {
      await api.setPetAvatarThumbnail(1, Buffer.from([1, 2, 3, 4])).catch(() => undefined);

      expect(getCapture().body.toString('utf-8')).toBe('"AQIDBA=="');
    } finally {
      close();
    }
  });
});

describe('PetApi operation servers', () => {
