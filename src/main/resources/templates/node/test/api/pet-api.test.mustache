describe('PetApi doc comments', () => {
  const source = fs.readFileSync(path.join(process.cwd(), 'src/api/pet-api.ts'), 'utf8');

  test('a parameter description keeps its quotes, angle brackets and ampersand raw', () => {
    expect(source).toContain(String.raw`* @param options.session Session token: \"a<b>\" & it's required (required)`);
  });

  test('no doc comment carries an HTML entity', () => {
    expect(source).not.toMatch(/&(#\d+|#x[0-9a-f]+|[a-z]+);/i);
  });

  test.each([
    ['deletePet', '* @param options options for query, header, form, and cookie parameters\n'],
    ['getPetSummary', '* @param options options for query, header, form, and cookie parameters\n'],
  ])('%s documents its options argument', (operation, line) => {
    const start = source.lastIndexOf('/**', source.indexOf(`  async ${operation}(`));
    const doc = source.slice(start, source.indexOf(`  async ${operation}(`));

    expect(doc).toContain(line);
  });

  test('bhv operations 032 a deprecated operation carries the deprecated doc tag', () => {
    const start = source.lastIndexOf('/**', source.indexOf('  async findPetsByStatus('));
    expect(source.slice(start, source.indexOf('  async findPetsByStatus('))).toContain('@deprecated');
  });

  test('bhv operations 033 every variant of a deprecated operation carries the deprecated doc tag', () => {
    for (const name of ['findPetsByStatus', 'findPetsByStatusWithHttpInfo']) {
      const start = source.lastIndexOf('/**', source.indexOf(`  async ${name}(`));
      expect(source.slice(start, source.indexOf(`  async ${name}(`))).toContain('@deprecated');
    }
  });
});

describe('PetApi against a recording client', () => {
  const recorded: Array<{ method: string; url: string; headers: Record<string, string> }> = [];
  const recordingClient: ApiClient = {
    async sendRequest(method: string, url: string, headers: Record<string, string>): Promise<ApiHttpResponse> {
      recorded.push({ method, url, headers });
      return {
        statusCode: 200,
        body: url.includes('/pet/born-on/') ? '[]' : '{"id":7,"name":"recorded","photoUrls":[]}',
        headers: { 'content-type': 'application/json' },
      };
    },
  };
  const recordingApi = new PetApi(
    recordingClient,
    Configuration.builder().baseUrl('https://client-base.example.com').build(),
  );

  beforeEach(() => {
    recorded.length = 0;
  });

  test('bhv operations 083 the generated operation-server variants resolve the URLs the spec declares', () => {
    expect(new GetExternalPetInfoServerServer0().getUrl()).toBe('https://external-api.example.com/v1');
    expect(new GetMultiServerPetInfoServerPrimary().getUrl()).toBe('https://primary.example.com/v1');
    expect(new GetMultiServerPetInfoServerRegional(GetMultiServerPetInfoServerRegionalRegion.EU).getUrl()).toBe(
      'https://eu.example.com/v1',
    );
    expect(
      new GetStagingPetInfoServerStagingServer(
        GetStagingPetInfoServerEnvironment.SANDBOX,
        GetStagingPetInfoServerVersion.V3,
      ).getUrl(),
    ).toBe('https://sandbox.example.com/api/v3');
  });

  test('getExternalPetInfo sends the request to the generated variant', async () => {
    await recordingApi.getExternalPetInfo(1, new GetExternalPetInfoServerServer0());

    expect(recorded).toHaveLength(1);
    expect(recorded[0]!.url.startsWith('https://external-api.example.com/v1/')).toBe(true);
  });

  test('getStagingPetInfo sends the request to the variant with its variables substituted', async () => {
    await recordingApi.getStagingPetInfo(
      1,
      new GetStagingPetInfoServerStagingServer(
        GetStagingPetInfoServerEnvironment.SANDBOX,
        GetStagingPetInfoServerVersion.V3,
      ),
    );

    expect(recorded).toHaveLength(1);
    expect(recorded[0]!.url.startsWith('https://sandbox.example.com/api/v3/')).toBe(true);
  });

  test('bhv operations 085 the multi-server operation offers a fixed and a templated server', async () => {
    const rows: Array<[unknown, string]> = [
      [new GetMultiServerPetInfoServerPrimary(), 'https://primary.example.com/v1/'],
      [new GetMultiServerPetInfoServerRegional(GetMultiServerPetInfoServerRegionalRegion.AP), 'https://ap.example.com/v1/'],
    ];
    for (const [server, prefix] of rows) {
      recorded.length = 0;
      await recordingApi.getMultiServerPetInfo(1, server as Parameters<typeof recordingApi.getMultiServerPetInfo>[1]);

      expect(recorded).toHaveLength(1);
      expect(recorded[0]!.url.startsWith(prefix)).toBe(true);
    }
  });

  test('bhv operations 084 the mirror operation server resolves reserved characters raw', async () => {
    const rows: Array<[GetMultiServerPetInfoServerChannel, string]> = [
      [GetMultiServerPetInfoServerChannel.A_B, 'https://eu.mirror.example.com/a&b/v1/pet/3/multi'],
      [GetMultiServerPetInfoServerChannel.IT_S, "https://eu.mirror.example.com/it's/v1/pet/3/multi"],
    ];
    for (const [channel, expected] of rows) {
      recorded.length = 0;
      await recordingApi.getMultiServerPetInfo(
        3,
        new GetMultiServerPetInfoServerMirror(GetMultiServerPetInfoServerMirrorRegion.EU, channel),
      );

      expect(recorded).toHaveLength(1);
      expect(recorded[0]!.url).toBe(expected);
    }
  });

  test('bhv operations 051 getPetByName rejects a dot segment before dispatch', async () => {
    for (const name of ['.', '..']) {
      const error = await recordingApi
        .getPetByName(name, { category: 'sample', xCorrelationId: 'sample-correlation' })
        .catch((e: unknown) => e);

      expect((error as Error).constructor).toBe(TypeError);
      expect((error as Error).message).toBe(`Path parameter 'name' must not be '.' or '..'`);
    }
    expect(recorded).toHaveLength(0);
  });

  test('bhv operations 064 getPetByName keeps a name that only contains dots', async () => {
    await recordingApi.getPetByName('a..b', { category: 'sample', xCorrelationId: 'sample-correlation' });

    expect(recorded).toHaveLength(1);
    expect(recorded[0]!.url).toContain('/pet/byName/a..b?');
  });

  test.each(['a$&b', 'US$$', "x$'y", '$1'])(
    'getPetByName puts the value %p in the path as written, never as a replacement pattern',
    async (name) => {
      await recordingApi.getPetByName(name, { category: 'sample', xCorrelationId: 'sample-correlation' });

      expect(recorded).toHaveLength(1);
      expect(recorded[0]!.url).toContain(`/pet/byName/${name}?`);
    }
  );

  test('bhv serializationparam 122 an allowReserved query value keeps its reserved characters literal on the wire', async () => {
    await recordingApi.getPetTag(5, 'sample', { revision: 'v1.0/beta:rc1@x,y;z=1' });

    expect(recorded[0]!.url).toContain('revision=v1.0/beta:rc1@x,y;z=1');
