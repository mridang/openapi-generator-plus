function createMockServer(status: number, requestContentType: string, body: string): Promise<{ api: PetApi; server: http.Server; close: () => void }> {
  return new Promise((resolve) => {
    const server = http.createServer((_req, res) => {
      res.writeHead(status, { 'Content-Type': requestContentType });
      res.end(body);
    });
    server.listen(0, '127.0.0.1', () => {
      const addr = server.address() as { port: number };
      const mockConfig = Configuration.builder()
        .baseUrl(`http://127.0.0.1:${addr.port}`)
        .build();
      const mockApi = new PetApi(new DefaultApiClient(TransportOptions.builder().maxRetries(0).build()), mockConfig);
      resolve({ api: mockApi, server, close: () => server.close() });
    });
  });
}

