  test('bhv operations 030 deletePet sends a legal cookie value raw', async () => {
    // Control: a value with no forbidden characters must pass validation and
    // reach the wire as a Cookie header (proves the guard is value-specific,
    // not a blanket rejection of the cookie path).
    let capturedCookie: string | undefined;
    const server = http.createServer((req, res) => {
      capturedCookie = req.headers['cookie'];
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('');
    });
    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
    try {
      const addr = server.address() as { port: number };
      const cfg = Configuration.builder().baseUrl(`http://127.0.0.1:${addr.port}`).build();
      const cookieApi = new PetApi(undefined, cfg);
      await cookieApi.deletePet(1, { apiKey: 'session-abc123' });
      expect(capturedCookie).toContain('api_key=session-abc123');
    } finally {
