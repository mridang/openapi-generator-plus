  describe('credentials per security scheme', () => {
    const host = 'https://client-base.example.com';
    const config = Configuration.builder().baseUrl(host).build();
    const bearer = new BearerAuthenticator(host, 'bearer-token');
    const apiKey = new ApiKeyAuthenticator(host, 'X-Api-Key', 'key-token', ApiKeyLocation.HEADER);
    const fallback = new BearerAuthenticator(host, 'fallback-token');
    const newPet = () => new Pet({ id: 1, name: 'x', photoUrls: new Set<string>() });

    test('bhv operations 079 an operation uses the credential of the scheme its spec names', async () => {
      const petApi = new PetApi(recordingClient, config, null, { petStoreBearer: bearer });

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['Authorization']).toBe('Bearer bearer-token');
    });

    test('bhv operations 080 an operation uses the first scheme of its own list that the client holds', async () => {
      const petApi = new PetApi(recordingClient, config, null, { petStoreBearer: bearer, apiKeyHeader: apiKey });

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['X-Api-Key']).toBe('key-token');
      expect(recorded[0]!.headers['Authorization']).toBeUndefined();
    });

    test('bhv operations 020 a credential held for a scheme the operation does not name is never sent', async () => {
      const petApi = new PetApi(recordingClient, config, null, { adminBasic: apiKey });

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['X-Api-Key']).toBeUndefined();
      expect(recorded[0]!.headers['Authorization']).toBeUndefined();
    });

    test('bhv operations 026 an operation no scheme credential matches uses the client-level authenticator', async () => {
      const petApi = new PetApi(recordingClient, config, fallback, { adminBasic: apiKey });

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['Authorization']).toBe('Bearer fallback-token');
      expect(recorded[0]!.headers['X-Api-Key']).toBeUndefined();
    });

    test('a scheme credential wins over the client-level authenticator', async () => {
      const petApi = new PetApi(recordingClient, config, fallback, { petStoreBearer: bearer });

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['Authorization']).toBe('Bearer bearer-token');
    });

    test('bhv operations 078 addPet uses the configured credentials when no scheme credential is held', async () => {
      const configured = Configuration.builder()
        .baseUrl(host)
        .defaultHeader('Authorization', 'Bearer configured-token')
        .build();
      const petApi = new PetApi(recordingClient, configured, null, {});

      await petApi.addPet(newPet());

      expect(recorded[0]!.headers['Authorization']).toBe('Bearer configured-token');
    });

    test('bhv operations 081 addPet without an Options object completes with the configured credentials', async () => {
      const server = http.createServer((req, res) => {
        const accepted = req.headers.authorization === 'Bearer configured-token';
        res.writeHead(accepted ? 200 : 401, { 'Content-Type': 'application/json' });
        res.end(accepted ? '{"id":7,"name":"recorded","photoUrls":[]}' : '{"message":"Unauthorized"}');
      });
      await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', () => resolve()));
      try {
        const addr = server.address() as { port: number };
        const configured = Configuration.builder()
          .baseUrl(`http://127.0.0.1:${addr.port}`)
          .defaultHeader('Authorization', 'Bearer configured-token')
          .build();
        const petApi = new PetApi(
          new DefaultApiClient(TransportOptions.builder().maxRetries(0).build()),
          configured,
          null,
          {},
        );

        const pet = await petApi.addPet(newPet());

        expect(pet.name).toBe('recorded');
      } finally {
        server.close();
      }
    });

    test('bhv operations 082 no operation options offers a per call authenticator', () => {
      const dir = path.join(process.cwd(), 'src/api/options');
      const files = fs.readdirSync(dir).filter((name) => name.endsWith('.ts') && name !== 'index.ts');

      expect(files.length).toBeGreaterThan(0);
      for (const name of files) {
        const source = fs.readFileSync(path.join(dir, name), 'utf8');
        expect(source).not.toMatch(/^\s*(readonly\s+)?auth\??\s*:/m);
        expect(source).not.toMatch(/Authenticator/);
      }
    });

    test('bhv operations 086 there is no per-call authenticator: no Options object has an auth member', async () => {
      const options = fs.readFileSync(path.join(process.cwd(), 'src/api/options/delete-pet-options.ts'), 'utf8');

      expect(options).not.toMatch(/\bauth\b/);
      expect(fs.existsSync(path.join(process.cwd(), 'src/api/options/add-pet-options.ts'))).toBe(false);
      // @ts-expect-error an Options object takes no per-call authenticator
      await recordingApi.deletePet(1, { auth: bearer });
    });
  });
