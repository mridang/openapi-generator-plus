    [401, UnauthorizedError],
    [403, ForbiddenError],
    [404, NotFoundError],
    [409, ConflictError],
    [418, ClientError],
    [422, UnprocessableEntityError],
    [500, InternalServerError],
    [502, ServerError],
  ])('bhv operations 138 getPetById picks the status-specific error for status %i', async (status, expected) => {
    const statusApi = new PetApi(
      new DefaultApiClient(TransportOptions.builder().maxRetries(0).build()),
      Configuration.builder().baseUrl(`${baseUrl}/test/status/${status}`).build(),
    );

    const error = await statusApi.getPetById(1).catch((e: unknown) => e);

    expect((error as Error).constructor).toBe(expected);
    expect((error as ClientError).statusCode).toBe(status);
  });

  test('bhv operations 034 download binary mock', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/octet-stream', 'FAKE_BINARY_DATA');
    try {
      const result = await mockApi.getPetAvatar(1);
      expect(result).toBeDefined();
    } finally {
      close();
    }
  });

  // A top-level `type: string, format: byte` value carried as application/json
  // arrives as a JSON string literal (quotes included). The SDK must JSON-parse
  // it and then base64-decode the inner string to the raw bytes.
  test('bhv operations 062 getPetAvatarThumbnail decodes a JSON string literal as base64 bytes', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/json', '"dGVzdC1pbWFnZQ=="');
    try {
      const result = await mockApi.getPetAvatarThumbnail(1);
      expect(Buffer.isBuffer(result)).toBe(true);
      expect(result).toEqual(Buffer.from('test-image'));
      expect(result.toString('utf8')).toBe('test-image');
    } finally {
      close();
    }
  });

  test('bhv operations 089 upload multipart mock', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/json', '{"code":200,"type":"","message":"success"}');
    try {
      const file = Buffer.from([0x25, 0x50, 0x44, 0x46]);
      const result = await mockApi.uploadPetCertificate(1, { file });
      expect(result).toBeDefined();
    } finally {
      close();
    }
  });

  // convenience-empty-body-handling: a body-returning operation that receives a
  // 200 with an empty body must surface a typed ApiError from the plain
  // convenience method, never a silently-cast undefined.
  test('bhv operations 036 empty body on a body-returning op throws ApiError', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/json', '');
    try {
      await expect(mockApi.getPetById(1)).rejects.toBeInstanceOf(ApiError);
      await expect(mockApi.getPetById(1)).rejects.toThrow(
        'Expected a response body for getPetById but received none',
      );
    } finally {
      close();
    }
  });

  test('bhv operations 136 a bare JSON null body from a model operation throws an ApiError naming the operation', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/json', 'null');
    try {
      await expect(mockApi.getPetById(1)).rejects.toBeInstanceOf(ApiError);
      await expect(mockApi.getPetById(1)).rejects.toThrow(
        'Expected a response body for getPetById but received none',
      );
    } finally {
      close();
    }
  });

  // Canonical #11 — a malformed 2xx response body must FAIL LOUD. The
  // convenience method routes the body through ObjectSerializer.parseJson and
  // the model deserializer; both throw, so the error propagates instead of the
  // raw string being returned. Two failure modes are exercised: syntactically
  // broken JSON (parse error) and well-formed JSON of the wrong shape (a Pet
  // payload missing the required `name`, which the deserializer rejects).
  test('bhv operations 130 a malformed 2xx JSON body propagates the deserialization error', async () => {
    const { api: mockApi, close } = await createMockServer(200, 'application/json', '{ not json');
    try {
      // The error propagates instead of the raw string being returned.
      await expect(mockApi.getPetById(1)).rejects.toBeInstanceOf(SerializationError);
    } finally {
      close();
    }
  });

  test('bhv operations 127 a malformed 2xx body fails loud with a serialization error, not returned raw', async () => {
    // 200 with valid JSON whose shape violates the Pet contract (required
    // `name` absent). The model deserializer must throw rather than hand back
    // a partial object or the raw dict.
    const { api: mockApi, close } = await createMockServer(200, 'application/json', '{"id":1,"photoUrls":["u"]}');
    try {
      await expect(mockApi.getPetById(1)).rejects.toBeInstanceOf(SerializationError);
    } finally {
      close();
    }
  });

  // Canonical #6 — an operation cookie param carrying CR/LF (or any control
  // char) must FAIL CLOSED with the RFC-6265 error before any HTTP call.
  // deletePet's optional `api_key` cookie is the path; the guard mirrors the
  // auth-cookie validation in BaseApi.
  test('bhv operations 029 deletePet api_key cookie with CR/LF fails closed (RFC 6265)', async () => {
    await expect(
