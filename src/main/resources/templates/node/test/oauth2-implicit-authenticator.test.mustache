import { inspect } from 'node:util';

import { OAuth2ImplicitAuthenticator } from '../src/auth/oauth/oauth2-implicit-authenticator{{importFileExtension}}';

describe('OAuth2ImplicitAuthenticator', () => {
  let authenticator: OAuth2ImplicitAuthenticator;

  beforeEach(() => {
    authenticator = new OAuth2ImplicitAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'https://auth.example.com/authorize',
      ['read', 'write']
    );
  });

  test('builds authorization URL with response type token', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('https://auth.example.com/authorize?');
    expect(url).toContain('response_type=token');
  });

  test('builds authorization URL with client id', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('client_id=my-client-id');
  });

  test('builds authorization URL with scopes', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('scope=read+write');
  });

  test('builds authorization URL with state', () => {
    const url = authenticator.buildAuthorizationUrl('my-state');
    expect(url).toContain('state=my-state');
  });

  test('getAuthHeaders returns Bearer after setAccessToken', () => {
    authenticator.setAccessToken('implicit-tok');

    const headers = authenticator.getAuthHeaders();

    expect(headers['Authorization']).toBe('Bearer implicit-tok');
  });

  test('throws when access token not set', () => {
    expect(() => authenticator.getAuthHeaders()).toThrow();
  });

  test('getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });

  test('inspect and JSON output redact the access token', () => {
    authenticator.setAccessToken('super-secret-token');

    const inspected = inspect(authenticator);
    const json = JSON.stringify(authenticator);

    expect(inspected).not.toContain('super-secret-token');
    expect(inspected).toContain('***');
    expect(json).not.toContain('super-secret-token');
    expect(json).toContain('***');
  });
});
