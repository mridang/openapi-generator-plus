import * as util from 'node:util';
import { OAuth2ImplicitAuthenticator } from '../src/auth/oauth/oauth2-implicit-authenticator{{importFileExtension}}';

describe('OAuth2ImplicitAuthenticator', () => {
  let authenticator: OAuth2ImplicitAuthenticator;

  beforeEach(() => {
    authenticator = new OAuth2ImplicitAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'https://auth.example.com/authorize',
      ['read', 'write']
    );
  });

  test('builds authorization URL with response type token', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('https://auth.example.com/authorize?');
    expect(url).toContain('response_type=token');
  });

  test('builds authorization URL with client id', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('client_id=my-client-id');
  });

  test('builds authorization URL with scopes', () => {
    const url = authenticator.buildAuthorizationUrl();
    expect(url).toContain('scope=read%20write');
  });

  test('builds authorization URL with state', () => {
    const url = authenticator.buildAuthorizationUrl('my-state');
    expect(url).toContain('state=my-state');
  });

  test('getAuthHeaders returns Bearer after setAccessToken', () => {
    authenticator.setAccessToken('implicit-tok');

    const headers = authenticator.getAuthHeaders();

    expect(headers['Authorization']).toBe('Bearer implicit-tok');
  });

  test('the authorize URL keeps the tilde literal and percent-encodes * ! \' ( )', () => {
    const auth = new OAuth2ImplicitAuthenticator(
      'https://api.example.com',
      "a~b*c!d'e(f)",
      'https://auth.example.com/authorize',
      []
    );

    expect(auth.buildAuthorizationUrl()).toContain('client_id=a~b%2Ac%21d%27e%28f%29');
  });

  test.each([
    ['CR/LF', 'abc\r\nInjected: yes'],
    ['LF', 'abc\ndef'],
    ['NUL', 'abc\0def'],
    ['DEL', 'abc\x7fdef'],
    ['non-ASCII', 'tök']
  ])('setAccessToken rejects a token containing %s', (_label, token) => {
    expect(() => authenticator.setAccessToken(token)).toThrow(TypeError);
    expect(() => authenticator.setAccessToken(token)).toThrow(
      'Access token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
    );
    expect(() => authenticator.getAuthHeaders()).toThrow('Must set the access token before making API requests');
  });

  test('throws when access token not set', () => {
    let caught: unknown;
    try {
      authenticator.getAuthHeaders();
    } catch (e) {
      caught = e;
    }
    expect((caught as Error).constructor).toBe(Error);
    expect((caught as Error).message).toContain('Must set the access token before making API requests');
  });

  test('getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });

  it("redacts the secret in inspect and JSON output", () => {
    authenticator.setAccessToken('implicit-tok');
    expect(util.inspect(authenticator)).not.toContain('implicit-tok');
    expect(JSON.stringify(authenticator)).not.toContain('implicit-tok');
    expect(util.inspect(authenticator)).toContain('***');
    expect(JSON.stringify(authenticator)).toContain('***');
  });

  test('the redacted representation shows exactly the agreed non-secret fields', () => {
    expect(util.inspect(authenticator)).toBe(
      'OAuth2ImplicitAuthenticator(host=https://api.example.com, clientId=my-client-id, authorizationUrl=https://auth.example.com/authorize, scopes=[read, write], accessToken=null)'
    );
    expect(JSON.parse(JSON.stringify(authenticator))).toEqual(
      { host: 'https://api.example.com', clientId: 'my-client-id', authorizationUrl: 'https://auth.example.com/authorize', scopes: ['read', 'write'], accessToken: null }
    );
  });
});
