import { OAuth2TokenManager } from '../src/auth/oauth/oauth2-token-manager{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiResponse } from '../src/api-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responseBody = '';
  responseStatus = 200;
  callCount = 0;

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    this.callCount++;
    return {
      statusCode: this.responseStatus,
      body: this.responseBody,
      headers: { 'content-type': 'application/json' }
    };
  }
}

describe('OAuth2TokenManager', () => {
  let tokenManager: OAuth2TokenManager;
  let mockClient: MockApiClient;

  beforeEach(() => {
    tokenManager = new OAuth2TokenManager();
    mockClient = new MockApiClient();
    tokenManager.setApiClient(mockClient);
  });

  test('extracts access token from response', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'my-access-token',
      expires_in: 3600
    });

    const token = await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });

    expect(token).toBe('my-access-token');
  });

  test('stores refresh token from response', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-123',
      refresh_token: 'refresh-456',
      expires_in: 3600
    });

    await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'authorization_code',
      code: 'auth-code'
    });

    expect(tokenManager.getRefreshToken()).toBe('refresh-456');
  });

  test('returns cached token when not expired', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'token-1',
      expires_in: 3600
    });

    const first = await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });
    const second = await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });

    expect(first).toBe('token-1');
    expect(second).toBe('token-1');
    expect(mockClient.callCount).toBe(1);
  });

  test('detects token expiry and refetches', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'token-1',
      expires_in: 1
    });

    await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });

    // Simulate token expiry by manipulating time
    const originalNow = Date.now;
    Date.now = () => originalNow() + 120_000;

    mockClient.responseBody = JSON.stringify({
      access_token: 'token-2',
      expires_in: 3600
    });

    const token = await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });

    Date.now = originalNow;
    expect(token).toBe('token-2');
  });

  test('setAccessToken bypasses endpoint', async () => {
    tokenManager.setAccessToken('manual-token');

    const token = await tokenManager.getAccessToken('https://auth.example.com/token', {
      grant_type: 'client_credentials'
    });

    expect(token).toBe('manual-token');
    expect(mockClient.callCount).toBe(0);
  });

  test('throws when no ApiClient injected', async () => {
    const manager = new OAuth2TokenManager();

    await expect(
      manager.getAccessToken('https://auth.example.com/token', {
        grant_type: 'client_credentials'
      })
    ).rejects.toThrow();
  });

  test('throws when token request fails', async () => {
    mockClient.responseStatus = 401;
    mockClient.responseBody = JSON.stringify({ error: 'invalid_client' });

    await expect(
      tokenManager.getAccessToken('https://auth.example.com/token', {
        grant_type: 'client_credentials'
      })
    ).rejects.toThrow();
  });
});
