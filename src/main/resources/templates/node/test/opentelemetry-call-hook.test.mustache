import { context, propagation, trace, metrics, SpanKind, SpanStatusCode } from '@opentelemetry/api';
import { AsyncLocalStorageContextManager } from '@opentelemetry/context-async-hooks';
import { W3CTraceContextPropagator } from '@opentelemetry/core';
import { MeterProvider, MetricReader } from '@opentelemetry/sdk-metrics';
import { BasicTracerProvider, InMemorySpanExporter, SimpleSpanProcessor } from '@opentelemetry/sdk-trace-base';
import type { ReadableSpan } from '@opentelemetry/sdk-trace-base';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiHttpResponse } from '../src/api-http-response{{importFileExtension}}';
import { BaseApi } from '../src/api/base-api{{importFileExtension}}';
import type { CallHook, CallInfo } from '../src/call-hook{{importFileExtension}}';
import { Configuration } from '../src/configuration{{importFileExtension}}';
import { DefaultApiClient } from '../src/default-api-client{{importFileExtension}}';
import { NetworkError, NetworkTimeoutError, SerializationError } from '../src/errors/index{{importFileExtension}}';
import { createOpenTelemetryCallHook } from '../src/opentelemetry-call-hook{{importFileExtension}}';
import { TransportOptions } from '../src/transport-options{{importFileExtension}}';

/** A reader the test collects from on demand, so no timer or exporter is involved. */
class CollectingReader extends MetricReader {
  protected onShutdown(): Promise<void> {
    return Promise.resolve();
  }
  protected onForceFlush(): Promise<void> {
    return Promise.resolve();
  }
}

interface Point {
  readonly scope: string;
  readonly version: string | undefined;
  readonly name: string;
  readonly unit: string;
  readonly attributes: Record<string, unknown>;
  readonly value: unknown;
}

class TestableApi extends BaseApi {
  constructor(apiClient: ApiClient, config: Configuration) {
    super(apiClient, config);
  }

  call(path: string, query: Record<string, unknown> = {}, headerParams: Record<string, string> = {}, signal?: AbortSignal) {
    return this.invokeApiForResult(
      'GET', path, query, headerParams, null, ['application/json'], 'application/json', null,
      undefined, false, undefined, '', signal ? { signal } : undefined, undefined, 'getItem', '/items/{id}');
  }
}

const info: CallInfo = {
  operationId: 'getItem',
  method: 'GET',
  urlTemplate: '/items/{id}',
  url: 'https://api.example.com/items/7',
  serverAddress: 'api.example.com'
};

function telemetry() {
  const exporter = new InMemorySpanExporter();
  const tracerProvider = new BasicTracerProvider({ spanProcessors: [new SimpleSpanProcessor(exporter)] });
  const reader = new CollectingReader();
  const meterProvider = new MeterProvider({ readers: [reader] });
  const hook = createOpenTelemetryCallHook({ tracerProvider, meterProvider, propagator: new W3CTraceContextPropagator() });
  const points = async (): Promise<Point[]> => {
    const { resourceMetrics } = await reader.collect();
    return resourceMetrics.scopeMetrics.flatMap((scope) =>
      scope.metrics.flatMap((metric) =>
        metric.dataPoints.map((point) => ({
          scope: scope.scope.name,
          version: scope.scope.version,
          name: metric.descriptor.name,
          unit: metric.descriptor.unit,
          attributes: point.attributes as Record<string, unknown>,
          value: point.value
        }))
      )
    );
  };
  return { hook, exporter, points };
}

/** Runs one call through the hook the way the SDK does and returns what the observer was given. */
function run(hook: CallHook, outcome: { statusCode: number; headers: Record<string, string> | null; error: unknown }, headers: Record<string, string> = {}): void {
  hook.start(info, headers)?.finish(outcome);
}

const ok = { statusCode: 200, headers: {}, error: null };

function scripted(...steps: Array<number | Error>): { client: ApiClient; sent: Array<Record<string, string>> } {
  const sent: Array<Record<string, string>> = [];
  const client: ApiClient = {
    async sendRequest(_method, _url, headers): Promise<ApiHttpResponse> {
      sent.push({ ...headers });
      const step = steps[Math.min(sent.length, steps.length) - 1]!;
      if (step instanceof Error) {
        throw step;
      }
      return { statusCode: step, body: '{}', headers: { 'content-type': 'application/json' } };
    }
  };
  return { client, sent };
}

beforeAll(() => {
  context.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());
  propagation.setGlobalPropagator(new W3CTraceContextPropagator());
});

afterAll(() => {
  context.disable();
  propagation.disable();
});

describe('OpenTelemetryCallHook', () => {
  test('bhv telemetry 001 the span is named with the spec operation id and has kind client', () => {
    const { hook, exporter } = telemetry();

    run(hook, ok);

    const [span] = exporter.getFinishedSpans();
    expect(span!.name).toBe('getItem');
    expect(span!.kind).toBe(SpanKind.CLIENT);
  });

  test('bhv telemetry 002 a 2xx sets the method, the template, the server and the status and leaves the span status unset', () => {
    const { hook, exporter } = telemetry();

    run(hook, ok);

    const [span] = exporter.getFinishedSpans();
    expect(span!.attributes).toEqual({
      'http.request.method': 'GET',
      'url.template': '/items/{id}',
      'server.address': 'api.example.com',
      'http.response.status_code': 200
    });
    expect(span!.status.code).toBe(SpanStatusCode.UNSET);
  });

  test('bhv telemetry 003 an error status sets error.type to the status code as text and marks the span as an error', () => {
    for (const [status] of [[404], [503]]) {
      const { hook, exporter } = telemetry();

      run(hook, { statusCode: status, headers: {}, error: new Error('status') });

      const [span] = exporter.getFinishedSpans();
      expect(span!.attributes['error.type']).toBe(String(status));
      expect(span!.attributes['http.response.status_code']).toBe(status);
      expect(span!.status.code).toBe(SpanStatusCode.ERROR);
    }
  });

  test('bhv telemetry 004 error.type is _OTHER for every unusable token', () => {
    for (const [token, error] of [
    ['timeout', new NetworkTimeoutError('timed out')],
    ['network_error', new NetworkError('refused')],
    ['serialization_error', new SerializationError('bad body')],
    ['cancelled', new DOMException('aborted', 'AbortError')],
    ['_OTHER', new Error('something else')]
  ] as const) {
      const { hook, exporter } = telemetry();

      run(hook, { statusCode: 0, headers: null, error });

      const [span] = exporter.getFinishedSpans();
      expect(span!.attributes['error.type']).toBe(token);
      expect(span!.status.code).toBe(SpanStatusCode.ERROR);
    }
  });

  test('bhv telemetry 005 a call with no response sets no http.response.status_code', () => {
    const { hook, exporter } = telemetry();

    run(hook, { statusCode: 0, headers: null, error: new NetworkError('refused') });

    expect('http.response.status_code' in exporter.getFinishedSpans()[0]!.attributes).toBe(false);
  });

  test('bhv telemetry 006 the span is a child of the active span and the traceparent sent names the client span', async () => {
    const { hook, exporter } = telemetry();
    const { client, sent } = scripted(200);
    const testable = new TestableApi(client, new Configuration({ baseUrl: 'https://api.example.com', callHook: hook }));
    const parentProvider = new BasicTracerProvider();

    const parent = parentProvider.getTracer('parent').startSpan('parent');
    await context.with(trace.setSpan(context.active(), parent), () => testable.call('/items/7'));
    parent.end();

    const [span] = exporter.getFinishedSpans();
    const parentContext = (span as unknown as { parentSpanContext?: { spanId: string } }).parentSpanContext;
    expect(parentContext?.spanId).toBe(parent.spanContext().spanId);
    expect(sent).toHaveLength(1);
    const traceparent = sent[0]!['traceparent']!;
    expect(traceparent.split('-')[1]).toBe(parent.spanContext().traceId);
    expect(traceparent.split('-')[2]).toBe(span!.spanContext().spanId);
    expect(Object.keys(sent[0]!).filter((name) => name.toLowerCase() === 'traceparent')).toHaveLength(1);
  });

  test('bhv telemetry 007 a call retried by the transport records one span and one count', async () => {
    const { hook, exporter, points } = telemetry();
    const sends: number[] = [];
    const stub = (async () => {
      sends.push(1);
      return new Response('{}', { status: sends.length === 1 ? 503 : 200, headers: { 'content-type': 'application/json' } });
    }) as unknown as typeof fetch;
    const timers = jest.spyOn(globalThis, 'setTimeout').mockImplementation(((handler: () => void) => {
      handler();
      return 0 as unknown as NodeJS.Timeout;
    }) as unknown as typeof setTimeout);
    const client = new DefaultApiClient(TransportOptions.builder().fetch(stub).build());

    try {
      await new TestableApi(client, new Configuration({ baseUrl: 'https://api.example.com', callHook: hook })).call('/items/7');
    } finally {
      timers.mockRestore();
    }

    expect(sends).toHaveLength(2);
    expect(exporter.getFinishedSpans()).toHaveLength(1);
    const counts = (await points()).filter((point) => point.name === 'http.client.request.count');
    expect(counts.map((point) => point.value)).toEqual([1]);
  });

  test('bhv telemetry 008 the request count is incremented once per call with the attributes of the span', async () => {
    const { hook, exporter, points } = telemetry();

    run(hook, ok);

    const [count] = (await points()).filter((point) => point.name === 'http.client.request.count');
    expect(count!.value).toBe(1);
    expect(count!.unit).toBe('{request}');
    expect(count!.attributes).toEqual(exporter.getFinishedSpans()[0]!.attributes);
  });

  test('bhv telemetry 009 the duration histogram records one value in seconds per call with the attributes of the span', async () => {
    const { hook, exporter, points } = telemetry();

    run(hook, ok);

    const [duration] = (await points()).filter((point) => point.name === 'http.client.request.duration');
    const value = duration!.value as { count: number; sum: number };
    expect(duration!.unit).toBe('s');
    expect(value.count).toBe(1);
    expect(value.sum).toBeGreaterThanOrEqual(0);
    expect(value.sum).toBeLessThan(5);
    expect(duration!.attributes).toEqual(exporter.getFinishedSpans()[0]!.attributes);
  });

  test('bhv telemetry 010 the instrumentation scope is the published package and carries the SDK version', async () => {
    const { hook, exporter, points } = telemetry();

    run(hook, ok);

    const scopes = (await points()).map((point) => [point.scope, point.version]);
    expect(scopes).toEqual([
      [{{#lambda.tsString}}{{{npmName}}}{{/lambda.tsString}}, {{#lambda.tsString}}{{{packageVersion}}}{{/lambda.tsString}}],
      [{{#lambda.tsString}}{{{npmName}}}{{/lambda.tsString}}, {{#lambda.tsString}}{{{packageVersion}}}{{/lambda.tsString}}]
    ]);
    const span = exporter.getFinishedSpans()[0] as ReadableSpan;
    expect(span.instrumentationScope.name).toBe({{#lambda.tsString}}{{{npmName}}}{{/lambda.tsString}});
    expect(span.instrumentationScope.version).toBe({{#lambda.tsString}}{{{packageVersion}}}{{/lambda.tsString}});
  });

  test('bhv telemetry 011 a provider handed to the hook is used instead of the global one', async () => {
    const globalExporter = new InMemorySpanExporter();
    const globalReader = new CollectingReader();
    trace.setGlobalTracerProvider(new BasicTracerProvider({ spanProcessors: [new SimpleSpanProcessor(globalExporter)] }));
    metrics.setGlobalMeterProvider(new MeterProvider({ readers: [globalReader] }));
    try {
      const { hook, exporter, points } = telemetry();

      run(hook, ok);

      expect(exporter.getFinishedSpans()).toHaveLength(1);
      expect(globalExporter.getFinishedSpans()).toHaveLength(0);
      expect((await points()).length).toBeGreaterThan(0);
      expect((await globalReader.collect()).resourceMetrics.scopeMetrics).toHaveLength(0);

      const fallback = createOpenTelemetryCallHook({ propagator: new W3CTraceContextPropagator() });
      run(fallback, ok);
      expect(globalExporter.getFinishedSpans()).toHaveLength(1);
    } finally {
      trace.disable();
      metrics.disable();
    }
  });

  test('bhv telemetry 012 with no provider configured the adapter does nothing and the call is unchanged', async () => {
    const { client, sent } = scripted(200);
    const testable = new TestableApi(client, new Configuration({ baseUrl: 'https://api.example.com', callHook: createOpenTelemetryCallHook() }));

    const result = await testable.call('/items/7');

    expect(result.statusCode).toBe(200);
    expect(sent[0]).toEqual({ Accept: 'application/json' });
  });

  test('bhv telemetry 013 the span ends exactly once, also when the call throws', async () => {
    const { hook, exporter } = telemetry();
    const { client } = scripted(new NetworkError('refused'));
    const testable = new TestableApi(client, new Configuration({ baseUrl: 'https://api.example.com', callHook: hook }));

    await expect(testable.call('/items/7')).rejects.toBeInstanceOf(NetworkError);
    expect(exporter.getFinishedSpans()).toHaveLength(1);

    const observer = hook.start(info, {});
    observer?.finish(ok);
    observer?.finish(ok);
    expect(exporter.getFinishedSpans()).toHaveLength(2);
  });

  test('bhv telemetry 014 no attribute carries a query string, a header value or a credential', async () => {
    const { hook, exporter, points } = telemetry();
    const { client } = scripted(200);
    const testable = new TestableApi(client, new Configuration({ baseUrl: 'https://api.example.com', callHook: hook }));

    await testable.call('/items/7', { token: 'sekret-query' }, { Authorization: 'Bearer sekret-header' });

    const recorded = JSON.stringify([
      exporter.getFinishedSpans().map((span) => span.attributes),
      (await points()).map((point) => point.attributes)
    ]);
    expect(recorded).not.toContain('sekret');
    expect(recorded).not.toContain('token=');
    expect(recorded).not.toContain('?');
  });
});
