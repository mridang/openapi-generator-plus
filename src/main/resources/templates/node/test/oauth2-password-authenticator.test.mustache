import * as util from 'node:util';
import { OAuth2PasswordAuthenticator } from '../src/auth/oauth/oauth2-password-authenticator{{importFileExtension}}';
import { ClientAuthMethod } from '../src/auth/oauth/client-auth-method{{importFileExtension}}';
import type { ApiClient } from '../src/api-client{{importFileExtension}}';
import type { ApiHttpResponse } from '../src/api-http-response{{importFileExtension}}';

class MockApiClient implements ApiClient {
  lastMethod = '';
  lastUrl = '';
  lastHeaders: Record<string, string> = {};
  lastBody: string | Buffer | null = null;
  responseBody = '';
  responseStatus = 200;
  queued: Array<{ status: number; body: unknown }> = [];
  calls: Array<{ url: string; headers: Record<string, string>; params: URLSearchParams }> = [];

  async sendRequest(
    method: string,
    url: string,
    headers: Record<string, string>,
    body: string | Buffer | null
  ): Promise<ApiHttpResponse> {
    this.lastMethod = method;
    this.lastUrl = url;
    this.lastHeaders = headers;
    this.lastBody = body;
    this.calls.push({ url, headers, params: new URLSearchParams(String(body)) });
    const next = this.queued.shift();
    return {
      statusCode: next?.status ?? this.responseStatus,
      body: next === undefined ? this.responseBody : JSON.stringify(next.body),
      headers: { 'content-type': 'application/json' }
    };
  }
}

describe('OAuth2PasswordAuthenticator', () => {
  let authenticator: OAuth2PasswordAuthenticator;
  let mockClient: MockApiClient;

  beforeEach(() => {
    authenticator = new OAuth2PasswordAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'my-client-secret',
      'https://auth.example.com/token',
      'testuser',
      'testpass',
      ['read', 'write']
    );
    mockClient = new MockApiClient();
    mockClient.responseBody = JSON.stringify({
      access_token: 'access-token-123',
      expires_in: 3600
    });
    authenticator.setApiClient(mockClient);
  });

  test('the synchronous getAuthHeaders throws instead of returning unauthenticated headers', () => {
    expect(() => authenticator.getAuthHeaders()).toThrow(
      'OAuth2 authenticators require async token exchange; use getAuthHeadersAsync() instead.'
    );
  });

  test('sends password grant type', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('password');
  });

  test('sends username and password', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('username')).toBe('testuser');
    expect(params.get('password')).toBe('testpass');
  });

  test('sends client id and secret', async () => {
    await authenticator.getAuthHeadersAsync();

    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('client_id')).toBe('my-client-id');
    expect(params.get('client_secret')).toBe('my-client-secret');
  });

  test('returns authorization bearer header', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'tok-pwd',
      expires_in: 3600
    });

    const headers = await authenticator.getAuthHeadersAsync();

    expect(headers['Authorization']).toBe('Bearer tok-pwd');
  });

  test('uses refresh token on subsequent calls', async () => {
    mockClient.responseBody = JSON.stringify({
      access_token: 'tok1',
      refresh_token: 'ref1',
      expires_in: 1
    });

    await authenticator.getAuthHeadersAsync();

    // Force token expiry
    const originalNow = Date.now;
    Date.now = () => originalNow() + 120_000;

    mockClient.responseBody = JSON.stringify({
      access_token: 'tok2',
      expires_in: 3600
    });

    await authenticator.getAuthHeadersAsync();

    Date.now = originalNow;
    const body = mockClient.lastBody as string;
    const params = new URLSearchParams(body);
    expect(params.get('grant_type')).toBe('refresh_token');
    expect(params.get('refresh_token')).toBe('ref1');
  });

  test('getHost returns configured host', () => {
    expect(authenticator.getHost()).toBe('https://api.example.com');
  });

  test('client secret and password are not leaked in default string representation', () => {
    // client-secret-leak-in-default-repr: console.log / util.inspect /
    // JSON.stringify must never expose the stored client secret or the
    // resource-owner password.
    expect(util.inspect(authenticator)).not.toContain('my-client-secret');
    expect(util.inspect(authenticator)).not.toContain('testpass');
    expect(JSON.stringify(authenticator)).not.toContain('my-client-secret');
    expect(JSON.stringify(authenticator)).not.toContain('testpass');
    expect(util.inspect(authenticator)).toContain('***');
  });

  it("redacts the secret in inspect and JSON output", () => {
    expect(util.inspect(authenticator)).not.toContain('my-client-secret');
    expect(util.inspect(authenticator)).not.toContain('testpass');
    expect(JSON.stringify(authenticator)).not.toContain('my-client-secret');
    expect(JSON.stringify(authenticator)).not.toContain('testpass');
    expect(util.inspect(authenticator)).toContain('***');
    expect(JSON.stringify(authenticator)).toContain('***');
  });

  test('basic auth url-encodes client id and secret', async () => {
    // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
    // client_id and client_secret MUST be application/x-www-form-
    // urlencoded BEFORE being joined with ':' and base64-encoded.
    const basicAuth = new OAuth2PasswordAuthenticator(
      'https://api.example.com',
      'id+with/special',
      'secret&with=stuff',
      'https://auth.example.com/token',
      'testuser',
      'testpass',
      ['read'],
      null,
      ClientAuthMethod.Basic
    );
    const basicClient = new MockApiClient();
    basicClient.responseBody = JSON.stringify({
      access_token: 'at',
      expires_in: 3600
    });
    basicAuth.setApiClient(basicClient);

    await basicAuth.getAuthHeadersAsync();

    const authHeader = basicClient.lastHeaders['Authorization'];
    expect(authHeader).toBeDefined();
    expect(authHeader.startsWith('Basic ')).toBe(true);
    const decoded = Buffer.from(
      authHeader.substring('Basic '.length),
      'base64'
    ).toString('utf-8');
    expect(decoded).toBe('id%2Bwith%2Fspecial:secret%26with%3Dstuff');
  });

  test('basic auth keeps the unreserved tilde literal and percent-encodes * ! \' ( )', async () => {
    // RFC 6749 §2.3.1 form-encoding keeps exactly "-._~" literal and
    // percent-encodes the sub-delimiters "* ! ' ( )".
    const basicAuth = new OAuth2PasswordAuthenticator(
      'https://api.example.com',
      'a~b*c',
      "d!e'f(g)",
      'https://auth.example.com/token',
      'testuser',
      'testpass',
      ['read'],
      null,
      ClientAuthMethod.Basic
    );
    const basicClient = new MockApiClient();
    basicClient.responseBody = JSON.stringify({ access_token: 'at', expires_in: 3600 });
    basicAuth.setApiClient(basicClient);

    await basicAuth.getAuthHeadersAsync();

    const authHeader = basicClient.lastHeaders['Authorization'];
    const decoded = Buffer.from(authHeader.substring('Basic '.length), 'base64').toString('utf-8');
    expect(decoded).toBe('a~b%2Ac:d%21e%27f%28g%29');
  });

  test('the request body keeps the tilde literal and percent-encodes * ! \' ( )', async () => {
    const bodyAuth = new OAuth2PasswordAuthenticator(
      'https://api.example.com',
      'a~b*c',
      "d!e'f(g)",
      'https://auth.example.com/token',
      'testuser',
      'testpass',
      []
    );
    const bodyClient = new MockApiClient();
    bodyClient.responseBody = JSON.stringify({ access_token: 'at', expires_in: 3600 });
    bodyAuth.setApiClient(bodyClient);

    await bodyAuth.getAuthHeadersAsync();

    const body = bodyClient.lastBody as string;
    expect(body).toContain('client_id=a~b%2Ac');
    expect(body).toContain('client_secret=d%21e%27f%28g%29');
  });

  test('sends the first grant to the token URL and the refresh grant to the refresh URL', async () => {
    const refreshing = new OAuth2PasswordAuthenticator(
      'https://api.example.com',
      'my-client-id',
      'my-client-secret',
      'https://auth.example.com/token',
      'testuser',
      'testpass',
      ['read'],
      'https://auth.example.com/oauth/refresh'
    );
    const refreshClient = new MockApiClient();
    refreshClient.responseBody = JSON.stringify({
      access_token: 'tok1',
      refresh_token: 'ref1',
      expires_in: 1
    });
    refreshing.setApiClient(refreshClient);
    const sendSpy = jest.spyOn(refreshClient, 'sendRequest');

    await refreshing.getAuthHeadersAsync();
    const originalNow = Date.now;
    Date.now = () => originalNow() + 120_000;
    try {
      await refreshing.getAuthHeadersAsync();
    } finally {
      Date.now = originalNow;
    }

    expect(sendSpy.mock.calls.map((call) => call[1])).toEqual([
      'https://auth.example.com/token',
      'https://auth.example.com/oauth/refresh'
    ]);
  });

  describe('refresh grant client authentication', () => {
    const originalNow = Date.now;

    async function twoCalls(auth: OAuth2PasswordAuthenticator): Promise<string> {
      await auth.getAuthHeadersAsync();
      Date.now = () => originalNow() + 120_000;
      try {
        return (await auth.getAuthHeadersAsync())['Authorization'];
      } finally {
        Date.now = originalNow;
      }
    }

    function refreshing(method: ClientAuthMethod): OAuth2PasswordAuthenticator {
      const auth = new OAuth2PasswordAuthenticator(
        'https://api.example.com',
        'my-client-id',
        'my-client-secret',
        'https://auth.example.com/token',
        'testuser',
        'testpass',
        ['read'],
        'https://auth.example.com/oauth/refresh',
        method
      );
      auth.setApiClient(mockClient);
      return auth;
    }

    test('in body mode the refresh grant carries client_id and client_secret', async () => {
      mockClient.queued = [
        { status: 200, body: { access_token: 'tok1', refresh_token: 'ref1', expires_in: 1 } },
        { status: 200, body: { access_token: 'tok2', expires_in: 3600 } }
      ];

      const header = await twoCalls(refreshing(ClientAuthMethod.Body));

      expect(header).toBe('Bearer tok2');
      expect(mockClient.calls[1]!.url).toBe('https://auth.example.com/oauth/refresh');
      expect(Object.fromEntries(mockClient.calls[1]!.params)).toEqual({
        grant_type: 'refresh_token',
        refresh_token: 'ref1',
        client_id: 'my-client-id',
        client_secret: 'my-client-secret'
      });
    });

    test('in basic mode the refresh grant carries the Basic header and no client_id', async () => {
      mockClient.queued = [
        { status: 200, body: { access_token: 'tok1', refresh_token: 'ref1', expires_in: 1 } },
        { status: 200, body: { access_token: 'tok2', expires_in: 3600 } }
      ];

      await twoCalls(refreshing(ClientAuthMethod.Basic));

      const refresh = mockClient.calls[1]!;
      expect(refresh.headers['Authorization']).toBe(
        `Basic ${Buffer.from('my-client-id:my-client-secret').toString('base64')}`
      );
      expect(refresh.params.get('grant_type')).toBe('refresh_token');
      expect(refresh.params.has('client_id')).toBe(false);
    });

    test('a rejected refresh re-runs the password grant against the token URL', async () => {
      mockClient.queued = [
        { status: 200, body: { access_token: 'tok1', refresh_token: 'ref1', expires_in: 1 } },
        { status: 400, body: { error: 'invalid_grant' } },
        { status: 200, body: { access_token: 'tok3', expires_in: 3600 } }
      ];

      const header = await twoCalls(refreshing(ClientAuthMethod.Body));

      expect(header).toBe('Bearer tok3');
      expect(mockClient.calls.map((call) => call.url)).toEqual([
        'https://auth.example.com/token',
        'https://auth.example.com/oauth/refresh',
        'https://auth.example.com/token'
      ]);
      expect(mockClient.calls[2]!.params.get('grant_type')).toBe('password');
    });
  });

  test('the redacted representation shows exactly the agreed non-secret fields', () => {
    expect(util.inspect(authenticator)).toBe(
      'OAuth2PasswordAuthenticator(host=https://api.example.com, clientId=my-client-id, clientSecret=***, tokenUrl=https://auth.example.com/token, refreshUrl=https://auth.example.com/token, username=testuser, password=***, scopes=[read, write], clientAuthMethod=body)'
    );
    expect(JSON.parse(JSON.stringify(authenticator))).toEqual(
      { host: 'https://api.example.com', clientId: 'my-client-id', username: 'testuser', clientSecret: '***', password: '***' }
    );
  });
});
