{{>api_info}}

import * as sdk from '../src/index{{importFileExtension}}';
import { ApiError } from '../src/errors/api-error{{importFileExtension}}';
import * as errors from '../src/errors/index{{importFileExtension}}';
import {
  {{errorPrefix}}Error,
  ClientError,
  BadRequestError,
  ConflictError,
  ForbiddenError,
  InternalServerError,
  NetworkError,
  NetworkTimeoutError,
  NotFoundError,
  OAuth2ServerError,
  OAuth2TokenError,
  SerializationError,
  ServerError,
  UnauthorizedError,
  UnprocessableEntityError,
} from '../src/errors/index{{importFileExtension}}';
import { Category } from '../src/models/index{{importFileExtension}}';

describe('ApiError', () => {
  describe('basic shape', () => {
    test('exposes statusCode, responseBody, responseHeaders, errorBody', () => {
      const err = new ApiError(
        404,
        'not found',
        { 'content-type': 'application/json' },
        '{"id":7,"name":"missing"}',
        null
      );
      expect(err.statusCode).toBe(404);
      expect(err.message).toBe('not found');
      expect(err.responseBody).toBe('{"id":7,"name":"missing"}');
      expect(err.responseHeaders?.['content-type']).toBe('application/json');
      expect(err.errorBody).toBeNull();
    });

    test('responseHeaders and responseBody are nullable to mark transport-no-response', () => {
      // apierror-responsebody-headers-nullable-split: null is distinct from
      // an empty header map / empty body. The public surface must accept null
      // so a pre-response transport failure can be encoded.
      const err = new ApiError(0, 'connection reset', null, null);
      expect(err.responseHeaders).toBeNull();
      expect(err.responseBody).toBeNull();
    });

    test('name is ApiError', () => {
      const err = new ApiError(500, 'boom');
      expect(err.name).toBe('ApiError');
      expect(err).toBeInstanceOf(Error);
    });

    test('ApiError extends the branded {{errorPrefix}}Error root', () => {
      const err = new ApiError(500, 'boom');
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err).toBeInstanceOf(Error);
    });
  });

  describe('unified exception hierarchy', () => {
    // The full extends chain a BadRequestError must satisfy:
    //   BadRequestError -> ClientError -> ApiError -> {{errorPrefix}}Error -> Error
    test('a BadRequestError is a ClientError, ApiError, {{errorPrefix}}Error and Error', () => {
      const err = new BadRequestError('bad input');
      expect(err).toBeInstanceOf(ClientError);
      expect(err).toBeInstanceOf(ApiError);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err).toBeInstanceOf(Error);
      expect(err.statusCode).toBe(400);
      expect(err.name).toBe('BadRequestError');
    });

    test('a NetworkTimeoutError is a NetworkError and ApiError with status 0', () => {
      const cause = new Error('socket hang up');
      const err = new NetworkTimeoutError('timed out', { cause });
      expect(err).toBeInstanceOf(NetworkError);
      expect(err).toBeInstanceOf(ApiError);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err.statusCode).toBe(0);
      expect(err.cause).toBe(cause);
      expect(err.name).toBe('NetworkTimeoutError');
      expect(new NetworkError('refused').statusCode).toBe(0);
    });
  });

  describe('getTypedErrorBody', () => {
    test('deserializes the raw body into the requested class', () => {
      const err = new ApiError<unknown>(
        400,
        'bad request',
        {},
        '{"id":42,"name":"Dogs"}'
      );
      const typed = err.getTypedErrorBody(Category);
      expect(typed).not.toBeNull();
      expect(typed).toBeInstanceOf(Category);
      expect(typed!.id).toBe(42);
      expect(typed!.name).toBe('Dogs');
    });

    test('returns null when there is no response body', () => {
      const err = new ApiError<unknown>(500, 'oops', {}, null);
      expect(err.getTypedErrorBody(Category)).toBeNull();
    });

    test('ignores extraneous fields not declared on the model', () => {
      const err = new ApiError<unknown>(
        422,
        'unprocessable',
        {},
        '{"id":1,"name":"Cat","extra":"drop-me"}'
      );
      const typed = err.getTypedErrorBody(Category);
      expect(typed).not.toBeNull();
      expect(typed!.id).toBe(1);
      expect(typed!.name).toBe('Cat');
      expect(typed as unknown as Record<string, unknown>).not.toHaveProperty('extra');
    });
  });

  describe('error tree', () => {
    const tree = [
      '{{errorPrefix}}Error',
      'ApiError',
      'ClientError',
      'ServerError',
      'BadRequestError',
      'UnauthorizedError',
      'ForbiddenError',
      'NotFoundError',
      'ConflictError',
      'UnprocessableEntityError',
      'InternalServerError',
      'NetworkError',
      'NetworkTimeoutError',
      'SerializationError',
      'OAuth2ServerError',
      'OAuth2TokenError',
    ];

    test('every error lives in src/errors and the package root exports it', () => {
      for (const name of tree) {
        const fromErrors = (errors as Record<string, unknown>)[name];
        expect(typeof fromErrors).toBe('function');
        expect((sdk as Record<string, unknown>)[name]).toBe(fromErrors);
      }
    });

    test('the OAuth2 errors are rooted at the branded base, not at ApiError', () => {
      const server = new OAuth2ServerError(400, 'invalid_grant', null, null, '{}');
      const token = new OAuth2TokenError('no access_token');
      expect(server).toBeInstanceOf({{errorPrefix}}Error);
      expect(token).toBeInstanceOf({{errorPrefix}}Error);
      expect(server).not.toBeInstanceOf(ApiError);
      expect(token).not.toBeInstanceOf(ApiError);
      expect(new SerializationError('boom')).toBeInstanceOf({{errorPrefix}}Error);
    });
  });

  describe('fromResponse', () => {
    test.each([
      [400, BadRequestError],
      [401, UnauthorizedError],
      [403, ForbiddenError],
      [404, NotFoundError],
      [409, ConflictError],
      [422, UnprocessableEntityError],
      [418, ClientError],
      [500, InternalServerError],
      [503, ServerError],
      [302, ApiError],
    ])('maps %i to its error', (status, expected) => {
      const err = ApiError.fromResponse(status, { 'x-request-id': 'abc' }, '{"code":7}');
      expect(err.constructor).toBe(expected);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err.statusCode).toBe(status);
      expect(err.responseHeaders).toEqual({ 'x-request-id': 'abc' });
      expect(err.responseBody).toBe('{"code":7}');
      expect(err.errorBody).toEqual({ code: 7 });
    });

    test('keeps a non-JSON body raw without an error body', () => {
      const err = ApiError.fromResponse(500, {}, '<html>oops</html>');
      expect(err.constructor).toBe(InternalServerError);
      expect(err.responseHeaders).toEqual({});
      expect(err.responseBody).toBe('<html>oops</html>');
      expect(err.errorBody).toBeNull();
    });
  });
});
