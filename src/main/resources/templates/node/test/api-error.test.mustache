{{>api_info}}

import * as sdk from '../src/index{{importFileExtension}}';
import { ApiError } from '../src/errors/api-error{{importFileExtension}}';
import * as errors from '../src/errors/index{{importFileExtension}}';
import {
  {{errorPrefix}}Error,
  ClientError,
  BadRequestError,
  ConflictError,
  ForbiddenError,
  InternalServerError,
  NetworkError,
  NetworkTimeoutError,
  NotFoundError,
  OAuth2ServerError,
  OAuth2TokenError,
  SerializationError,
  ServerError,
  UnauthorizedError,
  TooManyRequestsError,
  UnprocessableEntityError,
} from '../src/errors/index{{importFileExtension}}';
import { Category } from '../src/models/index{{importFileExtension}}';

describe('ApiError', () => {
  describe('basic shape', () => {
    test('bhv errors 004 exposes statusCode, responseBody, responseHeaders, errorBody', () => {
      const err = new ApiError(
        404,
        'not found',
        { 'content-type': 'application/json' },
        '{"id":7,"name":"missing"}',
        null
      );
      expect(err.statusCode).toBe(404);
      expect(err.message).toBe('not found');
      expect(err.responseBody).toBe('{"id":7,"name":"missing"}');
      expect(err.responseHeaders?.['content-type']).toBe('application/json');
      expect(err.errorBody).toBeNull();
    });

    test('bhv errors 021 responseHeaders and responseBody are nullable to mark transport-no-response', () => {
      // apierror-responsebody-headers-nullable-split: null is distinct from
      // an empty header map / empty body. The public surface must accept null
      // so a pre-response transport failure can be encoded.
      const err = new ApiError(0, 'connection reset', null, null);
      expect(err.responseHeaders).toBeNull();
      expect(err.responseBody).toBeNull();
    });

    test('requestMethod and requestPath are null unless the error says which request it answers', () => {
      const err = new ApiError(500, 'boom');
      expect(err.requestMethod).toBeNull();
      expect(err.requestPath).toBeNull();
    });

    test.each([
      ['ApiError', (o: object) => new ApiError(500, 'boom', null, null, null, o)],
      ['ClientError', (o: object) => new ClientError(418, 'boom', null, null, null, o)],
      ['ServerError', (o: object) => new ServerError(502, 'boom', null, null, null, o)],
      ['BadRequestError', (o: object) => new BadRequestError('boom', null, null, null, o)],
      ['UnauthorizedError', (o: object) => new UnauthorizedError('boom', null, null, null, o)],
      ['ForbiddenError', (o: object) => new ForbiddenError('boom', null, null, null, o)],
      ['NotFoundError', (o: object) => new NotFoundError('boom', null, null, null, o)],
      ['ConflictError', (o: object) => new ConflictError('boom', null, null, null, o)],
      ['UnprocessableEntityError', (o: object) => new UnprocessableEntityError('boom', null, null, null, o)],
      ['TooManyRequestsError', (o: object) => new TooManyRequestsError('boom', null, null, null, o)],
      ['InternalServerError', (o: object) => new InternalServerError('boom', null, null, null, o)],
      ['NetworkError', (o: object) => new NetworkError('boom', o)],
      ['NetworkTimeoutError', (o: object) => new NetworkTimeoutError('boom', o)]
    ])('bhv errors 002 %s carries requestMethod and requestPath', (_name, build) => {
      const err = build({ requestMethod: 'GET', requestPath: '/items/7' });
      expect(err.requestMethod).toBe('GET');
      expect(err.requestPath).toBe('/items/7');
    });

    test('bhv errors 003 every status-specific error keeps an optional cause', () => {
      const inner = new Error('inner');
      expect(new BadRequestError('boom', null, null, null, { cause: inner }).cause).toBe(inner);
      expect(new NotFoundError('boom', null, null, null, { cause: inner }).cause).toBe(inner);
      expect(new TooManyRequestsError('boom', null, null, null, { cause: inner }).cause).toBe(inner);
      expect(new BadRequestError('boom').cause).toBeUndefined();
    });

    test('bhv errors 019 is an Error subclass with the status in its string form', () => {
      const err = new ApiError(500, 'boom');
      expect(err).toBeInstanceOf(Error);
      expect(err.toString()).toContain('HTTP status code: 500');
    });

    test('bhv errors 047 name is ApiError', () => {
      const err = new ApiError(500, 'boom');
      expect(err.name).toBe('ApiError');
      expect(err).toBeInstanceOf(Error);
    });

    test('bhv errors 018 ApiError extends the branded {{errorPrefix}}Error root', () => {
      const err = new ApiError(500, 'boom');
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err).toBeInstanceOf(Error);
    });
  });

  describe('unified exception hierarchy', () => {
    // The full extends chain a BadRequestError must satisfy:
    //   BadRequestError -> ClientError -> ApiError -> {{errorPrefix}}Error -> Error
    test('bhv errors 061 a BadRequestError is a ClientError, ApiError, {{errorPrefix}}Error and Error', () => {
      const err = new BadRequestError('bad input');
      expect(err).toBeInstanceOf(ClientError);
      expect(err).toBeInstanceOf(ApiError);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err).toBeInstanceOf(Error);
      expect(err.statusCode).toBe(400);
      expect(err.name).toBe('BadRequestError');
    });

    test('status error constructors default the response context to null', () => {
      const bad = new BadRequestError();
      expect(bad.statusCode).toBe(400);
      expect(bad.message).toBe('');
      expect(bad.responseHeaders).toBeNull();
      expect(bad.responseBody).toBeNull();
      expect(bad.errorBody).toBeNull();
      expect(new NotFoundError('gone').responseHeaders).toBeNull();
      const client = new ClientError(418, 'teapot');
      expect(client.statusCode).toBe(418);
      expect(client.responseHeaders).toBeNull();
      expect(client.responseBody).toBeNull();
      expect(client.errorBody).toBeNull();
      expect(new ServerError(503, 'down').responseHeaders).toBeNull();
    });

    test('bhv errors 025 a SerializationError is a {{errorPrefix}}Error', () => {
      expect(new SerializationError('bad input')).toBeInstanceOf({{errorPrefix}}Error);
    });

    test.each([
      [400, BadRequestError],
      [401, UnauthorizedError],
      [403, ForbiddenError],
      [404, NotFoundError],
      [409, ConflictError],
      [422, UnprocessableEntityError],
      [429, TooManyRequestsError],
      [500, InternalServerError],
      [503, ServerError],
      [418, ClientError],
      [302, ApiError],
    ])('bhv errors 006 fromResponse maps status %i to its exception class', (status, expected) => {
      expect(ApiError.fromResponse(status, null, null).constructor).toBe(expected);
    });

    test('bhv errors 020 a NetworkTimeoutError is a NetworkError and ApiError with status 0', () => {
      const cause = new Error('socket hang up');
      const err = new NetworkTimeoutError('timed out', { cause });
      expect(err).toBeInstanceOf(NetworkError);
      expect(err).toBeInstanceOf(ApiError);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err.statusCode).toBe(0);
      expect(err.cause).toBe(cause);
      expect(err.name).toBe('NetworkTimeoutError');
      expect(new NetworkError('refused').statusCode).toBe(0);
    });

    test.each([
      ['BadRequestError', (c: Error) => new BadRequestError('m', null, null, null, { cause: c }), 400],
      ['UnauthorizedError', (c: Error) => new UnauthorizedError('m', null, null, null, { cause: c }), 401],
      ['ForbiddenError', (c: Error) => new ForbiddenError('m', null, null, null, { cause: c }), 403],
      ['NotFoundError', (c: Error) => new NotFoundError('m', null, null, null, { cause: c }), 404],
      ['ConflictError', (c: Error) => new ConflictError('m', null, null, null, { cause: c }), 409],
      ['UnprocessableEntityError', (c: Error) => new UnprocessableEntityError('m', null, null, null, { cause: c }), 422],
      ['TooManyRequestsError', (c: Error) => new TooManyRequestsError('m', null, null, null, { cause: c }), 429],
      ['InternalServerError', (c: Error) => new InternalServerError('m', null, null, null, { cause: c }), 500],
      ['ClientError', (c: Error) => new ClientError(418, 'm', null, null, null, { cause: c }), 418],
      ['ServerError', (c: Error) => new ServerError(503, 'm', null, null, null, { cause: c }), 503],
    ])('%s accepts an optional cause', (_name, build, status) => {
      const cause = new Error('root cause');
      const err = build(cause);
      expect(err.cause).toBe(cause);
      expect(err.statusCode).toBe(status);
    });
  });

  describe('getTypedErrorBody', () => {
    test('bhv errors 013 deserializes the raw body into the requested class', () => {
      // Built through fromResponse, the way a real response reaches a caller:
      // the typed body must come out of the raw body, not out of whatever the
      // generic parse happened to leave behind.
      const err = ApiError.fromResponse(400, {}, '{"id":42,"name":"Dogs"}');
      const typed = err.getTypedErrorBody(Category);
      expect(typed).not.toBeNull();
      expect(typed).toBeInstanceOf(Category);
      expect(typed!.id).toBe(42);
      expect(typed!.name).toBe('Dogs');
    });

    test('bhv errors 010 fromResponse keeps a scalar json body as the error body', () => {
      expect(ApiError.fromResponse(400, null, '42').errorBody).toBe(42);
    });

    test('bhv errors 008 parses an error body that starts with a BOM', () => {
      const err = ApiError.fromResponse(400, {}, '\uFEFF{"id":42,"name":"Dogs"}');
      expect(err.errorBody).toEqual({ id: 42, name: 'Dogs' });
    });

    test('bhv errors 015 returns null when there is no response body', () => {
      const err = ApiError.fromResponse(500, {}, null);
      expect(err.getTypedErrorBody(Category)).toBeNull();
    });

    test('bhv errors 016 returns null for an empty-string response body', () => {
      const err = ApiError.fromResponse(500, {}, '');
      expect(err.getTypedErrorBody(Category)).toBeNull();
    });

    test('bhv errors 017 throws SerializationError for a malformed response body', () => {
      const err = ApiError.fromResponse(500, {}, '{not json');
      expect(() => err.getTypedErrorBody(Category)).toThrow(SerializationError);
    });

    test('bhv errors 014 ignores extraneous fields not declared on the model', () => {
      const err = ApiError.fromResponse(
        422,
        {},
        '{"id":1,"name":"Cat","extra":"drop-me"}'
      );
      const typed = err.getTypedErrorBody(Category);
      expect(typed).not.toBeNull();
      expect(typed!.id).toBe(1);
      expect(typed!.name).toBe('Cat');
      expect(typed as unknown as Record<string, unknown>).not.toHaveProperty('extra');
    });
  });

  describe('error tree', () => {
    const tree = [
      '{{errorPrefix}}Error',
      'ApiError',
      'ClientError',
      'ServerError',
      'BadRequestError',
      'UnauthorizedError',
      'ForbiddenError',
      'NotFoundError',
      'ConflictError',
      'UnprocessableEntityError',
      'TooManyRequestsError',
      'InternalServerError',
      'NetworkError',
      'NetworkTimeoutError',
      'SerializationError',
      'OAuth2ServerError',
      'OAuth2TokenError',
    ];

    test('bhv errors 044 every error lives in src/errors and the package root exports it', () => {
      for (const name of tree) {
        const fromErrors = (errors as Record<string, unknown>)[name];
        expect(typeof fromErrors).toBe('function');
        expect((sdk as Record<string, unknown>)[name]).toBe(fromErrors);
      }
    });

    test('bhv errors 045 the OAuth2 errors are rooted at the branded base, not at ApiError', () => {
      const server = new OAuth2ServerError(400, 'invalid_grant', null, null, '{}');
      const token = new OAuth2TokenError('no access_token');
      expect(server).toBeInstanceOf({{errorPrefix}}Error);
      expect(token).toBeInstanceOf({{errorPrefix}}Error);
      expect(server).not.toBeInstanceOf(ApiError);
      expect(token).not.toBeInstanceOf(ApiError);
      expect(new SerializationError('boom')).toBeInstanceOf({{errorPrefix}}Error);
    });
  });

  describe('OAuth2ServerError message', () => {
    test.each([
      ['a raw body when there is no error code', null, null, 'upstream down', 'Token request failed with status 502: upstream down'],
      ['the error code', 'invalid_client', null, '{}', 'Token request failed with status 400: invalid_client'],
      [
        'the error code and description',
        'invalid_grant',
        'refresh token expired',
        '{}',
        'Token request failed with status 400: invalid_grant -- refresh token expired'
      ]
    ])('bhv errors 046 renders the OAuth2 message in three forms: %s', (_label, code, description, rawBody, expected) => {
      const status = code === null ? 502 : 400;
      expect(new OAuth2ServerError(status, code, description, null, rawBody).message).toBe(expected);
    });
  });

  describe('status mapping', () => {
    test('bhv errors 058 a 400 response maps to the bad request error', () => {
      const err = ApiError.fromResponse(400, null, null);
      expect(err).toBeInstanceOf(BadRequestError);
      expect(err.statusCode).toBe(400);
    });

    test('bhv errors 059 a 403 response maps to the forbidden error', () => {
      const err = ApiError.fromResponse(403, null, null);
      expect(err).toBeInstanceOf(ForbiddenError);
      expect(err.statusCode).toBe(403);
    });

    test('bhv errors 060 a 404 response maps to the not found error', () => {
      const err = ApiError.fromResponse(404, null, null);
      expect(err).toBeInstanceOf(NotFoundError);
      expect(err.statusCode).toBe(404);
    });

    test('bhv errors 066 a 429 response becomes a too-many-requests error that is a client error', () => {
      const err = ApiError.fromResponse(429, null, null);
      expect(err).toBeInstanceOf(TooManyRequestsError);
      expect(err).toBeInstanceOf(ClientError);
      expect(err.statusCode).toBe(429);
    });

    test('bhv errors 067 a 409 response becomes a conflict error', () => {
      const err = ApiError.fromResponse(409, null, null);
      expect(err).toBeInstanceOf(ConflictError);
      expect(err.statusCode).toBe(409);
    });

    test('bhv errors 068 a 422 response becomes an unprocessable entity error', () => {
      const err = ApiError.fromResponse(422, null, null);
      expect(err).toBeInstanceOf(UnprocessableEntityError);
      expect(err.statusCode).toBe(422);
    });

    test('bhv errors 069 a 500 response becomes an internal server error', () => {
      const err = ApiError.fromResponse(500, null, null);
      expect(err).toBeInstanceOf(InternalServerError);
      expect(err.statusCode).toBe(500);
    });

    test('bhv errors 070 a 502 response becomes a server error', () => {
      const err = ApiError.fromResponse(502, null, null);
      expect(err).toBeInstanceOf(ServerError);
      expect(err.statusCode).toBe(502);
    });
  });

  describe('TooManyRequestsError.retryAfter', () => {
    const tooMany = (headers: Record<string, string> | null) => new TooManyRequestsError('m', headers);

    test.each([
      ['seconds', { 'retry-after': '7' }, 7],
      ['fractional seconds', { 'Retry-After': ' 1.5 ' }, 1.5],
      ['a date in the past', { 'retry-after': 'Wed, 21 Oct 2015 07:28:00 GMT' }, 0]
    ])('reads %s', (_label, headers, expected) => {
      expect(tooMany(headers).retryAfter).toBe(expected);
    });

    test('reads an HTTP date as the seconds left until it', () => {
      const seconds = tooMany({ 'retry-after': new Date(Date.now() + 30_000).toUTCString() }).retryAfter;
      expect(seconds).toBeGreaterThanOrEqual(28);
      expect(seconds).toBeLessThanOrEqual(31);
    });

    test.each([
      ['no headers', null],
      ['no Retry-After', { 'x-other': '1' }],
      ['an unparseable value', { 'retry-after': 'soon' }],
      ['an empty value', { 'retry-after': '' }]
    ])('is null with %s', (_label, headers) => {
      expect(tooMany(headers).retryAfter).toBeNull();
    });
  });

  describe('fromResponse', () => {
    test.each([
      [400, BadRequestError],
      [401, UnauthorizedError],
      [403, ForbiddenError],
      [404, NotFoundError],
      [409, ConflictError],
      [422, UnprocessableEntityError],
      [429, TooManyRequestsError],
      [418, ClientError],
      [500, InternalServerError],
      [503, ServerError],
      [302, ApiError],
    ])('maps %i to its error', (status, expected) => {
      const err = ApiError.fromResponse(status, { 'x-request-id': 'abc' }, '{"code":7}');
      expect(err.constructor).toBe(expected);
      expect(err).toBeInstanceOf({{errorPrefix}}Error);
      expect(err.statusCode).toBe(status);
      expect(err.responseHeaders).toEqual({ 'x-request-id': 'abc' });
      expect(err.responseBody).toBe('{"code":7}');
      expect(err.errorBody).toEqual({ code: 7 });
    });

    test('a status at or above 600 is not a server error', () => {
      /* The 5xx arm is bounded at < 600: a status outside 400-599 yields the
       * base ApiError, never ServerError. */
      const err = ApiError.fromResponse(600, { 'x-request-id': 'abc' }, null);
      expect(err.constructor).toBe(ApiError);
      expect(err).not.toBeInstanceOf(ServerError);
      expect(err.statusCode).toBe(600);
    });

    test('bhv errors 005 keeps a non-JSON body raw without an error body', () => {
      const err = ApiError.fromResponse(500, {}, '<html>oops</html>');
      expect(err.constructor).toBe(InternalServerError);
      expect(err.responseHeaders).toEqual({});
      expect(err.responseBody).toBe('<html>oops</html>');
      expect(err.errorBody).toBeNull();
    });

    test.each([
      ['a JSON string', '"plain text"', 'plain text'],
      ['a JSON number', '42', 42],
      ['a JSON boolean', 'true', true]
    ])('keeps %s as the error body', (_label, body, expected) => {
      const err = ApiError.fromResponse(400, {}, body);
      expect(err.constructor).toBe(BadRequestError);
      expect(err.responseBody).toBe(body);
      expect(err.errorBody).toBe(expected);
    });

    test('bhv errors 012 fromResponse without a request keeps the plain message', () => {
      const err = ApiError.fromResponse(404, {}, null);
      expect(err.message).toBe('API returned status code 404');
      expect(err.requestMethod).toBeNull();
      expect(err.toString()).not.toContain('Request:');
    });

    test('bhv errors 007 fromResponse records the request method and path on the error it builds', () => {
      const err = ApiError.fromResponse(404, {}, null, { method: 'DELETE', path: '/items/7' });
      expect(err.constructor).toBe(NotFoundError);
      expect(err.requestMethod).toBe('DELETE');
      expect(err.requestPath).toBe('/items/7');
      expect(err.message).toBe('API returned status code 404');
    });

    test.each([
      [418, ClientError],
      [502, ServerError],
      [200, ApiError]
    ])('fromResponse records the request on the %i fallback error', (status, expected) => {
      const err = ApiError.fromResponse(status, {}, null, { method: 'POST', path: '/items' });
      expect(err.constructor).toBe(expected);
      expect(err.requestMethod).toBe('POST');
      expect(err.requestPath).toBe('/items');
    });

    test('bhv errors 009 refuses a deeply nested error body', () => {
      /* The error body is attacker-controlled, so parsing is depth-capped:
       * an over-deep payload leaves errorBody null instead of overflowing
       * the V8 stack. */
      const body = '['.repeat(2000) + ']'.repeat(2000);
      const err = ApiError.fromResponse(400, {}, body);
      expect(err.constructor).toBe(BadRequestError);
      expect(err.responseBody).toBe(body);
      expect(err.errorBody).toBeNull();
    });
  });

  describe('toString', () => {
    test('bhv errors 024 renders the message, status, headers and body', () => {
      const err = new ApiError(404, 'not found', { 'x-request-id': 'abc' }, '{"code":7}', null);
      expect(err.toString()).toBe(
        'not found\nHTTP status code: 404\nResponse headers: {"x-request-id":"abc"}\nResponse body: {"code":7}'
      );
    });

    test('bhv errors 065 the error text cuts a long response body at 1 KiB and counts the bytes left out', () => {
      const body = 'x'.repeat(1030);
      const err = new ApiError(502, 'bad gateway', {}, body, null);

      expect(err.toString()).toBe(
        `bad gateway\nHTTP status code: 502\nResponse body: ${'x'.repeat(1024)}... (6 more bytes)`
      );
      expect(err.responseBody).toBe(body);
    });

    test('escapes CR, LF and other control characters in the rendered body', () => {
      const err = new ApiError(500, 'boom', {}, 'a\r\nHTTP status code: 200\u0001\u007f', null);

      expect(err.toString()).toBe(
        'boom\nHTTP status code: 500\nResponse body: a\\r\\nHTTP status code: 200\\u0001\\u007f'
      );
    });

    test('bhv errors 023 masks credential-bearing response headers and sorts the rest', () => {
      const err = new ApiError(
        401,
        'denied',
        {
          'WWW-Authenticate': 'Bearer realm="x"',
          'Set-Cookie': 'sid=abc',
          'X-Api-Key': 'k-1',
          'x-request-id': 'abc',
          'Content-Type': 'text/plain'
        },
        null,
        null
      );

      expect(err.toString()).toBe(
        'denied\nHTTP status code: 401\nResponse headers: ' +
          '{"Content-Type":"text/plain","Set-Cookie":"***","WWW-Authenticate":"***","X-Api-Key":"***","x-request-id":"abc"}'
      );
      expect(err.responseHeaders!['Set-Cookie']).toBe('sid=abc');
    });

    test('bhv errors 011 renders the request after the status code', () => {
      const err = new ApiError(404, 'not found', { 'x-request-id': 'abc' }, '{"code":7}', null, {
        requestMethod: 'GET',
        requestPath: '/items/7'
      });
      expect(err.toString()).toBe(
        'not found\nHTTP status code: 404\nRequest: GET /items/7\nResponse headers: {"x-request-id":"abc"}\nResponse body: {"code":7}'
      );
    });

    test('bhv errors 001 escapes control characters in the rendered request path, keeping the field whole', () => {
      const err = new ApiError(404, 'not found', null, null, null, {
        requestMethod: 'GET',
        requestPath: '/a\r\nHTTP status code: 200'
      });
      expect(err.toString()).toBe('not found\nHTTP status code: 404\nRequest: GET /a\\r\\nHTTP status code: 200');
      expect(err.requestPath).toBe('/a\r\nHTTP status code: 200');
    });

    test('omits the request when only one half is known', () => {
      const err = new ApiError(404, 'not found', null, null, null, { requestMethod: 'GET' });
      expect(err.toString()).toBe('not found\nHTTP status code: 404');
    });

    test('omits an absent status, headers and body', () => {
      const err = new ApiError(0, 'connection reset');
      expect(err.toString()).toBe('connection reset');
    });

    test('bhv errors 022 omits empty headers and an empty body', () => {
      const err = new ApiError(502, 'bad gateway', {}, '', null);
      expect(err.toString()).toBe('bad gateway\nHTTP status code: 502');
    });

    test('bhv errors 064 an empty message renders the default text, like a missing one', () => {
      const err = new ApiError(500, '');
      expect(err.toString()).toBe('Error message: the server returns an error\nHTTP status code: 500');
    });
  });
});
