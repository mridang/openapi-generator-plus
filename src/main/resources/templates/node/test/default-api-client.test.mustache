  // T-new-3: multipart bodies must be replayed across 307 redirects per
  // RFC 7231 §6.4.7 / RFC 7538. Regression test: ensure the follow-up
  // request after a 307 still carries the multipart form parts.
  test('bhv retries 012 replays multipart body across 307 redirects (T-new-3)', async () => {
    const chasmUrl = process.env['CHASM_HTTP_URL']!;

    const transport = TransportOptions.builder()
      .followRedirects(true)
      .maxRedirects(5)
      .build();

    const client = new DefaultApiClient(transport);
    const boundary = 'test-boundary';
    const body = Buffer.from(
      `--${boundary}\r\n` +
        `Content-Disposition: form-data; name="description"\r\n\r\n` +
        `hello\r\n` +
        `--${boundary}\r\n` +
        `Content-Disposition: form-data; name="file"; filename="file"\r\n` +
        `Content-Type: application/octet-stream\r\n\r\n` +
        `file-content-bytes\r\n` +
        `--${boundary}--\r\n`
    );
    // chasm's bodyPatterns matches the replayed multipart parts; 200
    // is returned only when the multipart body arrives intact at the
    // redirect target.
    const response = await client.sendRequest(
      'POST',
      `${chasmUrl}/test/redirect/307-multipart`,
      { 'Content-Type': `multipart/form-data; boundary=${boundary}` },
      body
    );

    expect(response.statusCode).toBe(200);
    const json = JSON.parse(response.body as string);
    expect(json.method).toBe('POST');
    // Assert the replayed body arrived intact at the redirect target.
    expect(typeof json.body).toBe('string');
    expect(json.body.length).toBeGreaterThan(0);
    expect(json.body).toContain('file-content-bytes');
  });

  /*
   * WAVE E: redirect counting and the "too many redirects" refusal must be
   * scoped to a SINGLE request, never shared across concurrent requests made
   * through one client. The Node transport already satisfies this: the
   * redirect loop in AbstractApiClient.sendRequest keeps its hop counter
   * (`hops`) and follow-up method/body/headers in call-local variables, so
   * two in-flight requests on the same client cannot corrupt each other's
   * count or surface one request's refusal error on the other.
   *
   * This parity test proves the property end-to-end by firing many requests
   * CONCURRENTLY through ONE shared client: half follow a single redirect
   * (must succeed with 200) and half follow a chain far longer than the cap
   * (must each independently fail with "too many redirects"). A shared
   * counter would let the long chains inflate the short requests' hop count
   * (failing a 1-hop request) or let a refusal leak onto a 1-hop request.
   *
   * The redirect chain is served by an in-process http.Server with a
   * self-decrementing `/chain/{n}` endpoint (302 -> /chain/{n-1}, 200 at 0),
   * mirroring the Go SDK's WaveE verification rather than depending on a
   * fixed-length chasm endpoint.
   */
  describe('concurrent redirects are per-request (WAVE E)', () => {
    test('bhv redirects 003 a 1-hop request is not failed by a concurrent over-limit chain', async () => {
      const server = http.createServer((req, res) => {
        const n = Number.parseInt((req.url ?? '').replace('/chain/', ''), 10);
        if (!Number.isFinite(n) || n <= 0) {
          res.writeHead(200, { 'Content-Type': 'text/plain' });
          res.end('ok');
          return;
        }
        const addr = server.address();
        const port = typeof addr === 'object' && addr != null ? addr.port : 0;
        res.writeHead(302, { Location: `http://127.0.0.1:${port}/chain/${n - 1}` });
        res.end();
      });

      await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
      const addr = server.address();
      const port = typeof addr === 'object' && addr != null ? addr.port : 0;
      const baseUrl = `http://127.0.0.1:${port}`;

      const maxRedirects = 5;
      const transport = TransportOptions.builder()
        .followRedirects(true)
        .maxRedirects(maxRedirects)
        .build();
      const client = new DefaultApiClient(transport);

      // Interleave short (1-hop, must pass) and long (20-hop, must be refused)
      // requests so that if the hop counter were shared, the long chains would
      // run concurrently with — and corrupt — the short ones.
      type Case = { hops: number; wantErr: boolean };
      const cases: Case[] = [];
      for (let i = 0; i < 12; i++) {
        cases.push({ hops: 1, wantErr: false });
        cases.push({ hops: 20, wantErr: true });
      }

      try {
        const results = await Promise.allSettled(
          cases.map((c) =>
            client.sendRequest('GET', `${baseUrl}/chain/${c.hops}`, {}, null)
          )
        );

        cases.forEach((c, i) => {
          const result = results[i]!;
          if (c.wantErr) {
            // A request that legitimately exceeds the cap must reject with the
            // "too many redirects" ApiError mentioning the limit — and must do
            // so on ITS OWN account, not because a sibling exhausted a counter.
            expect(result.status).toBe('rejected');
            const reason = (result as PromiseRejectedResult).reason;
            expect(reason).toBeInstanceOf(ApiError);
            expect(String((reason as ApiError).message)).toContain(String(maxRedirects));
          } else {
            // A 1-hop request must succeed independently: the 20-hop chains
            // running alongside it must not push its hop count over the cap
            // nor surface their refusal error here.
            expect(result.status).toBe('fulfilled');
            const response = (result as PromiseFulfilledResult<Awaited<ReturnType<typeof client.sendRequest>>>).value;
            expect(response.statusCode).toBe(200);
            expect(response.body).toContain('ok');
          }
        });
      } finally {
        await new Promise<void>((resolve) => server.close(() => resolve()));
      }
    }, 30000);
  });

  test('bhv redirects 006 following stops at the configured maximum number of redirects', () => {
    const transport = TransportOptions.builder()
      .followRedirects(true)
      .maxRedirects(5)
      .build();

    const client = new DefaultApiClient(transport);
    expect(client).toBeDefined();
    expect(transport.maxRedirects).toBe(5);
  });

  test('bhv serializationwire 027 sends multipart form data', async () => {
    const chasmUrl = process.env['CHASM_HTTP_URL']!;

    const client = new DefaultApiClient();
    const formData: Buffer = Buffer.from(JSON.stringify({ description: 'A test file' }));
    const response = await client.sendRequest(
      'POST',
      `${chasmUrl}/test/echo`,
      { 'Content-Type': 'multipart/form-data' },
      formData
    );

    expect(response).toBeDefined();
  });

  // W-new-2: multipart field-name validation must run on every branch (not
  // just binary). Confirm that even for a plain string value, a CR/LF in
  // the field name is rejected, preventing Content-Disposition smuggling.
  test('bhv serializationwire 026 multipart_field_name_with_crlf_rejected_on_string_value', async () => {
    const chasmUrl = process.env['CHASM_HTTP_URL']!;
    const client = new DefaultApiClient();
    const badFields: Record<string, unknown> = {
      'name\r\nInjected: yes': 'string-value',
    };
    await expect(
      client.sendRequest('POST', `${chasmUrl}/test/echo`, {}, badFields)
    ).rejects.toThrow();
  });

  /*
   * The fixture's compressed endpoints really send the requested
   * Content-Encoding, so a JSON body that parses back to the fixture
   * document proves the client ran the decode path for that codec.
   */
  const compressedUrl = (encoding: string): string =>
    `${process.env['CHASM_HTTP_URL']!}/test/compressed/${encoding}`;
  const fixtureBody = { userId: 1, id: 1, title: 'compressed fixture body' };

  test('bhv transport 005 a gzip response body is decompressed', async () => {
    const client = new DefaultApiClient();
    const response = await client.sendRequest(
      'GET',
      compressedUrl('gzip'),
      { 'Accept-Encoding': 'gzip' },
      null
    );

    expect(response.statusCode).toBe(200);
    expect(JSON.parse(response.body)).toEqual(fixtureBody);
  });

  test('bhv transport 004 a brotli response body is decompressed', async () => {
    const client = new DefaultApiClient();
    const response = await client.sendRequest(
      'GET',
      compressedUrl('br'),
      { 'Accept-Encoding': 'br' },
      null
    );

    expect(response.statusCode).toBe(200);
    expect(JSON.parse(response.body)).toEqual(fixtureBody);
  });

  const zstdAvailable = typeof zlib.zstdDecompress === 'function';
  (zstdAvailable ? test : test.skip)('bhv transport 006 decompresses zstd response', async () => {
    const client = new DefaultApiClient();
    const response = await client.sendRequest(
      'GET',
      compressedUrl('zstd'),
      { 'Accept-Encoding': 'zstd' },
      null
    );

    expect(response.statusCode).toBe(200);
    expect(JSON.parse(response.body)).toEqual(fixtureBody);
  });

  /*
   * Regression: POST/PUT/PATCH with body == null must emit an
   * explicit Content-Length: 0. Some servers / WAFs reject body-
   * bearing verbs with no Content-Length (411 Length Required). The
   * client sets the header explicitly on body-bearing verbs when
   * the body is null.
   */
  test('bhv transport 019 post_with_null_body_sends_content_length_zero', async () => {
    const chasmUrl = process.env['CHASM_HTTP_URL']!;
    const client = new DefaultApiClient();
    const response = await client.sendRequest(
      'POST',
      `${chasmUrl}/test/echo`,
      {},
      null
    );

    expect(response.statusCode).toBe(200);
    const payload = JSON.parse(response.body) as { method: string; contentLength: number };
    expect(payload.method).toBe('POST');
    // chasm reports contentLength as a camelCase integer (not a string keyed 'content-length').
    expect(payload.contentLength).toBe(0);
  }, 30000);

  /*
   * Canonical scenario AK — proxy userinfo is carried, not dropped.
   * Configuring a proxy URL of the form http://user:pass@host:port MUST
   * surface the embedded credentials (Proxy-Authorization / userinfo
   * honoured) so an authenticated proxy can establish the tunnel. The Java
   * SDK is the one that drops userinfo (Gap AK); every other SDK -- including
   * Node, whose undici ProxyAgent reads userinfo natively from the URL --
   * preserves it. GREEN: TransportOptions preserves the userinfo end-to-end
   * and it base64-encodes to the expected Proxy-Authorization value.
   */
  describe('proxy credentials carried (canonical AK)', () => {
    test('bhv transport 020 proxy http://user:pass@127.0.0.1:3128 carries the credentials', () => {
      const transport = TransportOptions.builder()
        .proxy('http://user:pass@127.0.0.1:3128')
        .build();
      // The userinfo survives on the configured proxy URL (undici's
      // ProxyAgent reads it natively to emit Proxy-Authorization on CONNECT).
      const url = new URL(transport.proxy!);
      expect(url.username).toBe('user');
      expect(url.password).toBe('pass');
      expect(url.host).toBe('127.0.0.1:3128');
      // The credentials base64-encode to the canonical Proxy-Authorization
      // value the proxy expects.
      const encoded = Buffer.from(
        `${decodeURIComponent(url.username)}:${decodeURIComponent(url.password)}`,
      ).toString('base64');
      expect(`Basic ${encoded}`).toBe('Basic dXNlcjpwYXNz');
    });
  });

  /*
   * Canonical scenario N1 — HTTPS->HTTP downgrade body-replay guard is
   * restricted to 307/308. 301/302/303 coerce the follow-up to a bodyless
   * GET (RFC 7231), so a downgrade on those statuses carries nothing
   * sensitive and MUST proceed. Only 307/308 preserve the body, so only they
   * may leak it across a TLS downgrade and MUST throw.
   *
   * The 302-with-body case is RED before the fix (the old guard fired on any
   * status whenever the follow-up body was non-empty, so a GET-with-body that
   * 301/302 preserves was wrongly refused) and GREEN after. The 307/308 cases
   * are GREEN in both states (they must always refuse the downgrade).
   *
   * fetch is mocked so the test is deterministic and needs no live HTTPS.
   */
  describe('HTTPS->HTTP downgrade guard refuses every status except 303 (canonical N1)', () => {
    const originalFetch = global.fetch;
    afterEach(() => {
      global.fetch = originalFetch;
    });

    test('bhv redirects 001 an https->http 302 with a body is refused and the plain target is never requested', async () => {
      let call = 0;
      global.fetch = (async (): Promise<Response> => {
        call++;
        // 302 carrying a body, downgrading https -> http. The body would be
        // replayed in cleartext, so the hop is refused and nothing else is fetched.
        return new Response(null, {
          status: 302,
          headers: { Location: 'http://other.example/landing' },
        });
      }) as typeof fetch;

      const transport = TransportOptions.builder().followRedirects(true).build();
      const client = new DefaultApiClient(transport);
      await expect(
        client.sendRequest('GET', 'https://secure.example/start', { 'Content-Type': 'application/json' }, '{"x":1}'),
      ).rejects.toThrow('Refusing to replay request body');
      expect(call).toBe(1);
    });

    test('bhv retries 010 a https->http 307 with a body THROWS (body preserved across downgrade)', async () => {
      let call = 0;
      global.fetch = (async (): Promise<Response> => {
        call++;
        if (call === 1) {
          return new Response(null, {
            status: 307,
            headers: { Location: 'http://evil.example/steal' },
          });
        }
        return new Response('SHOULD NOT REACH', { status: 200 });
      }) as typeof fetch;

      const transport = TransportOptions.builder().followRedirects(true).build();
      const client = new DefaultApiClient(transport);
      await expect(
        client.sendRequest(
          'POST',
          'https://secure.example/token',
          { 'Content-Type': 'application/x-www-form-urlencoded' },
          'grant_type=client_credentials&client_secret=topsecret',
        ),
      ).rejects.toBeInstanceOf(ApiError);
      // The downgraded follow-up must never be sent.
      expect(call).toBe(1);
    });

    test('bhv retries 011 a https->http 308 with a body THROWS (body preserved across downgrade)', async () => {
      let call = 0;
      global.fetch = (async (): Promise<Response> => {
        call++;
        if (call === 1) {
          return new Response(null, {
            status: 308,
            headers: { Location: 'http://evil.example/steal' },
          });
        }
        return new Response('SHOULD NOT REACH', { status: 200 });
      }) as typeof fetch;

      const transport = TransportOptions.builder().followRedirects(true).build();
      const client = new DefaultApiClient(transport);
      await expect(
        client.sendRequest(
          'POST',
          'https://secure.example/token',
          { 'Content-Type': 'application/x-www-form-urlencoded' },
          'grant_type=client_credentials&client_secret=topsecret',
        ),
      ).rejects.toBeInstanceOf(ApiError);
      expect(call).toBe(1);
    });
  });

  /*
   * Gap T6: close() releases the underlying undici dispatcher and is
   * idempotent. A request issued on a closed client must throw the
   * invalid-state built-in Error (closed-flag guard), matching the
   * uniform use-after-close contract across SDKs.
   */
  test('bhv lifecycle 018 close releases underlying client', async () => {
    const client = new DefaultApiClient();
    await client.close();
    // close() is idempotent.
    await client.close();
    const error = await client
      .sendRequest('GET', 'https://example.com', {}, null)
      .catch((e: unknown) => e);
    expect((error as Error).constructor).toBe(Error);
    expect((error as Error).message).toContain('closed');
  });
});

describe('DefaultApiClient redirect misc behaviours', () => {
  const realFetch = global.fetch;
  afterEach(() => {
    global.fetch = realFetch;
  });

  function scriptFetch(steps: Array<{ status: number; location?: string }>): Array<{ url: string; init: RequestInit }> {
    const calls: Array<{ url: string; init: RequestInit }> = [];
    global.fetch = (async (url: string | URL | Request, init?: RequestInit) => {
      calls.push({ url: String(url), init: init ?? {} });
      const step = steps[Math.min(calls.length - 1, steps.length - 1)];
      const headers: Record<string, string> = step.location ? { Location: step.location } : {};
      if (step.status === 200) {
        headers['Content-Type'] = 'application/json';
      }
      return new Response(step.status === 200 ? '{"ok":true}' : null, { status: step.status, headers });
    }) as unknown as typeof fetch;
    return calls;
  }

  it('bhv misc 124 a request body is not replayed across a 301 redirect from HTTPS to plain HTTP, and the call fails', async () => {
    const calls = scriptFetch([{ status: 301, location: 'http://api.example/plain' }, { status: 200 }]);
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await expect(
      client.sendRequest('PUT', 'https://api.example/start', { 'Content-Type': 'application/json' }, { name: 'x' }),
    ).rejects.toThrow('Refusing to replay request body');
    expect(calls).toHaveLength(1);
  });

  it('bhv misc 126 a HEAD request redirected by 303 is followed as HEAD rather than converted to GET', async () => {
    const calls = scriptFetch([{ status: 303, location: 'https://example.com/elsewhere' }, { status: 200 }]);
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest('HEAD', 'https://example.com/start', {}, null);
    expect(calls).toHaveLength(2);
    expect(String(calls[1].init.method).toUpperCase()).toBe('HEAD');
  });

  it('bhv misc 127 a Location that holds only a query keeps the redirected path and replaces its query', async () => {
    const calls = scriptFetch([{ status: 302, location: '?page=2' }, { status: 200 }]);
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest('GET', 'https://h.example.com/v1/items/1?page=1', {}, null);
    expect(calls[1].url).toBe('https://h.example.com/v1/items/1?page=2');
  });

  it('bhv misc 128 a cross-origin redirect keeps the proxy credential on every request through the shared transport', async () => {
    /* undici tunnels every http:// origin through CONNECT, so the proxy answers each
     * tunnel and serves the origin request inside it. */
    const seen: Array<{ target: string; auth: string | undefined }> = [];
    const origin = http.createServer((req, res) => {
      if (req.headers.host === 'origin-a.example') {
        res.writeHead(302, { Location: 'http://origin-b.example/hop' });
        res.end();
        return;
      }
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end('{"ok":true}');
    });
    const proxy = http.createServer((_req, res) => {
      res.writeHead(400);
      res.end();
    });
    proxy.on('connect', (req, socket) => {
      seen.push({ target: String(req.url), auth: req.headers['proxy-authorization'] });
      socket.write('HTTP/1.1 200 Connection Established\r\n\r\n');
      origin.emit('connection', socket);
    });
    await new Promise<void>((resolve) => proxy.listen(0, '127.0.0.1', resolve));
    try {
      const port = (proxy.address() as { port: number }).port;
      const client = new DefaultApiClient(
        TransportOptions.builder().proxy(`http://user:pass@127.0.0.1:${port}`).followRedirects(true).build(),
      );
      const response = await client.sendRequest('GET', 'http://origin-a.example/start', {}, null);
      expect(response.statusCode).toBe(200);
      expect(seen.map((s) => s.target)).toEqual(['origin-a.example:80', 'origin-b.example:80']);
      expect(seen.every((s) => s.auth !== undefined)).toBe(true);
    } finally {
      proxy.close();
    }
  });

  it('bhv misc 129 a proxy credential the SDK adds is not sent again when a redirect moves an HTTPS request to another origin', async () => {
    const calls = scriptFetch([{ status: 302, location: 'https://other.example/landing' }, { status: 200 }]);
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest('GET', 'https://api.example/start', { 'Proxy-Authorization': 'Basic dXNlcjpwYXNz' }, null);
    expect(new Headers(calls[0].init.headers).has('proxy-authorization')).toBe(true);
    expect(new Headers(calls[1].init.headers).has('proxy-authorization')).toBe(false);
  });

  it('bhv misc 130 a credential removed by a cross-origin hop is not restored when a later redirect returns to the original origin', async () => {
    const calls = scriptFetch([
      { status: 302, location: 'https://other.example/hop' },
      { status: 302, location: 'https://api.example/back' },
      { status: 200 },
    ]);
    const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    await client.sendRequest('GET', 'https://api.example/start', { Authorization: 'Bearer secret' }, null);
    const auth = (i: number) => new Headers(calls[i].init.headers).get('authorization');
    expect(auth(0)).toBe('Bearer secret');
    expect(auth(1)).toBeNull();
    expect(auth(2)).toBeNull();
  });

  it('bhv misc 133 a 300 or 305 response is returned as it is, even when it carries a Location header', async () => {
    for (const status of [300, 305]) {
      const calls = scriptFetch([{ status, location: 'https://example.com/elsewhere' }]);
      const client = new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
      const response = await client.sendRequest('GET', 'https://example.com/start', {}, null);
      expect(response.statusCode).toBe(status);
      expect(calls).toHaveLength(1);
    }
  });
});

describe('DefaultApiClient retry misc behaviours', () => {
  const url = 'https://api.example.com/items';

  /** A transport that answers each attempt with the next step: a status code, or an error it throws. */
  function scripted(steps: Array<number | Error>): { fetch: typeof fetch; methods: string[] } {
    const methods: string[] = [];
    const fn = (async (_input: unknown, init?: RequestInit) => {
      methods.push(String(init?.method ?? 'GET'));
      const step = steps[Math.min(methods.length - 1, steps.length - 1)]!;
      if (step instanceof Error) throw step;
      return new Response(step === 200 ? '{}' : '', {
        status: step,
        headers: { 'content-type': 'application/json' }
      });
    }) as unknown as typeof fetch;
    return { fetch: fn, methods };
  }

  /** The TypeError fetch rejects with when the connection drops before any response. */
  function connectionDropped(): TypeError {
    return new TypeError('fetch failed', {
      cause: Object.assign(new Error('socket hang up'), { code: 'ECONNRESET' })
    });
  }

  function clientFor(fetchFn: typeof fetch): DefaultApiClient {
    return new DefaultApiClient(TransportOptions.builder().fetch(fetchFn).build());
  }

  test('bhvMisc160 an error that is not a network failure is never retried', async () => {
    const transport = scripted([new Error('boom'), 200]);
    const error = await clientFor(transport.fetch).sendRequest('GET', url, {}, null).catch((e: unknown) => e);
    expect(error).not.toBeInstanceOf(NetworkError);
    expect(transport.methods).toHaveLength(1);
  });

  test('bhvMisc161 a request whose connection drops is sent the expected number of times, QUERY being idempotent', async () => {
    for (const [method, attempts] of [
    ['POST', 1],
    ['PATCH', 1],
    ['QUERY', 2]
  ] as const) {
      const transport = scripted([connectionDropped(), 200]);
      const outcome: unknown = await clientFor(transport.fetch)
        .sendRequest(method, url, {}, method === 'QUERY' ? '{}' : null)
        .catch((error: unknown) => error);
      if (method === 'QUERY') {
        expect((outcome as { statusCode: number }).statusCode).toBe(200);
      } else {
        expect(outcome).toBeInstanceOf(NetworkError);
      }
      expect(transport.methods).toHaveLength(attempts);
    }
  });

  test('bhvMisc163 a one-shot stream body is not replayed on a retryable status, a text body is replayed', async () => {
    const streamTransport = scripted([503, 200]);
    const stream = Readable.from(['payload']);
    await clientFor(streamTransport.fetch).sendRequest('POST', url, {}, stream as unknown as Record<string, unknown>).catch(() => undefined);
    expect(streamTransport.methods).toHaveLength(1);

    const textTransport = scripted([503, 200]);
    const response = await clientFor(textTransport.fetch).sendRequest('POST', url, {}, 'payload');
    expect(response.statusCode).toBe(200);
    expect(textTransport.methods).toHaveLength(2);
  });

  test('bhvMisc170 a TLS certificate failure is a network error on the first attempt and is not retried', async () => {
    const tlsFailure = new TypeError('fetch failed', {
      cause: Object.assign(new Error('unable to verify the first certificate'), { code: 'UNABLE_TO_VERIFY_LEAF_SIGNATURE' })
    });
    const transport = scripted([tlsFailure, 200]);
    await expect(clientFor(transport.fetch).sendRequest('GET', url, {}, null)).rejects.toBeInstanceOf(NetworkError);
    expect(transport.methods).toHaveLength(1);
  });

  test('bhvMisc186 a non-fetch value and a ready-made fetch combined with a CA bundle are refused when the options are built', () => {
    const transport = scripted([200]);
    expect(() => TransportOptions.builder().fetch('not a function' as unknown as typeof fetch).build()).toThrow(TypeError);
    expect(() => TransportOptions.builder().fetch(transport.fetch).caCertPath('/path/to/ca.pem').build()).toThrow(TypeError);
  });
});

