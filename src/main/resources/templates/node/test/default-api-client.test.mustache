  });

  /*
   * #4 — the OAuth2/OIDC auth path (token exchange, discovery) must honour
   * the SAME transport options (custom CA, verifySsl, timeout) as the main
   * API client. The auth helpers route every HTTP call through the injected
   * ApiClient, which the unified client constructs from the user's
   * TransportOptions — so a self-signed endpoint is reachable on the auth
   * path exactly when verifySsl=false is set, and rejected otherwise.
   */
  describe('auth path honours transport TLS options (#4)', () => {
    test('token exchange reaches a self-signed endpoint with verifySsl=false', async () => {
      const chasmUrl = process.env['CHASM_HTTPS_URL']!;

      const transport = TransportOptions.builder()
        .verifySsl(false)
        .build();

      const manager = new OAuth2TokenManager();
      manager.setApiClient(new DefaultApiClient(transport));

      /* The echo endpoint returns 200 with a JSON body that has no
       * access_token, so the manager rejects with OAuth2TokenError —
       * proving the POST actually reached the server over the self-signed
       * TLS. If transport options were ignored on the auth path, the
       * request would instead reject with a certificate error before any
       * response was received. */
      await expect(
        manager.getAccessToken(`${chasmUrl}/test/echo`, { grant_type: 'client_credentials' })
      ).rejects.toBeInstanceOf(OAuth2TokenError);
    }, 30000);

    test('token exchange rejects a self-signed endpoint when verifySsl is left on', async () => {
      const chasmUrl = process.env['CHASM_HTTPS_URL']!;

      // Default transport: verifySsl is ON. The self-signed chasm cert is
      // not in the system trust store, so the token POST must fail at the
      // TLS layer (a different error than the missing-access_token case
      // above), confirming the auth path does not silently weaken TLS.
      const manager = new OAuth2TokenManager();
      manager.setApiClient(new DefaultApiClient());

      const error = await manager
        .getAccessToken(`${chasmUrl}/test/echo`, { grant_type: 'client_credentials' })
        .then(() => null, (e: unknown) => e);
      expect(error).not.toBeNull();
      expect(error).not.toBeInstanceOf(OAuth2TokenError);
    }, 30000);
  });

  describe('User-Agent header', () => {
    test('injects custom User-Agent header', async () => {
      const chasmUrl = process.env['CHASM_HTTP_URL']!;

      const transport = TransportOptions.builder()
        .userAgent('MyApp/1.0')
        .build();

      const client = new DefaultApiClient(transport);
      const response = await client.sendRequest(
        'GET',
        `${chasmUrl}/test/echo`,
        {},
        null
      );

      expect(response.statusCode).toBe(200);
      const json = JSON.parse(response.body);
      expect(json.headers['user-agent']).toBe('MyApp/1.0');
    });
  });

  describe('X-Request-ID injection', () => {
    test('injects X-Request-ID header with UUID format', async () => {
      const chasmUrl = process.env['CHASM_HTTP_URL']!;

      const transport = TransportOptions.builder()
        .injectRequestId(true)
        .build();

      const client = new DefaultApiClient(transport);
      const response = await client.sendRequest(
        'GET',
        `${chasmUrl}/test/echo`,
        {},
        null
      );

      expect(response.statusCode).toBe(200);
      const json = JSON.parse(response.body);
      const requestId = json.headers['x-request-id'];
      expect(requestId).toBeDefined();
      expect(requestId).toMatch(
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
      );
    });

    test('generates unique X-Request-ID per request', async () => {
      const chasmUrl = process.env['CHASM_HTTP_URL']!;

      const transport = TransportOptions.builder()
        .injectRequestId(true)
        .build();

      const client = new DefaultApiClient(transport);

      const response1 = await client.sendRequest(
        'GET',
        `${chasmUrl}/test/echo`,
        {},
        null
      );
      const requestId1 = JSON.parse(response1.body).headers['x-request-id'];

      const response2 = await client.sendRequest(
        'GET',
        `${chasmUrl}/test/echo`,
        {},
        null
      );
      const requestId2 = JSON.parse(response2.body).headers['x-request-id'];

      expect(requestId1).not.toBe(requestId2);
    });
  });

  describe('default headers', () => {
    test('includes transport-level default headers', async () => {
      const chasmUrl = process.env['CHASM_HTTP_URL']!;

      const transport = TransportOptions.builder()
        .defaultHeader('X-Custom', 'custom-value')
        .build();

      const client = new DefaultApiClient(transport);
      const response = await client.sendRequest(
        'GET',
        `${chasmUrl}/test/echo`,
        {},
        null
      );

      expect(response.statusCode).toBe(200);
      const json = JSON.parse(response.body);
      expect(json.headers['x-custom']).toBe('custom-value');
    });

    test('caller headers override transport default headers', async () => {
      const chasmUrl = process.env['CHASM_HTTP_URL']!;

      const transport = TransportOptions.builder()
        .defaultHeader('Accept', 'text/plain')
        .build();

      const client = new DefaultApiClient(transport);
      const response = await client.sendRequest(
