     * Gap AM: verifySsl=false must disable BOTH cert-chain AND
     * hostname verification (curl -k semantics). The chasm cert names
     * `chasm`, `localhost`, `host.docker.internal` and the IP 127.0.0.1,
     * but no other address. Connecting to the mock by the IP address its
     * host name resolves to therefore forces a hostname mismatch
     * independent of chain trust, so we can assert that turning off
     * verification skips the hostname check too.
     */

    test('bhv transport 025 verifySsl=true rejects hostname mismatch (the cert does not name the address)', async () => {
      const caCertPath = process.env['CA_CERT_PATH']!;

      const transport = TransportOptions.builder()
        .verifySsl(true)
        .caCertPath(caCertPath)
        .maxRetries(0)
        .build();

      const client = new DefaultApiClient(transport);
      await expect(
        client.sendRequest('GET', `${await ipHttpsUrl()}/test/echo`, {}, null)
      ).rejects.toBeInstanceOf(NetworkError);
    });

    test('bhv transport 062 verifySsl=false accepts a certificate that fails validation (curl -k semantics)', async () => {
      const transport = TransportOptions.builder()
        .verifySsl(false)
        .build();

      const client = new DefaultApiClient(transport);
