  test('bhv lifecycle 002 api key header rejects crlf and non ascii', () => {
    expect(() => new ApiKeyHeaderAuthenticator('{{{basePath}}}', 'abc\r\nInjected: yes')).toThrow(TypeError);
    expect(() => new ApiKeyHeaderAuthenticator('{{{basePath}}}', 'kéy')).toThrow(TypeError);
