describe('{{clientClassName}}', () => {
  const authenticator = new BearerAuthenticator('{{{basePath}}}', 'test-token');

  test('construct with authenticator only', () => {
    const client = new {{clientClassName}}(authenticator);

    expect(client).toBeDefined();
  });

  test('construct with authenticator and transport options', () => {
    const transport = TransportOptions.builder().build();

    const client = new {{clientClassName}}(authenticator, transport);

    expect(client).toBeDefined();
  });

  test('BearerAuthenticator rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () => {
    expect(() => new BearerAuthenticator('{{{basePath}}}', 'tok\r\nInjected: yes')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('{{{basePath}}}', 'ñoño')).toThrow(TypeError);
  });

  test('BearerAuthenticator rejects an empty or whitespace token', () => {
    // bearer-no-empty-token-guard: an empty/whitespace token would emit a
    // bare "Authorization: Bearer " header that silently fails auth.
    expect(() => new BearerAuthenticator('{{{basePath}}}', '')).toThrow(TypeError);
    expect(() => new BearerAuthenticator('{{{basePath}}}', '   ')).toThrow(TypeError);
  });

  test('authenticators redact the secret from default string/inspect/JSON', () => {
    // authenticator-secret-in-default-string-repr: console.log / util.inspect
    // / JSON.stringify must never leak the live credential.
    const bearer = new BearerAuthenticator('{{{basePath}}}', 'super-secret-token');
    expect(util.inspect(bearer)).not.toContain('super-secret-token');
    expect(JSON.stringify(bearer)).not.toContain('super-secret-token');
    expect(`${util.inspect(bearer)}`).toContain('***');

    const basic = new BasicAuthenticator('{{{basePath}}}', 'alice', 'pw-secret-123');
    expect(util.inspect(basic)).not.toContain('pw-secret-123');
    expect(JSON.stringify(basic)).not.toContain('pw-secret-123');

    const apiKey = new ApiKeyAuthenticator('{{{basePath}}}', 'X-Api-Key', 'key-secret-xyz', ApiKeyLocation.HEADER);
    expect(util.inspect(apiKey)).not.toContain('key-secret-xyz');
    expect(JSON.stringify(apiKey)).not.toContain('key-secret-xyz');
  });

  test('ApiKeyAuthenticator HEADER rejects CR/LF and non-ASCII (RFC 7230 §3.2.6)', () => {
    // HEADER location must reject anything outside printable ASCII +
    // TAB to prevent header injection (\r\n) and silent UTF-8 mangling.
    expect(() => new ApiKeyAuthenticator('{{{basePath}}}', 'X-Api-Key', 'abc\r\nInjected: yes', ApiKeyLocation.HEADER)).toThrow(TypeError);
    expect(() => new ApiKeyAuthenticator('{{{basePath}}}', 'X-Api-Key', 'kéy', ApiKeyLocation.HEADER)).toThrow(TypeError);
    // Non-header locations accept arbitrary chars.
    const queryAuth = new ApiKeyAuthenticator('{{{basePath}}}', 'api_key', 'kéy', ApiKeyLocation.QUERY);
    expect(queryAuth.getQueryParams()).toEqual({ api_key: 'kéy' });
  });

  test('API groups are accessible', () => {
    const client = new {{clientClassName}}(authenticator);

