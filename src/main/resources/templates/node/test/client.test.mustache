  describe('closing (F1078)', () => {
    const host = 'https://api.example.com';
    const closable = new BearerAuthenticator(host, 'test-token');
    function gatedFetch(): { transport: TransportOptions; started: Promise<void>; release: () => void; calls: () => number } {
      let release!: () => void;
      let started!: () => void;
      const gate = new Promise<void>((resolve) => {
        release = resolve;
      });
      const startedPromise = new Promise<void>((resolve) => {
        started = resolve;
      });
      let calls = 0;
      const stub = (async (): Promise<Response> => {
        calls++;
        started();
        await gate;
        return new Response('{"id":1,"name":"x","photoUrls":[]}', {
          status: 200,
          headers: { 'content-type': 'application/json' },
        });
      }) as typeof fetch;
      return { transport: TransportOptions.builder().fetch(stub).build(), started: startedPromise, release, calls: () => calls };
    }

    test('a request already running finishes after close()', async () => {
      const { transport, started, release } = gatedFetch();
      const client = new {{clientClassName}}(closable, transport);

      const pending = client.pet.getPetById(1);
      await started;
      await client.close();
      release();

      expect((await pending).name).toBe('x');
    });

    test('a request issued after close() fails with the one closed-client error and never reaches the transport', async () => {
      const { transport, calls } = gatedFetch();
      const client = new {{clientClassName}}(closable, transport);

      await client.close();

      await expect(client.pet.getPetById(1)).rejects.toThrow(
        new Error('ApiClient has been closed and can no longer send requests'),
      );
      expect(calls()).toBe(0);
    });

    test('a second close() is a no-op', async () => {
      const client = new {{clientClassName}}(closable);

      await client.close();

      await expect(client.close()).resolves.toBeUndefined();
    });

    test('close() does not wait for a request that is still running', async () => {
      const { transport, started, release } = gatedFetch();
      const client = new {{clientClassName}}(closable, transport);
      const pending = client.pet.getPetById(1);
      await started;

      await expect(client.close()).resolves.toBeUndefined();

      release();
      await pending;
    });
  });

  test('bhv lifecycle 008 close() makes the owned transport reject further requests', async () => {
    const client = new {{clientClassName}}(authenticator);

    await client.close();
    await client.close();

    const api = client as unknown as { ownedClient: ApiClient };
