import { ServerVariable } from '../src/server-configuration{{importFileExtension}}';

describe('ServerVariable', () => {
  it('exposes its default value, description, and enum values', () => {
    const variable = new ServerVariable('prod', 'the environment', ['prod', 'staging']);
    expect(variable.defaultValue).toBe('prod');
    expect(variable.description).toBe('the environment');
    expect(variable.enumValues).toEqual(['prod', 'staging']);
  });

  it('allows a null description and an empty enum (any value accepted)', () => {
    const variable = new ServerVariable('1', null, []);
    expect(variable.description).toBeNull();
    expect(variable.enumValues).toEqual([]);
  });

  it('freezes its enum values so the array cannot be mutated', () => {
    const variable = new ServerVariable('prod', null, ['prod', 'staging']);
    expect(Object.isFrozen(variable.enumValues)).toBe(true);
  });

  it('copies the enum values so later mutation of the source does not leak in', () => {
    const source = ['prod'];
    const variable = new ServerVariable('prod', null, source);
    source.push('staging');
    expect(variable.enumValues).toEqual(['prod']);
  });
});
