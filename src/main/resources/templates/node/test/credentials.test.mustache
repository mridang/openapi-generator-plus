{{>api_info}}

import { readEnvCredential, resolveCredential, resolveOAuthCredential } from '../src/auth/credentials{{importFileExtension}}';

const TOKEN_VARIABLE = '{{envVarPrefix}}_TOKEN';

describe('credentials', () => {
  const saved = process.env[TOKEN_VARIABLE];

  afterEach(() => {
    if (saved === undefined) {
      delete process.env[TOKEN_VARIABLE];
    } else {
      process.env[TOKEN_VARIABLE] = saved;
    }
  });

  it('bhv misc 207 reads the variable of the field', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(readEnvCredential(TOKEN_VARIABLE)).toBe('from-env');
  });

  it('bhv auth 003 treats an unset variable as absent', () => {
    delete process.env[TOKEN_VARIABLE];
    expect(readEnvCredential(TOKEN_VARIABLE)).toBeUndefined();
  });

  it('bhv auth 040 treats an empty variable as unset', () => {
    process.env[TOKEN_VARIABLE] = '';
    expect(readEnvCredential(TOKEN_VARIABLE)).toBeUndefined();
  });

  it('bhv authscheme 009 an explicit value wins over the environment', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(resolveCredential('explicit', TOKEN_VARIABLE, 'Token')).toBe('explicit');
  });

  it('bhv langnode 058 falls back to the environment when no value is passed', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(resolveCredential(undefined, TOKEN_VARIABLE, 'Token')).toBe('from-env');
  });

  it('bhv auth 023 keeps an explicit empty string, so the caller sees the mistake', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(resolveCredential('', TOKEN_VARIABLE, 'Token')).toBe('');
  });

  it('bhv langnode 059 names the variable when nothing supplies the value', () => {
    delete process.env[TOKEN_VARIABLE];
    expect(() => resolveCredential(undefined, TOKEN_VARIABLE, 'Token')).toThrow(
      new TypeError(`Token is required: pass it explicitly or set ${TOKEN_VARIABLE}`)
    );
  });

  it('bhv langnode 060 refuses an OAuth2 credential from the environment that has a line break', () => {
    process.env[TOKEN_VARIABLE] = 'bad\r\nvalue';
    expect(() => resolveOAuthCredential(undefined, TOKEN_VARIABLE, 'OAuth2 client ID')).toThrow(
      new TypeError('OAuth2 client ID must not contain CR, LF or NUL')
    );
  });

  it('bhv langnode 061 accepts an OAuth2 credential from the environment without a line break', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(resolveOAuthCredential(undefined, TOKEN_VARIABLE, 'OAuth2 client ID')).toBe('from-env');
  });

  it('bhv auth 007 reads only the variable it is told to read', () => {
    process.env[TOKEN_VARIABLE] = 'from-env';
    expect(() => resolveCredential(undefined, `${TOKEN_VARIABLE}_UNSET_SECOND`, 'Token')).toThrow(TypeError);
  });

  it('bhv auth 024 each field takes its own passed value or its own variable, independently', () => {
    const second = `${TOKEN_VARIABLE}_SECOND`;
    process.env[TOKEN_VARIABLE] = 'env-first';
    process.env[second] = 'env-second';
    try {
      expect(resolveCredential('passed-first', TOKEN_VARIABLE, 'First')).toBe('passed-first');
      expect(resolveCredential(undefined, second, 'Second')).toBe('env-second');
    } finally {
      delete process.env[second];
    }
  });

  it('bhv authbearer 025 reads the variable once, when the credential is resolved', () => {
    process.env[TOKEN_VARIABLE] = 'first';
    const resolved = resolveCredential(undefined, TOKEN_VARIABLE, 'Token');
    process.env[TOKEN_VARIABLE] = 'second';
    expect(resolved).toBe('first');
  });
});
