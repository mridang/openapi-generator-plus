import * as fs from 'node:fs';
import * as util from 'node:util';
import * as path from 'node:path';
import { ObjectSerializer, reattachAdditionalProperties } from '../src/object-serializer{{importFileExtension}}';
import { SerializationError } from '../src/errors/index{{importFileExtension}}';
import { Blobs, Category, Counters, Freeform, Metadata, Moments, Pet, Roster, Sparse } from '../src/models/index{{importFileExtension}}';

describe('Metadata', () => {
  describe('package.json manifest', () => {
    test('bhv models 002 declares a non-empty description', () => {
      // manifest-description-missing: the published manifest must carry a
      // description (wired from the spec's appDescription) so registries do
      // not show an empty description.
      const pkgPath = path.resolve(__dirname, '..', 'package.json');
      const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf-8')) as { description?: string };
      expect(typeof pkg.description).toBe('string');
      expect(pkg.description!.length).toBeGreaterThan(0);
    });

    test('bhv mocking 009 the README has a Testing your code section naming the group interface and the client interface', () => {
      const readme = fs.readFileSync(path.resolve(__dirname, '..', 'README.md'), 'utf-8');
      const start = readme.indexOf('\n### Testing your code\n');
      expect(start).toBeGreaterThanOrEqual(0);
      const end = readme.indexOf('\n### ', start + 4);
      const section = end < 0 ? readme.slice(start) : readme.slice(start, end);
{{#apiInfo}}
{{#apis}}
{{#-first}}
{{#operations}}
      expect(section).toContain('{{classname}}Interface');
{{/operations}}
{{/-first}}
{{/apis}}
{{/apiInfo}}
      expect(section).toContain('{{clientClassName}}Interface');
    });

    test('bhv langnode 082 declares sideEffects so a bundler can drop unused operations', () => {
      // The only module with an import-time side effect is the serializer, which
      // loads reflect-metadata; everything else may be tree-shaken.
      const pkgPath = path.resolve(__dirname, '..', 'package.json');
      const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf-8')) as { sideEffects?: string[] };
      expect(pkg.sideEffects).toEqual(['./dist/src/object-serializer.js']);
    });
  });

  describe('generated model docblocks (L1 parity)', () => {
    test('bhv models 006 the file header prints the info description verbatim, without a backslash before a quote', () => {
      const source = fs.readFileSync(path.resolve(__dirname, '..', 'src', 'models', 'account.ts'), 'utf-8');
      const header = source.split('\n').slice(0, 3).join('\n');

      expect(header).toContain('"quoted" text');
      expect(header).not.toContain('\\"');
    });

    test('bhv models 007 no generated model carries a literal "@example null" / "Example: null" doc line', () => {
      // A property whose schema example is the JSON null literal must not leak a
      // useless `@example null` JSDoc line into the generated model. The shared
      // codegen nulls such an example so the template's example section is
      // falsy and emits nothing; this asserts that contract holds across every
      // generated model file rather than re-appearing as documentation noise.
      const modelsDir = path.resolve(__dirname, '..', 'src', 'models');
      const modelFiles = fs
        .readdirSync(modelsDir)
        .filter((f) => f.endsWith('.ts') && f !== 'index.ts');
      expect(modelFiles.length).toBeGreaterThan(0);
      for (const file of modelFiles) {
        const source = fs.readFileSync(path.join(modelsDir, file), 'utf-8');
        expect(source).not.toMatch(/@example\s+null\b/);
        expect(source).not.toMatch(/Example:\s+null\b/);
      }
    });

    test('bhv serializationobject 227 a model externalDocs description is rendered raw, without HTML entities', () => {
      const source = fs.readFileSync(path.resolve(__dirname, '..', 'src', 'models', 'account.ts'), 'utf-8');

      expect(source).toContain(`* @see {@link https://example.com/docs/account} Account <docs> & "notes" it's here\n`);
    });
  });

  describe('schema constraints in model doc comments (documentation only)', () => {
    test('bhv langnode 083 a constrained property lists its pattern and bounds as doc tags', () => {
      const source = fs.readFileSync(path.resolve(__dirname, '..', 'src', 'models', 'pet.ts'), 'utf-8');

      expect(source).toContain('@minLength 2');
      expect(source).toContain('@maxLength 8');
      expect(source).toMatch(/@pattern .*\(\?!admin\)/);
    });

    test('bhv langnode 084 the constraints are not enforced at runtime', () => {
      expect(() => new Pet({ name: 'Fido', photoUrls: new Set<string>(), nickname: 'x' })).not.toThrow();
    });
  });

  describe('FindPetsByStatusOptions deprecated parameter (L3)', () => {
    test('bhv langnode 085 deprecated param status is marked deprecated in options', () => {
      // L3: the spec declares the findPetsByStatus `status` query parameter
      // deprecated:true. The deprecation must propagate onto the per-operation
      // Options field — not just operations and model properties — so callers
      // referencing `options.status` get an editor strikethrough / deprecation
      // warning. This asserts the generated Options carries an `@deprecated`
      // JSDoc tag on the `status` member.
      const optionsPath = path.resolve(
        __dirname,
        '..',
        'src',
        'api',
        'options',
        'find-pets-by-status-options.ts'
      );
      const source = fs.readFileSync(optionsPath, 'utf-8');
      // The `@deprecated` tag must appear immediately above the `status` field.
      expect(source).toMatch(/@deprecated[\s\S]*?readonly status\b/);
    });
  });

  describe('Metadata model (typed additionalProperties)', () => {
    test('bhv models 008 serializes empty metadata', () => {
      const metadata = new Metadata();
      const json = ObjectSerializer.serialize(metadata);
      expect(json).toBeDefined();
    });

    test('bhv models 003 deserializes empty object', () => {
      const metadata = ObjectSerializer.deserialize({}, Metadata);
      expect(metadata).toBeDefined();
    });

    test('bhv models 012 util.inspect dumps the declared fields and the extra keys', () => {
      const metadata = new Metadata({ createdAt: new Date('2024-01-15T10:30:00Z'), customField: 'hello' });
      const text = util.inspect(metadata);
      expect(text).toContain('createdAt');
      expect(text).toContain("customField: 'hello'");
    });

    test('bhv models 004 deserializes additional string properties', () => {
      const json = {
        createdAt: '2024-01-01T00:00:00Z',
        customField: 'hello'
      };
      const metadata = ObjectSerializer.deserialize(json, Metadata);
      expect(metadata).toBeDefined();
      expect(metadata!.createdAt instanceof Date).toBe(true);
      expect(metadata!.createdAt!.toISOString()).toBe('2024-01-01T00:00:00.000Z');
    });

    test('bhv models 011 round-trip preserves additional properties', () => {
      const original = new Metadata({
        createdAt: new Date('2024-01-15T10:30:00Z')
      });
      (original as Record<string, unknown>)['customField'] = 'test-value';
      const serialized = ObjectSerializer.serialize(original);
      expect(typeof serialized).toBe('string');
      const deserialized = ObjectSerializer.deserialize(JSON.parse(serialized), Metadata);
      expect(deserialized).toBeDefined();
      expect(deserialized!.createdAt instanceof Date).toBe(true);
      expect(deserialized!.createdAt!.toISOString()).toBe('2024-01-15T10:30:00.000Z');
    });

    test('bhv models 009 additional properties are a string-keyed record of the value type', () => {
      const metadata = ObjectSerializer.deserialize({ customField: 'hello' }, Metadata) as Metadata;
      const extras: Record<string, string> = metadata.additionalProperties;
      expect(extras['customField']).toBe('hello');
    });

    test('bhv models 025 an additional property of the wrong JSON type fails the decode', () => {
      for (const body of [{ a: 2.5 }, { a: '2' }, { a: 3000000000 }]) {
        expect(() => ObjectSerializer.deserialize(body, Counters)).toThrow(SerializationError);
      }
      expect(() => ObjectSerializer.deserialize({ a: 3 }, Metadata)).toThrow(SerializationError);
    });

    test('bhv models 026 an additional property whose value type is a model decodes to that model', () => {
      const roster = ObjectSerializer.deserialize({ label: 'l', a: { id: 1, name: 'x' } }, Roster) as Roster;
      const category: Category | undefined = roster.additionalProperties['a'];
      expect(category).toBeInstanceOf(Category);
      expect(category?.id).toBe(1);
      expect(category?.name).toBe('x');
      expect(() => ObjectSerializer.deserialize({ a: { id: 'x' } }, Roster)).toThrow(SerializationError);
    });

    test('bhv models 027 a null additional property is rejected unless the value schema is nullable', () => {
      expect(() => ObjectSerializer.deserialize({ a: null }, Counters)).toThrow(SerializationError);
      const sparse = ObjectSerializer.deserialize({ a: null }, Sparse) as Sparse;
      expect(Object.keys(sparse.additionalProperties)).toEqual(['a']);
      expect(sparse.additionalProperties['a']).toBeNull();
    });

    test('bhv models 028 a typed additional property is written flat in its wire form', () => {
      const moments = ObjectSerializer.deserialize({ label: 'l', at: '2024-01-01T00:00:00Z' }, Moments) as Moments;
      expect(moments.additionalProperties['at']).toBeInstanceOf(Date);
      const wire = JSON.parse(ObjectSerializer.serialize(moments)) as Record<string, unknown>;
      expect(Object.keys(wire)).toEqual(['label', 'at']);
      expect(wire['at']).toBe('2024-01-01T00:00:00.000+00:00');
      const blobs = ObjectSerializer.deserialize({ b: 'aGk=' }, Blobs) as Blobs;
      expect(blobs.additionalProperties['b'].toString('utf8')).toBe('hi');
      expect(ObjectSerializer.serialize(blobs)).toBe('{"b":"aGk="}');
    });

    test('bhv models 029 a free-form additionalProperties keeps every JSON value as it arrives', () => {
      const freeform = ObjectSerializer.deserialize({ a: 1, b: 'x', c: [true], d: null }, Freeform) as Freeform;
      expect(freeform.additionalProperties).toEqual({ a: 1, b: 'x', c: [true], d: null });
    });
  });

  describe('Metadata additionalProperties round-trip (H11)', () => {
    test('bhv langnode 086 undeclared wire keys survive deserialize instead of being dropped', () => {
      // H11: Metadata declares `additionalProperties: {type: string}`, so keys
      // beyond the declared `createdAt` are free-form data that must SURVIVE a
      // round-trip. plainToInstance(excludeExtraneousValues) drops every key
      // without an @Expose decorator — the index signature is not exposed — so
      // without the re-attach those extras are silently lost (data corruption).
      const wire = {
        createdAt: '2020-01-02T03:04:05.000Z',
        region: 'eu-west',
        tier: 'gold',
      };
      const restored = ObjectSerializer.deserialize(wire, Metadata) as Metadata &
        Record<string, unknown>;

      expect(restored.createdAt).toBeInstanceOf(Date);
      expect(restored.region).toBe('eu-west');
      expect(restored.tier).toBe('gold');

      // And they survive a full serialize -> parse -> deserialize round-trip.
      const roundTripped = ObjectSerializer.deserialize(
        ObjectSerializer.parseJson(ObjectSerializer.serialize(restored)),
        Metadata,
      ) as Metadata & Record<string, unknown>;
      expect(roundTripped.region).toBe('eu-west');
      expect(roundTripped.tier).toBe('gold');
    });
  });

  describe('Metadata additionalProperties accessor', () => {
    test('bhv models 010 a declared property wins over a colliding additional property', () => {
      const metadata = ObjectSerializer.deserialize({ createdAt: '2024-01-01T00:00:00Z' }, Metadata) as Metadata;
      expect(metadata.createdAt).toBeInstanceOf(Date);
      expect(metadata.createdAt!.toISOString()).toBe('2024-01-01T00:00:00.000Z');
      expect(metadata.additionalProperties).toEqual({});
      expect(Object.keys(JSON.parse(ObjectSerializer.serialize(metadata)) as Record<string, unknown>)).toEqual(['createdAt']);
    });

    test('bhv models 001 exposes the undeclared keys of a deserialized instance', () => {
      const metadata = ObjectSerializer.deserialize(
        { createdAt: '2024-01-01T00:00:00Z', customField: 'hello' },
        Metadata,
      ) as Metadata;
      expect(metadata.additionalProperties).toEqual({ customField: 'hello' });
    });

    test('bhv models 023 undeclared keys named like SDK methods are kept as additional properties, not treated as methods', () => {
      const metadata = ObjectSerializer.deserialize(
        { createdAt: '2024-01-01T00:00:00Z', equals: 'x', toJSON: 'y' },
        Metadata,
      ) as Metadata;
      expect(metadata.additionalProperties).toEqual({ equals: 'x', toJSON: 'y' });
      expect(typeof Metadata.prototype.equals).toBe('function');
    });

    test('bhv models 024 a newly built model leaves its optional properties unset', () => {
      const metadata = new Metadata();
      expect(metadata.createdAt).toBeUndefined();
      expect(metadata.additionalProperties).toEqual({});
    });

    test('bhv langnode 087 exposes the undeclared keys of a constructed instance', () => {
      const metadata = new Metadata({ createdAt: new Date('2024-01-01T00:00:00Z'), foo: 1 });
      expect(metadata.additionalProperties).toEqual({ foo: 1 });
    });

    test('bhv models 013 is an empty record, never undefined, when there are no extras', () => {
      const metadata = new Metadata({ createdAt: new Date('2024-01-01T00:00:00Z') });
      expect(metadata.additionalProperties).toEqual({});
      expect(new Metadata().additionalProperties).toEqual({});
    });

    test('bhv models 022 a generated model whose schema allows undeclared properties reports that it does', () => {
      expect(Object.getOwnPropertyDescriptor(Metadata.prototype, 'additionalProperties')?.get).toBeDefined();
      expect('additionalProperties' in new Category({ id: 1, name: 'Dogs' })).toBe(false);
    });

    test('bhv langnode 088 is typed like the index signature so typed values read without a cast', () => {
      const metadata = new Metadata({ foo: 'a', bar: 'b' });
      const extras: Record<string, Metadata[string]> = metadata.additionalProperties;
      expect(extras).toEqual({ foo: 'a', bar: 'b' });
    });

    test('bhv misc 145 returns a fresh record on every read', () => {
      const metadata = new Metadata({ foo: 1 });
      metadata.additionalProperties['bar'] = '2';
      expect(metadata.additionalProperties).toEqual({ foo: 1 });
    });

    test('bhv langnode 089 is not serialised as a data key', () => {
      const metadata = new Metadata({ createdAt: new Date('2024-01-01T00:00:00Z'), foo: 1 });
      const wire = JSON.parse(ObjectSerializer.serialize(metadata)) as Record<string, unknown>;
      expect(Object.keys(wire).sort()).toEqual(['createdAt', 'foo']);
      expect(wire).not.toHaveProperty('additionalProperties');
      const empty = JSON.parse(ObjectSerializer.serialize(new Metadata())) as Record<string, unknown>;
      expect(empty).not.toHaveProperty('additionalProperties');
    });

    test('bhv models 005 does not affect equality', () => {
      const left = new Metadata({ foo: 1 });
      const right = new Metadata({ foo: 1 });
      expect(left.equals(right)).toBe(true);
      expect(left.equals(new Metadata({ foo: 2 }))).toBe(false);
    });

    test('bhv misc 287 a wire key literally named additionalProperties is kept as data', () => {
      const metadata = ObjectSerializer.deserialize(
        { createdAt: '2024-01-01T00:00:00Z', additionalProperties: 'x' },
        Metadata,
      ) as Metadata;
      expect(metadata.additionalProperties).toEqual({ additionalProperties: 'x' });
      expect(JSON.parse(ObjectSerializer.serialize(metadata))).toEqual({
        createdAt: '2024-01-01T00:00:00.000+00:00',
        additionalProperties: 'x',
      });
      const built = new Metadata({ additionalProperties: 'y' } as unknown as Partial<Metadata>);
      expect(built.additionalProperties).toEqual({ additionalProperties: 'y' });
    });
  });
});

describe('Metadata additional properties misc behaviours', () => {
  it('bhv misc 142 additional properties are returned unchanged by key and the map holds exactly the stored entries', () => {
    const meta = ObjectSerializer.deserialize(JSON.parse('{"note":"x","owner":"ann"}'), Metadata) as Metadata;
    expect(meta.additionalProperties['note']).toBe('x');
    expect(Object.keys(meta.additionalProperties)).toEqual(['note', 'owner']);
  });

  it('bhv misc 143 a copy keeps the additional properties and compares equal to the original', () => {
    const original = reattachAdditionalProperties(new Metadata({}), { customField: 'a' });
    const copy = ObjectSerializer.deserialize(JSON.parse(ObjectSerializer.serialize(original)), Metadata) as Metadata;
    expect(copy.additionalProperties).toEqual({ customField: 'a' });
    expect(copy).toEqual(original);
  });
});

describe('Metadata map equality misc behaviours', () => {
  it('bhv misc 151 a model holding a map compares equal when the maps hold the same entries and unequal when any entry differs', () => {
    const build = (value: string) => reattachAdditionalProperties(new Metadata({}), { a: '1', b: value });
    expect(build('2')).toEqual(build('2'));
    expect(build('2')).not.toEqual(build('3'));
  });
});


describe('Metadata undeclared keys (misc)', () => {
  test('bhv misc 288 a snake_case key at the top level of an object is captured as an undeclared extra', () => {
    const metadata = ObjectSerializer.deserialize({ region_code: 'emea' }, Metadata) as Metadata;
    expect(metadata.additionalProperties).toEqual({ region_code: 'emea' });
  });

  test('bhv misc 289 a snake_case key inside a list element is captured as an undeclared extra', () => {
    const items = ObjectSerializer.deserializeArray([{ region_code: 'emea' }], (x: unknown) =>
      ObjectSerializer.deserialize(x, Metadata),
    );
    expect(items[0]!.additionalProperties).toEqual({ region_code: 'emea' });
  });

  test('bhv misc 290 an undeclared key whose value is a dictionary survives a full serialize and deserialize round trip', () => {
    const first = ObjectSerializer.deserialize({ labels: { a: 'b' } }, Freeform) as Freeform;
    const second = ObjectSerializer.deserialize(
      JSON.parse(ObjectSerializer.serialize(first)),
      Freeform,
    ) as Freeform;
    expect(second.additionalProperties).toEqual({ labels: { a: 'b' } });
  });
});

describe('Metadata misc free-form behaviours', () => {
  test('bhv misc 249 a free-form object-valued field keeps its object and integer entries through a JSON round trip', () => {
    const first = ObjectSerializer.deserialize({ labels: { a: 1, b: 'x' } }, Freeform) as Freeform;
    const second = ObjectSerializer.deserialize(JSON.parse(ObjectSerializer.serialize(first)), Freeform) as Freeform;
    expect(second.additionalProperties).toEqual({ labels: { a: 1, b: 'x' } });
  });
});
