import type { Context, Tracer } from '@opentelemetry/api';
import type { InMemorySpanExporter as InMemorySpanExporterType, Sampler } from '@opentelemetry/sdk-trace-base';
import { injectTraceContext } from '../src/trace-context-util{{importFileExtension}}';

/*
 * Load OpenTelemetry exactly the way trace-context-util does, rather than
 * importing it. In an ES module package the test runner resolves an `import`
 * through its own registry and the SDK's synchronous load through another, so
 * the two hold separate copies: a span started here would be invisible to the
 * SDK and every assertion below would pass on a no-op. An application has one
 * copy, so this mirrors production rather than working around it.
 */
const loadModule: (id: string) => unknown =
  typeof require === 'function'
    ? require
    : (
        globalThis as unknown as {
          process: {
            getBuiltinModule: (id: string) => {
              createRequire: (path: string) => (id: string) => unknown;
            };
            cwd: () => string;
          };
        }
      ).process
        .getBuiltinModule('node:module')
        .createRequire(`${process.cwd()}/`);

const { context, propagation, ROOT_CONTEXT, trace, TraceFlags } = loadModule(
  '@opentelemetry/api',
) as typeof import('@opentelemetry/api');
const { AsyncLocalStorageContextManager } = loadModule(
  '@opentelemetry/context-async-hooks',
) as typeof import('@opentelemetry/context-async-hooks');
const { TraceState, W3CTraceContextPropagator } = loadModule(
  '@opentelemetry/core',
) as typeof import('@opentelemetry/core');
const {
  AlwaysOffSampler,
  AlwaysOnSampler,
  BasicTracerProvider,
  InMemorySpanExporter,
  SimpleSpanProcessor,
} = loadModule(
  '@opentelemetry/sdk-trace-base',
) as typeof import('@opentelemetry/sdk-trace-base');

describe('TraceContextUtil', () => {
  test('bhv tracing 007 is a no-op without tracer', () => {
    const headers: Record<string, string> = {};
    injectTraceContext(headers);
    expect(Object.keys(headers).length).toBe(0);
  });

  test('bhv tracing 003 empty headers do not cause exception', () => {
    const headers: Record<string, string> = {};
    expect(() => injectTraceContext(headers)).not.toThrow();
    expect(Object.keys(headers).length).toBe(0);
  });

  test('bhv tracing 001 does not inject traceparent without OTel', () => {
    const headers: Record<string, string> = {};
    injectTraceContext(headers);
    expect(headers['traceparent']).toBeUndefined();
  });

  test('bhv tracing 002 does not inject tracestate without OTel', () => {
    const headers: Record<string, string> = {};
    injectTraceContext(headers);
    expect(headers['tracestate']).toBeUndefined();
  });

  test('bhv tracing 010 preserves Authorization header', () => {
    const headers: Record<string, string> = { Authorization: 'Bearer token123' };
    injectTraceContext(headers);
    expect(headers['Authorization']).toBe('Bearer token123');
  });

  test('bhv tracing 011 preserves Content-Type header', () => {
    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
    injectTraceContext(headers);
    expect(headers['Content-Type']).toBe('application/json');
  });

  test('bhv tracing 012 preserves X-Request-ID header', () => {
    const headers: Record<string, string> = { 'X-Request-ID': 'req-12345' };
    injectTraceContext(headers);
    expect(headers['X-Request-ID']).toBe('req-12345');
  });

  test('bhv tracing 009 preserves all existing headers', () => {
    const headers: Record<string, string> = {
      Authorization: 'Bearer token',
      'Content-Type': 'application/json',
      'X-Request-ID': 'abc-123',
    };
    injectTraceContext(headers);
    expect(Object.keys(headers).length).toBe(3);
    expect(headers['Authorization']).toBe('Bearer token');
    expect(headers['Content-Type']).toBe('application/json');
    expect(headers['X-Request-ID']).toBe('abc-123');
  });

  test('bhv misc 002 a trace propagator the caller registers is the one used, and headers already present are kept', () => {
    const custom = {
      inject(_context: unknown, carrier: Record<string, string>): void {
        carrier['x-caller-trace'] = 'registered';
      },
      extract: (context: unknown): unknown => context,
      fields: (): string[] => ['x-caller-trace'],
    };
    /* setGlobalPropagator does not replace a propagator already registered, so clear it first. */
    propagation.disable();
    propagation.setGlobalPropagator(custom as unknown as Parameters<typeof propagation.setGlobalPropagator>[0]);
    try {
      const headers: Record<string, string> = { Authorization: 'Bearer token' };

      injectTraceContext(headers);

      expect(headers['x-caller-trace']).toBe('registered');
      expect(headers['Authorization']).toBe('Bearer token');
    } finally {
      propagation.disable();
      propagation.setGlobalPropagator(new W3CTraceContextPropagator());
    }
  });

  test('bhv tracing 006 injects traceparent when a span is active', async () => {
    const { tracer, exporter } = sdkTracer();
    const headers: Record<string, string> = {};
    const spanContext = await tracer.startActiveSpan('request', async (span) => {
      injectTraceContext(headers);
      span.end();
      return span.spanContext();
    });
    const flags = spanContext.traceFlags.toString(16).padStart(2, '0');
    expect(headers['traceparent']).toBe(`00-${spanContext.traceId}-${spanContext.spanId}-${flags}`);
    expect(exporter.getFinishedSpans().map((s: { name: string }) => s.name)).toEqual(['request']);
  });

  test('bhv tracing 005 includes tracestate when present on the active span', async () => {
    const { tracer } = sdkTracer();
    const headers: Record<string, string> = {};
    await tracer.startActiveSpan('request', {}, remoteParent('vendor=value'), async (span) => {
      injectTraceContext(headers);
      span.end();
    });
    expect(headers['tracestate']).toBe('vendor=value');
  });

  test('bhv tracing 008 omits tracestate when empty on the active span', async () => {
    const { tracer } = sdkTracer();
    const headers: Record<string, string> = {};
    await tracer.startActiveSpan('request', async (span) => {
      injectTraceContext(headers);
      span.end();
    });
    expect(headers['traceparent']).toBeDefined();
    expect(headers['tracestate']).toBeUndefined();
  });

  test('bhv tracing 004 formats trace flags correctly on the active span', async () => {
    const sampled = sdkTracer().tracer;
    const unsampled = sdkTracer(new AlwaysOffSampler()).tracer;
    const sampledHeaders: Record<string, string> = {};
    const unsampledHeaders: Record<string, string> = {};
    await sampled.startActiveSpan('sampled', async (span) => {
      injectTraceContext(sampledHeaders);
      span.end();
    });
    await unsampled.startActiveSpan('unsampled', async (span) => {
      injectTraceContext(unsampledHeaders);
      span.end();
    });
    const sampledFlags = sampledHeaders['traceparent']!.split('-')[3]!;
    const unsampledFlags = unsampledHeaders['traceparent']!.split('-')[3]!;
    /* Two lowercase hex digits; the low bit is the sampled flag. */
    expect(sampledFlags).toMatch(/^[0-9a-f]{2}$/);
    expect(unsampledFlags).toMatch(/^[0-9a-f]{2}$/);
    expect(parseInt(sampledFlags, 16) & TraceFlags.SAMPLED).toBe(TraceFlags.SAMPLED);
    expect(parseInt(unsampledFlags, 16) & TraceFlags.SAMPLED).toBe(0);
  });
});

/*
 * The tests install the AsyncLocalStorage context manager and the W3C
 * propagator the OpenTelemetry SDK registers by default. No global tracer
 * provider is installed: each test drives its own, and so controls the span.
 */
beforeAll(() => {
  context.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());
  propagation.setGlobalPropagator(new W3CTraceContextPropagator());
});

afterAll(() => {
  context.disable();
  propagation.disable();
});

/** A tracer from a real SDK provider that records every finished span in memory. */
function sdkTracer(sampler: Sampler = new AlwaysOnSampler()): { tracer: Tracer; exporter: InMemorySpanExporterType } {
  const exporter = new InMemorySpanExporter();
  const provider = new BasicTracerProvider({
    sampler,
    spanProcessors: [new SimpleSpanProcessor(exporter)],
  });
  return { tracer: provider.getTracer('trace-context-test'), exporter };
}

/** A context whose active span is a sampled remote parent carrying the given tracestate. */
function remoteParent(tracestate: string): Context {
  return trace.setSpanContext(ROOT_CONTEXT, {
    traceId: '0af7651916cd43dd8448eb211c80319c',
    spanId: 'b7ad6b7169203331',
    traceFlags: TraceFlags.SAMPLED,
    traceState: new TraceState(tracestate),
    isRemote: true,
  });
}
