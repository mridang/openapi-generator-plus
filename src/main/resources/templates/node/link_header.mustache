/** One link of a `Link` header: the URI reference and the relation types of its `rel` parameter. */
export interface Link {
  readonly target: string;
  readonly relations: readonly string[];
}

/**
 * Returns the URI reference of the first link whose relation type is `next`.
 *
 * @param header the header value, repeated headers joined with a comma
 * @returns the URI reference exactly as written, or `null` when there is no `next` link
 */
export function nextLink(header: string | null | undefined): string | null {
  if (header == null) {
    return null;
  }
  for (const link of parseLinkHeader(header)) {
    if (link.relations.includes('next')) {
      return link.target;
    }
  }
  return null;
}

/**
 * Reads the `Link` header of RFC 8288. A value is a comma separated list of links, each an
 * angle-bracketed URI reference followed by `;` parameters whose values are tokens or quoted
 * strings. Commas and semicolons inside the brackets or inside a quoted string do not split
 * anything. A link that is malformed is skipped, and the parse goes on with the next comma that is
 * outside brackets and quotes.
 *
 * @param header the header value
 * @returns the links in order
 */
export function parseLinkHeader(header: string): Link[] {
  const links: Link[] = [];
  const n = header.length;
  let i = 0;
  const blank = (c: string | undefined): boolean => c === ' ' || c === '\t';
  while (i < n) {
    while (i < n && (blank(header[i]) || header[i] === ',')) {
      i++;
    }
    if (i >= n) {
      break;
    }
    if (header[i] !== '<') {
      i = skipToComma(header, i);
      continue;
    }
    const close = header.indexOf('>', i + 1);
    if (close < 0) {
      break;
    }
    const target = header.substring(i + 1, close);
    i = close + 1;
    const relations: string[] = [];
    let seenRel = false;
    while (i < n) {
      while (i < n && blank(header[i])) {
        i++;
      }
      if (i >= n || header[i] === ',') {
        break;
      }
      if (header[i] !== ';') {
        i = skipToComma(header, i);
        break;
      }
      i++;
      while (i < n && blank(header[i])) {
        i++;
      }
      const nameStart = i;
      while (i < n && !'=;, \t'.includes(header[i] as string)) {
        i++;
      }
      const name = header.substring(nameStart, i).toLowerCase();
      let value = '';
      if (i < n && header[i] === '=') {
        i++;
        if (i < n && header[i] === '"') {
          i++;
          while (i < n && header[i] !== '"') {
            if (header[i] === '\\' && i + 1 < n) {
              i++;
            }
            value += header[i];
            i++;
          }
          i++;
        } else {
          while (i < n && !';, \t'.includes(header[i] as string)) {
            value += header[i];
            i++;
          }
        }
      }
      if (name === 'rel' && !seenRel) {
        seenRel = true;
        for (const relation of value.trim().split(/\s+/)) {
          if (relation !== '') {
            relations.push(relation.toLowerCase());
          }
        }
      }
    }
    links.push({ target, relations });
  }
  return links;
}

/** Skips to the next comma that is outside brackets and quotes, and returns its index or the end. */
function skipToComma(text: string, from: number): number {
  let quoted = false;
  let bracketed = false;
  for (let i = from; i < text.length; i++) {
    const c = text[i];
    if (quoted) {
      if (c === '\\') {
        i++;
      } else if (c === '"') {
        quoted = false;
      }
    } else if (c === '"') {
      quoted = true;
    } else if (c === '<') {
      bracketed = true;
    } else if (c === '>') {
      bracketed = false;
    } else if (c === ',' && !bracketed) {
      return i;
    }
  }
  return text.length;
}
