import 'reflect-metadata';
import { plainToInstance, type ClassConstructor } from 'class-transformer';
import { Temporal } from 'temporal-polyfill';
import * as models from './models/index{{importFileExtension}}';
import { SerializationError } from './errors/serialization-error{{importFileExtension}}';

/**
 * Number of nanoseconds in one second, as a BigInt, for exact
 * protobuf-JSON duration arithmetic without floating-point loss.
 */
const NANOS_PER_SECOND = 1_000_000_000n;

/**
 * Validates a protobuf-JSON duration string: an optional sign, one or
 * more integer-second digits, and an optional fractional part of 1-9
 * digits, terminated by a literal `s` (e.g. `"3600s"`, `"3600.000000001s"`,
 * `"-1.5s"`).
 */
const PROTO_DURATION_PATTERN = /^-?\d+(\.\d{1,9})?s$/;
/** google.protobuf.Duration bound, in whole seconds (the magnitude, either sign). */
const PROTO_DURATION_MAX_SECONDS = 315576000000;

/**
 * Whether a value is a Temporal object of the given kind (or of any kind when
 * none is named), judged by its `Symbol.toStringTag`, which both the
 * polyfill and a native `Temporal` set. An `instanceof` test against this
 * module's own polyfill copy would be false for a native object, or for one
 * from a second copy of the polyfill.
 *
 * @param value the value to test
 * @param kind a Temporal class name such as `PlainTime` or `Duration`
 * @returns true when the value is such a Temporal object
 */
export function isTemporalValue(value: unknown, kind?: string): boolean {
  if (value === null || typeof value !== 'object') {
    return false;
  }
  const tag = Object.prototype.toString.call(value);
  return kind === undefined ? tag.startsWith('[object Temporal.') : tag === `[object Temporal.${kind}]`;
}

/**
 * Total nanoseconds in a `Temporal.Duration` as an exact BigInt.
 *
 * Avoids `Duration.prototype.total()` (which returns a `number` and loses
 * integer precision past 2^53 ns, i.e. ~104 days) by summing the duration's
 * own integer fields with BigInt arithmetic. A protobuf Duration carries
 * only seconds + nanos, so days/weeks are folded in at fixed lengths
 * (1 day = 86400 s, 1 week = 604800 s — the ISO-calendar, DST-free
 * convention protobuf uses). Years/months cannot appear on a
 * google.protobuf.Duration; if present they are ignored here.
 */
function durationTotalNanos(d: Temporal.Duration): bigint {
  const SEC = NANOS_PER_SECOND;
  return (
    BigInt(d.weeks) * 604800n * SEC +
    BigInt(d.days) * 86400n * SEC +
    BigInt(d.hours) * 3600n * SEC +
    BigInt(d.minutes) * 60n * SEC +
    BigInt(d.seconds) * SEC +
    BigInt(d.milliseconds) * 1_000_000n +
    BigInt(d.microseconds) * 1_000n +
    BigInt(d.nanoseconds)
  );
}

/**
 * Serialize a `Temporal.Duration` to the protobuf-JSON wire format
 * (https://protobuf.dev/programming-guides/json/): a decimal number of
 * seconds suffixed with `s`, e.g. `"3600s"` or `"3600.000000001s"`.
 *
 * A protobuf-JSON API (any google.protobuf.Duration field) rejects ISO-8601
 * durations like `"PT1H"`; this is the only accepted shape. Computed via
 * BigInt nanosecond arithmetic so large durations do not lose precision,
 * with the fractional part trimmed to 3, 6, or 9 digits (the smallest
 * width that preserves all non-zero nanos).
 */
export function durationToProtoJson(d: Temporal.Duration): string {
  const totalNs = durationTotalNanos(d);
  const sign = totalNs < 0n ? '-' : '';
  const abs = totalNs < 0n ? -totalNs : totalNs;
  const secs = abs / NANOS_PER_SECOND;
  const nanos = abs % NANOS_PER_SECOND;
  if (nanos === 0n) {
    return `${sign}${secs}s`;
  }
  let frac = nanos.toString().padStart(9, '0');
  /* Trim trailing zeros down to the smallest 3/6/9-digit width that still
   * preserves every non-zero nanosecond, matching the protobuf encoder. */
  if (frac.endsWith('000000')) {
    frac = frac.slice(0, 3);
  } else if (frac.endsWith('000')) {
    frac = frac.slice(0, 6);
  }
  return `${sign}${secs}.${frac}s`;
}

/**
 * Parse a protobuf-JSON duration string (see {@link durationToProtoJson})
 * back into a `Temporal.Duration`.
 *
 * @throws SerializationError if the input is not a valid protobuf-JSON
 *   duration (e.g. an ISO-8601 `"PT1H"`, a bare number, or a trailing
 *   fractional `s` with more than 9 digits).
 */
export function durationFromProtoJson(value: string): Temporal.Duration {
  if (!PROTO_DURATION_PATTERN.test(value)) {
    throw new SerializationError(
      `Invalid protobuf-JSON duration ${JSON.stringify(value)}: ` +
        `expected a decimal number of seconds suffixed with "s" (e.g. "3600s").`
    );
  }
  const negative = value.startsWith('-');
  const body = value.slice(0, -1).replace(/^-/, '');
  const [secPart, fracPart = ''] = body.split('.');
  const seconds = Number(secPart);
  const nanoseconds = Number(fracPart.padEnd(9, '0').slice(0, 9));
  /* google.protobuf.Duration is bounded at +-315,576,000,000 seconds: the bound itself is
   * accepted and anything past it (including a fraction beyond the bound) is rejected. */
  if (seconds > PROTO_DURATION_MAX_SECONDS || (seconds === PROTO_DURATION_MAX_SECONDS && nanoseconds > 0)) {
    throw new SerializationError(
      `Invalid protobuf-JSON duration ${JSON.stringify(value)}: value is out of range.`,
    );
  }
  try {
    return Temporal.Duration.from({
      seconds: negative ? -seconds : seconds,
      nanoseconds: negative ? -nanoseconds : nanoseconds,
    });
  } catch (cause) {
    /*
     * Temporal rejects seconds beyond its safe-integer range with a RangeError; the wire
     * contract is a SerializationError for every malformed or overflowing duration.
     */
    throw new SerializationError(
      `Invalid protobuf-JSON duration ${JSON.stringify(value)}: value is out of range.`,
      cause as Error,
    );
  }
}

/** Canonical base64: RFC 4648 standard alphabet with `=` padding, no whitespace. */
const BASE64_PATTERN = /^[A-Za-z0-9+/]*={0,2}$/;

/**
 * Decode a `format: byte` base64 string to a Buffer, REJECTING malformed input.
 *
 * `Buffer.from(s, 'base64')` silently ignores characters outside the base64
 * alphabet (so `"!!!!"` decodes to empty bytes rather than erroring) and
 * accepts whitespace, the URL-safe alphabet and missing padding. The raw
 * string must be RFC 4648 section 4 base64: standard alphabet, a length that
 * is a multiple of 4 with `=` padding, and no whitespace or newline. Anything
 * else is rejected, as the decoders in the other SDKs do.
 */
export function decodeBase64(value: string): Buffer {
  if (value.length % 4 !== 0 || !BASE64_PATTERN.test(value)) {
    throw new SerializationError(`Invalid base64 string: ${JSON.stringify(value)}`);
  }
  return Buffer.from(value, 'base64');
}

/**
 * Matches a canonical JSON number: optional minus, an integer part with no
 * leading zeros (or a bare 0), an optional fractional part, and an optional
 * exponent. Used to gate {@link rawDecimal} so only valid numeric text is
 * emitted unquoted; anything else falls back to a normal quoted string.
 */
const JSON_NUMBER_PATTERN = /^-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?$/;

/**
 * 2.5 — Emit a `type: number` (no-format) Decimal field as an unquoted JSON
 * number while preserving its full textual precision.
 *
 * A Decimal is a branded string at runtime (arbitrary precision the IEEE-754
 * `number` type cannot hold), so letting JSON.stringify quote it would emit
 * a JSON string and a spec-conformant server validating `type: number` would
 * reject it. JSON.rawJSON (TC39 json-parse-with-source, Node >= 21 / V8 12.4)
 * wraps already-valid JSON text so JSON.stringify writes it verbatim — and the
 * spec checks the [[IsRawJSON]] slot AFTER the replacer returns, so returning
 * this from the serialize replacer is honoured.
 *
 * `JSON.rawJSON` is not declared by the ES2024 lib this client targets, so it
 * is reached through a minimal typed view rather than an inline suppression.
 * Returns the raw-JSON token for valid numeric text, or the original string
 * unchanged (to be quoted normally) for anything that is not a JSON number.
 */
function rawDecimal(text: string): unknown {
  if (!JSON_NUMBER_PATTERN.test(text)) {
    return text;
  }
  const rawJson = (JSON as unknown as { rawJSON?: (t: string) => unknown }).rawJSON;
  return typeof rawJson === 'function' ? rawJson(text) : text;
}

/**
 * 2.5 (plain-object request bodies) — global registry of every property name
 * that is a `type: number` (no-format) Decimal field, aggregated across all
 * generated models.
 *
 * The per-model `__decimalFields` set on the owning class drives unquoted
 * emission when the value being serialized is a real model INSTANCE (the
 * replacer reads it off `this.constructor`). But request bodies are routinely
 * passed as plain object literals (the body parameter type is `DeepInput<T>`),
 * and a plain object's constructor is `Object`, which carries no
 * `__decimalFields` — so the Decimal field would be quoted as a JSON string,
 * violating the spec's `type: number`. This holder-independent set lets the
 * serializer recognise such fields by name on a plain object too.
 *
 * Built lazily (the models module is fully initialised only after this module
 * loads) by unioning each model class's own `__decimalFields`. Emission still
 * goes through {@link rawDecimal}, which only writes a value unquoted when it
 * is valid JSON numeric text, so a same-named non-numeric string is untouched.
 */
let globalDecimalFields: ReadonlySet<string> | undefined;

function decimalFieldNames(): ReadonlySet<string> {
  if (globalDecimalFields === undefined) {
    const names = new Set<string>();
    for (const exported of Object.values(models as Record<string, unknown>)) {
      const fields = (exported as { __decimalFields?: unknown } | undefined)?.__decimalFields;
      if (fields instanceof Set) {
        for (const name of fields as Set<string>) {
          names.add(name);
        }
      }
    }
    globalDecimalFields = names;
  }
  return globalDecimalFields;
}

/**
 * Property names of every `format: uuid` field across the generated models,
 * for plain-object request bodies (see {@link decimalFieldNames}). On such a
 * body a value is lowercased only when it already has the UUID shape, so a
 * same-named free-form string elsewhere is never rewritten.
 */
let globalUuidFields: ReadonlySet<string> | undefined;

function uuidFieldNames(): ReadonlySet<string> {
  if (globalUuidFields === undefined) {
    const names = new Set<string>();
    for (const exported of Object.values(models as Record<string, unknown>)) {
      const fields = (exported as { __uuidFields?: unknown } | undefined)?.__uuidFields;
      if (fields instanceof Set) {
        for (const name of fields as Set<string>) {
          names.add(name);
        }
      }
    }
    globalUuidFields = names;
  }
  return globalUuidFields;
}

const UUID_SHAPE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/**
 * Code-point order for strings. UTF-8 byte order equals Unicode code point
 * order, which the default UTF-16 comparison breaks for astral characters.
 */
function compareCodePoints(a: string, b: string): number {
  return Buffer.compare(Buffer.from(a, 'utf8'), Buffer.from(b, 'utf8'));
}

/**
 * The wire order of a `uniqueItems` array. Scalar members (strings, enum
 * values, numbers, booleans) are written in ascending natural order so the
 * bytes do not depend on insertion order; any other members keep the Set's
 * own (unspecified) order.
 */
function setElements(value: Set<unknown>): unknown[] {
  const elements = [...value];
  if (elements.every((e) => typeof e === 'string')) {
    return (elements as string[]).sort(compareCodePoints);
  }
  if (elements.every((e) => typeof e === 'number')) {
    return (elements as number[]).sort((a, b) => a - b);
  }
  if (elements.every((e) => typeof e === 'boolean')) {
    return (elements as boolean[]).sort((a, b) => Number(a) - Number(b));
  }
  return elements;
}

/**
 * The `format: time` wire form: `HH:mm:ss`, plus `.SSS` only when the
 * millisecond part is non-zero (sub-millisecond digits are truncated).
 */
function formatPlainTime(time: Temporal.PlainTime): string {
  return time.toString({
    fractionalSecondDigits: time.millisecond === 0 ? 0 : 3,
    roundingMode: 'trunc',
  });
}

/**
 * Decode-time validation. A generated model's constructor validates nothing
 * (F316), so a model can be built by hand from any value; the checks run only
 * when a payload is decoded, through the model's `__validate` method.
 * `validateDecoded` runs it on a model built from the wire and returns the
 * model; a value without the method (a oneOf/anyOf wrapper, a plain object) is
 * returned untouched.
 */
function validateDecoded<T>(model: T): T {
  const validate = (model as { __validate?: unknown } | null)?.__validate;
  if (typeof validate === 'function') {
    (validate as () => void).call(model);
  }
  return model;
}

/**
 * Nested-model validation. class-transformer builds every nested `@Type`
 * model with a no-argument `new X()` and then assigns the fields, so no
 * validation has run on a nested model. Only the root model is validated by
 * `ObjectSerializer.deserialize`, so a nested model with a missing
 * required field or a wrong-typed field would otherwise decode silently.
 *
 * {@link revalidateNestedFields} walks a freshly built model graph (model
 * fields, arrays, Sets and plain maps) and rebuilds each nested generated
 * model through its own constructor with the populated instance as `data`,
 * then validates it like the root and stores the coerced result back.
 * oneOf/anyOf wrappers are left alone: they are resolved by their own
 * variant routing.
 */
let modelClassRegistry: ReadonlySet<unknown> | undefined;

function isNestedModelClass(ctor: unknown): ctor is new (data: unknown) => object {
  if (typeof ctor !== 'function') {
    return false;
  }
  if (modelClassRegistry === undefined) {
    const classes = new Set<unknown>();
    for (const exported of Object.values(models as Record<string, unknown>)) {
      if (typeof exported === 'function') {
        classes.add(exported);
      }
    }
    modelClassRegistry = classes;
  }
  if (!modelClassRegistry.has(ctor)) {
    return false;
  }
  const marker = ctor as unknown as Record<string, unknown>;
  return marker['ONE_OF_SCHEMAS'] === undefined && marker['ANY_OF_SCHEMAS'] === undefined;
}

function revalidateNestedValue(value: unknown): unknown {
  if (Array.isArray(value)) {
    return Object.freeze(value.map((element) => revalidateNestedValue(element)));
  }
  if (value instanceof Set) {
    return new Set([...value].map((element) => revalidateNestedValue(element)));
  }
  if (value === null || typeof value !== 'object') {
    return value;
  }
  const ctor = (value as { constructor?: unknown }).constructor;
  if (isNestedModelClass(ctor)) {
    const rebuilt = validateDecoded(new ctor(value));
    revalidateNestedFields(rebuilt as Record<string, unknown>);
    return rebuilt;
  }
  if (ctor === Object) {
    return Object.freeze(
      Object.fromEntries(Object.entries(value as Record<string, unknown>).map(([k, v]) => [k, revalidateNestedValue(v)])),
    );
  }
  return value;
}

/**
 * Copies the free-form wire keys of `raw` onto `value` when `value` is a
 * generated model that declares `additionalProperties` (its class carries
 * `__additionalPropertiesDeclaredKeys`). plainToInstance with
 * excludeExtraneousValues keeps only keys with an Expose decorator, so without this the extras
 * of the root model, of a nested model field and of every array element would
 * be lost. An array is matched element by element; any other value, or a model
 * without the marker, is returned untouched.
 *
 * @param value the model instance (or array of them) built from `raw`
 * @param raw the wire JSON the value was built from
 * @returns `value`, with the undeclared keys of `raw` attached
 */
export function reattachAdditionalProperties(value: unknown, raw: unknown): unknown {
  if (Array.isArray(value)) {
    if (Array.isArray(raw)) {
      value.forEach((element, i) => reattachAdditionalProperties(element, raw[i]));
    }
    return value;
  }
  if (value === null || typeof value !== 'object' || raw === null || typeof raw !== 'object' || Array.isArray(raw)) {
    return value;
  }
  const declaredKeys = (value.constructor as { __additionalPropertiesDeclaredKeys?: ReadonlySet<string> } | undefined)
    ?.__additionalPropertiesDeclaredKeys;
  if (declaredKeys) {
    /* A typed additionalProperties decodes every undeclared key like an element of a
     * map of the value type; a model without one keeps the values as they arrived. */
    const decode = (
      value.constructor as {
        __decodeAdditionalProperties?: (extras: Record<string, unknown>) => Record<string, unknown>;
      }
    ).__decodeAdditionalProperties;
    let typed: Record<string, unknown> | undefined;
    if (decode) {
      const undeclared: Record<string, unknown> = {};
      for (const [key, extra] of Object.entries(raw as Record<string, unknown>)) {
        if (key !== 'additionalProperties' && !declaredKeys.has(key)) {
          Object.defineProperty(undeclared, key, {
            value: extra,
            enumerable: true,
            writable: true,
            configurable: true,
          });
        }
      }
      typed = decode(undeclared);
    }
    for (const [key, extra] of Object.entries(raw as Record<string, unknown>)) {
      if (key === 'additionalProperties') {
        (value.constructor as { __holdAdditionalPropertiesKey?: (instance: object, held: unknown) => void })
          .__holdAdditionalPropertiesKey?.(value, typed ? decode?.({ additionalProperties: extra }).additionalProperties : extra);
      } else if (!declaredKeys.has(key)) {
        Object.defineProperty(value, key, {
          value: typed ? typed[key] : extra,
          enumerable: true,
          writable: true,
          configurable: true,
        });
      }
    }
  }
  return value;
}

/**
 * A model holds a wire key named `additionalProperties` privately, because the
 * accessor of that name owns the property. Return a copy that carries it as an
 * own property so JSON.stringify emits it under its wire name; any other value
 * is returned untouched.
 */
function withAdditionalPropertiesKey(value: object): object {
  const ctor = value.constructor as
    | { __additionalPropertiesKeyOf?: (instance: object) => { value: unknown } | undefined }
    | undefined;
  const held = ctor?.__additionalPropertiesKeyOf?.(value);
  if (!held) {
    return value;
  }
  const copy = Object.create(Object.getPrototypeOf(value) as object) as object;
  Object.defineProperties(copy, Object.getOwnPropertyDescriptors(value));
  Object.defineProperty(copy, 'additionalProperties', {
    value: held.value,
    enumerable: true,
    writable: true,
    configurable: true,
  });
  return copy;
}

/**
 * Re-keys a model instance under the wire names of its renamed properties, when
 * the model declares any in its static `__wireNames`. The copy keeps the model
 * prototype so the registry lookups on its constructor still work.
 */
function withWireNames(value: object): object {
  const names = (value.constructor as { __wireNames?: Readonly<Record<string, string>> } | undefined)?.__wireNames;
  if (!names) {
    return value;
  }
  const copy = Object.create(Object.getPrototypeOf(value) as object) as object;
  for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(value))) {
    Object.defineProperty(copy, Object.prototype.hasOwnProperty.call(names, key) ? names[key] : key, descriptor);
  }
  return copy;
}

/**
 * The property name behind a wire key of a holder re-keyed by
 * {@link withWireNames}; the key itself when it was not renamed.
 */
function propertyNameOf(holder: unknown, wireKey: string): string {
  const names = (holder as { constructor?: { __wireNames?: Readonly<Record<string, string>> } } | null)?.constructor
    ?.__wireNames;
  if (!names) {
    return wireKey;
  }
  return Object.keys(names).find((property) => names[property] === wireKey) ?? wireKey;
}

function revalidateNestedFields(holder: Record<string, unknown>): void {
  for (const key of Object.keys(holder)) {
    holder[key] = revalidateNestedValue(holder[key]);
  }
}

/**
 * Maximum allowed JSON nesting depth. Node's JSON.parse has no built-in
 * cap and recurses through V8's call stack, so a malicious 100k-deep
 * `{"a":{"a":...}}` payload would stack-overflow / DoS. All twelve SDKs
 * use the same cap.
 */
const MAX_JSON_DEPTH = 1000;

/**
 * Returns the maximum nesting depth of `{`/`[` containers in the given
 * JSON text, ignoring characters inside string literals. Cheap pre-flight
 * scan used to refuse a deeply-nested payload before invoking JSON.parse.
 */
function jsonMaxDepth(s: string): number {
  let depth = 0;
  let max = 0;
  let inString = false;
  let escaped = false;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    if (inString) {
      if (escaped) {
        escaped = false;
      } else if (c === 0x5C /* \ */) {
        escaped = true;
      } else if (c === 0x22 /* " */) {
        inString = false;
      }
      continue;
    }
    if (c === 0x22) {
      inString = true;
    } else if (c === 0x7B /* { */ || c === 0x5B /* [ */) {
      depth++;
      if (depth > max) {
        max = depth;
      }
    } else if (c === 0x7D /* } */ || c === 0x5D /* ] */) {
      if (depth > 0) {
        depth--;
      }
    }
  }
  return max;
}

/**
 * Source text of the JSON numbers whose canonical double text differs from what
 * the document wrote (`12.345678901234567890123`, `1.50`, `1e2`). Recorded by
 * the JSON.parse reviver on the object (or array) that holds the number, under
 * this non-enumerable symbol, so a `type: number` Decimal field can decode
 * losslessly instead of through a rounded double.
 */
const NUMBER_SOURCE_TEXT: unique symbol = Symbol('numberSourceText');

/**
 * JSON.parse reviver that keeps the source text of every number that a double
 * cannot hold exactly. Needs the JSON.parse source-text access of Node 21 or
 * newer; without it nothing is recorded and a number decodes from its double.
 */
function recordNumberSource(this: unknown, key: string, value: unknown, context?: { source?: string }): unknown {
  if (
    typeof value === 'number' &&
    context?.source !== undefined &&
    context.source !== String(value) &&
    this !== null &&
    typeof this === 'object'
  ) {
    const holder = this as { [NUMBER_SOURCE_TEXT]?: Map<string, string> };
    let texts = holder[NUMBER_SOURCE_TEXT];
    if (texts === undefined) {
      texts = new Map<string, string>();
      Object.defineProperty(holder, NUMBER_SOURCE_TEXT, { value: texts, enumerable: false });
    }
    texts.set(key, context.source);
  }
  return value;
}

/**
 * Decode a bare `type: number` field of a wire object into its Decimal text.
 * A JSON number keeps its exact source text (no float coercion); a quoted
 * string, an array, an object or a boolean is rejected. Used by the model
 * `@Transform` of such a field.
 *
 * @param obj the wire object that holds the field
 * @param wireName the field's wire name
 * @returns the number's text, or the value itself when it is null or absent
 * @throws SerializationError when the value is not a JSON number
 */
export function decodePlainNumber(obj: unknown, wireName: string): unknown {
  if (obj === null || typeof obj !== 'object') {
    return undefined;
  }
  const raw = (obj as Record<string, unknown>)[wireName];
  if (raw === null || raw === undefined) {
    return raw;
  }
  if (typeof raw === 'number') {
    return (obj as { [NUMBER_SOURCE_TEXT]?: Map<string, string> })[NUMBER_SOURCE_TEXT]?.get(wireName) ?? String(raw);
  }
  throw new SerializationError(
    `Expected a JSON number for '${wireName}' but received ${typeof raw === 'string' ? 'a quoted string' : typeof raw}`
  );
}

/**
 * Read a `type: string` decimal field from the wire object. The value must be a JSON
 * string, which is kept as it is; a bare JSON number is not a string and is refused.
 *
 * @param obj the wire object that holds the field
 * @param wireName the field's wire name
 * @returns the string, or the value itself when it is null or absent
 * @throws SerializationError when the value is not a JSON string
 */
export function decodeStringDecimal(obj: unknown, wireName: string): unknown {
  if (obj === null || typeof obj !== 'object') {
    return undefined;
  }
  const raw = (obj as Record<string, unknown>)[wireName];
  if (raw === null || raw === undefined || typeof raw === 'string') {
    return raw;
  }
  throw new SerializationError(
    `Expected a JSON string for '${wireName}' but received ${typeof raw === 'number' ? 'a bare number' : typeof raw}`
  );
}

/**
 * Whether a string is a plain `format: date` value: `YYYY-MM-DD` naming a
 * real calendar day.
 *
 * @param value the text to check
 * @returns true when it is a date and nothing else (no time, no offset)
 */
export function isPlainDate(value: string): boolean {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
  if (match === null) {
    return false;
  }
  const year = Number(match[1]);
  const month = Number(match[2]);
  const day = Number(match[3]);
  const probe = new Date(0);
  probe.setUTCFullYear(year, month - 1, day);
  return probe.getUTCFullYear() === year && probe.getUTCMonth() === month - 1 && probe.getUTCDate() === day;
}

/**
 * Check a `format: date` value and return it as `YYYY-MM-DD`. A string is
 * validated and returned unchanged; a `Date` is read as its UTC date.
 *
 * @param value the string or Date
 * @param name what the value is, for the error message
 * @returns the date as `YYYY-MM-DD`
 * @throws TypeError when it is not a real calendar date
 */
export function plainDate(value: unknown, name = 'date'): string {
  if (typeof value === 'string' && isPlainDate(value)) {
    return value;
  }
  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    const day = `${String(value.getUTCFullYear()).padStart(4, '0')}-${String(value.getUTCMonth() + 1).padStart(2, '0')}-${String(value.getUTCDate()).padStart(2, '0')}`;
    if (isPlainDate(day)) {
      return day;
    }
  }
  throw new TypeError(`${name} must be a YYYY-MM-DD date, got ${typeof value === 'string' ? JSON.stringify(value) : String(value)}`);
}

/**
 * Handles JSON serialization and deserialization for API requests and responses.
 *
 * All serde operations in the generated client route through this class.
 * The parameter encoding methods provide consistent value conversion for
 * URL path, query string, header, and form parameters.
 */
export class ObjectSerializer {
  /**
   * Parse a JSON text into a plain JS value, refusing payloads that exceed
   * the `MAX_JSON_DEPTH` nesting cap (DoS guard for malicious
   * deeply-nested payloads — F5 follow-up, parity with Go/Java/Python).
   *
   * A leading UTF-8 BOM (U+FEFF) is stripped before parsing: RFC 8259
   * section 8.1 forbids it, but Windows-generated payloads often carry one
   * and JSON.parse rejects it.
   *
   * @param text the raw JSON text
   * @returns the parsed value
   * @throws SerializationError if the depth limit is exceeded or parsing fails
   */
  static parseJson(text: string): unknown {
    const json = text.charCodeAt(0) === 0xFEFF ? text.slice(1) : text;
    const depth = jsonMaxDepth(json);
    if (depth > MAX_JSON_DEPTH) {
      throw new SerializationError(
        `JSON nesting depth ${depth} exceeds limit ${MAX_JSON_DEPTH}`
      );
    }
    try {
      return JSON.parse(json, recordNumberSource);
    } catch (e) {
      throw new SerializationError(
        `Failed to deserialize JSON: ${e instanceof Error ? e.message : String(e)}`,
        e instanceof Error ? e : undefined
      );
    }
  }

  /**
   * Refuse a oneOf wrapper whose held value is none of its declared variants,
   * so a foreign value is never serialized silently.
   *
   * @param wrapper the oneOf wrapper instance
   * @throws SerializationError if the held value matches no variant
   */
  private static assertOneOfVariant(wrapper: object): void {
    const union = wrapper.constructor as { name: string; ONE_OF_SCHEMAS?: string[] };
    const names = union.ONE_OF_SCHEMAS ?? [];
    const isVariant = names.some((name) => {
      const probe = (wrapper as Record<string, unknown>)[`is${name}`];
      return typeof probe === 'function' && (probe as () => unknown).call(wrapper) === true;
    });
    if (!isVariant) {
      throw new SerializationError(`value is not a variant of ${union.name}`);
    }
  }

  /**
   * Serialize an object to a JSON string.
   *
   * @param obj the object to serialize
   * @returns JSON string representation, or "null" if object is null/undefined
   * @throws SerializationError if serialization fails
   */
  static serialize(obj: unknown): string {
    if (obj === null || obj === undefined) {
      return 'null';
    }
    /**
     * Unwrap a `oneOf` wrapper to its single inner instance. An `anyOf`
     * composite is left intact: it carries the `__isAnyOfComposite` marker and
     * its own `toJSON`, which merges every retained variant so the emitted
     * JSON is the union of all matched variants' fields (lossless round-trip).
     * Unwrapping it would collapse the union back to one variant.
     */
    if (
      typeof obj === 'object' &&
      'actualInstance' in (obj as Record<string, unknown>) &&
      !('__isAnyOfComposite' in (obj as Record<string, unknown>))
    ) {
      ObjectSerializer.assertOneOfVariant(obj as object);
      obj = (obj as Record<string, unknown>).actualInstance;
    }
    /**
     * Objects that sit beneath a generated model instance. A plain object
     * there is model DATA (a free-form map, additionalProperties, an
     * `object` field), not a request-body literal shaped like a model, so the
     * name-based Decimal fallback below must not reinterpret its strings.
     */
    const underModel = new WeakSet<object>();
    try {
      return JSON.stringify(obj, function (_key, value) {
        if (value !== null && typeof value === 'object' && !Array.isArray(value)) {
          value = withAdditionalPropertiesKey(value as object);
          value = withWireNames(value as object);
        }
        if (value !== null && typeof value === 'object') {
          const holder = this as unknown as object;
          const holderCtor = (holder as { constructor?: { __decimalFields?: unknown } }).constructor;
          if (underModel.has(holder) || holderCtor?.__decimalFields instanceof Set) {
            underModel.add(value as object);
          }
        }
        if (value instanceof Set) {
          const elements = setElements(value);
          if (underModel.has(value)) underModel.add(elements);
          return elements;
        }
        /**
         * Reject a non-finite number (NaN, ±Infinity) on encode. RFC 8259 §6
         * has no such token, so JSON.stringify would silently emit `null` in
         * its place — corrupting the wire value. Fail loudly instead, matching
         * the other SDKs (python allow_nan=False, go, rust, …).
         */
        if (typeof value === 'number' && !Number.isFinite(value)) {
          throw new SerializationError(
            `Non-finite number ${String(value)} is not permitted by RFC 8259 ` +
              `(JSON has no NaN or Infinity).`
          );
        }
        if (this[_key] instanceof Date) return ObjectSerializer.formatDateTimeOffset(this[_key]);
        /**
         * 2.1 — `format: byte` is base64 on the wire. The model holds a
         * Buffer; encode it here so callers never see the encoding step.
         * Check the raw `this[_key]` (not the replacer's `value`) because
         * Buffer is an object and JSON.stringify will have already invoked
         * its toJSON which yields `{ type: 'Buffer', data: [...] }`.
         */
        if (Buffer.isBuffer(this[_key])) return (this[_key] as Buffer).toString('base64');
        /**
         * 4.8 — `format: time` maps to Temporal.PlainTime and serialises to
         * its canonical ISO 8601 string. `format: duration` maps to
         * Temporal.Duration but must serialise to the protobuf-JSON wire
         * shape (`"3600s"`, not ISO-8601 `"PT1H"`) — every
         * google.protobuf.Duration field rejects the ISO form. Without these
         * branches JSON.stringify would emit the polyfill's internal object.
         */
        if (isTemporalValue(this[_key], 'PlainTime')) return formatPlainTime(this[_key] as Temporal.PlainTime);
        if (isTemporalValue(this[_key], 'Duration')) return durationToProtoJson(this[_key] as Temporal.Duration);
        /**
         * 2.5 — `type: number` (no format) Decimal field. The model holds it
         * as a precision-preserving string; emit it unquoted as a JSON number
         * (via JSON.rawJSON) so a spec-conformant server sees a number, not a
         * quoted string. The owning model registers its no-format numeric
         * fields by property name in a static `__decimalFields` set; consult
         * the holder's constructor for it first.
         *
         * A request body is often a plain object literal (the body parameter
         * type is `DeepInput<T>`), whose constructor is `Object` and carries no
         * `__decimalFields` — so fall back to the holder-independent global
         * registry ({@link decimalFieldNames}) keyed by property name. Either
         * way only a string value whose field is registered is considered, and
         * {@link rawDecimal} emits it unquoted only when it is valid JSON
         * numeric text, so genuine string fields are untouched. The fallback
         * applies only to plain objects that are not nested inside a model
         * instance, so a free-form value never changes JSON type.
         */
        const propKey = propertyNameOf(this, _key);
        if (typeof value === 'string') {
          const ctor = (this as { constructor?: unknown }).constructor as
            | { __decimalFields?: ReadonlySet<string> }
            | undefined;
          const ownDecimals = ctor && ctor.__decimalFields instanceof Set ? ctor.__decimalFields : undefined;
          const plainFallback = !underModel.has(this as unknown as object) && decimalFieldNames().has(propKey);
          if (ownDecimals ? ownDecimals.has(propKey) : plainFallback) {
            return rawDecimal(value);
          }
          const uuidCtor = ctor as { __uuidFields?: ReadonlySet<string> } | undefined;
          const ownUuids = uuidCtor && uuidCtor.__uuidFields instanceof Set ? uuidCtor.__uuidFields : undefined;
          if (ownUuids ? ownUuids.has(propKey) : !underModel.has(this as unknown as object) && uuidFieldNames().has(propKey)) {
            if (UUID_SHAPE.test(value)) {
              return value.toLowerCase();
            }
            if (ownUuids) {
              throw new SerializationError(`${_key} is not a canonical UUID: ${JSON.stringify(value)}`);
            }
          }
        }
        if (value === null && _key !== '') {
          /* A required and nullable field keeps its key: it is written as
           * null, never dropped. */
          const nullableCtor = (this as { constructor?: unknown }).constructor as
            | { __requiredNullableFields?: ReadonlySet<string> }
            | undefined;
          if (nullableCtor?.__requiredNullableFields instanceof Set && nullableCtor.__requiredNullableFields.has(propKey)) {
            return null;
          }
          return undefined;
        }
        return value;
      });
    } catch (e) {
      throw new SerializationError(
        `Failed to serialize object to JSON: ${e instanceof Error ? e.message : String(e)}`,
        e instanceof Error ? e : undefined
      );
    }
  }

  /**
   * Deserialize a plain JS object to an instance of the specified class.
   *
   * @param json the parsed JSON value
   * @param cls the class constructor to instantiate
   * @returns the deserialized object
   */
  static deserialize<T>(json: unknown, cls: ClassConstructor<T>): T | null {
    if (json === null || json === undefined) {
      return null;
    }
    try {
      const clsRecord = cls as unknown as Record<string, unknown>;
      const anyOfSchemas = clsRecord['ANY_OF_SCHEMAS'] as string[] | undefined;
      const oneOfSchemas = clsRecord['ONE_OF_SCHEMAS'] as string[] | undefined;
      const discProp = clsRecord['DISCRIMINATOR_PROPERTY'] as string | undefined;
      const discMapping = clsRecord['DISCRIMINATOR_MAPPING'] as Record<string, string> | undefined;
      const schemas = anyOfSchemas ?? oneOfSchemas;

      /**
       * A class-based base type (allOf plus a discriminator) owns the mapping
       * itself: decode into the subtype the discriminator names. The check is
       * on an own property because a subtype inherits the static members of
       * its base, and a subtype decodes as itself.
       */
      if (
        !schemas &&
        discProp &&
        discMapping &&
        Object.prototype.hasOwnProperty.call(cls, 'DISCRIMINATOR_PROPERTY') &&
        typeof json === 'object' &&
        !Array.isArray(json)
      ) {
        const record = json as Record<string, unknown>;
        if (!(discProp in record)) {
          throw new SerializationError(
            `Missing discriminator property '${discProp}' in payload.`
          );
        }
        const discValue = record[discProp] as string;
        const targetName = Object.prototype.hasOwnProperty.call(discMapping, discValue)
          ? discMapping[discValue]
          : undefined;
        const targetCls = targetName
          ? ((models as Record<string, unknown>)[targetName] as ClassConstructor<T> | undefined)
          : undefined;
        if (!targetCls) {
          throw new SerializationError(
            `Discriminator value '${discValue}' on '${discProp}' is not listed in ` +
              `the schema mapping (allowed: ${Object.keys(discMapping).join(', ') || '<empty>'}).`
          );
        }
        return ObjectSerializer.deserialize(json, targetCls);
      }

      if (schemas && json && typeof json === 'object') {
        if (discProp && discMapping && discProp in (json as Record<string, unknown>)) {
          const discValue = (json as Record<string, unknown>)[discProp] as string;
          const targetName = discMapping[discValue];
          if (targetName) {
            const targetCls = (models as Record<string, unknown>)[targetName] as ClassConstructor<unknown> | undefined;
            if (targetCls) {
              const instance = plainToInstance(targetCls, json, { excludeExtraneousValues: true });
              /**
               * plainToInstance bypasses the variant's constructor, and the
               * constructor validates nothing, so its required-field and
               * primitive-type checks never ran. Build the selected variant
               * and validate it (as the non-discriminated path below does)
               * before wrapping it.
               */
              const variant = validateDecoded(
                new (targetCls as unknown as new (i: unknown) => Record<string, unknown>)(instance)
              );
              revalidateNestedFields(variant);
              return new (cls as unknown as new (i: unknown) => T)(variant);
            }
            /**
             * 4.7 — The mapping names a class that doesn't exist in the
             * models index. Previously we returned null and silently fell
             * through; that hides spec/codegen drift. Surface it so callers
             * see a real error instead of an inexplicable null.
             */
            throw new SerializationError(
              `Discriminator '${discProp}=${discValue}' maps to '${targetName}', ` +
                `which is not a generated model.`
            );
          }
          /**
           * 4.7 — Discriminator value present but not listed in the
           * `oneOf`/`anyOf` mapping. The previous fallthrough returned the
           * base envelope unpopulated, which looked like a successful
           * parse of an empty object. Throw so callers know the payload
           * doesn't match any declared variant.
           */
          throw new SerializationError(
            `Discriminator value '${discValue}' on '${discProp}' is not listed in ` +
              `the schema mapping (allowed: ${Object.keys(discMapping).join(', ') || '<empty>'}).`
          );
        } else if (discProp && discMapping) {
          /**
           * Discriminated union, but the payload omits the discriminator
           * property entirely. The other 11 SDKs raise a deserialize error
           * here; Node previously fell through to structural variant-matching
           * and could silently mis-route to the wrong variant. Throw to match.
           */
          throw new SerializationError(
            `Missing discriminator property '${discProp}' in payload.`
          );
        }
        /**
         * anyOf vs oneOf retention. A `oneOf` is mutually exclusive, so the
         * first matching variant wins and resolution stops. A non-discriminated
         * `anyOf` may be co-satisfied by several variants at once ("a
         * medication, a surgery, OR BOTH"); returning on the first match would
         * silently drop the other variants' fields and lose them on re-encode.
         * For `anyOf` we therefore collect EVERY variant that validates and
         * hand them all to the composite wrapper, which retains them and emits
         * their union on serialize (lossless round-trip).
         */
        const isAnyOf = anyOfSchemas !== undefined;
        const matched: unknown[] = [];
        for (const schemaName of schemas) {
          const schemaCls = (models as Record<string, unknown>)[schemaName] as ClassConstructor<unknown> | undefined;
          if (schemaCls) {
            try {
              const instance = plainToInstance(schemaCls, json, { excludeExtraneousValues: true });
              const hasValues = Object.values(instance as Record<string, unknown>).some(v => v !== undefined);
              if (hasValues) {
                /**
                 * Gap S (union): class-transformer's plainToInstance bypasses
                 * the variant model's constructor, so a candidate with a
                 * type-wrong field (e.g. a string on a numeric field) would be
                 * silently retained. Validate the candidate through the
                 * variant model's own decode check so its primitive-type
                 * assertions fire; if they throw, this variant doesn't match
                 * and we fall through to the next candidate (and ultimately
                 * the no-match throw below) — matching the strict
                 * validate-each-variant canonical used by the other SDKs.
                 */
                validateDecoded(new (schemaCls as unknown as new (i: unknown) => unknown)(instance));
                if (isAnyOf) {
                  matched.push(instance);
                } else {
                  return new (cls as unknown as new (i: unknown) => T)(instance);
                }
              }
            } catch {
              continue;
            }
          }
        }
        /**
         * anyOf: hand the wrapper every variant that validated. The composite
         * retains all of them so co-satisfied fields survive a round-trip. A
         * single-variant payload still works — `matched` holds one element.
         */
        if (isAnyOf && matched.length > 0) {
          return new (cls as unknown as new (i: unknown) => T)(matched);
        }
        /**
         * 4.7 — oneOf/anyOf without a discriminator and no variant matched
         * the payload. Previously we fell through to a generic
         * plainToInstance that stored the raw bag-of-keys, hiding the
         * spec mismatch (type confusion / silent data corruption). Throw
         * so the caller sees the payload matches no declared variant,
         * matching the validate-each-variant-then-throw canonical.
         */
        throw new SerializationError(
          `Value does not match any of the declared schemas ` +
            `(${schemas.join(', ')}).`
        );
      }

      /**
       * Gap L11: a model declaring `unevaluatedProperties:false` (OAS 3.1 /
       * JSON Schema 2020-12) is STRICT — an undeclared wire key is a contract
       * violation that must be REJECTED, not silently dropped. plainToInstance
       * with excludeExtraneousValues discards every key without an Expose decorator, so without
       * this gate the strict contract would be unenforced on the real
       * deserialize path.
       * The static `__strictDeclaredKeys` set (present only on strict models)
       * lists the allowed wire keys; reject any json key not in it before
       * building the instance. Models without the marker are non-strict and
       * accept extras as before.
       */
      const strictKeys = (cls as { __strictDeclaredKeys?: ReadonlySet<string> })
        .__strictDeclaredKeys;
      if (strictKeys && json && typeof json === 'object' && !Array.isArray(json)) {
        for (const key of Object.keys(json as Record<string, unknown>)) {
          if (!strictKeys.has(key)) {
            throw new SerializationError(
              `Unknown property '${key}' on ${cls.name} ` +
                `(unevaluatedProperties:false).`
            );
          }
        }
      }

      const instance = plainToInstance(cls, json, { excludeExtraneousValues: true });
      /**
       * Gap S: validate the plain-instance so the model's primitive-type
       * assertions fire. class-transformer bypasses the constructor and the
       * constructor checks nothing, leaving wire-type bugs ({"id": "42"} on
       * an int field) silent. The model's own decode check enforces them.
       */
      if (instance && typeof instance === 'object' && typeof cls === 'function') {
        const built = validateDecoded(new (cls as unknown as new (i: unknown) => T)(instance));
        revalidateNestedFields(built as Record<string, unknown>);
        /**
         * H11: a model declaring `additionalProperties` carries free-form wire
         * keys on an index signature. plainToInstance(excludeExtraneousValues)
         * drops every key without an Expose decorator — the index signature is
         * not exposed — so those extras would be silently lost on a round-trip.
         * Re-attach any json key NOT in the model's declared-key set so free-form
         * data survives. Models without the marker intentionally discard extras.
         */
        reattachAdditionalProperties(built, json);
        return built;
      }
      return instance;
    } catch (e) {
      if (e instanceof SerializationError) {
        throw e;
      }
      throw new SerializationError(
        `Failed to deserialize JSON: ${e instanceof Error ? e.message : String(e)}`,
        e instanceof Error ? e : undefined
      );
    }
  }

  /**
   * Deserialize an array of objects using the provided class constructor.
   *
   * @param json the parsed JSON array
   * @param cls the class constructor to instantiate for each element
   * @returns array of deserialized objects
   */
  static deserializeArray<T>(
    json: unknown,
    cls: ClassConstructor<T> | ((value: unknown) => T | null),
  ): T[] {
    if (!Array.isArray(json)) {
      throw new SerializationError('Expected array but received: ' + typeof json);
    }
    const deserializeElement = ObjectSerializer.elementDeserializer(cls);
    const mapped = json.map((item: unknown) => deserializeElement(item));
    /**
     * A null element of a model-class element type is rejected: null is not
     * an object, and the element type cannot express nullability, so it is
     * neither kept nor silently dropped (dropping would shift indices). For a
     * primitive/enum element deserializer a `null` is a legitimate wire value
     * (e.g. `items: { nullable: true }`) and is preserved.
     */
    if (ObjectSerializer.isClassConstructor(cls)) {
      mapped.forEach((x, index) => {
        if (x === null || x === undefined) {
          throw new SerializationError(
            `Null element at index ${index} of an array of ${(cls as ClassConstructor<T>).name}`
          );
        }
      });
    }
    return mapped as T[];
  }

  /**
   * Whether a deserializer argument is a model class constructor (as opposed
   * to a bare element-deserializer arrow function). A class constructor has
   * an own `prototype`; an arrow function does not. Used to decide whether a
   * produced `null` is a failed-model-parse sentinel (drop) or a legitimate
   * primitive/enum null wire value (keep).
   */
  private static isClassConstructor<T>(
    cls: ClassConstructor<T> | ((value: unknown) => T | null),
  ): cls is ClassConstructor<T> {
    return typeof cls === 'function' && 'prototype' in cls;
  }

  /**
   * Resolve a deserializer argument that is either a model class constructor
   * or an element-deserializer function, into a uniform per-element function.
   * A bare class constructor is wrapped in {@link deserialize}; an arrow
   * function (which has no own `prototype`, unlike a class) is used directly.
   * This lets nested generic containers — e.g. `Array<Record<string, Foo>>` —
   * compose their per-level deserializers so the innermost models are decoded
   * into typed instances instead of left as raw objects.
   */
  private static elementDeserializer<T>(
    cls: ClassConstructor<T> | ((value: unknown) => T | null),
  ): (value: unknown) => T | null {
    if (!ObjectSerializer.isClassConstructor(cls)) {
      return cls as (value: unknown) => T | null;
    }
    return (value: unknown) => ObjectSerializer.deserialize(value, cls);
  }

  /**
   * 4.6 — Deserialize a map (object) whose values are themselves typed
   * models. Previously a `Record<string, Foo>` return type was forwarded as
   * a raw JSON object, leaving callers with plain dicts where the spec
   * promised `Foo` instances. Walks the entries, runs each value through
   * {@link deserialize}, and rebuilds the record with typed values.
   *
   * @param json the parsed JSON object
   * @param cls the class constructor to instantiate for each value
   * @returns a record of deserialized objects keyed by the original keys
   */
  static deserializeMap<T>(
    json: unknown,
    cls: ClassConstructor<T> | ((value: unknown) => T | null),
  ): Record<string, T> {
    if (json === null || json === undefined) {
      return {};
    }
    if (typeof json !== 'object' || Array.isArray(json)) {
      throw new SerializationError('Expected map/object but received: ' + (Array.isArray(json) ? 'array' : typeof json));
    }
    const deserializeValue = ObjectSerializer.elementDeserializer(cls);
    /**
     * As in deserializeArray: a null value of a model-class value type is
     * rejected. For a primitive/enum value deserializer a null is a
     * legitimate nullable wire value and the key is retained so the map's
     * key set is not silently mutated.
     */
    const rejectNulls = ObjectSerializer.isClassConstructor(cls);
    const out: Record<string, T> = {};
    for (const [k, v] of Object.entries(json as Record<string, unknown>)) {
      const deserialized = deserializeValue(v);
      if (rejectNulls && (deserialized === null || deserialized === undefined)) {
        throw new SerializationError(
          `Null value for key ${JSON.stringify(k)} of a map of ${(cls as ClassConstructor<T>).name}`
        );
      }
      /* defineProperty, never `out[k] =`: a wire key "__proto__" must stay an
       * own entry, not call the prototype setter and re-prototype the map. */
      Object.defineProperty(out, k, {
        value: deserialized as T,
        enumerable: true,
        writable: true,
        configurable: true
      });
    }
    return out;
  }

  /**
   * Validate a wire value against the members of a named enum at the
   * deserialize boundary. An operation whose response schema is the enum
   * itself, or an enum container leaf, arrives as a raw JSON scalar; a
   * plain cast would silently let an unknown value (`"magenta"`) through
   * as a non-enum string. This mirrors the model-field enum check (and Python's
   * `klass(data)` / Java's `@JsonCreator fromValue`), throwing on an
   * unknown value instead of corrupting the typed result.
   *
   * @param value the parsed wire value
   * @param enumObj the runtime enum object whose values are the wire values
   * @returns the value, typed as the enum member
   */
  static deserializeEnum<T>(value: unknown, enumObj: Record<string, unknown>): T {
    /* Enums are const objects, so there is no numeric reverse mapping and
     * Object.values() is exactly the set of wire values. */
    const members = Object.values(enumObj);
    if (!(members as readonly unknown[]).includes(value)) {
      throw new SerializationError(
        `Unknown enum value: ${JSON.stringify(value)}. ` +
          `Expected one of [${members.map((v) => JSON.stringify(v)).join(', ')}].`,
      );
    }
    return value as T;
  }

  /** Decode a `format: byte` string, rejecting malformed base64 with a SerializationError. */
  static decodeBase64(value: string): Buffer {
    return decodeBase64(value);
  }

  /**
   * The bytes of a binary response that came back as JSON, which happens when an
   * operation declares both a binary and an application/json response and the
   * server picks the JSON one. The caller gets the bytes of that JSON document,
   * never the parsed object cast to a Buffer.
   */
  static toBinary(json: unknown): Buffer {
    if (Buffer.isBuffer(json)) {
      return json;
    }
    return Buffer.from(typeof json === 'string' ? json : JSON.stringify(json), 'utf8');
  }

  /**
   * Validate the type of a primitive or date leaf of a container response
   * (a map or array element). A plain `as number` cast is erased at compile
   * time, so `{"a": "5"}` for a `Record<string, number>` would be returned as
   * the string "5" and `"garbage"` for a date element would become an Invalid
   * Date. The error names the expected and received types only, never the
   * value.
   *
   * `int32` (also used for a format-less integer) must be an integer inside
   * [-2^31, 2^31-1]. `int64` must be an integer; values beyond 2^53 cannot be
   * checked because JSON.parse has already rounded them.
   *
   * A `null` element is rejected for an integer or boolean leaf unless the
   * element schema is nullable (`nullable`).
   *
   * A date leaf must be an RFC 3339 date-time with an explicit offset or a
   * bare `YYYY-MM-DD` date; anything else (no offset, free text) is rejected
   * so it never resolves against the host time zone or the current date. A
   * `plainDate` leaf (`format: date`) must be a real `YYYY-MM-DD` day and is
   * returned as the string it came as.
   *
   * @param value the parsed wire value
   * @param kind the expected leaf type
   * @returns the value, typed as the expected leaf
   */
  static deserializeLeaf<T>(
    value: unknown,
    kind: 'int32' | 'int64' | 'double' | 'boolean' | 'string' | 'byte' | 'date' | 'plainDate',
    nullable = false,
  ): T {
    if (value === null || value === undefined) {
      /* A null element of a container of integers or booleans is a wrong-typed
       * element unless the element schema is nullable. Date leaves keep their
       * null so a nullable timestamp container is not corrupted. */
      if (kind !== 'date' && kind !== 'plainDate' && !nullable) {
        throw new SerializationError(`Expected ${kind} but received: null`);
      }
      return null as T;
    }
    if (kind === 'string') {
      if (typeof value !== 'string') {
        throw new SerializationError(`Expected string but received: ${typeof value}`);
      }
      return value as T;
    }
    if (kind === 'byte') {
      if (typeof value !== 'string') {
        throw new SerializationError(`Expected a base64 string but received: ${typeof value}`);
      }
      return decodeBase64(value) as T;
    }
    if (kind === 'plainDate') {
      if (typeof value !== 'string' || !isPlainDate(value)) {
        throw new SerializationError(`Expected a YYYY-MM-DD date but received: ${typeof value === 'string' ? JSON.stringify(value) : typeof value}`);
      }
      return value as T;
    }
    const valid =
      kind === 'int32'
        ? Number.isInteger(value) && (value as number) >= -2147483648 && (value as number) <= 2147483647
        : kind === 'int64'
          ? Number.isInteger(value)
          : kind === 'double'
            ? typeof value === 'number' && Number.isFinite(value)
            : kind === 'boolean'
            ? typeof value === 'boolean'
            : typeof value === 'string' &&
              (/^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$/.test(value) ||
                /^\d{4}-\d{2}-\d{2}$/.test(value)) &&
              !Number.isNaN(new Date(value).getTime());
    if (!valid) {
      throw new SerializationError(`Expected ${kind} but received: ${typeof value}`);
    }
    return (kind === 'date' ? new Date(value as string) : value) as T;
  }

  /**
   * Convert a single scalar value to its string representation.
   *
   * This is the canonical scalar-to-string conversion used by all parameter
   * encoding methods. Handles null/undefined, booleans, Dates, and falls
   * back to String() for everything else.
   *
   * @param value the value to stringify
   * @returns the string representation
   */
  static stringify(value: unknown): string {
    if (value === null || value === undefined) {
      return '';
    }
    if (typeof value === 'boolean') {
      return value ? 'true' : 'false';
    }
    if (value instanceof Date) {
      return ObjectSerializer.formatDateTimeOffset(value);
    }
    /**
     * `format: byte` parameters are standard-alphabet RFC 4648 base64 with
     * padding, never the raw bytes as text.
     */
    if (value instanceof Uint8Array) {
      return Buffer.from(value.buffer, value.byteOffset, value.byteLength).toString('base64');
    }
    /**
     * 4.8 — Temporal types. PlainTime emits its canonical ISO 8601 form
     * (e.g. "14:30:00"). Duration emits the protobuf-JSON wire shape
     * (e.g. "3600s") rather than ISO-8601 ("PT15M"); google.protobuf.Duration
     * fields accept only the seconds-suffixed form.
     */
    if (isTemporalValue(value, 'PlainTime')) {
      return formatPlainTime(value as Temporal.PlainTime);
    }
    if (isTemporalValue(value, 'Duration')) {
      return durationToProtoJson(value as Temporal.Duration);
    }
    return String(value);
  }

  /**
   * Formats a Date as a deterministic ISO 8601 date-time in UTC, e.g.
   * `2024-01-01T12:30:45+00:00` or `2020-01-02T03:04:05.123+00:00` when the
   * instant carries sub-second precision.
   *
   * A JS Date is an absolute instant with no stored timezone offset, so the
   * previous local-time formatting (getFullYear/getHours/getTimezoneOffset)
   * made the wire bytes depend on the host machine's timezone — the same
   * instant serialized differently on a UTC host vs a CET host. Pinning to
   * UTC via the getUTC* accessors makes the output host-independent and
   * aligns it with the other SDKs that emit a fixed numeric offset (Swift and
   * Go both pin UTC and emit `+00:00`, never `Z`). The explicit `+00:00`
   * suffix (rather than `Z`) keeps the offset-bearing shape the rest of the
   * stack expects while remaining a valid UTC designator.
   *
   * The encoder always emits a fixed three-digit millisecond fraction, so a
   * whole-second instant serialises as `…:45.000+00:00` and an instant like
   * `2020-01-02T03:04:05.123Z` keeps its `.123`. This fixed `.SSS` shape is the
   * canonical form shared by all twelve SDKs; a JS Date holds whole-millisecond
   * precision (`getUTCMilliseconds`), so the fraction round-trips intact.
   */
  private static formatDateTimeOffset(date: Date): string {
    const pad = (n: number, w = 2): string => String(n).padStart(w, '0');
    const y = date.getUTCFullYear();
    const mo = pad(date.getUTCMonth() + 1);
    const d = pad(date.getUTCDate());
    const h = pad(date.getUTCHours());
    const mi = pad(date.getUTCMinutes());
    const s = pad(date.getUTCSeconds());
    const ms = date.getUTCMilliseconds();
    const frac = `.${pad(ms, 3)}`;
    return `${y}-${mo}-${d}T${h}:${mi}:${s}${frac}+00:00`;
  }

  /**
   * Convert a value to a string suitable for use as a URL path parameter.
   *
   * @param value the value to convert (may be null or undefined)
   * @returns string representation, or empty string if null
   */
  static toPathValue(value: unknown): string {
    return ObjectSerializer.stringify(value);
  }

  /**
   * Convert a value to a representation suitable for use as a query parameter.
   * For collections, joins using the specified collection format delimiter.
   *
   * @param value the value to convert (may be null or undefined)
   * @param collectionFormat the format: csv, ssv, tsv, pipes, or multi
   * @returns the query value, or undefined if null
   */
  static toQueryValue(value: unknown, collectionFormat?: string): string | string[] | undefined {
    if (value === null || value === undefined) {
      return undefined;
    }
    if (Array.isArray(value)) {
      const items = value.map((v) => ObjectSerializer.stringify(v));
      if (collectionFormat === 'multi') return items;
      if (collectionFormat === 'ssv') return items.join(' ');
      if (collectionFormat === 'tsv') return items.join('\t');
      if (collectionFormat === 'pipes') return items.join('|');
      return items.join(',');
    }
    return ObjectSerializer.stringify(value);
  }

  /**
   * Convert a value to a string suitable for use as an HTTP header value.
   *
   * @param value the value to convert (may be null or undefined)
   * @returns string representation, or empty string if null
   */
  static toHeaderValue(value: unknown): string {
    if (value === null || value === undefined) {
      return '';
    }
    if (Array.isArray(value)) {
      return value.map((v) => ObjectSerializer.stringify(v)).join(',');
    }
    return ObjectSerializer.stringify(value);
  }

  /**
   * Convert a value to a string suitable for use as an HTTP cookie value.
   * Cookie values follow the same encoding rules as header values.
   *
   * @param value the value to convert (may be null or undefined)
   * @returns string representation, or empty string if null
   */
  static toCookieValue(value: unknown): string {
    return ObjectSerializer.toHeaderValue(value);
  }

  /**
   * Convert a value to a representation suitable for use as a form parameter.
   *
   * @param value the value to convert (may be null or undefined)
   * @returns string representation, or empty string if null
   */
  static toFormValue(value: unknown): string {
    return ObjectSerializer.stringify(value);
  }

  /**
   * Resolve a oneOf schema by trying each candidate deserializer in order.
   *
   * @param json the JSON string to deserialize
   * @param candidates array of deserializer functions that accept a JSON string
   * @returns the first non-null successful result
   * @throws SerializationError if no candidate matches the JSON — a payload
   *   satisfying none of the declared variants is a contract violation and must
   *   fail loudly rather than be silently dropped to null
   */
  static resolveOneOf<T>(json: string, candidates: Array<(json: string) => T | null>): T {
    for (const candidate of candidates) {
      try {
        const result = candidate(json);
        if (result !== null && result !== undefined) {
          return result;
        }
      } catch {
        continue;
      }
    }
    throw new SerializationError('No oneOf/anyOf variant matched the JSON');
  }

  /**
   * Resolve an anyOf schema by trying each candidate deserializer in order.
   * Delegates to resolveOneOf.
   *
   * @param json the JSON string to deserialize
   * @param candidates array of deserializer functions that accept a JSON string
   * @returns the first non-null successful result
   * @throws SerializationError if no candidate matches the JSON
   */
  static resolveAnyOf<T>(json: string, candidates: Array<(json: string) => T | null>): T {
    return ObjectSerializer.resolveOneOf(json, candidates);
  }
}
