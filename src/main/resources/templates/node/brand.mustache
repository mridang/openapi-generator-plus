/**
 * Branded string type for OpenAPI `format: uuid` values.
 *
 * 2.2 — Option A. A nominal alias for `string` so callers cannot accidentally
 * pass a free-form string where a UUID is expected. The brand exists only at
 * the type level; at runtime the value is still a plain string, so there is
 * no boxing cost or interop tax.
 *
 * Construct one via {@link uuid}, which validates the canonical RFC 4122
 * 8-4-4-4-12 hex form. Use {@link isUuid} as a type guard when narrowing.
 */
export type UUID = string & { readonly __brand: 'UUID' };

/**
 * Canonical OpenAPI/RFC 4122 UUID shape. Case-insensitive; matches all
 * versions (1-5). Does not enforce the version/variant nibbles — the spec
 * `format: uuid` is intentionally permissive about which variant is on the
 * wire, so we only insist on the structural shape.
 */
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/**
 * Type guard for {@link UUID}. Use to narrow an arbitrary string before
 * passing it to APIs expecting a UUID-shaped value.
 */
export function isUuid(value: unknown): value is UUID {
  return typeof value === 'string' && UUID_PATTERN.test(value);
}

/**
 * Brand a raw string as a {@link UUID} after validating its shape. Throws
 * if the input is not a canonical 8-4-4-4-12 hex UUID.
 */
export function uuid(value: string): UUID {
  if (!UUID_PATTERN.test(value)) {
    throw new TypeError(`Invalid UUID: ${JSON.stringify(value)}`);
  }
  return value as UUID;
}
