import { BaseAuthenticator } from './base-authenticator{{importFileExtension}}';
import { ApiKeyLocation } from './api-key-location{{importFileExtension}}';
import { resolveCredential } from './credentials{{importFileExtension}}';

/** The environment variable read when no key is passed. */
const API_KEY_VARIABLE = '{{envVarPrefix}}_API_KEY';

/**
 * Authenticator for API key authentication. Supports sending the key
 * as a header, query parameter, or cookie.
 *
 * The key is the explicit argument, or else the environment variable
 * `{{envVarPrefix}}_API_KEY`, read once here (an empty variable counts as unset). A
 * missing key fails here, when the authenticator is built.
 */
export class ApiKeyAuthenticator extends BaseAuthenticator {
  private readonly host: string;
  private readonly keyParamName: string;
  private readonly apiKey: string;
  private readonly location: ApiKeyLocation;

  /**
   * @param host API base URL
   * @param keyParamName the header, query parameter or cookie name
   * @param apiKey the key, or `undefined` to read it from the environment
   * @param location where the key is sent
   * @throws TypeError if no key is supplied or the key is malformed
   */
  constructor(
    host: string,
    keyParamName: string,
    apiKey: string | undefined,
    location: ApiKeyLocation
  ) {
    super();
    const resolvedKey = resolveCredential(apiKey, API_KEY_VARIABLE, `API key for '${keyParamName}'`);
    /* Validation applies to ALL locations: empty/whitespace API keys
     * and CR/LF/NUL are always programmer errors. RFC 7230 §3.2.6
     * printable-ASCII rule still applies to HEADER values. */
    if (/^[ \t\n\v\f\r]*$/.test(resolvedKey)) {
      throw new TypeError(
        `API key value for '${keyParamName}' must not be empty`
      );
    }
    /* RFC 7230 §3.2.4 — CR/LF in header values enables HTTP header
     * splitting; NUL terminates C strings in many downstream HTTP
     * libraries. Reject all three via explicit char-code checks
     * rather than a control-char regex (avoids eslint
     * `no-control-regex` which flags literal \x00 in patterns). */
    for (let i = 0; i < resolvedKey.length; i++) {
      const code = resolvedKey.charCodeAt(i);
      if (code === 0x0d || code === 0x0a || code === 0x00) {
        throw new TypeError(
          `API key value for '${keyParamName}' contains forbidden control characters (CR/LF/NUL)`
        );
      }
    }
    if (location === ApiKeyLocation.HEADER && /[^\t\x20-\x7E]/.test(resolvedKey)) {
      throw new TypeError(
        `API key for header '${keyParamName}' must contain only printable ASCII characters (RFC 7230 §3.2.6)`
      );
    }
    this.host = host;
    this.keyParamName = keyParamName;
    this.apiKey = resolvedKey;
    this.location = location;
  }

  getHost(): string {
    return this.host;
  }

  getAuthHeaders(): Record<string, string> {
    if (this.location === ApiKeyLocation.HEADER) {
      return { [this.keyParamName]: this.apiKey };
    }
    return {};
  }

  getAuthHeadersAsync(): Promise<Record<string, string>> {
    return Promise.resolve(this.getAuthHeaders());
  }

  override getQueryParams(): Record<string, string> {
    if (this.location === ApiKeyLocation.QUERY) {
      return { [this.keyParamName]: this.apiKey };
    }
    return {};
  }

  override getCookieParams(): Record<string, string> {
    if (this.location === ApiKeyLocation.COOKIE) {
      return { [this.keyParamName]: this.apiKey };
    }
    return {};
  }

  /* Redact the API key from the default string/inspect representation so
   * logging or inspecting the authenticator never leaks the credential. */
  [Symbol.for('nodejs.util.inspect.custom')](): string {
    return `${this.constructor.name}(host=${this.host}, keyParamName=${this.keyParamName}, apiKey=***, location=${this.location})`;
  }

  toJSON(): Record<string, string> {
    return { host: this.host, keyParamName: this.keyParamName, apiKey: '***', location: this.location };
  }
}
