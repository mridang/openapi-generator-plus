import { BaseAuthenticator } from './base-authenticator{{importFileExtension}}';
import { resolveCredential } from './credentials{{importFileExtension}}';

/**
 * Authenticator for HTTP Basic authentication.
 *
 * Each of the user name and the password is the explicit argument, or else
 * the environment variable `{{envPrefix}}_<FIELDPREFIX>USERNAME` or
 * `{{envPrefix}}_<FIELDPREFIX>PASSWORD`, read once here. A missing value fails
 * here, when the authenticator is built.
 */
export class BasicAuthenticator extends BaseAuthenticator {
  private readonly host: string;
  private readonly username: string;
  private readonly password: string;

  /**
   * @param host API base URL
   * @param username the user name, or `undefined` to read it from the environment
   * @param password the password, or `undefined` to read it from the environment
   * @param fieldPrefix the prefix of the environment fields (empty for `USERNAME` and `PASSWORD`)
   * @throws TypeError if a value is missing or malformed
   */
  constructor(host: string, username: string | undefined, password: string | undefined, fieldPrefix = '') {
    super();
    const resolvedUsername = resolveCredential(username, `${fieldPrefix}USERNAME`, 'Basic auth username');
    const resolvedPassword = resolveCredential(password, `${fieldPrefix}PASSWORD`, 'Basic auth password');
    /* RFC 7617 §2 — user-id MUST NOT contain ':' (it is the field
     * separator) and neither user-id nor password may carry CR/LF/NUL
     * (header-injection / smuggling vectors common when credentials are
     * read from .env files or interactive prompts). Validated eagerly at
     * construction so a malformed credential surfaces where it is supplied
     * rather than lazily at first request. */
    if (/[\r\n\0]/.test(resolvedUsername)) {
      throw new TypeError(
        'Basic auth username must not contain CR, LF, or NUL characters'
      );
    }
    if (resolvedUsername.includes(':')) {
      throw new TypeError(
        "Basic auth username must not contain ':' (RFC 7617 §2)"
      );
    }
    if (/[\r\n\0]/.test(resolvedPassword)) {
      throw new TypeError(
        'Basic auth password must not contain CR, LF, or NUL characters'
      );
    }
    this.host = host;
    this.username = resolvedUsername;
    this.password = resolvedPassword;
  }

  getHost(): string {
    return this.host;
  }

  getAuthHeaders(): Record<string, string> {
    const authHeader =
      'Basic ' + Buffer.from(`${this.username}:${this.password}`).toString('base64');
    return { Authorization: authHeader };
  }

  getAuthHeadersAsync(): Promise<Record<string, string>> {
    return Promise.resolve(this.getAuthHeaders());
  }

  /* Redact the password from the default string/inspect representation so
   * logging or inspecting the authenticator never leaks the credential. */
  [Symbol.for('nodejs.util.inspect.custom')](): string {
    return `${this.constructor.name}(host=${this.host}, username=${this.username}, password=***)`;
  }

  toJSON(): Record<string, string> {
    return { host: this.host, username: this.username, password: '***' };
  }
}
