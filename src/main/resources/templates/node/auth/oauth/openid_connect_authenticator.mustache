import type { ApiClient } from '../../api-client{{importFileExtension}}';
import { ApiError, SerializationError } from '../../errors/index{{importFileExtension}}';
import type { HttpAwareAuthenticator } from '../http-aware-authenticator{{importFileExtension}}';
import { OAuth2AuthorizationCodeAuthenticator, type PkceState } from './oauth2-authorization-code-authenticator{{importFileExtension}}';
import { OAuth2TokenManager } from './oauth2-token-manager{{importFileExtension}}';

/**
 * Authenticator for OpenID Connect.
 *
 * Fetches the OIDC discovery document to discover the authorization and
 * token endpoints, then delegates to an {@link OAuth2AuthorizationCodeAuthenticator}.
 *
 * Implements {@link HttpAwareAuthenticator} so that both the discovery
 * request and subsequent token exchange requests use the shared
 * {@link ApiClient} with the same transport configuration (proxy, TLS,
 * timeouts) as regular API calls.
 */
export class OpenIdConnectAuthenticator implements HttpAwareAuthenticator {
  private readonly host: string;
  private readonly openIdConnectUrl: string;
  private readonly clientId: string;
  private readonly clientSecret: string;
  private readonly redirectUri: string;
  private readonly scopes: readonly string[];
  private apiClient: ApiClient | null = null;
  private delegate: OAuth2AuthorizationCodeAuthenticator | null = null;
  private discoveryExpiry = 0;
  private inflightDiscovery: Promise<OAuth2AuthorizationCodeAuthenticator> | null = null;
  /* The session (tokens and the exchanged flag) outlives discovery: every
   * delegate built from a (re)fetched document shares this manager. */
  private readonly tokenManager = new OAuth2TokenManager();
  /* The PKCE verifier of the last authorization URL outlives rediscovery too. */
  private readonly pkce: PkceState = { verifier: null };

  /** RFC 8414 recommended default max-age for OIDC discovery documents. */
  private static readonly DEFAULT_DISCOVERY_MAX_AGE_SECONDS = 86400;
  private static readonly MAX_AGE_PATTERN = /max-age=(\d+)/i;
  /** Longest discovery max-age (one year, in seconds) a server may claim. */
  private static readonly MAX_DISCOVERY_MAX_AGE_SECONDS = 31_536_000;

  /**
   * Create a new OpenID Connect authenticator.
   *
   * @param host API base URL
   * @param openIdConnectUrl OIDC discovery document URL
   * @param clientId OAuth2 client ID
   * @param clientSecret OAuth2 client secret
   * @param redirectUri redirect URI registered with the provider
   * @param scopes requested scopes
   */
  constructor(
    host: string,
    openIdConnectUrl: string,
    clientId: string,
    clientSecret: string,
    redirectUri: string,
    scopes: string[]
  ) {
    this.host = host;
    this.openIdConnectUrl = openIdConnectUrl;
    this.clientId = clientId;
    this.clientSecret = clientSecret;
    this.redirectUri = redirectUri;
    /* OpenID Connect Core 3.1.2.1: the scope parameter must contain 'openid'. */
    this.scopes = Object.freeze(['openid', ...scopes.filter((s) => s !== 'openid')]);
  }

  /**
   * Inject the shared API client for making HTTP requests.
   *
   * Used for fetching the discovery document and for token exchange
   * via the delegate authenticator.
   *
   * @param apiClient the shared API client instance
   */
  setApiClient(apiClient: ApiClient): void {
    this.apiClient = apiClient;
    this.tokenManager.setApiClient(apiClient);
  }

  /**
   * Return the delegate, fetching the discovery document when it is missing
   * or its max-age has passed. Concurrent callers share one fetch. A failed
   * rediscovery leaves the previous delegate and expiry untouched, so the
   * next call retries.
   *
   * @returns the delegate authorization code authenticator
   * @throws Error if the API client has not been injected
   * @throws ApiError if the discovery request answers with a non-2xx status
   *   (the status-specific subclass where there is one)
   * @throws SerializationError if the discovery document is unusable
   */
  private async getDelegate(): Promise<OAuth2AuthorizationCodeAuthenticator> {
    if (this.delegate && Date.now() < this.discoveryExpiry) {
      return this.delegate;
    }
    if (this.inflightDiscovery) {
      return this.inflightDiscovery;
    }
    this.inflightDiscovery = (async () => {
      try {
        return await this.discover();
      } finally {
        this.inflightDiscovery = null;
      }
    })();
    return this.inflightDiscovery;
  }

  /**
   * Fetch the OIDC discovery document and build a delegate around the
   * shared token manager.
   */
  private async discover(): Promise<OAuth2AuthorizationCodeAuthenticator> {
    if (this.apiClient == null) {
      throw new Error(
        'ApiClient has not been injected. ' +
          'Ensure the {{clientClassName}} constructor calls setApiClient() ' +
          'on HttpAwareAuthenticator before making API requests.'
      );
    }
    /* The discovery document names the endpoints that later receive the
     * client secret, the authorization code and the refresh token, so it is
     * only fetched over https (or from a loopback host, RFC 8252 section 8.3). */
    if (!OpenIdConnectAuthenticator.isSecureOrLoopback(this.openIdConnectUrl)) {
      throw new TypeError('OIDC discovery URL must use https');
    }
    const response = await this.apiClient.sendRequest(
      'GET',
      this.openIdConnectUrl,
      { Accept: 'application/json' },
      null,
      { noDefaultHeaders: true }
    );
    /* Guard the HTTP status before JSON-parsing: an error response (e.g.
     * a 500 HTML page) must surface as a clear discovery failure, not be
     * mis-reported as "invalid JSON" from a downstream parse error.
     * Discovery is an HTTP call like any other, so it throws the same typed
     * error an API call with that status would. */
    if (response.statusCode < 200 || response.statusCode >= 300) {
      throw ApiError.fromResponse(response.statusCode, response.headers, response.body);
    }
    let parsed: unknown;
    try {
      parsed = JSON.parse(response.body);
    } catch (error) {
      throw new SerializationError(
        `OIDC discovery document is not valid JSON: ${(error as Error).message}`,
        error as Error
      );
    }
    if (parsed == null || typeof parsed !== 'object' || Array.isArray(parsed)) {
      throw new SerializationError('OIDC discovery document is not a JSON object');
    }
    const discovery = parsed as Record<string, unknown>;
    this.requireMatchingIssuer(discovery);
    /* Reject a malformed/partial discovery document before building the
     * delegate: an absent/null/empty authorization_endpoint or
     * token_endpoint would otherwise be passed through as `undefined` and
     * cause credentials to be POSTed to a malformed URL. Parity with the
     * other SDKs which fail loudly here. */
    const authorizationEndpoint = discovery.authorization_endpoint;
    if (typeof authorizationEndpoint !== 'string' || authorizationEndpoint.length === 0) {
      throw new SerializationError("OIDC discovery document is missing 'authorization_endpoint'");
    }
    const tokenEndpoint = discovery.token_endpoint;
    if (typeof tokenEndpoint !== 'string' || tokenEndpoint.length === 0) {
      throw new SerializationError("OIDC discovery document is missing 'token_endpoint'");
    }
    for (const [field, endpoint] of [
      ['authorization_endpoint', authorizationEndpoint],
      ['token_endpoint', tokenEndpoint]
    ]) {
      if (!OpenIdConnectAuthenticator.isSecureOrLoopback(endpoint)) {
        throw new SerializationError(`OIDC discovery document field must be an https URL: ${field}`);
      }
    }
    const delegate = new OAuth2AuthorizationCodeAuthenticator(
      this.host,
      this.clientId,
      this.clientSecret,
      authorizationEndpoint,
      tokenEndpoint,
      this.redirectUri,
      [...this.scopes],
      null,
      this.tokenManager,
      this.pkce
    );
    delegate.setApiClient(this.apiClient);
    this.delegate = delegate;
    this.discoveryExpiry =
      Date.now() +
      OpenIdConnectAuthenticator.parseMaxAge(response.headers) * 1000;
    return delegate;
  }

  /**
   * Reject a discovery document whose `issuer` differs from the discovery URL
   * without its `/.well-known/openid-configuration` suffix (OpenID Connect
   * Discovery 1.0 section 4.3), compared without a trailing slash. A document
   * without a string issuer, or a discovery URL of another shape, is not
   * checked.
   *
   * @throws SerializationError if the issuer does not match
   */
  private requireMatchingIssuer(discovery: Record<string, unknown>): void {
    const suffix = '/.well-known/openid-configuration';
    const issuer = discovery.issuer;
    if (typeof issuer !== 'string' || !this.openIdConnectUrl.endsWith(suffix)) {
      return;
    }
    const expected = this.openIdConnectUrl.slice(0, this.openIdConnectUrl.length - suffix.length);
    if (issuer.replace(/\/$/, '') !== expected.replace(/\/$/, '')) {
      throw new SerializationError('OIDC discovery document issuer does not match the discovery URL');
    }
  }

  /**
   * An https URL, or an http URL whose host is a loopback address (RFC 8252
   * section 8.3); anything unparseable is refused.
   */
  private static isSecureOrLoopback(url: string): boolean {
    let parsed: URL;
    try {
      parsed = new URL(url);
    } catch {
      return false;
    }
    if (parsed.protocol === 'https:') {
      return true;
    }
    return (
      parsed.protocol === 'http:' &&
      (parsed.hostname === 'localhost' || parsed.hostname === '127.0.0.1' || parsed.hostname === '[::1]')
    );
  }

  /**
   * Parse `Cache-Control: max-age=<seconds>` from response headers.
   *
   * @returns the parsed max-age in seconds, or 86400 (RFC 8414 default) if
   *   the header is absent or does not contain a `max-age` directive
   */
  private static parseMaxAge(headers: Readonly<Record<string, string>>): number {
    for (const [name, value] of Object.entries(headers)) {
      if (name.toLowerCase() === 'cache-control') {
        const match = OpenIdConnectAuthenticator.MAX_AGE_PATTERN.exec(value);
        if (match) {
          const seconds = Number.parseInt(match[1], 10);
          return Number.isFinite(seconds)
            ? Math.min(seconds, OpenIdConnectAuthenticator.MAX_DISCOVERY_MAX_AGE_SECONDS)
            : OpenIdConnectAuthenticator.DEFAULT_DISCOVERY_MAX_AGE_SECONDS;
        }
        return OpenIdConnectAuthenticator.DEFAULT_DISCOVERY_MAX_AGE_SECONDS;
      }
    }
    return OpenIdConnectAuthenticator.DEFAULT_DISCOVERY_MAX_AGE_SECONDS;
  }

  /**
   * Build the authorization URL using the discovered authorization endpoint.
   *
   * @param state optional CSRF state parameter
   * @returns the authorization URL
   */
  async buildAuthorizationUrl(state?: string): Promise<string> {
    const delegate = await this.getDelegate();
    return delegate.buildAuthorizationUrl(state);
  }

  /**
   * Exchange an authorization code for tokens using the discovered token endpoint.
   *
   * @param code the authorization code from the callback
   */
  async exchangeCode(code: string): Promise<void> {
    const delegate = await this.getDelegate();
    await delegate.exchangeCode(code);
  }

  /**
   * Returns the base URL of the API.
   *
   * @returns the host URL
   */
  getHost(): string {
    return this.host;
  }

  /**
   * Always throws: a token cannot be fetched synchronously, and returning
   * empty headers would silently send an unauthenticated request. Use
   * {@link getAuthHeadersAsync} to obtain a valid Bearer token.
   *
   * @throws Error always
   */
  getAuthHeaders(): Record<string, string> {
    throw new Error(
      'OAuth2 authenticators require async token exchange; use getAuthHeadersAsync() instead.'
    );
  }

  /**
   * Returns the authentication headers with a valid Bearer token.
   *
   * @returns a promise resolving to the authorization headers
   */
  async getAuthHeadersAsync(): Promise<Record<string, string>> {
    const delegate = await this.getDelegate();
    return delegate.getAuthHeadersAsync();
  }

  /**
   * Drop the cached access token so the next request obtains a fresh one
   * (through the refresh token when one is held). The refresh token is kept.
   * The client calls this when the API answers 401.
   */
  invalidateAccessToken(): void {
    this.tokenManager.invalidateAccessToken();
  }

  /**
   * Returns query parameters to include for authentication.
   *
   * @returns empty record (not used for OpenID Connect)
   */
  getQueryParams(): Record<string, string> {
    return {};
  }

  /**
   * Returns cookie parameters to include for authentication.
   *
   * @returns empty record (not used for OpenID Connect)
   */
  getCookieParams(): Record<string, string> {
    return {};
  }

  /* Redact the client secret from the default string/inspect representation
   * so `console.log(auth)` / `util.inspect(auth)` / JSON.stringify never
   * exfiltrate the credential into application logs. */
  [Symbol.for('nodejs.util.inspect.custom')](): string {
    return `OpenIdConnectAuthenticator(host=${this.host}, clientId=${this.clientId}, clientSecret=***)`;
  }

  toJSON(): Record<string, string> {
    return { host: this.host, clientId: this.clientId, clientSecret: '***' };
  }
}
