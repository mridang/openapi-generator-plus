.PHONY: install build test lint format typecheck audit docs clean

install:
	npm install

build: install
	npx tsc

test: install
	npm test

lint: install
	npx eslint .
	npx prettier --check .

format: install
	npx prettier --write .

typecheck: install
	npx tsc --noEmit

audit: install
	npm audit --omit=dev

docs: install
	npx typedoc --out .out/docs --treatWarningsAsErrors

clean:
	rm -rf node_modules dist coverage .out/docs
