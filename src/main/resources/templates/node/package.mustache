    "undici": "^6"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "typescript": "^5.7",
    "jest": "^30.0",
    "jest-junit": "^16.0",
    "ts-jest": "^29.4",
    "@types/jest": "^30.0",
    "@types/node": "^24.0",
    "eslint": "^9.0",
    "@eslint/js": "^9.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "@typescript-eslint/parser": "^8.0",
    "typescript-eslint": "^8.0",
    "prettier": "^3.0",
