import type { ApiResult } from './api-result{{importFileExtension}}';
import { PaginationError } from './errors/pagination-error{{importFileExtension}}';
import { nextLink } from './link-header{{importFileExtension}}';

/**
 * One page of a paged list: the items it holds, the cursor of the page after it, and the result of
 * the request that returned it.
 *
 * `nextCursor` has the type of the cursor request parameter and is `null` on the last page. A list
 * that is followed by the `Link` header has no cursor, so its `nextCursor` is always `null`.
 * `result` is what the matching `...WithHttpInfo` method returns for this page: the status, the
 * headers, the raw body and the decoded body.
 */
export interface Page<T, C> {
  /** The items of this page, in order (frozen). */
  readonly items: readonly T[];
  /** The cursor of the next page, or `null` on the last page. */
  readonly nextCursor: C | null;
  /** The status, headers, raw body and decoded body of the request that returned this page. */
  readonly result: ApiResult<unknown>;
}

/**
 * The items of a paged list, read lazily. The method that returns it sends no request; the first
 * request goes out when you first read an item or a page, and each next request goes out only when
 * you ask for more. Every page is an ordinary call, so the retries, timeouts, redirects,
 * authentication, redaction, headers and per-call options of the method apply to each one.
 *
 * Iterate it with `for await` (or call {@link items}) for the items, or call {@link pages} for the
 * pages with their cursor and result. Each call starts again from the starting position, so two
 * loops read the list twice. Stopping early (`break`) leaves nothing to close. A failed page request
 * raises its SDK error from the read that needed it, after the items of the earlier pages were
 * delivered, and ends that iteration; a cursor equal to the one just sent raises a
 * {@link PaginationError} from the next read, after the items of the page that repeated it.
 *
 * `T` is the item type and `C` is the type of the cursor request parameter, `never` for a list that
 * is followed by the `Link` header.
 */
export class Paginator<T, C = never> implements AsyncIterable<T> {
  private constructor(private readonly source: () => AsyncGenerator<Page<T, C>, void, undefined>) {}

  /**
   * Creates a paginator that follows a token cursor. Used by the generated `...Pages` methods.
   *
   * @param start the cursor of the first request, or `undefined` to start at the beginning
   * @param fetch sends the request for a cursor (`undefined` for none) and returns its result
   * @param items reads the items of a decoded page
   * @param next reads the cursor of the next page from a decoded page; absent, `null` or empty ends the list
   * @param requestPath the path of the operation, for errors
   * @returns the paginator
   */
  static ofCursor<T, C extends string | number, B>(
    start: C | undefined,
    fetch: (cursor: C | undefined) => Promise<ApiResult<B>>,
    items: (page: B) => readonly T[] | null | undefined,
    next: (page: B) => C | null | undefined,
    requestPath: string
  ): Paginator<T, C> {
    return new Paginator<T, C>(async function* (): AsyncGenerator<Page<T, C>, void, undefined> {
      let sent = start;
      for (;;) {
        const result = await fetch(sent);
        const body = result.data;
        const list = body == null ? [] : (items(body) ?? []);
        const following = body == null ? null : (next(body) ?? null);
        if (following === null || following === '') {
          yield { items: Object.freeze([...list]), nextCursor: null, result };
          return;
        }
        yield { items: Object.freeze([...list]), nextCursor: following, result };
        /* The page itself is good: it was delivered, and the next read raises. */
        if (following === sent) {
          throw new PaginationError('The server returned the cursor that was just sent, so the list cannot advance', {
            requestPath
          });
        }
        sent = following;
      }
    });
  }

  /**
   * Creates a paginator that follows the `rel="next"` link of the `Link` header. Used by the
   * generated `...Pages` methods.
   *
   * @param baseUrl the base URL of the client; a next URL that leaves its scheme, host or port is refused
   * @param fetch sends the request for a URL (`undefined` for the first page) and returns its result
   * @param items reads the items of a decoded page
   * @param requestPath the path of the operation, for errors
   * @returns the paginator
   */
  static ofLink<T, B>(
    baseUrl: string,
    fetch: (url: string | undefined) => Promise<ApiResult<B>>,
    items: (page: B) => readonly T[] | null | undefined,
    requestPath: string
  ): Paginator<T, never> {
    return new Paginator<T, never>(async function* (): AsyncGenerator<Page<T, never>, void, undefined> {
      let url: string | undefined;
      for (;;) {
        const result = await fetch(url);
        const body = result.data;
        const list = body == null ? [] : (items(body) ?? []);
        const link = nextLink(headerOf(result.headers, 'link'));
        yield { items: Object.freeze([...list]), nextCursor: null, result };
        if (link === null) {
          return;
        }
        /* The page itself is good: it was delivered, and the next read raises. */
        const target = resolveNext(baseUrl, url, link, requestPath);
        if (target === url) {
          throw new PaginationError(
            'The server returned a next link to the page that was just read, so the list cannot advance',
            { requestPath }
          );
        }
        url = target;
      }
    });
  }

  /**
   * Returns the items, starting at the starting position. Every call starts again.
   *
   * @returns a new lazy sequence of the items
   */
  items(): AsyncGenerator<T, void, undefined> {
    const pages = this.source();
    return (async function* (): AsyncGenerator<T, void, undefined> {
      for await (const page of pages) {
        yield* page.items;
      }
    })();
  }

  /**
   * Returns the pages, each with its items, next cursor and result. Every call starts again at the
   * starting position.
   *
   * @returns a new lazy sequence of pages
   */
  pages(): AsyncGenerator<Page<T, C>, void, undefined> {
    return this.source();
  }

  /**
   * Returns the items, like {@link items}, so the paginator itself can be iterated with `for await`.
   *
   * @returns a new lazy sequence of the items
   */
  [Symbol.asyncIterator](): AsyncGenerator<T, void, undefined> {
    return this.items();
  }
}

/** The value of a response header by name, whatever the case the transport gave it. */
function headerOf(headers: Readonly<Record<string, string>>, name: string): string | null {
  for (const [key, value] of Object.entries(headers)) {
    if (key.toLowerCase() === name) {
      return value;
    }
  }
  return null;
}

/** Resolves a link against the page just read and refuses a scheme, host or port other than the client's. */
function resolveNext(baseUrl: string, current: string | undefined, link: string, requestPath: string): string {
  let base: URL;
  let target: URL;
  try {
    base = new URL(baseUrl);
    target = new URL(link.trim(), current ?? base);
  } catch {
    throw new PaginationError('The next link is not a valid URI', { requestPath });
  }
  const web = target.protocol === 'http:' || target.protocol === 'https:';
  if (!web || target.origin !== base.origin) {
    throw new PaginationError('The next link leaves the origin of the request and was not followed', { requestPath });
  }
  return target.toString();
}
