{{>api_info}}

/*
 * Public API barrel. This is the package entry point referenced by the
 * `exports`/`main`/`types` fields in package.json. Only the symbols
 * re-exported here form the supported public surface; everything else under
 * `src/` (ObjectSerializer, ValueSerializer, HeaderSelector, the trace-context
 * helper, SENSITIVE_HEADER_NAMES, the oneOf/anyOf resolve helpers, …) is
 * internal plumbing and must not be imported by consumers.
 */

/*
 * Client entry point and per-group API classes (+ their Options, server, and
 * inline-enum types, re-exported transitively through the api barrel).
 */
export { {{clientClassName}} } from './{{clientClassFile}}{{importFileExtension}}';
export * from './api/index{{importFileExtension}}';

/* Model types. */
export * from './models/index{{importFileExtension}}';

/*
 * Transport-level DTOs and the pluggable HTTP client seam.
 *
 * The transport response shape carried by `ApiClient.sendRequest` lives in
 * `./api-response` and is exposed structurally through the exported
 * `ApiClient` interface; it is intentionally NOT re-exported by name here so
 * it cannot collide with a spec model that happens to be named `ApiResponse`
 * (the model wins via the `./models` star export).
 */
export type { ApiClient, SendRequestOptions } from './api-client{{importFileExtension}}';
export type { ApiResult } from './api-result{{importFileExtension}}';
export { DefaultApiClient } from './default-api-client{{importFileExtension}}';

/* Configuration and transport tuning. */
export { Configuration, ConfigurationBuilder } from './configuration{{importFileExtension}}';
export { TransportOptions, TransportOptionsBuilder } from './transport-options{{importFileExtension}}';
export { ServerConfiguration, ServerVariable } from './server-configuration{{importFileExtension}}';

/* Branded scalar types and their constructors. */
export { isUuid, uuid, URI, Email, Decimal } from './brand{{importFileExtension}}';
export type { UUID } from './brand{{importFileExtension}}';

/* Error hierarchy. */
export { ApiError } from './api-error{{importFileExtension}}';
export * from './errors/index{{importFileExtension}}';
export { SerializationError, DeserializationError } from './object-serializer{{importFileExtension}}';

/*
 * Authentication: the interface, the HTTP-aware extension, and every
 * concrete authenticator the spec's security schemes require.
 */
export type { Authenticator } from './auth/authenticator{{importFileExtension}}';
export type { HttpAwareAuthenticator } from './auth/http-aware-authenticator{{importFileExtension}}';
export { isHttpAwareAuthenticator } from './auth/http-aware-authenticator{{importFileExtension}}';
{{#hasBasicAuth}}
export { BasicAuthenticator } from './auth/basic-authenticator{{importFileExtension}}';
{{/hasBasicAuth}}
