# frozen_string_literal: true

{{>api_info}}

require 'json'

module {{moduleName}}
  module Auth
    module OAuth
      # Authenticator for OpenID Connect.
      #
      # Fetches the OIDC discovery document to discover the authorization and
      # token endpoints, then delegates to an {OAuth2AuthorizationCodeAuthenticator}.
      #
      # Includes {HttpAwareAuthenticator} so that both the discovery request
      # and subsequent token exchange requests use the shared {ApiClient}
      # with the same transport configuration (proxy, TLS, timeouts) as
      # regular API calls.
      class OpenIdConnectAuthenticator < BaseAuthenticator
        include HttpAwareAuthenticator

        # @return [String]
        attr_reader :host

        # Create a new OpenID Connect authenticator.
        #
        # @param host [String] API base URL
        # @param openid_connect_url [String] OIDC discovery document URL
        # @param client_id [String] OAuth2 client ID
        # @param client_secret [String] OAuth2 client secret
        # @param redirect_uri [String] redirect URI registered with the provider
        # @param scopes [Array<String>] requested scopes
        # rubocop:disable Metrics/ParameterLists
        def initialize(host, openid_connect_url, client_id, client_secret, redirect_uri, scopes)
          super()
          @host = host
          @openid_connect_url = openid_connect_url
          @client_id = client_id
          @client_secret = client_secret
          @redirect_uri = redirect_uri
          @scopes = scopes.freeze
          @api_client = nil
          @delegate = nil
        end
        # rubocop:enable Metrics/ParameterLists

        # Inject the shared API client for making discovery and token requests.
        #
        # @param client [ApiClient] the shared API client instance
        # @return [void]
        attr_writer :api_client

        # Build the authorization URL using the discovered authorization endpoint.
        #
        # @param state [String, nil] CSRF state parameter
        # @return [String] the authorization URL
        def build_authorization_url(state = nil)
          resolve_delegate.build_authorization_url(state)
        end

        # Exchange an authorization code for tokens using the discovered token endpoint.
        #
        # @param code [String] the authorization code from the callback
        # @return [void]
        def exchange_code(code)
          resolve_delegate.exchange_code(code)
        end

        # @return [Hash{String => String}]
        def auth_headers
          resolve_delegate.auth_headers
        end

        private

        # Lazily resolve the delegate by fetching the OIDC discovery document
        # using the injected API client.
        #
        # @return [OAuth2AuthorizationCodeAuthenticator]
        # @raise [RuntimeError] if the API client has not been injected
        def resolve_delegate # rubocop:disable Metrics/MethodLength
          return @delegate if @delegate

          client = @api_client
          if client.nil?
            raise 'ApiClient has not been injected. ' \
                  'Ensure the {{clientClassName}} constructor calls api_client= ' \
                  'on HttpAwareAuthenticator before making API requests.'
          end

          headers = { 'Accept' => 'application/json' }
          response = client.send_request(:get, @openid_connect_url, headers, nil)
          discovery = JSON.parse(response.body)
          @delegate = OAuth2AuthorizationCodeAuthenticator.new(
            @host, @client_id, @client_secret,
            discovery['authorization_endpoint'],
            discovery['token_endpoint'],
            @redirect_uri, @scopes
          )
          @delegate.api_client = client
          @delegate
        end
      end
    end
  end
end
