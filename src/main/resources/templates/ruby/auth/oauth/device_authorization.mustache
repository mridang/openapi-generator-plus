# frozen_string_literal: true

{{>api_info}}

module {{moduleName}}
  module Auth
    module OAuth
      # What the device authorization endpoint (RFC 8628 section 3.2) answered:
      # show +user_code+ and +verification_uri+ (or +verification_uri_complete+
      # when the server sent one) to the user, then hand the value to
      # {OAuth2DeviceAuthorizationAuthenticator#poll_for_token}. It is a frozen
      # value.
      #
      # @!attribute [r] device_code
      #   @return [String] the code the client polls with
      # @!attribute [r] user_code
      #   @return [String] the code the user enters
      # @!attribute [r] verification_uri
      #   @return [String] where the user enters the code
      # @!attribute [r] verification_uri_complete
      #   @return [String, nil] a URI that already carries the code, when the server sent one
      # @!attribute [r] expires_in
      #   @return [Integer] seconds until the device code expires
      # @!attribute [r] interval
      #   @return [Integer] seconds to wait between two polls (5 when the server sent none)
      DeviceAuthorization = Data.define(
        :device_code, :user_code, :verification_uri, :verification_uri_complete, :expires_in, :interval
      )
    end
  end
end
