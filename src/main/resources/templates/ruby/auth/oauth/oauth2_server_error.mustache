# frozen_string_literal: true

{{>api_info}}

require_relative '../../{{apiErrorParentFile}}'

module {{moduleName}}
  module Auth
    module OAuth
      # Raised when the OAuth2 token endpoint answers with a non-2xx status,
      # including a 3xx redirect, which the token POST never follows.
      # Typed representation of an RFC 6749 §5.2 OAuth2 error response. The
      # +code+ attribute carries the OAuth2 error code (e.g. +invalid_grant+,
      # +invalid_client+); +description+ and +uri+ are the optional
      # human-readable description and a URL to a page describing the error.
      # +raw_body+ preserves the original response payload for diagnostics
      # when the body is not a well-formed OAuth2 error object.
      class OAuth2ServerError < {{apiErrorParent}}
        attr_reader :status_code, :code, :description, :uri, :raw_body

        def initialize(status_code, code, description, uri, raw_body)
          @status_code = status_code
          @code = code
          @description = description
          @uri = uri
          @raw_body = raw_body
          super(build_message)
        end

        private

        def build_message
          if @code.nil?
            "Token request failed with status #{@status_code}: #{@raw_body}"
          elsif @description
            "Token request failed with status #{@status_code}: #{@code} -- #{@description}"
          else
            "Token request failed with status #{@status_code}: #{@code}"
          end
        end
      end
    end
  end
end
