# frozen_string_literal: true

{{>api_info}}

require 'base64'

module {{moduleName}}
  module Auth
    # Authenticator for HTTP Basic authentication.
    class BasicAuthenticator < BaseAuthenticator
      attr_reader :host

      # A credential left out comes from the environment variable
      # +<PREFIX>_USERNAME+ or +<PREFIX>_PASSWORD+, read once, here (an empty
      # value counts as unset); one that is still missing fails here.
      #
      # @param host [String] API base URL
      # @param username [String, nil]
      # @param password [String, nil]
      # @param env [#[]] where the variables are read from
      def initialize(host, username = nil, password = nil, env: ENV)
        super()
        username = credential_from(username, 'USERNAME', env)
        password = credential_from(password, 'PASSWORD', env)
        raise ArgumentError, 'Basic auth username must not be empty' if username.nil?
        raise ArgumentError, 'Basic auth password must not be empty' if password.nil?

        # Validate eagerly at construction so a malformed credential surfaces
        # where it is supplied rather than lazily at first request.
        # RFC 7617 §2 — user-id MUST NOT contain ':' (it is the field
        # separator) and neither user-id nor password may carry CR/LF/NUL
        # (header-injection / smuggling vectors common when credentials
        # are read from .env files or interactive prompts).
        if username.match?(/[\r\n\x00]/)
          raise ArgumentError,
                'Basic auth username must not contain CR, LF, or NUL characters'
        end
        if username.include?(':')
          raise ArgumentError,
                "Basic auth username must not contain ':' (RFC 7617 §2)"
        end
        if password.match?(/[\r\n\x00]/)
          raise ArgumentError,
                'Basic auth password must not contain CR, LF, or NUL characters'
        end
        @host = host
        @username = username
        @password = password
      end

      # Redact the password from the default object representation so logging
      # or inspecting an authenticator never leaks the credential.
      def inspect
        "#<#{self.class.name} host=#{@host.inspect} username=#{@username.inspect} password=\"***\">"
      end
      alias to_s inspect

      # @return [Hash{String => String}]
      def auth_headers
        # RFC 7617 §2.1: the credentials are sent as UTF-8. A Ruby string
        # carries its own encoding, so a Latin-1 one is transcoded rather than
        # sent as Latin-1 bytes, and mixing encodings does not raise.
        credentials = [@username, @password].map do |part|
          part.encoding == Encoding::BINARY ? part : part.encode(Encoding::UTF_8)
        end
        { 'Authorization' => "Basic #{Base64.strict_encode64(credentials.join(':'))}" }
      end
    end
  end
end
