# frozen_string_literal: true

{{>api_info}}

module {{moduleName}}
  module Auth
    # Extension of {Authenticator} for authentication schemes that require
    # making HTTP requests (e.g. OAuth2 token exchange, OpenID Connect discovery).
    #
    # Implementations receive a shared {ApiClient} instance so that
    # authentication-related HTTP calls (token endpoints, discovery documents)
    # use the same transport configuration (proxy, TLS, timeouts) as regular
    # API calls.
    #
    # The {ApiClient} is injected by the {{clientClassName}} class after construction,
    # via {#api_client=}. Implementations must not make HTTP calls before
    # the client is injected.
    #
    # Only OAuth2 and OpenID Connect authenticators include this module.
    # Simple authenticators (Basic, Bearer, API Key) do not need HTTP access
    # and inherit from {Authenticator} directly.
    module HttpAwareAuthenticator
      # Inject the shared API client for making HTTP requests.
      #
      # Called by the {{clientClassName}} constructor after the {ApiClient} has been
      # created with the user's {TransportOptions}. Implementations should
      # store this reference and use it for all outbound HTTP calls
      # (token exchange, discovery, etc.).
      #
      # @param client [ApiClient] the shared API client instance
      # @return [void]
      def api_client=(client)
        raise NotImplementedError, "#{self.class}#api_client= must be implemented"
      end
    end

    # The credentials of every scheme one security requirement names together:
    # the headers, query parameters and cookies of all of them are sent.
    class AllOfAuthenticator < Authenticator
      # The composite of +parts+; one holding a token authenticator can drop a
      # cached token on a 401.
      #
      # @param parts [Array<Authenticator>] the credentials, in the order the requirement names them
      # @return [Authenticator]
      def self.of(parts)
        parts.any? { |part| part.is_a?(HttpAwareAuthenticator) } ? AllOfHttpAwareAuthenticator.new(parts) : new(parts)
      end

      # @param parts [Array<Authenticator>]
      def initialize(parts)
        super()
        @parts = parts
      end

      # @return [String]
      def host
        @parts.first.host
      end

      # @return [Hash{String => String}]
      def auth_headers
        @parts.each_with_object({}) { |part, merged| merged.merge!(part.auth_headers) }
      end

      # @return [Hash{String => String}]
      def query_params
        @parts.each_with_object({}) { |part, merged| merged.merge!(part.query_params) }
      end

      # @return [Hash{String => String}]
      def cookie_params
        @parts.each_with_object({}) { |part, merged| merged.merge!(part.cookie_params) }
      end

      protected

      attr_reader :parts
    end

    # The composite of a requirement that includes a token authenticator.
    class AllOfHttpAwareAuthenticator < AllOfAuthenticator
      include HttpAwareAuthenticator

      # @param client [ApiClient]
      # @return [void]
      def api_client=(client)
        parts.each { |part| part.api_client = client if part.is_a?(HttpAwareAuthenticator) }
      end

      # @return [void]
      def invalidate_access_token
        parts.each { |part| part.invalidate_access_token if part.respond_to?(:invalidate_access_token) }
      end
    end
  end
end
