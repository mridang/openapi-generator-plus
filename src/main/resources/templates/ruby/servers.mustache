# frozen_string_literal: true

{{>api_info}}

module {{moduleName}}
  # Generated server configurations from the OpenAPI specification.
  #
  # Each constant corresponds to a server entry defined in the spec's
  # +servers+ array. Use these constants with
  # {Configuration::Builder#base_url} to select a server:
  #
  #     config = ::{{moduleName}}::Configuration.builder
  #       .base_url(::{{moduleName}}::Servers::SERVER_0.url)
  #       .build
  #
  # For servers with variables, pass overrides:
  #
  #     url = ::{{moduleName}}::Servers::SERVER_1.url('environment' => 'staging')
  module Servers
{{#serverConfigs}}
    # Server {{serverIndex}}: +{{{serverUrl}}}+{{#serverDescription}}
    #
    # {{#lambda.rubyComment}}{{{serverDescription}}}{{/lambda.rubyComment}}{{/serverDescription}}
    SERVER_{{serverIndex}} = ServerConfiguration.new(
      url_template: '{{#lambda.rubyQuoted}}{{{serverUrl}}}{{/lambda.rubyQuoted}}',
      description: {{#serverDescription}}'{{#lambda.rubyQuoted}}{{{serverDescription}}}{{/lambda.rubyQuoted}}'{{/serverDescription}}{{^serverDescription}}nil{{/serverDescription}},
      variables: {{#hasVariables}}{
{{#serverVariables}}        '{{#lambda.rubyQuoted}}{{{varName}}}{{/lambda.rubyQuoted}}' => ServerVariable.new(
          default_value: '{{#lambda.rubyQuoted}}{{{varDefault}}}{{/lambda.rubyQuoted}}',
          description: {{#varDescription}}'{{#lambda.rubyQuoted}}{{{varDescription}}}{{/lambda.rubyQuoted}}'{{/varDescription}}{{^varDescription}}nil{{/varDescription}},
          enum_values: {{#hasEnumValues}}%w[{{#varEnumValues}}{{{.}}}{{^-last}} {{/-last}}{{/varEnumValues}}]{{/hasEnumValues}}{{^hasEnumValues}}[]{{/hasEnumValues}}
        ){{^-last}},{{/-last}}
{{/serverVariables}}      }{{/hasVariables}}{{^hasVariables}}{}{{/hasVariables}},
      name: {{#serverName}}'{{#lambda.rubyQuoted}}{{{serverName}}}{{/lambda.rubyQuoted}}'{{/serverName}}{{^serverName}}nil{{/serverName}}
    ).freeze

{{/serverConfigs}}
    # All server configurations in declaration order.
    # @return [Array<ServerConfiguration>]
    ALL = [
{{#serverConfigs}}      SERVER_{{serverIndex}}{{^-last}},{{/-last}}
{{/serverConfigs}}    ].freeze

    # The server the specification gives the name +name+ (OpenAPI 3.2 +name+).
    #
    # @param name [String] the server name
    # @return [ServerConfiguration] the server with that name
    # @raise [ArgumentError] if no server has that name; the message lists the known names
    def self.by_name(name)
      found = ALL.find { |server| server.name == name }
      return found if found

      known = ALL.filter_map(&:name)
      raise ArgumentError, "Unknown server name '#{name}'. Known names: [#{known.join(', ')}]"
    end
  end
end
