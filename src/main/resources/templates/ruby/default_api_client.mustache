module {{moduleName}}
  # Default HTTP client implementation backed by Faraday.
  #
  # Applies transport-level settings from {TransportOptions}: TLS
  # verification, custom CA certificates, proxy routing, timeouts, redirect
  # handling, User-Agent injection, X-Request-ID injection, and
  # transport-level default headers.
  #
  # Header merge order (lowest to highest priority):
  # 1. {TransportOptions#default_headers} -- transport-level defaults
  # 2. Caller-provided headers (from BaseApi -- includes config defaults, auth, operation headers)
  # 3. {TransportOptions#user_agent} -- injected if not already set
  # 4. {TransportOptions#inject_request_id} -- injected if not already set
  class DefaultApiClient < ApiClient
    # Bucket 3.1: extra header names stripped on cross-origin redirects in
    # addition to the static +{Authorization, Cookie, Proxy-Authorization}+
    # set. Populated at codegen time from `securitySchemes` entries whose
    # `type` is `apiKey` and `in` is `header`, so a malicious 302 cannot
    # leak the API key to a different host. Entries are already lowercase
    # so the cross-origin filter can compare case-insensitively.
    # The verbs Faraday's run_request accepts.
    STANDARD_METHODS = %i[get post put delete head patch options trace].freeze

    # Statuses worth sending again: request timeout, conflict, rate limit and
    # every server error except 501 (not implemented), which a retry cannot fix.
    RETRYABLE_STATUS_CODES = [408, 409, 429, *((500..599).to_a - [501])].freeze

    # Methods RFC 9110 defines as idempotent, plus QUERY: only these are sent
    # again after a connection failed before any response.
    IDEMPOTENT_METHODS = %w[GET HEAD OPTIONS TRACE PUT DELETE QUERY].freeze

    # The wait before the first retry, in seconds; it doubles up to the cap.
    RETRY_BASE_DELAY_S = 0.5

    # The longest backoff wait, in seconds, before jitter.
    RETRY_MAX_DELAY_S = 8.0

    # The share of a backoff wait that jitter may take off it.
    RETRY_JITTER = 0.25

    # The longest wait a +Retry-After+ header may ask for, in seconds.
    RETRY_AFTER_CAP_S = 60.0

    # The Content-Encoding values a streamed body is decoded from as it
    # arrives; a stream call advertises only these.
    STREAM_ENCODINGS = 'gzip, deflate'

    # The read timeout handed to the HTTP library for a streamed body, in
    # seconds: effectively none, since the wait for the headers and the gap
    # between two reads are bounded by the SDK itself.
    STREAM_READ_TIMEOUT_S = 31_536_000

    private_constant :RETRYABLE_STATUS_CODES, :RETRY_BASE_DELAY_S, :RETRY_MAX_DELAY_S, :RETRY_JITTER, :RETRY_AFTER_CAP_S,
                     :STREAM_ENCODINGS, :STREAM_READ_TIMEOUT_S

    # What a streamed call needs beyond a buffered one: the longest silence in
    # the body, in milliseconds, or nil for none.
    StreamSpec = Struct.new(:idle_ms)
    private_constant :StreamSpec

    # Mixed into the +Net::HTTP+ object of a streamed call. It reports the
    # response head to the producer thread's {StreamBody} the moment the
    # headers are read, so the call returns at the headers even when the first
    # body byte is still to come.
    module HeadSignal
      def request(req, body = nil, &block)
        # A streamed request body has been read once: the library must not send
        # it again of its own accord after a dropped connection.
        send(:max_retries=, 0) if req.body_stream
        sink = Thread.current[StreamBody::SINK_KEY]
        return super unless sink && block

        reporting = proc do |response|
          sink.push_head(response.code.to_i, response.each_header.to_h)
          block.call(response)
        end
        super(req, body, &reporting)
      end
    end
    private_constant :HeadSignal

    EXTRA_SENSITIVE_HEADER_NAMES = %w[{{#apiKeyHeaderNames}} {{nameLower}}{{/apiKeyHeaderNames}}].freeze

    # BaseApi builds the query string itself, with the per-parameter style,
    # explode and allowReserved rules already applied, and hands Faraday the
    # whole URL. Faraday would otherwise decode that query into a Hash and
    # re-encode it, which keeps only the last value of a repeated key, sorts
    # the parameters, and percent-encodes the reserved characters that
    # allowReserved left literal. This encoder carries the query through as one
    # opaque string, so the bytes BaseApi built are the bytes sent. Params that
    # reach Faraday separately still get Faraday's encoding, with the
    # space-derived '+' normalised to %20 (RFC 3986 query component).
    module QueryParamsEncoder
      RAW_QUERY_KEY = '__raw_query__'

      def self.encode(params)
        raw = params[RAW_QUERY_KEY]
        rest = params.reject { |key, _value| key == RAW_QUERY_KEY }
        encoded = rest.empty? ? nil : ::Faraday::NestedParamsEncoder.encode(rest)&.gsub('+', '%20')
        return encoded if raw.nil?

        [raw, encoded].compact.reject(&:empty?).join('&')
      end

      def self.decode(query)
        query.nil? || query.empty? ? {} : { RAW_QUERY_KEY => query }
      end
    end

    # Create a client with default transport settings.
    #
    # Equivalent to +DefaultApiClient.new(TransportOptions.builder.build)+.
    #
    # @overload initialize
    #   Creates a client with default transport settings.
    # @overload initialize(transport_options)
    #   Creates a client configured from the given {TransportOptions}.
    #   @param transport_options [TransportOptions] transport configuration to apply
    def initialize(transport_options = nil)
      super()
      @transport_options = transport_options || TransportOptions.builder.build
      @closed = false
      @in_flight = 0
      @streams = [] #: Array[StreamBody]
      @lock = Mutex.new
      validate_ca_cert_path(@transport_options.ca_cert_path)
    end

    # Send an HTTP request with transport-level settings applied.
    #
    # Merges headers according to the priority order documented on the class,
    # then dispatches via Faraday. A failed request is sent again as
    # {TransportOptions#max_retries} allows: after a network error that
    # happened before any response, and after a 408, 409, 429 or 5xx (not 501)
    # response. The wait is an exponential backoff (0.5 s doubling to 8 s,
    # with 25% jitter) or the +Retry-After+ header (seconds or an HTTP date,
    # at most 60 s). The {TransportOptions#timeout} budget covers the whole
    # call, retries included, so no retry starts once it is spent. A body that
    # cannot be sent twice (a multipart form or a stream) is never retried.
    #
    # @param method [Symbol] HTTP method (:get, :post, :put, :delete, etc.)
    # @param url [String] fully qualified URL
    # @param headers [Hash{String => String}] caller-provided headers
    # @param body [Object, nil] request body
    # @param no_redirect [Boolean] when true, do not follow redirects; the
    #   first 3xx response is returned to the caller as-is. Used by the
    #   OAuth2 token-endpoint POST so credentials in the form body are
    #   never silently replayed to a redirect target — the token manager
    #   inspects and rejects the 3xx itself (Bucket 3.2).
    # @param retry_headers [Proc, nil] returns the complete headers of a retry
    #   (authentication included, so a renewed token is picked up); without it
    #   a retry reuses +headers+
    # @param timeout [Numeric, nil] the end-to-end timeout in milliseconds of
    #   this call alone; when nil the transport's timeout applies
    # @param max_retries [Integer, nil] the retry count of this call alone; when
    #   nil the transport's +max_retries+ applies
    # @param no_default_headers [Boolean] when true, the transport's default
    #   headers are not added. Used for the OAuth2 token and OIDC discovery
    #   requests, which go to the identity provider and must not carry the
    #   credentials meant for the API (F860).
    # @return [ApiHttpResponse] the HTTP response
    def send_request(method, url, headers, body, no_redirect: false, retry_headers: nil, no_default_headers: false,
                     timeout: nil, max_retries: nil)
      validate_header_values!(headers)
      validate_header_values!(@transport_options.default_headers) unless no_default_headers
      enter_request
      begin
        perform_request(method, url, headers, body, no_redirect, retry_headers, no_default_headers, timeout, max_retries)
      ensure
        leave_request
      end
    end

    # Send an HTTP request and return as soon as the response headers are
    # accepted, with the body not read yet.
    #
    # Everything up to the headers is {#send_request}: the same header merge,
    # retries, redirects, token replay and timeout budget, which stops at the
    # headers. The body is then read as the caller consumes it, bounded by
    # +idle_timeout+ alone, and a request is never retried after the first body
    # byte. A compressed body (gzip or deflate) is decoded as it arrives. A
    # non-2xx response is returned like any other, with its body open. The
    # caller owns the returned body and must close it; closing aborts the
    # connection, and {#close} cancels a body that is still open.
    #
    # @param method [Symbol, String] HTTP method
    # @param url [String] fully qualified URL
    # @param headers [Hash{String => String}] caller-provided headers
    # @param body [Object, nil] request body
    # @param no_redirect [Boolean] when true, do not follow redirects
    # @param retry_headers [Proc, nil] returns the complete headers of a retry
    # @param no_default_headers [Boolean] when true, the transport's default headers are not added
    # @param timeout [Numeric, false, nil] the timeout in milliseconds up to the
    #   response headers of this call alone; nil keeps the transport's, false lifts it
    # @param max_retries [Integer, nil] the retry count of this call alone
    # @param idle_timeout [Numeric, nil] the longest silence in the body in
    #   milliseconds, 0 to disable it, or nil for the transport's setting
    # @return [ApiStreamResponse] the status, the lower-cased headers and the open body
    # @raise [Errors::NetworkError] if the request fails before the headers
    def send_streaming(method, url, headers, body, no_redirect: false, retry_headers: nil, no_default_headers: false,
                       timeout: nil, max_retries: nil, idle_timeout: nil)
      validate_header_values!(headers)
      validate_header_values!(@transport_options.default_headers) unless no_default_headers
      idle_ms = idle_timeout.nil? ? @transport_options.idle_timeout : TransportOptions.validate_idle_timeout!(idle_timeout)
      enter_request
      handed_over = false
      begin
        response = perform_stream(method, url, headers, body, no_redirect, retry_headers, no_default_headers, timeout,
                                  max_retries, idle_ms)
        handed_over = true
        response
      ensure
        leave_request unless handed_over
      end
    end

    # Closes the client gracefully. It is marked closed at once, so a request
    # started afterwards raises a RuntimeError; a request already in flight
    # finishes, and the Faraday connection the SDK built is released when the
    # last of them completes (at once when none is running). The default
    # +net_http+ adapter opens a socket per request, so there is no pooled
    # socket to release. It is safe to call this method repeatedly
    # (idempotent): a second call changes nothing.
    #
    # Streams that are still open are cancelled, not waited for: their next
    # read raises the RuntimeError of a closed client.
    #
    # A connection supplied through {TransportOptions::Builder#connection}
    # belongs to the caller and is never closed here.
    def close
      open_streams = [] #: Array[StreamBody]
      release = @lock.synchronize do
        @closed = true
        open_streams.concat(@streams)
        @in_flight.zero?
      end
      open_streams.each(&:cancel)
      release_connection if release
    end

    # Returns the list of supported content encodings.
    # @return [String]
    def self.supported_encodings
      encodings = 'gzip, deflate'
      encodings += ', br' if defined?(Brotli)
      encodings += ', zstd' if defined?(Zstd)
      encodings
    end

    private

    # The body of {#send_request}: one call, every redirect hop and retry
    # included, while the request is counted as in flight.
    def perform_request(method, url, headers, body, no_redirect, retry_headers, no_default_headers, timeout, max_retries)
      # The timeout is one budget for the whole call: every redirect hop and
      # every retry is sent with what is left of it, measured on the monotonic
      # clock.
      # timeout: false lifts the deadline for this call alone; nil keeps the transport's.
      timeout_ms = timeout == false ? nil : (timeout || @transport_options.timeout)
      ms = timeout_ms
      seconds = ms ? ms.to_f / 1000.0 : nil
      deadline = seconds ? (Process.clock_gettime(Process::CLOCK_MONOTONIC) + seconds.to_f).to_f : nil

      response = transmit_with_retries(method, url, headers, body, no_redirect, deadline, retry_headers, no_default_headers,
                                       timeout_ms, max_retries || @transport_options.max_retries)
      content_type = response.headers['content-type'].to_s
      # A malformed Content-Encoding body (a truncated/garbage
      # gzip/deflate/br/zstd payload) arrived with a real response, so it
      # surfaces as an ApiError carrying that response's status rather than
      # a network error or a raw Zlib / decoder exception.
      decoded_body = begin
        decompress_body(response.body, response.headers['content-encoding'])
      rescue StandardError => e
        raise unusable_response(response, "Failed to decompress #{response.headers['content-encoding']} response body: #{e.message}")
      end
      response_body = if text_content_type?(content_type)
                        decode_text_body(decoded_body.to_s, content_type)
                      else
                        Base64.strict_encode64(decoded_body.to_s)
                      end

      # Gap BE+BF: response header keys are normalised to lowercase so
      # callers can look them up consistently regardless of the casing the
      # server used (HTTP header names are case-insensitive per RFC 7230
      # section 3.2, and HTTP/2 mandates lowercase on the wire). Repeated
      # header lines (for example multiple Link or Set-Cookie headers) are
      # joined with ", " to preserve order per RFC 7230 section 3.2.2.
      # Faraday already collapses repeated headers into either a comma-
      # joined string or an array depending on the header; here we
      # normalise both shapes. The joined form is not directly parseable
      # for Set-Cookie; callers needing structured cookie access should
      # use HTTP::Cookie.parse or read the raw Faraday::Utils::Headers.
      normalized_headers = {} #: Hash[String, String]
      response.headers.each do |name, value|
        joined = value.is_a?(Array) ? value.join(', ') : value.to_s
        normalized_headers[name.to_s.downcase] = joined
      end
      # D92: once the body has been decoded, Content-Encoding and Content-Length
      # describe bytes the caller no longer holds, so they are not returned. An
      # identity or empty body keeps both.
      content_encoding = normalized_headers['content-encoding'].to_s.strip.downcase
      unless response.body.to_s.empty? || ['', 'identity'].include?(content_encoding)
        normalized_headers.delete('content-encoding')
        normalized_headers.delete('content-length')
      end

      ApiHttpResponse.new(
        status_code: response.status,
        body: response_body,
        headers: normalized_headers
      )
    end

    # The body of {#send_streaming}: the header phase of a call, then the open
    # stream.
    def perform_stream(method, url, headers, body, no_redirect, retry_headers, no_default_headers, timeout, max_retries,
                       idle_ms)
      timeout_ms = timeout == false ? nil : (timeout || @transport_options.timeout)
      seconds = timeout_ms ? timeout_ms.to_f / 1000.0 : nil
      deadline = seconds ? (Process.clock_gettime(Process::CLOCK_MONOTONIC) + seconds.to_f).to_f : nil

      hop = transmit_with_retries(method, url, headers, body, no_redirect, deadline, retry_headers, no_default_headers,
                                  timeout_ms, max_retries || @transport_options.max_retries, StreamSpec.new(idle_ms))
      open_stream(hop)
    end

    # Turns the response head of the last hop into the stream the caller gets.
    # The client keeps track of it, so {#close} can cancel it.
    def open_stream(hop)
      response_headers = hop.headers || {} #: Hash[String, String]
      encoding = response_headers['content-encoding'].to_s.strip.downcase
      unless ['', 'identity'].include?(encoding)
        unless %w[gzip x-gzip deflate].include?(encoding)
          raise unusable_response(hop, "Failed to decompress #{encoding} response body: Unsupported Content-Encoding '#{encoding}'")
        end

        # D92: once the body is decoded, Content-Encoding and Content-Length
        # describe bytes the caller no longer holds, so they are not returned.
        hop.decode_with(encoding)
        response_headers = response_headers.except('content-encoding', 'content-length')
      end
      register_stream(hop)
      ApiStreamResponse.new(status_code: hop.status.to_i, headers: response_headers, body: hop)
    end

    # Starts tracking an open stream, or refuses it when the client was closed
    # while the request was in flight.
    def register_stream(hop)
      registered = @lock.synchronize do
        @streams << hop unless @closed
        !@closed
      end
      unless registered
        hop.close
        raise StreamBody::CLOSED_MESSAGE
      end

      hop.on_release do |body|
        @lock.synchronize { @streams.delete(body) }
        leave_request
      end
    end

    # Aborts the connection of a hop whose response is not going to be used (a
    # redirect, a retried failure, a refused response). A buffered response has
    # nothing left to release.
    def abort_hop(response)
      response.close if response.is_a?(StreamBody)
    end

    # Counts a request as in flight, or refuses it when the client is closed.
    #
    # Using the client after #close is a caller error. Surface it loudly as a
    # RuntimeError (the invalid-state error) instead of lazily rebuilding a
    # connection (which would make close a silent no-op), matching the other
    # SDKs.
    def enter_request
      @lock.synchronize do
        raise 'ApiClient has been closed and can no longer send requests' if @closed

        @in_flight += 1
      end
    end

    # Ends one in-flight request; the last one out of a closed client releases
    # the connection.
    def leave_request
      release = @lock.synchronize do
        @in_flight -= 1
        @closed && @in_flight.zero?
      end
      release_connection if release
    end

    # Drops the Faraday connection this client built. A connection supplied
    # through {TransportOptions::Builder#connection} is the caller's and is
    # never closed here.
    def release_connection
      conn = @lock.synchronize do
        built = @connection
        @connection = nil
        built
      end
      conn.close if conn.respond_to?(:close)
    end

    # One attempt: merge the headers, send the request (following redirects)
    # and return the Faraday response, or raise the SDK's network error.
    def transmit(method, url, headers, body, no_redirect, deadline, no_default_headers, timeout_ms, stream = nil)
      # Field names are case-insensitive (RFC 9110 section 5.1): a caller's
      # header replaces a default of the same name whatever its casing.
      # @type var defaults: Hash[String, String]
      defaults = no_default_headers ? {} : @transport_options.default_headers
      merged = defaults.reject { |name, _v| header?(headers, name.to_s) }.merge(headers)
      # RFC 9110 §5.1: field names are case-insensitive, so a caller's
      # `user-agent` or `x-request-id` (any casing, even empty) wins and
      # nothing is injected alongside it.
      user_agent = @transport_options.user_agent
      merged['User-Agent'] = user_agent if user_agent && !header?(merged, 'User-Agent')
      merged['X-Request-ID'] = SecureRandom.uuid if @transport_options.inject_request_id && !header?(merged, 'X-Request-ID')

      if body.is_a?(Hash)
        boundary = SecureRandom.uuid
        # A multipart type the caller declared (multipart/related, say) keeps its subtype.
        declared = (merged.find { |name, _value| name.to_s.casecmp?('Content-Type') } || [nil, ''])[1].to_s
        subtype = declared.split(';').first.to_s.strip
        subtype = 'multipart/form-data' unless subtype.match?(%r{\Amultipart/[#A-Za-z0-9!$&^_.+-]+\z})
        merged.delete_if { |name, _value| name.to_s.casecmp?('Content-Type') }
        merged['Content-Type'] = "#{subtype}; boundary=#{boundary}"
        serialized_body = build_multipart_body(body, boundary)
      elsif body.nil?
        merged.delete_if { |name, _value| name.to_s.casecmp?('Content-Type') }
        serialized_body = nil
        # Some servers / WAFs treat POST/PUT/PATCH with no body and no
        # Content-Length as malformed (411 Length Required) or behave
        # inconsistently. Send an empty-string body on body-bearing
        # verbs so Faraday/Net::HTTP emit an explicit
        # `Content-Length: 0`, matching Kotlin's `ByteArray(0)` and the
        # other 11 SDKs.
        upper = method.to_s.upcase
        if %w[POST PUT PATCH].include?(upper)
          serialized_body = ''
          merged['Content-Length'] ||= '0'
        end
      else
        serialized_body = body
        merged['Content-Type'] = 'application/json' unless header?(merged, 'Content-Type')
      end

      # Field names are case-insensitive: a caller's accept-encoding in any casing
      # suppresses the SDK's own, so the two never go out as duplicate headers.
      merged['Accept-Encoding'] = (stream ? STREAM_ENCODINGS : self.class.supported_encodings) unless header?(merged, 'Accept-Encoding')

      begin
        response = run_hop(method.downcase.to_sym, url, serialized_body, merged, deadline, timeout_ms, stream)
        # Gap BH: Faraday's follow_redirects middleware re-sends Authorization /
        # Cookie / Proxy-Authorization across cross-origin 3xx redirects by
        # default, which leaks bearer tokens to attacker-controlled hosts via
        # malicious 302. We disable the middleware in build_connection and
        # follow Location: headers manually here, stripping the sensitive
        # headers when the next URL's origin (scheme + host + port) differs
        # from the original.
        # Bucket 3.2: `no_redirect: true` (the OAuth2 token endpoint POST
        # does this) means "do not follow redirects; return the 3xx as-is".
        # The redirect loop is skipped and the first 3xx surfaces to the
        # caller verbatim. The OAuth2 token manager inspects and rejects the
        # 3xx itself, so a credential-bearing body is never silently
        # replayed to a redirect target.
        if @transport_options.follow_redirects && !no_redirect
          max_redirects = @transport_options.max_redirects || 20
          original_url = url
          hops = 0
          current_method = method
          current_body = serialized_body
          current_headers = merged.dup
          while hops < max_redirects && redirect_status?(response.status)
            location = response.headers['location']
            break if location.nil? || location.empty?

            next_url = resolve_url(url, location)
            break if next_url.nil?

            next_uri = safe_parse_uri(next_url)
            # Bucket 3: a Location header pointing at a non-http(s) scheme
            # (file:, javascript:, data:, ...) is an SSRF / local-file
            # exfiltration vector. Refuse loudly with an ApiError carrying the
            # 3xx status instead of silently returning the 3xx response,
            # matching the other SDKs.
            if next_uri.nil? || !%w[http https].include?(next_uri.scheme)
              raise unusable_response(response, "Refusing to follow redirect to non-HTTP(S) URL: #{next_url}")
            end

            cross_origin = !same_origin?(original_url, next_url)

            # Gap T3: pick follow-up method+body per RFC 9110 section 15.4.
            #   307 + 308: preserve original method and body.
            #   303:       every method except HEAD becomes GET, body dropped.
            #   301 + 302: only POST becomes GET, body dropped; any other
            #              method keeps its method and body.
            status_code = response.status.to_i
            method_str = current_method.to_s.upcase
            rewrite_to_get = case status_code
                             when 303 then !%w[GET HEAD].include?(method_str)
                             when 301, 302 then method_str == 'POST'
                             else false
                             end
            if rewrite_to_get
              next_method = :get
              next_body = nil
            else
              next_method = current_method
              next_body = current_body
            end

            # A single use body was read to its end by the request that was just
            # answered, so there is nothing to send again, and it is never
            # buffered to make that possible.
            if !rewrite_to_get && !replayable_body?(next_body)
              raise unusable_response(response, 'Refusing to replay a streamed request body')
            end

            # Bucket 3.3: an HTTPS -> HTTP redirect is a TLS downgrade. If
            # the follow-up request still carries a body (the 307/308
            # path, or the GET/HEAD same-method path), replaying it over
            # cleartext would leak sensitive form data the application
            # sent under TLS. Refuse the downgrade only when there is
            # actually a body to replay — a demotion to GET
            # drops the body and is allowed. The empty body substituted for a
            # bodyless POST/PUT/PATCH (the Content-Length: 0 workaround above)
            # is not a body either, so it is followed like the other SDKs do.
            # misc124: a 301 or 302 is refused across the downgrade whenever the
            # original request carried a body, even though the follow-up drops it.
            replays_body = !rewrite_to_get && !next_body.nil? && !next_body.to_s.empty?
            body_sent = !current_body.nil? && !current_body.to_s.empty?
            refuses_body = [301, 302].include?(status_code) ? body_sent : replays_body
            if refuses_body && https_to_http_downgrade?(url, next_url)
              raise unusable_response(response, 'Refusing to replay request body across HTTPS->HTTP ' \
                                                "redirect: #{url} -> #{next_url}")
            end

            redirect_headers = current_headers.dup
            if cross_origin
              # Bucket 3.1: in addition to the static
              # {authorization, cookie, proxy-authorization} set, strip
              # any `apiKey, in=header` names harvested from the OpenAPI
              # document at codegen time. Without this an `X-Api-Key`
              # header would otherwise be silently replayed to an
              # attacker-controlled host on a malicious 302.
              # Credentials that arrive through default headers or an
              # authenticator carry arbitrary names, so the redaction list
              # (auth, key, token, secret) and every default header are stripped too.
              default_names = @transport_options.default_headers.keys.map { |n| n.to_s.downcase }
              redirect_headers.delete_if do |k, _v|
                lower = k.to_s.downcase
                %w[authorization cookie proxy-authorization].include?(lower) ||
                  EXTRA_SENSITIVE_HEADER_NAMES.include?(lower) ||
                  default_names.include?(lower) ||
                  lower.include?('auth') ||
                  TransportOptions.sensitive_header?(lower)
              end
            end
            if next_body.nil?
              redirect_headers.delete_if do |k, _v|
                %w[content-type content-length].include?(k.to_s.downcase)
              end
            end
            url = next_url
            current_method = next_method
            current_body = next_body
            current_headers = redirect_headers
            abort_hop(response)
            response = run_hop(next_method.to_s.downcase.to_sym, next_url, next_body, redirect_headers, deadline, timeout_ms,
                               stream)
            hops += 1
          end
          # Bucket 3: if we exhausted the redirect budget while the server is
          # still returning a 3xx, the request never reached a final
          # resource. Surface this loudly as an ApiError instead of silently
          # returning the last redirect response as if it were the answer,
          # matching the other SDKs. A 3xx with no usable Location breaks out of
          # the loop early and is a legitimate terminal response, so the budget
          # check is gated on the hop count.
          if hops >= max_redirects && redirect_status?(response.status) && !response.headers['location'].to_s.empty?
            raise unusable_response(response, "Too many redirects (exceeded #{max_redirects})")
          end
        end
      rescue Faraday::TimeoutError, Faraday::ConnectionFailed, Faraday::SSLError => e
        raise network_error_class(e).new(message: redact_url_text(e.message))
      rescue URI::InvalidURIError => e
        raise ArgumentError, "Invalid request URL (#{e.message}): #{url}"
      end
      response
    end

    # Send the request, and send it again after a failure that is worth
    # another try, as far as +max_retries+, the body and the deadline allow.
    # The last failure is what the caller gets.
    def transmit_with_retries(method, url, headers, body, no_redirect, deadline, retry_headers, no_default_headers, timeout_ms, call_max_retries,
                              stream = nil)
      max_retries = replayable_body?(body) ? call_max_retries : 0
      attempt = 0
      current_headers = headers
      loop do
        # @type var failure: Errors::NetworkError?
        failure = nil
        # @type var response: untyped
        response = nil
        begin
          response = transmit(method, url, current_headers, body, no_redirect, deadline, no_default_headers, timeout_ms, stream)
          return response unless attempt < max_retries && RETRYABLE_STATUS_CODES.include?(response.status.to_i)
        rescue Errors::NetworkError => e
          raise unless attempt < max_retries && retryable_network_error?(e) &&
                       IDEMPOTENT_METHODS.include?(method.to_s.upcase)

          failure = e
        end
        delay = retry_delay(attempt, response)
        # No retry may start once the budget would be spent by the wait.
        out_of_time = deadline && (Process.clock_gettime(Process::CLOCK_MONOTONIC) + delay) >= deadline
        return give_up(failure, response) if out_of_time

        if retry_headers
          renewed = renewed_headers(retry_headers)
          return give_up(failure, response) if renewed.nil?

          current_headers = renewed
        end
        abort_hop(response)
        pause(delay)
        attempt += 1
      end
    end

    # End the retrying: raise the last network failure, or hand back the last
    # response when there was one.
    def give_up(failure, response)
      raise failure if failure

      response
    end

    # Whether a failed attempt may be tried again. A TLS failure is a setup
    # problem (an untrusted or mismatched certificate) that another try cannot
    # fix. A timeout has already spent the caller's time budget on the attempt,
    # so it is reported at once, as in the other SDKs.
    def retryable_network_error?(error)
      return false if error.is_a?(Errors::NetworkTimeoutError)

      !tls_failure?(error)
    end

    # Whether an error, or any error it wraps or was raised from, is an OpenSSL
    # or Faraday SSL error (misc170).
    def tls_failure?(error)
      seen = error
      while seen
        return true if seen.is_a?(OpenSSL::SSL::SSLError) || seen.is_a?(Faraday::SSLError)

        wrapped = seen.respond_to?(:wrapped_exception) ? seen.wrapped_exception : nil
        seen = wrapped || seen.cause
      end
      false
    end

    # The headers of a retry, or +nil+ when they cannot be built (a failed
    # re-authentication), which ends the retrying.
    def renewed_headers(retry_headers)
      retry_headers.call
    rescue {{apiErrorParent}}
      nil
    end

    # Whether a request body can be sent a second time: none, a string, or a
    # replayable body source.
    def replayable_body?(body)
      return body.replayable? if body.is_a?(BodySource)

      body.nil? || body.is_a?(String)
    end

    # The seconds to wait before retry number +attempt+ + 1: the +Retry-After+
    # header of +response+ when it carries a usable one, else an exponential
    # backoff with jitter.
    def retry_delay(attempt, response)
      asked = response && retry_after(response.headers)
      return asked if asked

      backoff = [RETRY_BASE_DELAY_S * (2**attempt), RETRY_MAX_DELAY_S].min
      backoff * (1.0 - (RETRY_JITTER * rand))
    end

    # The wait a +Retry-After+ header asks for (delta-seconds or an HTTP date),
    # capped, or +nil+ when there is none or it cannot be read.
    def retry_after(headers)
      pair = headers.find { |name, _value| name.to_s.casecmp?('retry-after') }
      return nil unless pair

      text = pair.last.to_s.strip
      seconds = if text.match?(/\A\d+(?:\.\d+)?\z/)
                  text.to_f
                else
                  http_date_wait(text)
                end
      seconds&.clamp(0.0, RETRY_AFTER_CAP_S)
    end

    # Seconds from now until the HTTP date +text+ (negative once it is past),
    # or +nil+ when +text+ is not an HTTP date.
    def http_date_wait(text)
      Time.httpdate(text) - Time.now
    rescue ArgumentError
      nil
    end

    # Wait +seconds+ between two attempts.
    def pause(seconds)
      sleep(seconds)
    end

    # Send one hop of a call. With a +deadline+ (a monotonic clock reading)
    # the hop's connect, write and read timeouts are what remains of the
    # call's budget, and a hop is never started once the budget is spent.
    def run_hop(method, url, body, headers, deadline, timeout_ms, stream = nil)
      return open_hop(method, url, body, headers, deadline, timeout_ms, stream) if stream

      if deadline.nil?
        return dispatch(method, url, body, headers) unless @transport_options.connection

        return dispatch(method, url, body, headers) do |request|
          request.options.params_encoder = QueryParamsEncoder
        end
      end

      remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
      if remaining <= 0
        raise Errors::NetworkTimeoutError.new(message: "Request timed out after #{timeout_ms} ms")
      end

      dispatch(method, url, body, headers) do |request|
        # A supplied connection has its own encoder; the request-level one keeps
        # the query exactly as BaseApi built it.
        request.options.params_encoder = QueryParamsEncoder if @transport_options.connection
        request.options.timeout = remaining
        request.options.open_timeout = remaining
        request.options.write_timeout = remaining
      end
    end

    # Send one hop of a streamed call: the request runs on a producer thread
    # and this returns, with the status and headers, as soon as they arrive.
    # Only the wait for them is bounded by the call's budget.
    def open_hop(method, url, body, headers, deadline, timeout_ms, stream)
      remaining = deadline ? deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC) : nil
      raise Errors::NetworkTimeoutError.new(message: "Request timed out after #{timeout_ms} ms") if remaining && remaining <= 0

      hop = StreamBody.new(method: method.to_s.upcase, url: url, idle_ms: stream.idle_ms)
      hop.start do |sink|
        response = dispatch(method, url, body, headers) do |request|
          request.options.params_encoder = QueryParamsEncoder if @transport_options.connection
          request.options.timeout = STREAM_READ_TIMEOUT_S
          if remaining
            request.options.open_timeout = remaining
            request.options.write_timeout = remaining
          end
          request.options.on_data = proc do |chunk, _size, env|
            sink.push_head(env.status, env.response_headers)
            sink.push_data(chunk)
          end
        end
        # A connection that does not stream hands the whole response back here.
        sink.push_head(response.status, response.headers)
        sink.push_data(response.body) if response.body.is_a?(String)
      end
      hop.await_head(remaining) || raise(Errors::NetworkTimeoutError.new(message: "Request timed out after #{timeout_ms} ms"))
    end

    # Faraday's +run_request+ refuses any verb outside its eight fixed ones,
    # so QUERY and other custom methods go through the same request build and
    # middleware stack below it.
    def dispatch(method, url, body, headers, &)
      return dispatch_wire(method, url, body, headers, &) unless body.is_a?(BodySource)

      # A body source is opened for this one send and read as it goes out: a
      # known length is a Content-Length, an unknown one is chunked. What the
      # SDK opened is closed when the send is over, and the caller's own
      # stream never is.
      opened = nil
      begin
        wire, framing = wire_body(body)
        opened = wire unless wire.is_a?(String)
        sent = headers.reject { |name, _value| %w[content-length transfer-encoding].include?(name.to_s.downcase) }
        dispatch_wire(method, url, wire, sent.merge(framing), &)
      ensure
        body.release(opened)
      end
    end

    # What goes to the HTTP library for a body source, and the headers that frame it.
    def wire_body(source)
      bytes = source.bytes
      return [bytes, {}] if bytes

      length = source.length
      return ['', { 'Content-Length' => '0' }] if length&.zero?

      [source.open, length ? { 'Content-Length' => length.to_s } : { 'Transfer-Encoding' => 'chunked' }]
    end

    def dispatch_wire(method, url, body, headers, &block)
      conn = connection
      return conn.run_request(method, url, body, headers, &block) if STANDARD_METHODS.include?(method)

      request = conn.build_request(method) do |req|
        req.url(url) if url
        req.headers.update(headers) if headers
        req.body = body if body
        block&.call(req)
      end
      conn.builder.build_response(conn, request)
    end

    # Refuses a header whose value holds a carriage return or line feed, before
    # anything is sent, so a value cannot split the request. The message names
    # the header and never echoes its value.
    #
    # @raise [ArgumentError] if a value contains CR or LF
    def validate_header_values!(headers)
      headers.each do |name, value|
        next unless value.to_s.match?(/[\r\n\0]/)

        raise ArgumentError, "Header #{name} value must not contain a carriage return, line feed or NUL byte"
      end
    end

    # +text+ with every URL in it reduced to scheme, host, port and path: the
    # userinfo, query string and fragment are dropped, so a failure message
    # never carries credentials or query parameters from the request URL.
    #
    # @param text [String, nil] a message that may quote a URL
    # @return [String]
    def redact_url_text(text)
      text.to_s.gsub(%r{([A-Za-z][A-Za-z0-9+.-]*://)(?:[^\s/?#@]*@)?([^\s?#]*)(?:\?[^\s#]*)?(?:#\S*)?}) { "#{Regexp.last_match(1)}#{Regexp.last_match(2)}" }
    end

    # Whether +headers+ already holds +name+ under ASCII case-folding.
    def header?(headers, name)
      headers.keys.any? { |key| key.to_s.casecmp?(name) }
    end

    # Faraday's net_http adapter reports a connect timeout (Net::OpenTimeout)
    # as Faraday::ConnectionFailed, so the underlying cause decides whether a
    # connection failure is really a timeout.
    def network_error_class(error)
      return Errors::NetworkTimeoutError if error.is_a?(Faraday::TimeoutError)

      cause = error.cause
      return Errors::NetworkTimeoutError if cause.is_a?(Timeout::Error) || cause.is_a?(Errno::ETIMEDOUT)

      Errors::NetworkError
    end

    # Bucket T4: fail fast on a user-supplied CA cert that cannot be read or
    # parsed rather than silently falling back to the system trust store. If
    # the caller explicitly asked for SSL pinning we must not pretend it
    # succeeded -- validate the PEM eagerly at construction.
    def validate_ca_cert_path(ca_cert_path)
      return if ca_cert_path.nil?

      begin
        pem = File.read(ca_cert_path)
      rescue SystemCallError => e
        raise ArgumentError, %(failed to read CA certificate from "#{ca_cert_path}": #{e.message})
      end

      begin
        OpenSSL::X509::Certificate.new(pem)
      rescue OpenSSL::X509::CertificateError => e
        raise ArgumentError,
              %(failed to parse CA certificate from "#{ca_cert_path}": no PEM blocks found or unparseable: #{e.message})
      end
    end

    def text_content_type?(content_type)
      media_type = content_type.split(';').first.to_s.strip.downcase
      return true if media_type.empty?
      return true if media_type.start_with?('text/')

      %w[application/json application/xml application/javascript].include?(media_type) ||
        media_type.end_with?('+json') ||
        media_type.end_with?('+xml')
    end

    # Decode a textual response body using the charset advertised in the
    # +Content-Type+ header, falling back to UTF-8 when the charset is
    # absent or unknown.
    #
    # @param body [String] raw response body bytes
    # @param content_type [String] the response +Content-Type+ header value
    # @return [String] the decoded body as a UTF-8 string
    def decode_text_body(body, content_type)
      encoding = detect_encoding(content_type)
      # RFC 2781: a UTF-16 stream with no byte-order mark defaults to
      # big-endian. Ruby's +Encoding::UTF_16+ is BOM-driven — fed BOM-less
      # bytes it cannot determine endianness and decodes to replacement
      # characters. So for a bare +utf-16+ / +utf16+ charset we inspect the
      # body: if it carries a BOM (FE FF or FF FE) we keep +UTF_16+ so the
      # BOM is honored; otherwise we force +UTF_16BE+ per RFC 2781.
      if encoding == Encoding::UTF_16 && !utf16_bom?(body)
        encoding = Encoding::UTF_16BE
      end
      bytes = body.dup.force_encoding(encoding)
      bytes.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
    rescue EncodingError
      body.dup.force_encoding(Encoding::UTF_8)
    end

    # Return true when the raw body begins with a UTF-16 byte-order mark
    # (big-endian +FE FF+ or little-endian +FF FE+). Used to decide whether a
    # bare +utf-16+ charset should defer to the BOM (when present) or default
    # to big-endian per RFC 2781 (when absent).
    def utf16_bom?(body)
      head = body.to_s.b
      return false if head.bytesize < 2

      first_two = head.byteslice(0, 2)
      first_two == "\xFE\xFF".b || first_two == "\xFF\xFE".b
    end

    # Parse the +charset=...+ parameter from a Content-Type header value
    # and resolve it to a Ruby +Encoding+ instance. Defaults to UTF-8 when
    # no charset is provided or the charset is not recognised.
    #
    # @param content_type [String] the +Content-Type+ header value
    # @return [Encoding] the resolved character encoding
    def detect_encoding(content_type)
      return Encoding::UTF_8 if content_type.nil?

      match = content_type.match(/(?:\A|;)\s*charset\s*=\s*"?([^";\s]+)"?/i)
      return Encoding::UTF_8 if match.nil?

      charset = match[1].to_s
      return Encoding::UTF_8 if charset.empty?

      Encoding.find(charset) || Encoding::UTF_8
    rescue ArgumentError
      Encoding::UTF_8
    end

    # A response arrived but cannot be used (a refused redirect, an
    # undecodable body): an ApiError carrying the response's real status.
    #
    # @return [Errors::ApiError]
    def unusable_response(response, message)
      abort_hop(response)
      Errors::ApiError.new(
        status_code: response.status.to_i,
        message: message,
        response_headers: response.headers.to_h
      )
    end

    def decompress_body(body, encoding)
      return body if body.nil? || body.empty?

      case encoding&.downcase
      when 'gzip', 'x-gzip'
        Zlib::GzipReader.new(StringIO.new(body)).read
      when 'deflate'
        Zlib::Inflate.inflate(body)
      when 'br'
        defined?(Brotli) ? Brotli.inflate(body) : raise('Received a br-encoded response but the br gem is unavailable')
      when 'zstd'
        defined?(Zstd) ? Zstd.decompress(body) : raise('Received a zstd-encoded response but the zstd gem is unavailable')
      when nil, '', 'identity'
        body
      else
        # An unrecognised (or multi-value) Content-Encoding is a response the
        # client cannot honour. Raise — the caller rescues this into an ApiError
        # carrying the response status (matching csharp/elixir and the documented
        # contract) rather than returning the body still encoded.
        raise "Unsupported Content-Encoding '#{encoding}'"
      end
    end

    # Returns the cached Faraday connection, building it on first use.
    # The connection is built once per ApiClient instance; the build step is
    # delegated to {#build_connection} so tests can stub it per-instance.
    def connection
      supplied = @transport_options.connection
      return supplied if supplied

      @connection ||= build_connection
    end

    def build_connection
      Faraday.new do |f|
        # Send the query BaseApi built unchanged. See {QueryParamsEncoder}.
        f.options.params_encoder = QueryParamsEncoder
        # TransportOptions#proxy is the only proxy source. Assigning it even
        # when nil marks the proxy as set by hand, so Faraday never reads
        # http_proxy / https_proxy / no_proxy and the adapter opens a direct
        # connection.
        f.proxy = proxy_settings(@transport_options.proxy)
        f.ssl.verify = @transport_options.verify_ssl
        if @transport_options.ca_cert_path
          f.ssl.ca_file = @transport_options.ca_cert_path
          # faraday-net_http seeds an unset store with the system roots, which
          # would trust public CAs alongside the configured one. An empty store
          # leaves ca_file as the only trust anchor, as in the other SDKs.
          f.ssl.cert_store = OpenSSL::X509::Store.new
        end

        if @transport_options.timeout
          # The one deadline is applied to every phase Faraday times
          # separately -- connect, read and write. Each raises a different
          # error, and all three classify as NetworkTimeoutError; the write
          # deadline is set here rather than left to Faraday's fallback so
          # the three are visibly the same budget.
          timeout_secs = @transport_options.timeout / 1000.0
          f.options.timeout = timeout_secs
          f.options.open_timeout = timeout_secs
          f.options.write_timeout = timeout_secs
        end

        # A body that ends before its Content-Length is a failed transfer, not a
        # short 200: Net::HTTP ignores the early EOF unless told otherwise.
        f.adapter :net_http do |http|
          http.ignore_eof = false
          http.extend(HeadSignal)
        end

        # Gap BH: do not register the Faraday follow_redirects middleware
        # here -- it carries Authorization across cross-origin 3xx, leaking
        # bearer tokens. We follow redirects ourselves in send_request with
        # a same-origin check.
      end
    end

    # The proxy handed to Faraday. Faraday decodes the userinfo of a proxy URL
    # with CGI.unescape, which turns a literal + into a space, so the user name
    # and password are percent-decoded here (RFC 3986 only, keeping +) and
    # passed to Faraday as explicit credentials.
    #
    # @param proxy [String, nil] the proxy URL from TransportOptions
    # @return [String, Hash, nil] the proxy for Faraday
    def proxy_settings(proxy)
      return proxy if proxy.nil?

      uri = URI.parse(proxy)
      return proxy if uri.userinfo.nil?

      raw_password = uri.password
      password = raw_password.nil? ? nil : URI.decode_uri_component(raw_password)
      { uri: uri, user: URI.decode_uri_component(uri.user.to_s), password: password }
    end

    # Return true for HTTP 3xx redirect status codes that carry a Location header.
    def redirect_status?(code)
      [301, 302, 303, 307, 308].include?(code.to_i)
    end

    # Resolve a (possibly relative) Location header value against the previous URL.
    def resolve_url(base, location)
      URI.join(base, location).to_s
    rescue StandardError
      nil
    end

    # Safely parse a URL, returning nil on invalid input.
    def safe_parse_uri(url)
      URI.parse(url)
    rescue StandardError
      nil
    end

    # Compare two URLs by scheme + host + effective port. Use to_s to coerce
    # nil components to "" — keeps cyclomatic complexity below rubocop's
    # default threshold (avoids relying on the global Metrics/CyclomaticComplexity
    # disable, which has proven unreliable inside the CI rubocop docker image).
    def same_origin?(url_a, url_b)
      uri_a = safe_parse_uri(url_a)
      uri_b = safe_parse_uri(url_b)
      return false if uri_a.nil? || uri_b.nil?
      return false unless uri_a.scheme.to_s.downcase == uri_b.scheme.to_s.downcase
      return false unless uri_a.host.to_s.downcase == uri_b.host.to_s.downcase

      effective_port(uri_a) == effective_port(uri_b)
    end

    # Return the URI's explicit port or the default port for its scheme.
    def effective_port(uri)
      uri.port || (uri.scheme == 'https' ? 443 : 80)
    end

    # Bucket 3.3: returns true when +url_a+ is an https URL and +url_b+ is
    # a plain http URL — i.e. a TLS downgrade. Used by the redirect loop
    # to refuse replaying a non-nil request body across the downgrade.
    def https_to_http_downgrade?(url_a, url_b)
      uri_a = safe_parse_uri(url_a)
      uri_b = safe_parse_uri(url_b)
      return false if uri_a.nil? || uri_b.nil?

      uri_a.scheme.to_s.downcase == 'https' && uri_b.scheme.to_s.downcase == 'http'
    end

    def build_multipart_body(form_parts, boundary)
      # @type var parts: Array[String]
      parts = []
      form_parts.each do |name, value|
        if value.is_a?(Array)
          value.each { |item| parts << multipart_part(name, item, boundary).b }
        else
          parts << multipart_part(name, value, boundary).b
        end
      end
      parts.push("--#{boundary}--\r\n".b)
      parts.join
    end

    def multipart_part(name, value, boundary)
      safe_name = sanitize_multipart_field_name(name)
      if value.respond_to?(:read)
        filename = if value.respond_to?(:path) && value.path
                     File.basename(value.path.to_s)
                   else
                     name.to_s
                   end
        # The caller owns the stream: it is read here, never closed.
        data = value.read
        disposition = build_content_disposition(safe_name, filename)
        part_mime = sniff_part_mime(filename)
        header = "--#{boundary}\r\n#{disposition}\r\n" \
                 "Content-Type: #{part_mime}\r\n\r\n"
        header.b + data.b + "\r\n".b
      elsif value.respond_to?(:to_hash)
        # Route the model part through the configured ObjectSerializer
        # rather than JSON.generate(value.to_hash). Dry::Struct#to_hash
        # yields snake_case attribute names (is_enabled/recorded_at) and raw
        # Time/Date/Duration/byte values, so a naive generate would emit
        # the wrong wire keys and unformatted date-times. ObjectSerializer
        # walks ATTRIBUTE_MAP + OPENAPI_FORMATS to produce the same wire
        # keys (isEnabled/recordedAt) and formatting as the JSON-body path.
        json_str = ObjectSerializer.serialize(value)
        "--#{boundary}\r\nContent-Disposition: form-data; name=\"#{safe_name}\"\r\n" \
          "Content-Type: application/json\r\n\r\n#{json_str}\r\n"
      else
        # A primitive is a plain text part (no part Content-Type) carrying
        # the canonical stringify form, the same one query and form values use.
        text = ObjectSerializer.stringify(value)
        "--#{boundary}\r\nContent-Disposition: form-data; name=\"#{safe_name}\"\r\n\r\n#{text}\r\n"
      end
    end

    # Gap W2: validate and escape a multipart form field name before
    # interpolating it into a Content-Disposition header. Rejects CR/LF/NUL
    # (header-injection) and backslash-escapes embedded quotes and
    # backslashes so a malicious field name cannot break out of the
    # +name="..."+ parameter.
    def sanitize_multipart_field_name(name)
      str = name.to_s
      if str.match?(/[\r\n\0]/)
        raise ArgumentError,
              "multipart field name must not contain CR, LF, or NUL bytes: #{str.inspect}"
      end
      str.gsub(/([\\"])/) { |c| "\\#{c}" }
    end

    # Build a Content-Disposition header value for a multipart file part.
    #
    # Rejects filenames containing CR, LF, or NUL to prevent header injection.
    # An ASCII-only filename is sent as +filename="..."+ with quotes and
    # backslashes escaped. Any other filename gets an ASCII fallback in which
    # each non-ASCII or control character becomes one +_+, followed by an
    # RFC 5987 +filename*+ that percent-encodes every UTF-8 byte outside the
    # RFC 3986 unreserved set (A-Z a-z 0-9 - . _ ~).
    #
    # @param name [String, Symbol] form field name
    # @param filename [String] proposed filename
    # @return [String] the Content-Disposition header value
    # @raise [ArgumentError] if +filename+ contains CR, LF, or NUL
    def build_content_disposition(name, filename)
      fname = filename.to_s
      if fname.match?(/[\r\n\0]/)
        raise ArgumentError,
              "multipart filename must not contain CR, LF, or NUL bytes: #{fname.inspect}"
      end

      text = fname.dup.force_encoding(Encoding::UTF_8)
      text = text.scrub("\uFFFD") unless text.valid_encoding?
      base = %(Content-Disposition: form-data; name="#{name}"; )
      return base + %(filename="#{escape_quoted(text)}") if text.ascii_only?

      fallback = text.each_char.map { |c| c.ord < 0x20 || c.ord > 0x7E ? '_' : c }.join
      base + %(filename="#{escape_quoted(fallback)}"; filename*=UTF-8''#{rfc5987_encode(text)})
    end

    # Backslash-escape the quotes and backslashes of a quoted-string value.
    def escape_quoted(value)
      value.gsub(/([\\"])/) { |c| "\\#{c}" }
    end

    # Percent-encode every byte of +value+ outside the RFC 3986 unreserved
    # set, the value-chars production of RFC 5987 section 3.2.1.
    def rfc5987_encode(value)
      value.b.each_byte.map do |byte|
        char = byte.chr
        char.match?(/\A[A-Za-z0-9\-._~]\z/) ? char : format('%%%02X', byte)
      end.join
    end

    # Map a filename to a Content-Type by extension.
    #
    # Uses the +mime-types+ gem if available; otherwise falls back to a small
    # built-in lookup table. Returns +application/octet-stream+ when no
    # mapping is found.
    #
    # @param filename [String] the filename to inspect
    # @return [String] the resolved MIME type
    def sniff_part_mime(filename)
      fname = filename.to_s
      if defined?(MIME::Types)
        types = MIME::Types.type_for(fname)
        return types.first.to_s unless types.empty?
      end
      ext = File.extname(fname).downcase
      case ext
      when '.png' then 'image/png'
      when '.jpg', '.jpeg' then 'image/jpeg'
      when '.gif' then 'image/gif'
      when '.pdf' then 'application/pdf'
      when '.json' then 'application/json'
      else 'application/octet-stream'
      end
    end
  end
end
