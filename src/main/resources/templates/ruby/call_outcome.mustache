# frozen_string_literal: true

{{>api_info}}

module {{moduleName}}
  # How a call ended, as a {CallObserver} is told in +finish+. It is a frozen
  # value.
  #
  # +status_code+ is 0 when no response arrived. +headers+ is the read-only
  # map of lower-cased response header names and is +nil+ when no response
  # arrived, never an empty map. +error+ is the very error object the caller
  # receives, or +nil+ on success.
  #
  # @!attribute [r] status_code
  #   @return [Integer]
  # @!attribute [r] headers
  #   @return [Hash{String => String}, nil]
  # @!attribute [r] error
  #   @return [Exception, nil]
  CallOutcome = Data.define(:status_code, :headers, :error)
end
