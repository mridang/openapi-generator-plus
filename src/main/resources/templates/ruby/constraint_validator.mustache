  module ConstraintValidator
{{#hasConstraintModels}}
    # Compiles a schema pattern, or returns +nil+ when Ruby's engine cannot
    # compile it, in which case the pattern is not enforced.
    # @param source [String] the pattern as the schema spells it
    # @return [Regexp, nil]
    def self.compile(source)
      Regexp.new(source)
    rescue RegexpError
      nil
    end
{{#constraintModels}}
