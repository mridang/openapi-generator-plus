{{/constraintModels}}

    # Whether a compiled pattern finds no match in the text; a pattern that
    # did not compile never fails.
    # @param pattern [Regexp, nil] the compiled pattern
    # @param text [String] the value
    # @return [Boolean]
    def self.mismatch?(pattern, text)
      return false if pattern.nil?

      !pattern.match?(text)
    end

    # Whether +value+ is less than +limit+.
    # @param value [Numeric] the value, a length or a size
    # @param limit [Numeric] the bound
    # @return [Boolean]
    def self.below?(value, limit)
      value < limit
    end

    # Whether +value+ is greater than +limit+.
    # @param value [Numeric] the value, a length or a size
    # @param limit [Numeric] the bound
    # @return [Boolean]
    def self.above?(value, limit)
      value > limit
    end

    # Whether +value+ divided by +limit+ is a whole number, within 1e-9.
    # @param value [Numeric] the value
    # @param limit [Float] the divisor
    # @return [Boolean]
    def self.multiple_of?(value, limit)
      quotient = value.to_f / limit
      (quotient - quotient.round).abs < 1e-9
    end

    # Raises the argument error for a violation.
    # @param path [String] the wire path of the value
    # @param message [String] the rule the value breaks
    # @raise [ArgumentError] always
    def self.fail_at(path, message)
      raise ArgumentError, "Invalid request body: #{path} #{message}"
    end
    private_class_method :compile, :validate_value, :mismatch?, :below?, :above?, :multiple_of?, :fail_at{{#constraintModels}},
                         :check_{{#lambda.rubySnake}}{{classname}}{{/lambda.rubySnake}}{{/constraintModels}}
{{/hasConstraintModels}}
{{^hasConstraintModels}}
    # Checks a request body. The specification declares no validation
    # keywords on any model, so every body passes.
    # @param _body [Object] the request body
    # @return [void]
    def self.validate(_body)
      nil
    end
{{/hasConstraintModels}}
