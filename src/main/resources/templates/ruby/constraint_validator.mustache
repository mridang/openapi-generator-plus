    # Checks a request body. A list body is checked item by item; any other
    # value that is not a model with constraints passes.
    # @param body [Object] the request body
    # @return [void]
    # @raise [ArgumentError] naming the path and the rule of the first violation
    def self.validate(body)
      if body.is_a?(Array)
        body.each_with_index { |item, index| validate_value(item, "[#{index}].") }
      else
        validate_value(body, '')
      end
    end

    # Checks one value whose path starts with +prefix+. The class is matched
    # exactly, so a model that extends another is checked by its own rules.
    # @param value [Object] the value
    # @param prefix [String] the path of the value, ending in a dot when not empty
    # @return [void]
    def self.validate_value(value, prefix)
{{#constraintModels}}
      return check_{{#lambda.rubySnake}}{{classname}}{{/lambda.rubySnake}}(value, prefix) if value.instance_of?(::{{moduleName}}::Models::{{classname}})
{{/constraintModels}}
      nil
    end
{{#constraintModels}}

    # Checks the properties of a {Models::{{classname}}} in declaration order.
    # @param value [Models::{{classname}}] the model
    # @param prefix [String] the path of the model, ending in a dot when not empty
    # @return [void]
    def self.check_{{#lambda.rubySnake}}{{classname}}{{/lambda.rubySnake}}(value, prefix)
{{#vendorExtensions.constraintProps}}
      field = value.{{name}}
      unless field.nil?
        path = "#{prefix}{{baseName}}"
{{#checks}}
{{#isMinLength}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if below?(field.length, {{limit}})
{{/isMinLength}}
{{#isMaxLength}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if above?(field.length, {{limit}})
{{/isMaxLength}}
{{#isPattern}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if mismatch?({{#lambda.uppercase}}{{#lambda.rubySnake}}{{classname}}{{/lambda.rubySnake}}_{{name}}{{/lambda.uppercase}}_PATTERN, field)
{{/isPattern}}
{{#isMinimum}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if below?(field, {{limit}})
{{/isMinimum}}
{{#isMaximum}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if above?(field, {{limit}})
{{/isMaximum}}
{{#isExclusiveMinimum}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') unless above?(field, {{limit}})
{{/isExclusiveMinimum}}
{{#isExclusiveMaximum}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') unless below?(field, {{limit}})
{{/isExclusiveMaximum}}
{{#isMultipleOf}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') unless multiple_of?(field, {{limitDouble}})
{{/isMultipleOf}}
{{#isMinItems}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if below?(field.size, {{limit}})
{{/isMinItems}}
{{#isMaxItems}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if above?(field.size, {{limit}})
{{/isMaxItems}}
{{#isMinProperties}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if below?(field.size, {{limit}})
{{/isMinProperties}}
{{#isMaxProperties}}
        fail_at(path, '{{#lambda.rubyQuoted}}{{{message}}}{{/lambda.rubyQuoted}}') if above?(field.size, {{limit}})
{{/isMaxProperties}}
{{/checks}}
{{#hasNestedModel}}
        validate_value(field, "#{path}.")
{{/hasNestedModel}}
{{#hasNestedItemsModel}}
        field.each_with_index { |item, index| validate_value(item, "#{path}[#{index}].") }
{{/hasNestedItemsModel}}
      end
{{/vendorExtensions.constraintProps}}
      nil
