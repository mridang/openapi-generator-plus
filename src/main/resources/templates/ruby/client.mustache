    # Releases the HTTP stack this client built (connection pool and sockets).
    #
    # Closing is graceful and idempotent: the client is marked closed at once,
    # a request already in flight finishes, and the connection is released when
    # the last of them completes (at once when none is running). A request
    # started after it raises a RuntimeError, and calling it again does
    # nothing. A Faraday connection supplied through
    # {TransportOptions::Builder#connection} belongs to the caller and is
    # never closed.
    #
    # @return [void]
    def close
      @api_client.close
    end

    # Creates a client authenticated with a static Bearer token.
    # The token is the +access_token+ given here, else the environment variable
    # +{{envVarPrefix}}_TOKEN+ (read once, here; an empty value counts as unset),
    # else the result of +token_provider+ (called for every request). A client
    # with none of them cannot be built: this raises an ArgumentError.
    #
    # @param host [String] API base URL.
    # @param access_token [String, nil] Bearer token.
    # @param transport_options [TransportOptions, nil] Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).
    # @param token_provider [#call, nil] Returns the Bearer token for one request.
    # @param call_hook [#start, nil] The hook that runs around every call, see {CallHook}.
    # @return [{{clientClassName}}] Configured client instance.
    def self.with_token(host, access_token = nil, transport_options = nil, token_provider: nil, call_hook: nil)
      new(Auth::BearerAuthenticator.new(host, access_token, token_provider: token_provider), transport_options,
          call_hook: call_hook)
    end

    # Creates a client from a ready-made authenticator.
    #
    # This is the generic entry point for bespoke authentication strategies
    # such as OAuth2 client credentials, JWT private-key (service account),
    # or a personal access token (PAT). Supply any {Auth::Authenticator}
    # implementation; if it also includes {Auth::HttpAwareAuthenticator}, the
    # shared {ApiClient} is injected so its HTTP calls reuse the same
    # transport configuration.
    #
    # @param authenticator [Auth::Authenticator] Provides host URL and auth headers.
    # @param transport_options [TransportOptions, nil] Optional HTTP transport configuration (proxy, TLS, timeouts, etc.).
    # @param call_hook [#start, nil] The hook that runs around every call, see {CallHook}.
    # @return [{{clientClassName}}] Configured client instance.
    def self.with_authenticator(authenticator, transport_options = nil, call_hook: nil)
      new(authenticator, transport_options, call_hook: call_hook)
    end
  end
