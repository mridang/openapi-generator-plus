module Base64
  def self.strict_encode64: (String) -> String
  def self.strict_decode64: (String) -> String
  def self.decode64: (String) -> String
end

module Dry
  def self.Types: () -> Module

  module Types
    class CoercionError < StandardError
    end
  end

  class Struct
    def self.attribute: (Symbol, untyped) -> void
    def self.transform_keys: () { (untyped) -> untyped } -> void
  end
end

module Types
  Builder: untyped
  Any: untyped
  Required: untyped
  String: untyped
  Integer: untyped
  Float: untyped
  Decimal: untyped
  Bool: untyped
  Date: untyped
  DateTime: untyped
  Time: untyped
  Hash: untyped
  Array: untyped
  Nil: untyped
end

module URI
  def self.parse: (String) -> URI::Generic
  def self.encode_www_form: (Hash[String, String]) -> String

  class Generic
    def host: () -> String?
    def port: () -> Integer?
    def scheme: () -> String?
    def path: () -> String
  end
end

module Net
  class HTTP
    def self.get_response: (URI::Generic) -> HTTPResponse
    def self.new: (String?, Integer?) -> HTTP

    attr_accessor use_ssl: bool

    def request: (HTTPRequest) -> HTTPResponse
  end

  class HTTPRequest
    def []=: (String, String) -> void
    attr_accessor body: String?
  end

  class HTTPResponse
    def body: () -> String
    def code: () -> String
    def is_a?: (Class) -> bool
  end

  class HTTPSuccess < HTTPResponse
  end

  module HTTP::Post
    def self.new: (String) -> HTTPRequest
  end
end

module JSON
  def self.parse: (String) -> untyped
end

module Brotli
  def self.inflate: (String) -> String
end

module Zstd
  def self.decompress: (String) -> String
end

# 4.8: format: time — Tod::TimeOfDay surface for HH:MM:SS values.
module Tod
  class TimeOfDay
    def self.parse: (String) -> TimeOfDay
    def self.new: (Integer, ?Integer, ?Integer) -> TimeOfDay
    def strftime: (String) -> String
    def to_s: () -> String
    def hour: () -> Integer
    def minute: () -> Integer
    def second: () -> Integer
  end
end

# 4.8: format: duration — ISO8601::Duration surface for ISO-8601 durations.
module ISO8601
  class Duration
    def self.new: (String) -> Duration
    def to_s: () -> String
    def to_seconds: () -> Numeric
  end
end

module Faraday
  def self.new: (?String?) ?{ (Connection) -> void } -> Connection

  class Connection
    attr_accessor proxy: String?
    attr_accessor ssl: SSLOptions
    attr_accessor options: RequestOptions
    def run_request: (Symbol, String?, String?, Hash[String, String]?) -> Response
    def response: (Symbol, **untyped) -> void
  end

  class SSLOptions
    attr_accessor verify: bool
    attr_accessor ca_file: String?
    attr_accessor client_cert: String?
    attr_accessor client_key: String?
  end

  class RequestOptions
    attr_accessor timeout: (Integer | Float)?
    attr_accessor open_timeout: (Integer | Float)?
  end

  class Response
    def status: () -> Integer
    def body: () -> String
    def headers: () -> Hash[String, String]
  end

  class Error < StandardError
  end

  class ConnectionFailed < Error
  end

  class TimeoutError < Error
  end

  class SSLError < Error
  end
end
