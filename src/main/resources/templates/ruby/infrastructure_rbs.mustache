module {{moduleName}}
  def self.configure: () { (Configuration) -> void } -> void
                    | () -> Configuration

  VERSION: String

  class Configuration
    attr_accessor base_url: String
    attr_accessor default_headers: Hash[String, String]
    attr_accessor debug: bool
    attr_accessor verify_ssl: bool
    attr_accessor ssl_ca_cert: String?
    attr_accessor cert_file: String?
    attr_accessor key_file: String?
    attr_accessor proxy: String?
    attr_accessor timeout: Integer?
    attr_accessor retries: Integer?
    def initialize: () -> void
                  | () { (Configuration) -> void } -> void
    def self.default: () -> Configuration
    def self.default=: (Configuration) -> Configuration
  end

  class ApiResponse
    attr_reader status_code: Integer
    attr_reader body: String
    attr_reader headers: Hash[String, String]
    def initialize: (status_code: Integer, body: String, headers: Hash[String, String]) -> void
  end

  class ApiError < StandardError
    attr_reader code: Integer?
    attr_reader response_headers: Hash[String, String]?
    attr_reader response_body: String?
    def initialize: (?untyped) -> void
    def message: () -> String
  end

  class ApiClient
    def send_request: (Symbol, String, Hash[String, String], untyped) -> ApiResponse
  end

  class DefaultApiClient < ApiClient
    def initialize: (?Configuration?) -> void
    def send_request: (Symbol, String, Hash[String, String], untyped) -> ApiResponse
  end

  class SerializationError < StandardError
    attr_reader cause: Exception?
    def initialize: (String, ?Exception?) -> void
  end

  class SchemaMismatchError < StandardError
  end

  class ObjectSerializer
    DEFAULT_DATETIME_FORMAT: String
    def self.serialize: (untyped) -> String
    def self.deserialize: (untyped, String) -> untyped
    def self.to_path_value: (untyped) -> String
    def self.to_query_value: (untyped, ?Symbol?) -> untyped
    def self.to_header_value: (untyped) -> String
    def self.to_form_value: (untyped) -> String
    def self.convert_to_type: (untyped, String) -> untyped
    def self.find_and_cast_into_type: (untyped, untyped) -> untyped
    def self.sanitize_for_serialization: (untyped) -> untyped
    def self.deserialize_model: (untyped, untyped) -> untyped
  end

  class TraceContextUtil
    def self.inject_trace_context: (Hash[String, String]) -> void
  end

  class HeaderSelector
    JSON_MIME_PATTERN: Regexp
    WEIGHT_PATTERN: Regexp
    HeaderData: untyped
    def select_headers: (Array[String], String, bool) -> Hash[String, String]
    def json_mime?: (String?) -> bool
    def get_next_weight: (Integer, bool) -> Integer
    private
    def select_accept_header: (Array[String]?) -> String?
    def select_json_mime_list: (Array[String]) -> Array[String]
    def get_accept_header_with_adjusted_weight: (Array[String], Array[String]) -> String
    def get_header_and_weight: (String) -> untyped
    def adjust_weight: (Array[untyped], Array[Integer], bool) -> Array[String]
    def build_accept_header: (String, Integer) -> String
  end

