  # Interface for API HTTP transport. Implementations handle the actual HTTP
  # request/response cycle. The default implementation ({DefaultApiClient})
  # is backed by Faraday.
  class ApiClient
    # Send an HTTP request and return the response.
    #
    # @param method [String] HTTP method (GET, POST, PUT, DELETE, etc.)
    # @param url [String] Fully qualified URL
    # @param headers [Hash] HTTP headers
    # @param body [Object, nil] Request body
    # @param no_redirect [Boolean] when true, the implementation must NOT
    #   follow any 3xx redirect and instead returns the first 3xx response to
    #   the caller as-is (it does not raise). Used by the OAuth2 token endpoint
    #   POST so that credentials in the body are never silently replayed to a
    #   redirect target — the caller inspects and rejects the 3xx itself.
    #   Defaults to false.
    # @return [ApiHttpResponse] ApiHttpResponse containing status code, body, and headers
    def send_request(method, url, headers, body, no_redirect: false)
