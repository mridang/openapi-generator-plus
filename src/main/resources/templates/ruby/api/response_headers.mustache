      class {{className}}
        # A decimal number: an optional sign, digits with an optional fraction,
        # and an optional exponent.
        DECIMAL = /\A[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?\z/
        private_constant :DECIMAL

        attr_reader {{accessorList}}

        def initialize({{initializeSignature}})
{{#headers}}
          @{{varName}} = {{varName}}{{#isArray}}&.freeze{{/isArray}}
{{/headers}}
          freeze
