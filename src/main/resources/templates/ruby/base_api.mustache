# frozen_string_literal: true

{{>api_info}}

require 'uri'
require 'cgi/escape'
require 'json'
require 'base64'
require 'stringio'
require 'English'

require '{{modulePath}}/object_serializer'

# :nodoc:
module {{moduleName}}
  module Api
    # Base class for all API classes. Provides the invoke_api method that
    # handles URL construction, header selection, body serialization, request
    # dispatch, and response deserialization.
    class BaseApi
      # Sentinel marker meaning "this operation is explicitly unauthenticated"
      # (declared `security: []` in the spec). It is a dedicated, identity-
      # comparable value distinct from both +nil+ and any real authenticator,
      # so base_api can tell three states apart:
      #
      #   * NO_AUTH                 -> suppress auth (do NOT fall back to the
      #                                client authenticator)
      #   * nil                     -> no scheme credential applies; fall back
      #                                to the client-level authenticator
      #   * a real authenticator    -> the credential of the scheme the
      #                                operation names; use it as-is
      #
      # Generated operation methods pass NO_AUTH for security:[] operations
      # and the result of {#scheme_authenticator} for the others. Callers never
      # construct or see this value.
      NO_AUTH = ::Object.new.freeze

      # @return [Configuration]
      attr_reader :config

      # Create an API instance.
      #
      # @param api_client [ApiClient, nil] the HTTP transport client
      # @param config [Configuration] API-level configuration (base URL and default headers)
      # @param authenticator [Authenticator, nil] default authenticator, used by an operation that no scheme credential matches
      # @param scheme_authenticators [Hash{String => Authenticator}] the credential of each security scheme the
      #   client holds, by the scheme's name in the spec
      def initialize(api_client = nil, config = ::{{moduleName}}::Configuration.default_configuration, authenticator = nil,
                     scheme_authenticators = {})
        @config = config
        @api_client = api_client || ::{{moduleName}}::DefaultApiClient.new
        @header_selector = ::{{moduleName}}::HeaderSelector.new
        @authenticator = authenticator
        @scheme_authenticators = scheme_authenticators.dup.freeze
      end

      protected

      # The credential of the first of +names+ the client holds, or nil when it
      # holds none of them, which leaves the call to the default authenticator
      # (and sends no credential when there is none). +names+ is the scheme
      # order of the operation's own security requirement.
      #
      # @param names [Array<String>] security scheme names, in the operation's order
      # @return [Authenticator, nil]
      def scheme_authenticator(*names)
        names.each do |name|
          found = @scheme_authenticators[name]
          return found if found
        end
        nil
      end

      # The credential for an operation whose security block lists alternative
      # requirements. Each group is one requirement: a group that names several
      # schemes needs the credentials of all of them and a request carries every
      # one. The first group the client holds every credential of wins, else the
      # first group it holds at least one credential of; nil when it holds none,
      # which leaves the call to the default authenticator.
      #
      # @param groups [Array<Array<String>>] the requirements, in the spec's order
      # @return [Authenticator, nil]
      def requirement_authenticator(*groups)
        partial = nil
        groups.each do |group|
          held = group.filter_map { |name| @scheme_authenticators[name] }
          next if held.empty?
          if held.size == group.size
            return held.one? ? held.first : ::{{moduleName}}::Auth::AllOfAuthenticator.of(held)
          end

          partial ||= held
        end
        return nil if partial.nil?

        partial.one? ? partial.first : ::{{moduleName}}::Auth::AllOfAuthenticator.of(partial)
      end

      # Invoke an API operation and return the full result including status
      # code, headers, and raw body alongside the deserialized data.
      #
      # @param method [String] HTTP method (GET, POST, PUT, DELETE, etc.)
      # @param path [String] URL path (with path params already substituted)
      # @param query_params [Hash] query parameters
      # @param header_params [Hash] custom header parameters
      # @param body [Object, nil] request body (model object or nil)
      # @param accepts [Array<String>] acceptable response content types
      # @param content_type [String, nil] request content type
      # @param return_type [String, Hash{Integer, String => String}, nil] return type for
      #   deserialization (nil for void). An operation with several 2xx schemas passes
      #   a Hash of status code (a +'2XX'+ key for the range) to type name, and the
      #   body is decoded as the type of the status the response actually carries.
      # @param auth [Object, nil] operation-specific auth resolution. Three states:
      #   NO_AUTH suppresses auth (security: [] operation), nil falls back to the
      #   client-level authenticator, and a real authenticator is the credential of the
      #   scheme the operation names.
      # @param operation_id [String, nil] the calling operation as +Class.operation+, named in a
      #   serialization error (defaults to the API class name)
      # @param request_options [Object, nil] the per-call options of the operation: its +timeout+
      #   (milliseconds), +headers+ and +max_retries+ apply to this call alone, and nil members
      #   keep the client's values. A custom ApiClient receives the headers only.
      # @param error_schemas [Hash{String => Class}, nil] the error classes the operation declares,
      #   by declared status (+'404'+, +'4XX'+, +'5XX'+ or +'default'+), nil when it declares none
      # @param spec_operation_id [String, nil] the operation id exactly as the spec writes it, which the
      #   call hook gets as +operation_id+ (defaults to +operation_id+)
      # @param url_template [String, nil] the spec path template of the operation, which the call hook
      #   gets as +url_template+ (defaults to the path of the request)
      # @return [ApiResult] ApiResult containing deserialized data, status code, raw body, and headers
      # @raise [Errors::ApiError] if the API call fails
      # @raise [Errors::SerializationError] if the response body cannot be decoded; the error
      #   carries the response status, headers and raw body and the request method and path
      def invoke_api_for_result(
        method, path, query_params, header_params, body,
        accepts, content_type, return_type, auth = nil, raw_body: false, operation_id: nil, request_options: nil,
        error_schemas: nil, spec_operation_id: nil, url_template: nil
      )
        started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
        url = if path.start_with?('http://', 'https://')
                path
              else
                # Strip trailing slash from baseUrl when path starts with
                # `/` so baseUrl='https://x/' + path='/y' produces
                # 'https://x/y', not 'https://x//y' which most servers
                # route to 404. Matches Java/C#/Go/Swift/Dart/Kotlin
                # which collapse via URI parsers.
                base = path.start_with?('/') ? @config.base_url.sub(%r{/+\z}, '') : @config.base_url
                "#{base}#{path}"
              end

        # Three-state auth resolution. `auth` carries the operation's intent:
        #   * NO_AUTH               -> the operation is explicitly unauthenticated
        #                              (security:[]); apply NO credential, and do
        #                              NOT fall back to the client authenticator.
        #   * nil                   -> no scheme credential applies; fall back to
        #                              the client-level authenticator.
        #   * a real authenticator  -> the credential of the scheme the operation
        #                              names; use it as-is.
        # equal? is identity comparison, so a real authenticator can never be
        # mistaken for the sentinel.
        # @type var effective_auth: untyped
        effective_auth = if auth.equal?(NO_AUTH)
                           nil
                         else
                           auth || @authenticator
                         end
        # A per-call credential that needs HTTP (an OAuth2 token exchange, a discovery
        # request) is handed the API's client here, as the client-level one is at construction.
        effective_auth.api_client = @api_client if effective_auth.is_a?(::{{moduleName}}::Auth::HttpAwareAuthenticator)
        effective_auth&.query_params&.each { |k, v| query_params[k] = v }

        query_string = build_query_string(query_params)
        url = "#{url}?#{query_string}" unless query_string.empty?

        is_multipart = content_type == 'multipart/form-data'
        selected = @header_selector.select_headers(accepts, content_type || '', is_multipart)
        # @type var headers: Hash[String, String]
        # Start from the operation-negotiated headers, then merge the config
        # default headers OVER them so a caller's default Accept/Content-Type
        # wins over content negotiation. Matches Java's putAll(default_headers)
        # after select_headers, and python/elixir.
        headers = {}
        headers['Accept'] = selected['Accept'] if selected['Accept']
        headers['Content-Type'] = selected['Content-Type'] if selected['Content-Type']
        merge_call_headers(headers, @config.default_headers)
        headers.merge!(header_params)
        merge_call_headers(headers, request_options.headers) if request_options&.headers
        request_headers = authenticated_headers(headers, effective_auth)
        # The hook starts once per call, right after the trace context is in the
        # headers, and may edit them. Every retry and replay is a fresh request
        # whose headers are rebuilt, so what the hook changed is kept as a delta
        # and applied to each of them again.
        call_hook = @config.call_hook
        observer = nil
        hook_delta = nil
        if call_hook
          info = call_info_of(method, url, spec_operation_id || operation_id || self.class.name.to_s, url_template)
          before = request_headers.dup
          observer = call_hook.start(info, request_headers)
          hook_delta = header_delta(before, request_headers)
        end
        outcome = nil
        begin
          serialized_body = serialize_body(body, content_type, raw_body: raw_body)
          request_headers.delete('Content-Type') if serialized_body.nil?
          # Every retry and replay is a fresh request: its headers (the
          # authentication among them, which may now hold a renewed token) are
          # rebuilt from the same inputs.
          fresh_headers = lambda do |replay = false|
            rebuilt_headers(headers, effective_auth, serialized_body.nil?, hook_delta, replay)
          end
          call_options = transport_call_options(request_options)
          call_options = remaining_deadline(call_options, started_at)
          response = dispatch_request(method, url, request_headers, serialized_body, fresh_headers, call_options)
          if response.status_code == 401 && effective_auth.respond_to?(:invalidate_access_token) && replayable_body?(serialized_body)
            # A revoked or rotated token keeps failing while it is cached. Drop it,
            # obtain a new one (a refresh grant first) and replay the request
            # once. A body that cannot be replayed (multipart, a stream) is not
            # sent again, and a failed re-authentication leaves the 401 as is.
            effective_auth.invalidate_access_token
            renewed = begin
              fresh_headers.call(true)
            rescue {{apiErrorParent}}
              nil
            end
            response = dispatch_request(method, url, renewed, serialized_body, fresh_headers, call_options) if renewed
          end
          throw_api_error(response, method, url, error_schemas) if response.status_code < 200 || response.status_code >= 300

          data = nil
          if response.body && !response.body.empty?
            begin
              data = decode_success_data(response, return_type, operation_id)
            rescue ::{{moduleName}}::Errors::SerializationError => e
              # The error learns which response and request it belongs to.
              raise e.with_response(
                status_code: response.status_code, headers: response.headers, body: response.body,
                request_method: method.to_s, request_path: request_path_of(url)
              )
            end
          end

          result = ::{{moduleName}}::ApiResult.new(
            status_code: response.status_code,
            data: data,
            raw_body: response.body,
            headers: response.headers
          )
          outcome = ::{{moduleName}}::CallOutcome.new(
            status_code: result.status_code, headers: lower_cased_headers(result.headers), error: nil
          )
          result
        ensure
          # The one place the call ends, whatever way it does: a result, an
          # error, or an interruption raised into the thread.
          finish_call(observer, outcome || error_outcome($ERROR_INFO)) if observer
        end
      end

      # Invoke an API operation.
      #
      # @param method [String] HTTP method (GET, POST, PUT, DELETE, etc.)
      # @param path [String] URL path (with path params already substituted)
      # @param query_params [Hash] query parameters
      # @param header_params [Hash] custom header parameters
      # @param body [Object, nil] request body (model object or nil)
      # @param accepts [Array<String>] acceptable response content types
      # @param content_type [String, nil] request content type
      # @param return_type [String, nil] return type for deserialization (nil for void)
      # @param auth [Object, nil] operation-specific auth resolution. Three states:
      #   NO_AUTH suppresses auth (security: [] operation), nil falls back to the
      #   client-level authenticator, and a real authenticator is the credential of the
      #   scheme the operation names.
      # @param operation_id [String, nil] the calling operation as +Class.operation+
      # @return [Object, nil] deserialized response or nil
      # @raise [Errors::ApiError] if the API call fails
      def invoke_api(
        method, path, query_params, header_params, body,
        accepts, content_type, return_type, auth = nil, operation_id: nil
      )
        invoke_api_for_result(
          method, path, query_params, header_params, body,
          accepts, content_type, return_type, auth, operation_id: operation_id
        ).data
      end

      private

      # The request headers: +base_headers+ plus what +effective_auth+ adds
      # (its headers and cookies) and the trace context, as a new Hash.
      def authenticated_headers(base_headers, effective_auth)
        headers = credentialed_headers(base_headers, effective_auth)
        ::{{moduleName}}::TraceContextUtil.inject_trace_context(headers)
        headers
      end

      # +base_headers+ plus what +effective_auth+ adds (its headers and cookies),
      # as a new Hash.
      def credentialed_headers(base_headers, effective_auth)
        headers = base_headers.dup
        headers.merge!(effective_auth.auth_headers) if effective_auth
        cookies = effective_auth&.cookie_params || {}
        unless cookies.empty?
          # RFC 6265 — don't URL-encode cookie name/value; most cookie
          # parsers don't URL-decode, so `=` (base64 padding) would
          # arrive as literal `%3D` and break JWT/session cookies.
          # Validate and pass through raw instead.
          cookie_str = cookies.map do |k, v|
            name = k.to_s
            value = v.to_s
            unless name.match?(/\A[A-Za-z0-9!#$%&'*+\-.^_`|~]+\z/)
              raise ArgumentError, "Cookie name '#{name}' contains characters forbidden by RFC 6265"
            end
            unless value.match?(/\A[!\x23-\x2B\x2D-\x3A\x3C-\x5B\x5D-\x7E]*\z/)
              raise ArgumentError, "Cookie value for '#{name}' contains characters forbidden by RFC 6265"
            end
            "#{name}=#{value}"
          end.join('; ')
          existing = headers['Cookie']
          headers['Cookie'] = existing ? "#{existing}; #{cookie_str}" : cookie_str
        end
        headers
      end

      # The headers of a retry or of the replay after a 401, built again from the
      # same inputs: the headers of the call, the credentials as they are now
      # and the trace context, with what the call hook changed put back. A retry
      # keeps every hook change. A replay carries fresh credentials, so a
      # header the credentials set replaces a hook header of the same name.
      def rebuilt_headers(base, effective_auth, no_body, hook_delta, replay)
        credentialed = credentialed_headers(base, effective_auth)
        credential_names = [] # : Array[String]
        credential_names = credentialed.keys.reject { |name| credentialed[name] == base[name] } if replay
        ::{{moduleName}}::TraceContextUtil.inject_trace_context(credentialed)
        apply_header_delta(credentialed, hook_delta, credential_names) if hook_delta
        credentialed.delete('Content-Type') if no_body
        credentialed
      end

      # What a hook changed in a header set: the headers it set or replaced and
      # the names it removed.
      def header_delta(before, after)
        set = after.reject { |name, value| before.key?(name) && before[name] == value }
        { set: set, removed: before.keys - after.keys }
      end

      # Puts a hook's changes onto +headers+, leaving alone the +skip+ names.
      def apply_header_delta(headers, delta, skip)
        delta[:removed].each { |name| headers.delete(name) unless skip.include?(name) }
        delta[:set].each { |name, value| headers[name] = value unless skip.include?(name) }
      end

      # The call hook's view of a call: the spec operation id and path template
      # and the request URL without its query string and fragment.
      def call_info_of(method, url, spec_operation_id, url_template)
        bare = url.split(/[?#]/, 2).first.to_s
        ::{{moduleName}}::CallInfo.new(
          operation_id: spec_operation_id,
          http_method: method.to_s.upcase,
          url_template: url_template || request_path_of(url),
          url: bare,
          server_address: server_address_of(bare)
        )
      end

      # The lower-case host of +url+ without its port and without the brackets
      # of an IPv6 literal, or an empty string when there is none.
      def server_address_of(url)
        URI.parse(url).host.to_s.delete_prefix('[').delete_suffix(']').downcase
      rescue URI::InvalidURIError
        ''
      end

      # Response headers as the hook sees them: lower-cased names, read-only.
      def lower_cased_headers(headers)
        return nil if headers.nil?

        headers.transform_keys { |name| name.to_s.downcase }.freeze
      end

      # How a call that raised ended: the status and headers of the response
      # the error carries (none for a failure before one arrived), and the
      # error itself.
      def error_outcome(error)
        status = error.respond_to?(:status_code) ? error.status_code.to_i : 0
        headers = status.positive? && error.respond_to?(:response_headers) ? lower_cased_headers(error.response_headers) : nil
        ::{{moduleName}}::CallOutcome.new(status_code: status, headers: headers, error: error)
      end

      # Tells the observer the call ended. A hook never changes the result or the
      # error of a call, so an error it raises here is dropped.
      def finish_call(observer, outcome)
        observer.finish(outcome)
      rescue StandardError
        nil
      end

      # Send one request. The SDK's own transport also gets +fresh_headers+, so
      # an automatic retry rebuilds the headers (and re-authenticates) first.
      def dispatch_request(method, url, headers, body, fresh_headers, call_options = {})
        unless @api_client.is_a?(::{{moduleName}}::DefaultApiClient)
          return @api_client.send_request(method, url, headers, body)
        end

        @api_client.send_request(method, url, headers, body, retry_headers: fresh_headers, **call_options)
      rescue ::{{moduleName}}::Errors::ApiError => e
        # A failure that carries no request yet (the network, a refused redirect,
        # an undecodable body) learns which request it belongs to.
        e.instance_variable_set(:@request_method, method.to_s.upcase) if e.request_method.nil?
        e.instance_variable_set(:@request_path, request_path_of(url)) if e.request_path.nil?
        raise
      end

      # Whether a request body can be sent a second time: none, or a string. A
      # multipart form or a stream handle is consumed by the first send.
      def replayable_body?(body)
        body.nil? || body.is_a?(String)
      end

      # Decodes the body of a success response as +decode_type+.
      #
      # @param response [ApiHttpResponse] the success response
      # @param decode_type [String] the type name to decode the body into
      # @param operation_id [String, nil] the calling operation, named in a serialization error
      # @return [Object, nil] the decoded body
      # @raise [Errors::SerializationError] if the body cannot be decoded
      def decode_success_body(response, decode_type, operation_id)
        # @type var resp_content_type: String?
        ct_pair = response.headers.find { |k, _| k.downcase == 'content-type' }
        resp_content_type = ct_pair ? ct_pair.last.split(';').first.strip : nil
        if binary_return_type?(decode_type)
          # Binary return types (File) must never be JSON-deserialized,
          # even when content negotiation makes the server label the
          # raw bytes `application/json`. Detect by the target return
          # type, not the response Content-Type. The transport
          # base64-encodes the body for binary content types and leaves
          # text content types (including JSON) as a decoded string, so
          # recover the raw bytes accordingly before wrapping.
          raw_bytes = if text_response_content_type?(resp_content_type)
                        response.body
                      else
                        Base64.strict_decode64(response.body)
                      end
          StringIO.new(raw_bytes)
        elsif !resp_content_type || @header_selector.json_mime?(resp_content_type)
          ::{{moduleName}}::ObjectSerializer.deserialize(response.body, decode_type)
        elsif decode_type == 'String'
          # The transport base64-encodes a binary content type as its carrier;
          # a string result is the decoded body, never that carrier text.
          text_response_content_type?(resp_content_type) ? response.body : decode_carrier(response.body)
        else
          # A non-JSON body can only be returned verbatim for a String
          # return type (the transport base64-encodes binary types);
          # anything else would be a raw string typed as a model, so
          # refuse it and name the Content-Type.
          raise ::{{moduleName}}::Errors::SerializationError.new(
            "Unexpected response Content-Type '#{resp_content_type}' for " \
            "#{operation_id || self.class.name.to_s.split('::').last}: expected a JSON body", nil
          )
        end
      end

      # Raises the error ApiError.from_response maps the response to, carrying
      # the method and the path (never the query string) of the request. The
      # body is parsed as JSON where possible so that structured error data
      # (e.g. from a +default+ response schema) is available via
      # {Errors::ApiError#error_body}.
      def throw_api_error(response, method, url, error_schemas = nil)
        raise ::{{moduleName}}::Errors::ApiError.from_response(
          response.status_code, response.headers, response.body,
          request_method: method.to_s, request_path: request_path_of(url), error_schemas: error_schemas
        )
      end

      # The timeout and retry count of one call, checked, as the keywords the
      # transport takes; a member left nil is left out, so the transport's own
      # value applies.
      def transport_call_options(request_options)
        timeout = request_options&.timeout
        max_retries = request_options&.max_retries
        if timeout && (!timeout.is_a?(Numeric) || timeout < 1)
          raise ArgumentError, "Invalid timeout: must be at least one millisecond (got #{timeout.inspect})"
        end

        ::{{moduleName}}::TransportOptions.validate_max_retries!(max_retries) unless max_retries.nil?
        { timeout: timeout, max_retries: max_retries }.compact
      end

      # The call options with the per-call timeout reduced by what credential
      # lookup already used. A timeout that has run out raises the network
      # timeout error before the transport is touched.
      def remaining_deadline(call_options, started_at)
        timeout = call_options[:timeout]
        return call_options unless timeout

        elapsed_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at) * 1000).floor
        if elapsed_ms >= timeout
          raise ::{{moduleName}}::Errors::NetworkTimeoutError.new(message: "Request timed out after #{timeout} ms")
        end

        call_options.merge(timeout: timeout - elapsed_ms)
      end

      # Adds the headers of one call to +headers+; a name replaces one of the
      # same name whatever its casing (RFC 9110 section 5.1).
      def merge_call_headers(headers, extra)
        unless extra.is_a?(Hash) && extra.all? { |name, value| name.is_a?(String) && value.is_a?(String) }
          raise ArgumentError, "Invalid headers: must be a Hash of String names to String values (got #{extra.inspect})"
        end

        extra.each do |name, value|
          headers.delete_if { |existing, _| existing.casecmp?(name) }
          headers[name] = value
        end
      end

      # The path of +url+ without its scheme, host and query string.
      def request_path_of(url)
        path = url.split('?', 2).first.to_s.sub(%r{\A[A-Za-z][A-Za-z0-9+.-]*://[^/]*}, '')
        path.empty? ? '/' : path
      end

      def build_query_string(query_params)
        pairs = query_params.compact.flat_map do |k, v|
          # CGI.escape emits '+' for a space; RFC 3986 requires %20 in a query
          # component (a strict server reads '+' as a literal plus), so normalise
          # it. A literal '+' is already %2B. Matches the other SDKs.
          encoded_key = CGI.escape(k.to_s).gsub('+', '%20')
          # OAS allowReserved: a wrapped value keeps RFC 3986 reserved
          # characters literal instead of percent-encoding them.
          allow_reserved = v.is_a?(::{{moduleName}}::ValueSerializer::AllowReservedValue)
          v = v.value if allow_reserved
          if v.is_a?(Array)
            next [] if v.empty?

            v.map { |val| "#{encoded_key}=#{encode_query_value(val, allow_reserved)}" }
          else
            "#{encoded_key}=#{encode_query_value(v, allow_reserved)}"
          end
        end
        pairs.join('&')
      end

      # Percent-encode a query-parameter value. When the parameter declared
      # +allowReserved: true+ the RFC 3986 reserved characters are left
      # literal; otherwise every reserved character is encoded as before.
      def encode_query_value(value, allow_reserved)
        str = ::{{moduleName}}::ObjectSerializer.to_query_value(value)
        if allow_reserved
          ::{{moduleName}}::ValueSerializer.encode_query_allowing_reserved(str)
        else
          CGI.escape(str).gsub('+', '%20')
        end
      end

      def serialize_body(body, content_type, raw_body: false)
        return nil if body.nil?

        if content_type == 'multipart/form-data'
          body
        elsif raw_body || content_type&.start_with?('image/') ||
              content_type == 'application/octet-stream'
          # A format: binary body (raw_body) is the caller's bytes under
          # whichever declared Content-Type was selected, application/json
          # included; it is never re-encoded through the JSON serializer.
          # An operation that declares BOTH multipart/form-data and a raw binary
          # content-type (e.g. application/octet-stream) builds its body as a
          # form-parts Hash for the multipart case. When the caller selects the
          # raw binary type instead, the multipart envelope must be bypassed:
          # send the single binary part's raw bytes directly. Without this the
          # Hash falls through to the transport, which dispatches multipart on
          # `body.is_a?(Hash)`, and the octet-stream selection silently still
          # ships a multipart/form-data body.
          body = binary_part_from_form_body(body) if body.is_a?(Hash)
          body.respond_to?(:read) ? body.read : body
        elsif content_type == 'text/plain'
          body.to_s
        elsif content_type == 'application/x-www-form-urlencoded'
          # Omit nil-valued fields entirely rather than emitting a valueless
          # `key=` pair, matching the query builder and the other SDKs. Each
          # scalar goes through ObjectSerializer.stringify for the canonical
          # wire form, and nil array elements are skipped.
          pairs = body.compact.flat_map do |key, value|
            items = value.is_a?(Array) || value.is_a?(Set) ? value.to_a : [value]
            items.compact.map do |item|
              # A model, map or nested array has no defined form encoding (the
              # generator does not emit the OAS encoding style), so refuse it
              # rather than putting its to_s on the wire.
              if item.is_a?(Hash) || item.is_a?(Struct) || item.is_a?(Array) || item.respond_to?(:to_hash)
                raise ::{{moduleName}}::Errors::SerializationError,
                      "form-urlencoded field #{key} must be a scalar or array of scalars"
              end

              [key.to_s, ::{{moduleName}}::ObjectSerializer.stringify(item)]
            end
          end
          # encode_www_form keeps '*' literal and escapes '~' to %7E; the other
          # SDKs (and the OAuth2 token body) keep '~' and escape '*'.
          URI.encode_www_form(pairs).gsub('%7E', '~').gsub('*', '%2A')
        else
          ::{{moduleName}}::ObjectSerializer.serialize(body)
        end
      end

      # Extract the single binary part from a multipart form-parts Hash so it
      # can be sent as a raw (non-multipart) request body. Operations that
      # accept both multipart/form-data and a raw binary content-type assemble
      # the body as a `{ field => value }` Hash; when the raw type is selected
      # only the file part belongs on the wire. Prefer a part that is an IO
      # (responds to +read+) — the uploaded file — and fall back to the first
      # value when no IO-like part is present.
      def binary_part_from_form_body(form_body)
        io_part = form_body.values.find { |v| v.respond_to?(:read) }
        io_part || form_body.values.first
      end

      # The type name to decode a response of +status+ into: +return_type+ itself,
      # or, for a Hash of status to type, the entry of that status (else of its
      # +'2XX'+ range, else none).
      def return_type_for_status(return_type, status)
        return return_type unless return_type.is_a?(Hash)

        return_type.fetch(status) { return_type['2XX'] }
      end

      # Decodes a success body. A status no declared response row names
      # decodes as the operation's union of declared success types: the first
      # type that accepts the body wins, and the last refusal is raised when none does.
      def decode_success_data(response, return_type, operation_id)
        declared = return_type_for_status(return_type, response.status_code)
        return decode_success_body(response, declared, operation_id) if declared
        return nil unless return_type.is_a?(Hash) && response.status_code.between?(200, 299)

        # @type var last_error: StandardError?
        last_error = nil
        return_type.values.uniq.each do |type|
          return decode_success_body(response, type, operation_id)
        rescue ::{{moduleName}}::Errors::SerializationError => e
          last_error = e
        end
        raise last_error if last_error

        nil
      end

      # Whether the operation's target return type denotes raw binary data
      # (an OpenAPI `string`/`binary` schema), which the generator maps to
      # +File+. Such responses must be returned as raw bytes rather than being
      # JSON-deserialized.
      def binary_return_type?(return_type)
        return_type == 'File'
      end

      # The bytes a binary body's base64 carrier holds, as text where they are
      # valid UTF-8; a body that is not base64 is returned as it came.
      def decode_carrier(body)
        decoded = Base64.strict_decode64(body)
        text = decoded.dup.force_encoding(Encoding::UTF_8)
        text.valid_encoding? ? text : decoded
      rescue ArgumentError
        body
      end

      # Mirror of the transport's text/binary content-type classification.
      # The transport keeps text content types (including JSON) as a decoded
      # string and base64-encodes everything else, so binary return-type
      # handling must apply the same rule to recover the raw bytes.
      def text_response_content_type?(content_type)
        return true if content_type.nil?

        media_type = content_type.split(';').first.to_s.strip.downcase
        return true if media_type.empty?
        return true if media_type.start_with?('text/')

        %w[application/json application/xml application/javascript].include?(media_type) ||
          media_type.end_with?('+json') ||
          media_type.end_with?('+xml')
      end
    end
  end
end
