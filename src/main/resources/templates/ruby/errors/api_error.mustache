# frozen_string_literal: true

{{> api_info}}

require 'json'

{{#apiErrorParentFile}}
require_relative '{{apiErrorParentFile}}'

{{/apiErrorParentFile}}
module {{moduleName}}
  module Errors
    # Represents an error returned by the API, including the HTTP status code,
    # response headers, and response body.
    class ApiError < {{apiErrorParent}}
      attr_reader :status_code, :response_headers, :response_body, :error_body

      # The one status-to-error mapping in the SDK: the error a non-2xx response
      # with this status raises. The API classes and the OpenID Connect
      # discovery both use it.
      #
      # @param status_code [Integer] the HTTP status code of the response
      # @param headers [Hash{String => String}] the response headers
      # @param body [String, nil] the raw response body
      # @return [ApiError] the status-specific subclass where there is one (for
      #   example NotFoundError for 404), else ClientError for any other 4xx,
      #   ServerError for any other 5xx, and ApiError for everything else
      def self.from_response(status_code, headers, body)
        opts = {
          message: "API returned status code #{status_code}",
          response_body: body,
          response_headers: headers,
          error_body: parse_error_body(body)
        }
        case status_code
        when 400 then BadRequestError.new(**opts)
        when 401 then UnauthorizedError.new(**opts)
        when 403 then ForbiddenError.new(**opts)
        when 404 then NotFoundError.new(**opts)
        when 409 then ConflictError.new(**opts)
        when 422 then UnprocessableEntityError.new(**opts)
        when 429 then TooManyRequestsError.new(**opts)
        when 500 then InternalServerError.new(**opts)
        when 400..499 then ClientError.new(status_code: status_code, **opts)
        when 500..599 then ServerError.new(status_code: status_code, **opts)
        else ApiError.new(status_code: status_code, **opts)
        end
      end

      # Parses a JSON error body so structured error data (e.g. from a
      # +default+ response schema) is available via #error_body.
      #
      # @param body [String, nil] the raw response body
      # @return [Object, nil] the parsed body, or nil when it is empty or not JSON
      def self.parse_error_body(body)
        return nil if body.nil? || body.empty?

        # F5: route through parse_json so the depth-cap rejects malicious
        # 100k-deep error payloads before they exhaust the interpreter stack.
        ::{{moduleName}}::ObjectSerializer.parse_json(body)
      rescue SerializationError
        nil
      end
      private_class_method :parse_error_body

      # Usage examples:
      #   ApiError.new
      #   ApiError.new('message')
      #   ApiError.new(status_code: 500, response_headers: {}, response_body: '')
      #   ApiError.new(status_code: 404, message: 'Not Found')
      def initialize(arg = nil)
        # A failure with no HTTP response carries status 0, as in every other SDK.
        @status_code = 0
        if arg.is_a? Hash
          if arg.key?(:message) || arg.key?('message')
            super(arg[:message] || arg['message'])
          else
            super()
          end

          arg.each do |k, v|
            instance_variable_set :"@#{k}", v
          end
        else
          super
          @message = arg
        end
      end

      # Override to_s to display a friendly error message
      def to_s
        message
      end

      # Deserialize the response body into a typed error object.
      #
      # @param klass [String] the target type name for deserialization
      # @return [Object, nil] the deserialized error body, or nil if the body is empty
      def typed_error_body(klass)
        return nil if response_body.nil? || response_body.empty?

        ::{{moduleName}}::ObjectSerializer.deserialize(response_body, klass)
      end

      # The bare detail message, without the status, headers and body that
      # #message appends. Falls back to the default text when the detail is
      # nil or empty.
      #
      # @return [String] the detail message
      def detail_message
        detail = @message
        return 'Error message: the server returns an error' if detail.nil? || detail.to_s.empty?

        detail
      end

      # Most bytes of the response body that #message renders.
      MAX_RENDERED_BODY_BYTES = 1024
      private_constant :MAX_RENDERED_BODY_BYTES

      # Build a human-readable error message from the stored attributes. The
      # headers and body sections are left out when they are nil or empty. The
      # headers have their credentials redacted (the S15 list plus Set-Cookie),
      # and the body is cut at 1 KiB with control characters escaped, so one
      # error never floods or forges a log line. The full values stay in
      # #response_headers and #response_body.
      def message
        msg = detail_message

        msg += "\nHTTP status code: #{status_code}" if status_code && status_code != 0
        msg += "\nResponse headers: #{JSON.generate(rendered_headers.sort.to_h)}" unless response_headers.nil? || response_headers.empty?
        msg += "\nResponse body: #{rendered_body}" unless response_body.nil? || response_body.empty?

        msg
      end

      private

      # The response headers with every credential value replaced by +***+.
      #
      # @return [Hash{String => String}]
      def rendered_headers
        headers = ::{{moduleName}}::TransportOptions.redact_headers(response_headers || {})
        headers.to_h { |name, value| [name, name.to_s.casecmp?('set-cookie') ? '***' : value] }
      end

      # The response body cut at {MAX_RENDERED_BODY_BYTES} bytes, control
      # characters written as escapes, and a suffix counting the bytes left out.
      #
      # @return [String]
      def rendered_body
        text = response_body.to_s.scrub
        excess = text.bytesize - MAX_RENDERED_BODY_BYTES
        text = text.byteslice(0, MAX_RENDERED_BODY_BYTES).to_s.scrub if excess.positive?
        text = text.gsub(/[\x00-\x1f\x7f]/) do |char|
          { "\n" => '\\n', "\r" => '\\r', "\t" => '\\t' }.fetch(char) { format('\\x%02X', char.ord) }
        end
        excess.positive? ? "#{text}... (#{excess} more bytes)" : text
      end
    end
  end
end
