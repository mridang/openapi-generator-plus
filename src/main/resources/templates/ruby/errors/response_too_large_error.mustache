# frozen_string_literal: true

{{> api_info}}
module {{moduleName}}
  module Errors
    # Exception for a buffered response body that passed
    # {TransportOptions#max_response_bytes}. A response came back, so it carries
    # the real status code and the lower-cased response headers; the body is
    # empty because the client stopped reading as soon as the limit was passed,
    # counting both the bytes on the wire and the decompressed bytes. Only the
    # default client raises it, and it is never retried: the same request
    # returns the same body.
    class ResponseTooLargeError < ::{{moduleName}}::Errors::ApiError
      # The +max_response_bytes+ limit the body passed.
      # @return [Integer]
      attr_reader :limit

      # @param limit [Integer] the limit the body passed
      # @param status_code [Integer] the status of the response
      # @param response_headers [Hash{String => String}, nil] the lower-cased response headers
      # @param request_method [String, nil] the method of the request
      # @param request_path [String, nil] the path of the request
      def initialize(limit:, status_code: 0, response_headers: nil, request_method: nil, request_path: nil)
        super({ status_code: status_code, message: "Response body exceeds the limit of #{limit} bytes",
                response_headers: response_headers, response_body: '',
                request_method: request_method, request_path: request_path })
        @limit = limit
      end

      # Always +false+: sending the request again returns the same body.
      # @return [Boolean]
      def retryable?
        false
      end
    end
  end
end
