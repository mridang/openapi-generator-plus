{{#hasClientSchemes}}
# A credential that records the transport the client hands it, as an OAuth2 or
# OpenID Connect authenticator needs it.
class ClientTestHttpAwareCredential < {{moduleName}}::Auth::Authenticator
  include {{moduleName}}::Auth::HttpAwareAuthenticator

  attr_reader :host, :injected

  def initialize(host)
    super()
    @host = host
  end

  def auth_headers
    {}
  end

  def api_client=(client)
    @injected = client
  end
end

