# frozen_string_literal: true

require 'test_helper'

describe {{moduleName}}::{{clientClassName}} do
  it 'constructs with authenticator only' do
    authenticator = {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', 'test-token')

    client = {{moduleName}}::{{clientClassName}}.new(authenticator)

    _(client).wont_be_nil
  end

  it 'constructs with authenticator and nil transport options' do
    authenticator = {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', 'test-token')

    client = {{moduleName}}::{{clientClassName}}.new(authenticator, nil)

    _(client).wont_be_nil
  end

  it 'constructs with authenticator and transport options' do
    authenticator = {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', 'test-token')
    transport = {{moduleName}}::TransportOptions.builder.build

    client = {{moduleName}}::{{clientClassName}}.new(authenticator, transport)

    _(client).wont_be_nil
  end

  it 'BearerAuthenticator rejects CR/LF and non-ASCII' do
    # RFC 7230 §3.2.6 — Bearer tokens commonly arrive with trailing
    # newlines from .env / file reads, which would CRLF-inject the
    # Authorization header. Also reject non-ASCII.
    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', "tok\r\nInjected: yes")
    }).must_raise ArgumentError

    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', 'ñoño')
    }).must_raise ArgumentError
  end

  it 'ApiKeyAuthenticator HEADER rejects CR/LF and non-ASCII' do
    # RFC 7230 §3.2.6 — header field-value is HTAB / SP / VCHAR.
    # The HEADER location must reject anything outside printable ASCII
    # + TAB to prevent header injection (CR/LF) and silent UTF-8
    # mangling that varies per HTTP lib.
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new('{{{basePath}}}', 'X-Api-Key', "abc\r\nInjected: yes",
                                                    {{moduleName}}::Auth::ApiKeyLocation::HEADER)
    }).must_raise ArgumentError

    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new('{{{basePath}}}', 'X-Api-Key', 'kéy',
                                                    {{moduleName}}::Auth::ApiKeyLocation::HEADER)
    }).must_raise ArgumentError

    # Non-header locations accept arbitrary chars.
    query_auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      '{{{basePath}}}', 'api_key', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(query_auth.query_params).must_equal({ 'api_key' => 'kéy' })
  end

  it 'API groups are accessible' do
    authenticator = {{moduleName}}::Auth::BearerAuthenticator.new('{{{basePath}}}', 'test-token')

    client = {{moduleName}}::{{clientClassName}}.new(authenticator)

{{#apiInfo}}
{{#apis}}
{{#operations}}
    _(client.{{clientPropertyName}}).wont_be_nil
{{/operations}}
{{/apis}}
{{/apiInfo}}
  end
end
