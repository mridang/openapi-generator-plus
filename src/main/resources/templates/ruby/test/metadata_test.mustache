# frozen_string_literal: true
# rubocop:disable all

require 'test_helper'
require 'json'

describe {{moduleName}}::Models::Metadata do
  parallelize_me!

  it 'serializes empty metadata' do
    metadata = {{moduleName}}::Models::Metadata.new
    json = {{moduleName}}::ObjectSerializer.serialize(metadata)

    _(json).wont_be_nil
  end

  it 'deserializes empty object' do
    metadata = {{moduleName}}::ObjectSerializer.deserialize('{}', 'Metadata')

    _(metadata).wont_be_nil
  end

  it 'deserializes additional string properties' do
    json = '{"createdAt":"2024-01-01T00:00:00+0000","customField":"hello"}'
    metadata = {{moduleName}}::ObjectSerializer.deserialize(json, 'Metadata')

    _(metadata).wont_be_nil
    _(metadata).must_be_kind_of({{moduleName}}::Models::Metadata)
  end

  it 'captures and round-trips additionalProperties' do
    json = '{"createdAt":"2024-01-01T00:00:00+0000","customField":"hello","count":3}'
    metadata = {{moduleName}}::ObjectSerializer.deserialize(json, 'Metadata')

    # Undeclared keys are captured (not silently dropped) so a round-trip
    # preserves them, matching the SDKs that round-trip additionalProperties.
    _(metadata.additional_properties).must_equal('customField' => 'hello', 'count' => 3)

    data = JSON.parse({{moduleName}}::ObjectSerializer.serialize(metadata))
    _(data['customField']).must_equal('hello')
    _(data['count']).must_equal(3)
    _(data['createdAt']).wont_be_nil
  end
end

describe {{moduleName}}::Models::Metadata, 'round-trip and constants' do
  parallelize_me!

  it 'round-trip preserves known properties' do
    metadata = {{moduleName}}::Models::Metadata.new(
      created_at: Time.new(2024, 1, 1, 0, 0, 0, '+00:00')
    )
    json = {{moduleName}}::ObjectSerializer.serialize(metadata)
    data = JSON.parse(json)

    _(data['createdAt']).wont_be_nil
  end

  it 'defines ADDITIONAL_PROPERTIES constant' do
    _({{moduleName}}::Models::Metadata.const_defined?(:ADDITIONAL_PROPERTIES)).must_equal(true)
    _({{moduleName}}::Models::Metadata::ADDITIONAL_PROPERTIES).must_equal(true)
  end
end

describe 'gem manifest' do
  parallelize_me!

  # manifest-description-missing: the published gemspec must carry a
  # non-empty description (wired from the spec's appDescription, with a
  # generated fallback) so the gem does not publish with an empty
  # description on RubyGems.
  it 'declares a non-empty description' do
    gemspec_path = File.join(File.expand_path('..', __dir__), '{{gemName}}.gemspec')
    _(File.exist?(gemspec_path)).must_equal(true)

    spec = Gem::Specification.load(gemspec_path)
    _(spec).wont_be_nil
    _(spec.description).must_be_kind_of(String)
    _(spec.description.strip).wont_be_empty
  end

  # default-gem-undeclared: base64, json and set are required by the
  # generated runtime (object serializer, base API, authenticators) but
  # are default gems that Ruby is unbundling from the standard library
  # (base64 is no longer a default gem on Ruby 3.4+). They must be
  # declared explicitly so the gem keeps working once they are removed.
  it 'declares the default gems used by the runtime' do
    gemspec_path = File.join(File.expand_path('..', __dir__), '{{gemName}}.gemspec')
    _(File.exist?(gemspec_path)).must_equal(true)

    spec = Gem::Specification.load(gemspec_path)
    _(spec).wont_be_nil

    declared = spec.dependencies.map(&:name)
    %w[base64 json set].each do |gem_name|
      _(declared).must_include(gem_name)
    end
  end
end
