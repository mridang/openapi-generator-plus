# frozen_string_literal: true

require 'spec_helper'
require 'json'

describe {{moduleName}}::Models::Metadata do
  describe 'typed additional properties' do
    it 'deserializes additional string properties' do
      json = '{"createdAt":"2024-01-01T00:00:00+0000","customField":"hello"}'
      metadata = {{moduleName}}::ObjectSerializer.deserialize(json, 'Metadata')

      _(metadata).wont_be_nil
      _(metadata).must_be_kind_of({{moduleName}}::Models::Metadata)
    end

    it 'round-trip preserves known properties' do
      metadata = {{moduleName}}::Models::Metadata.new(
        created_at: Time.new(2024, 1, 1, 0, 0, 0, '+00:00')
      )
      json = {{moduleName}}::ObjectSerializer.serialize(metadata)
      data = JSON.parse(json)

      _(data['createdAt']).wont_be_nil
    end

    it 'defines ADDITIONAL_PROPERTIES constant' do
      _({{moduleName}}::Models::Metadata.const_defined?(:ADDITIONAL_PROPERTIES)).must_equal(true)
      _({{moduleName}}::Models::Metadata::ADDITIONAL_PROPERTIES).must_equal(true)
    end
  end
end
