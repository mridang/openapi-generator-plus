require 'minitest/autorun'
require 'json'
require 'uri'
require '{{gemName}}'

class FakeAuthCodeClient
  attr_reader :last_url, :last_body

  def initialize(responses)
    @responses = responses
    @call_index = 0
  end

  def send_request(_method, url, _headers, body)
    @last_url = url
    @last_body = body
    response = @responses[@call_index] || @responses.last
    @call_index += 1
    {{moduleName}}::ApiResponse.new(
      status_code: response[:status],
      body: response[:body].to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

describe {{moduleName}}::Auth::OAuth::OAuth2AuthorizationCodeAuthenticator do

  let(:auth) do
    {{moduleName}}::Auth::OAuth::OAuth2AuthorizationCodeAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/authorize',
      'https://auth.example.com/token',
      'https://app.example.com/callback',
      %w[read write]
    )
  end

  it 'builds authorization URL with required params' do
    url = auth.build_authorization_url
    _(url).must_include 'https://auth.example.com/authorize?'
    _(url).must_include 'response_type=code'
    _(url).must_include 'client_id=my_client_id'
    _(url).must_include 'redirect_uri='
    _(url).must_include 'scope=read+write'
  end

  it 'builds authorization URL with state' do
    url = auth.build_authorization_url('csrf_state_123')
    _(url).must_include 'state=csrf_state_123'
  end

  it 'exchanges code with correct grant type' do
    client = FakeAuthCodeClient.new([
      { status: 200, body: { 'access_token' => 'tok_abc', 'refresh_token' => 'ref_xyz', 'expires_in' => 3600 } }
    ])
    auth.api_client = client

    auth.exchange_code('auth_code_123')
    _(client.last_body).must_include 'grant_type=authorization_code'
    _(client.last_body).must_include 'code=auth_code_123'
    _(client.last_body).must_include 'client_id=my_client_id'
    _(client.last_body).must_include 'client_secret=my_client_secret'
  end

  it 'includes refresh token on refresh' do
    client = FakeAuthCodeClient.new([
      { status: 200, body: { 'access_token' => 'tok_abc', 'refresh_token' => 'ref_xyz', 'expires_in' => -1 } },
      { status: 200, body: { 'access_token' => 'tok_refreshed', 'expires_in' => 3600 } }
    ])
    auth.api_client = client

    auth.exchange_code('auth_code_123')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer tok_refreshed'
    _(client.last_body).must_include 'refresh_token=ref_xyz'
  end

  it 'throws before exchange code called' do
    assert_raises(RuntimeError) do
      auth.auth_headers
    end
  end

  it 'getHost returns configured host' do
    _(auth.host).must_equal 'https://api.example.com'
  end

  it 'auth_headers_before_exchange_returns_recoverable_error' do
    # Calling auth_headers before exchange_code is a precondition violation.
    # It must surface as a catchable exception so callers can recover --
    # not as a process crash.
    caught = nil
    begin
      auth.auth_headers
    rescue RuntimeError => e
      caught = e
    end
    _(caught).wont_be_nil

    # Caller continues normally after rescuing -- no process crash.
    _(auth.host).must_equal 'https://api.example.com'
  end
end
