# frozen_string_literal: true
# rubocop:disable all

{{>api_info}}

require 'minitest/autorun'
require '{{gemName}}'

describe {{moduleName}}::Auth::ApiKeyAuthenticator do
  parallelize_me!

  it 'valid header key is exposed via auth_headers' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-API-Key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    _(auth.auth_headers).must_equal({ 'X-API-Key' => 'abc123' })
  end

  it 'valid query key is exposed via query_params' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params).must_equal({ 'api_key' => 'abc123' })
  end

  it 'valid cookie key is exposed via cookie_params' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'session', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::COOKIE
    )
    _(auth.cookie_params).must_equal({ 'session' => 'abc123' })
  end

  it 'rejects an empty header key at construction' do
    err = _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', '', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
    _(err.message).must_include 'must not be empty'
  end

  it 'rejects an empty query key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'api_key', '', {{moduleName}}::Auth::ApiKeyLocation::QUERY
      )
    }).must_raise ArgumentError
  end

  it 'rejects an empty cookie key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'session', '', {{moduleName}}::Auth::ApiKeyLocation::COOKIE
      )
    }).must_raise ArgumentError
  end

  it 'rejects a whitespace-only key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', '   ', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  # CR/LF/NUL are forbidden control characters in ALL locations.
  it 'rejects CR/LF in a query key at construction' do
    err = _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'api_key', "abc\r\n", {{moduleName}}::Auth::ApiKeyLocation::QUERY
      )
    }).must_raise ArgumentError
    _(err.message).must_include 'forbidden control'
  end

  it 'rejects LF in a cookie key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'session', "abc\n", {{moduleName}}::Auth::ApiKeyLocation::COOKIE
      )
    }).must_raise ArgumentError
  end

  it 'rejects CR in a header key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', "abc\rdef", {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  # RFC 7230 §3.2.6 — the HEADER location must reject non-ASCII to prevent
  # silent UTF-8 mangling that varies per HTTP lib. Non-header locations
  # accept arbitrary chars.
  it 'HEADER location rejects a non-ASCII key' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-Api-Key', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  it 'QUERY location accepts a non-ASCII key' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params).must_equal({ 'api_key' => 'kéy' })
  end

  # authenticator-secret-in-default-string-repr: the default object
  # representation must mask the stored API key — the secret value must be
  # absent and a *** redaction marker present.
  it 'redacts the api key from inspect and to_s' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', 'super-secret-key', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    _(auth.inspect).wont_include 'super-secret-key'
    _(auth.to_s).wont_include 'super-secret-key'
    _("#{auth}").wont_include 'super-secret-key'
    _(auth.inspect).must_include '***'
  end
end
