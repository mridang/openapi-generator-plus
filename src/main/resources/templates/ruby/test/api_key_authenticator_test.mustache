# frozen_string_literal: true

{{>api_info}}

require 'minitest/autorun'
require '{{gemName}}'

describe {{moduleName}}::Auth::ApiKeyAuthenticator do
  parallelize_me!

  it 'bhv_authapikey_014 valid header key is exposed via auth_headers' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-API-Key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    _(auth.auth_headers).must_equal({ 'X-API-Key' => 'abc123' })
  end

  it 'bhv_authapikey_015 valid query key is exposed via query_params' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params).must_equal({ 'api_key' => 'abc123' })
  end

  it 'bhv_authapikey_013 valid cookie key is exposed via cookie_params' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'session', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::COOKIE
    )
    _(auth.cookie_params).must_equal({ 'session' => 'abc123' })
  end

  it 'bhv_authapikey_005 rejects an empty header key at construction' do
    err = _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', '', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
    _(err.message).must_include 'must not be empty'
  end

  it 'bhv_authapikey_006 rejects an empty query key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'api_key', '', {{moduleName}}::Auth::ApiKeyLocation::QUERY
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_004 rejects an empty cookie key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'session', '', {{moduleName}}::Auth::ApiKeyLocation::COOKIE
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_017 rejects a whitespace-only key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', '   ', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_011 rejects a key made only of ASCII whitespace such as a vertical tab' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'api_key', " \v\f", {{moduleName}}::Auth::ApiKeyLocation::QUERY
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_001 accepts a key made only of a Unicode space' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', "\u00A0\u2003", {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params['api_key']).must_equal "\u00A0\u2003"
  end

  # CR/LF/NUL are forbidden control characters in ALL locations.
  it 'bhv_authapikey_003 rejects CR/LF in a query key at construction' do
    err = _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'api_key', "abc\r\n", {{moduleName}}::Auth::ApiKeyLocation::QUERY
      )
    }).must_raise ArgumentError
    _(err.message).must_include 'forbidden control'
  end

  it 'bhv_authapikey_002 rejects LF in a cookie key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'session', "abc\n", {{moduleName}}::Auth::ApiKeyLocation::COOKIE
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_018 rejects CR in a header key at construction' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-API-Key', "abc\rdef", {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  # RFC 7230 §3.2.6 — the HEADER location must reject non-ASCII to prevent
  # silent UTF-8 mangling that varies per HTTP lib. Non-header locations
  # accept arbitrary chars.
  it 'bhv_authapikey_008 HEADER location rejects a non-ASCII key' do
    _(-> {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-Api-Key', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::HEADER
      )
    }).must_raise ArgumentError
  end

  it 'bhv_authapikey_009 QUERY location accepts a non-ASCII key' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params).must_equal({ 'api_key' => 'kéy' })
  end

  # authenticator-secret-in-default-string-repr: the default object
  # representation must mask the stored API key — the secret value must be
  # absent and a *** redaction marker present.
  it 'bhv_authapikey_010 redacts the api key from inspect and to_s' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', 'super-secret-key', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    _(auth.inspect).wont_include 'super-secret-key'
    _(auth.to_s).wont_include 'super-secret-key'
    _("#{auth}").wont_include 'super-secret-key'
    _(auth.inspect).must_include '***'
  end

  it 'names the reason in each rejection' do
    location = {{moduleName}}::Auth::ApiKeyLocation
    # @type var cases: Array[untyped]
    cases = [
      ['', location::HEADER, "API key value for 'X-API-Key' must not be empty"],
      ['   ', location::QUERY, "API key value for 'X-API-Key' must not be empty"],
      ["abc\r\n", location::COOKIE, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"],
      ["abc\0def", location::QUERY, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"],
      ['kéy', location::HEADER, "API key for header 'X-API-Key' must contain only printable ASCII characters (RFC 7230 §3.2.6)"]
    ]
    cases.each do |key, where, message|
      err = _(-> { {{moduleName}}::Auth::ApiKeyAuthenticator.new('https://api.example.com', 'X-API-Key', key, where) }).must_raise ArgumentError
      _(err.message).must_equal message
    end
  end

  it 'bhv_authapikey_023 a cookie key accepts a non-ASCII value' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'session', 'kéy', {{moduleName}}::Auth::ApiKeyLocation::COOKIE
    )
    _(auth.cookie_params).must_equal({ 'session' => 'kéy' })
  end

  it 'bhv_authapikey_022 emits a key only at its own location' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    _(auth.auth_headers).must_equal({ 'X-Api-Key' => 'abc123' })
    _(auth.query_params).must_be_empty
    _(auth.cookie_params).must_be_empty
  end

  it 'bhv_authapikey_012 shows the host, key name and location but not the key in inspect' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', 'super-secret-key', {{moduleName}}::Auth::ApiKeyLocation::HEADER
    )
    location = {{moduleName}}::Auth::ApiKeyLocation::HEADER.inspect
    _(auth.inspect).must_equal(
      "#<#{auth.class.name} host=\"https://api.example.com\" key_param_name=\"X-Api-Key\" " \
      "api_key=\"***\" location=#{location}>"
    )
  end

  it 'bhv_authapikey_021 reads the key from the environment variable when none is given' do
    prefix = {{moduleName}}::Auth::BaseAuthenticator::ENV_PREFIX
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', nil, {{moduleName}}::Auth::ApiKeyLocation::HEADER,
      env: { "#{prefix}_API_KEY" => 'from-env' }
    )

    _(auth.auth_headers).must_equal('X-Api-Key' => 'from-env')
  end

  it 'bhv_serializationobject_187 prefers the key given to the environment variable' do
    prefix = {{moduleName}}::Auth::BaseAuthenticator::ENV_PREFIX
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', 'explicit', {{moduleName}}::Auth::ApiKeyLocation::HEADER,
      env: { "#{prefix}_API_KEY" => 'from-env' }
    )

    _(auth.auth_headers).must_equal('X-Api-Key' => 'explicit')
  end

  it 'fails at construction when the key is neither given nor in the environment' do
    prefix = {{moduleName}}::Auth::BaseAuthenticator::ENV_PREFIX
    error = _(lambda {
      {{moduleName}}::Auth::ApiKeyAuthenticator.new(
        'https://api.example.com', 'X-Api-Key', nil, {{moduleName}}::Auth::ApiKeyLocation::HEADER,
        env: { "#{prefix}_API_KEY" => '' }
      )
    }).must_raise ArgumentError

    _(error.message).must_equal "Missing API key for 'X-Api-Key': pass it or set the environment variable #{prefix}_API_KEY"
  end

  it 'reads the variable it is told to read, and no other' do
    prefix = {{moduleName}}::Auth::BaseAuthenticator::ENV_PREFIX
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', nil, {{moduleName}}::Auth::ApiKeyLocation::HEADER,
      env: { "#{prefix}_API_KEY" => 'generic', 'OTHER_KEY' => 'from-other' }, api_key_env: 'OTHER_KEY'
    )

    _(auth.auth_headers).must_equal('X-Api-Key' => 'from-other')
  end

  it 'reads the environment once, at construction' do
    env = { 'OTHER_KEY' => 'first' }
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'X-Api-Key', nil, {{moduleName}}::Auth::ApiKeyLocation::HEADER,
      env: env, api_key_env: 'OTHER_KEY'
    )
    env['OTHER_KEY'] = 'second'

    _(auth.auth_headers).must_equal('X-Api-Key' => 'first')
  end

  it 'bhv_authapikey_016 passes a valid query key at construction' do
    auth = {{moduleName}}::Auth::ApiKeyAuthenticator.new(
      'https://api.example.com', 'api_key', 'abc123', {{moduleName}}::Auth::ApiKeyLocation::QUERY
    )
    _(auth.query_params).must_equal({ 'api_key' => 'abc123' })
  end
end
