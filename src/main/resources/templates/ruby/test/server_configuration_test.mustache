# frozen_string_literal: true

{{>api_info}}

require 'minitest/autorun'
require '{{gemName}}'

describe {{moduleName}}::ServerConfiguration do
  parallelize_me!

  it 'bhv_servers_011 returns the template unchanged when there are no variables' do
    config = {{moduleName}}::ServerConfiguration.new(url_template: 'https://api.example.com/v1')
    _(config.url).must_equal 'https://api.example.com/v1'
  end

  it 'substitutes default variable values when no overrides are given' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com/v{version}',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod'),
        'version' => {{moduleName}}::ServerVariable.new(default_value: '2')
      }
    )
    _(config.url).must_equal 'https://prod.api.example.com/v2'
  end

  it 'bhv_servers_010 substitutes overrides in place of default values' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com/v{version}',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod'),
        'version' => {{moduleName}}::ServerVariable.new(default_value: '2')
      }
    )
    _(config.url({ 'env' => 'staging' })).must_equal 'https://staging.api.example.com/v2'
  end

  it 'bhv_servers_009 uses the default for variables absent from the overrides' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com/v{version}',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod'),
        'version' => {{moduleName}}::ServerVariable.new(default_value: '2')
      }
    )
    _(config.url({ 'version' => '3' })).must_equal 'https://prod.api.example.com/v3'
  end

  it 'substitutes a value containing backslash sequences literally' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{host}.example.com/{host}',
      variables: { 'host' => {{moduleName}}::ServerVariable.new(default_value: 'prod') }
    )
    _(config.url({ 'host' => 'a\\0b\\&c' })).must_equal 'https://a\\0b\\&c.example.com/a\\0b\\&c'
  end

  it 'bhv_servers_005 does not expand a placeholder that a substituted value introduces' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com/{version}',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod'),
        'version' => {{moduleName}}::ServerVariable.new(default_value: 'v2')
      }
    )
    _(config.url({ 'env' => '{version}' })).must_equal 'https://{version}.api.example.com/v2'
  end

  it 'leaves an undeclared placeholder in the template as written' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com/{unknown}',
      variables: { 'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod') }
    )
    _(config.url).must_equal 'https://prod.api.example.com/{unknown}'
  end

  it 'bhv_servers_003 accepts an override value that is in the variable enum' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod', enum_values: %w[prod staging])
      }
    )
    _(config.url({ 'env' => 'staging' })).must_equal 'https://staging.api.example.com'
  end

  it 'bhv_servers_008 rejects an override value that is not in the variable enum' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod', enum_values: %w[prod staging])
      }
    )
    err = _(-> { config.url({ 'env' => 'dev' }) }).must_raise ArgumentError
    _(err).must_be_instance_of ArgumentError
    _(err).wont_be_kind_of {{apiErrorParent}}
    _(err.message).must_include 'dev'
    _(err.message).must_include 'env'
  end

  it 'bhv_servers_006 exposes the raw url_template, description, and variables' do
    variables = { 'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod') }
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      description: 'Primary server',
      variables: variables
    )
    _(config.url_template).must_equal 'https://{env}.api.example.com'
    _(config.description).must_equal 'Primary server'
    _(config.variables).must_equal variables
  end

  it 'is immutable and freezes its variables map' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://api.example.com',
      variables: { 'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod') }
    )
    _(config).must_be :frozen?
    _(config.variables).must_be :frozen?
  end

  it 'bhv_servers_012 names the value, the variable and the allowed values when an override is rejected' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod', enum_values: %w[prod staging])
      }
    )
    err = _(-> { config.url({ 'env' => 'dev' }) }).must_raise ArgumentError
    _(err.message).must_equal "Invalid value 'dev' for server variable 'env'. Allowed values: [prod, staging]"
  end

  it 'bhv_servers_004 rejects a default value that is not in the variable enum' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      variables: {
        'env' => {{moduleName}}::ServerVariable.new(default_value: 'qa', enum_values: %w[prod staging])
      }
    )
    err = _(-> { config.url }).must_raise ArgumentError
    _(err.message).must_equal "Invalid value 'qa' for server variable 'env'. Allowed values: [prod, staging]"
  end

  it 'bhv_servers_014 accepts any override for a variable that declares no enum' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{region}.api.example.com',
      variables: { 'region' => {{moduleName}}::ServerVariable.new(default_value: 'eu') }
    )
    _(config.url({ 'region' => 'anything-goes' })).must_equal 'https://anything-goes.api.example.com'
  end

  it 'bhv_servers_007 leaves an unknown override out of the URL' do
    config = {{moduleName}}::ServerConfiguration.new(
      url_template: 'https://{env}.api.example.com',
      variables: { 'env' => {{moduleName}}::ServerVariable.new(default_value: 'prod') }
    )
    _(config.url({ 'unknown' => 'x' })).must_equal 'https://prod.api.example.com'
  end
end
