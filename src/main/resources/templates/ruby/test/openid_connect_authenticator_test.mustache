require 'minitest/autorun'
require 'json'
require '{{gemName}}'

class FakeOidcClient
  attr_reader :requests

  def initialize(responses)
    @responses = responses
    @requests = []
  end

  def send_request(method, url, headers, body)
    @requests << { method: method, url: url, headers: headers, body: body }
    response = @responses.shift || @responses.last
    {{moduleName}}::ApiResponse.new(
      status_code: response[:status],
      body: response[:body].is_a?(String) ? response[:body] : response[:body].to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

describe {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator do

  let(:discovery_response) do
    {
      status: 200,
      body: {
        'authorization_endpoint' => 'https://auth.example.com/authorize',
        'token_endpoint' => 'https://auth.example.com/token'
      }
    }
  end

  let(:token_response) do
    { status: 200, body: { 'access_token' => 'oidc_tok', 'refresh_token' => 'oidc_ref', 'expires_in' => 3600 } }
  end

  it 'builds authorization URL from discovery' do
    client = FakeOidcClient.new([discovery_response])
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid profile]
    )
    auth.api_client = client

    url = auth.build_authorization_url('state_abc')
    _(url).must_include 'https://auth.example.com/authorize?'
    _(url).must_include 'response_type=code'
    _(url).must_include 'client_id=my_client_id'
    _(url).must_include 'state=state_abc'
    _(url).must_include 'scope=openid+profile'
  end

  it 'fetches discovery document' do
    client = FakeOidcClient.new([discovery_response])
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid]
    )
    auth.api_client = client

    auth.build_authorization_url
    _(client.requests.first[:url]).must_equal 'https://auth.example.com/.well-known/openid-configuration'
    _(client.requests.first[:method]).must_equal :get
  end

  it 'obtains token after code exchange' do
    client = FakeOidcClient.new([discovery_response, token_response])
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid]
    )
    auth.api_client = client

    auth.exchange_code('oidc_code_123')
    token_request = client.requests[1]
    _(token_request[:url]).must_equal 'https://auth.example.com/token'
    _(token_request[:body]).must_include 'grant_type=authorization_code'
    _(token_request[:body]).must_include 'code=oidc_code_123'
  end

  it 'getAuthHeaders returns Bearer after exchange' do
    client = FakeOidcClient.new([discovery_response, token_response])
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid]
    )
    auth.api_client = client

    auth.exchange_code('oidc_code_123')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer oidc_tok'
  end

  it 'throws when no ApiClient injected' do
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid]
    )

    assert_raises(RuntimeError) do
      auth.build_authorization_url
    end
  end

  it 'getHost returns configured host' do
    auth = {{moduleName}}::Auth::OAuth::OpenIdConnectAuthenticator.new(
      'https://api.example.com',
      'https://auth.example.com/.well-known/openid-configuration',
      'my_client_id',
      'my_client_secret',
      'https://app.example.com/callback',
      %w[openid]
    )
    _(auth.host).must_equal 'https://api.example.com'
  end
end
