# frozen_string_literal: true

{{>api_info}}

require 'minitest/autorun'
require '{{gemName}}'

describe {{moduleName}}::Auth::BearerAuthenticator do
  parallelize_me!

  it 'bhv_authbearer_009 raw token is prefixed with Bearer' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'xyz')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer xyz'
  end

  it 'bhv_authbearer_003 already-prefixed token is not doubled' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'Bearer xyz')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer xyz'
  end

  it 'bhv_authbearer_007 lowercase bearer prefix is stripped' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'bearer xyz')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer xyz'
  end

  it 'bhv_authbearer_008 mixed-case bearer prefix is stripped' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'BeArEr xyz')
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer xyz'
  end

  it 'bhv_authbearer_015 a token that merely begins with the letters bearer is kept whole' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'bearerxyz')
    _(auth.auth_headers['Authorization']).must_equal 'Bearer bearerxyz'
  end

  it 'bhv_authbearer_004 a doubled prefix is stripped only once' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'Bearer Bearer xyz')
    _(auth.auth_headers['Authorization']).must_equal 'Bearer Bearer xyz'
  end

  # bearer-no-empty-token-guard: an empty/whitespace token would emit a bare
  # "Authorization: Bearer " header, sending the request unauthenticated, so
  # the constructor must reject it.
  it 'bhv_authbearer_005 rejects an empty token' do
    error = _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', '') }).must_raise ArgumentError
    _(error.message).must_include 'Bearer token must not be empty'
  end

  it 'bhv_authbearer_017 rejects a whitespace-only token' do
    _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', '   ') }).must_raise ArgumentError
  end

  # A Unicode space is not ASCII blank, so the printable-ASCII rule rejects it
  # rather than the empty-token rule.
  it 'bhv_authbearer_016 a Unicode space is not blank, it fails the printable ASCII check instead' do
    error = _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', "\u00A0")
    }).must_raise ArgumentError
    _(error.message).must_equal 'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
  end

  # RFC 7230 §3.2.6 — Bearer tokens commonly arrive with trailing newlines
  # from .env / file reads, which would CRLF-inject the Authorization header.
  # Also reject non-ASCII.
  it 'bhv_authbearer_012 rejects CR/LF in the token' do
    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', "tok\r\nInjected: yes")
    }).must_raise ArgumentError
  end

  it 'bhv_authbearer_028 rejects a bearer token containing CRLF at construction' do
    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', "tok\r\nInjected: yes")
    }).must_raise ArgumentError
  end

  it 'bhv_authbearer_022 rejects a non-ASCII token' do
    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'ñoño')
    }).must_raise ArgumentError
  end

  # authenticator-secret-in-default-string-repr: the default object
  # representation must mask the stored token — the secret value must be absent
  # and a *** redaction marker present.
  it 'bhv_authbearer_011 redacts the token from inspect and to_s' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'super-secret-token')
    _(auth.inspect).wont_include 'super-secret-token'
    _(auth.to_s).wont_include 'super-secret-token'
    _("#{auth}").wont_include 'super-secret-token'
    _(auth.inspect).must_include '***'
    _(auth.inspect).must_include 'host='
  end

  it 'bhv_authbearer_001 names the reason in each rejection' do
    cases = {
      '' => 'Bearer token must not be empty',
      "tok\r\nInjected: yes" => 'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)',
      'ñoño' => 'Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)'
    }
    cases.each do |token, message|
      err = _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', token) }).must_raise ArgumentError
      _(err.message).must_equal message
    end
  end

  it 'bhv_authbearer_013 shows the host but not the token in inspect' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'super-secret-token')
    _(auth.inspect).must_equal "#<#{auth.class.name} host=\"https://api.example.com\" token=\"***\">"
  end

  describe 'credential sources' do
    let(:prefix) { {{moduleName}}::Auth::BaseAuthenticator::ENV_PREFIX }

    it 'bhv_authbearer_010 reads the token from the environment variable when none is given' do
      auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: { "#{prefix}_TOKEN" => 'from-env' })

      _(auth.auth_headers['Authorization']).must_equal 'Bearer from-env'
    end

    it 'bhv_authbearer_018 prefers the token given to the environment variable' do
      auth = {{moduleName}}::Auth::BearerAuthenticator.new(
        'https://api.example.com', 'explicit', env: { "#{prefix}_TOKEN" => 'from-env' }
      )

      _(auth.auth_headers['Authorization']).must_equal 'Bearer explicit'
    end

    it 'bhv_authscheme_003 treats an empty environment variable as unset' do
      error = _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: { "#{prefix}_TOKEN" => '' }) })
              .must_raise ArgumentError

      _(error.message).must_equal "Missing Bearer token: pass it or set the environment variable #{prefix}_TOKEN"
    end

    it 'bhv_authbearer_019 an empty token variable counts as unset and fails construction naming it' do
      error = _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: { "#{prefix}_TOKEN" => '' }) })
              .must_raise ArgumentError

      _(error.message).must_include "#{prefix}_TOKEN"
    end

    it 'bhv_lifecycle_013 fails at construction when there is no token at all' do
      error = _(-> { {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: {}) }).must_raise ArgumentError

      _(error.message).must_equal "Missing Bearer token: pass it or set the environment variable #{prefix}_TOKEN"
    end

    it 'bhv_authbearer_025 reads the environment variable once, at construction' do
      env = { "#{prefix}_TOKEN" => 'first' }
      auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: env)
      env["#{prefix}_TOKEN"] = 'second'

      _(auth.auth_headers['Authorization']).must_equal 'Bearer first'
    end

    it 'bhv_auth_022 prefers the environment variable to the token provider' do
      auth = {{moduleName}}::Auth::BearerAuthenticator.new(
        'https://api.example.com', token_provider: -> { 'from-provider' }, env: { "#{prefix}_TOKEN" => 'from-env' }
      )

      _(auth.auth_headers['Authorization']).must_equal 'Bearer from-env'
    end

    it 'asks the token provider for every request when neither a token nor the variable is set' do
      calls = 0
      provider = -> { "token-#{calls += 1}" }
      auth = {{moduleName}}::Auth::BearerAuthenticator.new(
        'https://api.example.com', token_provider: provider, env: { "#{prefix}_TOKEN" => '' }
      )

      _(auth.auth_headers['Authorization']).must_equal 'Bearer token-1'
      _(auth.auth_headers['Authorization']).must_equal 'Bearer token-2'
    end

    it 'reads the variable it is told to read, and no other' do
      env = { "#{prefix}_TOKEN" => 'generic', 'OTHER_TOKEN' => 'from-other' }
      auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: env, token_env: 'OTHER_TOKEN')

      _(auth.auth_headers['Authorization']).must_equal 'Bearer from-other'
      error = _(lambda do
        {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', env: env, token_env: 'MISSING_TOKEN')
      end).must_raise ArgumentError
      _(error.message).must_equal 'Missing Bearer token: pass it or set the environment variable MISSING_TOKEN'
    end

    it 'bhv_authbearer_014 rejects an empty token from the provider when the request is made' do
      auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', token_provider: -> { '' })

      _(-> { auth.auth_headers }).must_raise ArgumentError
    end
  end

  it 'bhv_authbearer_026 a token and a token provider passed together are refused' do
    _(-> {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', 'explicit', token_provider: -> { 'from-provider' })
    }).must_raise ArgumentError
  end

  it 'bhv_authbearer_002 validates a token from the provider like a fixed token' do
    auth = {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', token_provider: -> { "bad\ntoken" })

    _(-> { auth.auth_headers }).must_raise ArgumentError
  end
end

describe 'BearerAuthenticator', 'token refusal at construction' do
  parallelize_me!

  it 'bhv_auth_009 refuses an access token that contains a carriage return or line feed' do
    _(lambda {
      {{moduleName}}::Auth::BearerAuthenticator.new('https://api.example.com', "xy\r\nz")
    }).must_raise ArgumentError
  end
end
