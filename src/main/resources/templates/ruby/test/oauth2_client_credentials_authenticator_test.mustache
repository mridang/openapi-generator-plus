# frozen_string_literal: true

{{>api_info}}

# rubocop:disable Metrics/BlockLength, Lint/MissingCopEnableDirective

require 'minitest/autorun'
require 'base64'
require 'json'
require '{{gemName}}'

class FakeClientCredentialsClient
  attr_reader :last_url, :last_body, :last_headers

  def send_request(_method, url, headers, body, no_redirect: false) # rubocop:disable Lint/UnusedMethodArgument
    @last_url = url
    @last_headers = headers
    @last_body = body
    {{moduleName}}::ApiResponse.new(
      status_code: 200,
      body: { 'access_token' => 'cc_tok_abc', 'expires_in' => 3600 }.to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

describe {{moduleName}}::Auth::OAuth::OAuth2ClientCredentialsAuthenticator do
  parallelize_me!

  let(:client) { FakeClientCredentialsClient.new }

  let(:auth) do
    a = {{moduleName}}::Auth::OAuth::OAuth2ClientCredentialsAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      %w[read write]
    )
    a.api_client = client
    a
  end

  it 'sends client credentials grant type' do
    auth.auth_headers
    _(client.last_body).must_include 'grant_type=client_credentials'
  end

  it 'sends client id and secret' do
    auth.auth_headers
    _(client.last_body).must_include 'client_id=my_client_id'
    _(client.last_body).must_include 'client_secret=my_client_secret'
  end

  it 'sends scopes' do
    auth.auth_headers
    _(client.last_body).must_include 'scope=read+write'
  end

  it 'returns authorization bearer header' do
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer cc_tok_abc'
  end

  it 'sends request to token URL' do
    auth.auth_headers
    _(client.last_url).must_equal 'https://auth.example.com/token'
  end

  it 'getHost returns configured host' do
    _(auth.host).must_equal 'https://api.example.com'
  end

  it 'basic auth url-encodes client id and secret' do
    # Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
    # client_id and client_secret MUST be application/x-www-form-
    # urlencoded BEFORE being joined with ':' and base64-encoded.
    basic_client = FakeClientCredentialsClient.new
    basic_auth = {{moduleName}}::Auth::OAuth::OAuth2ClientCredentialsAuthenticator.new(
      'https://api.example.com',
      'id+with/special',
      'secret&with=stuff',
      'https://auth.example.com/token',
      %w[read],
      client_auth_method: {{moduleName}}::Auth::OAuth::ClientAuthMethod::BASIC
    )
    basic_auth.api_client = basic_client

    basic_auth.auth_headers

    auth_header = basic_client.last_headers['Authorization']
    _(auth_header).wont_be_nil
    _(auth_header.start_with?('Basic ')).must_equal true
    decoded = Base64.strict_decode64(auth_header.sub(/\ABasic /, ''))
    _(decoded).must_equal 'id%2Bwith%2Fspecial:secret%26with%3Dstuff'
  end
end
