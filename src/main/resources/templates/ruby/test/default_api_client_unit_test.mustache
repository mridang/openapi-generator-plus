  # A self-signed CA certificate for the trust-store tests below.
  def self_signed_ca(name)
    key = OpenSSL::PKey::RSA.new(2048)
    ca = OpenSSL::X509::Certificate.new
    ca.version = 2
    ca.serial = 1
    ca.subject = ca.issuer = OpenSSL::X509::Name.parse("/CN=#{name}")
    ca.public_key = key.public_key
    ca.not_before = Time.now - 60
    ca.not_after = Time.now + 3600
    factory = OpenSSL::X509::ExtensionFactory.new
    factory.subject_certificate = ca
    factory.issuer_certificate = ca
    ca.add_extension(factory.create_extension('basicConstraints', 'CA:TRUE', true))
    ca.sign(key, OpenSSL::Digest.new('SHA256')) # steep:ignore ArgumentTypeMismatch
    ca
  end

  it 'bhv_transport_066 a CA bundle file trusts every certificate it contains' do
    cas = [self_signed_ca('bundle-one'), self_signed_ca('bundle-two')]
    file = Tempfile.new(['bundle', '.pem'])
    file.write(cas.map(&:to_pem).join)
    file.close

    transport = {{moduleName}}::TransportOptions.builder.ca_cert_path(file.path).build
    ssl = {{moduleName}}::DefaultApiClient.new(transport).send(:build_connection).ssl
    _(ssl.ca_file).must_equal file.path
    store = OpenSSL::X509::Store.new
    store.add_file(ssl.ca_file)
    cas.each { |ca| _(store.verify(ca)).must_equal true }
  end

  # A configured CA pins trust to that CA alone: the connection gets an empty
  # certificate store, because faraday-net_http would otherwise seed an unset
  # one with the system roots and accept public CAs as well.
  it 'bhv_transport_065 a configured CA bundle replaces the system trust store instead of adding to it' do
    key = OpenSSL::PKey::RSA.new(2048)
    ca = OpenSSL::X509::Certificate.new
    ca.version = 2
    ca.serial = 1
    ca.subject = ca.issuer = OpenSSL::X509::Name.parse('/CN=pinned-test-ca')
    ca.public_key = key.public_key
    ca.not_before = Time.now - 60
    ca.not_after = Time.now + 3600
    ca.sign(key, OpenSSL::Digest.new('SHA256')) # steep:ignore ArgumentTypeMismatch
    file = Tempfile.new(['ca', '.pem'])
    file.write(ca.to_pem)
    file.close

    transport = {{moduleName}}::TransportOptions.builder.ca_cert_path(file.path).build
    ssl = {{moduleName}}::DefaultApiClient.new(transport).send(:build_connection).ssl
    _(ssl.ca_file).must_equal file.path
    store = ssl.cert_store
    _(store).must_be_instance_of OpenSSL::X509::Store
    _(store.verify(ca)).must_equal false
    system_bundle = OpenSSL::X509::DEFAULT_CERT_FILE
    if File.file?(system_bundle)
      root = OpenSSL::X509::Certificate.new(File.read(system_bundle))
      _(store.verify(root)).must_equal false
    end
  ensure
    file&.unlink
  end

  it 'bhv_misc_033 a pinned CA file holding only the root accepts a server that also sends the intermediate' do
    issue = lambda do |subject, key, signer, signer_key, ca|
      cert = OpenSSL::X509::Certificate.new
      cert.version = 2
      cert.serial = OpenSSL::BN.new(Random.rand(2..(2**31)).to_s)
      cert.subject = OpenSSL::X509::Name.parse("/CN=#{subject}")
      cert.issuer = signer ? signer.subject : cert.subject
      cert.public_key = key.public_key
      cert.not_before = Time.now - 60
      cert.not_after = Time.now + 3600
      factory = OpenSSL::X509::ExtensionFactory.new(signer || cert, cert)
      cert.add_extension(factory.create_extension('basicConstraints', ca ? 'CA:TRUE' : 'CA:FALSE', true))
      cert.add_extension(factory.create_extension('subjectAltName', 'DNS:localhost,IP:127.0.0.1')) unless ca
      cert.sign(signer_key || key, OpenSSL::Digest.new('SHA256')) # steep:ignore ArgumentTypeMismatch
      cert
    end
    root_key = OpenSSL::PKey::RSA.new(2048)
    intermediate_key = OpenSSL::PKey::RSA.new(2048)
    leaf_key = OpenSSL::PKey::RSA.new(2048)
    root = issue.call('bhv-root-ca', root_key, nil, nil, true)
    intermediate = issue.call('bhv-intermediate-ca', intermediate_key, root, root_key, true)
    leaf = issue.call('localhost', leaf_key, intermediate, intermediate_key, false)

    tcp = TCPServer.new('127.0.0.1', 0) # steep:ignore UnexpectedPositionalArgument
    port = tcp.addr[1]
    context = OpenSSL::SSL::SSLContext.new
    context.cert = leaf
    context.key = leaf_key
    context.extra_chain_cert = [intermediate]
    tls = OpenSSL::SSL::SSLServer.new(tcp, context)
    thread = Thread.new do
      conn = tls.accept
      conn.gets
      while (line = conn.gets)
        break if line.strip.empty?
      end
      conn.write("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
      conn.close
    rescue StandardError
      nil
    end
    file = Tempfile.new(['root', '.pem'])
    file.write(root.to_pem)
    file.close
    transport = {{moduleName}}::TransportOptions.builder.ca_cert_path(file.path).build

    response = {{moduleName}}::DefaultApiClient.new(transport).send_request('GET', "https://127.0.0.1:#{port}/ping", {}, nil)
    _(response.status_code).must_equal 200
  ensure
    tls&.close
    thread&.join(5)
    file&.unlink
  end

