  # ── a body that fails after the response head arrived ──
  # Serves one connection on a loopback port: reads the request head, then lets
  # the block write whatever the scenario needs before the socket is closed.
  def serve_once(&block)
    server = TCPServer.new('127.0.0.1', 0) # steep:ignore UnexpectedPositionalArgument
    port = server.addr[1]
    thread = Thread.new do
      socket = server.accept
      loop { break if socket.gets.to_s.strip.empty? }
      block.call(socket)
    ensure
      socket&.close
      server.close
    end
    [port, thread]
  end

