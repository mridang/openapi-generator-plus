  # ── F823: automatic retries with backoff ──
  #
  # The stub answers every attempt through +respond+ (called with the attempt
  # number), the recorded pauses replace real sleeping, and +envs+ keeps each
  # attempt's request.
  def run_retry_probe(options: nil, verb: :get, headers: {}, body: nil, retry_headers: nil, random: nil,
                      call_max_retries: nil, call_timeout: nil, &respond)
    envs = []
    delays = []
    # The request body as sent: the stub rewrites env.body with the response.
    @sent_bodies = []
    # One stub per possible attempt: the adapter consumes a stub per request.
    stubs = Faraday::Adapter::Test::Stubs.new do |stub|
      10.times do
        stub.public_send(verb, '/r') do |env|
          envs << env
          @sent_bodies << env.body
          respond.call(envs.length)
        end
      end
    end
    client = {{moduleName}}::DefaultApiClient.new(options || {{moduleName}}::TransportOptions.builder.build)
    client.define_singleton_method(:pause) { |seconds| delays << seconds }
    client.define_singleton_method(:rand) { |*_args| random } unless random.nil?
    outcome = nil
    client.stub(:build_connection, stub_connection(stubs)) do
      outcome = begin
        client.send_request(verb, 'http://localhost/r', headers, body, retry_headers: retry_headers,
                                                                       max_retries: call_max_retries,
                                                                       timeout: call_timeout)
      rescue {{moduleName}}::Errors::NetworkError => e
        e
      end
    end
    [outcome, envs, delays]
  end

