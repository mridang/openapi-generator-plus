  it 'bhv_retries_048 the default client retries a 503 over a real connection and returns the later success' do
    server = TCPServer.new('127.0.0.1', 0) # steep:ignore UnexpectedPositionalArgument
    port = server.addr[1]
    replies = [
      "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 4\r\nConnection: close\r\n\r\nbusy",
      "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
    ]
    thread = Thread.new do
      replies.each do |raw|
        conn = server.accept
        conn.gets
        while (line = conn.gets)
          break if line.strip.empty?
        end
        conn.write(raw)
        conn.close
      end
    end

    outcome = {{moduleName}}::DefaultApiClient.new.send_request('GET', "http://127.0.0.1:#{port}/r", {}, nil)
    thread.join
    server.close

    _(outcome.status_code).must_equal 200
    _(outcome.body).must_equal 'ok'
  end

