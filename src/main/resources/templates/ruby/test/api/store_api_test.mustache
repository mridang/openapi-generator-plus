  # Starts a one-shot TCP server that records the real outgoing request line
  # and headers (lower-cased names), then answers 200 with the given JSON
  # +response_body+. The returned Queue receives one { request_line:, headers: }
  # Hash.
  def capture_wire_request(response_body)
    server = TCPServer.new('127.0.0.1', 0) # steep:ignore UnexpectedPositionalArgument
    port = server.addr[1]
    captured = Queue.new
    thread = Thread.new do
      client = begin
        server.accept
      rescue StandardError
        next
      end
      request_line = client.gets.to_s.strip
      headers = {}
      while (line = client.gets)
        break if line.strip.empty?

        name, value = line.split(':', 2)
        headers[name.to_s.strip.downcase] = value.to_s.strip
      end
      captured << { request_line: request_line, headers: headers }
      client.print("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n" \
                   "Content-Length: #{response_body.bytesize}\r\nConnection: close\r\n\r\n#{response_body}")
      client.close
    end
    config = {{moduleName}}::Configuration.new(base_url: "http://127.0.0.1:#{port}", default_headers: {})
    [{{moduleName}}::Api::StoreApi.new(nil, config), server, thread, captured]
  end

  describe '#search_store content-encoded query' do
    it 'encodes the q value through the SDK serializer as compact JSON' do
      api, server, thread, captured = capture_wire_request('[]')
      begin
        query = {{moduleName}}::Models::PhotoMetadata.new(caption: "a/b<é")
        api.search_store({{moduleName}}::Api::Options::SearchStoreOptions.new(q: query))
        request_line = captured.pop[:request_line]
        _(request_line).must_include 'q=%7B%22caption%22%3A%22a%2Fb%3C%C3%A9%22%7D'
      ensure
        server.close
        thread.join(2)
      end
    end

    it 'raises SerializationError for an unserializable q and sends nothing' do
      api, server, thread, captured = capture_wire_request('[]')
      begin
        query = {{moduleName}}::Models::PhotoMetadata.new(caption: 'c', location: { 'lat' => Float::NAN })
        _ { api.search_store({{moduleName}}::Api::Options::SearchStoreOptions.new(q: query)) }
          .must_raise({{moduleName}}::Errors::SerializationError)
        _(captured.empty?).must_equal(true)
      ensure
        server.close
        thread.join(2)
      end
    end
  end

  describe '#search_store uniqueItems query' do
    it 'expands a Set of labels into one pair per element' do
      api, server, thread, captured = capture_wire_request('[]')
      begin
        api.search_store({{moduleName}}::Api::Options::SearchStoreOptions.new(labels: Set['red', 'blue']))
        request_line = captured.pop[:request_line]
        query = request_line.split[1].to_s.split('?', 2).last.to_s
        _(query.split('&').sort).must_equal(%w[labels=blue labels=red])
      ensure
        server.close
        thread.join(2)
      end
    end
  end

