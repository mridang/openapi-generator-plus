  describe 'per-call auth override' do
    # capture_auth_header: spin up a one-shot TCP server that records the
    # Authorization header (if any) of the first request and returns a
    # minimal Pet JSON body so the body-returning convenience method is happy.
    def capture_auth_header
      server = TCPServer.new('127.0.0.1', 0)
      port = server.addr[1]
      captured = Queue.new
      thread = Thread.new do
        client = server.accept rescue next
        client.gets # request line
        saw_auth = false
        while (line = client.gets)
          if line.downcase.start_with?('authorization:')
            captured << line
            saw_auth = true
          end
          break if line.strip.empty?
        end
        captured << :none unless saw_auth
        body = '{"id":1,"name":"x","photoUrls":[]}'
        response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n" \
                   "Content-Length: #{body.bytesize}\r\nConnection: close\r\n\r\n#{body}"
        client.print(response)
        client.close
      end
      [server, port, thread, captured]
    end

    # per-call-auth-override: an authenticator carried INSIDE the Options
    # object must be applied to the outgoing request. The default header
    # carries one token; the per-call authenticator carries a different one
    # and must win on the wire.
    it 'applies the per-call authenticator supplied in Options' do
      server, port, thread, captured = capture_auth_header

      begin
        config = {{moduleName}}::Configuration.new(
          base_url: "http://127.0.0.1:#{port}",
          default_headers: { 'Authorization' => 'Bearer default-token' }
        )
        api = {{moduleName}}::Api::PetApi.new(nil, config)
        per_call_auth = {{moduleName}}::Auth::BearerAuthenticator.new("http://127.0.0.1:#{port}", 'per-call-token')

        pet = {{moduleName}}::Models::Pet.new(
          id: 1,
          name: 'OverrideDog',
          photo_urls: Set['http://example.com/p.jpg']
        )
        api.add_pet(pet, {{moduleName}}::Api::Options::AddPetOptions.new(auth: per_call_auth))

        header_line = captured.pop
        _(header_line).must_include 'Bearer per-call-token'
      ensure
        server.close
        thread.join(2)
      end
    end

    # auth-omitted-uses-config-default: when no per-operation authenticator is
    # supplied (auth omitted from Options entirely), the base client must fall
    # back to the credentials configured on the Configuration object.
    it 'falls back to the configured credentials when auth is omitted from Options' do
      server, port, thread, captured = capture_auth_header

      begin
        config = {{moduleName}}::Configuration.new(
          base_url: "http://127.0.0.1:#{port}",
          default_headers: { 'Authorization' => 'Bearer config-default-token' }
        )
        api = {{moduleName}}::Api::PetApi.new(nil, config)

        pet = {{moduleName}}::Models::Pet.new(
          id: 1,
          name: 'DefaultCredsDog',
          photo_urls: Set['http://example.com/p.jpg']
        )
        # Options omits auth entirely; the minted Options object defaults its
        # auth member to nil, so the configured default credentials apply.
        api.add_pet(pet, {{moduleName}}::Api::Options::AddPetOptions.new)

        header_line = captured.pop
        _(header_line).must_include 'Bearer config-default-token'
      ensure
        server.close
        thread.join(2)
      end
    end

    # immutable-options: Options objects are constructed via keyword
    # arguments only. The generated classes expose attr_reader members and
    # freeze themselves at the end of #initialize, so reading values works
    # but no writer (setter) is exposed and the instance is frozen.
    it 'builds immutable Options from keyword arguments' do
      options = {{moduleName}}::Api::Options::FindPetsByStatusOptions.new(status: 'available')

      _(options.status).must_equal 'available'
      refute options.respond_to?(:status=)
      refute options.respond_to?(:auth=)
      assert options.frozen?
    end

    # unsecured-op-has-no-auth-member: an unsecured operation
    # (get_pet_by_id has no security requirement) must NOT mint an `auth`
    # member on its Options object — indeed it has no Options object at all,
    # so there is no AddPetOptions-style class for it. Guard the contract by
    # asserting the GetPetByIdOptions constant is absent.
    it 'does not expose an auth member on an unsecured operation' do
      _({{moduleName}}::Api::Options.const_defined?(:GetPetByIdOptions)).must_equal false
    end
  end

  # End-to-end form-urlencoded body assembly through the real generated
  # set_pet_preferences operation (POST /pet/{petId}/preferences). These
  # capture the raw request body off the wire so the assertions exercise the
  # operation's request_body construction plus BaseApi#serialize_body, not
  # just a helper in isolation.
  describe 'form-urlencoded body assembly (set_pet_preferences)' do
    # capture_request_body: one-shot TCP server that records the full request
    # body and returns a minimal ApiResponse JSON so the convenience method
    # is satisfied.
    def capture_request_body
      server = TCPServer.new('127.0.0.1', 0)
      port = server.addr[1]
      captured = Queue.new
      thread = Thread.new do
        client = server.accept rescue next
        content_length = 0
        client.gets # request line
        while (line = client.gets)
          if line.downcase.start_with?('content-length:')
            content_length = line.split(':', 2).last.strip.to_i
          end
          break if line.strip.empty?
        end
        captured << (content_length.positive? ? client.read(content_length).to_s : '')
        body = '{"code":200,"type":"","message":"ok"}'
        response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n" \
                   "Content-Length: #{body.bytesize}\r\nConnection: close\r\n\r\n#{body}"
        client.print(response)
        client.close
      end
      config = {{moduleName}}::Configuration.new(base_url: "http://127.0.0.1:#{port}", default_headers: {})
      api = {{moduleName}}::Api::PetApi.new(nil, config)
      [api, server, thread, captured]
    end

    # Canonical behavior 1 — a repeated-key array (`tags=a&tags=b`), not a
    # comma-joined value or a bracketed `tags[]` form.
    it 'expands an array form property to repeated keys' do
      api, server, thread, captured = capture_request_body
      begin
        options = {{moduleName}}::Api::Options::SetPetPreferencesOptions.new(
          nickname: 'Rex', tags: %w[a b]
        )
        api.set_pet_preferences(1, options)
        sent = captured.pop
        _(sent).must_include 'tags=a&tags=b'
        _(sent).wont_include 'tags=a,b'
        _(sent).wont_include 'tags%5B%5D'
      ensure
        server.close
        thread.join(2)
      end
    end

    # Canonical behavior 2 — optional `tags`/`note` left absent are omitted
    # from the body entirely; only the required `nickname` is sent.
    it 'omits absent optional form properties' do
      api, server, thread, captured = capture_request_body
      begin
        options = {{moduleName}}::Api::Options::SetPetPreferencesOptions.new(nickname: 'Rex')
        api.set_pet_preferences(1, options)
        sent = captured.pop
        _(sent).must_equal 'nickname=Rex'
        _(sent).wont_include 'tags'
        _(sent).wont_include 'note'
      ensure
        server.close
        thread.join(2)
      end
    end

    # Canonical behavior 3 — a space inside a form value is encoded as '+',
    # never '%20' (WHATWG application/x-www-form-urlencoded rules).
    it 'encodes a space in a form value as + not %20' do
      api, server, thread, captured = capture_request_body
      begin
        options = {{moduleName}}::Api::Options::SetPetPreferencesOptions.new(
          nickname: 'Mr Whiskers', note: 'good boy'
        )
        api.set_pet_preferences(1, options)
        sent = captured.pop
        _(sent).must_include 'nickname=Mr+Whiskers'
        _(sent).must_include 'note=good+boy'
        _(sent).wont_include '%20'
      ensure
        server.close
        thread.join(2)
      end
    end
  end
