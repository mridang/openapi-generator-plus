    it 'substitutes the server variables into the templated URL' do
      environment = {{moduleName}}::Api::GetStagingPetInfoServerEnvironment
      version = {{moduleName}}::Api::GetStagingPetInfoServerVersion
      server = {{moduleName}}::Api::GetStagingPetInfoServerStagingServer.new(
        environment: environment::SANDBOX, version: version::V3
      )
      url = url_sent_to(server) { |api, chosen| api.get_staging_pet_info(7, server: chosen) }
      _(url).must_equal 'https://sandbox.example.com/api/v3/pet/7/staging'
    end

    it 'bhv_operations_085 sends the multi-server operation to whichever server is chosen' do
      primary = url_sent_to({{moduleName}}::Api::GetMultiServerPetInfoServerPrimary.new) do |api, server|
        api.get_multi_server_pet_info(7, server: server)
      end
      regional = url_sent_to(
        {{moduleName}}::Api::GetMultiServerPetInfoServerRegional.new(
          region: {{moduleName}}::Api::GetMultiServerPetInfoServerRegionalRegion::EU
        )
      ) { |api, server| api.get_multi_server_pet_info(7, server: server) }

      _(primary).must_equal 'https://primary.example.com/v1/pet/7/multi'
      _(regional).must_equal 'https://eu.example.com/v1/pet/7/multi'
    end

    # The Mirror variant has two variables, and its channel values hold
    # characters that are special in a URL and in a string literal.
    {
      'a&b' => 'https://eu.mirror.example.com/a&b/v1/pet/7/multi',
      "it's" => "https://eu.mirror.example.com/it's/v1/pet/7/multi"
    }.each do |channel, expected|
      it "bhv_operations_084 resolves the Mirror variant for the channel #{channel.inspect}" do
        server = {{moduleName}}::Api::GetMultiServerPetInfoServerMirror.new(
          region: {{moduleName}}::Api::GetMultiServerPetInfoServerMirrorRegion::EU, channel: channel
        )
        url = url_sent_to(server) { |api, chosen| api.get_multi_server_pet_info(7, server: chosen) }
        _(url).must_equal expected
      end
    end

    it 'rejects a Mirror channel outside the declared values' do
      err = assert_raises(ArgumentError) do
        {{moduleName}}::Api::GetMultiServerPetInfoServerMirror.new(
          region: {{moduleName}}::Api::GetMultiServerPetInfoServerMirrorRegion::EU, channel: 'other'
        )
      end
      _(err.message).must_include "Invalid value 'other' for server variable 'channel'"
    end
  end
end
