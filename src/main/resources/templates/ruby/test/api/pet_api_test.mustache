      api, server, thread, captured = capture_wire_request('{}')
      begin
        api.set_pet_avatar_thumbnail(1, [0x89, 0x50, 0x4E, 0x47].pack('C*'))
        _(captured.pop[:body]).must_equal '"iVBORw=="'
