class FakeTokenClient
  attr_reader :last_url, :last_headers, :last_body, :call_count, :last_no_redirect, :bodies

  def initialize(responses)
    @responses = responses
    @call_count = 0
    @bodies = []
  end

  def send_request(_method, url, headers, body, no_redirect: false)
    @bodies << body
    @last_url = url
    @last_headers = headers
    @last_body = body
    @last_no_redirect = no_redirect
    @call_count += 1
    response = @responses[@call_count - 1] || @responses.last
    {{moduleName}}::ApiHttpResponse.new(
      status_code: response[:status],
      body: response[:body].is_a?(String) ? response[:body] : response[:body].to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

# Client whose transport always fails, as when the token endpoint is
# unreachable.
class FailingTokenClient
  def initialize(error)
    @error = error
  end

  def send_request(_method, _url, _headers, _body, **_kwargs)
    raise @error
  end
end

# Thread-safe client that counts calls and stalls briefly so concurrent
# callers genuinely race against a single in-flight refresh.
class SlowCountingTokenClient
  attr_reader :call_count

  def initialize(body)
    @body = body
    @call_count = 0
    @mutex = Mutex.new
  end

  def send_request(_method, _url, _headers, _body, **_kwargs)
    @mutex.synchronize { @call_count += 1 }
    sleep 0.05
    {{moduleName}}::ApiHttpResponse.new(
      status_code: 200,
      body: @body.to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

# Thread-safe client that hands out tok1, tok2, ... on successive calls and
# stalls briefly so concurrent callers race against a single in-flight refresh.
class NumberingSlowTokenClient
  attr_reader :call_count

  def initialize
    @call_count = 0
    @mutex = Mutex.new
  end

  def send_request(_method, _url, _headers, _body, **_kwargs)
    n = @mutex.synchronize { @call_count += 1 }
    sleep 0.05
    {{moduleName}}::ApiHttpResponse.new(
      status_code: 200,
      body: { 'access_token' => "tok#{n}", 'expires_in' => 3600 }.to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

