    # second call within the buffer window must serve from cache.
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'str-tok', 'expires_in' => '3600' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    first = manager.get_access_token('https://auth.example.com/token', params)
    second = manager.get_access_token('https://auth.example.com/token', params)

    _(first).must_equal 'str-tok'
    _(second).must_equal 'str-tok'
    _(client.call_count).must_equal 1
  end

  it 'bhv_auth_056 expires_in is honoured only as a decimal number, with padding allowed; any other value marks the token stale' do
    ['0x1000', '1e4', '1_000_000', '3600d', '-5'].each do |raw|
      client = FakeTokenClient.new([
        { status: 200, body: { 'access_token' => 'first', 'expires_in' => raw } },
        { status: 200, body: { 'access_token' => 'second', 'expires_in' => 3600 } }
      ])
      manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
      manager.api_client = client

      params = { 'grant_type' => 'client_credentials' }
      _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'first'
      _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'second'
      _(client.call_count).must_equal 2
    end

    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'padded', 'expires_in' => " 3600.5\n" } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    manager.get_access_token('https://auth.example.com/token', params)
    manager.get_access_token('https://auth.example.com/token', params)
    _(client.call_count).must_equal 1
  end

  it 'bhv_authoauthtwotokenmgr_005 an expires_in too large to represent is clamped to one year instead of overflowing' do
    [1e20, 10**30, '9' * 400].each_case do |raw|
      client = FakeTokenClient.new([
        { status: 200, body: { 'access_token' => 'huge', 'expires_in' => raw } }
      ])
      manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
      manager.api_client = client

      params = { 'grant_type' => 'client_credentials' }
      _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'huge'
      _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'huge'
      _(client.call_count).must_equal 1
      _(manager.instance_variable_get(:@token_expiry)).must_be :<=, Time.now.to_f + 31_536_000
    end
  end

  it 'bhv_authoauthtwotokenmgr_008 expires_in as float is floored' do
    # D1: some providers send expires_in as a JSON float (e.g. 3600.5).
    # The manager must floor it and cache the token.
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'flt-tok', 'expires_in' => 3600.5 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    first = manager.get_access_token('https://auth.example.com/token', params)
    second = manager.get_access_token('https://auth.example.com/token', params)

    _(first).must_equal 'flt-tok'
    _(second).must_equal 'flt-tok'
    _(client.call_count).must_equal 1
  end

  it 'bhv_authoauthtwotokenmgr_011 expires_in negative skips caching' do
    # D1: a negative expires_in (e.g. -1) must mark the token as
    # immediately stale so the very next call refetches.
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'neg1', 'expires_in' => -1 } },
      { status: 200, body: { 'access_token' => 'neg2', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    first = manager.get_access_token('https://auth.example.com/token', params)
    second = manager.get_access_token('https://auth.example.com/token', params)

    _(first).must_equal 'neg1'
    _(second).must_equal 'neg2'
    _(client.call_count).must_equal 2
  end

  it 'bhv_authoauthtwotokenmgr_031 throws when token request fails' do
    client = FakeTokenClient.new([
      { status: 401, body: { 'error' => 'invalid_client' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    # A failed token request surfaces as the typed OAuth2ServerError, which
    # subclasses the SDK's branded root so a rescue on the root catches it
    # alongside every other SDK error.
    error = assert_raises({{apiErrorParent}}) do
      manager.get_access_token('https://auth.example.com/token', {})
    end
    _(error).must_be_kind_of {{moduleName}}::Errors::OAuth2ServerError
    _(error).wont_be_kind_of {{moduleName}}::Errors::ApiError
  end

  it 'bhv_authoauthtwotokenmgr_034 token POST requests no_redirect from transport (Bucket 3.2)' do
    # The token POST carries client_id / client_secret / refresh_token in
    # the form body; the manager MUST flag the request as
    # `no_redirect: true` so the transport refuses any 3xx instead of
    # silently replaying the credentials body to a redirect target.
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_nr', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(client.last_no_redirect).must_equal true
  end

  it 'bhv_authoauthtwotokenmgr_035 token POST carries the form Content-Type and a JSON Accept header' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_h', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(client.last_headers['Content-Type']).must_equal 'application/x-www-form-urlencoded'
    _(client.last_headers['Accept']).must_equal 'application/json'
  end

  # Bucket 3.2: RFC 6749 §3.2 forbids redirects at the token endpoint. The
  # manager must refuse the whole 300-399 range (302 and 307 both exercised
  # here, plus 301/303/308) rather than replaying the credential-bearing
  # POST to the redirect target. A 3xx is a non-2xx answer, so it raises
  # OAuth2ServerError carrying the status.
  it 'bhv_authoauthtwotokenmgr_033 refuses a 3xx redirect on the token endpoint' do
    [301, 302, 303, 307, 308].each_case do |status|
      client = FakeTokenClient.new([{ status: status, body: '' }])
      manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
      manager.api_client = client

      err = assert_raises({{moduleName}}::Errors::OAuth2ServerError) do
        manager.get_access_token(
          'https://auth.example.com/token',
          { 'grant_type' => 'client_credentials', 'client_secret' => 'topsecret' }
        )
      end
      _(err.status_code).must_equal status
    end
  end

  it 'bhv_authoauthtwotokenmgr_019 invalidate_access_token triggers a single refetch under concurrency' do
    # After invalidation, 10 threads must coalesce into exactly ONE additional
    # network round-trip (single-flight), all observing the refreshed token.
    client = NumberingSlowTokenClient.new
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    first = manager.get_access_token('https://auth.example.com/token', params)
    _(first).must_equal 'tok1'
    _(client.call_count).must_equal 1

    manager.invalidate_access_token

    tokens = Array.new(10)
    threads = (0...10).map do |i|
      Thread.new do
        tokens[i] = manager.get_access_token('https://auth.example.com/token', params)
      end
    end
    threads.each(&:join)

    _(client.call_count).must_equal 2
    _(tokens.all? { |t| t == 'tok2' }).must_equal true
  end

  it 'bhv_authoauthtwotokenmgr_022 sends the refresh grant with the cached refresh token and the client credentials' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'first', 'refresh_token' => 'cached_refresh', 'expires_in' => -1 } },
      { status: 200, body: { 'access_token' => 'second', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'authorization_code', 'code' => 'abc', 'client_id' => 'cid', 'client_secret' => 'csecret' }
    manager.get_access_token('https://auth.example.com/token', params)
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'second'

    _(client.bodies[1]).must_equal 'grant_type=refresh_token&refresh_token=cached_refresh&client_id=cid&client_secret=csecret'
  end

  it 'bhv_authoauthtwotokenmgr_016 falls back to the original grant when the refresh grant fails' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'first', 'refresh_token' => 'revoked', 'expires_in' => -1 } },
      { status: 400, body: { 'error' => 'invalid_grant' } },
      { status: 200, body: { 'access_token' => 'third', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    manager.get_access_token('https://auth.example.com/token', params)
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'third'

    _(client.call_count).must_equal 3
    _(client.bodies[1]).must_include 'grant_type=refresh_token'
    _(client.bodies[2]).must_equal 'grant_type=client_credentials'
  end

  it 'bhv_authoauthtwotokenmgr_039 a response without expires_in is cached indefinitely' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'no_expiry' } },
      { status: 200, body: { 'access_token' => 'unexpected' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'client_credentials' }
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'no_expiry'
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'no_expiry'
    _(client.call_count).must_equal 1
  end

  it 'bhv_authoauthtwotokenmgr_003 a refresh response without expires_in clears the previous expiry' do
    # The first token is stale on arrival. A refresh answer that omits
    # expires_in carries no expiry, so it is cached instead of refreshing
    # again on every call.
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'first', 'refresh_token' => 'r', 'expires_in' => 0 } },
      { status: 200, body: { 'access_token' => 'second' } },
      { status: 200, body: { 'access_token' => 'third' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    params = { 'grant_type' => 'authorization_code' }
    manager.get_access_token('https://auth.example.com/token', params)
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'second'
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'second'
    _(client.call_count).must_equal 2
  end

  it 'bhv_authoauthtwotokenmgr_017 ignores a numeric refresh_token' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok', 'refresh_token' => 12_345, 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(manager.refresh_token).must_be_nil
  end

  it 'bhv_authoauthtwotokenmgr_020 non string refresh token is ignored for a structured value too' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok', 'refresh_token' => %w[not a string], 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(manager.refresh_token).must_be_nil
  end

  it 'bhv_authoauthtwotokenmgr_037 a transport failure during the token fetch reaches the caller unchanged' do
    failure = {{moduleName}}::Errors::NetworkError.new(message: 'connection refused')
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = FailingTokenClient.new(failure)

    err = assert_raises({{moduleName}}::Errors::NetworkError) do
      manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    end
    _(err).must_be_same_as failure
  end

  it 'bhv_authoauthtwotokenmgr_002 accepts a bearer token_type in any case and a missing one' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'a', 'token_type' => 'BEARER', 'expires_in' => 0 } },
      { status: 200, body: { 'access_token' => 'b', 'expires_in' => 0 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client
    params = { 'grant_type' => 'client_credentials' }
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'a'
    _(manager.get_access_token('https://auth.example.com/token', params)).must_equal 'b'
  end

  it 'bhv_authoauthtwotokenmgr_038 rejects a token_type other than bearer without echoing it' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'a', 'token_type' => 'DPoP-secret' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client
    err = assert_raises({{moduleName}}::Errors::OAuth2TokenError) do
      manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    end
    _(err.message).must_equal 'Unsupported token_type in token response'
  end

  it 'bhv_auth_030 token state read from several threads at once never shows a value that was not set' do
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    values = %w[tok_0 tok_1 tok_2 tok_3]
    manager.access_token = values.first
    observed = Queue.new

    writers = values.map { |value| Thread.new { 200.times { manager.access_token = value } } }
    readers = Array.new(4) do
      Thread.new do
        200.times { observed << manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' }) }
      end
    end
    (writers + readers).each(&:join)

    seen = []
    seen << observed.pop until observed.empty?
    _(seen.length).must_equal 800
    _(seen.reject { |token| values.include?(token) }).must_be_empty
  end

  it 'bhv_errors_082 keeps a valid error code when its description and uri are not strings' do
    client = FakeTokenClient.new([
      { status: 400, body: { 'error' => 'invalid_grant', 'error_description' => 42, 'error_uri' => ['https://x'] } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    error = assert_raises({{moduleName}}::Errors::OAuth2ServerError) do
      manager.get_access_token('https://auth.example.com/token', {})
    end
    _(error.code).must_equal 'invalid_grant'
    _(error.description).must_be_nil
    _(error.uri).must_be_nil
  end

  it 'bhv_langruby_047 a non-string error value is not taken as an error code' do
    client = FakeTokenClient.new([{ status: 400, body: { 'error' => 7 } }])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    error = assert_raises({{moduleName}}::Errors::OAuth2ServerError) do
      manager.get_access_token('https://auth.example.com/token', {})
    end
    _(error.code).must_be_nil
  end
