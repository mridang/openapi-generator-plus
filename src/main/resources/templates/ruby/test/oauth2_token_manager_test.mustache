# rubocop:disable Metrics/BlockLength, Lint/MissingCopEnableDirective

require 'minitest/autorun'
require 'json'
require '{{gemName}}'

class FakeTokenClient
  attr_reader :last_url, :last_headers, :last_body, :call_count

  def initialize(responses)
    @responses = responses
    @call_count = 0
  end

  def send_request(_method, url, headers, body)
    @last_url = url
    @last_headers = headers
    @last_body = body
    @call_count += 1
    response = @responses[@call_count - 1] || @responses.last
    {{moduleName}}::ApiResponse.new(
      status_code: response[:status],
      body: response[:body].to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

describe {{moduleName}}::Auth::OAuth::OAuth2TokenManager do
  it 'fetches and returns an access token' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_abc', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    token = manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(token).must_equal 'tok_abc'
  end

  it 'stores the refresh token from the response' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_abc', 'refresh_token' => 'ref_xyz', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(manager.refresh_token).must_equal 'ref_xyz'
  end

  it 'returns cached token when not expired' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_abc', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    token1 = manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    token2 = manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(token1).must_equal token2
    _(client.call_count).must_equal 1
  end

  it 'refetches token when expired' do
    client = FakeTokenClient.new([
      { status: 200, body: { 'access_token' => 'tok_first', 'expires_in' => -1 } },
      { status: 200, body: { 'access_token' => 'tok_second', 'expires_in' => 3600 } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    token1 = manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(token1).must_equal 'tok_first'

    token2 = manager.get_access_token('https://auth.example.com/token', { 'grant_type' => 'client_credentials' })
    _(token2).must_equal 'tok_second'
    _(client.call_count).must_equal 2
  end

  it 'raises an error when api_client is not set' do
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    assert_raises(RuntimeError) do
      manager.get_access_token('https://auth.example.com/token', {})
    end
  end

  it 'raises an error when token request fails' do
    client = FakeTokenClient.new([
      { status: 401, body: { 'error' => 'invalid_client' } }
    ])
    manager = {{moduleName}}::Auth::OAuth::OAuth2TokenManager.new
    manager.api_client = client

    assert_raises(RuntimeError) do
      manager.get_access_token('https://auth.example.com/token', {})
    end
  end
end
