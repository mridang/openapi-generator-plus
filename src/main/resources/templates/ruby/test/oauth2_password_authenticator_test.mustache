require 'minitest/autorun'
require 'base64'
require 'json'
require '{{gemName}}'

class FakePasswordClient
  attr_reader :last_url, :last_body, :last_headers, :call_count

  def initialize(responses)
    @responses = responses
    @call_count = 0
  end

  def send_request(_method, url, headers, body, no_redirect: false)
    @last_url = url
    @last_headers = headers
    @last_body = body
    response = @responses[@call_count] || @responses.last
    @call_count += 1
    {{moduleName}}::ApiResponse.new(
      status_code: response[:status],
      body: response[:body].to_json,
      headers: { 'content-type' => 'application/json' }
    )
  end
end

describe {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator do
  parallelize_me!

  it 'sends password grant type' do
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    auth.api_client = client

    auth.auth_headers
    _(client.last_body).must_include 'grant_type=password'
  end

  it 'sends username and password' do
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    auth.api_client = client

    auth.auth_headers
    _(client.last_body).must_include 'username=user%40example.com'
    _(client.last_body).must_include 'password=secret_password'
  end

  it 'sends client id and secret' do
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    auth.api_client = client

    auth.auth_headers
    _(client.last_body).must_include 'client_id=my_client_id'
    _(client.last_body).must_include 'client_secret=my_client_secret'
  end

  it 'returns authorization bearer header' do
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    auth.api_client = client

    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer pw_tok'
  end

  it 'uses refresh token on subsequent calls' do
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'refresh_token' => 'ref_tok', 'expires_in' => -1 } },
      { status: 200, body: { 'access_token' => 'pw_tok_refreshed', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    auth.api_client = client

    auth.auth_headers
    headers = auth.auth_headers
    _(headers['Authorization']).must_equal 'Bearer pw_tok_refreshed'
    _(client.last_body).must_include 'grant_type=refresh_token'
    _(client.last_body).must_include 'refresh_token=ref_tok'
  end

  it 'getHost returns configured host' do
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'my_client_secret',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read]
    )
    _(auth.host).must_equal 'https://api.example.com'
  end

  it 'basic auth url-encodes client id and secret' do
    # Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
    # client_id and client_secret MUST be application/x-www-form-
    # urlencoded BEFORE being joined with ':' and base64-encoded.
    client = FakePasswordClient.new([
      { status: 200, body: { 'access_token' => 'pw_tok', 'expires_in' => 3600 } }
    ])
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'id+with/special',
      'secret&with=stuff',
      'https://auth.example.com/token',
      'user@example.com',
      'secret_password',
      %w[read],
      client_auth_method: {{moduleName}}::Auth::OAuth::ClientAuthMethod::BASIC
    )
    auth.api_client = client

    auth.auth_headers

    auth_header = client.last_headers['Authorization']
    _(auth_header).wont_be_nil
    _(auth_header.start_with?('Basic ')).must_equal true
    decoded = Base64.strict_decode64(auth_header.sub(/\ABasic /, ''))
    _(decoded).must_equal 'id%2Bwith%2Fspecial:secret%26with%3Dstuff'
  end

  it 'masks the client secret and password in inspect' do
    # client-secret-leak-in-default-repr: the default Object#inspect dumps
    # every instance variable, leaking @client_secret and @password into
    # logs / error messages. The overridden inspect must mask both.
    auth = {{moduleName}}::Auth::OAuth::OAuth2PasswordAuthenticator.new(
      'https://api.example.com',
      'my_client_id',
      'super_secret_value',
      'https://auth.example.com/token',
      'user@example.com',
      'super_secret_password',
      %w[read]
    )

    _(auth.inspect).wont_include 'super_secret_value'
    _(auth.inspect).wont_include 'super_secret_password'
    _(auth.inspect).must_include '***'
    _(auth.to_s).wont_include 'super_secret_value'
    _(auth.to_s).wont_include 'super_secret_password'
  end
end
