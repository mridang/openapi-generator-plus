{{>api_info}}

require 'base64'
require 'minitest/autorun'
require '{{gemName}}'

# The entry point does not require the per-scheme wrappers: an autoloader maps
# each file to its constant. Load them here, or the checks below would
# enumerate only the generic authenticators and never see a wrapper.
Dir[File.expand_path('../lib/{{modulePath}}/auth/**/*_authenticator.rb', File.dirname(__FILE__))].each { |file| require file }

# The per-scheme authenticators subclass the generic ones, whose constructors
# take positional arguments. A wrapper that took keywords instead would reject
# the very call its base accepts, so no authenticator may require a keyword.
describe 'scheme authenticators' do
  parallelize_me!

  def authenticator_classes
    modules = [{{moduleName}}::Auth, {{moduleName}}::Auth::OAuth]
    modules.flat_map { |mod| mod.constants.map { |name| mod.const_get(name) } }
           .select { |const| const.is_a?(Class) && const < {{moduleName}}::Auth::Authenticator }
  end

  it 'finds the generated authenticators' do
    _(authenticator_classes).wont_be_empty
  end

  it 'take positional arguments like their base authenticators' do
    offenders = authenticator_classes.select do |klass|
      klass.instance_method(:initialize).parameters.any? { |kind, _name| kind == :keyreq }
    end
    _(offenders.map(&:name)).must_equal([])
  end

  def wrappers_of(base)
    authenticator_classes.select { |klass| klass < base }
  end

  it 'every API-key wrapper emits its key at exactly one location' do
    wrappers_of({{moduleName}}::Auth::ApiKeyAuthenticator).each do |klass|
      auth = klass.new('https://api.example.com', 'wrapper-key')
      emitted = [auth.auth_headers, auth.query_params, auth.cookie_params].reject(&:empty?)
      _(emitted.length).must_equal 1, klass.name
      _(emitted.first.values).must_equal ['wrapper-key'], klass.name
      _(emitted.first.keys.first).wont_be_empty
    end
  end

  it 'every API-key wrapper validates eagerly and redacts the key' do
    wrappers_of({{moduleName}}::Auth::ApiKeyAuthenticator).each do |klass|
      _(-> { klass.new('https://api.example.com', '') }).must_raise ArgumentError
      _(klass.new('https://api.example.com', 'wrapper-key').inspect).wont_include 'wrapper-key'
    end
  end
{{#hasApiKeyHeaderNames}}

  it 'the API-key wrappers emit every header name the spec declares' do
    emitted = wrappers_of({{moduleName}}::Auth::ApiKeyAuthenticator).flat_map do |klass|
      klass.new('https://api.example.com', 'wrapper-key').auth_headers.keys
    end
{{#apiKeyHeaderNames}}
    _(emitted).must_include '{{name}}'
{{/apiKeyHeaderNames}}
  end
{{/hasApiKeyHeaderNames}}

  it 'every Bearer wrapper sends the token as a Bearer credential' do
    wrappers_of({{moduleName}}::Auth::BearerAuthenticator).each do |klass|
      auth = klass.new('https://api.example.com', 'wrapper-token')
      _(auth.auth_headers).must_equal({ 'Authorization' => 'Bearer wrapper-token' }, klass.name)
      _(auth.inspect).wont_include 'wrapper-token'
    end
  end

  it 'every Basic wrapper sends the credentials as a Basic credential' do
    wrappers_of({{moduleName}}::Auth::BasicAuthenticator).each do |klass|
      auth = klass.new('https://api.example.com', 'alice', 's3cret')
      _(auth.auth_headers).must_equal({ 'Authorization' => 'Basic YWxpY2U6czNjcmV0' }, klass.name)
      _(auth.inspect).wont_include 's3cret'
    end
  end

  # One row per scheme: the wrapper, its generic base and the environment
  # variable of each credential, as the generator named them.
  def environment_schemes
    [
{{#schemeEnvironmentEntries}}
      ['{{className}}', '{{baseClass}}', { {{#credentials}}'{{name}}' => '{{envName}}'{{^-last}}, {{/-last}}{{/credentials}} }]{{^-last}},{{/-last}}
{{/schemeEnvironmentEntries}}
    ]
  end

  def scheme_class(name)
    authenticator_classes.find { |klass| klass.name.to_s.end_with?("::#{name}") }
  end

  def every_variable
    environment_schemes.flat_map { |_name, _base, credentials| credentials.values }
  end

  it 'finds a wrapper for every scheme the spec declares' do
    environment_schemes.each { |name, _base, _credentials| _(scheme_class(name)).wont_be_nil }
  end

  it 'bhv_authscheme_001 gives every credential of every scheme a variable of its own' do
    _(every_variable.uniq).must_equal every_variable
  end

  it 'builds each wrapper from its own variables alone' do
    environment_schemes.each do |name, _base, credentials|
      env = credentials.values.to_h { |variable| [variable, "value-#{variable}"] }
      _(scheme_class(name).new('https://api.example.com', env: env)).wont_be_nil
    end
  end

  it 'fails when a credential is missing, whatever the other schemes have set' do
    environment_schemes.each do |name, _base, credentials|
      credentials.each_value do |missing|
        env = every_variable.reject { |variable| variable == missing }.to_h { |variable| [variable, "value-#{variable}"] }
        _(-> { scheme_class(name).new('https://api.example.com', env: env) }).must_raise ArgumentError, "#{name} #{missing}"
      end
    end
  end

  it 'counts an empty variable as unset' do
    environment_schemes.each do |name, _base, credentials|
      credentials.each_value do |empty|
        env = every_variable.to_h { |variable| [variable, variable == empty ? '' : "value-#{variable}"] }
        _(-> { scheme_class(name).new('https://api.example.com', env: env) }).must_raise ArgumentError, "#{name} #{empty}"
      end
    end
  end

  it 'prefers the value given to the constructor to the variable' do
    environment_schemes.each do |name, base, credentials|
      env = credentials.values.to_h { |variable| [variable, "value-#{variable}"] }
      klass = scheme_class(name)
      case base
      when 'BearerAuthenticator'
        _(klass.new('https://api.example.com', 'given', env: env).auth_headers).must_equal({ 'Authorization' => 'Bearer given' }, name)
      when 'ApiKeyAuthenticator'
        auth = klass.new('https://api.example.com', 'given', env: env)
        _([auth.auth_headers, auth.query_params, auth.cookie_params].flat_map(&:values)).must_equal ['given'], name
      when 'BasicAuthenticator'
        auth = klass.new('https://api.example.com', 'given', 'pw', env: env)
        _(auth.auth_headers['Authorization']).must_equal "Basic #{Base64.strict_encode64('given:pw')}", name
      end
    end
  end

  it 'reads the environment once, when the wrapper is built' do
    environment_schemes.each do |name, base, credentials|
      next unless base == 'BearerAuthenticator'

      variable = credentials.values.first
      env = { variable => 'first' }
      auth = scheme_class(name).new('https://api.example.com', env: env)
      env[variable] = 'second'
      _(auth.auth_headers).must_equal({ 'Authorization' => 'Bearer first' }, name)
    end
  end

  it 'takes the token provider of a Bearer wrapper after the variable' do
    environment_schemes.each do |name, base, credentials|
      next unless base == 'BearerAuthenticator'

      variable = credentials.values.first
      auth = scheme_class(name).new('https://api.example.com', token_provider: -> { 'from-provider' }, env: {})
      _(auth.auth_headers).must_equal({ 'Authorization' => 'Bearer from-provider' }, name)
      auth = scheme_class(name).new('https://api.example.com', token_provider: -> { 'from-provider' }, env: { variable => 'from-env' })
      _(auth.auth_headers).must_equal({ 'Authorization' => 'Bearer from-env' }, name)
    end
  end
end
