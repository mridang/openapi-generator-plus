{{>api_info}}

require 'json'
require 'uri'

module {{moduleName}}
  # Serializes parameter values for HTTP requests based on their location and format.
  #
  # Converts values into their string representations suitable for HTTP request
  # paths, query strings, and headers. Handles null values, collections with various
  # collection formats, and URL encoding.
  #
  # @api private
  class ValueSerializer # :nodoc:
    # Percent-encodes a string for use as a path segment, preserving
    # sub-delimiters that OAS 3.0 path styles use as structural separators.
    # '~' is an RFC 3986 unreserved character and must never be
    # percent-encoded. URI.encode_www_form_component over-encodes it to
    # %7E; restore it to a literal '~' to match the other SDKs.
    PRESERVE_ENCODED = {
      '%3B' => ';', '%3D' => '=', '%2C' => ',', '%3A' => ':',
      '%40' => '@', '%21' => '!', '%24' => '$', '%26' => '&',
      '%27' => "'", '%28' => '(', '%29' => ')', '%2A' => '*',
      '%2B' => '+', '%7E' => '~'
    }.freeze

    # RFC 3986 reserved characters that must be left literal when a query
    # parameter declares +allowReserved: true+: exactly the set RFC 3986
    # §3.4 permits in a query. '#' (the fragment delimiter, which would
    # truncate the query) and '[' ']' stay percent-encoded, as does
    # everything else (spaces, control characters, non-ASCII), so the result
    # is always a valid query segment. URI.encode_www_form_component
    # percent-encodes each of these; restore it to its literal byte. '~' is
    # restored for the same reason as in PRESERVE_ENCODED.
    RESERVED_PRESERVED = {
      '%3A' => ':', '%2F' => '/', '%3F' => '?', '%40' => '@', '%21' => '!',
      '%24' => '$', '%26' => '&', '%27' => "'", '%28' => '(',
      '%29' => ')', '%2A' => '*', '%2B' => '+', '%2C' => ',',
      '%3B' => ';', '%3D' => '=', '%7E' => '~'
    }.freeze

    def self.serialize(value, location, _schema_type, collection_format: nil)
      return serialize_nil(location) if value.nil?

      # A uniqueItems array parameter is a Set; it expands exactly like an
      # array, in the Set's iteration order.
      value = value.to_a if value.is_a?(Set)
      return serialize_array(value, location, collection_format) if value.is_a?(Array)

      str_val = ObjectSerializer.stringify(value)

      return encode_path_segment(str_val) if location == :path

      str_val
    end

    def self.serialize_nil(location)
      return nil if location == :query

      ''
    end

    def self.serialize_array(value, location, collection_format)
      if location == :query
        serialize_query_array(value, collection_format)
      else
        value.map { |v| ObjectSerializer.stringify(v) }.join(',')
      end
    end

    def self.serialize_query_array(value, collection_format)
      case collection_format
      when :multi
        value.map { |v| ObjectSerializer.stringify(v) }
      when :ssv
        value.map { |v| ObjectSerializer.stringify(v) }.join(' ')
      when :tsv
        value.map { |v| ObjectSerializer.stringify(v) }.join("\t")
      when :pipes
        value.map { |v| ObjectSerializer.stringify(v) }.join('|')
      else
        value.map { |v| ObjectSerializer.stringify(v) }.join(',')
      end
    end

    def self.encode_path_segment(value)
      return '' if value.nil? || value.empty?

      encoded = URI.encode_www_form_component(value).gsub('+', '%20')
      PRESERVE_ENCODED.reduce(encoded) { |s, (from, to)| s.gsub(from, to) }
    end

    # Percent-encodes the JSON of a +content:+ cookie parameter, keeping only
    # A-Z a-z 0-9 - _ ~ literal. Every other byte, including the dot, the colon,
    # * ! ' ( ) and each byte of a non-ASCII character as UTF-8, becomes %XX, so
    # a JSON model is fully encoded and is a valid RFC 6265 cookie-value.
    #
    # @param value [String] the serialized JSON
    # @return [String] the encoded cookie value
    def self.encode_content_cookie(value)
      value.to_s.b.gsub(/[^A-Za-z0-9\-_~]/n) { |byte| format('%%%02X', byte.ord) }.force_encoding(Encoding::UTF_8)
    end

    # Wraps a query value so the query-string builder preserves RFC 3986
    # reserved characters (OAS +allowReserved: true+) instead of
    # percent-encoding them. Produced by .maybe_allow_reserved and unwrapped
    # when the query string is assembled. The wrapped value is a String, or
    # an Array of strings for exploded parameters.
    class AllowReservedValue
      attr_reader :value

      def initialize(value)
        @value = value
      end
    end

    # Wrap +value+ in an {AllowReservedValue} when the parameter declares
    # +allowReserved: true+; otherwise return it unchanged. A nil value is
    # never wrapped so the query builder still omits it.
    def self.maybe_allow_reserved(value, allow_reserved)
      return value if value.nil? || !allow_reserved

      AllowReservedValue.new(value)
    end

    # Wraps a multipart part value whose Encoding Object declares the part
    # Content-Type and/or part headers. The multipart encoder unwraps it: the
    # declared Content-Type replaces the one the SDK would choose, and each
    # header is written after it in declaration order. A list value applies
    # the encoding to each item.
    class EncodedPart
      attr_reader :value, :content_type, :headers

      def initialize(value, content_type, headers)
        @value = value
        @content_type = content_type
        @headers = headers
      end
    end

    # Wrap +value+ in an {EncodedPart} carrying the declared part
    # Content-Type (or nil) and the ordered part headers, given as
    # +[name, value]+ pairs. A nil value is never wrapped so the body
    # builder still omits it.
    def self.encoded_part(value, content_type, headers)
      return value if value.nil?

      EncodedPart.new(value, content_type, headers.to_h)
    end

    # Percent-encode a query value while leaving RFC 3986 reserved characters
    # literal (OAS +allowReserved: true+). A space is illegal in a URL and is
    # still encoded as +%20+; only the reserved set is restored.
    def self.encode_query_allowing_reserved(value)
      return '' if value.nil? || value.empty?

      encoded = URI.encode_www_form_component(value).gsub('+', '%20')
      RESERVED_PRESERVED.reduce(encoded) { |s, (from, to)| s.gsub(from, to) }
    end

    # The RFC 6265 cookie-octet set an operation cookie value may carry.
    COOKIE_OCTETS = /\A[!\x23-\x2B\x2D-\x3A\x3C-\x5B\x5D-\x7E]*\z/

    # The Cookie header fragment of one OAS 3.2 +style: cookie+ parameter.
    #
    # A scalar is +name=value+; an array is +name=a,b+ (explode false) or
    # +name=a; name=b+ (explode true); an object is +name=k1,v1,k2,v2+
    # (explode false) or +k1=v1; k2=v2+ (explode true). Nothing is
    # percent-encoded: every item, key and value must already be RFC 6265
    # cookie-octets.
    #
    # @param name [String] the parameter name
    # @param value [Object, nil] the parameter value
    # @param explode [Boolean] whether the value is exploded
    # @return [String] the fragment, or an empty string when nothing is sent
    # @raise [ArgumentError] when a piece holds a character outside the cookie-octet set
    def self.cookie_pairs(name, value, explode)
      return '' if value.nil?

      value = value.to_a if value.is_a?(Set)
      fields = object_fields(value)
      if fields
        pairs = fields.compact.map do |key, field|
          [cookie_octets(name, key.to_s), cookie_octets(name, object_field_text(key, field))]
        end
        return '' if pairs.empty?

        return explode ? pairs.map { |key, text| "#{key}=#{text}" }.join('; ') : "#{name}=#{pairs.flatten.join(',')}"
      end
      if value.is_a?(Array)
        return '' if value.empty?

        items = value.map { |item| cookie_octets(name, ObjectSerializer.stringify(item)) }
        return explode ? items.map { |item| "#{name}=#{item}" }.join('; ') : "#{name}=#{items.join(',')}"
      end
      "#{name}=#{cookie_octets(name, ObjectSerializer.stringify(value))}"
    end

    # Return +text+ when it holds only RFC 6265 cookie-octets; raise otherwise.
    def self.cookie_octets(name, text)
      raise ArgumentError, "Cookie value for '#{name}' contains characters forbidden by RFC 6265" unless text.match?(COOKIE_OCTETS)

      text
    end

    # Turn the percent-encoded RFC 3986 reserved characters a path segment
    # may carry (OAS +allowReserved: true+ on a path parameter) back into
    # their literal form: / : @ ! $ & ' ( ) * + , ; =. Takes the value after
    # path encoding, so ? # [ ] a space and a literal % (as %25) stay encoded.
    #
    # @param encoded [String] the path-encoded value
    # @return [String] the value with the reserved characters literal
    def self.allow_reserved_in_path(encoded)
      encoded.gsub(/%(?:2[146-9A-CF]|3[ABD]|40)/i) { |match| match[1, 2].to_s.hex.chr }
    end

    # Serialize a parameter value according to OAS 3.0 style and explode rules.
    #
    # @param param_name [String] the parameter name
    # @param value [Object, nil] the value to serialize
    # @param location [Symbol] parameter location (:path, :query, :header, :cookie)
    # @param schema_type [String] the schema type (e.g. 'string', 'array')
    # @param collection_format [Symbol, nil] legacy collection format
    # @param style [String, nil] OAS 3.0 style (e.g. 'matrix', 'label', 'form',
    #   'simple', 'spaceDelimited', 'pipeDelimited')
    # @param explode [Boolean] whether to explode array values
    # @return [String, Array<String>, nil] the serialized value
    def self.serialize_styled(param_name, value, location, schema_type, collection_format, style, explode)
      # A uniqueItems array parameter is a Set; it expands exactly like an
      # array, in the Set's iteration order.
      value = value.to_a if value.is_a?(Set)
      # A +format: date+ parameter is written as YYYY-MM-DD even when the caller
      # passes a DateTime or Time (a DateTime is a Date, so the type check does
      # not stop it).
      value = date_only(value) if ['Date', 'Array<Date>'].include?(schema_type)
      # Path parameters are required components of the URL — accepting an
      # empty string would silently produce a malformed URL like
      # `/resource//details`, which most servers route to 404 instead of
      # surfacing the bug at the call site. The required-non-null check
      # lives in the operation method; here we catch the empty-string
      # case that slips through it.
      if location == :path && value.is_a?(String) && value.empty?
        raise ArgumentError, "Path parameter '#{param_name}' must not be empty"
      end
      # RFC 3986 §5.2.4: a '.' or '..' segment is path navigation, so a URL
      # parser would silently re-route the request. Matrix and label styles
      # prefix the value and can never produce such a segment.
      if location == :path && !%w[matrix label].include?(style) && !value.nil?
        segment = value.is_a?(Array) ? value.map { |v| ObjectSerializer.stringify(v) }.join(',') : ObjectSerializer.stringify(value)
        raise ArgumentError, "Path parameter '#{param_name}' must not be '.' or '..'" if %w[. ..].include?(segment)
      end

      return serialize(value, location, schema_type, collection_format: collection_format) if style.nil? || style.empty?

      # A nil value serializes to nil for a query parameter (so it is
      # omitted) or '' for every other location, regardless of which style
      # was requested — checked once here rather than in each style branch
      # below.
      return nil if value.nil? && location == :query
      return '' if value.nil?

      # An object value (a model or a Hash) goes through its wire-named fields,
      # expanded by style and explode (D47).
      fields = object_fields(value)
      return serialize_object(param_name, fields, location, style, explode) if fields

      case style
      when 'matrix'
        if value.is_a?(Array)
          if explode
            value.map do |v|
              ";#{param_name}=#{encode_item(v, location)}"
            end.join
          else
            items = value.map { |v| encode_item(v, location) }
            ";#{param_name}=#{items.join(',')}"
          end
        else
          ";#{param_name}=#{encode_item(value, location)}"
        end
      when 'label'
        if value.is_a?(Array)
          items = value.map { |v| encode_item(v, location) }
          explode ? ".#{items.join('.')}" : ".#{items.join(',')}"
        else
          ".#{encode_item(value, location)}"
        end
      when 'spaceDelimited'
        if value.is_a?(Array) && explode
          value.map { |v| ObjectSerializer.stringify(v) }
        elsif value.is_a?(Array)
          value.map { |v| ObjectSerializer.stringify(v) }.join(' ')
        else
          ObjectSerializer.stringify(value)
        end
      when 'pipeDelimited'
        if value.is_a?(Array) && explode
          value.map { |v| ObjectSerializer.stringify(v) }
        elsif value.is_a?(Array)
          value.map { |v| ObjectSerializer.stringify(v) }.join('|')
        else
          ObjectSerializer.stringify(value)
        end
      when 'form'
        if value.is_a?(Array) && explode
          value.map { |v| ObjectSerializer.stringify(v) }
        elsif value.is_a?(Array)
          value.map { |v| ObjectSerializer.stringify(v) }.join(',')
        else
          ObjectSerializer.stringify(value)
        end
      when 'simple'
        if value.is_a?(Array)
          value.map { |v| encode_item(v, location) }.join(',')
        else
          encode_item(value, location)
        end
      else
        serialize(value, location, schema_type, collection_format: collection_format)
      end
    end

    def self.encode_item(value, location)
      str = ObjectSerializer.stringify(value)
      location == :path ? encode_path_segment(str) : str
    end

    # The query entries one parameter contributes. A model or Hash value in an
    # exploded form-style parameter is expanded to one entry per property
    # (name=value); every other value is a single entry under +param_name+, as
    # {.serialize_styled} renders it.
    #
    # @param param_name [String] the parameter name
    # @param value [Object] the non-nil value
    # @param schema_type [String] the schema type name
    # @param collection_format [Symbol, nil] legacy collection format
    # @param style [String, nil] OAS style
    # @param explode [Boolean] whether the value is exploded
    # @param allow_reserved [Boolean] whether the parameter declares +allowReserved+
    # @return [Hash{String => Object}] query parameter names to values
    def self.query_entries(param_name, value, schema_type, collection_format, style, explode, allow_reserved)
      # @type var entries: Hash[String, untyped]
      entries = {}
      fields = object_fields(value)
      if fields && explode && ['form', '', nil].include?(style)
        fields.each do |key, field|
          next if field.nil?

          text = field.is_a?(Array) ? field.map { |item| ObjectSerializer.stringify(item) } : ObjectSerializer.stringify(field)
          entries[key.to_s] = maybe_allow_reserved(text, allow_reserved)
        end
      else
        styled = serialize_styled(param_name, value, :query, schema_type, collection_format, style, explode)
        entries[param_name] = maybe_allow_reserved(styled, allow_reserved)
      end
      entries
    end

    # The wire-named fields of an object value: a Hash as given, a generated
    # model reduced through the SDK serializer (unset fields omitted). Anything
    # else is not an object.
    #
    # @param value [Object] a parameter value
    # @return [Hash, nil] the fields, or nil when +value+ is not an object
    def self.object_fields(value)
      return value if value.is_a?(Hash)
      return nil unless value.class.const_defined?(:ATTRIBUTE_MAP)

      parsed = JSON.parse(ObjectSerializer.serialize(value))
      parsed.is_a?(Hash) ? parsed : nil
    end

    # Render an object by style and explode: +matrix+ and +label+ prefix it,
    # +simple+ and +form+ separate the pairs with commas (name=value when
    # exploded), +spaceDelimited+ and +pipeDelimited+ flatten it with their
    # delimiter.
    def self.serialize_object(param_name, fields, location, style, explode)
      pairs = fields.map { |key, field| [encode_item(key.to_s, location), encode_item(object_field_text(key, field), location)] }
      joined = pairs.map { |key, text| "#{key}=#{text}" }
      case style
      when 'matrix'
        explode ? joined.map { |pair| ";#{pair}" }.join : ";#{param_name}=#{pairs.flatten.join(',')}"
      when 'label'
        explode ? ".#{joined.join('.')}" : ".#{pairs.flatten.join(',')}"
      when 'spaceDelimited'
        pairs.flatten.join(' ')
      when 'pipeDelimited'
        pairs.flatten.join('|')
      else
        separator = location == :cookie ? '&' : ','
        explode ? joined.join(separator) : pairs.flatten.join(',')
      end
    end

    # The text of one object property. A property that is itself an object or
    # an array has no single text form in an object-valued parameter, so it is
    # refused rather than written as a comma list or the Ruby inspect text.
    def self.object_field_text(key, field)
      if field.is_a?(Hash) || field.is_a?(Array) || field.class.const_defined?(:ATTRIBUTE_MAP)
        raise ::{{moduleName}}::Errors::SerializationError.new(
          "Property '#{key}' holds a nested object or array, which a parameter cannot carry", nil
        )
      end
      ObjectSerializer.stringify(field)
    end

    # Serialize a deepObject-style query parameter.
    #
    # Produces a hash of flattened keys in the form +param_name[key]+ to
    # stringified values, suitable for inclusion in a query string.
    #
    # @param param_name [String] the parameter name (e.g. 'filter')
    # A generated model is first reduced to its wire-named fields (unset
    # fields omitted), so each bracketed key carries the JSON name.
    #
    # @param value [Hash, Object, nil] the hash or model value to serialize
    # @return [Hash{String => String}] expanded keys to serialized values
    def self.serialize_deep_object(param_name, value)
      # @type var empty: Hash[String, String]
      empty = {}
      return empty if value.nil?

      fields = value.is_a?(Hash) ? value : JSON.parse(ObjectSerializer.serialize(value))
      return empty unless fields.is_a?(Hash)

      # @type var acc: Hash[String, String]
      acc = {}
      fields.sort_by { |key, _val| key.to_s }.each_with_object(acc) do |(key, val), result|
        next if val.nil?

        result["#{param_name}[#{key}]"] = ObjectSerializer.stringify(val)
      end
    end

    # Drop the time of day from a DateTime or Time, in an array as well.
    #
    # @param value [Object, nil] the parameter value
    # @return [Object, nil] the same value, with any DateTime or Time as a Date
    def self.date_only(value)
      case value
      when DateTime, Time then value.to_date
      when Array then value.map { |item| date_only(item) }
      else value
      end
    end

    private_class_method :date_only, :serialize_nil, :serialize_array, :serialize_query_array, :encode_item,
                         :object_fields, :serialize_object, :object_field_text, :cookie_octets
  end
end
