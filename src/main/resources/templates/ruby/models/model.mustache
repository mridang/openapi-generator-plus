        # Builds the object
        # @param data [Object] data to be matched against the list of anyOf items
        # @return [Object] Returns a single variant when exactly one matches, a
        #   {Composite} retaining every variant when more than one matches, or
        #   the raw data for an +AnyType+ union
        def build(data)
          # Retain-all lossless anyOf: collect EVERY variant that decodes,
          # not just the first. A non-discriminated anyOf documents "A, B, OR
          # BOTH"; returning only the first match silently dropped the other
          # variants' fields and lost them on re-encode. We keep each match so
          # a co-satisfied payload round-trips losslessly.
          matched = [] #: Array[untyped]
          openapi_any_of.each do |klass_name|
            next if klass_name == :AnyType

            result = ::{{moduleName}}::ObjectSerializer.convert_to_type(data, klass_name.to_s)
            matched << result unless result.nil?
          rescue StandardError
            next
          end

          # Exactly one variant matched — return it bare so single-variant
          # callers see the same plain instance as before (no wrapper).
          return matched.first if matched.length == 1

          # More than one variant matched — wrap them in a Composite that
          # exposes the union of their fields and re-emits all of them on
          # encode, so the co-satisfied data is never silently dropped.
          return Composite.new(matched) if matched.length > 1

          return data if openapi_any_of.include?(:AnyType)

          # Raise on union no-match instead of returning nil. See the
          # oneOf branch for the cross-lang rationale (5 of 12 SDKs
          # already throw; we promote the rest to the same strict
          # behaviour).
          raise ArgumentError, 'JSON did not match any schema in the {{classname}} anyOf union'
        end
      end
    end
