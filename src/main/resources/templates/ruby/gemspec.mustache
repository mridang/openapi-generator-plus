# frozen_string_literal: true

{{> api_info}}

lib = File.expand_path('lib', __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require '{{modulePath}}/version'

Gem::Specification.new do |s|
  s.name        = '{{gemName}}'
  s.version     = ::{{moduleName}}::VERSION
  s.platform    = Gem::Platform::RUBY
{{#hasAuthorList}}
  s.authors     = [{{#authorList}}'{{{name}}}'{{^-last}}, {{/-last}}{{/authorList}}]
{{/hasAuthorList}}
{{^hasAuthorList}}
  s.authors     = ['{{#infoContactName}}{{infoContactName}}{{/infoContactName}}{{^infoContactName}}{{appNameBase}}{{/infoContactName}}']
{{/hasAuthorList}}
{{#infoContactEmail}}
  s.email       = '{{infoContactEmail}}'
{{/infoContactEmail}}
  s.summary     = '{{appNameBase}} Ruby Gem'
  s.description = '{{#appDescription}}{{{appDescription}}}{{/appDescription}}{{^appDescription}}{{appNameBase}} Ruby Gem{{/appDescription}}'
  s.license     = '{{licenseId}}'
  s.required_ruby_version = '>= 3.2'
{{#homepageUrl}}
  s.homepage = '{{{homepageUrlLiteral}}}'
{{/homepageUrl}}
  s.metadata['rubygems_mfa_required'] = 'true'
{{#repositoryUrl}}
  s.metadata['source_code_uri'] = '{{{repositoryUrlLiteral}}}'
{{/repositoryUrl}}
{{#documentationUrl}}
  s.metadata['documentation_uri'] = '{{{documentationUrlLiteral}}}'
{{/documentationUrl}}
{{#issueTrackerUrl}}
  s.metadata['bug_tracker_uri'] = '{{{issueTrackerUrlLiteral}}}'
{{/issueTrackerUrl}}

  # base64, json and set are default gems that Ruby is unbundling from
  # the standard library (base64 is no longer a default gem on Ruby
  # 3.4+). The generated runtime requires all three, so declare them
  # explicitly rather than relying on them being preinstalled. iso8601
  # covers `format: duration` (no stdlib equivalent; lighter than
  # ActiveSupport::Duration) and tod covers `format: time`, the
  # time-of-day values Ruby has no native type for. One alphabetical
  # run, which is what Gemspec/OrderedDependencies asks for.
  s.add_dependency 'base64', '~> 0.3'
  s.add_dependency 'bigdecimal', '~> 3.1'
  s.add_dependency 'dry-struct', '~> 1.6'
  s.add_dependency 'dry-types', '~> 1.7'
  s.add_dependency 'faraday', '~> 2.0'
  s.add_dependency 'faraday-net_http_persistent', '~> 2.3'
  s.add_dependency 'iso8601', '~> 0.13'
  s.add_dependency 'json', '~> 2.6'
  s.add_dependency 'set', '~> 1.1'
  s.add_dependency 'tod', '~> 3.1'

  s.files = Dir['lib/**/*', 'sig/**/*', 'README.md', 'Gemfile', '{{gemName}}.gemspec']
  s.require_paths = ['lib']
end
