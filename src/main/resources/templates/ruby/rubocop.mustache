AllCops:
  TargetRubyVersion: 3.4
  NewCops: enable
  SuggestExtensions: false

# The builder DSL chains methods off `.builder` with a consistent 2-space
# indent; the `aligned` style would require excessive horizontal space.
Layout/MultilineMethodCallIndentation:
  EnforcedStyle: indented

# Multi-line method arguments use a 2-space indent from the call site,
# not alignment with the first argument (which would be layout-sensitive).
Layout/ArgumentAlignment:
  EnforcedStyle: with_fixed_indentation

# Multi-line hash and array literals use a consistent 2-space indent,
# not alignment with the character after the opening bracket.
Layout/FirstHashElementIndentation:
  EnforcedStyle: consistent

Layout/FirstArrayElementIndentation:
  EnforcedStyle: consistent

# Style-only cops disabled for generated code:
# - Lint/RedundantRequireStatement: templates `require` defensively for clarity
# - Style/IfUnlessModifier: multi-line if is more readable in generated branches
# - Style/StringLiterals: templates mix quoting; not worth normalizing
# - Style/Lambda: `->` arrow vs `lambda` keyword is taste
# - Metrics/BlockLength: long test blocks are intentional
Lint/RedundantRequireStatement:
  Enabled: false
Style/IfUnlessModifier:
  Enabled: false
# Generated per-parameter serialization emits an explicit if/else that
# assigns the same key in both branches; rubocop prefers a single
# conditional assignment, but the templated branch bodies read clearer
# as a plain if/else. Behaviour is identical either way.
Style/ConditionalAssignment:
  Enabled: false
Style/StringLiterals:
  Enabled: false
Style/Lambda:
  Enabled: false
# Conditional mustache sections can't statically know which item is last
# in generated hash/array literals, so emitted output mixes "with trailing
# comma" and "without trailing comma" inconsistently between files.
# Disabling these cops is cleaner than trying to teach mustache about
# last-item context in every per-format/per-type branch.
Style/TrailingCommaInHashLiteral:
  Enabled: false
Style/TrailingCommaInArrayLiteral:
  Enabled: false
Metrics/BlockLength:
  Enabled: false
# Generated SDK methods (same_origin?, validate_api_key!) inherently exceed
# small thresholds. Real method-design rules (Naming, Layout) stay strict.
Metrics/MethodLength:
  Enabled: false
Metrics/AbcSize:
  Enabled: false
Metrics/CyclomaticComplexity:
  Enabled: false
Metrics/PerceivedComplexity:
  Enabled: false
# Generated classes (API clients, serializers, token managers) aggregate every
# operation/format branch into one type, so they inherently exceed the length
# threshold. Method-design rules stay strict; only the size metric is relaxed.
Metrics/ClassLength:
  Enabled: false
# Generated SDK method signatures mirror the operation's parameter set from the
# OpenAPI spec (path/query/header/body/auth), which can exceed the argument-count
# threshold. The shape is dictated by the spec, not by template style.
Metrics/ParameterLists:
  Enabled: false
# When an operation's body parameter is itself named `request_body`, the emitted
# assignment becomes `request_body = request_body`. This is a naming artifact of
# the spec, not a real self-assignment bug.
Lint/SelfAssignment:
  Enabled: false
# Accessor-style method names (e.g. `get_*`) are derived from spec operationIds
# and cannot be renamed without breaking the generated public API surface.
Naming/AccessorMethodName:
  Enabled: false
# The following Style cops flag layout/idiom artifacts of templated emission that
# cannot be avoided without per-branch mustache context:
# - DefWithParentheses / MethodCallWithoutArgsParentheses: empty-arg defs/calls
#   are emitted uniformly regardless of arity.
# - StringConcatenation: URL/path assembly mixes literals and interpolation.
Style/DefWithParentheses:
  Enabled: false
Style/MethodCallWithoutArgsParentheses:
  Enabled: false
Style/StringConcatenation:
  Enabled: false
# Model files emit a struct plus its companion enum/oneOf classes into a single
# file by design; splitting them across files is not how the generator lays out
# generated models.
Style/OneClassPerFile:
  Enabled: false
# Inline RBS type annotations use the `#:` sigil (e.g. `foo = {} #: Hash[...]`),
# which RuboCop misreads as a comment lacking a leading space. The sigil is
# required by Steep/RBS, so the layout cop cannot apply here.
Layout/LeadingCommentSpace:
  Enabled: false
# Layout cops below are auto-corrected by the `rubocop -A --only Layout` post
# step, but generated output (long descriptions from spec, blank-line spacing
# between emitted defs/modules) would otherwise be flagged. Generated code does
# not benefit from manual line-length/blank-line review.
Layout/LineLength:
  Enabled: false
Layout/EmptyLines:
  Enabled: false
Layout/EmptyLineBetweenDefs:
  Enabled: false
Layout/EmptyLinesAroundModuleBody:
  Enabled: false
# Test-only relaxations. These rules are legitimate in hand-written code but the
# generated test harness cannot satisfy them:
# - Style/RescueModifier: the embedded TCP mock server loop uses `accept rescue
#   break/next` to drain connections concisely.
# - Lint/UnusedMethodArgument: mock `send_request` overrides must match the
#   ApiClient interface signature even when an argument is unused in the stub.
Style/RescueModifier:
  Exclude:
    - 'test/**/*'
Lint/UnusedMethodArgument:
  Exclude:
    - 'test/**/*'
