module {{moduleName}}
  # Represents a server variable from the OpenAPI specification.
  #
  # Server variables define substitution parameters in server URL templates.
  # Each variable has a default value and may optionally restrict values to
  # an enumerated set.
  #
  # This class is immutable and thread-safe.
  #
  # @see ServerConfiguration
  class ServerVariable
    # The default value for this variable.
    # @return [String]
    attr_reader :default_value
    # Human-readable description of this variable.
    # @return [String, nil]
    attr_reader :description
    # The allowed values for this variable. An empty array means any value
    # is accepted.
    # @return [Array<String>]
    attr_reader :enum_values
    # Create a new server variable.
    #
    # @param default_value [String] the default value used when no override is provided
    # @param description [String, nil] human-readable description of the variable
    # @param enum_values [Array<String>] allowed values, or an empty array if any value is accepted
    def initialize(default_value:, description: nil, enum_values: [])
      @default_value = default_value
      @description = description
      @enum_values = enum_values.freeze
      freeze
    end

    # Two server variables are equal when their default, description and
    # allowed values are equal.
    # @param other [Object]
    # @return [Boolean]
    def ==(other)
      other.is_a?(self.class) &&
        default_value == other.default_value &&
        description == other.description &&
        enum_values == other.enum_values
    end

    alias eql? ==

    # @return [Integer] a hash consistent with {#==}
    def hash
      [self.class, default_value, description, enum_values].hash
    end
  end
end
