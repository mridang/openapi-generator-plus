{{>api_info}}
namespace {{invokerPackage}};

{{#apiInfo}}
{{#apis}}
{{#operations}}
use {{apiPackage}}\{{classname}}Interface;
{{/operations}}
{{/apis}}
{{/apiInfo}}

/**
 * Contract of {@see {{clientClassName}}}: every API group typed as its group interface, plus
 * `close()`. Depend on it instead of the class to substitute a hand-written fake client in your
 * own tests; a fake client built from fake groups opens no connection, and closing it does
 * nothing. It is not the PSR-18 `Psr\Http\Client\ClientInterface`.
 */
interface {{clientClassName}}Interface
{
{{#apiInfo}}
{{#apis}}
{{#operations}}
    /** API operations for the {{classname}} group. */
    public function get{{clientAccessorSuffix}}(): {{classname}}Interface;

{{/operations}}
{{/apis}}
{{/apiInfo}}
    /** Closes the client; a fake client has nothing to release. */
    public function close(): void;
}
