namespace {{invokerPackage}};

/**
 * One small hook around every operation call. It can edit the request headers
 * before the send and observe the status or the error afterwards, and it does
 * nothing when no hook is set.
 *
 * It runs once per operation call, however many sends happen inside it
 * (transport retries, the one replay after a 401) and for both variants of an
 * operation. It sits above the transport, so it also fires when the caller
 * supplied the HTTP client.
 *
 * Set it with {@see ConfigurationBuilder::callHook()}. To run several hooks
 * use {@see CallHookChain::chain()}.
 *
 * @category Interface
 * @package  {{invokerPackage}}
 */
interface CallHook
{
    /**
     * Called once per operation call, right after the trace context is injected
     * and before anything is sent. The header set is final at this point
     * (default headers, operation headers, per-call headers, authentication,
     * cookies and the propagated trace context), so the hook can read and
     * replace any of it. A header the hook sets is sent on every send of the
     * call. Reuse the existing spelling of a header name to replace it.
     *
     * An exception thrown here reaches the caller unchanged, nothing is sent
     * and the observer is not called.
     *
     * @param CallInfo              $info    what is being called
     * @param array<string, string> $headers the request headers, editable
     *
     * @return CallObserver|null an observer told how the call ended, or null for none
     */
    public function start(CallInfo $info, array &$headers): ?CallObserver;
}
