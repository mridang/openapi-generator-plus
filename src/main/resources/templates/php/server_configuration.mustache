namespace {{invokerPackage}};

/**
 * Represents a single server entry from the OpenAPI specification.
 *
 * A server URL may contain template variables (e.g.
 * "https://{env}.api.example.com/v{version}"). Use {@see getUrl()} to resolve
 * the URL with default variable values, or pass overrides to substitute
 * specific variables.
 *
 * This class is immutable.
 *
 * @category Class
 * @package  {{invokerPackage}}
 *
 * @see ServerVariable
 */
final class ServerConfiguration
{
    /**
     * @param string                         $urlTemplate the URL template, possibly containing {variable} placeholders
     * @param string|null                    $description human-readable description of this server, or null
     * @param array<string, ServerVariable>  $variables   map of variable names to their definitions
     */
    public function __construct(
        public readonly string $urlTemplate,
        public readonly ?string $description = null,
        public readonly array $variables = [],
    ) {
    }

    /**
     * Resolve the URL template, substituting the given variable overrides.
     *
     * Variables not present in the overrides array use their default values.
     * If a variable has an enum constraint, the override value is validated
     * against the allowed values.
     *
     * @param array<string, string> $overrides variable name to value overrides
     * @return string the fully resolved URL
     *
     * @throws \InvalidArgumentException if an override value is not in the variable's enum
     */
    public function getUrl(array $overrides = []): string
    {
        $replacements = [];
        foreach ($this->variables as $varName => $variable) {
            /* An override that is passed as null is a value, not an absent one: it is
             * checked against the enum rather than replaced by the default. */
            $value = array_key_exists($varName, $overrides) ? $overrides[$varName] : $variable->defaultValue;

            if ($variable->enumValues !== [] && !in_array($value, $variable->enumValues, true)) {
                throw new \InvalidArgumentException(
                    "Invalid value '$value' for server variable '$varName'"
                    . ". Allowed values: [" . implode(', ', $variable->enumValues) . ']'
                );
            }

            $replacements['{' . $varName . '}'] = $value;
        }

        /* One pass over the template: a placeholder that a substituted value
         * introduces is never expanded again. */
        return strtr($this->urlTemplate, $replacements);
    }
}
