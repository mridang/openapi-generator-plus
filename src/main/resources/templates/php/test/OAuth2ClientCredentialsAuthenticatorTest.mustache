namespace {{invokerPackage}}\Test;

use PHPUnit\Framework\TestCase;
use {{invokerPackage}}\ApiResponse;
use {{invokerPackage}}\Auth\OAuth\OAuth2ClientCredentialsAuthenticator;

class OAuth2ClientCredentialsAuthenticatorTest extends TestCase
{
    public function testSendsClientCredentialsGrantType(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'cc-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            ['read']
        );
        $authenticator->setApiClient($client);

        $headers = $authenticator->getAuthHeaders();

        $this->assertSame('Bearer cc-token', $headers['Authorization']);
        $this->assertCount(1, $client->capturedRequests);
        $request = $client->capturedRequests[0];
        $this->assertStringContainsString('grant_type=client_credentials', $request['body'] ?? '');
    }

    public function testSendsClientIdAndClientSecret(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'cc-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            []
        );
        $authenticator->setApiClient($client);

        $authenticator->getAuthHeaders();

        $request = $client->capturedRequests[0];
        $this->assertStringContainsString('client_id=my-client-id', $request['body'] ?? '');
        $this->assertStringContainsString('client_secret=my-client-secret', $request['body'] ?? '');
    }

    public function testIncludesScopesWhenProvided(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'cc-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            ['read', 'write']
        );
        $authenticator->setApiClient($client);

        $authenticator->getAuthHeaders();

        $request = $client->capturedRequests[0];
        $this->assertStringContainsString('scope=read+write', $request['body'] ?? '');
    }

    public function testReturnsHost(): void
    {
        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            []
        );

        $this->assertSame('https://api.example.com', $authenticator->getHost());
    }

    public function testCachesTokenOnSubsequentCalls(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'cached-cc-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            []
        );
        $authenticator->setApiClient($client);

        $headers1 = $authenticator->getAuthHeaders();
        $headers2 = $authenticator->getAuthHeaders();

        $this->assertSame('Bearer cached-cc-token', $headers1['Authorization']);
        $this->assertSame('Bearer cached-cc-token', $headers2['Authorization']);
        $this->assertCount(1, $client->capturedRequests);
    }

    public function testSendsRequestToTokenUrl(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'cc-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

        $authenticator = new OAuth2ClientCredentialsAuthenticator(
            'https://api.example.com',
            'my-client-id',
            'my-client-secret',
            'https://auth.example.com/token',
            []
        );
        $authenticator->setApiClient($client);

        $authenticator->getAuthHeaders();

        $request = $client->capturedRequests[0];
        $this->assertSame('https://auth.example.com/token', $request['url']);
    }
}
