<?php

declare(strict_types=1);

namespace {{invokerPackage}}\Test;

use PHPUnit\Framework\TestCase;
use {{invokerPackage}}\CancellationException;
use {{invokerPackage}}\CancellationToken;

class CancellationTokenTest extends TestCase
{
    public function testInitiallyNotCancelled(): void
    {
        $token = new CancellationToken();
        $this->assertFalse($token->isCancelled());
    }

    public function testCancelMarksAsCancelled(): void
    {
        $token = new CancellationToken();
        $token->cancel();
        $this->assertTrue($token->isCancelled());
    }

    public function testCancelInvokesRegisteredCallbacks(): void
    {
        $token = new CancellationToken();
        $called = 0;
        $token->onCancel(function () use (&$called): void {
            $called++;
        });

        $token->cancel();

        $this->assertSame(1, $called);
    }

    public function testCancelInvokesAllRegisteredCallbacks(): void
    {
        $token = new CancellationToken();
        $calls = [];
        $token->onCancel(function () use (&$calls): void {
            $calls[] = 'a';
        });
        $token->onCancel(function () use (&$calls): void {
            $calls[] = 'b';
        });

        $token->cancel();

        $this->assertSame(['a', 'b'], $calls);
    }

    public function testCancelIsIdempotent(): void
    {
        $token = new CancellationToken();
        $called = 0;
        $token->onCancel(function () use (&$called): void {
            $called++;
        });

        $token->cancel();
        $token->cancel();
        $token->cancel();

        $this->assertSame(1, $called);
    }

    public function testOnCancelInvokedImmediatelyIfAlreadyCancelled(): void
    {
        $token = new CancellationToken();
        $token->cancel();

        $called = false;
        $token->onCancel(function () use (&$called): void {
            $called = true;
        });

        $this->assertTrue($called);
    }

    public function testThrowIfCancelledNoopWhenNotCancelled(): void
    {
        $token = new CancellationToken();
        $token->throwIfCancelled();
        $this->addToAssertionCount(1);
    }

    public function testThrowIfCancelledThrowsAfterCancel(): void
    {
        $token = new CancellationToken();
        $token->cancel();

        $this->expectException(CancellationException::class);
        $token->throwIfCancelled();
    }

    public function testCallbackExceptionsDoNotPropagate(): void
    {
        $token = new CancellationToken();
        $token->onCancel(function (): void {
            throw new \RuntimeException('boom');
        });

        // Must not throw.
        $token->cancel();
        $this->assertTrue($token->isCancelled());
    }

    public function testCallbackRegisteredAfterCancelIsInvokedThenForgotten(): void
    {
        $token = new CancellationToken();
        $token->cancel();

        $called = 0;
        $token->onCancel(function () use (&$called): void {
            $called++;
        });

        // A second cancel must not re-invoke.
        $token->cancel();
        $this->assertSame(1, $called);
    }
}
