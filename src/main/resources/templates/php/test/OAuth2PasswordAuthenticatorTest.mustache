    public function testReturnsAuthorizationBearerHeader(): void
    {
        $client = new MockTokenApiClient();
        $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
            'access_token' => 'pw-token',
            'expires_in' => 3600,
        ]), ['Content-Type' => 'application/json']));

