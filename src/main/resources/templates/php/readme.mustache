function followEvents({{clientClassName}} $client{{#vendorExtensions.op.signatureArgsNoServer}}, {{#isPath}}{{{dataType}}} ${{paramName}}{{/isPath}}{{#isBody}}{{{dataType}}}{{#nullable}}|null{{/nullable}} ${{paramName}}{{/isBody}}{{#isOptions}}{{#nullable}}?{{/nullable}}{{{dataType}}} $options{{/isOptions}}{{/vendorExtensions.op.signatureArgsNoServer}}): void
