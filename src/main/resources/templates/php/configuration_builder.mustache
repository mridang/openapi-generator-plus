<?php

{{>partial_header}}
namespace {{invokerPackage}};

/**
 * Builder for creating immutable {@see Configuration} instances.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class ConfigurationBuilder
{
    /** @var string Base URL for all API requests. */
    private string $baseUrl = '{{{basePath}}}';

    /** @var array<string, string> Default headers to include in every API request. */
    private array $defaultHeaders = [];

    /**
     * Set the base URL for all API requests.
     *
     * @param string $baseUrl the base URL
     * @return self this builder
     */
    public function baseUrl(string $baseUrl): self
    {
        $this->baseUrl = $baseUrl;
        return $this;
    }

    /**
     * Add a single default header to include in every API request.
     *
     * @param string $name  header name
     * @param string $value header value
     * @return self this builder
     */
    public function defaultHeader(string $name, string $value): self
    {
        $this->defaultHeaders[$name] = $value;
        return $this;
    }

    /**
     * Add multiple default headers to include in every API request.
     *
     * @param array<string, string> $headers map of header names to values
     * @return self this builder
     */
    public function defaultHeaders(array $headers): self
    {
        $this->defaultHeaders = array_merge($this->defaultHeaders, $headers);
        return $this;
    }

    /**
     * Build and return an immutable Configuration instance.
     *
     * @return Configuration the configured instance
     */
    public function build(): Configuration
    {
        return new Configuration(
            baseUrl: $this->baseUrl,
            defaultHeaders: $this->defaultHeaders,
        );
    }
}
