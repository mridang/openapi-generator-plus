namespace {{invokerPackage}};

/**
 * Reads the `Link` header of RFC 8288. A value is a comma separated list of links, each an
 * angle-bracketed URI reference followed by `;` parameters whose values are tokens or quoted strings.
 * Commas and semicolons inside the brackets or inside a quoted string do not split anything.
 *
 * @internal Not part of the public API; used by {@see Paginator}.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class LinkHeader
{
    private function __construct()
    {
    }

    /**
     * Returns the URI reference of the first link whose relation type is `next`.
     *
     * @param string|null $header the header value, repeated headers joined with a comma
     *
     * @return string|null the URI reference exactly as written, or null when there is no `next` link
     */
    public static function next(?string $header): ?string
    {
        if ($header === null) {
            return null;
        }
        foreach (self::parse($header) as $link) {
            if (in_array('next', $link['relations'], true)) {
                return $link['target'];
            }
        }

        return null;
    }

    /**
     * Parses a header value into its links. A link that is malformed is skipped, and the parse goes on
     * with the next comma that is outside brackets and quotes.
     *
     * @return list<array{target: string, relations: list<string>}> the links in order
     */
    public static function parse(string $header): array
    {
        $links = [];
        $i = 0;
        $n = strlen($header);
        while ($i < $n) {
            while ($i < $n && ($header[$i] === ' ' || $header[$i] === "\t" || $header[$i] === ',')) {
                $i++;
            }
            if ($i >= $n) {
                break;
            }
            if ($header[$i] !== '<') {
                $i = self::skipToComma($header, $i);
                continue;
            }
            $close = strpos($header, '>', $i + 1);
            if ($close === false) {
                break;
            }
            $target = substr($header, $i + 1, $close - $i - 1);
            $i = $close + 1;
            $relations = [];
            while ($i < $n) {
                while ($i < $n && ($header[$i] === ' ' || $header[$i] === "\t")) {
                    $i++;
                }
                if ($i >= $n || $header[$i] === ',') {
                    break;
                }
                if ($header[$i] !== ';') {
                    $i = self::skipToComma($header, $i);
                    break;
                }
                $i++;
                while ($i < $n && ($header[$i] === ' ' || $header[$i] === "\t")) {
                    $i++;
                }
                $nameStart = $i;
                while ($i < $n && strpos("=;, \t", $header[$i]) === false) {
                    $i++;
                }
                $name = strtolower(substr($header, $nameStart, $i - $nameStart));
                $value = '';
                if ($i < $n && $header[$i] === '=') {
                    $i++;
                    if ($i < $n && $header[$i] === '"') {
                        $i++;
                        while ($i < $n && $header[$i] !== '"') {
                            if ($header[$i] === '\\' && $i + 1 < $n) {
                                $i++;
                            }
                            $value .= $header[$i];
                            $i++;
                        }
                        $i++;
                    } else {
                        while ($i < $n && strpos(";, \t", $header[$i]) === false) {
                            $value .= $header[$i];
                            $i++;
                        }
                    }
                }
                if ($name === 'rel' && $relations === []) {
                    foreach (preg_split('/\s+/', trim($value)) ?: [] as $relation) {
                        if ($relation !== '') {
                            $relations[] = strtolower($relation);
                        }
                    }
                }
            }
            $links[] = ['target' => $target, 'relations' => $relations];
        }

        return $links;
    }

    /**
     * Skips to the next comma that is outside brackets and quotes, and returns its index or the end.
     */
    private static function skipToComma(string $text, int $from): int
    {
        $quoted = false;
        $bracketed = false;
        for ($i = $from, $n = strlen($text); $i < $n; $i++) {
            $c = $text[$i];
            if ($quoted) {
                if ($c === '\\') {
                    $i++;
                } elseif ($c === '"') {
                    $quoted = false;
                }
            } elseif ($c === '"') {
                $quoted = true;
            } elseif ($c === '<') {
                $bracketed = true;
            } elseif ($c === '>') {
                $bracketed = false;
            } elseif ($c === ',' && !$bracketed) {
                return $i;
            }
        }

        return strlen($text);
    }
}
