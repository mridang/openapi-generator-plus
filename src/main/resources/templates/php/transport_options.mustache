namespace {{invokerPackage}};

/**
 * Immutable HTTP transport configuration for {@see DefaultApiClient}.
 *
 * Controls low-level HTTP behavior such as TLS verification, proxy routing,
 * timeouts, redirect handling, and automatic header injection. These settings
 * are independent of API-level concerns (base URL, authentication headers)
 * which belong in {@see Configuration}.
 *
 * This class is immutable and thread-safe. Use {@see TransportOptions::builder()} to create instances:
 *
 *     $transport = TransportOptions::builder()
 *         ->verifySsl(false)
 *         ->proxy('http://proxy.example.com:8080')
 *         ->timeout(5000)
 *         ->userAgent('MyApp/1.0')
 *         ->build();
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class TransportOptions
{
    /** @var int|null The longest a streamed response body may stay silent in milliseconds, or null when disabled. */
    public readonly ?int $idleTimeout;

    /**
     * @param bool                  $verifySsl      Whether TLS certificate verification is enabled
     * @param string|null           $caCertPath     Path to a custom CA certificate bundle for TLS verification
     * @param string|null           $proxy          HTTP or HTTPS proxy URL for all outbound requests
     * @param int|null              $timeout        End-to-end request timeout in milliseconds. Covers the
     *                                               entire request lifecycle: connection, TLS handshake,
     *                                               sending the request body, and reading the response.
     *                                               Defaults to 60000 ms (60 seconds). `null` disables the
     *                                               timeout (waits indefinitely)
     * @param bool                  $followRedirects Whether the client follows HTTP 3xx redirects automatically
     * @param int|null              $maxRedirects   Maximum number of consecutive redirects to follow. Only
     *                                               meaningful when $followRedirects is true. A value of
     *                                               `null` uses the HTTP client's built-in default
     * @param string|null           $userAgent      Custom User-Agent header value
     * @param array<string, string> $defaultHeaders Transport-level default headers included in every
     *                                               request. These headers have the lowest priority:
     *                                               API-level headers from
     *                                               {@see Configuration::$defaultHeaders}, operation-specific
     *                                               headers, and authentication headers all take precedence
     * @param bool                  $injectRequestId Whether to auto-inject an X-Request-ID header
     * @param int                   $maxRetries     Maximum number of automatic retries of a failed request
     *                                               (so up to `maxRetries + 1` attempts). Defaults to 2;
     *                                               0 disables retries. A request is retried after a
     *                                               network error that happened before a response, and
     *                                               after a 408, 409, 429 or 5xx (except 501) response,
     *                                               with exponential backoff and `Retry-After` honoured.
     *                                               A stream or multipart body is never retried
     * @param int|null              $idleTimeout    The longest a streamed response body (a binary operation)
     *                                               may stay silent, in milliseconds. The `timeout` stops at
     *                                               the response headers and this bounds the gap between two
     *                                               reads of the body; a stalled body raises
     *                                               `NetworkTimeoutException`. Defaults to 60000 ms (60
     *                                               seconds); 0 or `null` disables it (stored as `null`). A
     *                                               buffered call is unaffected
     * @param int|null              $maxResponseBytes The most bytes the client reads for a buffered
     *                                               response body (success, error or redirect), counting
     *                                               both the bytes on the wire and the decompressed bytes;
     *                                               a body that passes it fails with
     *                                               `ResponseTooLargeException`. `null` (the default)
     *                                               means no limit. A streamed response is not limited
     */
    public function __construct(
        public readonly bool $verifySsl = true,
        public readonly ?string $caCertPath = null,
        public readonly ?string $proxy = null,
        public readonly ?int $timeout = 60000,
        public readonly bool $followRedirects = true,
        public readonly ?int $maxRedirects = null,
        public readonly ?string $userAgent = '{{userAgentDefault}}',
        public readonly array $defaultHeaders = [],
        public readonly bool $injectRequestId = false,
        public readonly int $maxRetries = 2,
        ?int $idleTimeout = 60000,
        public readonly ?int $maxResponseBytes = null,
    ) {
        self::assertValidProxy($proxy);
        if ($timeout !== null && $timeout <= 0) {
            throw new \InvalidArgumentException(
                "Invalid timeout: must be a positive number of milliseconds (got $timeout)"
            );
        }
        if ($maxRedirects !== null && $maxRedirects < 0) {
            throw new \InvalidArgumentException(
                "Invalid maxRedirects: must not be negative (got $maxRedirects)"
            );
        }
        if ($maxRetries < 0) {
            throw new \InvalidArgumentException(
                "Invalid maxRetries: must not be negative (got $maxRetries)"
            );
        }
        if ($maxResponseBytes !== null && $maxResponseBytes <= 0) {
            throw new \InvalidArgumentException(
                "Invalid maxResponseBytes: must be a positive number of bytes (got $maxResponseBytes)"
            );
        }
        if ($idleTimeout !== null && $idleTimeout < 0) {
            throw new \InvalidArgumentException(
                "Invalid idleTimeout: must not be negative (got $idleTimeout)"
            );
        }
        $this->idleTimeout = $idleTimeout === 0 ? null : $idleTimeout;
    }

    /**
     * Validate a proxy URL: it must be a well-formed URL with a host and an
     * http or https scheme (matched case-insensitively, per RFC 3986). Runs for
     * every instance, whether it comes from the builder (at build) or from the constructor.
     *
     * @internal used by the constructor
     * @param string|null $proxy proxy URL, or null for no proxy
     * @throws \InvalidArgumentException if the URL is invalid
     */
    public static function assertValidProxy(?string $proxy): void
    {
        if ($proxy === null) {
            return;
        }
        if (filter_var($proxy, FILTER_VALIDATE_URL) === false) {
            throw new \InvalidArgumentException('Invalid proxy URL: ' . self::redactProxyUserinfo($proxy));
        }
        $parsed = parse_url($proxy);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme !== 'http' && $scheme !== 'https') {
            throw new \InvalidArgumentException(
                'Invalid proxy URL (must use http or https scheme): ' . self::redactProxyUserinfo($proxy)
            );
        }
        if (empty($parsed['host'])) {
            throw new \InvalidArgumentException(
                'Invalid proxy URL (missing host): ' . self::redactProxyUserinfo($proxy)
            );
        }
    }

    /**
     * Renders a proxy URL for an error message with any user:password
     * userinfo replaced by `***@`, so a configuration error never carries
     * credentials into logs or error trackers.
     */
    private static function redactProxyUserinfo(string $proxy): string
    {
        return preg_replace('~^([a-z][a-z0-9+.-]*://)[^/?#]*@~i', '$1***@', $proxy) ?? $proxy;
    }

    /**
     * Create a new builder for constructing TransportOptions instances.
     *
     * @return TransportOptionsBuilder a new builder with sensible defaults
     */
    public static function builder(): TransportOptionsBuilder
    {
        return new TransportOptionsBuilder();
    }

    /**
     * Masks credentials so they never leak through var_dump() / print_r() /
     * debug_zval_dump() / error logs: the proxy password and the value of
     * every default header named Authorization, Proxy-Authorization, Cookie
     * or containing key, token or secret.
     *
     * @return array<string, mixed>
     */
    public function __debugInfo(): array
    {
        $headers = [];
        foreach ($this->defaultHeaders as $name => $value) {
            $sensitive = preg_match('/^(proxy-)?authorization$|^cookie$|key|token|secret/i', $name) === 1;
            $headers[$name] = $sensitive ? '***' : $value;
        }
        $proxy = $this->proxy === null
            ? null
            : preg_replace('~^([a-z][a-z0-9+.-]*://[^/?#@:]*:)[^/?#@]*@~i', '$1***@', $this->proxy);
        return [
            'verifySsl' => $this->verifySsl,
            'caCertPath' => $this->caCertPath,
            'proxy' => $proxy,
            'timeout' => $this->timeout,
            'followRedirects' => $this->followRedirects,
            'maxRedirects' => $this->maxRedirects,
            'userAgent' => $this->userAgent,
            'injectRequestId' => $this->injectRequestId,
            'maxRetries' => $this->maxRetries,
            'idleTimeout' => $this->idleTimeout,
            'maxResponseBytes' => $this->maxResponseBytes,
            'defaultHeaders' => $headers,
        ];
    }
}
