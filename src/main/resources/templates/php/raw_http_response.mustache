namespace {{invokerPackage}};

/**
 * Raw, unprocessed result of a single HTTP exchange performed by a transport's
 * {@see AbstractApiClient::execute()} implementation.
 *
 * Unlike {@see ApiHttpResponse} -- the decoded, decompressed, charset-normalised
 * response handed to callers -- this value object carries the bytes exactly as
 * they came off the wire: the body is undecoded and the headers retain their
 * multi-value list form (keys already lowercased) so the shared
 * redirect/decompression orchestration in {@see AbstractApiClient} can
 * post-process them uniformly across every transport.
 *
 * @internal Not part of the public API; a transport-seam value type shared
 *           between AbstractApiClient and its concrete subclasses. May change
 *           or be removed in any release without notice.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class RawHttpResponse
{
    /**
     * @param int                         $statusCode HTTP status code
     * @param string                      $body       raw, undecoded response body bytes
     * @param array<string, list<string>> $headers    response headers; keys lowercased, multi-value lists preserved
     */
    public function __construct(
        public readonly int $statusCode,
        public readonly string $body,
        public readonly array $headers
    ) {
    }
}
