parameters:
  level: 9
  treatPhpDocTypesAsCertain: false
  tmpDir: .phpstan
  # The codegen emits \Ds\Vector / \Ds\Set / \Ds\Map return types
  # without inline generic <T> PHPDoc — the generic inner type lives in
  # CodegenOperation.returnBaseType which the api template would need to
  # compose into a `\Ds\Vector<\Foo\Bar>` PHPDoc tag for every operation.
  # Until that template work lands, ignore the generic-missing reports
  # for the Ds container family.
  ignoreErrors:
    - '#return type with generic class Ds\\(Vector|Set|Map) does not specify its types#'
    - '#parameter .* with generic class Ds\\(Vector|Set|Map) does not specify its types#'
    - '#return type has no value type specified in iterable type#'
    - '#parameter .* has no value type specified in iterable type#'
  paths:
    - .
  excludePaths:
    - vendor
    # Pest test files use magic methods (test(), expect(), beforeEach(),
    # etc.) that phpstan cannot analyse without the dedicated
    # pestphp/pest-plugin-phpstan plugin. Skip the test directory until
    # that plugin is wired up.
    - test
