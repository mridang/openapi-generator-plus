namespace {{invokerPackage}}\Auth;

/**
 * Authenticator for HTTP Basic authentication.
 */
class BasicAuthenticator extends BaseAuthenticator
{
    private readonly string $host;
    private readonly string $username;
    private readonly string $password;

    /**
     * @param string      $host     the API base URL
     * @param string|null $username the user name; when null, the {{envPrefix}}_USERNAME environment
     *                              variable is used (an empty value counts as unset)
     * @param string|null $password the password; when null, the {{envPrefix}}_PASSWORD environment
     *                              variable is used (an empty value counts as unset)
     * @throws \InvalidArgumentException when a credential is neither passed nor in the environment
     */
    public function __construct(
        string $host,
        ?string $username = null,
        #[\SensitiveParameter] ?string $password = null
    ) {
        $username ??= self::environmentCredential('USERNAME');
        $password ??= self::environmentCredential('PASSWORD');
        if ($username === null || $password === null) {
            throw new \InvalidArgumentException(
                'Basic auth credentials are required: pass a username and a password, '
                . 'or set the {{envPrefix}}_USERNAME and {{envPrefix}}_PASSWORD environment variables'
            );
        }
        /* RFC 7617 §2 — user-id MUST NOT contain ':' (it is the field
         * separator) and neither user-id nor password may carry CR/LF/NUL
         * (header-injection / smuggling vectors common when credentials
         * are read from .env files or interactive prompts). Validated
         * eagerly at construction so a malformed credential surfaces where
         * it is supplied rather than lazily at first request. */
        if (preg_match('/[\r\n\x00]/', $username) === 1) {
            throw new \InvalidArgumentException(
                'Basic auth username must not contain CR, LF, or NUL characters'
            );
        }
        if (str_contains($username, ':')) {
            throw new \InvalidArgumentException(
                "Basic auth username must not contain ':' (RFC 7617 §2)"
            );
        }
        if (preg_match('/[\r\n\x00]/', $password) === 1) {
            throw new \InvalidArgumentException(
                'Basic auth password must not contain CR, LF, or NUL characters'
            );
        }
        $this->host = $host;
        $this->username = $username;
        $this->password = $password;
    }

    public function getHost(): string
    {
        return $this->host;
    }

    /** @return array<string, string> */
    public function getAuthHeaders(): array
    {
        $authHeader = 'Basic ' . base64_encode($this->username . ':' . $this->password);
        return ['Authorization' => $authHeader];
    }

    /**
     * Masks the password so it never leaks through var_dump() / print_r() /
     * debug_zval_dump() / stack traces / error logs.
     *
     * @return array<string, string>
     */
    public function __debugInfo(): array
    {
        return [
            'host' => $this->host,
            'username' => $this->username,
            'password' => '***',
        ];
    }
}
