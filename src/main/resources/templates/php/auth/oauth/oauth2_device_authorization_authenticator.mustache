namespace {{invokerPackage}}\Auth\OAuth;

use {{invokerPackage}}\ApiClient;
use {{invokerPackage}}\Auth\BaseAuthenticator;
use {{invokerPackage}}\Auth\HttpAwareAuthenticator;
use {{invokerPackage}}\Errors\OAuth2ServerException;
use {{invokerPackage}}\Errors\OAuth2TokenException;

/**
 * Authenticator for the OAuth2 Device Authorization Grant (RFC 8628), for
 * devices without a browser or with limited input.
 *
 * Implements {@see HttpAwareAuthenticator} so that the device authorization and
 * token requests use the shared {@see ApiClient} with the same transport
 * configuration (proxy, TLS, timeouts) as regular API calls.
 *
 * Usage:
 * 1. Call requestDeviceAuthorization() to get the user code and verification URI
 * 2. Show both to the user
 * 3. Call pollForToken() to wait for the approval
 * 4. Use the authenticator normally -- tokens are managed automatically
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
class OAuth2DeviceAuthorizationAuthenticator extends BaseAuthenticator implements HttpAwareAuthenticator
{
    /** The grant type of a device access token request (RFC 8628 section 3.4). */
    private const string DEVICE_CODE_GRANT = 'urn:ietf:params:oauth:grant-type:device_code';

    /** The polling interval, in seconds, when the server names none (RFC 8628 section 3.2). */
    private const int DEFAULT_INTERVAL_SECONDS = 5;

    /** The seconds a slow_down answer adds to the polling interval (RFC 8628 section 3.5). */
    private const int SLOW_DOWN_SECONDS = 5;

    /** @var string API base URL. */
    private readonly string $host;

    /** @var string OAuth2 client ID. */
    private readonly string $clientId;

    /** @var string Device authorization endpoint URL. */
    private readonly string $deviceAuthorizationUrl;

    /** @var string Token endpoint URL. */
    private readonly string $tokenUrl;

    /** @var string Refresh token endpoint URL (falls back to tokenUrl if not set). */
    private readonly string $refreshUrl;

    /** @var string[] Requested scopes. */
    private readonly array $scopes;

    /** @var OAuth2TokenManager Token lifecycle manager. */
    private readonly OAuth2TokenManager $tokenManager;

    /** @var \Closure(int): void The wait between polls, in seconds; the tests replace it. */
    private \Closure $sleep;

    /** @var \Closure(): float The monotonic clock, in seconds; the tests replace it. */
    private \Closure $clock;

    /**
     * Create a new device authorization authenticator.
     *
     * @param string      $host                   API base URL
     * @param string      $clientId               OAuth2 client ID
     * @param string      $deviceAuthorizationUrl device authorization endpoint URL
     * @param string      $tokenUrl               token endpoint URL
     * @param string[]    $scopes                 requested scopes
     * @param string|null $refreshUrl             refresh token endpoint URL (defaults to tokenUrl)
     */
    public function __construct(
        string $host,
        string $clientId,
        string $deviceAuthorizationUrl,
        string $tokenUrl,
        array $scopes,
        ?string $refreshUrl = null
    ) {
        $this->host = $host;
        $this->clientId = $clientId;
        $this->deviceAuthorizationUrl = $deviceAuthorizationUrl;
        $this->tokenUrl = $tokenUrl;
        $this->refreshUrl = $refreshUrl ?? $tokenUrl;
        $this->scopes = $scopes;
        $this->tokenManager = new OAuth2TokenManager();
        $this->sleep = static function (int $seconds): void {
            sleep($seconds);
        };
        $this->clock = static fn (): float => hrtime(true) / 1e9;
    }

    /**
     * Inject the shared API client for making token requests.
     *
     * @param ApiClient $apiClient the shared API client instance
     */
    public function setApiClient(ApiClient $apiClient): void
    {
        $this->tokenManager->setApiClient($apiClient);
    }

    /**
     * Ask the device authorization endpoint for a device code and a user code.
     *
     * @return DeviceAuthorization the codes and the verification URI to show to the user
     *
     * @throws OAuth2ServerException if the endpoint answers with a non-2xx status
     * @throws OAuth2TokenException if the endpoint answers 2xx with an unusable body
     */
    public function requestDeviceAuthorization(): DeviceAuthorization
    {
        $params = ['client_id' => $this->clientId];
        if ($this->scopes !== []) {
            $params['scope'] = implode(' ', $this->scopes);
        }
        $body = $this->tokenManager->postForm($this->deviceAuthorizationUrl, $params);
        try {
            $data = json_decode($body, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException) {
            throw new OAuth2TokenException('Device authorization response is not valid JSON');
        }
        if (!is_array($data) || ($data !== [] && array_is_list($data))) {
            throw new OAuth2TokenException('Device authorization response is not a JSON object');
        }
        $fields = [];
        foreach (['device_code', 'user_code', 'verification_uri'] as $field) {
            $value = $data[$field] ?? null;
            if (!is_string($value) || $value === '') {
                throw new OAuth2TokenException(
                    'Device authorization response missing or empty ' . $field . ' field'
                );
            }
            $fields[$field] = $value;
        }
        $complete = $data['verification_uri_complete'] ?? null;
        $interval = $data['interval'] ?? null;

        return new DeviceAuthorization(
            $fields['device_code'],
            $fields['user_code'],
            $fields['verification_uri'],
            is_string($complete) && $complete !== '' ? $complete : null,
            OAuth2TokenManager::parseExpiresIn($data['expires_in'] ?? null),
            $interval === null ? self::DEFAULT_INTERVAL_SECONDS : OAuth2TokenManager::parseExpiresIn($interval),
        );
    }

    /**
     * Poll the token endpoint until the user approves the device, then replace
     * the session with the issued token.
     *
     * Waits the interval before each request; authorization_pending keeps
     * polling and slow_down adds five seconds to the interval.
     *
     * @param DeviceAuthorization $authorization the value returned by requestDeviceAuthorization()
     *
     * @throws OAuth2ServerException if the server refuses the grant (e.g. access_denied, expired_token)
     * @throws OAuth2TokenException if the device code expires before the user approves it
     */
    public function pollForToken(DeviceAuthorization $authorization): void
    {
        $started = ($this->clock)();
        $interval = $authorization->interval;
        while (true) {
            if (($this->clock)() - $started + $interval > $authorization->expiresIn) {
                throw new OAuth2TokenException('Device authorization expired before the user approved it');
            }
            ($this->sleep)($interval);
            try {
                $this->tokenManager->exchange($this->tokenUrl, [
                    'grant_type' => self::DEVICE_CODE_GRANT,
                    'client_id' => $this->clientId,
                    'device_code' => $authorization->deviceCode,
                ]);

                return;
            } catch (OAuth2ServerException $e) {
                if ($e->errorCode === 'authorization_pending') {
                    continue;
                }
                if ($e->errorCode === 'slow_down') {
                    $interval += self::SLOW_DOWN_SECONDS;
                    continue;
                }
                throw $e;
            }
        }
    }

    /**
     * Drops the cached access token so that the next call fetches a fresh one
     * (a refresh grant first when a refresh token is held). The SDK calls this
     * itself when the API answers 401; callers may use it to force a refresh.
     */
    public function invalidateAccessToken(): void
    {
        $this->tokenManager->invalidateAccessToken();
    }

    /**
     * Returns the base URL of the API.
     *
     * @return string the API base URL
     */
    public function getHost(): string
    {
        return $this->host;
    }

    /**
     * Returns the authentication headers with a Bearer token obtained
     * via the device authorization flow.
     *
     * @return array<string, string> the authorization headers
     *
     * @throws \LogicException if pollForToken() has not succeeded
     */
    public function getAuthHeaders(): array
    {
        if (!$this->tokenManager->isExchanged()) {
            throw new \LogicException('Must call pollForToken() before making API requests');
        }
        $params = [
            'grant_type' => 'refresh_token',
            'refresh_token' => $this->tokenManager->getRefreshToken() ?? '',
            'client_id' => $this->clientId,
        ];
        $token = $this->tokenManager->getAccessToken($this->refreshUrl, $params);

        return ['Authorization' => 'Bearer ' . $token];
    }

    /**
     * A public client holds no secret; the session's tokens are never shown
     * through var_dump() / print_r() / stack traces / error logs.
     *
     * @return array<string, mixed>
     */
    public function __debugInfo(): array
    {
        return [
            'host' => $this->host,
            'clientId' => $this->clientId,
            'deviceAuthorizationUrl' => $this->deviceAuthorizationUrl,
            'tokenUrl' => $this->tokenUrl,
            'refreshUrl' => $this->refreshUrl,
            'scopes' => $this->scopes,
            'tokenExchanged' => $this->tokenManager->isExchanged(),
        ];
    }
}
