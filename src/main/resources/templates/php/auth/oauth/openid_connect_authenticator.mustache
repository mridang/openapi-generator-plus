namespace {{invokerPackage}}\Auth\OAuth;

use {{invokerPackage}}\ApiClient;
use {{invokerPackage}}\Errors\ApiException;
use {{invokerPackage}}\ApiHttpResponse;
use {{invokerPackage}}\Auth\BaseAuthenticator;
use {{invokerPackage}}\Auth\HttpAwareAuthenticator;
use {{invokerPackage}}\Errors\SerializationException;

/**
 * Authenticator for OpenID Connect.
 *
 * Fetches the OIDC discovery document to discover the authorization and
 * token endpoints, then delegates to an {@see OAuth2AuthorizationCodeAuthenticator}.
 *
 * Implements {@see HttpAwareAuthenticator} so that both the discovery
 * request and subsequent token exchange requests use the shared
 * {@see ApiClient} with the same transport configuration (proxy, TLS,
 * timeouts) as regular API calls.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
class OpenIdConnectAuthenticator extends BaseAuthenticator implements HttpAwareAuthenticator
{
    /** @var string API base URL. */
    private readonly string $host;

    /** @var string OIDC discovery document URL. */
    private readonly string $openIdConnectUrl;

    /** @var string OAuth2 client ID. */
    private readonly string $clientId;

    /** @var string OAuth2 client secret. */
    private readonly string $clientSecret;

    /** @var string Redirect URI registered with the provider. */
    private readonly string $redirectUri;

    /** @var string[] Requested scopes. */
    private readonly array $scopes;

    /** @var ApiClient|null The shared API client for making discovery requests. */
    private ?ApiClient $apiClient = null;

    /** @var OAuth2AuthorizationCodeAuthenticator|null The delegate authenticator. */
    private ?OAuth2AuthorizationCodeAuthenticator $delegate = null;

    /** @var string|null The endpoints the current delegate was built for. */
    private ?string $discoveredEndpoints = null;

    /** @var int Unix timestamp at which the cached discovery document expires. */
    private int $discoveryExpiry = 0;

    /** RFC 8414 recommended default max-age for OIDC discovery documents. */
    private const int DEFAULT_DISCOVERY_MAX_AGE_SECONDS = 86400;

    /** Ceiling in seconds applied to a server-supplied max-age (one year). */
    private const int MAX_DISCOVERY_MAX_AGE_SECONDS = 31536000;

    /**
     * Create a new OpenID Connect authenticator.
     *
     * @param string   $host              API base URL
     * @param string   $openIdConnectUrl  OIDC discovery document URL
     * @param string   $clientId          OAuth2 client ID
     * @param string   $clientSecret      OAuth2 client secret
     * @param string   $redirectUri       redirect URI registered with the provider
     * @param string[] $scopes            requested scopes
     */
    public function __construct(
        string $host,
        string $openIdConnectUrl,
        string $clientId,
        #[\SensitiveParameter] string $clientSecret,
        string $redirectUri,
        array $scopes
    ) {
        $this->host = $host;
        $this->openIdConnectUrl = $openIdConnectUrl;
        $this->clientId = $clientId;
        $this->clientSecret = $clientSecret;
        $this->redirectUri = $redirectUri;
        /* OpenID Connect Core 3.1.2.1: the scope parameter must contain "openid". */
        $this->scopes = array_values(array_unique(array_merge(['openid'], $scopes)));
    }

    /**
     * Inject the shared API client for making discovery and token requests.
     *
     * @param ApiClient $apiClient the shared API client instance
     */
    public function setApiClient(ApiClient $apiClient): void
    {
        $this->apiClient = $apiClient;
    }

    /**
     * Lazily fetch the OIDC discovery document and create the delegate authenticator.
     *
     * @return OAuth2AuthorizationCodeAuthenticator the delegate
     *
     * @throws \LogicException if the API client has not been injected
     * @throws ApiException if the discovery request fails or returns a non-2xx status
     * @throws SerializationException if the discovery document is unusable
     */
    private function getDelegate(): OAuth2AuthorizationCodeAuthenticator
    {
        if ($this->delegate instanceof OAuth2AuthorizationCodeAuthenticator
            && time() < $this->discoveryExpiry) {
            return $this->delegate;
        }

        $apiClient = $this->apiClient;
        if (!$apiClient instanceof ApiClient) {
            throw new \LogicException(
                'ApiClient has not been injected. '
                . 'Ensure the {{clientClassName}} constructor calls setApiClient() '
                . 'on HttpAwareAuthenticator before making API requests.'
            );
        }

        /* Discovery is an HTTP call like any other: a transport failure
         * propagates unchanged as NetworkException / NetworkTimeoutException. */
        $response = $apiClient->sendRequest(
            'GET',
            $this->openIdConnectUrl,
            ['Accept' => 'application/json'],
            null,
            noDefaultHeaders: true
        );

        if ($response->statusCode < 200 || $response->statusCode >= 300) {
            throw ApiException::fromResponse($response->statusCode, $response->headers, $response->body);
        }

        $discovery = json_decode($response->body, true);
        if (!is_array($discovery)) {
            throw new SerializationException('OIDC discovery document is not a JSON object');
        }

        /* Reject a malformed/partial discovery document before building the
         * delegate: an absent/null/empty authorization_endpoint or
         * token_endpoint would otherwise be passed through and cause
         * credentials to be POSTed to a malformed URL. Parity with the other
         * SDKs which fail loudly here. */
        $authorizationEndpoint = $discovery['authorization_endpoint'] ?? null;
        if (!is_string($authorizationEndpoint) || $authorizationEndpoint === '') {
            throw new SerializationException("OIDC discovery document is missing 'authorization_endpoint'");
        }
        $tokenEndpoint = $discovery['token_endpoint'] ?? null;
        if (!is_string($tokenEndpoint) || $tokenEndpoint === '') {
            throw new SerializationException("OIDC discovery document is missing 'token_endpoint'");
        }

        /* OpenID Connect Discovery 1.0 section 4.3: the issuer must equal the
         * URL the document was fetched from (minus the well-known suffix),
         * which is the defence against a document served for another issuer.
         * A document that carries no issuer is not rejected here. */
        $wellKnown = '/.well-known/openid-configuration';
        $issuer = $discovery['issuer'] ?? null;
        if (is_string($issuer) && str_ends_with($this->openIdConnectUrl, $wellKnown)) {
            $expectedIssuer = rtrim(substr($this->openIdConnectUrl, 0, -strlen($wellKnown)), '/');
            if (rtrim($issuer, '/') !== $expectedIssuer) {
                throw new SerializationException(
                    "OIDC discovery issuer '" . $issuer . "' does not match '" . $expectedIssuer . "'"
                );
            }
        }
        /* The authorization code and the client secret travel to these
         * endpoints: refuse clear text unless the host is a loopback address
         * (RFC 8252 section 8.3). */
        foreach (['authorization_endpoint' => $authorizationEndpoint, 'token_endpoint' => $tokenEndpoint] as $name => $endpoint) {
            self::assertSecureEndpoint($name, $endpoint);
        }

        /* The session (tokens and the exchanged flag) lives in the token manager,
         * which outlives discovery: a document that names the same endpoints keeps
         * the delegate, and one that names new endpoints gets a delegate built
         * around the previous token manager, so refreshing the discovery cache
         * never discards the code exchange. */
        $endpoints = $authorizationEndpoint . "\n" . $tokenEndpoint;
        if ($this->delegate === null) {
            $this->delegate = new OAuth2AuthorizationCodeAuthenticator(
                $this->host,
                $this->clientId,
                $this->clientSecret,
                $authorizationEndpoint,
                $tokenEndpoint,
                $this->redirectUri,
                $this->scopes
            );
        } elseif ($endpoints !== $this->discoveredEndpoints) {
            $previous = $this->delegate;
            $this->delegate = new OAuth2AuthorizationCodeAuthenticator(
                $this->host,
                $this->clientId,
                $this->clientSecret,
                $authorizationEndpoint,
                $tokenEndpoint,
                $this->redirectUri,
                $this->scopes,
                null,
                $previous->getTokenManager()
            );
            $this->delegate->adoptPkceVerifier($previous);
        }
        $this->discoveredEndpoints = $endpoints;
        $this->delegate->setApiClient($apiClient);
        $this->discoveryExpiry = time() + $this->parseMaxAge($response->headers);

        return $this->delegate;
    }

    /**
     * Rejects a discovered endpoint that is not https, unless it is a loopback host.
     *
     * @throws SerializationException when the endpoint would send credentials in clear text
     */
    private static function assertSecureEndpoint(string $name, string $endpoint): void
    {
        $parts = parse_url($endpoint);
        $scheme = strtolower((string) ($parts['scheme'] ?? ''));
        $host = strtolower(trim((string) ($parts['host'] ?? ''), '[]'));
        if ($scheme === 'https') {
            return;
        }
        $loopback = $host === 'localhost' || $host === '::1' || str_starts_with($host, '127.');
        if ($scheme === 'http' && $loopback) {
            return;
        }
        throw new SerializationException(
            "OIDC discovery document '" . $name . "' must be an https URL (got '" . $endpoint . "')"
        );
    }

    /**
     * Parse `Cache-Control: max-age=<seconds>` from response headers.
     *
     * @param array<string, string> $headers response headers
     * @return int the parsed max-age in seconds, or 86400 (RFC 8414 default) if absent
     */
    private function parseMaxAge(array $headers): int
    {
        foreach ($headers as $name => $value) {
            if (strcasecmp((string) $name, 'Cache-Control') === 0) {
                if (preg_match('/max-age=(\d+)/i', (string) $value, $matches) === 1) {
                    $digits = ltrim($matches[1], '0');
                    if (strlen($digits) > 8) {
                        return self::MAX_DISCOVERY_MAX_AGE_SECONDS;
                    }
                    return min((int) $digits, self::MAX_DISCOVERY_MAX_AGE_SECONDS);
                }
                return self::DEFAULT_DISCOVERY_MAX_AGE_SECONDS;
            }
        }
        return self::DEFAULT_DISCOVERY_MAX_AGE_SECONDS;
    }

    /**
     * Build the authorization URL using the discovered authorization endpoint.
     *
     * @param string|null $state optional CSRF state parameter
     * @return string the authorization URL
     */
    public function buildAuthorizationUrl(?string $state = null): string
    {
        return $this->getDelegate()->buildAuthorizationUrl($state);
    }

    /**
     * Exchange an authorization code for tokens using the discovered token endpoint.
     *
     * @param string $code the authorization code from the callback
     */
    public function exchangeCode(string $code): void
    {
        $this->getDelegate()->exchangeCode($code);
    }

    /**
     * Drops the cached access token so that the next call fetches a fresh one
     * (a refresh grant first when a refresh token is held). The SDK calls this
     * itself when the API answers 401; callers may use it to force a refresh.
     */
    public function invalidateAccessToken(): void
    {
        $this->delegate?->invalidateAccessToken();
    }

    /**
     * Returns the base URL of the API.
     *
     * @return string the API base URL
     */
    public function getHost(): string
    {
        return $this->host;
    }

    /**
     * Returns the authentication headers from the delegate authenticator.
     *
     * @return array<string, string> the authorization headers
     */
    public function getAuthHeaders(): array
    {
        return $this->getDelegate()->getAuthHeaders();
    }

    /**
     * Masks the client secret so it never leaks through var_dump() /
     * print_r() / stack traces / error logs.
     *
     * @return array<string, mixed>
     */
    public function __debugInfo(): array
    {
        return [
            'host' => $this->host,
            'openIdConnectUrl' => $this->openIdConnectUrl,
            'clientId' => $this->clientId,
            'clientSecret' => '***',
            'redirectUri' => $this->redirectUri,
            'scopes' => $this->scopes,
        ];
    }
}
