namespace {{invokerPackage}}\Auth\OAuth;

/**
 * The answer of the device authorization endpoint (RFC 8628 section 3.2).
 *
 * Show the user code and the verification URI to the user, then pass the whole
 * value to {@see OAuth2DeviceAuthorizationAuthenticator::pollForToken()}.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final readonly class DeviceAuthorization
{
    /**
     * @param string      $deviceCode              the device verification code, sent back while polling
     * @param string      $userCode                the code the user enters at the verification URI
     * @param string      $verificationUri         the page where the user enters the code
     * @param string|null $verificationUriComplete the verification URI with the user code included, when the server sends one
     * @param int         $expiresIn               the lifetime of the device code and user code, in seconds
     * @param int         $interval                the seconds to wait between polls (5 when the server names none)
     */
    public function __construct(
        public string $deviceCode,
        public string $userCode,
        public string $verificationUri,
        public ?string $verificationUriComplete,
        public int $expiresIn,
        public int $interval,
    ) {
    }
}
