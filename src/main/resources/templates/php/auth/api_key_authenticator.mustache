namespace {{invokerPackage}}\Auth;

/**
 * Authenticator for API key authentication. Supports sending the key
 * as a header, query parameter, or cookie.
 */
final class ApiKeyAuthenticator extends BaseAuthenticator
{
    private readonly string $host;
    private readonly string $keyParamName;
    private readonly string $apiKey;
    private readonly ApiKeyLocation $location;

    public function __construct(string $host, string $keyParamName, string $apiKey, ApiKeyLocation $location)
    {
        $this->host = $host;
        $this->keyParamName = $keyParamName;
        $this->apiKey = $apiKey;
        $this->location = $location;
    }

    public function getHost(): string
    {
        return $this->host;
    }

    /** @return array<string, string> */
    public function getAuthHeaders(): array
    {
        if ($this->location === ApiKeyLocation::HEADER) {
            return [$this->keyParamName => $this->apiKey];
        }
        return [];
    }

    /** @return array<string, string> */
    public function getQueryParams(): array
    {
        if ($this->location === ApiKeyLocation::QUERY) {
            return [$this->keyParamName => $this->apiKey];
        }
        return [];
    }

    /** @return array<string, string> */
    public function getCookieParams(): array
    {
        if ($this->location === ApiKeyLocation::COOKIE) {
            return [$this->keyParamName => $this->apiKey];
        }
        return [];
    }
}
