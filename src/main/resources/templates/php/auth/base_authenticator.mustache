namespace {{invokerPackage}}\Auth;

/**
 * Abstract base class providing default implementations for optional
 * Authenticator methods. Concrete authenticators should extend this class.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
abstract class BaseAuthenticator implements Authenticator
{
    /** Prefix of the environment variables a credential is read from when none is passed. */
    protected const string ENV_PREFIX = '{{envPrefix}}';

    /**
     * The credential in the environment variable ENV_PREFIX_FIELD, or null when it is unset or empty.
     * Read once, when the authenticator is built.
     */
    protected static function environmentCredential(string $field): ?string
    {
        $value = getenv(self::ENV_PREFIX . '_' . $field);

        return is_string($value) && $value !== '' ? $value : null;
    }

    abstract public function getHost(): string;

    abstract public function getAuthHeaders(): array;

    /**
     * @return array<string, string>
     */
    public function getQueryParams(): array
    {
        return [];
    }

    /**
     * @return array<string, string>
     */
    public function getCookieParams(): array
    {
        return [];
    }
}
