namespace {{invokerPackage}}\Auth;

/**
 * Abstract base class providing default implementations for optional
 * Authenticator methods. Concrete authenticators should extend this class.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
abstract class BaseAuthenticator implements Authenticator
{
    abstract public function getHost(): string;

    abstract public function getAuthHeaders(): array;

    /**
     * @return array<string, string>
     */
    public function getQueryParams(): array
    {
        return [];
    }

    /**
     * @return array<string, string>
     */
    public function getCookieParams(): array
    {
        return [];
    }
}
