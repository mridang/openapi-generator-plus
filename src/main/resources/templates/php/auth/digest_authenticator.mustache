namespace {{invokerPackage}}\Auth;

/**
 * Authenticator for HTTP Digest authentication (RFC 7616).
 *
 * Nothing is sent with the first request. When the server answers 401 with a
 * `WWW-Authenticate: Digest` challenge, the SDK asks this authenticator to
 * answer it and replays the request once; later requests answer the
 * remembered challenge up front with the nonce count incremented. MD5,
 * MD5-sess, SHA-256 and SHA-256-sess are answered, with `qop=auth` or without
 * a qop.
 */
class DigestAuthenticator extends BaseAuthenticator
{
    /** The algorithms a challenge may name, in lower case; MD5 when it names none. */
    private const array ALGORITHMS = ['md5', 'md5-sess', 'sha-256', 'sha-256-sess'];

    private readonly string $host;
    private readonly string $username;
    private readonly string $password;

    /**
     * The remembered challenge, or null before any was accepted.
     *
     * @var array{realm: string, nonce: string, opaque: ?string, algorithm: ?string, qop: bool}|null
     */
    private ?array $challenge = null;

    private int $nonceCount = 0;

    /**
     * The client nonce of each answer: 16 random bytes as hex. Replaced in tests.
     *
     * @var \Closure(): string
     */
    private \Closure $cnonceSource;

    /**
     * @param string      $host     the API base URL
     * @param string|null $username the user name; when null, the environment variable of the generated
     *                              authenticator is used (an empty value counts as unset)
     * @param string|null $password the password; when null, the environment variable of the generated
     *                              authenticator is used (an empty value counts as unset)
     * @throws \InvalidArgumentException when a credential is missing or malformed
     */
    public function __construct(
        string $host,
        ?string $username = null,
        #[\SensitiveParameter] ?string $password = null
    ) {
        $username ??= static::environmentCredential('username');
        $password ??= static::environmentCredential('password');
        if ($username === null || $password === null) {
            throw new \InvalidArgumentException(
                'Digest credentials are required: pass a username and a password'
                . static::environmentHint('username', 'password')
            );
        }
        if ($username === '') {
            throw new \InvalidArgumentException('Digest username must not be empty');
        }
        if (preg_match('/[\r\n\x00]/', $username . $password) === 1) {
            throw new \InvalidArgumentException('Digest credentials must not contain a line break or NUL');
        }
        if (str_contains($username, '"')) {
            throw new \InvalidArgumentException('Digest username must not contain a double quote');
        }
        $this->host = $host;
        $this->username = $username;
        $this->password = $password;
        $this->cnonceSource = static fn (): string => bin2hex(random_bytes(16));
    }

    public function getHost(): string
    {
        return $this->host;
    }

    /**
     * Nothing up front: the header depends on the request and the challenge.
     *
     * @return array<string, string>
     */
    public function getAuthHeaders(): array
    {
        return [];
    }

    /**
     * The `Authorization` header that answers the remembered challenge.
     *
     * @param string $method        the upper-case HTTP method
     * @param string $requestTarget the path and query of the request URL
     *
     * @return string|null the header value, or null before any challenge was accepted
     */
    public function authorization(string $method, string $requestTarget): ?string
    {
        $challenge = $this->challenge;
        if ($challenge === null) {
            return null;
        }
        $algorithm = strtolower($challenge['algorithm'] ?? 'MD5');
        $hashName = str_starts_with($algorithm, 'sha-256') ? 'sha256' : 'md5';
        $hash = static fn (string $value): string => hash($hashName, $value);
        $this->nonceCount++;
        $nc = sprintf('%08x', $this->nonceCount);
        $cnonce = ($this->cnonceSource)();
        $ha1 = $hash($this->username . ':' . $challenge['realm'] . ':' . $this->password);
        if (str_ends_with($algorithm, '-sess')) {
            $ha1 = $hash($ha1 . ':' . $challenge['nonce'] . ':' . $cnonce);
        }
        $ha2 = $hash($method . ':' . $requestTarget);
        $response = $challenge['qop']
            ? $hash($ha1 . ':' . $challenge['nonce'] . ':' . $nc . ':' . $cnonce . ':auth:' . $ha2)
            : $hash($ha1 . ':' . $challenge['nonce'] . ':' . $ha2);
        $parts = [
            'username=' . self::quote($this->username),
            'realm=' . self::quote($challenge['realm']),
            'nonce=' . self::quote($challenge['nonce']),
            'uri=' . self::quote($requestTarget),
        ];
        if ($challenge['algorithm'] !== null) {
            $parts[] = 'algorithm=' . $challenge['algorithm'];
        }
        $parts[] = 'response="' . $response . '"';
        if ($challenge['qop']) {
            $parts[] = 'qop=auth';
            $parts[] = 'nc=' . $nc;
            $parts[] = 'cnonce=' . self::quote($cnonce);
        }
        if ($challenge['opaque'] !== null) {
            $parts[] = 'opaque=' . self::quote($challenge['opaque']);
        }

        return 'Digest ' . implode(', ', $parts);
    }

    /**
     * Remembers the first challenge of a `WWW-Authenticate` value this authenticator can answer.
     *
     * @param string $wwwAuthenticate the header value, every challenge of every line
     *
     * @return bool whether a challenge was accepted
     */
    public function acceptChallenge(string $wwwAuthenticate): bool
    {
        foreach (self::parseChallenges($wwwAuthenticate) as [$scheme, $params]) {
            if (strtolower($scheme) !== 'digest') {
                continue;
            }
            $qop = $params['qop'] ?? null;
            if ($qop !== null
                && !in_array('auth', array_map(static fn (string $o): string => strtolower(trim($o)), explode(',', $qop)), true)
            ) {
                continue;
            }
            $algorithm = $params['algorithm'] ?? null;
            if ($algorithm !== null && !in_array(strtolower($algorithm), self::ALGORITHMS, true)) {
                continue;
            }
            $this->challenge = [
                'realm' => $params['realm'] ?? '',
                'nonce' => $params['nonce'] ?? '',
                'opaque' => $params['opaque'] ?? null,
                'algorithm' => $algorithm,
                'qop' => $qop !== null,
            ];
            $this->nonceCount = 0;

            return true;
        }

        return false;
    }

    /** A quoted string, with the backslash and the double quote escaped. */
    private static function quote(string $value): string
    {
        return '"' . addcslashes($value, '\\"') . '"';
    }

    /**
     * Every challenge of a `WWW-Authenticate` value, as its scheme and its parameters (names in
     * lower case). A parameter is `name=token` or `name="quoted"` with backslash escapes.
     *
     * @return list<array{0: string, 1: array<string, string>}>
     */
    private static function parseChallenges(string $header): array
    {
        $challenges = [];
        $current = null;
        $n = strlen($header);
        $i = 0;
        $space = " \t\r\n";
        while ($i < $n) {
            while ($i < $n && ($header[$i] === ',' || str_contains($space, $header[$i]))) {
                $i++;
            }
            $start = $i;
            while ($i < $n && !str_contains($space . ',=', $header[$i])) {
                $i++;
            }
            $token = substr($header, $start, $i - $start);
            if ($token === '') {
                /* A stray '=' with no name before it. */
                $i++;
                continue;
            }
            $j = $i;
            while ($j < $n && str_contains($space, $header[$j])) {
                $j++;
            }
            if ($j >= $n || $header[$j] !== '=') {
                if ($current !== null) {
                    $challenges[] = $current;
                }
                $current = [$token, []];
                continue;
            }
            $i = $j + 1;
            while ($i < $n && str_contains($space, $header[$i])) {
                $i++;
            }
            $value = '';
            if ($i < $n && $header[$i] === '"') {
                $i++;
                while ($i < $n && $header[$i] !== '"') {
                    if ($header[$i] === '\\' && $i + 1 < $n) {
                        $i++;
                    }
                    $value .= $header[$i];
                    $i++;
                }
                $i++;
            } else {
                $valueStart = $i;
                while ($i < $n && $header[$i] !== ',' && !str_contains($space, $header[$i])) {
                    $i++;
                }
                $value = substr($header, $valueStart, $i - $valueStart);
            }
            $name = strtolower($token);
            if ($current !== null && !array_key_exists($name, $current[1])) {
                $current[1][$name] = $value;
            }
        }
        if ($current !== null) {
            $challenges[] = $current;
        }

        return $challenges;
    }

    /**
     * Masks the password so it never leaks through var_dump() / print_r() /
     * debug_zval_dump() / stack traces / error logs.
     *
     * @return array<string, string>
     */
    public function __debugInfo(): array
    {
        return [
            'host' => $this->host,
            'username' => $this->username,
            'password' => '***',
        ];
    }
}
