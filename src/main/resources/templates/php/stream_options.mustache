namespace {{invokerPackage}};

/**
 * Settings of one JSON Lines or server-sent events stream call, passed as the last argument of an
 * operation's `...Stream` method. Every value is optional; a value left out takes its default.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class StreamOptions
{
    /**
     * @param int|null    $idleTimeout    the longest the body may stay silent, in milliseconds; null keeps the
     *                                    transport's setting (60 seconds), 0 disables it
     * @param int|null    $maxReconnects  how many failures in a row, without an event, an event stream
     *                                    survives: 5 by default, 0 for a request with a body, -1 for no limit
     * @param int|null    $reconnectDelay the wait before a reconnect, in milliseconds: 1000 by default,
     *                                    doubling with jitter up to 30 seconds, unless the server sent a
     *                                    `retry` value
     * @param string|null $lastEventId    the id an event stream resumes from on its first request
     * @param int|null    $maxEventBytes  the longest line or event, in bytes: 1 MiB by default
     */
    public function __construct(
        public readonly ?int $idleTimeout = null,
        public readonly ?int $maxReconnects = null,
        public readonly ?int $reconnectDelay = null,
        public readonly ?string $lastEventId = null,
        public readonly ?int $maxEventBytes = null,
    ) {
        if ($idleTimeout !== null && $idleTimeout < 0) {
            throw new \InvalidArgumentException("Invalid idleTimeout: must not be negative (got $idleTimeout)");
        }
        if ($maxReconnects !== null && $maxReconnects < -1) {
            throw new \InvalidArgumentException("Invalid maxReconnects: must be -1 or more (got $maxReconnects)");
        }
        if ($reconnectDelay !== null && $reconnectDelay < 0) {
            throw new \InvalidArgumentException("Invalid reconnectDelay: must not be negative (got $reconnectDelay)");
        }
        if ($maxEventBytes !== null && $maxEventBytes <= 0) {
            throw new \InvalidArgumentException("Invalid maxEventBytes: must be positive (got $maxEventBytes)");
        }
    }
}
