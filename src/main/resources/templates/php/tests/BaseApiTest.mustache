test('bhv tracing 014 the traceparent still reaches the request when building the headers waits on the credentials', function (): void {
    withBaseApiTestTracing(function (\OpenTelemetry\SDK\Trace\TracerProvider $tracerProvider): void {
        $client = new CapturingApiClient();
        $api = new TestableApi($client, new Configuration('http://localhost'));
        $slowCredentials = new class implements Authenticator {
            public function getHost(): string
            {
                return '';
            }

            public function getAuthHeaders(): array
            {
                \Fiber::suspend('waiting for the credentials');

                return ['x-credential' => 'secret'];
            }

            public function getQueryParams(): array
            {
                return [];
            }

            public function getCookieParams(): array
            {
                return [];
            }
        };
        $span = $tracerProvider->getTracer('base-api-test')->spanBuilder('caller')->startSpan();
        $fiber = new \Fiber(static function () use ($api, $slowCredentials, $span): void {
            $scope = $span->activate();
            try {
                $api->call('GET', '/test/echo', [], [], null, ['application/json'], 'application/json', null, $slowCredentials);
            } finally {
                $scope->detach();
            }
        });
        $fiber->start();
        expect($fiber->isSuspended())->toBeTrue();
        $fiber->resume();
        $span->end();

        $context = $span->getContext();
        expect($client->capturedHeaders['x-credential'] ?? null)->toBe('secret');
        expect($client->capturedHeaders['traceparent'] ?? null)->toBe(sprintf(
            '00-%s-%s-%02x',
            $context->getTraceId(),
            $context->getSpanId(),
            $context->getTraceFlags()
        ));
    });
});

test('bhv tracing 015 concurrent operations each send the traceparent of their own caller span', function (): void {
    withBaseApiTestTracing(function (\OpenTelemetry\SDK\Trace\TracerProvider $tracerProvider): void {
        /** @var \ArrayObject<int, string> $requests */
        $requests = new \ArrayObject();
        /** @var \ArrayObject<int, array<string, string>> $headersSeen */
        $headersSeen = new \ArrayObject();
        $api = new TestableApi(inFlightTransport($requests, null, $headersSeen), new Configuration('http://localhost'));
        $tracer = $tracerProvider->getTracer('base-api-test');
        $spans = [$tracer->spanBuilder('first')->startSpan(), $tracer->spanBuilder('second')->startSpan()];
        $fibers = [];
        foreach ($spans as $span) {
            $fibers[] = new \Fiber(static function () use ($api, $span): void {
                $scope = $span->activate();
                try {
                    $api->call('GET', '/items', [], [], null, ['application/json'], null, 'object');
                } finally {
                    $scope->detach();
                }
            });
        }
        foreach ($fibers as $fiber) {
            $fiber->start();
        }
        foreach ($fibers as $fiber) {
            $fiber->resume();
        }

        expect($headersSeen)->toHaveCount(2);
        foreach ($spans as $index => $span) {
            $span->end();
            $context = $span->getContext();
            expect($headersSeen[$index]['traceparent'] ?? null)->toBe(sprintf(
                '00-%s-%s-%02x',
                $context->getTraceId(),
                $context->getSpanId(),
                $context->getTraceFlags()
            ));
        }
        expect($headersSeen[0]['traceparent'] ?? '')->not->toBe($headersSeen[1]['traceparent'] ?? '');
    });
});

