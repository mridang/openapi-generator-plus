/**
 * A transport that stays in flight until the caller resumes or cancels the fiber that runs the
 * call: PHP's native way to cancel work that is waiting (Fiber::throw), since a call takes no
 * cancellation signal of its own (S7).
 *
 * @param \ArrayObject<int, string>                       $requests    the URL of every request the transport started
 * @param \ArrayObject<int, array<string, string>>|null $headersSeen the headers of every request, when given
 */
function inFlightTransport(
    \ArrayObject $requests,
    ?\Throwable $thenFail = null,
    ?\ArrayObject $headersSeen = null
): ApiClient {
    return new class ($requests, $thenFail, $headersSeen) implements ApiClient {
        /**
         * @param \ArrayObject<int, string>                       $requests
         * @param \ArrayObject<int, array<string, string>>|null $headersSeen
         */
        public function __construct(
            private \ArrayObject $requests,
            private ?\Throwable $thenFail,
            private ?\ArrayObject $headersSeen
        ) {
        }

        public function close(): void
        {
        }

        /** @param array<string, string> $headers */
        public function sendRequest(
            string $method,
            string $url,
            array $headers,
            mixed $body,
            bool $noRedirect = false,
            bool $noDefaultHeaders = false,
        ): ApiHttpResponse {
            $this->requests->append($url);
            $this->headersSeen?->append($headers);
            \Fiber::suspend('in flight');
            if ($this->thenFail !== null) {
                throw $this->thenFail;
            }

            return new ApiHttpResponse(200, '{}', ['Content-Type' => 'application/json']);
        }
    };
}

/**
 * Starts $call in a fiber, lets it reach its in-flight request, then cancels it with $cancel.
 *
 * @param callable(): mixed $call
 */
function cancelWhileInFlight(callable $call, \Throwable $cancel): ?\Throwable
{
    $fiber = new \Fiber($call);
    $fiber->start();
    expect($fiber->isSuspended())->toBeTrue();
    $caught = null;
    try {
        $fiber->throw($cancel);
    } catch (\Throwable $e) {
        $caught = $e;
    }
    expect($fiber->isTerminated())->toBeTrue();

    return $caught;
}

test('bhv transport 083 cancelling an in-flight call aborts its request and surfaces the cancellation', function (): void {
