function makeBaseApiTestableApi(): TestableApi
{
    $url = getenv('CHASM_HTTP_URL') ?: '';
    $config = new Configuration($url);
    return new TestableApi(new DefaultApiClient(TransportOptions::builder()->maxRetries(0)->build()), $config);
}

