/**
 * A transport that answers every connection of an event stream with the next scripted body (an empty
 * one is a 204), recording the headers it was sent.
 *
 * @param list<string> $bodies
 */
function eventStreamTransport(array $bodies): ScriptedApiClient
{
    return new ScriptedApiClient(array_map(
        static fn (string $text): ApiHttpResponse => $text === ''
            ? new ApiHttpResponse(204, '', [])
            : new ApiHttpResponse(200, $text, ['Content-Type' => 'text/event-stream']),
        $bodies
    ));
}

/**
 * The value of a header, whatever the casing of its name.
 *
 * @param array<string, string> $headers
 */
function sentHeader(array $headers, string $name): ?string
{
    foreach ($headers as $key => $value) {
        if (strcasecmp((string) $key, $name) === 0) {
            return $value;
        }
    }

    return null;
}

/**
 * How often a header is present, whatever the casing of its name.
 *
 * @param array<string, string> $headers
 */
function sentHeaderCount(array $headers, string $name): int
{
    return count(array_filter(array_keys($headers), static fn (int|string $key): bool => strcasecmp((string) $key, $name) === 0));
}

