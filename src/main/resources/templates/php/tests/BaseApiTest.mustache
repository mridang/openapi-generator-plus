    $dropped = new \Fiber(
        static fn (): mixed => $api->call('GET', '/items', [], [], null, ['application/json'], null, 'object')
    );
    $dropped->start();
    expect($dropped->isSuspended())->toBeTrue();
    unset($dropped);
    gc_collect_cycles();

    $cancel = new \RuntimeException('cancelled by the caller');
    $caught = cancelWhileInFlight(
        static fn (): mixed => $api->call('GET', '/items', [], [], null, ['application/json'], null, 'object'),
        $cancel
    );

    expect($caught)->toBe($cancel);
    expect($requests)->toHaveCount(2);
});

