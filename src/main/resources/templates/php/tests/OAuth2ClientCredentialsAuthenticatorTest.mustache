namespace {{invokerPackage}}\Test;

use {{invokerPackage}}\ApiResponse;
use {{invokerPackage}}\Auth\OAuth\ClientAuthMethod;
use {{invokerPackage}}\Auth\OAuth\OAuth2ClientCredentialsAuthenticator;

test('sends client credentials grant type', function (): void {
    $client = new MockTokenApiClient();
    $client->enqueueResponse(new ApiResponse(200, (string) json_encode([
        'access_token' => 'cc-token',
        'expires_in' => 3600,
    ]), ['Content-Type' => 'application/json']));

    $authenticator = new OAuth2ClientCredentialsAuthenticator(
        'https://api.example.com',
        'my-client-id',
        'my-client-secret',
        'https://auth.example.com/token',
        ['read']
    );
    $authenticator->setApiClient($client);

    $headers = $authenticator->getAuthHeaders();

    expect($headers['Authorization'])->toBe('Bearer cc-token');
    expect($client->capturedRequests)->toHaveCount(1);
    $request = $client->capturedRequests[0];
    expect($request['body'] ?? '')->toContain('grant_type=client_credentials');
});

