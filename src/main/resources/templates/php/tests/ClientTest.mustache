test('injected api client is wired into every api group', function (): void {
    // A custom ApiClient passed to the facade must reach the supplied transport from every
    // API group sends through — this is the seam that lets a Psr18ApiClient (or
    // any bespoke transport) replace the bundled DefaultApiClient.
    $stub = new class implements ApiClient {
        public int $sent = 0;

        public bool $closed = false;

        public function close(): void
        {
            $this->closed = true;
        }

        public function sendRequest(
            string $method,
            string $url,
            array $headers,
            mixed $body,
            bool $noRedirect = false,
        ): ApiHttpResponse {
            $this->sent++;

            return new ApiHttpResponse(200, '', []);
        }
    };

    $client = new {{clientClassName}}($this->authenticator, null, $stub);

    $count = 0;
{{#apiInfo}}
{{#apis}}
{{#operations}}
    $property = (new \ReflectionClass(\{{apiPackage}}\{{classname}}::class))->getProperty('apiClient');
    $transport = $property->getValue($client->{{clientPropertyName}});
    assert($transport instanceof ApiClient);
    $transport->sendRequest('GET', 'http://example.com/ping', [], null);
    $count++;
{{/operations}}
{{/apis}}
{{/apiInfo}}
    expect($stub->sent)->toBe($count);
});

test('a closed client rejects further requests from every api group and keeps a supplied transport open', function (): void {
    $stub = new class implements ApiClient {
        public int $sent = 0;

        public bool $closed = false;

        public function close(): void
        {
            $this->closed = true;
        }

        public function sendRequest(
            string $method,
            string $url,
            array $headers,
            mixed $body,
            bool $noRedirect = false,
        ): ApiHttpResponse {
            $this->sent++;

            return new ApiHttpResponse(200, '', []);
        }
    };

    $client = new {{clientClassName}}($this->authenticator, null, $stub);
    $client->close();
    $client->close();

{{#apiInfo}}
{{#apis}}
{{#operations}}
    $property = (new \ReflectionClass(\{{apiPackage}}\{{classname}}::class))->getProperty('apiClient');
    $transport = $property->getValue($client->{{clientPropertyName}});
    assert($transport instanceof ApiClient);
    expect(fn () => $transport->sendRequest('GET', 'http://example.com/ping', [], null))
        ->toThrow(\LogicException::class, 'closed');
{{/operations}}
{{/apis}}
{{/apiInfo}}
    expect($stub->sent)->toBe(0);
    expect($stub->closed)->toBeFalse();
});

