/**
 * A transport that counts how often it was asked to send and to close.
 *
 * @return array{0: ApiClient, 1: \stdClass}
 */
function newRecordingTransport(): array
{
    $counts = new \stdClass();
    $counts->sent = 0;
    $counts->closes = 0;
    $transport = new class($counts) implements ApiClient {
        public function __construct(private readonly \stdClass $counts)
        {
        }

        public function close(): void
        {
            $this->counts->closes++;
        }

        public function sendRequest(
            string $method,
            string $url,
            array $headers,
            mixed $body,
            bool $noRedirect = false,
            bool $noDefaultHeaders = false,
        ): ApiHttpResponse {
            $this->counts->sent++;

            return new ApiHttpResponse(200, '{}', ['Content-Type' => 'application/json']);
        }
    };

    return [$transport, $counts];
}

