test('builder rejects a proxy with a non http scheme at build', function (): void {
    expect(fn () => TransportOptions::builder()->proxy('ftp://proxy:21')->build())
        ->toThrow(\InvalidArgumentException::class, 'Invalid proxy URL (must use http or https scheme): ftp://proxy:21');
});

test('constructor rejects a proxy with a non http scheme', function (): void {
    expect(fn () => new TransportOptions(proxy: 'socks5://proxy:1080'))
        ->toThrow(\InvalidArgumentException::class, 'Invalid proxy URL (must use http or https scheme): socks5://proxy:1080');
});

test('constructor rejects a malformed proxy url', function (): void {
    expect(fn () => new TransportOptions(proxy: 'not-a-url'))
        ->toThrow(\InvalidArgumentException::class, 'Invalid proxy URL: not-a-url');
});

test('bhv options 008 a rejected proxy url never carries its userinfo into the message', function (string $proxy, string $expected): void {
    expect(fn () => new TransportOptions(proxy: $proxy))
        ->toThrow(function (\Exception $e) use ($expected): void {
            expect($e->getMessage())->toBe($expected);
            expect($e->getMessage())->not->toContain('s3cret');
        });
})->with([
    'unsupported scheme' => [
        'socks5://svc:s3cret@proxy:1080',
        'Invalid proxy URL (must use http or https scheme): socks5://***@proxy:1080',
    ],
    'ftp scheme' => [
        'ftp://svc:s3cret@proxy:21',
        'Invalid proxy URL (must use http or https scheme): ftp://***@proxy:21',
    ],
]);

test('constructor accepts a valid proxy and none', function (): void {
    expect((new TransportOptions(proxy: 'https://proxy:3128'))->proxy)->toBe('https://proxy:3128');
    expect((new TransportOptions())->proxy)->toBeNull();
});

test('bhv options 011 constructor rejects a proxy that has no usable scheme or host', function (string $proxy): void {
    expect(fn () => new TransportOptions(proxy: $proxy))
        ->toThrow(\InvalidArgumentException::class, 'Invalid proxy URL');
})->with([
    'scheme only' => ['http://'],
    'empty string' => [''],
    'host and port without a scheme' => ['proxy.example.com:3128'],
]);

test('bhv options 009 constructor accepts a proxy url with an ipv6 literal host', function (string $proxy): void {
    expect((new TransportOptions(proxy: $proxy))->proxy)->toBe($proxy);
})->with([
    'loopback' => ['http://[::1]:3128'],
    'without a port' => ['https://[2001:db8::1]'],
    'with userinfo' => ['http://user:pw@[::1]:3128'],
]);

test('bhv options 010 constructor rejects a proxy url with an unterminated ipv6 literal host', function (string $proxy): void {
    expect(fn () => new TransportOptions(proxy: $proxy))
        ->toThrow(\InvalidArgumentException::class, 'Invalid proxy URL');
})->with([
    'no closing bracket' => ['http://[::1:3128'],
    'bracket only' => ['http://['],
]);

test('bhv options 023 debug output masks the proxy password and credential default headers', function (): void {
    $opts = TransportOptions::builder()
        ->proxy('http://user:s3cr3t@proxy.example.com:8080')
        ->defaultHeader('Authorization', 'Bearer s3cr3t')
        ->defaultHeader('Proxy-Authorization', 'Basic s3cr3t')
        ->defaultHeader('Cookie', 'session=s3cr3t')
        ->defaultHeader('X-Api-Key', 's3cr3t')
        ->defaultHeader('X-Trace', 'visible')
        ->build();

    $dump = print_r($opts, true);

    expect($dump)->not->toContain('s3cr3t');
    expect($dump)->toContain('http://user:***@proxy.example.com:8080');
    expect($dump)->toContain('visible');
    expect($opts->proxy)->toBe('http://user:s3cr3t@proxy.example.com:8080');
});

