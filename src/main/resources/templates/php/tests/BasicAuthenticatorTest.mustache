/**
 * Runs $body with each variable of $values set (null unsets it), then restores the previous values.
 *
 * @param array<string, ?string> $values
 */
function withBasicEnvValues(array $values, callable $body): void
{
    $previous = [];
    foreach ($values as $name => $value) {
        $previous[$name] = getenv($name);
        putenv($value === null ? $name : $name . '=' . $value);
    }
    try {
        $body();
    } finally {
        foreach ($previous as $name => $value) {
            putenv($value === false ? $name : $name . '=' . $value);
        }
    }
}

/**
 * Checks every generated basic scheme wrapper with the username and password set to $user and $secret: when the
 * variable of $field is empty, construction fails and the message names that variable.
 */
function assertBasicWrappersRefuseEmptyVariable(string $field, string $user, string $secret): void
{
    $matched = 0;
    foreach (glob(dirname(__DIR__) . '/lib/Auth/*Authenticator.php') ?: [] as $file) {
        $class = '{{invokerPackage}}\\Auth\\' . basename($file, '.php');
        if (!is_subclass_of($class, BasicAuthenticator::class)) {
            continue;
        }
        $matched++;
        $variables = basicWrapperEnvVariables($class);
        withBasicEnvValues([$variables['username'] => $user, $variables['password'] => $secret], function () use ($class, $variables, $field): void {
            expect(fn () => basicWrapper($class, 'https://api.example.com'))
                ->toThrow(\InvalidArgumentException::class, $variables[$field]);
        });
    }
    expect($matched)->toBeGreaterThan(0);
}

