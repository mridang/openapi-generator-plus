/**
 * Runs $body with the user name and password environment variables of {{className}} set (null unsets one), then restores them.
 */
function withBasicEnvironment(?string $user, ?string $secret, callable $body): void
{
    $names = ['{{usernameEnv}}' => $user, '{{passwordEnv}}' => $secret];
    $previous = [];
    foreach ($names as $name => $value) {
        $previous[$name] = getenv($name);
        putenv($value === null ? $name : $name . '=' . $value);
    }
    try {
        $body();
    } finally {
        foreach ($previous as $name => $value) {
            putenv($value === false ? $name : $name . '=' . $value);
        }
    }
}

