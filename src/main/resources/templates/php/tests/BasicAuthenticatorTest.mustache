test('bhv errors 081 a refused credential names whether the username or the password is at fault', function (): void {
    expect(fn () => new BasicAuthenticator('https://api.example.com', "bad\nuser", 'secret'))
        ->toThrow(\InvalidArgumentException::class, 'username');
    expect(fn () => new BasicAuthenticator('https://api.example.com', 'user', "bad\npassword"))
        ->toThrow(\InvalidArgumentException::class, 'password');
});

/**
 * Builds a generated basic wrapper by its class name; the wrappers take their arguments from the base constructor.
 */
function basicWrapper(string $class, string ...$args): BasicAuthenticator
{
    $wrapper = new $class(...$args);
    \assert($wrapper instanceof BasicAuthenticator);

    return $wrapper;
}

/**
 * The environment variable names a generated basic wrapper reads its user and password from.
 *
 * @param class-string $class
 * @return array<string, string>
 */
function basicWrapperEnvVariables(string $class): array
{
    $constants = (new \ReflectionClass($class))->getConstant('ENV_VARS');
    \assert(is_array($constants));

    return array_map(static function (mixed $name): string {
        \assert(is_string($name));

        return $name;
    }, $constants);
}

