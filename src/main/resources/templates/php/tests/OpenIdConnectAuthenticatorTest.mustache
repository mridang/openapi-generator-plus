/**
 * Asserts that the client secret never leaks through print_r()'s use of
 * __debugInfo(): the literal secret is absent and the masked '***'
 * placeholder is present.
 */
test('bhv authoidc 019 redacts secret', function (): void {
    $authenticator = new OpenIdConnectAuthenticator(
        'https://api.example.com',
        'https://auth.example.com/.well-known/openid-configuration',
        'my-client-id',
        'my-client-secret',
        'https://app.example.com/callback',
        []
    );

    $printR = print_r($authenticator, true);

    expect($printR)->not->toContain('my-client-secret');
    expect($printR)->toContain('***');
});

test('secret constructor parameters are marked sensitive', function (): void {
    $sensitive = [];
    foreach ((new \ReflectionMethod(OpenIdConnectAuthenticator::class, '__construct'))->getParameters() as $param) {
        if ($param->getAttributes(\SensitiveParameter::class) !== []) {
            $sensitive[] = $param->getName();
        }
    }
    expect($sensitive)->toBe(['clientSecret']);
});

test('oidc refetches discovery once its Cache-Control max-age has elapsed', function (): void {
    $client = new MockTokenApiClient();
    $discovery = (string) json_encode([
        'authorization_endpoint' => 'https://auth.example.com/authorize',
        'token_endpoint' => 'https://auth.example.com/token',
    ]);
    $client->enqueueResponse(new ApiHttpResponse(200, $discovery, ['Cache-Control' => 'public, max-age=0']));
    $client->enqueueResponse(new ApiHttpResponse(200, $discovery, ['Cache-Control' => 'public, max-age=0']));

    $authenticator = new OpenIdConnectAuthenticator(
        'https://api.example.com',
        'https://auth.example.com/.well-known/openid-configuration',
        'my-client-id',
        'my-client-secret',
        'https://app.example.com/callback',
        []
    );
    $authenticator->setApiClient($client);

    $authenticator->buildAuthorizationUrl();
    $authenticator->buildAuthorizationUrl();

    expect($client->capturedRequests)->toHaveCount(2);
});

test('bhv authoidc 020 oidc rediscovery after expiry keeps the exchanged session', function (): void {
    $client = new MockTokenApiClient();
    $discovery = (string) json_encode([
        'authorization_endpoint' => 'https://auth.example.com/authorize',
        'token_endpoint' => 'https://auth.example.com/token',
    ]);
    $expired = ['Cache-Control' => 'max-age=0'];
    $client->enqueueResponse(new ApiHttpResponse(200, $discovery, $expired));
    $client->enqueueResponse(new ApiHttpResponse(200, (string) json_encode([
        'access_token' => 'at-1',
        'token_type' => 'Bearer',
        'expires_in' => 3600,
    ]), ['Content-Type' => 'application/json']));
    $client->enqueueResponse(new ApiHttpResponse(200, $discovery, $expired));

    $authenticator = new OpenIdConnectAuthenticator(
        'https://api.example.com',
        'https://auth.example.com/.well-known/openid-configuration',
        'my-client-id',
        'my-client-secret',
        'https://app.example.com/callback',
        []
    );
    $authenticator->setApiClient($client);

    $authenticator->exchangeCode('the-code');

    // The cached document has expired, so this call rediscovers; the exchange made
    // before it must still count.
    expect($authenticator->getAuthHeaders())->toBe(['Authorization' => 'Bearer at-1']);
});

