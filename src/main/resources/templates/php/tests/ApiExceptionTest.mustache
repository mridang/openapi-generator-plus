    expect(ApiException::fromResponse(503, null, null))->toBeInstanceOf(\{{invokerPackage}}\Errors\ServerException::class);
});

test('bhv errors 096 a status outside every class range falls back to the base error', function (): void {
    foreach ([399, 600] as $status) {
        $ex = ApiException::fromResponse($status, null, null);

        expect($ex::class)->toBe(ApiException::class);
        expect($ex)->not->toBeInstanceOf(\{{invokerPackage}}\Errors\ClientException::class);
        expect($ex)->not->toBeInstanceOf(\{{invokerPackage}}\Errors\ServerException::class);
    }
});

test('bhv errors 097 an unrecognised 4xx status raises the generic client error', function (): void {
    $ex = ApiException::fromResponse(499, null, null);

    expect($ex::class)->toBe(\{{invokerPackage}}\Errors\ClientException::class);
});

test('bhv misc 284 a status with a typed error raises that typed error', function (): void {
    $cases = [
        400 => \{{invokerPackage}}\Errors\BadRequestException::class,
        403 => \{{invokerPackage}}\Errors\ForbiddenException::class,
        404 => \{{invokerPackage}}\Errors\NotFoundException::class,
        409 => \{{invokerPackage}}\Errors\ConflictException::class,
        422 => \{{invokerPackage}}\Errors\UnprocessableEntityException::class,
        429 => \{{invokerPackage}}\Errors\TooManyRequestsException::class,
        500 => \{{invokerPackage}}\Errors\InternalServerErrorException::class,
        502 => \{{invokerPackage}}\Errors\BadGatewayException::class,
    ];
    foreach ($cases as $status => $class) {
        expect(ApiException::fromResponse($status, [], ''))->toBeInstanceOf($class);
    }
});
