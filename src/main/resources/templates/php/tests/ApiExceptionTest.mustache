test('bhv errors 080 every typed API error extends the base ApiException', function (): void {
    /* #5: a caller catching the base ApiException must catch every typed
     * error the SDK throws. ClientException/ServerException extend
     * ApiException directly; the status-specific errors extend those. A
     * catch on ApiException therefore covers them all. */
    $typed = [
        new \{{invokerPackage}}\Errors\BadRequestException('bad request'),
        new \{{invokerPackage}}\Errors\UnauthorizedException('unauthorized'),
        new \{{invokerPackage}}\Errors\ForbiddenException('forbidden'),
        new \{{invokerPackage}}\Errors\NotFoundException('not found'),
        new \{{invokerPackage}}\Errors\ConflictException('conflict'),
        new \{{invokerPackage}}\Errors\UnprocessableEntityException('unprocessable'),
        new \{{invokerPackage}}\Errors\TooManyRequestsException('slow down'),
        new \{{invokerPackage}}\Errors\PaymentRequiredException('slow down'),
        new \{{invokerPackage}}\Errors\MethodNotAllowedException('slow down'),
        new \{{invokerPackage}}\Errors\RequestTimeoutException('slow down'),
        new \{{invokerPackage}}\Errors\GoneException('slow down'),
        new \{{invokerPackage}}\Errors\PayloadTooLargeException('slow down'),
        new \{{invokerPackage}}\Errors\UnsupportedMediaTypeException('slow down'),
        new \{{invokerPackage}}\Errors\LockedException('slow down'),
        new \{{invokerPackage}}\Errors\NotImplementedException('slow down'),
        new \{{invokerPackage}}\Errors\BadGatewayException('slow down'),
        new \{{invokerPackage}}\Errors\ServiceUnavailableException('slow down'),
        new \{{invokerPackage}}\Errors\GatewayTimeoutException('slow down'),
        new \{{invokerPackage}}\Errors\ClientException(418, 'client error'),
        new \{{invokerPackage}}\Errors\InternalServerErrorException('server error'),
        new \{{invokerPackage}}\Errors\ServerException(503, 'server error'),
    ];

    foreach ($typed as $ex) {
        expect($ex)->toBeInstanceOf(ApiException::class);
    }
});

