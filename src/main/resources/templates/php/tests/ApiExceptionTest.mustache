test('bhv langphp 053 a thrown typed error is caught by a {{errorPrefix}}Exception catch', function (): void {
    /* Full chain: UnauthorizedException → ClientException → ApiException
     * → {{errorPrefix}}Exception → \Exception. Catching the root must catch the
     * 401 typed error. */
    $caught = null;
    try {
        throw new \{{invokerPackage}}\Errors\UnauthorizedException('unauthorized');
    } catch ({{errorPrefix}}Exception $e) {
        $caught = $e;
    }

    expect($caught)->toBeInstanceOf(\{{invokerPackage}}\Errors\UnauthorizedException::class);
    expect($caught)->toBeInstanceOf(ApiException::class);
    expect($caught)->toBeInstanceOf({{errorPrefix}}Exception::class);
    assert($caught instanceof ApiException);
    expect($caught->getStatusCode())->toBe(401);
});

