{{#apiKeyScheme}}
/**
 * Runs $body with the API key environment variable of {{className}} set to $value (null unsets it), then restores it.
 */
function withApiKeyEnvironment(?string $value, callable $body): void
{
    $name = '{{apiKeyEnv}}';
    $previous = getenv($name);
    putenv($value === null ? $name : $name . '=' . $value);
    try {
        $body();
    } finally {
        putenv($previous === false ? $name : $name . '=' . $previous);
    }
}

/**
 * The key an authenticator sends, wherever its scheme puts it (header, query or cookie).
 *
 * @return list<string>
 */
function sentApiKeys(\{{invokerPackage}}\Auth\Authenticator $auth): array
{
    return array_values(array_merge($auth->getAuthHeaders(), $auth->getQueryParams(), $auth->getCookieParams()));
}

