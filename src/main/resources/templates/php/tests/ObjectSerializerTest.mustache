    \assert($meta instanceof Metadata);
    /** @var Metadata $back */
    $back = ObjectSerializer::deserialize(ObjectSerializer::serialize($meta), Metadata::class);
    \assert($back instanceof Metadata);

    expect($back->additionalProperties->get('region'))->toBe('emea');
});


