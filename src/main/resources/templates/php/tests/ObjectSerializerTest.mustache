test('bhv serializationobject 104 models named Error and Result nest and round trip', function (): void {
    $model = new EdgeCases(
        lastError: new \{{modelPackage}}\Error(500, 'boom'),
        outcome: new \{{modelPackage}}\Result(true)
    );
    $json = ObjectSerializer::serialize($model);

    expect($json)->toContain('"lastError":{"code":500,"message":"boom"}');
    expect($json)->toContain('"outcome":{"ok":true}');
    /** @var EdgeCases $back */
    $back = ObjectSerializer::deserialize($json, EdgeCases::class);
    \assert($back instanceof EdgeCases);
    expect($back->lastError)->toBeInstanceOf(\{{modelPackage}}\Error::class);
    expect($back->lastError?->code)->toBe(500);
    expect($back->lastError?->message)->toBe('boom');
    expect($back->outcome)->toBeInstanceOf(\{{modelPackage}}\Result::class);
    expect($back->outcome?->ok)->toBeTrue();
});

test('bhv serializationobject 024 an inline enum keeps its mixed-case wire values, and an unknown value inside a container is rejected', function (): void {
    $cases = [
        [\{{modelPackage}}\EdgeCasesPhaseEnum::IN_STOCK, 'In-Stock'],
        [\{{modelPackage}}\EdgeCasesPhaseEnum::ON_HOLD, 'on-hold'],
        [\{{modelPackage}}\EdgeCasesPhaseEnum::OUT_OF_STOCK, 'OUT_OF_STOCK'],
    ];

    foreach ($cases as [$case, $wire]) {
        $json = ObjectSerializer::serialize(new EdgeCases(phase: $case));

        expect($json)->toContain('"phase":"' . $wire . '"');
        /** @var EdgeCases $back */
        $back = ObjectSerializer::deserialize($json, EdgeCases::class);
        \assert($back instanceof EdgeCases);
        expect($back->phase)->toBe($case);
    }

    expect(fn (): mixed => ObjectSerializer::deserialize('{"a":"purple"}', 'Ds\Map<Swatch>'))
        ->toThrow(\{{invokerPackage}}\Errors\SerializationException::class);
});

