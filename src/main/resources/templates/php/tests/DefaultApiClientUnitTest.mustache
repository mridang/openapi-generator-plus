                $capturedHeaders[strtolower(trim($parts[0]))] = trim($parts[1]);
            }
        }
        return $hop2;
    });
    $client = new StubbedDefaultApiClient($mock, $transport);

    $client->sendRequest('GET', 'https://api.example.com/start', [
