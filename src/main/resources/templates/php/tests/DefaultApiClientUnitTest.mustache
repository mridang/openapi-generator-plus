test('a redirect keeps credentials only when the target is the same origin', function (string $start, string $location, bool $kept): void {
    /* Origin equality is scheme + host + effective port, so an explicit
     * default port or a differently cased host is still the same origin and
     * must not lose its credentials, while a different port, host or scheme
     * must. */
    $capturedHeaders = [];
    $hops = 0;
    $mockClient = new MockHttpClient(
        function (string $method, string $url, array $options) use (&$capturedHeaders, &$hops, $location): MockResponse {
            $hops++;
            if ($hops === 1) {
                return new MockResponse('', ['http_code' => 302, 'response_headers' => ['Location' => $location]]);
            }
            foreach ($options['normalized_headers'] ?? [] as $values) {
                [$name, $value] = explode(': ', $values[0], 2);
                $capturedHeaders[strtolower($name)] = $value;
            }
            return new MockResponse('ok', ['http_code' => 200]);
        }
    );
    $transport = TransportOptions::builder()->followRedirects(true)->build();
    $client = new StubbedDefaultApiClient($mockClient, $transport);

    $client->sendRequest('GET', $start, [
        'Authorization' => 'Bearer secret',
        'Cookie' => 'session=xyz',
        'Proxy-Authorization' => 'Basic cHJveHk6c2VjcmV0',
        'X-Trace' => 'keep',
    ], null);

    expect($hops)->toBe(2);
    expect($capturedHeaders['x-trace'] ?? null)->toBe('keep');
    if ($kept) {
        expect($capturedHeaders['authorization'] ?? null)->toBe('Bearer secret');
        expect($capturedHeaders['cookie'] ?? null)->toBe('session=xyz');
        expect($capturedHeaders['proxy-authorization'] ?? null)->toBe('Basic cHJveHk6c2VjcmV0');
    } else {
        expect($capturedHeaders)->not->toHaveKey('authorization');
        expect($capturedHeaders)->not->toHaveKey('cookie');
        expect($capturedHeaders)->not->toHaveKey('proxy-authorization');
    }
})->with([
    'same origin absolute url' => ['https://api.example.com/start', 'https://api.example.com/final', true],
    'same origin relative path' => ['https://api.example.com/start', '/final', true],
    'explicit default https port' => ['https://api.example.com/start', 'https://api.example.com:443/final', true],
    'explicit default http port' => ['http://api.example.com/start', 'http://api.example.com:80/final', true],
    'implicit default port after explicit' => ['https://api.example.com:443/start', 'https://api.example.com/final', true],
    'host case differs' => ['https://api.example.com/start', 'https://API.EXAMPLE.COM/final', true],
    'different port' => ['https://api.example.com/start', 'https://api.example.com:8443/final', false],
    'different host' => ['https://api.example.com/start', 'https://other.example.com/final', false],
    'scheme upgrade changes the port' => ['http://api.example.com/start', 'https://api.example.com/final', false],
]);

