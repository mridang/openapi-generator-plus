test('bhv redirects 024 a redirect keeps credentials only when the target is the same origin', function (string $start, string $location, bool $kept): void {
    /* Origin equality is scheme + host + effective port, so an explicit
     * default port or a differently cased host is still the same origin and
     * must not lose its credentials, while a different port, host or scheme
     * must. */
    $capturedHeaders = [];
    $hops = 0;
    $mockClient = new MockHttpClient(
        function (string $method, string $url, array $options) use (&$capturedHeaders, &$hops, $location): MockResponse {
            $hops++;
            if ($hops === 1) {
                return new MockResponse('', ['http_code' => 302, 'response_headers' => ['Location' => $location]]);
            }
            foreach ($options['normalized_headers'] ?? [] as $values) {
                [$name, $value] = explode(': ', $values[0], 2);
                $capturedHeaders[strtolower($name)] = $value;
            }
            return new MockResponse('ok', ['http_code' => 200]);
        }
    );
    $transport = TransportOptions::builder()->followRedirects(true)->build();
    $client = new StubbedDefaultApiClient($mockClient, $transport);

    $client->sendRequest('GET', $start, [
        'Authorization' => 'Bearer secret',
        'Cookie' => 'session=xyz',
        'Proxy-Authorization' => 'Basic cHJveHk6c2VjcmV0',
        'X-Trace' => 'keep',
    ], null);

    expect($hops)->toBe(2);
