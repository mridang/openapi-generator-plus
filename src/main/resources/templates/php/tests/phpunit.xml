<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         cacheResult="false">
    <!-- Every test file the generator emits runs: the suite is the whole
         tests/ directory (unit, integration, and API tests alike), so a new
         test file can never be silently left out of the run. -->
    <testsuites>
        <testsuite name="All Tests">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <!-- Coverage source declaration uses phpunit 10/11's `<source>` schema
         rather than the legacy `<coverage><include>` block. The legacy
         form still parses but phpunit emits a "Filter for code coverage
         has not been configured" warning that pest's parallel runner
         treats as a fatal exit. The <source> form is the supported
         shape going forward. -->
    <source>
        <include>
            <directory suffix=".php">lib</directory>
        </include>
    </source>
    <coverage>
        <report>
            <cobertura outputFile=".out/coverage.xml"/>
        </report>
    </coverage>
    <logging>
        <junit outputFile=".out/reports/junit.xml"/>
    </logging>
</phpunit>
