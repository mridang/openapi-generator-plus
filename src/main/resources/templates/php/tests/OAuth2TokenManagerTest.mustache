test('expires in short lived token does not storm', function (): void {
    // Gap CM: short-lived token (expires_in < buffer) must produce exactly
    // ONE network call from a single getAccessToken invocation.
    $client = new MockTokenApiClient();
    $client->enqueueResponse(makeOAuth2TokenManagerResponse('short', 10));

    $manager = new OAuth2TokenManager();
    $manager->setApiClient($client);

    $token = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);

    expect($token)->toBe('short');
    expect($client->capturedRequests)->toHaveCount(1);
});

test('expires in long lived token applies full buffer', function (): void {
    // Gap CM: long-lived token gets full 30s buffer; second call serves
    // from cache.
    $client = new MockTokenApiClient();
    $client->enqueueResponse(makeOAuth2TokenManagerResponse('long', 3600));

    $manager = new OAuth2TokenManager();
    $manager->setApiClient($client);

    $first = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);
    $second = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);

    expect($first)->toBe('long');
    expect($second)->toBe('long');
    expect($client->capturedRequests)->toHaveCount(1);
});

test('expires in exactly buffer returns zero buffer', function (): void {
    // Gap CM: expires_in == 30 collapses expiry to now, forcing refetch.
    $client = new MockTokenApiClient();
    $client->enqueueResponse(makeOAuth2TokenManagerResponse('edge1', 30));
    $client->enqueueResponse(makeOAuth2TokenManagerResponse('edge2', 30));

    $manager = new OAuth2TokenManager();
    $manager->setApiClient($client);

    $first = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);
    $second = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);

    expect($first)->toBe('edge1');
    expect($second)->toBe('edge2');
    expect($client->capturedRequests)->toHaveCount(2);
});

test('refresh token empty string preserves existing', function (): void {
    // Gap A3 (RFC 6749 §6): an empty refresh_token in a refresh response
    // MUST NOT clobber the cached refresh_token.
    $client = new MockTokenApiClient();
    // Seed: initial token grant returns refresh_token "old_refresh" with a
    // short-lived access token so the next call triggers a refresh.
    $client->enqueueResponse(makeOAuth2TokenManagerResponse('old_access', 1, 'old_refresh'));
    // Refresh response: explicit empty refresh_token must not overwrite cache.
    $client->enqueueResponse(new ApiHttpResponse(
        200,
        (string) json_encode(['access_token' => 'new_access', 'expires_in' => 3600, 'refresh_token' => '']),
        ['Content-Type' => 'application/json']
    ));

    $manager = new OAuth2TokenManager();
    $manager->setApiClient($client);

    $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'authorization_code']);
    expect($manager->getRefreshToken())->toBe('old_refresh');

    $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'authorization_code']);
    expect($manager->getRefreshToken())->toBe('old_refresh');
});

test('expires in as json string is accepted', function (): void {
    // D1: RFC 6749 §5.1 — providers like Salesforce send expires_in as a
    // quoted string. The manager must accept it and cache the token; a
    // second call within the buffer window must serve from cache.
    $client = new MockTokenApiClient();
    $client->enqueueResponse(new ApiHttpResponse(
        200,
        (string) json_encode(['access_token' => 'str-tok', 'expires_in' => '3600']),
        ['Content-Type' => 'application/json']
    ));

    $manager = new OAuth2TokenManager();
    $manager->setApiClient($client);

    $first = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);
    $second = $manager->getAccessToken('https://auth.example.com/token', ['grant_type' => 'client_credentials']);

    expect($first)->toBe('str-tok');
    expect($second)->toBe('str-tok');
    expect($client->capturedRequests)->toHaveCount(1);
});

test('expires in as float is floored', function (): void {
    // D1: some providers send expires_in as a JSON float (e.g. 3600.5).
