namespace {{invokerPackage}};

/**
 * Converts scalar values, arrays, and objects into string representations
 * suitable for different HTTP parameter locations (path, query, header).
 * Handles collection format serialization (csv, ssv, tsv, pipes, multi)
 * and URL-encoding for path parameters.
 */
final class ValueSerializer
{
    /**
     * Serialize a value for use in an HTTP request parameter.
     *
     * Converts the given value to a string (or array of strings for multi-valued
     * query parameters) appropriate for the specified HTTP parameter location.
     * Path values are URL-encoded. Query values support collection formats.
     * Header values are comma-joined for arrays.
     *
     * @param mixed       $value            the value to serialize
     * @param string      $location         the HTTP parameter location ('path', 'query', or 'header')
     * @param string      $schemaType       the OpenAPI schema type (e.g. 'string', 'integer', 'array')
     * @param string|null $collectionFormat the collection format for
     *                                       array values ('csv', 'ssv', 'tsv', 'pipes', 'multi')
     *
     * @return string|array<int, string>|null the serialized value
     */
    public static function serialize(
        mixed $value,
        string $location,
        string $schemaType,
        ?string $collectionFormat = null,
    ): string|array|null
    {
        if ($value === null) {
            if ($location === 'query') {
                return null;
            }

            return '';
        }

        {{! Per W3/N3: in path params, format: date emits YYYY-MM-DD (no time). }}
        {{! The codegen appends '|date' to the schemaType for date-only path params. }}
        if ($location === 'path' && str_ends_with($schemaType, '|date') && $value instanceof \DateTimeInterface) {
            return rawurlencode($value->format('Y-m-d'));
        }

        if (is_array($value)) {
            if ($location === 'query') {
                $items = array_map([ObjectSerializer::class, 'stringify'], $value);

                return match ($collectionFormat) {
                    'multi' => $items,
                    'ssv' => implode(' ', $items),
                    'tsv' => implode("\t", $items),
                    'pipes' => implode('|', $items),
                    default => implode(',', $items), // csv or default
                };
            }

            if ($location === 'header') {
                return implode(',', array_map([ObjectSerializer::class, 'stringify'], $value));
            }
        }

        $str = ObjectSerializer::stringify($value);

        if ($location === 'path') {
            return rawurlencode($str);
        }

        return $str;
    }

    /**
     * Serialize a value using the specified OAS 3.0 parameter style.
     *
     * Supports simple, form, matrix, label, spaceDelimited, and pipeDelimited
     * styles. Falls back to the existing serialize() method when style is null.
     *
     * @param string      $paramName  the parameter name
     * @param mixed       $value      the value to serialize
     * @param string      $location   the HTTP parameter location ('path', 'query', 'header', 'cookie')
     * @param string      $schemaType the OpenAPI schema type (e.g. 'string', 'integer', 'array')
     * @param string|null $collectionFormat the collection format (legacy, used when style is null)
     * @param string|null $style      the OAS 3.0 parameter style
     * @param bool        $explode    whether to explode array values
     *
     * @return string|array<int, string>|null the serialized value
     */
    public static function serializeStyled(
        string $paramName,
        mixed $value,
        string $location,
        string $schemaType,
        ?string $collectionFormat,
        ?string $style,
        bool $explode
    ): string|array|null {
        if ($style === null || $style === '') {
            return self::serialize($value, $location, $schemaType, $collectionFormat);
        }

        if ($value === null) {
            if ($location === 'query') {
                return null;
            }
            return '';
        }

        {{! Per W3/N3: format: date in path becomes YYYY-MM-DD (no time component). }}
        $isDateOnly = str_ends_with($schemaType, '|date');
        $stringifier = $isDateOnly
            ? static fn (mixed $v): string => $v instanceof \DateTimeInterface
                ? $v->format('Y-m-d')
                : ObjectSerializer::stringify($v)
            : [ObjectSerializer::class, 'stringify'];

        $items = is_array($value)
            ? array_map($stringifier, $value)
            : [$stringifier($value)];

        return match ($style) {
            'matrix' => self::serializeMatrix($paramName, $items, $explode),
            'label' => self::serializeLabel($items, $explode),
            'form' => self::serializeForm($items, $explode),
            'spaceDelimited' => implode(' ', $items),
            'pipeDelimited' => implode('|', $items),
            'simple' => implode(',', $items),
            default => self::serialize($value, $location, $schemaType, $collectionFormat),
        };
    }

    /**
     * @param string[] $items
     */
    private static function serializeMatrix(string $paramName, array $items, bool $explode): string
    {
        if ($explode) {
            return implode('', array_map(
                static fn (string $v): string => ';' . $paramName . '=' . $v,
                $items,
            ));
        }

        return ';' . $paramName . '=' . implode(',', $items);
    }

    /**
     * @param string[] $items
     */
    private static function serializeLabel(array $items, bool $explode): string
    {
        if ($explode) {
            return '.' . implode('.', $items);
        }

        return '.' . implode(',', $items);
    }

    /**
     * @param string[] $items
     * @return string|array<int, string>
     */
    private static function serializeForm(array $items, bool $explode): string|array
    {
        if ($explode) {
            return $items;
        }

        return implode(',', $items);
    }

    /**
     * Serialize a deepObject-style query parameter.
     *
     * Produces an associative array of flattened keys in the form
     * `paramName[key]` to stringified values, suitable for inclusion
     * in a query string.
     *
     * @param string              $paramName the parameter name (e.g. 'filter')
     * @param array<string,mixed>|null $value the associative array to serialize
     *
     * @return array<string,string> expanded keys to serialized values
     */
    public static function serializeDeepObject(string $paramName, ?array $value): array
    {
        $result = [];
        if ($value === null) {
            return $result;
        }

        foreach ($value as $key => $val) {
            $result[$paramName . '[' . $key . ']'] = ObjectSerializer::stringify($val);
        }

        return $result;
    }
}
