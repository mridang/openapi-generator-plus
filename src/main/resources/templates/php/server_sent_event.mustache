{{>api_info}}
namespace {{invokerPackage}};

/**
 * One server-sent event: the standard envelope of the `text/event-stream` format.
 *
 * @template T
 * @category Class
 * @package  {{invokerPackage}}
 */
final class ServerSentEvent
{
    /**
     * @param string|null $id    the last event id, or null while none was set
     * @param string      $event the event name, `message` when the server named none
     * @param T|null      $data  the data, decoded as the schema of the operation (a string for a text stream)
     * @param int|null    $retry the reconnection time in milliseconds the server asked for, or null
     * @param string      $raw   the data text as it arrived, data lines joined with a line feed
     */
    public function __construct(
        public readonly ?string $id,
        public readonly string $event,
        public readonly mixed $data,
        public readonly ?int $retry,
        public readonly string $raw,
    ) {
    }

    /** Shows the event name and id only, never the data. */
    public function __toString(): string
    {
        return 'ServerSentEvent{event=' . $this->event . ', id=' . ($this->id ?? 'null') . '}';
    }
}
