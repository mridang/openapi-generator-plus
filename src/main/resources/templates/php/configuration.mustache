namespace {{invokerPackage}};

/**
 * API-level configuration for generated client classes.
 *
 * Holds the base URL and default headers that are applied to every API
 * request. Transport-level settings (TLS, proxy, timeouts) belong in
 * {@see TransportOptions} and are configured on the {@see DefaultApiClient}.
 *
 * This class is immutable and thread-safe. Use {@see Configuration::builder()} to create instances:
 *
 *     $config = Configuration::builder()
 *         ->baseUrl('https://api.example.com')
 *         ->defaultHeader('Authorization', 'Bearer token')
 *         ->build();
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class Configuration
{
    /**
     * @param string               $baseUrl        Base URL for all API requests
     * @param array<string, string> $defaultHeaders Headers to include in every API request
     * @param CallHook|null        $callHook       Hook called once around every operation call, or null for none
     * @param bool                 $validateConstraints Whether every request body is checked against the
     *                                                  validation keywords of its schema before it is sent
     */
    public function __construct(
        public readonly string $baseUrl = '{{{basePath}}}',
        public readonly array $defaultHeaders = [],
        public readonly ?CallHook $callHook = null,
        public readonly bool $validateConstraints = false,
    ) {
    }

    /**
     * The hook called once around every operation call, or null when none is set.
     */
    public function getCallHook(): ?CallHook
    {
        return $this->callHook;
    }

    /**
     * Create a new builder for constructing Configuration instances.
     */
    public static function builder(): ConfigurationBuilder
    {
        return new ConfigurationBuilder();
    }

    /**
     * Return a Configuration with default values.
     *
     * A fresh instance every call: the SDK keeps no process-wide default a
     * caller could swap out from under another caller.
     */
    public static function defaultConfiguration(): Configuration
    {
        return self::builder()->build();
    }

    /**
     * Masks credentials so they never leak through var_dump() / print_r() /
     * debug_zval_dump() / error logs: the proxy password and the value of
     * every default header named Authorization, Proxy-Authorization, Cookie
     * or containing key, token or secret.
     *
     * @return array<string, mixed>
     */
    public function __debugInfo(): array
    {
        $headers = [];
        foreach ($this->defaultHeaders as $name => $value) {
            $sensitive = preg_match('/^(proxy-)?authorization$|^cookie$|key|token|secret/i', $name) === 1;
            $headers[$name] = $sensitive ? '***' : $value;
        }
        return [
            'baseUrl' => $this->baseUrl,
            'defaultHeaders' => $headers,
        ];
    }
}
