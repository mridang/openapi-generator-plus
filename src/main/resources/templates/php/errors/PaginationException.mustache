{{>api_info}}
namespace {{invokerPackage}}\Errors;

/**
 * Raised when a paged list cannot be followed safely: the server returned the cursor that was just
 * sent, so asking again would loop forever, or a `Link` header pointed to another origin, so following
 * it would send the credentials there. It is not a network error and not an API error: it is a direct
 * child of {@see {{errorPrefix}}Exception}, and the items already delivered are complete and correct. A
 * failed page request raises the SDK error of that failure instead.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
class PaginationException extends {{errorPrefix}}Exception
{
    private readonly ?string $requestPath;

    /**
     * @param string      $message     what made the list impossible to follow; it never holds a query string
     * @param string|null $requestPath the path of the request that returned the page, without its query
     */
    public function __construct(string $message, ?string $requestPath = null)
    {
        parent::__construct($message);
        $this->requestPath = $requestPath === null ? null : ApiException::pathWithoutQuery($requestPath);
    }

    /**
     * The path of the request whose response could not be followed, without its query string.
     */
    public function getRequestPath(): ?string
    {
        return $this->requestPath;
    }
}
