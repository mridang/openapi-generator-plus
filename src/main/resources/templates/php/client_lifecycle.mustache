namespace {{invokerPackage}};

/**
 * Whether a client has been closed. The client and every API group of it share one instance,
 * so closing the client makes each later request fail with the same error, whichever transport
 * (the SDK's own or one the caller supplied) carries the request. A request already sent is
 * not interrupted, but a {@see ByteStream} that is still open is cancelled: its connection is
 * aborted and its next read raises the closed-client error.
 */
final class ClientLifecycle
{
    /** The message of the error a closed client raises. */
    public const string CLOSED_MESSAGE = 'client closed';

    private bool $closed = false;

    /** @var array<int, \WeakReference<ByteStream>> the streams opened through this client and not yet finished */
    private array $streams = [];

    /**
     * Marks the client closed and cancels the streams that are still open. Safe to call more than once.
     */
    public function close(): void
    {
        $this->closed = true;
        $open = $this->streams;
        $this->streams = [];
        foreach ($open as $reference) {
            $reference->get()?->cancel();
        }
    }

    /**
     * Remembers an open stream so that closing the client cancels it. The reference is weak, so a
     * stream the caller drops still releases its connection.
     *
     * @throws \LogicException when the client is already closed, after cancelling the stream
     */
    public function track(ByteStream $stream): void
    {
        if ($this->closed) {
            $stream->cancel();
            throw new \LogicException(self::CLOSED_MESSAGE);
        }
        $this->streams[spl_object_id($stream)] = \WeakReference::create($stream);
        $stream->attach($this);
    }

    /** Forgets a stream that has ended or been closed. */
    public function release(ByteStream $stream): void
    {
        unset($this->streams[spl_object_id($stream)]);
    }

    public function isClosed(): bool
    {
        return $this->closed;
    }

    /**
     * @throws \LogicException when the client is closed
     */
    public function assertOpen(): void
    {
        if ($this->closed) {
            throw new \LogicException(self::CLOSED_MESSAGE);
        }
    }
}
