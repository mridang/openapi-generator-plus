namespace {{invokerPackage}};

use {{invokerPackage}}\Errors\ApiException;
use {{invokerPackage}}\Errors\NetworkException;
use {{invokerPackage}}\Errors\NetworkTimeoutException;
use {{invokerPackage}}\Errors\StreamException;

/**
 * Transport-agnostic base for {@see ApiClient} implementations.
 *
 * Owns every piece of HTTP behaviour that must be identical regardless of the
 * underlying transport: transport-level default-header merging, User-Agent and
 * X-Request-ID injection, Accept-Encoding negotiation, the manual redirect loop
 * (with cross-origin sensitive-header stripping, HTTPS->HTTP body-replay
 * refusal, and non-http(s) scheme rejection), response decompression, and
 * charset decoding. Concrete subclasses supply only the single-request wire
 * send via {@see execute()}, so this security-critical logic lives in exactly
 * one place across both the bundled Symfony transport
 * ({@see DefaultApiClient}) and the pluggable PSR-18 transport
 * ({@see Psr18ApiClient}).
 *
 * Header merge order (lowest to highest priority):
 * 1. TransportOptions::defaultHeaders -- transport-level defaults
 * 2. Caller-provided headers (from BaseApi -- includes config defaults, auth, operation headers)
 * 3. TransportOptions::userAgent -- injected if not already set
 * 4. TransportOptions::injectRequestId -- injected if not already set
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
abstract class AbstractApiClient implements ApiClient, StreamingApiClient
{
    /**
     * Gap 3.1: headers stripped from cross-origin redirect hops. Includes
     * the static set {Authorization, Cookie, Proxy-Authorization} plus any
     * `apiKey, in=header` names harvested from the OpenAPI document at
     * codegen time so cross-origin redirects strip caller-provided API-key
     * headers even when the key is not named "Authorization". Compared
     * case-insensitively (entries are already lowercased here).
     *
     * @var list<string>
     */
    protected const array SENSITIVE_HEADER_NAMES = [
        'authorization',
        'cookie',
        'proxy-authorization',
{{#apiKeyHeaderNames}}
        '{{nameLower}}',
{{/apiKeyHeaderNames}}
    ];

    /**
     * The Accept-Encoding a streaming call offers: the encodings that can be decoded while the body
     * is read (the br and zstd codecs have no incremental decoder here).
     */
    private const string STREAMING_ENCODINGS = 'gzip, deflate';

    /** @var TransportOptions Transport configuration applied to every request. */
    protected readonly TransportOptions $transportOptions;

    /** The streams this transport handed out that are still open; close() cancels them. */
    private readonly ClientLifecycle $openStreams;

    /**
     * Gap T-D4: tracks whether close() has been called. Once closed, any
     * further sendRequest() raises an SDK-typed ApiException instead of
     * silently re-using a reset client or leaking a foreign library error,
     * giving every SDK a uniform use-after-close contract.
     */
    protected bool $closed = false;

    /** True while a {@see sendWithRetries()} call that was admitted before close() runs its attempts. */
    private bool $inCall = false;

    /**
     * Monotonic instant (seconds) at which the request timeout of the call in
     * flight is spent, or null when the timeout is disabled or no call is in
     * flight. The timeout is one end-to-end budget for the whole call, every
     * redirect hop included, never a fresh allowance per hop.
     */
    private ?float $deadline = null;

    /**
     * Monotonic instant (seconds) at which the one end-to-end budget of a
     * {@see sendWithRetries()} call is spent, or null outside such a call or
     * when the timeout is disabled. Every attempt is bounded by it, so the
     * retries never extend the request timeout.
     */
    private ?float $retryDeadline = null;

    /**
     * Request timeout in milliseconds that one {@see sendWithRetries()} call
     * asks for, replacing {@see TransportOptions::$timeout} for that call, or
     * null when the call keeps the transport timeout.
     */
    private ?int $callTimeoutMs = null;

    /**
     * @param TransportOptions|null $transportOptions transport configuration applied to every request
     */
    public function __construct(?TransportOptions $transportOptions = null)
    {
        $this->transportOptions = $transportOptions ?? TransportOptions::builder()->build();
        $this->openStreams = new ClientLifecycle();
    }

    /**
     * Seconds left of the request timeout for the call in flight, or null when
     * the timeout is disabled. Transports use it to bound each hop so the hops
     * together never outlast the one budget.
     */
    protected function remainingTimeout(): ?float
    {
        if ($this->deadline === null) {
            return null;
        }
        return max(0.0, $this->deadline - hrtime(true) / 1e9);
    }

    /**
     * Perform a single HTTP exchange with NO automatic redirect following.
     *
     * Implementations build their transport's wire request from the given
     * method, URL, headers, and body -- including multipart/form-data encoding
     * when $body is an array (in which case the implementation owns the
     * `Content-Type: multipart/form-data; boundary=...` header) -- send exactly
     * one request, and return the raw status, undecoded body, and multi-value
     * headers (keys lowercased) as a {@see RawHttpResponse}. The transport MUST
     * NOT follow 3xx redirects itself ({@see sendRequest()} runs the redirect
     * loop) and MUST wrap any transport-level failure in an {@see ApiException}.
     *
     * @param string                $method  HTTP method
     * @param string                $url     fully qualified URL
     * @param array<string, string> $headers request headers
     * @param mixed                 $body    request body (string, multipart array, or null)
     *
     * @return RawHttpResponse the raw, unprocessed response
     *
     * @throws ApiException if the request fails at the transport level
     */
    abstract protected function execute(
        string $method,
        string $url,
        array $headers,
        mixed $body,
    ): RawHttpResponse;

    /**
     * Send an HTTP request and return the response.
     *
     * Merges transport-level default headers, applies User-Agent and
     * X-Request-ID injection, follows redirects (stripping sensitive headers on
     * cross-origin hops and refusing unsafe replays), and decompresses and
     * charset-decodes the response body.
     *
     * @param string                $method     HTTP method
     * @param string                $url        Fully qualified URL
     * @param array<string, string> $headers    HTTP headers
     * @param mixed                 $body       Request body
     * @param bool                  $noRedirect when true, suppress redirect following
     *                                          regardless of {@see TransportOptions::followRedirects}
     *                                          (Gap 3.2 -- used by {@see OAuth2TokenManager}
     *                                          to refuse 307/308 on token POSTs)
     * @param bool                  $noDefaultHeaders when true, omit the transport default headers,
     *                                          which are meant for the API. A token request
     *                                          (identity provider) and OpenID Connect discovery
     *                                          set it so an Authorization or API key default
     *                                          header never reaches another host.
     *
     * @return ApiHttpResponse the HTTP response
     *
     * @throws ApiException if the request fails at the transport level
     */
    public function sendRequest(
        string $method,
        string $url,
        array $headers,
        mixed $body,
        bool $noRedirect = false,
        bool $noDefaultHeaders = false,
    ): ApiHttpResponse {
        $mergedHeaders = $this->prepareRequest(
            $method,
            $url,
            $headers,
            $body,
            $noDefaultHeaders,
            $this->getSupportedEncodings()
        );
        $timeoutMs = $this->armDeadline();

        try {
            $response = $this->sendAndFollow(
                $method,
                $url,
                $mergedHeaders,
                $body,
                $noRedirect,
                $timeoutMs,
                fn (string $m, string $u, array $h, mixed $b): RawHttpResponse => $this->execute($m, $u, $h, $b)
            );
            $responseBody = $response->body;
            /* Gap BE+BF: response header keys are normalised to lowercase so
               callers can look them up consistently regardless of the casing
               the server used (HTTP header names are case-insensitive per
               RFC 7230 section 3.2, and HTTP/2 mandates lowercase on the
               wire). Repeated header lines (for example multiple Link or
               Set-Cookie headers) are joined with ', ' to preserve order
               per RFC 7230 section 3.2.2. Each transport's execute() already
               lowercases keys and exposes multi-value lists; we join them
               for the public surface. The joined form is not directly
               parseable for Set-Cookie; callers needing structured cookie
               access should use a transport that exposes the raw response. */
            $responseHeaders = self::joinedHeaders($response->headers);
            $contentEncoding = $response->headers['content-encoding'][0] ?? '';
            try {
                $responseBody = $this->decompressBody($responseBody, $contentEncoding);
            } catch (\RuntimeException $e) {
                /* A corrupt or truncated compressed body is not a transport
                 * failure: a response did arrive, so it is an ApiException
                 * carrying the real status, never a NetworkException. */
                throw new ApiException(
                    $response->statusCode,
                    "Failed to decompress $contentEncoding response body: {$e->getMessage()}",
                    $responseHeaders,
                    null,
                    null,
                    $e
                );
            }
            if ($contentEncoding !== '' && strtolower(trim($contentEncoding)) !== 'identity') {
                /* D92: the headers describe the body the caller receives, and
                 * that body is no longer encoded or the wire length. */
                unset($responseHeaders['content-encoding'], $responseHeaders['content-length']);
            }
            $contentType = $response->headers['content-type'][0] ?? '';
            if (!$this->isTextContentType($contentType)) {
                $responseBody = base64_encode($responseBody);
            } else {
                $responseBody = $this->decodeTextBody($responseBody, $contentType);
            }

            return new ApiHttpResponse(
                statusCode: $response->statusCode,
                body: $responseBody,
                headers: $responseHeaders
            );
        } catch (ApiException $e) {
            /* SDK-typed errors raised inside the redirect loop (unsupported
             * scheme, refused downgrade, too many redirects), by the body
             * decoding above, and by the transport's execute() already carry
             * the right type — surface them unchanged rather than re-wrapping. */
            throw $e;
        } finally {
            $this->deadline = null;
        }
    }

    /**
     * Validates one request and builds the headers it is sent with: the closed-client and URL checks,
     * the transport default headers, User-Agent and X-Request-ID injection, Accept-Encoding and the
     * explicit empty body. The header rules every call shares, buffered or streamed.
     *
     * @param array<string, string> $headers          HTTP headers of the caller
     * @param string                $encodings        the Accept-Encoding value to offer when the caller set none
     *
     * @return array<string, string> the headers to send
     */
    private function prepareRequest(
        string $method,
        string $url,
        array $headers,
        mixed $body,
        bool $noDefaultHeaders,
        string $encodings,
    ): array {
        /* Gap T-D4: refuse to send on a closed client. Using a client after
         * close() is a wrong call order, so it raises \LogicException rather
         * than silently re-using a reset transport. */
        if ($this->closed && !$this->inCall) {
            throw new \LogicException(ClientLifecycle::CLOSED_MESSAGE);
        }

        /* A malformed request URL is a caller mistake, not a network failure:
         * refuse it before any header is merged or the transport is touched. */
        if (!self::isUsableWebUrl($url)) {
            throw new \InvalidArgumentException('Malformed request URL: ' . self::loggableUrl($url));
        }

        /* An SDK token request (RFC 6749 section 3.2) or OpenID Connect
         * discovery goes to the identity provider, a different origin, so the
         * caller's default headers (an Authorization or API key meant for the
         * API) must not ride along. */
        $mergedHeaders = $noDefaultHeaders
            ? $headers
            : self::mergeHeaders($this->transportOptions->defaultHeaders, $headers);
        /* A CR, LF or NUL in a header value would end the header line early and let
         * the rest be read as a forged header, so it is refused before the transport
         * is touched. The value is never echoed: only the header name is named. */
        foreach ($mergedHeaders as $headerName => $headerValue) {
            if (preg_match("/[\r\n\0]/", $headerValue) === 1) {
                throw new \InvalidArgumentException(
                    "Header '$headerName' must not contain CR, LF, or NUL characters"
                );
            }
        }
        /* Field names are case-insensitive (RFC 9110 section 5.1): a caller's
         * user-agent or x-request-id in any casing wins and is left as written. */
        $presentHeaders = array_change_key_case($mergedHeaders, CASE_LOWER);

        if (
            $this->transportOptions->userAgent !== null
            && !isset($presentHeaders['user-agent'])
        ) {
            $mergedHeaders['User-Agent'] = $this->transportOptions->userAgent;
        }

        if (
            $this->transportOptions->injectRequestId
            && !isset($presentHeaders['x-request-id'])
        ) {
            $mergedHeaders['X-Request-ID'] = $this->generateUuid();
        }

        /* A caller's accept-encoding in any casing wins (RFC 9110 section 5.1);
         * a second differently-cased line would be sent next to it. */
        if (!isset($presentHeaders['accept-encoding'])) {
            $mergedHeaders['Accept-Encoding'] = $encodings;
        }

        if ($body instanceof BodySource) {
            /* A known length goes out as Content-Length and an unknown one is sent chunked, so
             * a Content-Length the caller set is replaced and a stale one never rides along. */
            foreach (array_keys($mergedHeaders) as $headerName) {
                if (in_array(strtolower((string) $headerName), ['content-length', 'transfer-encoding'], true)) {
                    unset($mergedHeaders[$headerName]);
                }
            }
            $bodyLength = $body->length();
            if ($bodyLength !== null) {
                $mergedHeaders['Content-Length'] = (string) $bodyLength;
            }
        }

        if ($body === null) {
            foreach (array_keys($mergedHeaders) as $headerName) {
                if (strtolower((string) $headerName) === 'content-type') {
                    unset($mergedHeaders[$headerName]);
                }
            }
            /* Some servers / WAFs treat POST/PUT/PATCH with no body
             * and no Content-Length as malformed (411 Length
             * Required) or behave inconsistently. Emit an explicit
             * `Content-Length: 0` on body-bearing verbs to match
             * Kotlin's `ByteArray(0)` and the other 11 SDKs. */
            $upperMethod = strtoupper($method);
            if ($upperMethod === 'POST' || $upperMethod === 'PUT' || $upperMethod === 'PATCH') {
                $mergedHeaders['Content-Length'] = '0';
            }
        }

        return $mergedHeaders;
    }

    /**
     * Starts the one end-to-end budget of the call in flight, the retries' own budget included.
     *
     * @return int|null the timeout in milliseconds, or null when it is disabled
     */
    private function armDeadline(): ?int
    {
        $timeoutMs = $this->callTimeoutMs ?? $this->transportOptions->timeout;
        $this->deadline = $timeoutMs === null
            ? null
            : hrtime(true) / 1e9 + $timeoutMs / 1000.0;
        if ($this->retryDeadline !== null) {
            $this->deadline = $this->deadline === null
                ? $this->retryDeadline
                : min($this->deadline, $this->retryDeadline);
        }

        return $timeoutMs;
    }

    /**
     * Sends the request and follows its redirects with the security rules shared by every transport:
     * cross-origin credential stripping, the HTTPS to HTTP body-replay refusal, non-http(s) scheme
     * rejection and the redirect budget. A streamed response that is followed or refused is closed.
     *
     * @template R of RawHttpResponse|RawStreamResponse
     *
     * @param array<string, string> $mergedHeaders the headers prepared for the first hop
     * @param \Closure(string, string, array<string, string>, mixed): R $execute performs one exchange
     *
     * @return R the response that is not a redirect to follow
     *
     * @throws ApiException when a redirect is refused or the redirect budget is spent
     */
    private function sendAndFollow(
        string $method,
        string $url,
        array $mergedHeaders,
        mixed $body,
        bool $noRedirect,
        ?int $timeoutMs,
        \Closure $execute,
    ): RawHttpResponse|RawStreamResponse {
        $response = null;
        try {
            /* A deadline that has already passed raises the timeout before the
             * transport is touched. */
            if ($timeoutMs !== null && $this->remainingTimeout() === 0.0) {
                throw new NetworkTimeoutException(
                    "API Request timed out: the $timeoutMs ms timeout was spent before the request was sent"
                );
            }
            $response = $execute($method, $url, $mergedHeaders, $body);

            /* Gap BH: manual redirect loop with cross-origin sensitive-
             * header strip. Transports never follow redirects themselves
             * (execute() sends exactly one request), so we follow
             * Location: headers ourselves here, removing Authorization /
             * Cookie / Proxy-Authorization whenever the next URL's origin
             * differs from the original. */
            if ($this->transportOptions->followRedirects && !$noRedirect) {
                $maxRedirects = $this->transportOptions->maxRedirects ?? 20;
                $originalUrl = $url;
                $hops = 0;
                $currentMethod = $method;
                $currentBody = $body;
                $currentHeaders = $mergedHeaders;
                while ($hops < $maxRedirects && self::isRedirectStatus($response->statusCode)) {
                    $location = ($response->headers['location'] ?? [null])[0];
                    if ($location === null) {
                        break;
                    }
                    $nextUrl = self::resolveUrl($url, $location);
                    if ($nextUrl === null) {
                        break;
                    }
                    $scheme = parse_url($nextUrl, PHP_URL_SCHEME);
                    if (!in_array(strtolower((string) $scheme), ['http', 'https'], true)) {
                        /* Gap T-D3: a Location pointing at a non-http(s)
                         * scheme (file:, javascript:, data:, ...) is an
                         * attack vector. Refuse loudly instead of silently
                         * returning the 3xx, matching the throwing SDKs. */
                        throw new ApiException(
                            $response->statusCode,
                            'Refusing to follow redirect to non-HTTP(S) URL: ' . self::withoutQuery($nextUrl),
                            self::joinedHeaders($response->headers)
                        );
                    }
                    $crossOrigin = !self::sameOrigin($originalUrl, $nextUrl);

                    /* Gap T3: pick follow-up method+body per RFC 9110 15.4.
                     *   307 + 308: preserve original method and body.
                     *   303:       every method except HEAD becomes GET, body dropped.
                     *   301 + 302: only POST becomes GET (body dropped); every
                     *              other method keeps its method and body. */
                    $statusCode = $response->statusCode;
                    $methodUpper = strtoupper($currentMethod);

                    if ($statusCode === 307 || $statusCode === 308) {
                        $nextMethod = $currentMethod;
                        $dropBody = false;
                    } elseif ($statusCode === 303) {
                        $toGet = $methodUpper !== 'HEAD';
                        $nextMethod = $toGet ? 'GET' : $currentMethod;
                        $dropBody = $toGet;
                    } elseif ($methodUpper === 'POST') {
                        $nextMethod = 'GET';
                        $dropBody = true;
                    } else {
                        $nextMethod = $currentMethod;
                        $dropBody = false;
                    }

                    /* Gap 3.3: refuse to replay a request body across an
                     * HTTPS -> HTTP downgrade. A malicious 307/308 from an
                     * upstream proxy can otherwise leak request bodies
                     * (containing credentials, PII, etc.) onto the wire in
                     * plaintext. The connection is closed and the original
                     * 3xx response surfaces to the caller. */
                    $prevScheme = strtolower((string) parse_url($url, PHP_URL_SCHEME));
                    $nextScheme = strtolower((string) $scheme);
                    if ($currentBody instanceof BodySource && !$currentBody->isReplayable() && !$dropBody) {
                        /* The one stream was read to its end by the first request, so there is
                         * nothing to send again, and it is never buffered to make that possible. */
                        throw new ApiException(
                            $statusCode,
                            'Refusing to replay a streamed request body',
                            self::joinedHeaders($response->headers)
                        );
                    }
                    $isDowngrade = $prevScheme === 'https' && $nextScheme === 'http';
                    $hasBody = $currentBody !== null;
                    /* misc124: a 301 or 302 downgrade is refused with a body too,
                     * even though the follow-up would drop it. 303 is still followed. */
                    if ($isDowngrade && $hasBody && (!$dropBody || $statusCode === 301 || $statusCode === 302)) {
                        /* Gap 3.3 / T-D2: raise instead of silently returning
                         * the 3xx so the caller sees the refused downgrade,
                         * matching the SDKs that throw on a refused replay. */
                        throw new ApiException(
                            $statusCode,
                            'Refusing to replay request body across HTTPS->HTTP redirect: '
                            . self::withoutQuery($url) . ' -> ' . self::withoutQuery($nextUrl),
                            self::joinedHeaders($response->headers)
                        );
                    }

                    $redirectHeaders = $currentHeaders;
                    if ($crossOrigin) {
                        /* Besides the fixed list, a header is a credential when
                         * its name says so (key, token, secret, auth,
                         * credential: the rule that redacts string forms) or
                         * when the caller set it as a transport default, since
                         * defaults and custom authenticators are where an
                         * arbitrary secret header comes from. */
                        $defaultHeaderNames = array_change_key_case($this->transportOptions->defaultHeaders, CASE_LOWER);
                        foreach (array_keys($redirectHeaders) as $hname) {
                            $lower = strtolower((string) $hname);
                            if (
                                in_array($lower, static::SENSITIVE_HEADER_NAMES, true)
                                || preg_match('/key|token|secret|auth|credential/', $lower) === 1
                                || (
                                    $lower !== 'user-agent'
                                    && array_key_exists($lower, $defaultHeaderNames)
                                )
                            ) {
                                unset($redirectHeaders[$hname]);
                            }
                        }
                    }
                    if ($dropBody) {
                        foreach (array_keys($redirectHeaders) as $hname) {
                            $lower = strtolower((string) $hname);
                            if ($lower === 'content-type' || $lower === 'content-length') {
                                unset($redirectHeaders[$hname]);
                            }
                        }
                    }

                    $redirectBody = $dropBody ? null : $currentBody;
                    $url = $nextUrl;
                    $currentMethod = $nextMethod;
                    $currentBody = $redirectBody;
                    $currentHeaders = $redirectHeaders;
                    if ($this->remainingTimeout() === 0.0) {
                        throw new NetworkTimeoutException(
                            "API Request timed out: the $timeoutMs ms timeout "
                            . "was spent before following the redirect to $nextUrl"
                        );
                    }
                    $response = $execute($nextMethod, $nextUrl, $redirectHeaders, $redirectBody);
                    $hops++;
                }

                /* Gap T-D1: if we ran out of redirect budget while the
                 * response is still a redirect, raise "too many redirects"
                 * instead of silently returning the last 3xx as a normal
                 * response — matching the throwing SDKs. */
                if (
                    $hops >= $maxRedirects
                    && self::isRedirectStatus($response->statusCode)
                    && isset($response->headers['location'][0])
                    && self::resolveUrl($url, $response->headers['location'][0]) !== null
                ) {
                    throw new ApiException(
                        $response->statusCode,
                        "Too many redirects (exceeded $maxRedirects)",
                        self::joinedHeaders($response->headers)
                    );
                }
            }

            return $response;
        } catch (\Throwable $failure) {
            if ($response instanceof RawStreamResponse) {
                $response->close();
            }
            throw $failure;
        }
    }

    /**
     * Send a request and retry it after a transient failure.
     *
     * The request is retried up to {@see TransportOptions::$maxRetries} times
     * after a network error that happened before a response, and after a 408,
     * 409, 429 or 5xx (except 501) response. The wait grows from 0.5 s,
     * doubling up to 8 s, with up to 25% jitter, and a `Retry-After` header
     * (seconds or an HTTP date, capped at 60 s) replaces it. The whole call,
     * waits included, stays inside the one request timeout: when the next wait
     * would outlast what is left, the last failure is returned or thrown. A body
     * that is neither null, a string nor a replayable {@see BodySource} (a stream or multipart parts)
     * is not replayable and is sent once. Every attempt calls $headers again, so a
     * retry carries freshly built headers, authentication included.
     *
     * @param string                          $method  HTTP method
     * @param string                          $url     fully qualified URL
     * @param callable(): array<string, string> $headers builds the request headers for one attempt
     * @param mixed                           $body    request body (string, multipart array, stream, or null)
     * @param int|null                        $timeoutMs  request timeout in milliseconds for this call, replacing
     *                                                    {@see TransportOptions::$timeout}; null keeps it
     * @param int|null                        $maxRetries retries for this call, replacing
     *                                                    {@see TransportOptions::$maxRetries}; null keeps it
     *
     * @return ApiHttpResponse the response of the last attempt
     *
     * @throws ApiException if the last attempt fails at the transport level
     */
    public function sendWithRetries(
        string $method,
        string $url,
        callable $headers,
        mixed $body,
        ?int $timeoutMs = null,
        ?int $maxRetries = null,
    ): ApiHttpResponse {
        $this->callTimeoutMs = $timeoutMs;
        try {
            $response = $this->sendAndRetry(
                $method,
                $url,
                $headers,
                $body,
                $timeoutMs ?? $this->transportOptions->timeout,
                $maxRetries ?? $this->transportOptions->maxRetries,
                fn (array $attemptHeaders): ApiHttpResponse => $this->sendRequest($method, $url, $attemptHeaders, $body)
            );
            assert($response instanceof ApiHttpResponse);

            return $response;
        } finally {
            $this->callTimeoutMs = null;
        }
    }

    /**
     * Send a request and return as soon as the response headers are accepted,
     * with the body not read yet. The retries are those of
     * {@see sendWithRetries()}, the redirects, header rules and credential
     * stripping those of {@see sendRequest()}, all of them up to the headers.
     *
     * @param string                $method        HTTP method
     * @param string                $url           fully qualified URL
     * @param array<string, string> $headers       HTTP headers
     * @param mixed                 $body          request body (string, multipart array, stream, or null)
     * @param int|null              $timeoutMs     timeout in milliseconds up to the headers, or null for the
     *                                             transport's
     * @param int|null              $maxRetries    retries for this call, or null for the transport's
     * @param int|null              $idleTimeoutMs the longest silence in the body in milliseconds, 0 to disable,
     *                                             or null for the transport's
     *
     * @throws ApiException if the request fails before the headers arrive
     */
    public function sendStreaming(
        string $method,
        string $url,
        array $headers,
        mixed $body,
        ?int $timeoutMs = null,
        ?int $maxRetries = null,
        ?int $idleTimeoutMs = null,
    ): ByteStream {
        return $this->sendStreamingWithRetries(
            $method,
            $url,
            static fn (): array => $headers,
            $body,
            $timeoutMs,
            $maxRetries,
            $idleTimeoutMs
        );
    }

    /**
     * {@see sendStreaming()} for a caller that builds the headers of every attempt afresh (a retry
     * carries the authenticator's current headers), as {@see sendWithRetries()} does.
     *
     * @param callable(): array<string, string> $headers builds the request headers for one attempt
     *
     * @throws ApiException if the request fails before the headers arrive
     */
    public function sendStreamingWithRetries(
        string $method,
        string $url,
        callable $headers,
        mixed $body,
        ?int $timeoutMs = null,
        ?int $maxRetries = null,
        ?int $idleTimeoutMs = null,
    ): ByteStream {
        $idle = $idleTimeoutMs ?? $this->transportOptions->idleTimeout;
        $this->callTimeoutMs = $timeoutMs;
        try {
            $response = $this->sendAndRetry(
                $method,
                $url,
                $headers,
                $body,
                $timeoutMs ?? $this->transportOptions->timeout,
                $maxRetries ?? $this->transportOptions->maxRetries,
                fn (array $attemptHeaders): ByteStream => $this->openStream(
                    $method,
                    $url,
                    $attemptHeaders,
                    $body,
                    $idle === null || $idle === 0 ? null : $idle / 1000.0
                )
            );
            assert($response instanceof ByteStream);

            return $response;
        } finally {
            $this->callTimeoutMs = null;
        }
    }

    /**
     * One streaming attempt: the header phase of {@see sendRequest()} with a transport that leaves
     * the body unread, then the body wrapped as a {@see ByteStream}.
     *
     * @param array<string, string> $headers     the headers of this attempt
     * @param float|null            $idleSeconds the longest silence in the body, or null when disabled
     */
    private function openStream(string $method, string $url, array $headers, mixed $body, ?float $idleSeconds): ByteStream
    {
        $mergedHeaders = $this->prepareRequest($method, $url, $headers, $body, false, self::STREAMING_ENCODINGS);
        $timeoutMs = $this->armDeadline();
        try {
            $raw = $this->sendAndFollow(
                $method,
                $url,
                $mergedHeaders,
                $body,
                false,
                $timeoutMs,
                fn (string $m, string $u, array $h, mixed $b): RawStreamResponse => $this->executeStreaming(
                    $m,
                    $u,
                    $h,
                    $b,
                    $idleSeconds
                )
            );
        } finally {
            /* The timeout stops at the headers: the body is bounded by the idle timeout alone. */
            $this->deadline = null;
        }

        return $this->wrapStream($method, $url, $raw);
    }

    /**
     * Wraps the raw body of a streaming response: the headers are lower-cased, a gzip or deflate
     * encoded body is decoded as it is read, a body that ends before its declared Content-Length
     * raises a StreamException, and the stream is tracked so that closing this transport cancels it.
     *
     * @throws ApiException when the response uses a Content-Encoding this client cannot decode
     */
    private function wrapStream(string $method, string $url, RawStreamResponse $raw): ByteStream
    {
        $headers = self::joinedHeaders($raw->headers);
        $encoding = strtolower(trim($raw->headers['content-encoding'][0] ?? ''));
        $identity = $encoding === '' || $encoding === 'identity';
        $status = $raw->statusCode;
        $hasBody = strtoupper($method) !== 'HEAD' && $status !== 204 && $status !== 304 && $status >= 200;
        $declared = null;
        if ($hasBody && $identity) {
            $length = trim($raw->headers['content-length'][0] ?? '');
            if ($length !== '' && ctype_digit($length) && strlen($length) < 18) {
                $declared = (int) $length;
            }
        }
        $inflater = null;
        if (!$identity) {
            $inflater = match ($encoding) {
                'gzip', 'x-gzip' => inflate_init(ZLIB_ENCODING_GZIP),
                'deflate' => inflate_init(ZLIB_ENCODING_DEFLATE),
                default => false,
            };
            if ($inflater === false) {
                $raw->close();
                throw new ApiException(
                    $status,
                    "Failed to decompress $encoding response body: Unsupported Content-Encoding '$encoding'",
                    $headers
                );
            }
            /* D92: the headers describe the body the caller receives, so the wire
             * encoding and length of an encoded body go. */
            unset($headers['content-encoding'], $headers['content-length']);
        }
        $path = self::withoutQuery($url);
        $wire = 0;
        $pull = function () use ($raw, &$wire, $declared, $inflater, $encoding, $status, $headers, $method, $path): ?string {
            $chunk = ($raw->pull)();
            if ($chunk === null) {
                if ($declared !== null && $wire < $declared) {
                    throw new StreamException(
                        "The response body ended after $wire of $declared bytes",
                        null,
                        $method,
                        $path
                    );
                }
                if ($inflater !== null && $wire > 0 && inflate_get_status($inflater) !== ZLIB_STREAM_END) {
                    throw new StreamException('The compressed response body ended early', null, $method, $path);
                }

                return null;
            }
            $wire += strlen($chunk);
            if ($inflater === null) {
                return $chunk;
            }
            $decoded = @inflate_add($inflater, $chunk, ZLIB_SYNC_FLUSH);
            if ($decoded === false) {
                /* A response did arrive, so a corrupt body is an ApiException carrying the real
                 * status, never a network error, as for a buffered call. */
                throw new ApiException(
                    $status,
                    "Failed to decompress $encoding response body: the $encoding stream is corrupt",
                    $headers,
                    null,
                    null,
                    new \RuntimeException("the $encoding stream is corrupt"),
                    $method,
                    $path
                );
            }

            return $decoded;
        };
        $stream = new ByteStream($status, $headers, $pull, static function () use ($raw): void {
            $raw->close();
        });
        try {
            $this->openStreams->track($stream);
        } catch (\LogicException $closed) {
            $raw->close();
            throw $closed;
        }

        return $stream;
    }

    /**
     * Perform the header phase of a single streaming HTTP exchange with NO automatic redirect
     * following: send the request, wait for the status and the headers, and return them with the
     * body left unread. A transport that can stream overrides this; the default says it cannot.
     *
     * @param array<string, string> $headers     request headers
     * @param mixed                 $body        request body (string, multipart array, or null)
     * @param float|null            $idleSeconds the longest silence in the body, or null when disabled
     *
     * @throws \BadMethodCallException when this transport cannot stream
     * @throws ApiException             if the request fails at the transport level
     */
    protected function executeStreaming(
        string $method,
        string $url,
        array $headers,
        mixed $body,
        ?float $idleSeconds,
    ): RawStreamResponse {
        throw new \BadMethodCallException(
            static::class . ' cannot stream: it does not implement executeStreaming, so an operation'
            . ' that returns a stream cannot be called through it'
        );
    }

    /**
     * Cancels every stream this transport handed out that is still open. Called by close().
     */
    protected function cancelOpenStreams(): void
    {
        $this->openStreams->close();
    }

    /**
     * Runs the attempts of one admitted call, the buffered and the streaming one alike.
     *
     * @param callable(): array<string, string>                      $headers builds the request headers for one attempt
     * @param \Closure(array<string, string>): (ApiHttpResponse|ByteStream) $send    performs one attempt
     */
    private function sendAndRetry(
        string $method,
        string $url,
        callable $headers,
        mixed $body,
        ?int $timeout,
        int $retries,
        \Closure $send,
    ): ApiHttpResponse|ByteStream {
        if ($this->closed) {
            throw new \LogicException(ClientLifecycle::CLOSED_MESSAGE);
        }
        /* A call admitted before close() finishes, including its retries. */
        $this->inCall = true;
        try {
            return $this->attemptLoop($method, $headers, $body, $timeout, $retries, $send);
        } finally {
            $this->inCall = false;
        }
    }

    /**
     * Runs the attempts of one admitted call.
     *
     * @param callable(): array<string, string>                      $headers builds the request headers for one attempt
     * @param \Closure(array<string, string>): (ApiHttpResponse|ByteStream) $send    performs one attempt
     */
    private function attemptLoop(
        string $method,
        callable $headers,
        mixed $body,
        ?int $timeout,
        int $retries,
        \Closure $send,
    ): ApiHttpResponse|ByteStream {
        /* A body that is a stream or multipart parts cannot be sent again; a body source can unless it is single use. */
        $maxRetries = ($body === null || is_string($body) || ($body instanceof BodySource && $body->isReplayable()))
            ? $retries
            : 0;
        $budgetEnd = $timeout === null ? null : hrtime(true) / 1e9 + $timeout / 1000.0;
        $attempt = 0;
        while (true) {
            $this->retryDeadline = $budgetEnd;
            try {
                $response = $send($headers());
                $failure = null;
            } catch (NetworkTimeoutException $e) {
                /* A timeout is not retried: the call's time budget is already spent,
                 * so the timeout is raised on the first attempt. */
                throw $e;
            } catch (NetworkException $e) {
                /* misc161: a dropped connection is retried only for idempotent
                 * methods, since the request may already have reached the server.
                 * misc170: a TLS or certificate failure is never retried. */
                if (!self::isIdempotentMethod($method) || self::isTlsFailure($e)) {
                    throw $e;
                }
                $response = null;
                $failure = $e;
            } finally {
                $this->retryDeadline = null;
            }
            if ($failure === null && $response !== null && !self::isRetryableStatus($response->statusCode)) {
                return $response;
            }
            if ($attempt >= $maxRetries) {
                break;
            }
            $delay = $response === null
                ? null
                : self::retryAfterSeconds($response->headers['retry-after'] ?? null);
            $delay ??= self::backoffSeconds($attempt, $this->jitter());
            if ($budgetEnd !== null && hrtime(true) / 1e9 + $delay >= $budgetEnd) {
                break;
            }
            /* A retried streaming response is closed unread before the wait. */
            if ($response instanceof ByteStream) {
                $response->close();
            }
            $this->pause($delay);
            $attempt++;
        }
        if ($failure !== null) {
            throw $failure;
        }
        /* The loop only leaves with a response or a failure. */
        assert($response !== null);
        return $response;
    }

    /**
     * Waits between two attempts. A seam so tests can run without sleeping.
     *
     * @param float $seconds how long to wait
     */
    protected function pause(float $seconds): void
    {
        usleep((int) round($seconds * 1_000_000));
    }

    /**
     * A random number in [0, 1) used to jitter the backoff. A seam for tests.
     */
    protected function jitter(): float
    {
        return mt_rand() / (mt_getrandmax() + 1);
    }

    /**
     * Whether a response status is worth another attempt: 408, 409, 429 and
     * every 5xx except 501 (which will not change).
     */
    private static function isRetryableStatus(int $status): bool
    {
        return $status === 408 || $status === 409 || $status === 429
            || ($status >= 500 && $status <= 599 && $status !== 501);
    }

    /**
     * Whether a method may be sent again after a dropped connection: the
     * RFC 9110 idempotent methods plus QUERY. POST and PATCH are not.
     */
    private static function isIdempotentMethod(string $method): bool
    {
        return in_array(strtoupper($method), ['GET', 'HEAD', 'OPTIONS', 'TRACE', 'PUT', 'DELETE', 'QUERY'], true);
    }

    /**
     * Whether a transport failure is a TLS or certificate failure, found by
     * walking the exception and its previous chain. The lookaround keeps a
     * host such as ssl.example.com from matching.
     */
    private static function isTlsFailure(\Throwable $e): bool
    {
        for ($cause = $e; $cause !== null; $cause = $cause->getPrevious()) {
            if (preg_match('/(?<![.\w-])(ssl|tls)(?![.\w-])|certificate/i', $cause->getMessage()) === 1) {
                return true;
            }
        }
        return false;
    }

    /**
     * Backoff before retry number $attempt + 1: 0.5 s doubling up to 8 s, cut
     * by up to 25% of itself according to $jitter in [0, 1).
     */
    private static function backoffSeconds(int $attempt, float $jitter): float
    {
        $base = min(8.0, 0.5 * (2 ** min($attempt, 16)));
        return $base * (1.0 - 0.25 * $jitter);
    }

    /**
     * Seconds a `Retry-After` value asks for (delay-seconds or an HTTP date),
     * capped at 60, or null when it is absent or not understood.
     */
    private static function retryAfterSeconds(?string $value): ?float
    {
        if ($value === null) {
            return null;
        }
        $value = trim($value);
        if ($value === '') {
            return null;
        }
        if (preg_match('/\A\d+(\.\d+)?\z/', $value) === 1) {
            return min(60.0, (float) $value);
        }
        $at = strtotime($value);
        if ($at === false) {
            return null;
        }
        return min(60.0, max(0.0, (float) ($at - time())));
    }

    /**
     * Lower-cases header names and joins repeated values with ', ', the form
     * the public response and the redirect refusals carry.
     *
     * @param array<array-key, array<array-key, string>> $headers transport headers, name to value list
     * @return array<string, string>
     */
    private static function joinedHeaders(array $headers): array
    {
        $joined = [];
        foreach ($headers as $name => $values) {
            $joined[strtolower((string) $name)] = implode(', ', $values);
        }
        return $joined;
    }

    /**
     * Determines whether the given content type represents text content
     * that is safe to decode as a UTF-8 string.
     *
     * @param string $contentType the Content-Type header value
     * @return bool true for text-like content types, false otherwise
     */
    protected function isTextContentType(string $contentType): bool
    {
        $mediaType = strtolower(trim(explode(';', $contentType)[0]));
        if ($mediaType === '') {
            return true;
        }
        if (str_starts_with($mediaType, 'text/')) {
            return true;
        }
        return in_array($mediaType, [
            'application/json',
            'application/xml',
            'application/javascript',
        ], true)
            || str_ends_with($mediaType, '+json')
            || str_ends_with($mediaType, '+xml');
    }

    /**
     * Guess the MIME type for a multipart file part based on its filename
     * extension, falling back to filesystem detection and finally to
     * application/octet-stream.
     *
     * Uses Symfony Mime's {@see \Symfony\Component\Mime\MimeTypes} when
     * available, then a small hardcoded extension map, then PHP's built-in
     * {@see mime_content_type()} on the actual file path.
     *
     * @param string|null $path     optional absolute path to the file on disk
     * @param string|null $filename original filename (used for extension lookup)
     * @return string the detected MIME type
     */
    protected function guessMimeType(?string $path, ?string $filename): string
    {
        $extensionMap = [
            'png' => 'image/png',
            'jpg' => 'image/jpeg',
            'jpeg' => 'image/jpeg',
            'gif' => 'image/gif',
            'webp' => 'image/webp',
            'svg' => 'image/svg+xml',
            'bmp' => 'image/bmp',
            'pdf' => 'application/pdf',
            'json' => 'application/json',
            'xml' => 'application/xml',
            'zip' => 'application/zip',
            'gz' => 'application/gzip',
            'tar' => 'application/x-tar',
            'txt' => 'text/plain',
            'csv' => 'text/csv',
            'html' => 'text/html',
            'htm' => 'text/html',
            'css' => 'text/css',
            'js' => 'application/javascript',
            'mp3' => 'audio/mpeg',
            'mp4' => 'video/mp4',
            'wav' => 'audio/wav',
            'ogg' => 'audio/ogg',
            'webm' => 'video/webm',
        ];

        $extension = null;
        if ($filename !== null && $filename !== '') {
            $extension = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
        }
        if (($extension === null || $extension === '') && $path !== null && $path !== '') {
            $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));
        }

        if (
            class_exists(\Symfony\Component\Mime\MimeTypes::class)
            && $extension !== null
            && $extension !== ''
        ) {
            $guessed = \Symfony\Component\Mime\MimeTypes::getDefault()->getMimeTypes($extension);
            if ($guessed !== []) {
                return $guessed[0];
            }
        }

        if ($extension !== null && isset($extensionMap[$extension])) {
            return $extensionMap[$extension];
        }

        if (
            $path !== null
            && $path !== ''
            && function_exists('mime_content_type')
            && is_file($path)
        ) {
            $detected = @mime_content_type($path);
            if (is_string($detected) && $detected !== '') {
                return $detected;
            }
        }

        return 'application/octet-stream';
    }

    /**
     * Decode a text response body to UTF-8 using the charset declared in the
     * Content-Type header, falling back to UTF-8 when the charset is absent
     * or unknown.
     *
     * Applies to both successful and error response bodies, since both flow
     * through this method via {@see sendRequest()}.
     *
     * @param string $body        the raw response body bytes
     * @param string $contentType the Content-Type header value
     * @return string the body re-encoded as UTF-8
     */
    protected function decodeTextBody(string $body, string $contentType): string
    {
        if ($body === '') {
            return $body;
        }

        $charset = $this->extractCharset($contentType);
        if ($charset === null || strcasecmp($charset, 'utf-8') === 0 || strcasecmp($charset, 'utf8') === 0) {
            return $this->replaceInvalidBytes($body);
        }

        if (!function_exists('mb_convert_encoding')) {
            return $body;
        }

        $encodings = mb_list_encodings();
        $known = in_array(strtolower($charset), array_map(strtolower(...), $encodings), true);
        if (!$known) {
            try {
                $aliases = mb_encoding_aliases($charset);
            } catch (\ValueError) {
                $aliases = [];
            }
            foreach ($aliases as $alias) {
                if (in_array(strtolower($alias), array_map(strtolower(...), $encodings), true)) {
                    $known = true;
                    break;
                }
            }
        }
        if (!$known) {
            return $body;
        }

        $previous = mb_substitute_character();
        mb_substitute_character(0xFFFD);
        try {
            $converted = @mb_convert_encoding($body, 'UTF-8', $charset);
        } finally {
            mb_substitute_character($previous);
        }

        return is_string($converted) ? $converted : $body;
    }

    /**
     * Replaces each byte that is not valid UTF-8 with U+FFFD, so a body with a bad byte decodes
     * instead of failing later.
     *
     * @param string $body the response body bytes, declared or assumed to be UTF-8
     * @return string the body with every invalid byte replaced
     */
    private function replaceInvalidBytes(string $body): string
    {
        if (!function_exists('mb_scrub') || mb_check_encoding($body, 'UTF-8')) {
            return $body;
        }
        $previous = mb_substitute_character();
        mb_substitute_character(0xFFFD);
        try {
            return mb_scrub($body, 'UTF-8');
        } finally {
            mb_substitute_character($previous);
        }
    }

    /**
     * Extract the charset parameter from a Content-Type header value.
     *
     * @param string $contentType the Content-Type header value
     * @return string|null the charset value, or null if none was declared
     */
    protected function extractCharset(string $contentType): ?string
    {
        if ($contentType === '') {
            return null;
        }
        $parts = explode(';', $contentType);
        array_shift($parts);
        foreach ($parts as $part) {
            $kv = explode('=', $part, 2);
            if (count($kv) !== 2) {
                continue;
            }
            if (strcasecmp(trim($kv[0]), 'charset') === 0) {
                return trim($kv[1], " \t\"'");
            }
        }

        return null;
    }

    /**
     * Generate a version 4 UUID.
     *
     * @return string a random UUID string
     */
    protected function generateUuid(): string
    {
        $data = random_bytes(16);
        $data[6] = chr((ord($data[6]) & 0x0f) | 0x40);
        $data[8] = chr((ord($data[8]) & 0x3f) | 0x80);

        return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
    }

    /**
     * Return true for HTTP 3xx redirect status codes that carry a Location header.
     */
    protected static function isRedirectStatus(int $code): bool
    {
        return in_array($code, [301, 302, 303, 307, 308], true);
    }

    /**
     * Drop the query and fragment from a URL before it is quoted in an error
     * message, so a credential passed as a query parameter never reaches a log.
     */
    protected static function withoutQuery(string $url): string
    {
        return substr($url, 0, strcspn($url, '?#'));
    }

    /**
     * An absolute http or https URL with a usable host. Anything else handed to
     * sendRequest() is a caller mistake.
     */
    protected static function isUsableWebUrl(string $url): bool
    {
        $parsed = parse_url($url);

        return $parsed !== false
            && in_array(strtolower($parsed['scheme'] ?? ''), ['http', 'https'], true)
            && self::hasUsableHost($parsed);
    }

    /**
     * parse_url() is lenient: it accepts an unterminated or invalid IP literal
     * such as http://[bad, so a web URL's host is checked here as well.
     *
     * @param array<string, string|int> $parsed
     */
    private static function hasUsableHost(array $parsed): bool
    {
        $host = $parsed['host'] ?? '';
        $literal = str_starts_with((string) $host, '[') || str_ends_with((string) $host, ']');

        return $host !== ''
            && !($literal && filter_var(trim((string) $host, '[]'), FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) === false);
    }

    /**
     * The URL for an error message: no query, and any userinfo replaced by
     * `***@`, so a credential never reaches a log.
     */
    private static function loggableUrl(string $url): string
    {
        return preg_replace('~^([a-z][a-z0-9+.-]*://)[^/?#]*@~i', '$1***@', self::withoutQuery($url)) ?? '';
    }

    /**
     * Resolve a (possibly relative) Location header against the previous URL.
     *
     * @internal Shared with {@see Paginator}; not part of the public API.
     */
    public static function resolveUrl(string $base, string $location): ?string
    {
        $parsed = parse_url($location);
        if ($parsed === false) {
            return null;
        }
        if (isset($parsed['scheme'])) {
            if (in_array(strtolower($parsed['scheme']), ['http', 'https'], true) && !self::hasUsableHost($parsed)) {
                return null;
            }

            return $location;
        }
        $baseParts = parse_url($base);
        if ($baseParts === false || !isset($baseParts['scheme'], $baseParts['host'])) {
            return null;
        }
        /* RFC 3986 section 5.2 reference resolution, so a query-only
         * reference keeps the base path and dot segments are removed. */
        $authority = ($baseParts['user'] ?? '') !== ''
            ? $baseParts['user'] . (isset($baseParts['pass']) ? ':' . $baseParts['pass'] : '') . '@'
            : '';
        $authority .= $baseParts['host'] . (isset($baseParts['port']) ? ':' . $baseParts['port'] : '');
        $basePath = $baseParts['path'] ?? '';
        $baseQuery = $baseParts['query'] ?? null;
        if (isset($parsed['host'])) {
            /* A network-path reference ("//host/path") keeps only the scheme. */
            $targetAuthority = ($parsed['user'] ?? '') !== ''
                ? $parsed['user'] . (isset($parsed['pass']) ? ':' . $parsed['pass'] : '') . '@'
                : '';
            $targetAuthority .= $parsed['host'] . (isset($parsed['port']) ? ':' . $parsed['port'] : '');
            $targetPath = self::removeDotSegments($parsed['path'] ?? '');
            $targetQuery = $parsed['query'] ?? null;
        } else {
            $targetAuthority = $authority;
            $path = $parsed['path'] ?? '';
            if ($path === '') {
                $targetPath = $basePath;
                $targetQuery = $parsed['query'] ?? $baseQuery;
            } else {
                if (str_starts_with($path, '/')) {
                    $targetPath = self::removeDotSegments($path);
                } else {
                    $slash = strrpos($basePath, '/');
                    $directory = $slash === false ? '/' : substr($basePath, 0, $slash + 1);
                    $targetPath = self::removeDotSegments($directory . $path);
                }
                $targetQuery = $parsed['query'] ?? null;
            }
        }

        return $baseParts['scheme'] . '://' . $targetAuthority . $targetPath
            . ($targetQuery !== null ? '?' . $targetQuery : '')
            . (isset($parsed['fragment']) ? '#' . $parsed['fragment'] : '');
    }

    /**
     * RFC 3986 section 5.2.4: remove the "." and ".." segments of a path.
     */
    private static function removeDotSegments(string $path): string
    {
        $output = [];
        $segments = explode('/', $path);
        $last = count($segments) - 1;
        foreach ($segments as $index => $segment) {
            if ($segment === '.') {
                if ($index === $last) {
                    $output[] = '';
                }
                continue;
            }
            if ($segment === '..') {
                if (count($output) > 1) {
                    array_pop($output);
                }
                if ($index === $last) {
                    $output[] = '';
                }
                continue;
            }
            $output[] = $segment;
        }

        return implode('/', $output);
    }

    /**
     * Merges header maps so that a name in any casing replaces the same name
     * already present (RFC 9110 section 5.1): one field is never sent twice.
     *
     * @param array<string, string> $base
     * @param array<string, string> $overrides
     * @return array<string, string>
     */
    private static function mergeHeaders(array $base, array $overrides): array
    {
        foreach ($overrides as $name => $value) {
            foreach (array_keys($base) as $existing) {
                if (strcasecmp((string) $existing, (string) $name) === 0) {
                    unset($base[$existing]);
                }
            }
            $base[$name] = $value;
        }

        return $base;
    }

    /**
     * Compare two URLs by scheme + host + effective port.
     *
     * @internal Shared with {@see Paginator}; not part of the public API.
     */
    public static function sameOrigin(string $a, string $b): bool
    {
        $pa = parse_url($a);
        $pb = parse_url($b);
        if ($pa === false || $pb === false) {
            return false;
        }
        if (strtolower($pa['scheme'] ?? '') !== strtolower($pb['scheme'] ?? '')) {
            return false;
        }
        if (strtolower($pa['host'] ?? '') !== strtolower($pb['host'] ?? '')) {
            return false;
        }
        $portA = $pa['port'] ?? (strtolower($pa['scheme'] ?? '') === 'https' ? 443 : 80);
        $portB = $pb['port'] ?? (strtolower($pb['scheme'] ?? '') === 'https' ? 443 : 80);

        return $portA === $portB;
    }

    /**
     * Return a comma-separated list of supported content encodings.
     *
     * @return string supported encoding names
     */
    protected function getSupportedEncodings(): string
    {
        $encodings = ['gzip', 'deflate'];
        if (function_exists('brotli_uncompress')) {
            $encodings[] = 'br';
        }
        if (function_exists('zstd_uncompress')) {
            $encodings[] = 'zstd';
        }

        return implode(', ', $encodings);
    }

    /**
     * Decompress a response body based on the Content-Encoding header value.
     *
     * @param string $body     the raw response body
     * @param string $encoding the Content-Encoding header value
     * @return string the decompressed body
     */
    protected function decompressBody(string $body, string $encoding): string
    {
        if ($body === '') {
            return $body;
        }

        return match (strtolower($encoding)) {
            /* The @ keeps zlib's E_WARNING for a corrupt body from escaping
             * (an error handler could turn it into an \ErrorException); the
             * false return is what signals the failure. */
            'gzip', 'x-gzip' => self::decoded(@gzdecode($body), 'gzip'),
            'deflate' => self::decoded(@gzuncompress($body), 'deflate'),
            'br' => function_exists('brotli_uncompress')
                ? self::decoded(@brotli_uncompress($body), 'br')
                : throw new \RuntimeException(
                    'Received a br-encoded response but the br extension is unavailable'
                ),
            'zstd' => function_exists('zstd_uncompress')
                ? self::decoded(@zstd_uncompress($body), 'zstd')
                : throw new \RuntimeException(
                    'Received a zstd-encoded response but the zstd extension is unavailable'
                ),
            '', 'identity' => $body,
            /* An unrecognised (or multi-value) Content-Encoding is a response
             * the client cannot honour. Throw — the caller wraps it in an
             * ApiException carrying the response status (matching csharp/elixir
             * and the documented contract) rather than returning the body
             * still encoded. */
            default => throw new \RuntimeException(
                "Unsupported Content-Encoding '" . $encoding . "'"),
        };
    }

    /**
     * Returns a decoded body, or fails when the decoder reported failure.
     *
     * Only the false return signals a corrupt stream: a valid stream that
     * decodes to an empty string or to "0" is falsy but is a good body.
     *
     * @throws \RuntimeException when the decoder returned false
     */
    private static function decoded(string|false $decoded, string $codec): string
    {
        if ($decoded === false) {
            throw new \RuntimeException("the $codec stream is corrupt or truncated");
        }

        return $decoded;
    }

    /**
     * Rejects multipart filenames that would allow Content-Disposition header
     * injection or smuggling. Throws InvalidArgumentException when the
     * filename contains CR, LF, or NUL characters.
     *
     * @internal Not part of the public API; exposed only for SDK-internal use
     *           and direct unit testing. May change or be removed in any
     *           release without notice.
     *
     * @param string|null $filename the filename to validate
     * @throws \InvalidArgumentException when the filename contains CR/LF/NUL
     */
    public static function validateMultipartFilename(?string $filename): void
    {
        if ($filename === null) {
            return;
        }
        if (preg_match("/[\r\n\0]/", $filename) === 1) {
            throw new \InvalidArgumentException(
                'multipart filename must not contain CR, LF, or NUL characters'
            );
        }
    }

    /**
     * Validates a multipart form field NAME. CR/LF/NUL in the name would
     * inject a forged header line into the `Content-Disposition: form-data;
     * name="..."` segment. Symfony's FormDataPart trusts caller-supplied
     * keys verbatim so we guard before handing them over (W-new-2).
     *
     * @param string $name the field name to validate
     * @throws \InvalidArgumentException when the name contains CR/LF/NUL
     */
    protected static function validateMultipartFieldName(string $name): void
    {
        if (preg_match("/[\r\n\0]/", $name) === 1) {
            throw new \InvalidArgumentException(
                'multipart field name must not contain CR, LF, or NUL characters'
            );
        }
    }

    /**
     * Backslash-escapes the `"` and `\` characters of a multipart field name
     * so it stays one quoted-string inside `name="..."`.
     *
     * @param string $name the (validated) field name
     * @return string the escaped name
     */
    protected static function escapeMultipartFieldName(string $name): string
    {
        return str_replace(['\\', '"'], ['\\\\', '\\"'], $name);
    }

    /**
     * Builds the `filename=...` directive for a multipart Content-Disposition
     * header. For ASCII-only filenames emits a quote/backslash-escaped
     * `filename="..."`. For non-ASCII filenames additionally emits an RFC 5987
     * `filename*=UTF-8''<percent-encoded>` parameter alongside an ASCII
     * fallback (non-ASCII bytes replaced with `_`).
     *
     * @internal Not part of the public API; exposed only for SDK-internal use
     *           and direct unit testing. May change or be removed in any
     *           release without notice.
     *
     * @param string $filename the (validated) filename
     * @return string the directive string
     */
    public static function buildFilenameDirective(string $filename): string
    {
        $escaped = str_replace(['\\', '"'], ['\\\\', '\\"'], $filename);
        $isAscii = preg_match('/^[\x00-\x7F]*$/u', $filename) === 1;
        if ($isAscii) {
            return 'filename="' . $escaped . '"';
        }
        $fallback = preg_replace('/[^\x20-\x7E]/u', '_', $filename) ?? '';
        $fallbackEscaped = str_replace(['\\', '"'], ['\\\\', '\\"'], $fallback);
        $encoded = self::rfc5987EncodeValue($filename);

        return 'filename="' . $fallbackEscaped . '"; filename*=UTF-8\'\'' . $encoded;
    }

    /**
     * Percent-encodes every byte that is not an RFC 3986 §2.3 unreserved
     * character, producing the value-chars production of RFC 5987 §3.2.1.
     *
     * @param string $s the value to encode
     * @return string the percent-encoded value
     */
    protected static function rfc5987EncodeValue(string $s): string
    {
        $hex = '0123456789ABCDEF';
        $bytes = unpack('C*', $s);
        if ($bytes === false) {
            return '';
        }
        $out = '';
        foreach ($bytes as $b) {
            $isUnreserved =
                ($b >= 0x41 && $b <= 0x5A) ||
                ($b >= 0x61 && $b <= 0x7A) ||
                ($b >= 0x30 && $b <= 0x39) ||
                $b === 0x2D || $b === 0x2E || $b === 0x5F || $b === 0x7E;
            if ($isUnreserved) {
                $out .= chr($b);
            } else {
                $out .= '%' . $hex[$b >> 4] . $hex[$b & 0x0F];
            }
        }

        return $out;
    }
}
