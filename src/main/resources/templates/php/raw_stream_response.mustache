namespace {{invokerPackage}};

/**
 * Raw result of the header phase of one streaming HTTP exchange, as performed
 * by a transport's {@see AbstractApiClient::executeStreaming()}.
 *
 * Unlike {@see RawHttpResponse} the body has not been read: it is a pair of
 * closures, one that returns the next chunk of the undecoded body (null at the
 * end) and one that aborts the connection.
 *
 * @internal Not part of the public API; a transport-seam value type shared
 *           between AbstractApiClient and its concrete subclasses. May change
 *           or be removed in any release without notice.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class RawStreamResponse
{
    private bool $closed = false;

    /**
     * @param int                         $statusCode HTTP status code
     * @param array<string, list<string>> $headers    response headers; keys lowercased, multi-value lists preserved
     * @param \Closure(): ?string         $pull       returns the next chunk of the raw body, or null at its end;
     *                                                raises a NetworkTimeoutException for an idle stall and a
     *                                                StreamException for a reset
     * @param \Closure(): void            $abort      aborts the connection without draining the body
     */
    public function __construct(
        public readonly int $statusCode,
        public readonly array $headers,
        public readonly \Closure $pull,
        private readonly \Closure $abort
    ) {
    }

    /** Aborts the connection. Safe to call more than once. */
    public function close(): void
    {
        if ($this->closed) {
            return;
        }
        $this->closed = true;
        ($this->abort)();
    }
}
