namespace {{invokerPackage}};

use {{invokerPackage}}\Errors\NetworkException;
use {{invokerPackage}}\Errors\SerializationException;

/**
 * The line splitter and the server-sent events parser of the stream types, over a {@see ByteStream}.
 *
 * Lines end with LF, CR or CRLF (a CR is followed by a skipped LF, even across two reads); the first
 * line loses a UTF-8 byte order mark; a line longer than the limit raises a {@see \LengthException}.
 * The event grammar is the WHATWG one: a blank line dispatches, an event with an empty data buffer is
 * not dispatched but its id is kept, a comment line is skipped, one space after the colon is removed,
 * unknown fields are ignored, data lines are joined with a line feed, an id containing NUL is ignored,
 * a retry value must be digits, and an event cut off by the end of the connection is discarded.
 *
 * @internal Used by {@see SseStream} and by the JSON Lines generator; not part of the public API.
 *
 * @category Class
 * @package  {{invokerPackage}}
 */
final class EventStream
{
    private string $buffer = '';

    private int $position = 0;

    private bool $skipLineFeed = false;

    private bool $first = true;

    private bool $terminated = true;

    private bool $ended = false;

    private string $lastEventId;

    private ?int $retry = null;

    /**
     * @param ByteStream  $source       the body to read
     * @param int         $maxBytes     the longest line or event in bytes
     * @param string|null $lastEventId  the id an event stream starts from
     */
    public function __construct(
        private readonly ByteStream $source,
        private readonly int $maxBytes,
        ?string $lastEventId = null,
    ) {
        $this->lastEventId = $lastEventId ?? '';
    }

    /**
     * The items of a JSON Lines body: blank lines are skipped, a line that does not decode raises a
     * SerializationException naming its 1-based number and ends the generator, and so does a line
     * longer than the limit. Leaving the generator closes the source.
     *
     * @param \Closure(string): mixed|null $decoder decodes one line, or null to hand it over as it is
     *
     * @return \Generator<int, mixed> the items, in order
     */
    public static function jsonLines(ByteStream $source, ?\Closure $decoder, int $maxLineBytes, string $method, string $path): \Generator
    {
        $lines = new self($source, $maxLineBytes);
        $number = 0;
        try {
            while (($line = $lines->readLine()) !== null) {
                $number++;
                if (trim($line) === '') {
                    continue;
                }
                try {
                    $item = $decoder === null ? $line : $decoder($line);
                } catch (SerializationException $failure) {
                    throw (new SerializationException(
                        'Line ' . $number . ' of the JSON Lines response does not decode: ' . $failure->getMessage(),
                        0,
                        $failure
                    ))->withResponse($source->statusCode, $source->headers, '', $method, $path);
                }
                yield $item;
            }
        } catch (\LengthException $tooLong) {
            throw (new SerializationException(
                'Line ' . ($number + 1) . ' of the JSON Lines response is too long: ' . $tooLong->getMessage(),
                0,
                $tooLong
            ))->withResponse($source->statusCode, $source->headers, '', $method, $path);
        } catch (\RuntimeException) {
            /* the stream was closed by the caller */
        } finally {
            $source->close();
        }
    }

    /** The id of the last event the parser saw, empty while none was set. */
    public function lastEventId(): string
    {
        return $this->lastEventId;
    }

    /** The last `retry` value the server sent, in milliseconds, or null. */
    public function retry(): ?int
    {
        return $this->retry;
    }

    /** Whether the line read last ended with a line end, false for a last line cut off by the end of the body. */
    public function wasTerminated(): bool
    {
        return $this->terminated;
    }

    /**
     * Reads the next line without its line end.
     *
     * @return string|null the line, or null at the end of the body
     *
     * @throws \LengthException when the line is longer than the limit
     * @throws NetworkException  when the body fails or stalls
     * @throws \RuntimeException when the stream was closed by the caller
     */
    public function readLine(): ?string
    {
        $line = '';
        $any = false;
        while (true) {
            if ($this->position >= strlen($this->buffer)) {
                $chunk = $this->ended ? '' : $this->source->read(8192);
                if ($chunk === '') {
                    $this->ended = true;
                    if (!$any) {
                        return null;
                    }
                    $this->terminated = false;

                    return $this->decode($line);
                }
                $this->buffer = $chunk;
                $this->position = 0;
            }
            if ($this->skipLineFeed) {
                $this->skipLineFeed = false;
                if ($this->buffer[$this->position] === "\n") {
                    $this->position++;
                    continue;
                }
            }
            $length = strcspn($this->buffer, "\r\n", $this->position);
            if ($length > 0) {
                if (strlen($line) + $length > $this->maxBytes) {
                    throw new \LengthException('A line is longer than ' . $this->maxBytes . ' bytes');
                }
                $any = true;
                $line .= substr($this->buffer, $this->position, $length);
                $this->position += $length;
            }
            if ($this->position >= strlen($this->buffer)) {
                continue;
            }
            $this->skipLineFeed = $this->buffer[$this->position] === "\r";
            $this->position++;
            $this->terminated = true;

            return $this->decode($line);
        }
    }

    /**
     * Reads the next event to dispatch.
     *
     * @return ServerSentEvent<string>|null the event with its data as text, or null at the end of the body
     *
     * @throws \LengthException when a line or the data of an event is longer than the limit
     * @throws NetworkException  when the body fails or stalls
     * @throws \RuntimeException when the stream was closed by the caller
     */
    public function nextEvent(): ?ServerSentEvent
    {
        $data = '';
        $hasData = false;
        $name = '';
        $idBuffer = $this->lastEventId;
        while (true) {
            $line = $this->readLine();
            if ($line === null || !$this->terminated) {
                return null;
            }
            if ($line === '') {
                $this->lastEventId = $idBuffer;
                if (!$hasData) {
                    $name = '';
                    continue;
                }
                $text = substr($data, 0, -1);

                return new ServerSentEvent(
                    $this->lastEventId === '' ? null : $this->lastEventId,
                    $name === '' ? 'message' : $name,
                    $text,
                    $this->retry,
                    $text
                );
            }
            if ($line[0] === ':') {
                continue;
            }
            $field = $line;
            $value = '';
            $colon = strpos($line, ':');
            if ($colon !== false) {
                $field = substr($line, 0, $colon);
                $value = substr($line, $colon + 1);
                if (str_starts_with($value, ' ')) {
                    $value = substr($value, 1);
                }
            }
            switch ($field) {
                case 'data':
                    if (strlen($data) + strlen($value) + 1 > $this->maxBytes) {
                        throw new \LengthException('An event is longer than ' . $this->maxBytes . ' bytes');
                    }
                    $data .= $value . "\n";
                    $hasData = true;
                    break;
                case 'event':
                    $name = $value;
                    break;
                case 'id':
                    if (!str_contains($value, "\0")) {
                        $idBuffer = $value;
                    }
                    break;
                case 'retry':
                    if ($value !== '' && ctype_digit($value) && strlen($value) < 18) {
                        $this->retry = (int) $value;
                    }
                    break;
                default:
                    /* an unknown field is ignored */
                    break;
            }
        }
    }

    /** Decodes a line as UTF-8, dropping a byte order mark from the first one. */
    private function decode(string $line): string
    {
        if ($this->first) {
            $this->first = false;
            if (str_starts_with($line, "\xEF\xBB\xBF")) {
                $line = substr($line, 3);
            }
        }

        return function_exists('mb_scrub') ? mb_scrub($line, 'UTF-8') : $line;
    }
}
