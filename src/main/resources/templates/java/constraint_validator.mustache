    static IllegalArgumentException refused(String prefix, String name, String message) {
        return new IllegalArgumentException(
                "Invalid request body: " + prefix + name + " " + message);
    }

    static void minLength(
            @Nullable String value, int limit, String prefix, String name, String message) {
        if (value != null && value.codePointCount(0, value.length()) < limit) {
            throw refused(prefix, name, message);
        }
    }

    static void maxLength(
            @Nullable String value, int limit, String prefix, String name, String message) {
        if (value != null && value.codePointCount(0, value.length()) > limit) {
            throw refused(prefix, name, message);
        }
    }

    /* A pattern is searched, not anchored; one the JDK engine cannot compile is not enforced. */
    static void pattern(
            @Nullable String value, String regex, String prefix, String name, String message) {
        if (value == null) {
            return;
        }
        Optional<Pattern> compiled = PATTERNS.computeIfAbsent(regex, ConstraintValidator::compile);
        if (compiled.isPresent() && !compiled.get().matcher(value).find()) {
            throw refused(prefix, name, message);
        }
    }

    static Optional<Pattern> compile(String regex) {
        try {
            return Optional.of(Pattern.compile(regex));
        } catch (PatternSyntaxException unsupported) {
            return Optional.empty();
        }
    }

    static void minimum(
            @Nullable Number value, double limit, String prefix, String name, String message) {
        if (value != null && value.doubleValue() < limit) {
            throw refused(prefix, name, message);
        }
    }

    static void maximum(
            @Nullable Number value, double limit, String prefix, String name, String message) {
        if (value != null && value.doubleValue() > limit) {
            throw refused(prefix, name, message);
        }
    }

    static void exclusiveMinimum(
            @Nullable Number value, double limit, String prefix, String name, String message) {
        if (value != null && value.doubleValue() <= limit) {
            throw refused(prefix, name, message);
        }
    }

    static void exclusiveMaximum(
            @Nullable Number value, double limit, String prefix, String name, String message) {
        if (value != null && value.doubleValue() >= limit) {
            throw refused(prefix, name, message);
        }
    }

    static void multipleOf(
            @Nullable Number value, double limit, String prefix, String name, String message) {
        if (value == null) {
            return;
        }
        double quotient = value.doubleValue() / limit;
        if (Math.abs(quotient - Math.rint(quotient)) >= 1e-9) {
            throw refused(prefix, name, message);
        }
    }

    static void minSize(
            @Nullable Collection<?> value, int limit, String prefix, String name, String message) {
        if (value != null && value.size() < limit) {
            throw refused(prefix, name, message);
        }
    }

    static void maxSize(
            @Nullable Collection<?> value, int limit, String prefix, String name, String message) {
        if (value != null && value.size() > limit) {
            throw refused(prefix, name, message);
        }
    }

    static void minEntries(
            @Nullable Map<?, ?> value, int limit, String prefix, String name, String message) {
        if (value != null && value.size() < limit) {
            throw refused(prefix, name, message);
        }
    }

    static void maxEntries(
            @Nullable Map<?, ?> value, int limit, String prefix, String name, String message) {
        if (value != null && value.size() > limit) {
            throw refused(prefix, name, message);
        }
    }
}
