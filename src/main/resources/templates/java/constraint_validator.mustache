package {{invokerPackage}}.api;

import java.util.Collection;
import java.util.Map;
import java.util.Optional;
import java.util.concurrent.ConcurrentHashMap;
import java.util.regex.Pattern;
import java.util.regex.PatternSyntaxException;
import javax.annotation.Nullable;

/**
 * Checks a request body against the validation keywords of its schema before it is sent, when
 * {@link {{invokerPackage}}.Configuration#isValidateConstraints()} is on.
 *
 * <p>A body that is a model, or a list of models, is checked property by property in declaration
 * order, depth first through the models it holds; the first broken keyword raises an {@link
 * IllegalArgumentException} that names the property by its wire path. A null value is not
 * checked, and any other body passes.
 */
final class ConstraintValidator {

    /** The compiled patterns by their text; empty when the pattern does not compile. */
    private static final Map<String, Optional<Pattern>> PATTERNS = new ConcurrentHashMap<>();

    private ConstraintValidator() {}

    /**
     * Check a request body.
     *
     * @param body the request body
     * @throws IllegalArgumentException when a value breaks a keyword of its schema
     */
    static void validate(@Nullable Object body) {
        if (body instanceof Collection<?> items) {
            int index = 0;
            for (Object item : items) {
                validateModel(item, "[" + index + "].");
                index++;
            }
            return;
        }
        validateModel(body, "");
    }

    /* The exact class is matched, so a model that extends another is checked by its own rules.
     * The helpers are package-private so that a spec without one keyword leaves none unused. */
    static void validateModel(@Nullable Object value, String prefix) {
        if (value == null) {
            return;
        }
{{#constraintModels}}
        if (value instanceof {{modelPackage}}.{{classname}} model
                && value.getClass() == {{modelPackage}}.{{classname}}.class) {
            validate{{classname}}(model, prefix);
            return;
        }
{{/constraintModels}}
    }

    static void validateItems(@Nullable Collection<?> items, String prefix, String name) {
        if (items == null) {
            return;
        }
        int index = 0;
        for (Object item : items) {
            validateModel(item, prefix + name + "[" + index + "].");
            index++;
        }
    }
{{#constraintModels}}

