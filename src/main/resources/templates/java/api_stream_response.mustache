package {{invokerPackage}};

import java.io.IOException;
import java.io.InputStream;
import java.util.Base64;
import java.util.Collections;
import java.util.HashMap;
import java.util.Map;

/**
 * An HTTP response whose body has not been read yet: the status code, the lower-cased headers
 * and the open body. It is what {@link ApiClient#sendStreaming} returns. The caller owns the
 * body and must close it; closing aborts the connection instead of draining it.
 *
 * <p>A non-2xx response is returned like any other, with its body open; a caller that does not
 * want it reads a bounded part with {@link #readBounded(int)} or closes it.
 *
 * @param statusCode the HTTP status code
 * @param headers the response headers, lower-cased (unmodifiable)
 * @param body the open response body, decoded when the server compressed it
 */
public record ApiStreamResponse(int statusCode, Map<String, String> headers, InputStream body)
        implements AutoCloseable {

    /**
     * Creates a response with defensively copied headers.
     */
    public ApiStreamResponse(int statusCode, Map<String, String> headers, InputStream body) {
        this.statusCode = statusCode;
        this.headers = Collections.unmodifiableMap(new HashMap<>(headers));
        this.body = body;
    }

    /**
     * Reads at most {@code maxBytes} of the body, closes it and returns the result as a buffered
     * response, so the same typed error as a buffered call can be raised from it. The body text is
     * decoded for a text content type and is Base64 text otherwise, as a buffered response is.
     *
     * @param maxBytes the most bytes to read
     * @return the buffered response
     */
    public ApiHttpResponse readBounded(int maxBytes) {
        try (InputStream in = body) {
            byte[] bytes = in.readNBytes(maxBytes);
            String contentType = headers.getOrDefault("content-type", "");
            String text =
                    DefaultApiClient.isTextContentType(contentType)
                            ? new String(bytes, DefaultApiClient.parseCharset(contentType))
                            : Base64.getEncoder().encodeToString(bytes);
            return new ApiHttpResponse(statusCode, text, headers);
        } catch (IOException failure) {
            return new ApiHttpResponse(statusCode, "", headers);
        }
    }

    /** Closes the body, which aborts the connection. */
    @Override
    public void close() {
        try {
            body.close();
        } catch (IOException ignored) {
            /* the connection is being dropped either way */
        }
    }

    /**
     * Describes the response by its status only; the headers and the body are never shown.
     *
     * @return the status
     */
    @Override
    public String toString() {
        return "ApiStreamResponse{statusCode=" + statusCode + "}";
    }
}
