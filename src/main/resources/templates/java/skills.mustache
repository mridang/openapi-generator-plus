import java.util.concurrent.Executors;

class Cancellation {
    static void {{operationId}}ThenCancel({{clientClassName}} client{{#vendorExtensions.op.signatureArgsNoServer}}, {{{dataType}}} {{paramName}}{{/vendorExtensions.op.signatureArgsNoServer}}) {
