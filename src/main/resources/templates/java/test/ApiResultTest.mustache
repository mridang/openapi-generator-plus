package {{invokerPackage}};

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertThrows;

import java.util.Map;
import org.junit.jupiter.api.Test;

{{>models/checkstyle_suppressions}}
class ApiResultTest {

    @Test
    void carriesDataStatusCodeHeadersAndRawBodyAsConstructed() {
        ApiResult<String> result =
                new ApiResult<>(
                        200,
                        "payload",
                        "{\"value\":\"payload\"}",
                        Map.of("content-type", "application/json"));

        assertEquals(200, result.statusCode());
        assertEquals("payload", result.data());
        assertEquals("{\"value\":\"payload\"}", result.rawBody());
        assertEquals("application/json", result.headers().get("content-type"));
    }

    @Test
    void allowsNullDataForVoidResponses() {
        // data is @Nullable — void responses carry a null payload but still
        // expose status, raw body, and headers.
        ApiResult<String> result = new ApiResult<>(204, null, "", Map.of());

        assertEquals(204, result.statusCode());
        assertNull(result.data());
        assertEquals("", result.rawBody());
        assertEquals(Map.of(), result.headers());
    }

    @Test
    void headersAreDefensivelyCopiedAndUnmodifiable() {
        // The compact constructor wraps the headers in an unmodifiable copy, so
        // mutation attempts on the exposed map throw.
        ApiResult<String> result =
                new ApiResult<>(200, "ok", "ok", Map.of("x-trace", "abc"));

        assertThrows(
                UnsupportedOperationException.class,
                () -> result.headers().put("x-evil", "1"));
    }
}
