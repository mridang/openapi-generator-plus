    @Nested
    @DisplayName("oneOf with discriminator: PetFood")
    class PetFoodTests {

        @Test
        @DisplayName("bhvUnions012 deserializes DryFood via discriminator")
        void bhvUnions012TestDeserializeDryFood() {
            String json = "{\"foodType\":\"dry\",\"weightKg\":2.5}";
            Object result = Objects.requireNonNull(serializer.deserialize(json, PET_FOOD_TYPE));

            assertThat(result).isInstanceOf(DryFood.class);
            assertThat(((DryFood) result).foodType).isEqualTo("dry");
        }

        @Test
        @DisplayName("bhvUnions013 deserializes WetFood via discriminator")
        void bhvUnions013TestDeserializeWetFood() {
            String json = "{\"foodType\":\"wet\",\"volumeMl\":400}";
            Object result = Objects.requireNonNull(serializer.deserialize(json, PET_FOOD_TYPE));

            assertThat(result).isInstanceOf(WetFood.class);
            assertThat(((WetFood) result).foodType).isEqualTo("wet");
        }

        @Test
        @DisplayName("bhvUnions016 throws for unknown discriminator value")
        void bhvUnions016TestUnknownDiscriminator() {
            // An unknown discriminator matches no listed subtype and must be
            // rejected (FAIL_ON_INVALID_SUBTYPE), matching the other 11 SDKs.
            String json = "{\"foodType\":\"raw\",\"calories\":300}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }

        @Test
        @DisplayName("bhvUnions020 serializes DryFood back to JSON")
        void bhvUnions020TestSerializeDryFood() {
            String json = "{\"foodType\":\"dry\",\"weightKg\":2.5}";
            Object result = Objects.requireNonNull(serializer.deserialize(json, PET_FOOD_TYPE));

            String serialized = serializer.serialize(result);

            assertThat(serialized).contains("dry");
            assertThat(serialized).contains("2.5");
        }

        @Test
        @DisplayName("bhvUnions015 throws when discriminator field is missing")
        void bhvUnions015TestMissingDiscriminatorThrows() {
            // A payload omitting the discriminator property entirely cannot
            // route to any subtype; Jackson's EXISTING_PROPERTY type resolution
            // fails. Aligns Java with Python / Swift / PHP / Ruby / Dart / Rust.
            String json = "{\"weightKg\":2.5}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }

        @Test
        @DisplayName("bhvUnions024 throws when discriminator value is empty")
        void bhvUnions024TestEmptyDiscriminatorThrows() {
            // An empty discriminator value matches no listed subtype and must
            // be rejected rather than silently routed.
            String json = "{\"foodType\":\"\",\"weightKg\":2.5}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }

        @Test
        @DisplayName("bhvUnions026 unknown discriminator error names the offending value")
        void bhvUnions026TestUnknownDiscriminatorErrorNamesValue() {
            // The deserialization failure must surface the offending
            // discriminator value so callers can diagnose server/spec drift.
            // Jackson reports the unresolved type id in the root cause message.
            String json = "{\"foodType\":\"raw\",\"calories\":300}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                    .isExactlyInstanceOf(SerializationException.class)
                    .hasRootCauseInstanceOf(Exception.class)
                    .satisfies(thrown -> {
                        Throwable root = thrown;
                        while (root.getCause() != null) {
                            root = root.getCause();
                        }
                        assertThat(root.getMessage()).contains("raw");
                    });
        }

        @Test
        @DisplayName("bhvUnions030 a subtype whose discriminator key is absent is filled with the mapping default")
        void bhvUnions030DryFoodFillsAbsentDiscriminatorWithItsDefault() {
            Object result = Objects.requireNonNull(serializer.deserialize(
                    "{\"weightKg\":2.5}", new TypeReference<DryFood>() {}.getType()));

            assertThat(result).isInstanceOf(DryFood.class);
            assertThat(((DryFood) result).foodType).isEqualTo("dry");
        }

        @Test
        @DisplayName("bhvUnions032 a oneOf wrapper built from a variant serializes it with its discriminator")
        void bhvUnions032VariantBuiltInCodeSerializesWithItsDiscriminator() {
            Object food = new DryFood(2.5);

            assertThat(food).isInstanceOf(DryFood.class);
            assertThat(serializer.serialize(food)).contains("\"foodType\":\"dry\"");
        }

        @Test
        @DisplayName("bhvUnions033 an unknown, missing or empty discriminator fails with the serialization error")
        void bhvUnions033UnknownMissingOrEmptyDiscriminatorIsASerializationError() {
            for (String json : List.of(
                    "{\"foodType\":\"raw\",\"weightKg\":2.5}",
                    "{\"weightKg\":2.5}",
                    "{\"foodType\":\"\",\"weightKg\":2.5}")) {
                assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                        .isExactlyInstanceOf(SerializationException.class);
            }
        }

        @Test
        @DisplayName("bhvUnions035 a discriminator value not listed in the mapping fails to deserialize")
        void bhvUnions035UnlistedDiscriminatorValueFailsToDeserialize() {
            String json = "{\"foodType\":\"fish\",\"weightKg\":2.5}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_FOOD_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }
    }

    @Nested
    @DisplayName("anyOf without discriminator: PetTreatment")
    class PetTreatmentTests {

        @Test
        @DisplayName("bhvUnions014 deserializes Medication from anyOf")
        void bhvUnions014TestDeserializeMedication() {
            String json = "{\"drugName\":\"Amoxicillin\",\"dosage\":\"500mg\"}";
            PetTreatment result =
                    Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));

            assertThat(result.getActualInstance()).isInstanceOf(Medication.class);
            // getActualInstance() is @Nullable (empty union -> null); a successfully
            // deserialized anyOf always has >= 1 retained variant, so assert non-null
            // before the cast to satisfy NullAway.
            assertThat(((Medication) Objects.requireNonNull(result.getActualInstance())).drugName)
                    .isEqualTo("Amoxicillin");
        }

        @Test
        @DisplayName("bhvUnions007 anyOf with no matching variant throws SerializationException")
        void bhvUnions007TestAnyOfNoMatchingVariantThrows() {
            String json = "{\"unexpected\":\"shape\"}";
            assertThatThrownBy(() -> serializer.deserialize(json, PET_TREATMENT_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }

        @Test
        @DisplayName("bhvUnions011 anyOf unions decoded from the same JSON are equal with equal hash codes")
        void bhvUnions011AnyOfValueEquality() {
            String json = "{\"drugName\":\"a\",\"procedureName\":\"b\"}";
            PetTreatment first = Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));
            PetTreatment second = Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));
            assertThat(first).isEqualTo(second).hasSameHashCodeAs(second);
        }

        @Test
        @DisplayName("bhvUnions006 deserializes Surgery from anyOf")
        void bhvUnions006TestDeserializeSurgery() {
            String json = "{\"procedureName\":\"Spay\",\"durationMinutes\":45}";
            PetTreatment result =
                    Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));

            assertThat(result.getActualInstance()).isInstanceOf(Surgery.class);
        }

        @Test
        @DisplayName("bhvUnions008 serializes round-trip for anyOf")
        void bhvUnions008TestSerializeRoundTrip() {
            String json = "{\"drugName\":\"Amoxicillin\",\"dosage\":\"500mg\"}";
            PetTreatment result =
                    Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));

            String serialized = serializer.serialize(result);
            assertThat(serialized).isNotEmpty();
        }

        @Test
        @DisplayName("bhvUnions003 anyOf with a single matching variant has one matched instance")
        void bhvUnions003TestSingleMatchedInstance() {
            String json = "{\"drugName\":\"Amoxicillin\",\"dosage\":\"500mg\"}";
            PetTreatment result =
                    Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));

            assertThat(result.getMatchedInstances()).hasSize(1);
            assertThat(result.getActualInstance()).isSameAs(result.getMatchedInstances().get(0));
            assertThat(result.getActualInstance()).isInstanceOf(Medication.class);
        }

        @Test
        @DisplayName("bhvUnions009 anyOf retains all matching variants (medication and surgery) losslessly")
        void bhvUnions009TestRetainsAllMatchingVariants() {
            // anyOf is inclusive: PetTreatment is documented as matching a
            // medication, a surgery, OR BOTH. A payload that satisfies both
            // variants at once must retain every variant — not just the first
            // match — so the co-satisfied data round-trips without silent loss.
            String json =
                    "{\"drugName\":\"Amoxicillin\",\"dosage\":\"250mg\","
                            + "\"procedureName\":\"Spay\",\"durationMinutes\":45}";
            PetTreatment result =
                    Objects.requireNonNull(serializer.deserialize(json, PET_TREATMENT_TYPE));

            // Both variants are retained and accessible, not just the first.
            assertThat(result.getMatchedInstances()).hasSize(2);
            assertThat(result.getMatchedInstances().get(0)).isInstanceOf(Medication.class);
            assertThat(result.getMatchedInstances().get(1)).isInstanceOf(Surgery.class);
            assertThat(result.getActualInstance())
                    .isSameAs(result.getMatchedInstances().get(0))
                    .isInstanceOf(Medication.class);
            Medication medication =
                    result.getMatchedInstances().stream()
                            .filter(Medication.class::isInstance)
                            .map(Medication.class::cast)
                            .findFirst()
                            .orElseThrow();
            Surgery surgery =
                    result.getMatchedInstances().stream()
                            .filter(Surgery.class::isInstance)
                            .map(Surgery.class::cast)
                            .findFirst()
                            .orElseThrow();
            assertThat(medication.drugName).isEqualTo("Amoxicillin");
            assertThat(medication.dosage).isEqualTo("250mg");
            assertThat(surgery.procedureName).isEqualTo("Spay");
            assertThat(surgery.durationMinutes).isEqualTo(45);

            // Re-serializing emits the union of both variants' fields, so all
            // four fields survive the round-trip with no silent drop.
            String serialized = serializer.serialize(result);
            assertThat(serialized).contains("drugName");
            assertThat(serialized).contains("Amoxicillin");
            assertThat(serialized).contains("dosage");
            assertThat(serialized).contains("250mg");
            assertThat(serialized).contains("procedureName");
            assertThat(serialized).contains("Spay");
            assertThat(serialized).contains("durationMinutes");
            assertThat(serialized).contains("45");
        }

        @Test
        @DisplayName("bhvUnions010 shared-property collision keeps the last variant's value, emitted once")
        void bhvUnions010TestSharedPropertyCollisionLastWins() {
            // Both members declare `notes`. When a PetTreatment retains a
            // Medication AND a Surgery that each set `notes` to a different
            // value, the merged encoding keeps the LAST-declared member's value
            // (Surgery is declared after Medication) and emits `notes` exactly
            // once — never a duplicate JSON key.
            PetTreatment medication =
                    Objects.requireNonNull(
                            serializer.deserialize(
                                    "{\"drugName\":\"Amoxicillin\",\"notes\":\"from-medication\"}",
                                    PET_TREATMENT_TYPE));
            PetTreatment surgery =
                    Objects.requireNonNull(
                            serializer.deserialize(
                                    "{\"procedureName\":\"Spay\",\"notes\":\"from-surgery\"}",
                                    PET_TREATMENT_TYPE));
            PetTreatment combined =
                    new PetTreatment(
                            java.util.List.of(
                                    Objects.requireNonNull(medication.getActualInstance()),
                                    Objects.requireNonNull(surgery.getActualInstance())));

            String serialized = serializer.serialize(combined);

            // Surgery is the later member, so its `notes` wins the collision.
            assertThat(serialized).contains("from-surgery");
            assertThat(serialized).doesNotContain("from-medication");
            // `notes` appears exactly once — no duplicate key.
            assertThat(serialized.split("\"notes\"", -1)).hasSize(2);
        }
    }

