    @Nested
    @DisplayName("oneOf without discriminator: SetPetAvatarThumbnailRequest")
    class OneOfNoDiscriminatorTests {

        @Test
        @DisplayName("bhvUnions019 deserializes the single base64 (byte[]) variant")
        void bhvUnions019TestDeserializeByteVariant() {
            String json = "\"aGVsbG8=\"";
            SetPetAvatarThumbnailRequest result =
                    Objects.requireNonNull(serializer.deserialize(json, ONE_OF_NO_DISCRIMINATOR_TYPE));
            // The spec variant `type: string, format: byte` maps to byte[] in
            // Java, so a lone base64 string decodes to the byte[] member of the
            // union rather than to String.
            assertThat(result.getActualInstance()).isInstanceOf(byte[].class);
        }

        @Test
        @DisplayName("bhvUnions029 oneOf wrappers have value equality")
        void bhvUnions029OneOfWrappersHaveValueEquality() {
            SetPetAvatarThumbnailRequest first =
                    Objects.requireNonNull(serializer.deserialize("\"aGVsbG8=\"", ONE_OF_NO_DISCRIMINATOR_TYPE));
            SetPetAvatarThumbnailRequest second =
                    Objects.requireNonNull(serializer.deserialize("\"aGVsbG8=\"", ONE_OF_NO_DISCRIMINATOR_TYPE));
            SetPetAvatarThumbnailRequest other =
                    Objects.requireNonNull(serializer.deserialize("\"d29ybGQ=\"", ONE_OF_NO_DISCRIMINATOR_TYPE));
            assertThat(first).isEqualTo(second).hasSameHashCodeAs(second).isNotEqualTo(other);
        }

        @Test
        @DisplayName("an empty JSON array is the list variant and a base64 string is the byte variant")
        void bhvUnions041EachVariantDecodesItsOwnShape() {
            SetPetAvatarThumbnailRequest list =
                    Objects.requireNonNull(serializer.deserialize("[]", ONE_OF_NO_DISCRIMINATOR_TYPE));
            assertThat(list.getActualInstance()).isInstanceOf(List.class);
            SetPetAvatarThumbnailRequest bytes =
                    Objects.requireNonNull(serializer.deserialize("\"AQID\"", ONE_OF_NO_DISCRIMINATOR_TYPE));
            assertThat(bytes.getActualInstance()).isInstanceOf(byte[].class);
        }

        {{! Canonical byte-oneOf regression: the scalar `format:byte` variant }}
        {{! must travel on the wire as a base64 STRING (the same encoding the }}
        {{! bare scalar format:byte field uses) — never a JSON int-array }}
        {{! [1,2,3,4], never the raw bytes, never a toString() of byte[]. }}
        @Test
        @DisplayName("bhvUnions023 setPetAvatarThumbnail byte oneOf round-trips through base64")
        void bhvUnions023SetPetAvatarThumbnailByteOneOfRoundTripsThroughBase64() {
            byte[] payload = new byte[] {0x01, 0x02, 0x03, 0x04};
            SetPetAvatarThumbnailRequest request = new SetPetAvatarThumbnailRequest(payload);

            String serialized = serializer.serialize(request);

            // The wire form is the base64 STRING of the four bytes — base64 of
            // [0x01,0x02,0x03,0x04] is "AQIDBA==". It must NOT be the int-array
            // [1,2,3,4] nor the raw/toString-mangled bytes.
            assertThat(serialized).isEqualTo("\"AQIDBA==\"");
            assertThat(serialized).doesNotContain("[1,2,3,4]");
            assertThat(serialized).doesNotContain("[1, 2, 3, 4]");

            // Round-trip: the base64 string decodes back to the scalar byte[]
            // variant (one value), recovering exactly the original four bytes —
            // not mis-parsed element-by-element into a List<byte[]>.
            SetPetAvatarThumbnailRequest restored =
                    Objects.requireNonNull(
                            serializer.deserialize(serialized, ONE_OF_NO_DISCRIMINATOR_TYPE));
            assertThat(restored.getActualInstance()).isInstanceOf(byte[].class);
            assertThat((byte[]) restored.getActualInstance()).isEqualTo(payload);
        }

        {{! The array branch (List<byte[]>) is a distinct constructible variant: }}
        {{! it must serialize to a JSON array of base64 STRINGS and round-trip }}
        {{! back to the same two payloads. }}
        @Test
        @DisplayName("bhvUnions022 setPetAvatarThumbnail byte-array oneOf round-trips through base64 array")
        void bhvUnions022SetPetAvatarThumbnailByteArrayOneOfRoundTripsThroughBase64Array() {
            byte[] first = new byte[] {0x01, 0x02, 0x03, 0x04};
            byte[] second = new byte[] {0x05, 0x06};
            SetPetAvatarThumbnailRequest request =
                    new SetPetAvatarThumbnailRequest(java.util.List.of(first, second));

            String serialized = serializer.serialize(request);

            // base64 of [0x01,0x02,0x03,0x04] is "AQIDBA=="; of [0x05,0x06] is "BQY=".
            assertThat(serialized).isEqualTo("[\"AQIDBA==\",\"BQY=\"]");

            SetPetAvatarThumbnailRequest restored =
                    Objects.requireNonNull(
                            serializer.deserialize(serialized, ONE_OF_NO_DISCRIMINATOR_TYPE));
            @SuppressWarnings("unchecked")
            java.util.List<byte[]> restoredList =
                    (java.util.List<byte[]>) restored.getActualInstance();
            assertThat(restoredList).hasSize(2);
            assertThat(restoredList.get(0)).isEqualTo(first);
            assertThat(restoredList.get(1)).isEqualTo(second);
        }

        {{! Ordering: a scalar base64 string must resolve to the SCALAR byte[] }}
        {{! variant, not be mis-coerced element-by-element into a List<byte[]>, }}
        {{! even though List<byte[]> precedes byte[] in ONE_OF_SCHEMAS. }}
        @Test
        @DisplayName("bhvUnions018 scalar base64 string resolves to the scalar variant, not a list")
        void bhvUnions018ScalarBase64StringResolvesToScalarVariantNotList() {
            String json = "\"AQIDBA==\"";
            SetPetAvatarThumbnailRequest result =
                    Objects.requireNonNull(
                            serializer.deserialize(json, ONE_OF_NO_DISCRIMINATOR_TYPE));
            assertThat(result.getActualInstance()).isInstanceOf(byte[].class);
            assertThat(result.getActualInstance()).isNotInstanceOf(java.util.List.class);
            assertThat((byte[]) result.getActualInstance())
                    .isEqualTo(new byte[] {0x01, 0x02, 0x03, 0x04});
        }

        @Test
        @DisplayName("throws when no oneOf variant matches (no silent raw accept)")
        void testNoMatchThrows() {
            // A JSON object matches neither the single-byte[] nor the
            // array-of-byte[] variant. The deserializer must reject it rather
            // than silently store the raw tree as the actualInstance.
            String json = "{\"unexpected\":\"shape\"}";
            assertThatThrownBy(() -> serializer.deserialize(json, ONE_OF_NO_DISCRIMINATOR_TYPE))
                    .isExactlyInstanceOf(SerializationException.class);
        }
    }

