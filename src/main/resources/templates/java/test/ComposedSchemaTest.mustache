        @Test
        @DisplayName("bhvUnions004 deserializes all properties from allOf composition")
        void bhvUnions004TestDeserialize() {
            String json =
                    "{\"name\":\"doggie\",\"photoUrls\":[\"http://example.com/photo.jpg\"],\"ownerName\":\"John\",\"ownerEmail\":\"john@example.com\"}";
