        java.io.IOException cause = new java.io.IOException("root cause");
        ApiException[] errors = {
            new ApiException(418, "m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.BadRequestException("m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.UnauthorizedException("m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.ForbiddenException("m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.NotFoundException("m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.ConflictException("m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.UnprocessableEntityException(
                    "m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.TooManyRequestsException(
                    "m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.InternalServerErrorException(
                    "m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.ClientException(418, "m", null, null, null, cause, "PUT", "/a?q=1"),
            new {{invokerPackage}}.errors.ServerException(503, "m", null, null, null, cause, "PUT", "/a?q=1"),
