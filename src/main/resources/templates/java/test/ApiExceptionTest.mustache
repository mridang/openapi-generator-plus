    @Test
    void bhvErrors001RenderedBodyEscapesTabsAndOtherControlCharacters() {
        ApiException ex = new ApiException(500, "boom", Map.of(), "a\tb\1c\177d");

        assertEquals(
                "boom\nHTTP status code: 500\nResponse body: a\\tb\\u0001c\\u007fd",
                ex.toString());
    }

    @Test
    void renderedBodyIsCappedAndControlCharactersAreEscaped() {
        String longBody = "x".repeat(1030);
        ApiException capped = new ApiException(500, "boom", Map.of(), longBody);
        assertEquals(
                "boom\nHTTP status code: 500\nResponse body: " + "x".repeat(1024) + "... (6 more bytes)",
                capped.toString());
        assertEquals(longBody, capped.getResponseBody());

        ApiException forged = new ApiException(500, "boom", Map.of(), "a\r\nHTTP status code: 200");
        assertEquals(
                "boom\nHTTP status code: 500\nResponse body: a\\r\\nHTTP status code: 200",
                forged.toString());
    }

    @Test
    void bhvErrors013GetTypedErrorBodyDeserializesTheBodyIntoTheGivenClass() {
        // Built through fromResponse, the way a real response reaches a caller:
        // the typed body must come out of the raw body, not out of whatever the
        // generic parse happened to leave behind.
        ApiException ex = ApiException.fromResponse(
