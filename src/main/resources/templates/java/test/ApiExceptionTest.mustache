        assertEquals(429, new {{invokerPackage}}.errors.TooManyRequestsException("m", null, null, null, cause).getStatusCode());
        assertEquals(cause, new {{invokerPackage}}.errors.PaymentRequiredException("m", null, null, null, cause).getCause());
        assertEquals(402, new {{invokerPackage}}.errors.PaymentRequiredException("m", null, null, null, cause).getStatusCode());
        assertEquals(cause, new {{invokerPackage}}.errors.MethodNotAllowedException("m", null, null, null, cause).getCause());
        assertEquals(405, new {{invokerPackage}}.errors.MethodNotAllowedException("m", null, null, null, cause).getStatusCode());
        assertEquals(cause, new {{invokerPackage}}.errors.RequestTimeoutException("m", null, null, null, cause).getCause());
        assertEquals(408, new {{invokerPackage}}.errors.RequestTimeoutException("m", null, null, null, cause).getStatusCode());
        assertEquals(cause, new {{invokerPackage}}.errors.GoneException("m", null, null, null, cause).getCause());
        assertEquals(410, new {{invokerPackage}}.errors.GoneException("m", null, null, null, cause).getStatusCode());
        assertEquals(cause, new {{invokerPackage}}.errors.PayloadTooLargeException("m", null, null, null, cause).getCause());
        assertEquals(413, new {{invokerPackage}}.errors.PayloadTooLargeException("m", null, null, null, cause).getStatusCode());
