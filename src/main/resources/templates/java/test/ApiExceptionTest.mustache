        assertEquals(cause, new {{invokerPackage}}.errors.NotImplementedException("m", null, null, null, cause).getCause());
        assertEquals(501, new {{invokerPackage}}.errors.NotImplementedException("m", null, null, null, cause).getStatusCode());
