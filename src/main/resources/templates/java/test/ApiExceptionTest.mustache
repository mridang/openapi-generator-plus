    @Test
    void bhvErrors006FromResponseMapsEveryStatusToItsException() {
        // 302 is below the client range and 600 above the server range: neither
        // is a ClientException or a ServerException, both are the base type.
        Map<Integer, Class<? extends ApiException>> expected = Map.ofEntries(
                Map.entry(400, {{invokerPackage}}.errors.BadRequestException.class),
                Map.entry(401, {{invokerPackage}}.errors.UnauthorizedException.class),
                Map.entry(403, {{invokerPackage}}.errors.ForbiddenException.class),
                Map.entry(404, {{invokerPackage}}.errors.NotFoundException.class),
                Map.entry(409, {{invokerPackage}}.errors.ConflictException.class),
                Map.entry(422, {{invokerPackage}}.errors.UnprocessableEntityException.class),
                Map.entry(429, {{invokerPackage}}.errors.TooManyRequestsException.class),
                Map.entry(402, {{invokerPackage}}.errors.PaymentRequiredException.class),
                Map.entry(405, {{invokerPackage}}.errors.MethodNotAllowedException.class),
                Map.entry(408, {{invokerPackage}}.errors.RequestTimeoutException.class),
                Map.entry(410, {{invokerPackage}}.errors.GoneException.class),
                Map.entry(413, {{invokerPackage}}.errors.PayloadTooLargeException.class),
                Map.entry(415, {{invokerPackage}}.errors.UnsupportedMediaTypeException.class),
                Map.entry(423, {{invokerPackage}}.errors.LockedException.class),
                Map.entry(501, {{invokerPackage}}.errors.NotImplementedException.class),
                Map.entry(502, {{invokerPackage}}.errors.BadGatewayException.class),
                Map.entry(503, {{invokerPackage}}.errors.ServiceUnavailableException.class),
                Map.entry(504, {{invokerPackage}}.errors.GatewayTimeoutException.class),
                Map.entry(418, {{invokerPackage}}.errors.ClientException.class),
                Map.entry(500, {{invokerPackage}}.errors.InternalServerErrorException.class),
                Map.entry(599, {{invokerPackage}}.errors.ServerException.class),
                Map.entry(302, ApiException.class),
                Map.entry(600, ApiException.class));
        for (Map.Entry<Integer, Class<? extends ApiException>> entry : expected.entrySet()) {
            ApiException ex = ApiException.fromResponse(
                    entry.getKey(), Map.of("x-request-id", "abc"), "{\"code\":\"denied\"}");

            assertEquals(entry.getValue(), ex.getClass());
            assertEquals(entry.getKey(), ex.getStatusCode());
            assertEquals("abc",
                    Objects.requireNonNull(ex.getResponseHeaders()).get("x-request-id"));
            assertEquals("{\"code\":\"denied\"}", ex.getResponseBody());
            assertEquals(Map.of("code", "denied"), ex.getErrorBody());
        }
    }

    @Test
    void bhvErrors009FromResponseRefusesADeeplyNestedBodyButKeepsTheRawBody() {
        // A nesting-depth cap stops a hostile error payload from recursing
        // through the call stack: the structured error body is dropped, the
        // exception for the status and the raw body are kept.
        int depth = ObjectSerializer.MAX_JSON_DEPTH + 1;
        String nested = "[".repeat(depth) + "]".repeat(depth);

        ApiException ex = ApiException.fromResponse(500, Map.of(), nested);

        assertEquals({{invokerPackage}}.errors.InternalServerErrorException.class, ex.getClass());
        assertEquals(nested, ex.getResponseBody());
        assertNull(ex.getErrorBody());
    }

