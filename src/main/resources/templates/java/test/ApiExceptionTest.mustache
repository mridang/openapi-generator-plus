    @Test
    void bhvErrors046TheErrorFactoryOfAnOperationIsChosenByExactStatusThenRangeThenDefault() {
        Map<String, {{invokerPackage}}.errors.ErrorFactory> factories = Map.of(
                "404", (m, p, s, h, b) -> new ApiException(s, "exact", h, b),
                "4XX", (m, p, s, h, b) -> new ApiException(s, "range", h, b),
                "default", (m, p, s, h, b) -> new ApiException(s, "default", h, b));

        assertEquals("exact", ApiException.fromResponse("GET", "/x", 404, Map.of(), "{}", factories).getMessage());
        assertEquals("range", ApiException.fromResponse("GET", "/x", 418, Map.of(), "{}", factories).getMessage());
        assertEquals("default", ApiException.fromResponse("GET", "/x", 502, Map.of(), "{}", factories).getMessage());
