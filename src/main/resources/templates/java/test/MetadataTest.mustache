    @Test
    void bhvLangjava030TestToBuilderCopiesWithOnePropertyChanged() {
        java.time.OffsetDateTime first = java.time.OffsetDateTime.parse("2024-01-01T00:00:00Z");
        java.time.OffsetDateTime second = java.time.OffsetDateTime.parse("2025-02-03T04:05:06Z");
        Metadata original =
                Metadata.builder()
                        .createdAt(first)
                        .putAdditionalProperty("customField", "hello")
                        .build();

        Metadata copy = original.toBuilder().createdAt(second).build();

        assertThat(original.createdAt).isEqualTo(first);
        assertThat(copy.createdAt).isEqualTo(second);
        assertThat(copy.getAdditionalProperties()).containsEntry("customField", "hello");
        assertThat(original.toBuilder().build()).isEqualTo(original);
    }

