    @Test
    void bhvModels006FileHeaderPrintsTheDescriptionWithoutEscapedQuotes() throws IOException {
        java.util.List<Path> sources;
        try (java.util.stream.Stream<Path> walk = Files.walk(Path.of("src"))) {
            sources = walk.filter(Files::isRegularFile)
                    .filter(f -> f.toString().endsWith(".java"))
                    .collect(java.util.stream.Collectors.toList());
        }
        java.util.List<java.util.List<String>> headers = new java.util.ArrayList<>();
        for (Path source : sources) {
            try (java.util.stream.Stream<String> lines = Files.lines(source)) {
                java.util.List<String> head = lines.limit(3).collect(java.util.stream.Collectors.toList());
                if (!head.isEmpty() && head.get(0).startsWith("// ")) {
                    headers.add(head);
                }
            }
        }
        assertThat(headers).as("generated sources must start with the header comment").isNotEmpty();
        for (java.util.List<String> header : headers) {
            for (String line : header) {
                assertThat(line).as("header line must not contain a backslash-escaped quote")
                        .doesNotContain("\\\"");
            }
        }
    }

    @Test
    void bhvSerializationObject227ModelExternalDocsDescriptionIsWrittenVerbatim() throws IOException {
        java.util.List<Path> found;
        try (java.util.stream.Stream<Path> walk = Files.walk(Path.of("src/main"))) {
            found = walk.filter(f -> f.getFileName().toString().equals("Account.java"))
                    .collect(java.util.stream.Collectors.toList());
        }
        assertThat(found).hasSize(1);
        String source = Files.readString(found.get(0));
        assertThat(source).contains("\"notes\" it's here");
        assertThat(source).doesNotContainPattern("&(lt|gt|quot|#)");
    }

    @Test
    void bhvModels002TestPomManifestDeclaresNonEmptyDescription() throws IOException {
        {{! manifest-description-missing: the published Maven POM must carry a }}
        {{! non-empty <description> (wired from the spec's appDescription, with }}
        {{! a generated fallback). Surefire runs tests with the project root as }}
        {{! the working directory. }}
        Path pom = Path.of("pom.xml");
        assertThat(Files.exists(pom)).as("pom.xml must exist at the project root").isTrue();
        String contents = Files.readString(pom);
        Matcher matcher = Pattern.compile("<description>(.*?)</description>").matcher(contents);
        assertThat(matcher.find()).as("pom.xml must declare a <description>").isTrue();
        assertThat(matcher.group(1).trim()).as("description must not be empty").isNotEmpty();
    }

    @Test
    void bhvLangjava036TestPomLicenseNameAndUrlComeFromTheSameLicense() throws IOException {
        {{! A literal MIT URL beside a configurable licenseId once mislabelled an }}
        {{! Apache-2.0 client; the name and the link are derived together. }}
        String contents = Files.readString(Path.of("pom.xml"));
        Matcher matcher =
                Pattern.compile("<license>\\s*<name>(.*?)</name>\\s*<url>(.*?)</url>")
                        .matcher(contents);
        assertThat(matcher.find()).as("pom.xml must declare a license name and url").isTrue();
        assertThat(matcher.group(1)).isEqualTo("{{licenseId}}");
        assertThat(matcher.group(2)).isEqualTo("{{licenseUrl}}");
    }

    @Test
    void bhvLangjava037TestDeclaredDevDependenciesAreInTheProjectManifest() throws IOException {
        {{! dev-dependency-drift: a generated test may import a package that only }}
        {{! the generator knows about, and every real client keep-lists its own }}
        {{! pom.xml, so the two silently drift apart and the suite dies at compile }}
        {{! time with an unresolved import. The generator-owned manifest lists what }}
        {{! the generated tests need; this fails first, naming the file. }}
        Path declared = Path.of(".openapi-generator", "DEV-DEPENDENCIES");
        assertThat(Files.exists(declared))
                .as(".openapi-generator/DEV-DEPENDENCIES must exist at the project root")
                .isTrue();
        String pomContents = Files.readString(Path.of("pom.xml"));
        for (String line : Files.readAllLines(declared)) {
            String entry = line.strip();
            if (entry.isEmpty()) {
                continue;
            }
            int space = entry.indexOf(' ');
            String coordinate = space < 0 ? entry : entry.substring(0, space);
            String artifactId = coordinate.substring(coordinate.indexOf(':') + 1);
            assertThat(pomContents)
                    .as(
                            "pom.xml does not declare %s, which"
                                    + " .openapi-generator/DEV-DEPENDENCIES lists as required by"
                                    + " the generated tests. Add it with <scope>test</scope>; the"
                                    + " generator cannot edit a keep-listed manifest.",
                            coordinate)
                    .contains("<artifactId>" + artifactId + "</artifactId>");
        }
    }

    @Test
    void bhvModels007TestModelDoesNotDocumentNullExample() throws IOException {
        {{! example-null-doc-pollution: when a property declares no example, the }}
        {{! codegen leaves CodegenProperty.example as the literal string "null", }}
        {{! which is truthy in Mustache. The model template guards the example }}
        {{! Javadoc with a section, so a real example still renders, but the bogus }}
        {{! "null" must never reach the generated source as a doc comment. Tag's }}
        {{! id and name properties carry no example, so Tag.java is the canary. }}
        {{! Surefire runs tests with the project root as the working directory. }}
        Path model =
                Path.of("src", "main", "java")
                        .resolve(Path.of("{{modelPackage}}".replace('.', '/')))
                        .resolve("Tag.java");
        assertThat(Files.exists(model))
                .as("the Tag model must be generated at %s", model)
                .isTrue();
        String source = Files.readString(model);
        assertThat(source)
                .as("a no-example property must not document a literal null example")
                .doesNotContain("Example: {@code null}")
                .doesNotContain("Example: null");
    }

