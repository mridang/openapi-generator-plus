class MetadataTest {

    private static final java.lang.reflect.Type METADATA_TYPE =
            new TypeReference<Metadata>() {}.getType();
    private final ObjectSerializer serializer = new ObjectSerializer();

    @Test
    void bhvModels008TestSerializeEmptyMetadata() {
        Metadata metadata = Metadata.builder().build();

        String json = serializer.serialize(metadata);

        assertThat(json).isNotNull();
    }

    @Test
    void bhvModels003TestDeserializeEmptyObject() {
        String json = "{}";

        Metadata metadata = serializer.deserialize(json, METADATA_TYPE);

        assertThat(metadata).isNotNull();
    }

    @Test
    void bhvModels004TestDeserializesAdditionalStringProperties() {
        String json = "{\"createdAt\":\"2024-01-01T00:00:00Z\",\"customField\":\"hello\"}";
        Metadata metadata = Objects.requireNonNull(serializer.deserialize(json, METADATA_TYPE));

        assertThat(metadata.getAdditionalProperties().get("customField")).isEqualTo("hello");
        java.util.Map<String, String> extras = metadata.getAdditionalProperties();
        assertThatThrownBy(() -> extras.put("other", "x"))
                .isInstanceOf(UnsupportedOperationException.class);
    }

    @Test
    void bhvModels001CapturesUndeclaredKeysIntoAdditionalProperties() {
        String json = "{\"createdAt\":\"2024-01-01T00:00:00Z\",\"undeclaredKey\":\"extra\"}";
        Metadata metadata = Objects.requireNonNull(serializer.deserialize(json, METADATA_TYPE));

        assertThat(metadata.getAdditionalProperties()).containsOnlyKeys("undeclaredKey");
        assertThat(metadata.getAdditionalProperties().get("undeclaredKey")).isEqualTo("extra");
    }

    @Test
    void bhvModels011TestRoundTripPreservesAdditionalProperties() {
        Metadata metadata =
                Metadata.builder()
                        .putAdditionalProperty("customField", "hello")
                        .putAdditionalProperty("anotherField", "world")
                        .build();

        String json = serializer.serialize(metadata);
        Metadata deserialized = Objects.requireNonNull(serializer.deserialize(json, METADATA_TYPE));

        assertThat(deserialized.getAdditionalProperties().get("customField")).isEqualTo("hello");
        assertThat(deserialized.getAdditionalProperties().get("anotherField")).isEqualTo("world");
    }

    @Test
    void bhvLangjava028TestAdditionalPropertiesAreWrittenThroughTheBuilderNotASetter() {
        assertThat(java.util.Arrays.stream(Metadata.class.getMethods()).map(java.lang.reflect.Method::getName))
                .doesNotContain("setAdditionalProperty");
        assertThat(java.util.Arrays.stream(Metadata.Builder.class.getMethods()).map(java.lang.reflect.Method::getName))
                .contains(
                        "additionalProperties",
                        "putAdditionalProperty",
                        "putAllAdditionalProperties",
                        "removeAdditionalProperty");
    }

    @Test
    void bhvLangjava029TestBuilderPutAllRemoveAndReplaceTheAdditionalProperties() {
        Metadata.Builder builder =
                Metadata.builder()
                        .putAllAdditionalProperties(java.util.Map.of("a", "1", "b", "2"))
                        .removeAdditionalProperty("a");

        assertThat(builder.build().getAdditionalProperties()).containsOnlyKeys("b");
        assertThat(builder.additionalProperties(java.util.Map.of("c", "3")).build().getAdditionalProperties())
                .containsOnlyKeys("c");
    }

    @Test
    void bhvModels023BuilderMethodsAreNotJsonProperties() {
        {{! The builder names its extra-property methods after JSON keys a payload may carry; with }}
        {{! the empty with-prefix they would otherwise read as properties and swallow the key. }}
        Metadata metadata =
                Objects.requireNonNull(
                        serializer.deserialize(
                                "{\"additionalProperties\":\"x\",\"removeAdditionalProperty\":\"y\"}",
                                METADATA_TYPE));

        assertThat(metadata.getAdditionalProperties())
                .containsEntry("additionalProperties", "x")
                .containsEntry("removeAdditionalProperty", "y");
    }

