package {{modelPackage}};

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import {{invokerPackage}}.ObjectSerializer;
import com.fasterxml.jackson.core.type.TypeReference;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Objects;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.junit.jupiter.api.Test;

class MetadataTest {

    private static final java.lang.reflect.Type METADATA_TYPE =
            new TypeReference<Metadata>() {}.getType();
    private final ObjectSerializer serializer = new ObjectSerializer();

    @Test
    void testSerializeEmptyMetadata() {
        Metadata metadata = Metadata.builder().build();

        String json = serializer.serialize(metadata);

        assertThat(json).isNotNull();
    }

    @Test
    void testDeserializeEmptyObject() {
        String json = "{}";

        Metadata metadata = serializer.deserialize(json, METADATA_TYPE);

        assertThat(metadata).isNotNull();
    }

    @Test
    void testDeserializesAdditionalStringProperties() {
        String json = "{\"createdAt\":\"2024-01-01T00:00:00Z\",\"customField\":\"hello\"}";
        Metadata metadata = Objects.requireNonNull(serializer.deserialize(json, METADATA_TYPE));

        assertThat(metadata.getAdditionalProperties().get("customField")).isEqualTo("hello");
        java.util.Map<String, Object> extras = metadata.getAdditionalProperties();
        assertThatThrownBy(() -> extras.put("other", "x"))
                .isInstanceOf(UnsupportedOperationException.class);
    }

    @Test
    void testRoundTripPreservesAdditionalProperties() {
        Metadata metadata =
                Metadata.builder()
                        .putAdditionalProperty("customField", "hello")
                        .putAdditionalProperty("anotherField", "world")
                        .build();

        String json = serializer.serialize(metadata);
        Metadata deserialized = Objects.requireNonNull(serializer.deserialize(json, METADATA_TYPE));

        assertThat(deserialized.getAdditionalProperties().get("customField")).isEqualTo("hello");
        assertThat(deserialized.getAdditionalProperties().get("anotherField")).isEqualTo("world");
    }

    @Test
    void testAdditionalPropertiesAreWrittenThroughTheBuilderNotASetter() {
        assertThat(java.util.Arrays.stream(Metadata.class.getMethods()).map(java.lang.reflect.Method::getName))
                .doesNotContain("setAdditionalProperty");
        assertThat(java.util.Arrays.stream(Metadata.Builder.class.getMethods()).map(java.lang.reflect.Method::getName))
                .contains(
                        "additionalProperties",
                        "putAdditionalProperty",
                        "putAllAdditionalProperties",
                        "removeAdditionalProperty");
    }

    @Test
    void testBuilderPutAllRemoveAndReplaceTheAdditionalProperties() {
        Metadata.Builder builder =
                Metadata.builder()
                        .putAllAdditionalProperties(java.util.Map.of("a", "1", "b", "2"))
                        .removeAdditionalProperty("a");

        assertThat(builder.build().getAdditionalProperties()).containsOnlyKeys("b");
        assertThat(builder.additionalProperties(java.util.Map.of("c", "3")).build().getAdditionalProperties())
                .containsOnlyKeys("c");
    }

    @Test
    void testBuilderMethodsAreNotJsonProperties() {
        {{! The builder names its extra-property methods after JSON keys a payload may carry; with }}
        {{! the empty with-prefix they would otherwise read as properties and swallow the key. }}
        Metadata metadata =
                Objects.requireNonNull(
                        serializer.deserialize(
                                "{\"additionalProperties\":\"x\",\"removeAdditionalProperty\":\"y\"}",
                                METADATA_TYPE));

        assertThat(metadata.getAdditionalProperties())
                .containsEntry("additionalProperties", "x")
                .containsEntry("removeAdditionalProperty", "y");
    }

    @Test
    void testAdditionalPropertiesAreTypedAsString() {
        Metadata metadata = Metadata.builder().putAdditionalProperty("key", "value").build();

        java.util.Map<String, Object> additionalProps = metadata.getAdditionalProperties();
        assertThat(additionalProps).containsEntry("key", "value");
    }

    @Test
    void testEqualsAndHashCodeIncludeAdditionalProperties() {
        Metadata first = Metadata.builder().putAdditionalProperty("customField", "hello").build();
        Metadata same = Metadata.builder().putAdditionalProperty("customField", "hello").build();
        Metadata differentValue =
                Metadata.builder().putAdditionalProperty("customField", "world").build();
        Metadata differentKey =
                Metadata.builder().putAdditionalProperty("otherField", "hello").build();

        assertThat(first).isEqualTo(same).hasSameHashCodeAs(same);
        assertThat(first).isNotEqualTo(differentValue).isNotEqualTo(differentKey);
        assertThat(first).isNotEqualTo(new Metadata());
    }

    @Test
    void testDeclaredPropertyWinsOverCollidingAdditionalProperty() {
        Metadata metadata =
                Metadata.builder()
                        .createdAt(java.time.OffsetDateTime.parse("2024-01-01T00:00:00Z"))
                        .putAdditionalProperty("createdAt", "x")
                        .build();

        String json = Objects.requireNonNull(serializer.serialize(metadata));

        assertThat(json).isEqualTo("{\"createdAt\":\"2024-01-01T00:00:00.000+00:00\"}");
    }

    @Test
    void testToStringDumpsTheAdditionalProperties() {
        Metadata metadata = Metadata.builder().putAdditionalProperty("customField", "hello").build();

        assertThat(metadata.toString())
                .isEqualTo("Metadata{createdAt=null, additionalProperties={customField=hello}}");
    }

    @Test
    void testModelFieldsAreFinal() throws NoSuchFieldException {
        assertThat(java.lang.reflect.Modifier.isFinal(Metadata.class.getField("createdAt").getModifiers()))
                .isTrue();
    }

    @Test
    void testToBuilderCopiesWithOnePropertyChanged() {
        java.time.OffsetDateTime first = java.time.OffsetDateTime.parse("2024-01-01T00:00:00Z");
        java.time.OffsetDateTime second = java.time.OffsetDateTime.parse("2025-02-03T04:05:06Z");
        Metadata original =
                Metadata.builder()
                        .createdAt(first)
                        .putAdditionalProperty("customField", "hello")
                        .build();

        Metadata copy = original.toBuilder().createdAt(second).build();

        assertThat(original.createdAt).isEqualTo(first);
        assertThat(copy.createdAt).isEqualTo(second);
        assertThat(copy.getAdditionalProperties()).containsEntry("customField", "hello");
        assertThat(original.toBuilder().build()).isEqualTo(original);
    }

    @Test
    void testBuilderDoesNotShareStateWithTheInstanceItBuilt() {
        Metadata.Builder builder = Metadata.builder().putAdditionalProperty("a", "1");
        Metadata built = builder.build();

        builder.putAdditionalProperty("b", "2");

        assertThat(built.getAdditionalProperties()).containsOnlyKeys("a");
    }

    @Test
    void testCollectionPropertyIsCopiedAndUnmodifiable() {
        java.util.Set<String> urls = new java.util.LinkedHashSet<>(java.util.Set.of("u"));
        Pet pet = new Pet("Rex", urls);

        urls.add("later");

        assertThat(pet.photoUrls).containsExactly("u");
        assertThatThrownBy(() -> pet.photoUrls.add("x"))
                .isInstanceOf(UnsupportedOperationException.class);
    }

    @Test
    void testBuilderRejectsAMissingRequiredProperty() {
        assertThatThrownBy(() -> Pet.builder().build())
                .isInstanceOf(NullPointerException.class)
                .hasMessage("name is required");
    }

    @Test
    void testToBuilderChangesOnePropertyAndKeepsTheOthers() {
        Pet original = Pet.builder().name("Rex").photoUrls(java.util.Set.of("u")).id(7L).build();

        Pet renamed = original.toBuilder().name("Max").build();

        assertThat(renamed.name).isEqualTo("Max");
        assertThat(renamed.id).isEqualTo(7L);
        assertThat(renamed.photoUrls).containsExactly("u");
        assertThat(original.name).isEqualTo("Rex");
    }

    @Test
    void testDefaultedPropertyKeepsItsDefaultUntilSet() {
        assertThat(Order.builder().build().status).isEqualTo(Order.StatusEnum.PLACED);
    }

    @Test
    void testPomManifestDeclaresNonEmptyDescription() throws IOException {
        {{! manifest-description-missing: the published Maven POM must carry a }}
        {{! non-empty <description> (wired from the spec's appDescription, with }}
        {{! a generated fallback). Surefire runs tests with the project root as }}
        {{! the working directory. }}
        Path pom = Path.of("pom.xml");
        assertThat(Files.exists(pom)).as("pom.xml must exist at the project root").isTrue();
        String contents = Files.readString(pom);
        Matcher matcher = Pattern.compile("<description>(.*?)</description>").matcher(contents);
        assertThat(matcher.find()).as("pom.xml must declare a <description>").isTrue();
        assertThat(matcher.group(1).trim()).as("description must not be empty").isNotEmpty();
    }

    @Test
    void testPomLicenseNameAndUrlComeFromTheSameLicense() throws IOException {
        {{! A literal MIT URL beside a configurable licenseId once mislabelled an }}
        {{! Apache-2.0 client; the name and the link are derived together. }}
        String contents = Files.readString(Path.of("pom.xml"));
        Matcher matcher =
                Pattern.compile("<license>\\s*<name>(.*?)</name>\\s*<url>(.*?)</url>")
                        .matcher(contents);
        assertThat(matcher.find()).as("pom.xml must declare a license name and url").isTrue();
        assertThat(matcher.group(1)).isEqualTo("{{licenseId}}");
        assertThat(matcher.group(2)).isEqualTo("{{licenseUrl}}");
    }

    @Test
    void testDeclaredDevDependenciesAreInTheProjectManifest() throws IOException {
        {{! dev-dependency-drift: a generated test may import a package that only }}
        {{! the generator knows about, and every real client keep-lists its own }}
        {{! pom.xml, so the two silently drift apart and the suite dies at compile }}
        {{! time with an unresolved import. The generator-owned manifest lists what }}
        {{! the generated tests need; this fails first, naming the file. }}
        Path declared = Path.of(".openapi-generator", "DEV-DEPENDENCIES");
        assertThat(Files.exists(declared))
                .as(".openapi-generator/DEV-DEPENDENCIES must exist at the project root")
                .isTrue();
        String pomContents = Files.readString(Path.of("pom.xml"));
        for (String line : Files.readAllLines(declared)) {
            String entry = line.strip();
            if (entry.isEmpty()) {
                continue;
            }
            int space = entry.indexOf(' ');
            String coordinate = space < 0 ? entry : entry.substring(0, space);
            String artifactId = coordinate.substring(coordinate.indexOf(':') + 1);
            assertThat(pomContents)
                    .as(
                            "pom.xml does not declare %s, which"
                                    + " .openapi-generator/DEV-DEPENDENCIES lists as required by"
                                    + " the generated tests. Add it with <scope>test</scope>; the"
                                    + " generator cannot edit a keep-listed manifest.",
                            coordinate)
                    .contains("<artifactId>" + artifactId + "</artifactId>");
        }
    }

    @Test
    void testModelDoesNotDocumentNullExample() throws IOException {
        {{! example-null-doc-pollution: when a property declares no example, the }}
        {{! codegen leaves CodegenProperty.example as the literal string "null", }}
        {{! which is truthy in Mustache. The model template guards the example }}
        {{! Javadoc with a section, so a real example still renders, but the bogus }}
        {{! "null" must never reach the generated source as a doc comment. Tag's }}
        {{! id and name properties carry no example, so Tag.java is the canary. }}
        {{! Surefire runs tests with the project root as the working directory. }}
        Path model =
                Path.of("src", "main", "java")
                        .resolve(Path.of("{{modelPackage}}".replace('.', '/')))
                        .resolve("Tag.java");
        assertThat(Files.exists(model))
                .as("the Tag model must be generated at %s", model)
                .isTrue();
        String source = Files.readString(model);
        assertThat(source)
                .as("a no-example property must not document a literal null example")
                .doesNotContain("Example: {@code null}")
                .doesNotContain("Example: null");
    }
}
