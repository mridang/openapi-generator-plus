    @Test
    void bhvModels005TestEqualsAndHashCodeIncludeAdditionalProperties() {
        Metadata first = Metadata.builder().putAdditionalProperty("customField", "hello").build();
        Metadata same = Metadata.builder().putAdditionalProperty("customField", "hello").build();
        Metadata differentValue =
                Metadata.builder().putAdditionalProperty("customField", "world").build();
        Metadata differentKey =
                Metadata.builder().putAdditionalProperty("otherField", "hello").build();

        assertThat(first).isEqualTo(same).hasSameHashCodeAs(same);
        assertThat(first).isNotEqualTo(differentValue).isNotEqualTo(differentKey);
        assertThat(first).isNotEqualTo(new Metadata());
    }

    @Test
    void bhvEquality001TestEqualValuesAreEqualAndAnyChangeMakesThemUnequal() {
        java.time.OffsetDateTime created = java.time.OffsetDateTime.parse("2024-01-01T00:00:00Z");
        Metadata first =
                Metadata.builder()
                        .createdAt(created)
                        .putAdditionalProperty("customField", "hello")
                        .build();
        Metadata same =
                Metadata.builder()
                        .createdAt(created)
                        .putAdditionalProperty("customField", "hello")
                        .build();
        Metadata changedNested =
                Metadata.builder()
                        .createdAt(created)
                        .putAdditionalProperty("customField", "world")
                        .build();
        Metadata changedCreatedAt =
                Metadata.builder()
                        .createdAt(java.time.OffsetDateTime.parse("2025-01-01T00:00:00Z"))
                        .putAdditionalProperty("customField", "hello")
                        .build();

        assertThat(first).isEqualTo(same).hasSameHashCodeAs(same);
        assertThat(first).isNotEqualTo(changedNested);
        assertThat(first).isNotEqualTo(changedCreatedAt);
        assertThat(first).isNotEqualTo("Metadata");
        assertThat(first).isNotEqualTo(null);
    }

    @Test
    void bhvModels010TestDeclaredPropertyWinsOverCollidingAdditionalProperty() {
        Metadata metadata =
                Metadata.builder()
                        .createdAt(java.time.OffsetDateTime.parse("2024-01-01T00:00:00Z"))
                        .putAdditionalProperty("createdAt", "x")
                        .build();

        String json = Objects.requireNonNull(serializer.serialize(metadata));

        assertThat(json).isEqualTo("{\"createdAt\":\"2024-01-01T00:00:00.000+00:00\"}");
    }

