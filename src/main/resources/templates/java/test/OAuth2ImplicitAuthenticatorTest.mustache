package {{invokerPackage}}.auth.oauth;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrowsExactly;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;

class OAuth2ImplicitAuthenticatorTest {

    private static OAuth2ImplicitAuthenticator createAuthenticator() {
        return new OAuth2ImplicitAuthenticator(
                "https://api.example.com",
                "my-client-id",
                "https://auth.example.com/authorize",
                List.of("read", "write"));
    }

    @Test
    void buildsAuthorizationUrlWithResponseTypeToken() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        String url = auth.buildAuthorizationUrl(null);

        assertTrue(url.startsWith("https://auth.example.com/authorize?"));
        assertTrue(url.contains("response_type=token"));
    }

    @Test
    void buildsAuthorizationUrlWithClientId() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        String url = auth.buildAuthorizationUrl(null);

        assertTrue(url.contains("client_id=my-client-id"));
    }

    @Test
    void buildsAuthorizationUrlWithScopes() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        String url = auth.buildAuthorizationUrl(null);

        assertTrue(url.contains("scope=read%20write"), url);
        assertFalse(url.contains("+"), url);
    }

    @Test
    void buildsAuthorizationUrlWithState() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        String url = auth.buildAuthorizationUrl("my-state");

        assertTrue(url.contains("state=my-state"));
    }

    @Test
    void keepsTheRfc3986UnreservedSetLiteralInTheAuthorizationUrl() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        String url = auth.buildAuthorizationUrl("s-._~*!'() x");

        assertTrue(url.endsWith("&state=s-._~%2A%21%27%28%29%20x"), url);
    }

    @ParameterizedTest
    @ValueSource(strings = {"abc\r\nInjected: yes", "abc\u0000def", "abc\u007Fdef", "tökén"})
    void setAccessTokenRejectsAControlOrNonAsciiCharacter(String token) {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        IllegalArgumentException ex = assertThrowsExactly(
                IllegalArgumentException.class, () -> auth.setAccessToken(token));

        assertEquals(
                "Access token must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                ex.getMessage());
        assertThrowsExactly(IllegalStateException.class, auth::getAuthHeaders);
    }

    @Test
    void schemeWrapperBuildsTheSpecAuthorizationUrl() {
        BrowserAuthImplicitAuthenticator auth =
                new BrowserAuthImplicitAuthenticator("https://api.example.com", "my-client-id");

        assertEquals(
                "https://auth.example.com/authorize?response_type=token"
                        + "&client_id=my-client-id&scope=read",
                auth.buildAuthorizationUrl(null));
    }

    @Test
    void setAccessTokenAcceptsTabAndPrintableAscii() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();
        auth.setAccessToken("a b\tc~");

        assertEquals("Bearer a b\tc~", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void getAuthHeadersReturnsBearerAfterSetAccessToken() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();
        auth.setAccessToken("implicit-tok");

        Map<String, String> headers = auth.getAuthHeaders();

        assertEquals("Bearer implicit-tok", headers.get("Authorization"));
    }

    @Test
    void throwsWhenAccessTokenNotSet() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        IllegalStateException ex = assertThrowsExactly(
                IllegalStateException.class, () -> auth.getAuthHeaders());
        assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains("Must set the access token before making API requests"));
    }

    @Test
    void getHostReturnsConfiguredHost() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();

        assertEquals("https://api.example.com", auth.getHost());
    }

    /**
     * The default {@code toString()} must mask the stored access token: once an
     * access token has been set, its value must be absent from the string and a
     * {@code ***} redaction marker present.
     */
    @Test
    @DisplayName("toString() redacts the access token and shows ***")
    void redactsSecret() {
        OAuth2ImplicitAuthenticator auth = createAuthenticator();
        auth.setAccessToken("implicit-tok");
        String repr = auth.toString();
        assertFalse(repr.contains("implicit-tok"));
        assertTrue(repr.contains("***"));
        assertEquals(
                "OAuth2ImplicitAuthenticator(host=https://api.example.com"
                        + ", clientId=my-client-id"
                        + ", authorizationUrl=https://auth.example.com/authorize"
                        + ", scopes=[read, write], accessToken=***)",
                repr);
    }

    @Test
    @DisplayName("the access token is volatile so a callback-thread write is visible to request threads")
    void accessTokenFieldIsVolatile() throws NoSuchFieldException {
        assertTrue(java.lang.reflect.Modifier.isVolatile(
                OAuth2ImplicitAuthenticator.class.getDeclaredField("accessToken").getModifiers()));
    }
}
