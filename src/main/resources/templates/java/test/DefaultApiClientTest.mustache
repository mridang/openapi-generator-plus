    @Nested
    @DisplayName("proxy with credentials")
    class ProxyWithCredentials {

        /*
         * Gap AK: java.net.http.HttpClient silently drops userinfo embedded
         * in the proxy URL. Without manual extraction the proxy 407s and
         * every request fails. We assert that the constructed client has
         * extracted `alice:s3cret` into a Basic Proxy-Authorization header.
         */
        @Test
        @DisplayName("proxy_with_credentials_injects_basic_authorization")
        void proxy_with_credentials_injects_basic_authorization() throws Exception {
            TransportOptions transport = TransportOptions.builder()
                    .proxy("http://alice:s3cret@127.0.0.1:3128")
                    .build();
            DefaultApiClient client = new DefaultApiClient(transport);

            java.lang.reflect.Field field = DefaultApiClient.class.getDeclaredField("proxyAuthHeader");
            field.setAccessible(true);
            String actual = (String) field.get(client);

            assertEquals("Basic YWxpY2U6czNjcmV0", actual);
        }

        /*
         * Gap AK — canonical fleet-wide scenario (AUDIT.md): a proxy URL of
         * http://user:pass@127.0.0.1:3128 must have its userinfo honoured, not
         * dropped. java.net.http.HttpClient silently discards the embedded
         * user:pass, so DefaultApiClient extracts it, base64-encodes it, and
         * carries it as a pre-built `Basic <b64>` value that is injected as
         * Proxy-Authorization on every request. Java is the SDK that was fixed
         * for AK; this asserts the credentials are now carried.
         */
        @Test
        @DisplayName("proxy_userinfo_carried_as_basic_proxy_authorization")
        void proxyUserInfoCarriedAsBasicProxyAuthorization() throws Exception {
            TransportOptions transport = TransportOptions.builder()
                    .proxy("http://user:pass@127.0.0.1:3128")
                    .build();
            DefaultApiClient client = new DefaultApiClient(transport);

            java.lang.reflect.Field field = DefaultApiClient.class.getDeclaredField("proxyAuthHeader");
            field.setAccessible(true);
            String actual = (String) field.get(client);

            // base64("user:pass") == "dXNlcjpwYXNz"
            assertEquals("Basic dXNlcjpwYXNz", actual,
                    "proxy credentials user:pass must be carried, not dropped");
        }
    }

