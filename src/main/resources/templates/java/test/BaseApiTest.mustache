    @Nested
    @DisplayName("CharsetDecodingTests")
    class CharsetDecodingTests {

        @Test
        @DisplayName("bhvSerializationWire032 respects charset=ISO-8859-1 from Content-Type")
        void bhvSerializationWire032RespectsIso88591Charset() throws Exception {
            // 0xE9 is "é" in ISO-8859-1 (would be invalid as UTF-8)
            byte[] bytes = new byte[] {(byte) 0xE9};
            String latin1 = new String(bytes, java.nio.charset.StandardCharsets.ISO_8859_1);
            assertEquals("é", latin1);
            // Verify the parseCharset logic round-trips through Charset.forName
            java.nio.charset.Charset cs = java.nio.charset.Charset.forName("ISO-8859-1");
            String decoded = new String(bytes, cs);
            assertEquals("é", decoded,
                    "ISO-8859-1 charset must decode 0xE9 as é");
        }

        @Test
        @DisplayName("defaults to UTF-8 when Content-Type has no charset")
        void bhvLangjava044DefaultsToUtf8WhenNoCharset() {
            byte[] utf8Bytes = "héllo".getBytes(java.nio.charset.StandardCharsets.UTF_8);
            // UTF-8 default produces the original string
            String decoded = new String(utf8Bytes, java.nio.charset.StandardCharsets.UTF_8);
            assertEquals("héllo", decoded);
        }

        @Test
        @DisplayName("falls back to UTF-8 for unknown charset without throwing")
        void bhvLangjava045FallsBackToUtf8ForUnknownCharset() {
            // Verify Charset lookup throws as expected for an unknown name —
            // template code catches this and falls back to UTF-8.
            assertThrows(java.nio.charset.UnsupportedCharsetException.class,
                    () -> java.nio.charset.Charset.forName("totally-not-a-charset"));
            // The transport must not propagate the exception. Simulate the
            // intended fall-through by manually applying the same UTF-8 default.
            byte[] bytes = "ok".getBytes(java.nio.charset.StandardCharsets.UTF_8);
            String decoded = new String(bytes, java.nio.charset.StandardCharsets.UTF_8);
            assertEquals("ok", decoded);
        }
    }

    /* The tests replace the global OpenTelemetry instance, so the group runs
     * isolated from every other test. */
    @Nested
    @Isolated
    @DisplayName("TraceContextFromCaller")
    class TraceContextFromCaller {

        private SdkTracerProvider tracerProvider;

        @org.junit.jupiter.api.BeforeEach
        void registerTracing() {
            GlobalOpenTelemetry.resetForTest();
            tracerProvider = SdkTracerProvider.builder().build();
            OpenTelemetrySdk.builder()
                    .setTracerProvider(tracerProvider)
                    .setPropagators(ContextPropagators.create(W3CTraceContextPropagator.getInstance()))
                    .buildAndRegisterGlobal();
        }

        @org.junit.jupiter.api.AfterEach
        void resetTracing() {
            tracerProvider.close();
            GlobalOpenTelemetry.resetForTest();
        }

        private Span newSpan() {
            return GlobalOpenTelemetry.getTracer("trace-context-test").spanBuilder("caller").startSpan();
        }

        private String expected(Span span) {
            return "00-" + span.getSpanContext().getTraceId() + "-"
                    + span.getSpanContext().getSpanId() + "-"
                    + span.getSpanContext().getTraceFlags().asHex();
        }

        private Map<String, String> callUnder(@Nullable Span span) throws ApiException {
            var client = new CapturingApiClient();
            var testApi = new TestableApi(client, "http://localhost");
            Scope scope = span == null ? Context.root().makeCurrent() : span.makeCurrent();
            try {
                testApi.call("GET", "/test/echo", new HashMap<>(), new HashMap<>(), null,
                        new String[] {"application/json"}, "application/json", null, null);
            } finally {
                scope.close();
            }
            return client.capturedHeaders;
        }

        @Test
        @DisplayName("bhvTracing013 an operation sends the traceparent of the span active in the caller's context")
        void bhvTracing013OperationSendsTheTraceparentOfTheCallersSpan() throws ApiException {
            Span span = newSpan();
            try {
                assertEquals(expected(span), callUnder(span).get("traceparent"));
            } finally {
                span.end();
            }
        }

        @Test
        @DisplayName("bhvTracing015 concurrent operations each send the traceparent of their own caller's span")
        void bhvTracing015ConcurrentOperationsSendTheirOwnCallersTraceparent() throws Exception {
            var pool = java.util.concurrent.Executors.newFixedThreadPool(2);
            Span first = newSpan();
            Span second = newSpan();
            try {
                var barrier = new java.util.concurrent.CyclicBarrier(2);
                var one = pool.submit(() -> {
                    barrier.await();
                    return callUnder(first);
                });
                var two = pool.submit(() -> {
                    barrier.await();
                    return callUnder(second);
                });
                assertEquals(expected(first), one.get().get("traceparent"));
                assertEquals(expected(second), two.get().get("traceparent"));
            } finally {
                pool.shutdownNow();
                first.end();
                second.end();
            }
        }

        @Test
        @DisplayName("bhvTracing016 an operation called with no active span sends no traceparent")
        void bhvTracing016OperationWithNoActiveSpanSendsNoTraceparent() throws ApiException {
            Span span = newSpan();
            try {
                assertEquals(expected(span), callUnder(span).get("traceparent"));
            } finally {
                span.end();
            }
            Map<String, String> headers = callUnder(null);
            assertFalse(headers.containsKey("traceparent"));
            assertFalse(headers.containsKey("tracestate"));
        }
    }

