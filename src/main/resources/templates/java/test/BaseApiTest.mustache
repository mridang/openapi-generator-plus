        @Test
        @DisplayName("bhvHooks014 finish gets the timeout error, never the cancellation error")
        void bhvHooks014FinishGetsTheTimeout() {
            var hook = new RecordingHook();
            var failure = new {{invokerPackage}}.errors.NetworkTimeoutException("slow", new java.io.IOException("x"));
            assertThrows(
                    {{invokerPackage}}.errors.NetworkTimeoutException.class,
                    () -> hookedCall(new FixedApiClient(failure), hook));

            assertSame(failure, hook.outcomes.get(0).error());
            assertFalse(hook.outcomes.get(0).error() instanceof java.util.concurrent.CancellationException);
        }

        @Test
        @DisplayName("bhvHooks015 finish gets the cancellation and the call rethrows it")
        void bhvHooks015FinishGetsTheCancellation() {
            var hook = new RecordingHook();
            var failure = new java.util.concurrent.CancellationException("interrupted");
            var caught = assertThrows(
                    java.util.concurrent.CancellationException.class,
                    () -> hookedCall(new FixedApiClient(failure), hook));

            assertSame(failure, caught);
            assertSame(failure, hook.outcomes.get(0).error());
            assertEquals(1, hook.outcomes.size());
        }

        @Test
        @DisplayName("bhvHooks016 finish gets the serialization error with the status that arrived")
        void bhvHooks016FinishGetsTheDecodeError() {
