                    null,
                    new String[] {"application/json"},
                    "application/json",
                    null, null);
            assertEquals("text/plain", client.capturedHeaders.get("Accept"),
                    "an explicit Accept header parameter must beat the config default and the negotiated Accept");
        }

        @Test
