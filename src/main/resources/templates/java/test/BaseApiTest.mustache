            query.put("a", "1");
            hookedCall(new CapturingApiClient(), hook, "http://localhost", "/items/7#x", query);
            hookedCall(new CapturingApiClient(), hook, "http://localhost", "/items/7", query);

            assertEquals("http://localhost/items/7", hook.infos.get(0).url());
