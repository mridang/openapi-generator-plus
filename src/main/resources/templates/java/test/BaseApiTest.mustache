        @Test
        @DisplayName("bhvHooks018 an error thrown by start reaches the caller, nothing is sent and finish is not called")
        void bhvHooks018AStartErrorPropagates() {
            var failure = new IllegalStateException("refused by the hook");
            var client = new FixedApiClient(200, "{}", JSON);
            CallHook hook = (info, headers) -> {
                throw failure;
            };
            var caught = assertThrows(IllegalStateException.class, () -> hookedCall(client, hook, "http://localhost", "/items/7", new HashMap<>()));

            assertSame(failure, caught);
            assertTrue(client.sentHeaders.isEmpty());
        }

        @Test
        @DisplayName("bhvHooks019 an error thrown by finish is swallowed")
        void bhvHooks019AFinishErrorIsSwallowed() {
            CallHook hook = (info, headers) -> outcome -> {
                throw new IllegalStateException("observer broke");
            };
            var ok = hookedCall(new FixedApiClient(200, "{}", JSON), hook, "http://localhost", "/items/7", new HashMap<>());
            assertEquals(200, ok.statusCode());

            assertThrows(
                    NotFoundException.class,
                    () -> hookedCall(new FixedApiClient(404, "{}", JSON), hook, "http://localhost", "/items/7", new HashMap<>()));
        }

        @Test
        @DisplayName("bhvHooks021 the url given to the hook never carries the query string or the fragment")
        void bhvHooks021TheUrlHasNoQueryOrFragment() {
