        @Test
        @DisplayName("bhvHooks013 finish gets status 0, null headers and the network error when no response arrived")
        void bhvHooks013FinishGetsTheNetworkError() {
            var hook = new RecordingHook();
            var failure = new {{invokerPackage}}.errors.NetworkException("refused", new java.io.IOException("x"));
            var caught = assertThrows(
                    {{invokerPackage}}.errors.NetworkException.class,
                    () -> hookedCall(new FixedApiClient(failure), hook));

            assertSame(failure, caught);
            assertEquals(0, hook.outcomes.get(0).statusCode());
            assertNull(hook.outcomes.get(0).headers());
            assertSame(failure, hook.outcomes.get(0).error());
