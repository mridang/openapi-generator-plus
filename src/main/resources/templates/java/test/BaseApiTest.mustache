                        new HashMap<>(), new HashMap<>(),
                        body,
                        new String[] {"application/json"},
                        contentType,
                        null, null);
    }

    @Nested
    @DisplayName("401 replay")
    class UnauthorizedReplay {

        @Test
        @DisplayName("bhvRetries001 a 401 drops the token and the request is replayed once with fresh headers")
        void bhvRetries001UnauthorizedReplaysOnceWithFreshHeaders() throws ApiException {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(true);
            callWith(client, auth, "{}", "application/json");
            assertEquals(2, client.sentHeaders.size());
            assertEquals("Bearer t1", client.sentHeaders.get(0).get("Authorization"));
            assertEquals("Bearer t2", client.sentHeaders.get(1).get("Authorization"));
            assertEquals(1, auth.invalidations);
        }

        @Test
        @DisplayName("bhvRetries008 a second 401 is reported as Unauthorized after exactly one replay")
        void bhvRetries008SecondUnauthorizedIsReported() {
            var client = new ScriptedApiClient(401);
            var auth = new RotatingTokenAuthenticator(true);
            assertThrowsExactly(
                    UnauthorizedException.class, () -> callWith(client, auth, "{}", "application/json"));
            assertEquals(2, client.sentHeaders.size());
        }

        @Test
        @DisplayName("a stream body is not replayed, but the token is still dropped")
        void bhvRetries045StreamBodyIsNotReplayed() {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(true);
            assertThrowsExactly(
                    UnauthorizedException.class,
                    () ->
                            callWith(
                                    client,
                                    auth,
                                    new java.io.ByteArrayInputStream(new byte[] {1, 2}),
                                    "application/octet-stream"));
            assertEquals(1, client.sentHeaders.size());
            assertEquals(1, auth.invalidations);
        }

        @Test
        @DisplayName("bhvRetries006 a multipart body is not replayed")
        void bhvRetries006MultipartBodyIsNotReplayed() {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(true);
            assertThrowsExactly(
                    UnauthorizedException.class,
                    () -> callWith(client, auth, Map.of("field", "value"), "multipart/form-data"));
            assertEquals(1, client.sentHeaders.size());
        }

        @Test
        @DisplayName("bhvAuthIntegration001 a failed re-authentication leaves the 401 as it is")
        void bhvAuthIntegration001FailedReauthenticationLeavesTheUnauthorizedResponse() {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(false);
            assertThrowsExactly(
                    UnauthorizedException.class, () -> callWith(client, auth, "{}", "application/json"));
            assertEquals(1, client.sentHeaders.size());
        }

        @Test
        @DisplayName("bhvRetries003 a multipart body is not retried")
        void bhvRetries003MultipartBodyIsNotRetried() {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(true);
            assertThrowsExactly(
                    UnauthorizedException.class,
                    () -> callWith(client, auth, Map.of("avatar", "bytes"), "multipart/form-data"));
            assertEquals(1, client.sentHeaders.size());
        }

        @Test
        @DisplayName("bhvRetries005 a retry asks the authenticator for the headers again")
        void bhvRetries005RetryAsksTheAuthenticatorForFreshHeaders() throws ApiException {
            var client = new ScriptedApiClient(401, 200);
            var auth = new RotatingTokenAuthenticator(true);
            callWith(client, auth, "{}", "application/json");
            assertEquals(2, client.sentHeaders.size());
            assertEquals("Bearer t2", client.sentHeaders.get(1).get("Authorization"));
            assertEquals(2, auth.token);
        }

        @Test
        @DisplayName("bhvRetries007 a status other than 401 is not replayed")
        void bhvRetries007OtherStatusesAreNotReplayed() {
            var client = new ScriptedApiClient(403, 200);
            var auth = new RotatingTokenAuthenticator(true);
            assertThrowsExactly(
                    ForbiddenException.class, () -> callWith(client, auth, "{}", "application/json"));
            assertEquals(1, client.sentHeaders.size());
            assertEquals(0, auth.invalidations);
        }

        @Test
        @DisplayName("bhvRetries002 a bearer authenticator never replays")
        void bhvRetries002BearerAuthenticatorNeverReplays() {
            var client = new ScriptedApiClient(401, 200);
            var auth = new BearerAuthenticator("http://localhost", "static-token");
            assertThrowsExactly(
                    UnauthorizedException.class, () -> callWith(client, auth, "{}", "application/json"));
            assertEquals(1, client.sentHeaders.size());
        }

        @Test
        @DisplayName("a request without an authenticator is not replayed on 401")
        void bhvRetries043NoAuthenticatorNeverReplays() {
            var client = new ScriptedApiClient(401, 200);
            assertThrowsExactly(
                    UnauthorizedException.class, () -> callWith(client, null, "{}", "application/json"));
            assertEquals(1, client.sentHeaders.size());
        }
    }

