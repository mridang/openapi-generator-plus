        @Test
        @DisplayName("bhvOptions001 config default header overrides operation-negotiated Accept")
        void bhvOptions001ConfigDefaultHeaderOverridesNegotiatedAccept() throws ApiException {
            // R5-1: a caller-supplied config default header must win over the
            // operation's content-negotiated Accept. Here the operation
            // negotiates Accept: application/json, but the config default sets
            // Accept: application/xml — the outgoing request must carry the
            // config default, not the negotiated value.
            var client = new CapturingApiClient();
            var config = new Configuration("http://localhost", Map.of("Accept", "application/xml"));
            var testApi = new TestableApi(client, config);
            testApi.call(
                    "GET", "/test/echo",
                    new HashMap<>(), new HashMap<>(),
                    null,
                    new String[] {"application/json"},
                    "application/json",
                    null, null);
            assertEquals("application/xml", client.capturedHeaders.get("Accept"),
                    "config default Accept must override the negotiated Accept");
        }

        @Test
        @DisplayName("bhvHeaders030 a default header in another case replaces the negotiated one instead of being sent beside it")
        void bhvHeaders030DefaultHeaderInAnotherCaseReplacesTheNegotiatedAccept() throws ApiException {
            var client = new CapturingApiClient();
            var config = new Configuration("http://localhost", Map.of("accept", "application/xml"));
            var testApi = new TestableApi(client, config);
            testApi.call(
                    "GET", "/test/echo",
                    new HashMap<>(), new HashMap<>(),
                    null,
                    new String[] {"application/json"},
                    "application/json",
                    null, null);
            List<String> accepts = client.capturedHeaders.keySet().stream()
                    .filter(name -> name.equalsIgnoreCase("accept"))
                    .toList();
            assertEquals(1, accepts.size(), "two spellings of Accept were sent: " + accepts);
            assertEquals("application/xml", client.capturedHeaders.get(accepts.get(0)));
        }

        @Test
        void bhvOperations008HeaderParamAcceptWinsOverTheConfigDefaultAndTheNegotiatedAccept() throws ApiException {
            var client = new CapturingApiClient();
            var config = new Configuration("http://localhost", Map.of("Accept", "application/xml"));
