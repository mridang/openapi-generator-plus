    /** Answers each request with the next scripted status and keeps a copy of what it was sent. */
    static class ScriptedApiClient implements ApiClient {
        final java.util.List<Map<String, String>> sentHeaders = new java.util.ArrayList<>();
        private final int[] statuses;

        ScriptedApiClient(int... statuses) {
            this.statuses = statuses;
        }

        @Override
        public ApiHttpResponse sendRequest(
                String method, String url, Map<String, String> headers, @Nullable Object body) {
            int index = Math.min(sentHeaders.size(), statuses.length - 1);
            sentHeaders.add(new HashMap<>(headers));
            return new ApiHttpResponse(
                    statuses[index], "{}", Map.of("Content-Type", "application/json"));
        }
    }

    /** A token authenticator whose invalidation moves it on to the next token. */
    static class RotatingTokenAuthenticator
            implements {{invokerPackage}}.auth.HttpAwareAuthenticator {

        int token = 1;
        int invalidations = 0;
        private final boolean rotates;

        RotatingTokenAuthenticator(boolean rotates) {
            this.rotates = rotates;
        }

        @Override
        public void setApiClient(ApiClient apiClient) {}

        @Override
        public void invalidateAccessToken() {
            invalidations++;
            if (rotates) {
                token++;
            }
        }

        @Override
        public String getHost() {
            return "";
        }

        @Override
        public Map<String, String> getAuthHeaders() {
            return Map.of("Authorization", "Bearer t" + token);
        }
    }

    private static void callWith(
            ApiClient client, @Nullable Authenticator auth, @Nullable Object body, String contentType)
            throws ApiException {
        new TestableApi(client, "http://localhost", auth)
