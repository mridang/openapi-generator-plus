    @Nested
    @DisplayName("per-call options")
    class PerCallOptions {

        /** A client that records the per-call overrides it is handed. */
        static class OverrideCapturingClient extends CapturingApiClient {
            @Nullable Integer capturedTimeout;
            @Nullable Integer capturedRetries;
            boolean overrideOverloadUsed;

            @Override
            public ApiHttpResponse sendRequest(
                    String method,
                    String url,
                    Map<String, String> headers,
                    @Nullable Object body,
                    @Nullable Integer timeoutMillis,
                    @Nullable Integer maxRetries) {
                this.overrideOverloadUsed = true;
                this.capturedTimeout = timeoutMillis;
                this.capturedRetries = maxRetries;
                return sendRequest(method, url, headers, body);
            }
        }

        private PetApi apiOver(ApiClient client) {
            return new PetApi(client, new Configuration("http://localhost", Map.of()));
        }

        @Test
        @DisplayName("bhvTransport002 the timeout reaches the transport for this call only")
        void bhvTransport002TimeoutReachesTheTransportForThisCallOnly() {
            var client = new OverrideCapturingClient();
            var api = apiOver(client);
            try {
                api.findPetsByStatus(new FindPetsByStatusOptions().timeout(1500));
            } catch (Exception ignored) {
                // Response deserialization may fail; we only care about what the transport saw
            }
            assertEquals(1500, client.capturedTimeout);
            client.overrideOverloadUsed = false;
            client.capturedTimeout = null;
            try {
                api.findPetsByStatus(new FindPetsByStatusOptions());
            } catch (Exception ignored) {
                // Response deserialization may fail; we only care about what the transport saw
            }
            assertFalse(client.overrideOverloadUsed);
            assertNull(client.capturedTimeout);
        }

        @Test
        @DisplayName("bhvRetries009 timeout and maxRetries reach the transport")
        void bhvRetries009TimeoutAndRetriesReachTheTransport() {
            var client = new OverrideCapturingClient();
            try {
                apiOver(client).findPetsByStatus(new FindPetsByStatusOptions().timeout(1500).maxRetries(0));
            } catch (Exception ignored) {
                // Response deserialization may fail; we only care about what the transport saw
            }
            assertTrue(client.overrideOverloadUsed);
            assertEquals(1500, client.capturedTimeout);
            assertEquals(0, client.capturedRetries);
        }

        @Test
        @DisplayName("without per-call settings the plain send is used")
        void bhvLangjava043WithoutPerCallSettingsThePlainSendIsUsed() {
            var client = new OverrideCapturingClient();
            try {
                apiOver(client).findPetsByStatus(new FindPetsByStatusOptions());
            } catch (Exception ignored) {
                // Response deserialization may fail; we only care about what the transport saw
            }
