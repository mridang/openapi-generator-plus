            JsonNode result =
                    configured.call(
                            "GET",
                            "/test/echo",
                            new HashMap<>(),
                            new HashMap<>(),
                            null,
                            new String[] {"application/json"},
                            "application/json",
                            JSON_NODE_TYPE,
