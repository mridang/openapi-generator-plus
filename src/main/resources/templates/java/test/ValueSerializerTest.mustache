    @Nested
    @DisplayName("path location")
    class PathTests {

        @Test
        @DisplayName("bhvSerializationParam062 null returns empty string")
        void bhvSerializationParam062NullReturnsEmptyString() {
            assertEquals("", ValueSerializer.serialize(null, "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam071 a content-encoded JSON value is segment-encoded once")
        void bhvSerializationParam071ContentEncodedJsonIsSegmentEncoded() {
            assertEquals(
                    "%7B%22k%22:%22v%22%7D",
                    ValueSerializer.encodePathSegment(
                            new {{invokerPackage}}.ObjectSerializer().serialize(java.util.Map.of("k", "v"))));
        }

        @Test
        @DisplayName("bhvSerializationParam029 a dot segment value is rejected")
        void bhvSerializationParam029DotSegmentValueIsRejected() {
            for (String dots : List.of(".", "..")) {
                IllegalArgumentException ex = assertThrows(IllegalArgumentException.class,
                        () -> ValueSerializer.serializeStyled(
                                "name", dots, "path", "string", null, "simple", false));
                assertEquals("Path parameter 'name' must not be '.' or '..'", ex.getMessage());
            }
        }

        @Test
        @DisplayName("bhvSerializationParam072 a value merely containing dots is kept")
        void bhvSerializationParam072ValueContainingDotsIsKept() {
            assertEquals("a..b", ValueSerializer.serializeStyled(
                    "name", "a..b", "path", "string", null, "simple", false));
            assertEquals(".hidden", ValueSerializer.serializeStyled(
                    "name", ".hidden", "path", "string", null, "simple", false));
        }

