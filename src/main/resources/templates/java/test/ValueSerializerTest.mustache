    @Nested
    @DisplayName("allowReserved query encoding")
    class AllowReservedTests {

        @Test
        @DisplayName("bhvSerializationParam080 reserved characters are left literal, other characters still encoded")
        void bhvSerializationParam080ReservedCharsPreserved() {
            assertEquals("v1.0/beta:rc1", ValueSerializer.encodeQueryAllowingReserved("v1.0/beta:rc1"));
            // Space is illegal in a URL and must still be percent-encoded even
            // when reserved characters are preserved.
            assertEquals("a%20b:c", ValueSerializer.encodeQueryAllowingReserved("a b:c"));
        }

        @Test
        @DisplayName("bhvSerializationParam002 allow reserved leaves reserved chars literal but still encodes others")
        void bhvSerializationParam002AllowReservedKeepsReservedCharsLiteral() {
            assertEquals("a:b/c%20d%23e", ValueSerializer.encodeQueryAllowingReserved("a:b/c d#e"));
        }

        @Test
        @DisplayName("bhvSerializationParam122 an allowReserved query value keeps its reserved characters literal on the wire")
        void bhvSerializationParam122AllowReservedQueryValueKeepsReservedCharsLiteral() {
            assertEquals("a:b/c?d=e&f", ValueSerializer.encodeQueryAllowingReserved("a:b/c?d=e&f"));
        }

        @Test
        @DisplayName("bhvSerializationParam003 allow reserved still percent encodes non ascii")
        void bhvSerializationParam003AllowReservedStillEncodesNonAscii() {
            assertEquals("%C3%A9/%C3%BC", ValueSerializer.encodeQueryAllowingReserved("é/ü"));
        }

        @Test
        @DisplayName("bhvSerializationParam068 only the RFC 3986 query-legal reserved set stays literal")
        void bhvSerializationParam068OnlyQueryLegalReservedCharsStayLiteral() {
            assertEquals(
                    "a:b/c?d%5Be%5Df@g!h$i&j'k(l)m*n+o,p;q=r~s%23t%20u",
                    ValueSerializer.encodeQueryAllowingReserved(
                            "a:b/c?d[e]f@g!h$i&j'k(l)m*n+o,p;q=r~s#t u"));
        }

        @Test
        @DisplayName("bhvSerializationParam060 maybeAllowReserved wraps only when allowReserved is true")
        void bhvSerializationParam060MaybeAllowReservedWraps() {
            assertEquals("plain", ValueSerializer.maybeAllowReserved("plain", false));
            ValueSerializer.AllowReservedValue wrapped = assertInstanceOf(
                    ValueSerializer.AllowReservedValue.class,
                    ValueSerializer.maybeAllowReserved("v1/beta", true));
            assertEquals("v1/beta", wrapped.value());
            assertNull(ValueSerializer.maybeAllowReserved(null, true));
        }
    }

