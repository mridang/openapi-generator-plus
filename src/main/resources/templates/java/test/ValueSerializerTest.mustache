    /**
     * Cross-language parity tests for path-segment percent-encoding.
     * Every SDK must produce identical encoded strings for these inputs.
     */
    @Nested
    @DisplayName("path encoding parity")
    class PathEncodingParityTests {

        @Test
        @DisplayName("bhvSerializationParam034 empty string preserved")
        void bhvSerializationParam034EmptyStringPreserved() {
            assertEquals("", ValueSerializer.serialize("", "path", "string", null));
            assertEquals("", ValueSerializer.serialize("", "query", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam016 ASCII-safe pass-through")
        void bhvSerializationParam016AsciiSafePassThrough() {
            assertEquals("abc123", ValueSerializer.serialize("abc123", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam092 space encoded as %20")
        void bhvSerializationParam092SpaceEncoded() {
            assertEquals("a%20b", ValueSerializer.serialize("a b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam091 slash encoded")
        void bhvSerializationParam091SlashEncoded() {
            assertEquals("a%2Fb", ValueSerializer.serialize("a/b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam079 question mark encoded")
        void bhvSerializationParam079QuestionMarkEncoded() {
            assertEquals("a%3Fb", ValueSerializer.serialize("a?b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam043 hash encoded")
        void bhvSerializationParam043HashEncoded() {
            assertEquals("a%23b", ValueSerializer.serialize("a#b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam081 semicolon preserved (sub-delimiter)")
        void bhvSerializationParam081SemicolonPreserved() {
            assertEquals("a;b", ValueSerializer.serialize("a;b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam026 comma preserved (sub-delimiter)")
        void bhvSerializationParam026CommaPreserved() {
            assertEquals("a,b", ValueSerializer.serialize("a,b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam025 colon preserved (sub-delimiter)")
        void bhvSerializationParam025ColonPreserved() {
            assertEquals("a:b", ValueSerializer.serialize("a:b", "path", "string", null));
        }

        @Test
        @DisplayName("equals preserved (sub-delimiter)")
        void bhvLangjava055EqualsPreserved() {
            assertEquals("x=y", ValueSerializer.serialize("x=y", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam103 unicode encoded as UTF-8 percent")
        void bhvSerializationParam103UnicodeEncoded() {
            assertEquals("%E6%97%A5%E6%9C%AC",
                ValueSerializer.serialize("日本", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam077 plus preserved (sub-delimiter)")
        void bhvSerializationParam077PlusPreserved() {
            assertEquals("a+b", ValueSerializer.serialize("a+b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam119 tilde preserved (RFC 3986 unreserved)")
        void bhvSerializationParam119TildeIsKeptLiteralInAPathValue() {
            // '~' is an RFC 3986 unreserved character and MUST NOT be
            // percent-encoded. URLEncoder emits %7E; the canonical encoding
            // (Node, C#, etc.) keeps a literal '~'.
            assertEquals("a~b", ValueSerializer.serialize("a~b", "path", "string", null));
            assertEquals("~", ValueSerializer.serialize("~", "path", "string", null));
        }

        @Test
        @DisplayName("tilde preserved in styled path array items")
        void bhvLangjava056TildePreservedInStyledArray() {
            assertEquals("a~b,c~d",
                ValueSerializer.serializeStyled("ids", Arrays.asList("a~b", "c~d"),
                    "path", "array", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam004 already-percent-encoded is re-encoded (literal %)")
        void bhvSerializationParam004AlreadyEncodedReencoded() {
            // Inputs are treated as raw literals; the '%' is itself encoded.
            assertEquals("a%2520b", ValueSerializer.serialize("a%20b", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam059 matrix style with reserved char in value")
        void bhvSerializationParam059MatrixStyleEncodesValue() {
            assertEquals(";id=a%20b",
                ValueSerializer.serializeStyled("id", "a b", "path", "string", null, "matrix", false));
        }

        @Test
        @DisplayName("bhvSerializationParam088 simple style array with reserved chars")
        void bhvSerializationParam088SimpleStyleArrayEncodesEachItem() {
            assertEquals("a%20b,c%3Fd",
                ValueSerializer.serializeStyled("ids", Arrays.asList("a b", "c?d"),
                    "path", "array", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam069 path_array_item_with_reserved_char_is_percent_encoded")
        void bhvSerializationParam069PathArrayItemWithReservedCharIsPercentEncoded() {
            // Gap W1 regression: every per-item path value in a styled array
            // must be percent-encoded BEFORE being joined with the structural
            // separator. Otherwise '/', '?', '#', space leak into the URL.
            List<String> items = Arrays.asList("a/b", "c");
            assertEquals("a%2Fb,c",
                ValueSerializer.serializeStyled("name", items, "path", "array", null, "simple", false));
            assertEquals(".a%2Fb.c",
                ValueSerializer.serializeStyled("name", items, "path", "array", null, "label", true));
            assertEquals(";name=a%2Fb,c",
                ValueSerializer.serializeStyled("name", items, "path", "array", null, "matrix", false));
        }

        @Test
        @DisplayName("bhvSerializationParam070 empty string returns empty string")
        void bhvSerializationParam070EmptyStringReturnsEmpty() {
            assertEquals("", ValueSerializer.serialize("", "path", "string", null));
        }

        @Test
        @DisplayName("bhvSerializationParam066 null returns empty string in path location")
        void bhvSerializationParam066NullReturnsEmptyInPath() {
            assertEquals("", ValueSerializer.serialize(null, "path", "string", null));
        }
    }

