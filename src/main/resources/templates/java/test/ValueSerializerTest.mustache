    @Nested
    @DisplayName("simple style backward compatibility")
    class SimpleStyleTests {

        @Test
        @DisplayName("bhvSerializationParam086 scalar returns stringified value")
        void bhvSerializationParam086ScalarReturnsStringifiedValue() {
            assertEquals("5", ValueSerializer.serializeStyled("id", "5", "path", "string", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam084 array joins with comma")
        void bhvSerializationParam084ArrayJoinsWithComma() {
            assertEquals("3,4,5", ValueSerializer.serializeStyled("id", Arrays.asList("3", "4", "5"), "path", "array", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam085 null returns empty string")
        void bhvSerializationParam085NullReturnsEmptyString() {
            assertEquals("", ValueSerializer.serializeStyled("id", null, "path", "string", null, "simple", true));
        }

        @Test
        @DisplayName("bhvSerializationParam089 simple style encodes value")
        void bhvSerializationParam089SimpleStyleEncodesValue() {
            assertEquals("x%20y%2Fz", ValueSerializer.serializeStyled("name", "x y/z", "path", "string", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam087 scalar URL-encodes path value")
        void bhvSerializationParam087ScalarUrlEncodesPath() {
            // Path-location values are percent-encoded so reserved chars don't break the URL.
            assertEquals("hello%20world", ValueSerializer.serializeStyled("id", "hello world", "path", "string", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam033 empty string path param throws IllegalArgumentException")
        void bhvSerializationParam033EmptyStringPathParamThrows() {
            // Empty-string path values silently produce malformed URLs like
            // `/resource//details`; reject at serialization time so callers see
            // the real error rather than a downstream 404.
            assertThrows(
                    IllegalArgumentException.class,
                    () -> ValueSerializer.serializeStyled("id", "", "path", "string", null, "simple", false));
        }

        @Test
        @DisplayName("bhvSerializationParam073 path value is encoded exactly once (no double-encoding)")
        void bhvSerializationParam073PathValueEncodedExactlyOnce() {
            // path-double-encoding: serializeStyled already percent-encodes the
            // path segment, so the api template must NOT wrap it again. A space
            // must become %20 (never %2520) and a slash %2F (never %252F).
            String space = String.valueOf(ValueSerializer.serializeStyled("id", "a b", "path", "string", null, "simple", false));
            assertEquals("a%20b", space);
            assertFalse(space.contains("%2520"));
            String slash = String.valueOf(ValueSerializer.serializeStyled("id", "a/b", "path", "string", null, "simple", false));
            assertEquals("a%2Fb", slash);
            assertFalse(slash.contains("%252F"));
        }
    }

