    @Nested
    @DisplayName("object-valued styled parameters")
    class ObjectValuedTests {

        private Map<String, Object> fields() {
            Map<String, Object> fields = new java.util.LinkedHashMap<>();
            fields.put("breed", "lab");
            fields.put("min_age", 3);
            return fields;
        }

        @Test
        @DisplayName("bhvSerializationParam039 form without explode joins keys and values with commas")
        void bhvSerializationParam039FormWithoutExplodeJoinsKeysAndValues() {
            assertEquals("breed,lab,min_age,3",
                    ValueSerializer.serializeStyled("c", fields(), "query", "object", null, "form", false));
        }

        @Test
        @DisplayName("bhvSerializationParam036 form with explode spreads one query entry per field in declaration order")
        void bhvSerializationParam036FormWithExplodeSpreadsFields() {
            Map<String, Object> query = new java.util.LinkedHashMap<>();
            ValueSerializer.putQuery(query, "c",
                    ValueSerializer.serializeStyled("c", fields(), "query", "object", null, "form", true), false);
            assertEquals(List.of("breed", "min_age"), List.copyOf(query.keySet()));
            assertEquals("3", query.get("min_age"));
        }

        @Test
        @DisplayName("matrix, label and simple styles expand per the explode flag")
        void bhvSerialization015PathStylesExpand() {
            assertEquals(";c=breed,lab,min_age,3",
                    ValueSerializer.serializeStyled("c", fields(), "path", "object", null, "matrix", false));
            assertEquals(";breed=lab;min_age=3",
                    ValueSerializer.serializeStyled("c", fields(), "path", "object", null, "matrix", true));
            assertEquals(".breed=lab.min_age=3",
                    ValueSerializer.serializeStyled("c", fields(), "path", "object", null, "label", true));
            assertEquals("breed=lab,min_age=3",
                    ValueSerializer.serializeStyled("c", fields(), "header", "object", null, "simple", true));
        }

        @Test
        @DisplayName("bhvSerializationParam108 a nested object leaf in a styled parameter is rejected with a serialization error")
        void bhvSerializationParam108NestedObjectLeafIsASerializationError() {
            Map<String, Object> nested = new java.util.LinkedHashMap<>();
            nested.put("inner", Map.of("a", "b"));
            assertThrows(SerializationException.class,
                    () -> ValueSerializer.serializeStyled("c", nested, "query", "object", null, "form", false));
        }
    }

