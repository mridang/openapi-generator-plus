package {{invokerPackage}};

import static org.junit.jupiter.api.Assertions.*;

import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;

class ValueSerializerTest {

    @Nested
    @DisplayName("path location")
    class PathTests {

        @Test
        @DisplayName("null returns empty string")
        void nullReturnsEmptyString() {
            assertEquals("", ValueSerializer.serialize(null, "path", "string", null));
        }

        @Test
        @DisplayName("string returns URL-encoded value")
        void stringReturnsUrlEncodedValue() {
            assertEquals("hello", ValueSerializer.serialize("hello", "path", "string", null));
        }

        @Test
        @DisplayName("string with spaces is URL-encoded")
        void stringWithSpacesIsUrlEncoded() {
            assertEquals("hello%20world", ValueSerializer.serialize("hello world", "path", "string", null));
        }

        @Test
        @DisplayName("string with slash is URL-encoded")
        void stringWithSlashIsUrlEncoded() {
            assertEquals("a%2Fb", ValueSerializer.serialize("a/b", "path", "string", null));
        }

        @Test
        @DisplayName("integer returns string")
        void integerReturnsString() {
            assertEquals("42", ValueSerializer.serialize(42, "path", "integer", null));
        }

        @Test
        @DisplayName("boolean true returns true")
        void booleanTrueReturnsTrue() {
            assertEquals("true", ValueSerializer.serialize(true, "path", "boolean", null));
        }

        @Test
        @DisplayName("boolean false returns false")
        void booleanFalseReturnsFalse() {
            assertEquals("false", ValueSerializer.serialize(false, "path", "boolean", null));
        }
    }

    @Nested
    @DisplayName("query location")
    class QueryTests {

        @Test
        @DisplayName("null returns null")
        void nullReturnsNull() {
            assertNull(ValueSerializer.serialize(null, "query", "string", null));
        }

        @Test
        @DisplayName("string returns as-is")
        void stringReturnsAsIs() {
            assertEquals("hello", ValueSerializer.serialize("hello", "query", "string", null));
        }

        @Test
        @DisplayName("integer returns string")
        void integerReturnsString() {
            assertEquals("42", ValueSerializer.serialize(42, "query", "integer", null));
        }

        @Test
        @DisplayName("boolean true returns true")
        void booleanTrueReturnsTrue() {
            assertEquals("true", ValueSerializer.serialize(true, "query", "boolean", null));
        }

        @Test
        @DisplayName("boolean false returns false")
        void booleanFalseReturnsFalse() {
            assertEquals("false", ValueSerializer.serialize(false, "query", "boolean", null));
        }

        @Test
        @DisplayName("array joins with comma by default")
        void arrayJoinsWithCommaByDefault() {
            assertEquals("a,b,c", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", null));
        }

        @Test
        @DisplayName("array joins with comma for csv")
        void arrayJoinsWithCommaForCsv() {
            assertEquals("a,b,c", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", "csv"));
        }

        @Test
        @DisplayName("array joins with space for ssv")
        void arrayJoinsWithSpaceForSsv() {
            assertEquals("a b c", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", "ssv"));
        }

        @Test
        @DisplayName("array joins with tab for tsv")
        void arrayJoinsWithTabForTsv() {
            assertEquals("a\tb\tc", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", "tsv"));
        }

        @Test
        @DisplayName("array joins with pipe for pipes")
        void arrayJoinsWithPipeForPipes() {
            assertEquals("a|b|c", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", "pipes"));
        }

        @Test
        @DisplayName("array returns list for multi")
        void arrayReturnsListForMulti() {
            List<String> expected = Arrays.asList("a", "b", "c");
            assertEquals(expected, ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "query", "array", "multi"));
        }

        @Test
        @DisplayName("empty array returns empty string for csv")
        void emptyArrayReturnsEmptyStringForCsv() {
            assertEquals("", ValueSerializer.serialize(Collections.emptyList(), "query", "array", null));
        }

        @Test
        @DisplayName("empty array returns empty list for multi")
        void emptyArrayReturnsEmptyListForMulti() {
            assertEquals(Collections.emptyList(), ValueSerializer.serialize(Collections.emptyList(), "query", "array", "multi"));
        }

        @Test
        @DisplayName("single-element array returns single value")
        void singleElementArrayReturnsSingleValue() {
            assertEquals("a", ValueSerializer.serialize(List.of("a"), "query", "array", null));
        }

        @Test
        @DisplayName("array of integers stringifies elements")
        void arrayOfIntegersStringifiesElements() {
            assertEquals("1,2,3", ValueSerializer.serialize(Arrays.asList(1, 2, 3), "query", "array", null));
        }

        @Test
        @DisplayName("array of booleans stringifies elements")
        void arrayOfBooleansStringifiesElements() {
            assertEquals("true,false", ValueSerializer.serialize(Arrays.asList(true, false), "query", "array", null));
        }
    }

    @Nested
    @DisplayName("header location")
    class HeaderTests {

        @Test
        @DisplayName("null returns empty string")
        void nullReturnsEmptyString() {
            assertEquals("", ValueSerializer.serialize(null, "header", "string", null));
        }

        @Test
        @DisplayName("string returns as-is")
        void stringReturnsAsIs() {
            assertEquals("hello", ValueSerializer.serialize("hello", "header", "string", null));
        }

        @Test
        @DisplayName("integer returns string")
        void integerReturnsString() {
            assertEquals("42", ValueSerializer.serialize(42, "header", "integer", null));
        }

        @Test
        @DisplayName("boolean true returns true")
        void booleanTrueReturnsTrue() {
            assertEquals("true", ValueSerializer.serialize(true, "header", "boolean", null));
        }

        @Test
        @DisplayName("array joins with comma")
        void arrayJoinsWithComma() {
            assertEquals("a,b,c", ValueSerializer.serialize(Arrays.asList("a", "b", "c"), "header", "array", null));
        }

        @Test
        @DisplayName("empty array joins to empty string")
        void emptyArrayJoinsToEmptyString() {
            assertEquals("", ValueSerializer.serialize(Collections.emptyList(), "header", "array", null));
        }

        @Test
        @DisplayName("array of integers stringifies and joins")
        void arrayOfIntegersStringifiesAndJoins() {
            assertEquals("1,2,3", ValueSerializer.serialize(Arrays.asList(1, 2, 3), "header", "array", null));
        }
    }

    @Nested
    @DisplayName("form location")
    class FormTests {

        @Test
        @DisplayName("null returns empty string")
        void nullReturnsEmptyString() {
            assertEquals("", ValueSerializer.serialize(null, "form", "string", null));
        }

        @Test
        @DisplayName("string returns as-is")
        void stringReturnsAsIs() {
            assertEquals("hello", ValueSerializer.serialize("hello", "form", "string", null));
        }

        @Test
        @DisplayName("integer returns string")
        void integerReturnsString() {
            assertEquals("42", ValueSerializer.serialize(42, "form", "integer", null));
        }

        @Test
        @DisplayName("boolean true returns true")
        void booleanTrueReturnsTrue() {
            assertEquals("true", ValueSerializer.serialize(true, "form", "boolean", null));
        }

        @Test
        @DisplayName("boolean false returns false")
        void booleanFalseReturnsFalse() {
            assertEquals("false", ValueSerializer.serialize(false, "form", "boolean", null));
        }
    }
}
