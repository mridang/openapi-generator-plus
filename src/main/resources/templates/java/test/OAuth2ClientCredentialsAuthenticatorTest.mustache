    @Test
    void bhvAuth054TokenEndpointErrorIsAnOAuth2ServerExceptionWithStatusAndBody() {
        ApiClient client = (method, url, headers, body) ->
                new ApiHttpResponse(401,
                        "{\"error\":\"invalid_client\",\"error_description\":\"bad secret\"}", Map.of());
        OAuth2ClientCredentialsAuthenticator auth = createAuthenticator();
        auth.setApiClient(client);

        OAuth2ServerException ex = assertThrowsExactly(OAuth2ServerException.class, auth::getAuthHeaders);
        assertEquals(401, ex.getStatusCode());
        assertEquals("invalid_client", ex.getCode());
        assertEquals("bad secret", ex.getDescription());
        assertTrue(ex.getRawBody().contains("invalid_client"), ex.getRawBody());
    }

    @Test
    void bhvAuth055TransportFailureReachesTheCallerUnchanged() {
        java.io.IOException reset = new java.io.IOException("connection reset");
        {{invokerPackage}}.errors.NetworkException failure =
                new {{invokerPackage}}.errors.NetworkException("connection reset", reset);
        ApiClient client = (method, url, headers, body) -> {
            throw failure;
        };
        OAuth2ClientCredentialsAuthenticator auth = createAuthenticator();
        auth.setApiClient(client);

        {{invokerPackage}}.errors.NetworkException thrown =
                assertThrowsExactly({{invokerPackage}}.errors.NetworkException.class, auth::getAuthHeaders);
        assertTrue(thrown == failure, "the same exception instance must reach the caller");
    }
