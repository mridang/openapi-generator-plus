    void bhvLangjava049DocumentsTheEnvironmentVariableOfEveryCredential() throws IOException {
        String skills = skills();
        String[] rows = {
{{#securitySchemeEnvVars}}
            "| `{{schemeId}}` | `{{field}}` | `{{envName}}` |",
{{/securitySchemeEnvVars}}
        };
        for (String row : rows) {
            assertTrue(skills.contains(row), "expected SKILLS.md to contain " + row);
        }
    }
