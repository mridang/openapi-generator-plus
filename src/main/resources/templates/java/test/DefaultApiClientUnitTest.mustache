class DefaultApiClientUnitTest {

  private static HttpServer server;
  private static String baseUrl;

  @BeforeAll
  static void startServer() throws IOException {
    server = HttpServer.create(new InetSocketAddress(0), 0);
    server.createContext(
        "/echo",
        exchange -> {
          byte[] requestBody = exchange.getRequestBody().readAllBytes();
          String responseJson =
              String.format(
                  "{\"method\":\"%s\",\"body\":\"%s\"}",
                  exchange.getRequestMethod(),
                  new String(requestBody, StandardCharsets.UTF_8).replace("\"", "\\\""));
          exchange.getResponseHeaders().add("X-Test-Header", "test-value");
          byte[] response = responseJson.getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    server.createContext(
        "/not-found",
        exchange -> {
          byte[] response = "not found".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(404, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    server.createContext(
        "/vendor-json",
        exchange -> {
          String json = "{\"format\":\"vendor\"}";
          exchange.getResponseHeaders().add("Content-Type", "application/vnd.api+json");
          byte[] response = json.getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    server.createContext(
        "/echo-headers",
        exchange -> {
          StringBuilder json = new StringBuilder("{");
          boolean first = true;
          for (Map.Entry<String, List<String>> entry : exchange.getRequestHeaders().entrySet()) {
            if (!first) {
              json.append(",");
            }
            first = false;
            String key = entry.getKey().toLowerCase(java.util.Locale.ROOT);
            String value = String.join(", ", entry.getValue()).replace("\"", "\\\"");
            json.append("\"").append(key).append("\":\"").append(value).append("\"");
          }
          json.append("}");
          byte[] response = json.toString().getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    server.createContext(
        "/set-cookie",
        exchange -> {
          exchange.getResponseHeaders().add("Set-Cookie", "sid=abc; Path=/");
          byte[] response = "{}".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    server.createContext(
        "/redirect-307",
        exchange -> {
          // Self-loop 307: replays method + body
          exchange.getResponseHeaders().add("Location", "/echo-headers");
          exchange.sendResponseHeaders(307, -1);
          exchange.close();
        });
    server.createContext(
        "/redirect-308",
        exchange -> {
          exchange.getResponseHeaders().add("Location", "/echo-headers");
          exchange.sendResponseHeaders(308, -1);
          exchange.close();
        });
    server.createContext(
        "/redirect-bad-scheme",
        exchange -> {
          exchange.getResponseHeaders().add("Location", "file:///etc/passwd");
          exchange.sendResponseHeaders(302, -1);
          exchange.close();
        });
    server.createContext(
        "/redirect-no-location",
        exchange -> {
          byte[] body = "moved".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(302, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/redirect-query-only/item",
        exchange -> {
          String query = exchange.getRequestURI().getRawQuery();
          if (!"page=2".equals(query)) {
            exchange.getResponseHeaders().add("Location", "?page=2");
            exchange.sendResponseHeaders(302, -1);
            exchange.close();
            return;
          }
          byte[] body =
              (exchange.getRequestURI().getRawPath() + "?" + query)
                  .getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/stalled-body",
        exchange -> {
          // Headers promise 100 bytes, three arrive, then the server stalls.
          exchange.sendResponseHeaders(200, 100);
          OutputStream os = exchange.getResponseBody();
          os.write(new byte[] {1, 2, 3});
          os.flush();
          try {
            Thread.sleep(2500);
          } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
          }
          exchange.close();
        });
    server.createContext(
        "/redirect-status",
        exchange -> {
          String code = exchange.getRequestURI().getRawQuery();
          exchange.getRequestBody().readAllBytes();
          exchange.getResponseHeaders().add("Location", "/echo");
          exchange.sendResponseHeaders(Integer.parseInt(code), -1);
          exchange.close();
        });
    server.createContext(
        "/redirect-loop",
        exchange -> {
          exchange.getResponseHeaders().add("Location", "/redirect-loop");
          exchange.sendResponseHeaders(302, -1);
          exchange.close();
        });
    server.createContext(
        "/latin1",
        exchange -> {
          byte[] body = new byte[] {(byte) 0xE9}; // "é" in ISO-8859-1
          exchange.getResponseHeaders().add("Content-Type", "text/plain; charset=ISO-8859-1");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/utf8-default",
        exchange -> {
          byte[] body = "héllo".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Type", "text/plain");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/unknown-charset",
        exchange -> {
          byte[] body = "héllo".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Type", "text/plain; charset=not-a-real-charset");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/utf16-bom",
        exchange -> {
          // A big-endian byte-order mark (FE FF) makes the BOM-less body that follows it big-endian.
          byte[] body = new byte[] {(byte) 0xFE, (byte) 0xFF, 0x00, 0x44, 0x00, 0x6F, 0x00, 0x63};
          exchange.getResponseHeaders().add("Content-Type", "text/plain; charset=utf-16");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/utf16-no-bom",
        exchange -> {
          // RFC 2781: a UTF-16 body with NO byte-order mark defaults to
          // big-endian. "Doc" as BOM-less UTF-16BE is 00 44 00 6F 00 63.
          byte[] body = new byte[] {0x00, 0x44, 0x00, 0x6F, 0x00, 0x63};
          exchange.getResponseHeaders().add("Content-Type", "text/plain; charset=utf-16");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/utf16-le-bom",
        exchange -> {
          // A little-endian byte-order mark (FF FE) makes the BOM-less body that follows it little-endian.
          byte[] body = new byte[] {(byte) 0xFF, (byte) 0xFE, 0x44, 0x00, 0x6F, 0x00, 0x63, 0x00};
          exchange.getResponseHeaders().add("Content-Type", "text/plain; charset=utf-16");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-lie",
        exchange -> {
          // Gap AL: the server claims gzip but sends plain (non-gzip) bytes.
          byte[] body = "this is not gzip".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Encoding", "gzip");
          exchange.getResponseHeaders().add("Content-Type", "text/plain");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-unknown",
        exchange -> {
          // A server advertising an encoding the client cannot decode.
          byte[] body = "payload".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Encoding", "made-up-codec");
          exchange.getResponseHeaders().add("Content-Type", "text/plain");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/zstd-streaming",
        exchange -> {
          // A streaming encoder omits the frame content size, and this body
          // compresses far better than 4:1, which a size-guessing one-shot
          // decoder cannot hold.
          java.io.ByteArrayOutputStream compressed = new java.io.ByteArrayOutputStream();
          try (com.github.luben.zstd.ZstdOutputStream zstd =
              new com.github.luben.zstd.ZstdOutputStream(compressed)) {
            zstd.write("a".repeat(200_000).getBytes(StandardCharsets.UTF_8));
          }
          byte[] body = compressed.toByteArray();
          exchange.getResponseHeaders().add("Content-Encoding", "zstd");
          exchange.getResponseHeaders().add("Content-Type", "text/plain");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-identity",
        exchange -> {
          // F1135: an identity-encoded body is the payload itself; the client
          // must hand it through undecoded and keep its encoding header.
          byte[] body = "{\"ok\":true}".getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Encoding", "identity");
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-empty-gzip",
        exchange -> {
          // Gap AL: a zero-byte body that still advertises `Content-Encoding:
          // gzip`. There is nothing to inflate, so the decompressor must pass
          // the empty payload straight through rather than raising on an empty
          // gzip stream.
          byte[] body = new byte[0];
          exchange.getResponseHeaders().add("Content-Encoding", "gzip");
          exchange.getResponseHeaders().add("Content-Type", "text/plain");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-deflate",
        exchange -> {
          // HTTP "deflate" is the zlib format (RFC 1950), not raw DEFLATE.
          java.io.ByteArrayOutputStream compressed = new java.io.ByteArrayOutputStream();
          try (java.util.zip.DeflaterOutputStream deflater =
              new java.util.zip.DeflaterOutputStream(compressed)) {
            deflater.write("{\"ok\":true}".getBytes(StandardCharsets.UTF_8));
          }
          byte[] body = compressed.toByteArray();
          exchange.getResponseHeaders().add("Content-Encoding", "deflate");
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-raw-deflate",
        exchange -> {
          // Headerless DEFLATE (RFC 1951) is not what "deflate" means in HTTP.
          java.util.zip.Deflater raw = new java.util.zip.Deflater(java.util.zip.Deflater.DEFAULT_COMPRESSION, true);
          java.io.ByteArrayOutputStream compressed = new java.io.ByteArrayOutputStream();
          try (java.util.zip.DeflaterOutputStream deflater =
              new java.util.zip.DeflaterOutputStream(compressed, raw)) {
            deflater.write("{\"ok\":true}".getBytes(StandardCharsets.UTF_8));
          } finally {
            raw.end();
          }
          byte[] body = compressed.toByteArray();
          exchange.getResponseHeaders().add("Content-Encoding", "deflate");
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/content-encoding-gzip",
        exchange -> {
          java.io.ByteArrayOutputStream compressed = new java.io.ByteArrayOutputStream();
          try (java.util.zip.GZIPOutputStream gzip =
              new java.util.zip.GZIPOutputStream(compressed)) {
            gzip.write("{\"ok\":true}".getBytes(StandardCharsets.UTF_8));
          }
          byte[] body = compressed.toByteArray();
          exchange.getResponseHeaders().add("Content-Encoding", "gzip");
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.createContext(
        "/repeated-header",
        exchange -> {
          exchange.getResponseHeaders().add("X-Repeated", "first");
          exchange.getResponseHeaders().add("X-Repeated", "second");
          exchange.getResponseHeaders().add("X-Repeated", "third");
          byte[] response = "ok".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });

    server.createContext(
        "/redirect-bad-location",
        exchange -> {
          // A Location that does not parse as a URI: the 3xx is returned as it is.
          exchange.getResponseHeaders().add("Location", "http://[::1");
          exchange.sendResponseHeaders(302, -1);
          exchange.close();
        });
    server.createContext(
        "/truncated-body",
        exchange -> {
          // Declares 100 bytes, sends 9 and closes, so reading the body fails.
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, 100);
          exchange.getResponseBody().write("{\"partial\"".getBytes(StandardCharsets.UTF_8));
          exchange.close();
        });
    // A handler that stalls (/stalled-body) must not hold up the other requests.
    server.setExecutor(
        java.util.concurrent.Executors.newCachedThreadPool(
            task -> {
              Thread thread = new Thread(task);
              thread.setDaemon(true);
              return thread;
            }));
    server.start();
    baseUrl = "http://localhost:" + server.getAddress().getPort();
  }

  @AfterAll
  static void stopServer() {
    server.stop(0);
  }

  /** Forwards every call to a real client and records the requests it was asked to send. */
  private static final class RecordingHttpClient extends java.net.http.HttpClient {
    private final java.net.http.HttpClient delegate = java.net.http.HttpClient.newHttpClient();
    private final List<java.net.http.HttpRequest> requests =
        new java.util.concurrent.CopyOnWriteArrayList<>();

    /** When set, answers every send with this response instead of reaching the network. */
    @javax.annotation.Nullable private java.net.http.HttpResponse<byte[]> scripted;

    /** When set, answers each send with this function of the request instead of the network. */
    @javax.annotation.Nullable
    private java.util.function.Function<java.net.http.HttpRequest, java.net.http.HttpResponse<byte[]>>
        responder;

    @Override
    public java.util.Optional<java.net.CookieHandler> cookieHandler() {
      return delegate.cookieHandler();
    }

    @Override
    public java.util.Optional<java.time.Duration> connectTimeout() {
      return delegate.connectTimeout();
    }

    @Override
    public Redirect followRedirects() {
      return Redirect.NEVER;
    }

    @Override
    public java.util.Optional<java.net.ProxySelector> proxy() {
      return delegate.proxy();
    }

    @Override
    public javax.net.ssl.SSLContext sslContext() {
      return delegate.sslContext();
    }

    @Override
    public javax.net.ssl.SSLParameters sslParameters() {
      return delegate.sslParameters();
    }

    @Override
    public java.util.Optional<java.net.Authenticator> authenticator() {
      return delegate.authenticator();
    }

    @Override
    public Version version() {
      return delegate.version();
    }

    @Override
    public java.util.Optional<java.util.concurrent.Executor> executor() {
      return delegate.executor();
    }

    @Override
    @SuppressWarnings("unchecked")
    public <T> java.net.http.HttpResponse<T> send(
        java.net.http.HttpRequest request,
        java.net.http.HttpResponse.BodyHandler<T> responseBodyHandler)
        throws IOException, InterruptedException {
      requests.add(request);
      if (responder != null) {
        return (java.net.http.HttpResponse<T>) responder.apply(request);
      }
      if (scripted != null) {
        return (java.net.http.HttpResponse<T>) scripted;
      }
      return delegate.send(request, responseBodyHandler);
    }

    /** An answer for {@code request} with {@code status}, a Location when {@code location} is set. */
    static java.net.http.HttpResponse<byte[]> redirect(
        int status,
        @javax.annotation.Nullable String location,
        java.net.http.HttpRequest request) {
      java.net.http.HttpHeaders headers =
          java.net.http.HttpHeaders.of(
              location == null ? Map.of() : Map.of("location", List.of(location)),
              (name, value) -> true);
      return new java.net.http.HttpResponse<byte[]>() {
        @Override
        public int statusCode() {
          return status;
        }

        @Override
        public java.net.http.HttpRequest request() {
          return request;
        }

        @Override
        public java.util.Optional<java.net.http.HttpResponse<byte[]>> previousResponse() {
          return java.util.Optional.empty();
        }

        @Override
        public java.net.http.HttpHeaders headers() {
          return headers;
        }

        @Override
        public byte[] body() {
          return new byte[0];
        }

        @Override
        public java.util.Optional<javax.net.ssl.SSLSession> sslSession() {
          return java.util.Optional.empty();
        }

        @Override
        public java.net.URI uri() {
          return request.uri();
        }

        @Override
        public java.net.http.HttpClient.Version version() {
          return java.net.http.HttpClient.Version.HTTP_1_1;
        }
      };
    }

    @Override
    @SuppressWarnings("unchecked")
    public <T> java.util.concurrent.CompletableFuture<java.net.http.HttpResponse<T>> sendAsync(
        java.net.http.HttpRequest request,
        java.net.http.HttpResponse.BodyHandler<T> responseBodyHandler) {
      requests.add(request);
      if (responder != null) {
        return java.util.concurrent.CompletableFuture.completedFuture(
            (java.net.http.HttpResponse<T>) responder.apply(request));
      }
      if (scripted != null) {
        return java.util.concurrent.CompletableFuture.completedFuture(
            (java.net.http.HttpResponse<T>) scripted);
      }
      return delegate.sendAsync(request, responseBodyHandler);
    }

    @Override
    public <T> java.util.concurrent.CompletableFuture<java.net.http.HttpResponse<T>> sendAsync(
        java.net.http.HttpRequest request,
        java.net.http.HttpResponse.BodyHandler<T> responseBodyHandler,
        java.net.http.HttpResponse.PushPromiseHandler<T> pushPromiseHandler) {
      requests.add(request);
      return delegate.sendAsync(request, responseBodyHandler, pushPromiseHandler);
    }
  }

  @Test
  void bhvTransport040InjectedHttpClientReceivesTheRequestWithSdkDefaultsApplied() {
    RecordingHttpClient transport = new RecordingHttpClient();
    DefaultApiClient client =
        new DefaultApiClient(TransportOptions.builder().httpClient(transport).build());
    ApiHttpResponse response = client.sendRequest("GET", baseUrl + "/echo", Map.of(), null);
    assertEquals(200, response.statusCode());
    assertEquals(1, transport.requests.size());
    assertTrue(transport.requests.get(0).headers().firstValue("User-Agent").isPresent());
    assertTrue(transport.requests.get(0).timeout().isPresent());
  }

  @Test
  void closingTheClientNeverClosesAnInjectedHttpClient() {
    RecordingHttpClient transport = new RecordingHttpClient();
    DefaultApiClient client =
        new DefaultApiClient(TransportOptions.builder().httpClient(transport).build());
    client.close();
    DefaultApiClient reuse =
        new DefaultApiClient(TransportOptions.builder().httpClient(transport).build());
    assertEquals(200, reuse.sendRequest("GET", baseUrl + "/echo", Map.of(), null).statusCode());
  }

  private static String echoed(String method, String body) {
    return "{\"method\":\"" + method + "\",\"body\":\"" + body + "\"}";
  }

  private String methodAndBodyAfterRedirect(String method, int status) {
    DefaultApiClient client =
        new DefaultApiClient(TransportOptions.builder().followRedirects(true).build());
    ApiHttpResponse response =
        client.sendRequest(method, baseUrl + "/redirect-status?" + status, Map.of(), "payload");
    assertEquals(200, response.statusCode());
    return response.body();
  }

  @Test
  void redirect301And302RewriteOnlyPostToGet() {
    for (int status : new int[] {301, 302}) {
      assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect("POST", status));
      for (String method : new String[] {"PUT", "PATCH", "DELETE"}) {
        assertEquals(echoed(method, "payload"), methodAndBodyAfterRedirect(method, status));
      }
    }
  }

  @Test
  void bhvRedirects036Redirect303RewritesEveryMethodToGet() {
    for (String method : new String[] {"POST", "PUT", "PATCH", "DELETE"}) {
      assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect(method, 303));
    }
  }

  @Test
  void redirect307And308KeepMethodAndBody() {
    for (int status : new int[] {307, 308}) {
      assertEquals(echoed("PUT", "payload"), methodAndBodyAfterRedirect("PUT", status));
    }
  }

  /** A transport that answers {@code /start} with a redirect and every other path with a bare 200. */
  private static RecordingHttpClient redirectingOnceTo(int status, String location) {
    RecordingHttpClient transport = new RecordingHttpClient();
    transport.responder =
        request ->
            request.uri().getPath().equals("/start")
                ? RecordingHttpClient.redirect(status, location, request)
                : RecordingHttpClient.redirect(200, null, request);
    return transport;
  }

  /** The Authorization header the second hop carries when {@code start} redirects to {@code location}. */
  private static java.util.Optional<String> authorizationOnSecondHop(
      String start, int status, String location) {
    RecordingHttpClient transport = redirectingOnceTo(status, location);
    DefaultApiClient client =
        new DefaultApiClient(
            TransportOptions.builder().httpClient(transport).followRedirects(true).build());
    client.sendRequest("GET", start, Map.of("Authorization", "Bearer secret"), null);
    assertEquals(2, transport.requests.size());
    return transport.requests.get(1).headers().firstValue("Authorization");
  }

  @Test
  void bhvRedirects029RedirectRewritesTheMethodOnlyAsRfc9110Allows() {
    assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect("POST", 301));
    assertEquals(echoed("PUT", "payload"), methodAndBodyAfterRedirect("PUT", 301));
    assertEquals(echoed("PATCH", "payload"), methodAndBodyAfterRedirect("PATCH", 301));
    assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect("POST", 302));
    assertEquals(echoed("DELETE", "payload"), methodAndBodyAfterRedirect("DELETE", 302));
    assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect("POST", 303));
    assertEquals(echoed("GET", ""), methodAndBodyAfterRedirect("DELETE", 303));
    assertEquals(echoed("POST", "payload"), methodAndBodyAfterRedirect("POST", 307));
    assertEquals(echoed("PATCH", "payload"), methodAndBodyAfterRedirect("PATCH", 308));
    assertEquals(echoed("DELETE", "payload"), methodAndBodyAfterRedirect("DELETE", 308));
    RecordingHttpClient transport = redirectingOnceTo(303, "https://api.example.invalid/landed");
    DefaultApiClient client =
        new DefaultApiClient(
            TransportOptions.builder().httpClient(transport).followRedirects(true).build());
    client.sendRequest("HEAD", "https://api.example.invalid/start", Map.of(), null);
    assertEquals("HEAD", transport.requests.get(1).method());
  }

  @Test
  void bhvRedirects030ExplicitDefaultPortIsTheSameOriginAsTheImplicitOne() {
    assertEquals(
        java.util.Optional.of("Bearer secret"),
        authorizationOnSecondHop(
            "https://api.example.invalid/start", 307, "https://api.example.invalid:443/landed"));
