  /** Accepts connections and closes each without answering; returns the accept count. */
  private static java.util.concurrent.atomic.AtomicInteger dropConnections(
      java.net.ServerSocket socket) {
    java.util.concurrent.atomic.AtomicInteger accepted =
        new java.util.concurrent.atomic.AtomicInteger();
    Thread thread =
        new Thread(
            () -> {
              try {
                while (!socket.isClosed()) {
                  try (java.net.Socket connection = socket.accept()) {
                    accepted.incrementAndGet();
                    connection.setSoTimeout(300);
                    try {
                      connection.getInputStream().readAllBytes();
                    } catch (java.net.SocketTimeoutException drained) {
                      // The request is fully read; close without a response.
                    }
                  }
                }
              } catch (IOException closed) {
                // The test closed the listening socket.
              }
            });
    thread.setDaemon(true);
    thread.start();
    return accepted;
  }

