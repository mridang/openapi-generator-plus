  @Test
  void bhvTransport032TransportFailureRaisesNetworkExceptionPreservingCause() {
    // A send-phase transport failure (connection refused on a closed port)
    // must surface as a NetworkException (an ApiException with status 0)
    // whose getCause() is the underlying IOException.
    DefaultApiClient client = new DefaultApiClient(TransportOptions.builder().maxRetries(0).build());
    {{invokerPackage}}.errors.NetworkException ex = assertThrowsExactly({{invokerPackage}}.errors.NetworkException.class, () ->
        client.sendRequest("GET", "http://127.0.0.1:1/never", Map.of(), null));
    assertInstanceOf(ApiException.class, ex);
    assertEquals(0, ex.getStatusCode());
    assertFalse(ex instanceof {{invokerPackage}}.errors.NetworkTimeoutException,
        "connection refused is not a timeout");
    assertNotNull(ex.getCause(),
        "transport exception must be preserved as the cause");
    assertTrue(ex.getCause() instanceof java.io.IOException,
        "cause should be the underlying IOException, was: " + ex.getCause());
  }

  @Test
  void bhvTransport031ConnectDeadlineRaisesNetworkTimeoutException() {
    // The `timeout` option arms two deadlines: the connect timeout on the
    // HttpClient and the read timeout on the HttpRequest. Both expire on the
    // same configured budget, so both must classify as NetworkTimeoutException
    // — a connect-phase expiry surfacing as a plain NetworkException would let
    // one deadline report under two types. 192.0.2.1 (RFC 5737 TEST-NET-1) is
    // reserved for documentation and never routed, so the SYN is dropped
    // rather than refused and the connect timer is the one that fires.
    DefaultApiClient client =
        new DefaultApiClient(TransportOptions.builder().timeout(250).build());
    {{invokerPackage}}.errors.NetworkTimeoutException ex = assertThrowsExactly({{invokerPackage}}.errors.NetworkTimeoutException.class, () ->
        client.sendRequest("GET", "http://192.0.2.1:81/never", Map.of(), null));
    assertInstanceOf({{invokerPackage}}.errors.NetworkException.class, ex);
    assertEquals(0, ex.getStatusCode());
    assertTrue(ex.getCause() instanceof java.net.http.HttpTimeoutException,
        "cause should be the JDK timeout exception, was: " + ex.getCause());
  }

  @Test
  void bhvTransport029StalledResponseBodyRaisesNetworkTimeoutException() {
    // The request timeout is documented as end-to-end, so a server that sends
    // the headers and then stalls the body must time out, not block until it
    // gives up (the JDK stops its own request timer once headers arrive).
    DefaultApiClient client =
        new DefaultApiClient(TransportOptions.builder().timeout(400).build());
    long started = System.nanoTime();
    {{invokerPackage}}.errors.NetworkTimeoutException ex = assertThrowsExactly({{invokerPackage}}.errors.NetworkTimeoutException.class, () ->
        client.sendRequest("GET", baseUrl + "/stalled-body", Map.of(), null));
    long elapsedMillis = (System.nanoTime() - started) / 1_000_000L;
    assertTrue(elapsedMillis < 2000, "must time out near the 400 ms budget, took " + elapsedMillis + " ms");
    assertEquals(0, ex.getStatusCode());
    assertTrue(ex.getCause() instanceof java.net.http.HttpTimeoutException,
        "cause should be the JDK timeout exception, was: " + ex.getCause());
  }

  @Test
