  {{! -- Parity regression: a raw byte[] part named avatar.png must emit a }}
  {{! -- per-part Content-Type derived from the filename extension (image/png), }}
  {{! -- never a blanket application/octet-stream. The bug was that the byte[] }}
  {{! -- and InputStream branches hard-coded octet-stream. Locked here by }}
  {{! -- rendering the actual multipart bytes. }}

  private static String renderMultipartPart(String fieldName, Object value) throws Exception {
    DefaultApiClient client = new DefaultApiClient();
    java.lang.reflect.Method method =
        DefaultApiClient.class.getDeclaredMethod(
            "addMultipartField",
            List.class,
            String.class,
            String.class,
            Object.class);
    method.setAccessible(true);
    List<byte[]> byteArrays = new java.util.ArrayList<>();
    method.invoke(client, byteArrays, "BOUNDARY", fieldName, value);
    java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
    for (byte[] chunk : byteArrays) {
      out.write(chunk);
    }
    return out.toString(StandardCharsets.UTF_8);
  }

  @Test
  void bhvSerializationWire037MultipartRawBytesPartDerivesContentTypeFromFilenameExtension() throws Exception {
    byte[] raw = new byte[] {(byte) 0x89, 'P', 'N', 'G'};
    String part = renderMultipartPart("avatar.png", raw);
    assertTrue(
        part.contains("Content-Type: image/png"),
        "byte[] part named avatar.png must derive Content-Type image/png, got: " + part);
    assertFalse(
        part.contains("Content-Type: application/octet-stream"),
        "byte[] part with a known extension must not fall back to octet-stream");
  }

  @Test
  void multipartInputStreamPartIsReadButNeverClosed() throws Exception {
    java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean();
    java.io.InputStream stream =
        new java.io.ByteArrayInputStream(new byte[] {1, 2, 3}) {
          @Override
          public void close() throws java.io.IOException {
            closed.set(true);
            super.close();
          }
        };
    String part = renderMultipartPart("blob", stream);
    assertTrue(part.contains("name=\"blob\""), "stream part must be rendered, got: " + part);
    assertFalse(closed.get(), "the caller owns the stream; the SDK must not close it");
  }

