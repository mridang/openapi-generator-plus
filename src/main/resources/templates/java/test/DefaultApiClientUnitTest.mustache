    DefaultApiClient client = new DefaultApiClient();
    client.close();
    IllegalStateException ex = assertThrowsExactly(IllegalStateException.class,
        () -> client.sendRequest("GET", baseUrl + "/echo", Map.of(), null));
    assertFalse(((Object) ex) instanceof {{errorPrefix}}Exception,
        "use-after-close must not be an SDK error");
    assertEquals("ApiClient has been closed and can no longer send requests", ex.getMessage());
  }

  @Test
  void staleConnectionRetryDrawsFromTheRemainingBudget() throws Exception {
    // D76: the one retry after "header parser received no bytes" shares the end-to-end
    // budget. The first connection is held 1.5 s and dropped without a byte; the second is
    // never answered. With a 2 s budget the call ends near 2 s, not near 3.5 s.
    try (java.net.ServerSocket silent = new java.net.ServerSocket(0)) {
      Thread acceptor =
          new Thread(
              () -> {
                try (java.net.Socket first = silent.accept()) {
                  Thread.sleep(first.isClosed() ? 0 : 1500);
                } catch (IOException | InterruptedException ignored) {
                  return;
                }
                try (java.net.Socket second = silent.accept()) {
                  Thread.sleep(second.isClosed() ? 0 : 6000);
                } catch (IOException | InterruptedException ignored) {
                  // The test is over.
                }
              });
      acceptor.setDaemon(true);
      acceptor.start();
      DefaultApiClient client =
          new DefaultApiClient(TransportOptions.builder().timeout(2000).build());
      String url = "http://127.0.0.1:" + silent.getLocalPort() + "/never-answers";
      long startedNanos = System.nanoTime();
      assertThrowsExactly(
          {{invokerPackage}}.errors.NetworkTimeoutException.class,
          () -> client.sendRequest("GET", url, Map.of(), null));
      long elapsedMillis = (System.nanoTime() - startedNanos) / 1_000_000L;
      assertTrue(elapsedMillis < 3000, "the retry got a fresh budget: " + elapsedMillis + " ms");
      acceptor.interrupt();
    }
  }

