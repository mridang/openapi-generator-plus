  /** What a scripted server answers: a status and an optional Retry-After value. */
  private record Reply(int status, String retryAfter) {}

  /** A throwaway server that answers request number n (from 1) with {@code script(n)}. */
  private static HttpServer scriptedServer(
      java.util.function.IntFunction<Reply> script,
      java.util.concurrent.atomic.AtomicInteger hits)
      throws IOException {
    HttpServer scripted = HttpServer.create(new InetSocketAddress(0), 0);
    scripted.createContext(
        "/",
        exchange -> {
          exchange.getRequestBody().readAllBytes();
          Reply reply = script.apply(hits.incrementAndGet());
          if (!reply.retryAfter().isEmpty()) {
            exchange.getResponseHeaders().add("Retry-After", reply.retryAfter());
          }
          byte[] body = "{}".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(reply.status(), body.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    scripted.start();
    return scripted;
  }

  private static String urlOf(HttpServer scripted) {
    return "http://localhost:" + scripted.getAddress().getPort() + "/resource";
  }

