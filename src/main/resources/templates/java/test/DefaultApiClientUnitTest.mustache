  @Test
  void bhvRetries026RetryAfterSecondsSetTheWait() throws Exception {
    var hits = new java.util.concurrent.atomic.AtomicInteger();
    HttpServer scripted =
        scriptedServer(n -> n == 1 ? new Reply(429, "1") : new Reply(200, ""), hits);
    try {
      long startedNanos = System.nanoTime();
      ApiHttpResponse response =
          new DefaultApiClient().sendRequest("GET", urlOf(scripted), Map.of(), null);
      long elapsedMillis = (System.nanoTime() - startedNanos) / 1_000_000L;
      assertEquals(200, response.statusCode());
      assertTrue(elapsedMillis >= 900, "waited the Retry-After second, took " + elapsedMillis);
