  void bhvLifecycle021ClosingTheClientLetsARunningRequestFinish() throws Exception {
    var entered = new java.util.concurrent.CountDownLatch(1);
    var release = new java.util.concurrent.CountDownLatch(1);
    HttpServer slow = HttpServer.create(new InetSocketAddress(0), 0);
    slow.createContext(
        "/",
        exchange -> {
          entered.countDown();
          try {
            release.await();
          } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
          }
          byte[] response = "done".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    slow.start();
    var result = new java.util.concurrent.atomic.AtomicReference<ApiHttpResponse>();
    try {
      DefaultApiClient client = new DefaultApiClient();
      Thread running =
          new Thread(
              () -> result.set(client.sendRequest("GET", urlOf(slow), Map.of(), null)));
      running.start();
      assertTrue(entered.await(10, java.util.concurrent.TimeUnit.SECONDS));

      client.close();

      assertFalse(client.isTransportReleased(), "a request is still in flight");
      IllegalStateException refused =
          assertThrowsExactly(
              IllegalStateException.class,
              () -> client.sendRequest("GET", urlOf(slow), Map.of(), null));
      assertEquals("ApiClient has been closed and can no longer send requests", refused.getMessage());
      release.countDown();
      running.join(10_000);
      ApiHttpResponse finished = java.util.Objects.requireNonNull(result.get());
      assertEquals(200, finished.statusCode());
      assertEquals("done", finished.body());
      assertTrue(client.isTransportReleased(), "the last request released the transport");
    } finally {
      release.countDown();
      slow.stop(0);
    }
  }

  @Test
  void bhvLifecycle019CloseRefusesANewRequestWithoutSendingItWhileAnotherIsInFlight()
      throws Exception {
    var entered = new java.util.concurrent.CountDownLatch(1);
    var release = new java.util.concurrent.CountDownLatch(1);
    var hits = new java.util.concurrent.atomic.AtomicInteger();
    HttpServer slow = HttpServer.create(new InetSocketAddress(0), 0);
    slow.createContext(
        "/",
        exchange -> {
          hits.incrementAndGet();
          entered.countDown();
          try {
            release.await();
          } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
          }
          byte[] response = "done".getBytes(StandardCharsets.UTF_8);
          exchange.sendResponseHeaders(200, response.length);
          try (OutputStream os = exchange.getResponseBody()) {
            os.write(response);
          }
        });
    slow.start();
    var result = new java.util.concurrent.atomic.AtomicReference<ApiHttpResponse>();
    try {
      DefaultApiClient client = new DefaultApiClient();
      Thread running =
          new Thread(
              () -> result.set(client.sendRequest("GET", urlOf(slow), Map.of(), null)));
      running.start();
      assertTrue(entered.await(10, java.util.concurrent.TimeUnit.SECONDS));

      client.close();

      assertThrowsExactly(
          IllegalStateException.class,
          () -> client.sendRequest("GET", urlOf(slow), Map.of(), null));
      assertEquals(1, hits.get(), "the refused request must never reach the server");
      release.countDown();
      running.join(10_000);
      assertEquals(200, java.util.Objects.requireNonNull(result.get()).statusCode());
    } finally {
      release.countDown();
      slow.stop(0);
    }
  }

  @Test
  void bhvLifecycle022ClosingTwiceIsANoOpAndReleasesTheTransportOnce() {
    DefaultApiClient client = new DefaultApiClient();
    assertFalse(client.isTransportReleased());

    client.close();
    assertTrue(client.isTransportReleased());
    client.close();

    assertTrue(client.isTransportReleased());
  }

  @Test
  void bhvLifecycle035RequestAfterCloseFailsWithTheClosedErrorAndNeverReachesTheWire()
      throws Exception {
    java.util.concurrent.atomic.AtomicInteger hits = new java.util.concurrent.atomic.AtomicInteger();
    HttpServer counting = HttpServer.create(new InetSocketAddress(0), 0);
    counting.createContext(
        "/items",
        exchange -> {
          hits.incrementAndGet();
          exchange.sendResponseHeaders(200, -1);
          exchange.close();
        });
    counting.start();
    try {
      DefaultApiClient client = new DefaultApiClient();
      client.close();
      IllegalStateException ex = assertThrowsExactly(IllegalStateException.class,
          () -> client.sendRequest(
              "GET", "http://localhost:" + counting.getAddress().getPort() + "/items", Map.of(), null));
      assertEquals("ApiClient has been closed and can no longer send requests", ex.getMessage());
      assertEquals(0, hits.get());
    } finally {
      counting.stop(0);
    }
  }

  @Test
  void bhvLifecycle020ClosingNeverReleasesACallerSuppliedTransport() throws Exception {
    java.net.http.HttpClient supplied = java.net.http.HttpClient.newHttpClient();
    try {
      DefaultApiClient client =
          new DefaultApiClient(TransportOptions.builder().httpClient(supplied).build());
      client.close();
      client.close();

      assertFalse(supplied.isTerminated());
      assertFalse(client.isTransportReleased());
      assertThrowsExactly(
          IllegalStateException.class,
          () -> client.sendRequest("GET", baseUrl + "/echo", Map.of(), null));
    } finally {
      supplied.close();
    }
  }
