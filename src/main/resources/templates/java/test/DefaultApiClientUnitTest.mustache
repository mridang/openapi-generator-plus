  {{! -- Cross-cutting parity: a model part in a multipart/form-data body must }}
  {{! -- be serialized through the SDK-configured Jackson mapper, so it uses the }}
  {{! -- WIRE property names declared by the model's JsonProperty annotations }}
  {{! -- (isEnabled, recordedAt) and the SDK date-time format -- never snake_case }}
  {{! -- is_enabled/recorded_at, and never an epoch timestamp. Rendering the part }}
  {{! -- bytes locks the contract. }}
  {{! -- }}
  {{! -- The part model is declared below rather than taken from the generated }}
  {{! -- models, so this test holds for EVERY spec this SDK is generated from -- }}
  {{! -- no spec is guaranteed to contain a model with these properties. }}

  @Test
  void bhvSerializationWire048MultipartPrimitivePartsArePlainTextInTheCanonicalForm() throws Exception {
    assertEquals(
        "--BOUNDARY\r\nContent-Disposition: form-data; name=\"flag\"\r\n\r\ntrue\r\n",
        renderMultipartPart("flag", true));
    assertEquals(
        "--BOUNDARY\r\nContent-Disposition: form-data; name=\"count\"\r\n\r\n3\r\n",
        renderMultipartPart("count", 3L));
    String at = renderMultipartPart(
        "at", java.time.OffsetDateTime.of(2024, 1, 15, 10, 30, 0, 0, java.time.ZoneOffset.UTC));
    assertTrue(at.endsWith("name=\"at\"\r\n\r\n2024-01-15T10:30:00.000+00:00\r\n"), at);
    assertFalse(at.contains("Content-Type"), at);
    assertEquals(
        "--BOUNDARY\r\nContent-Disposition: form-data; name=\"day\"\r\n\r\n2024-01-15\r\n",
        renderMultipartPart("day", java.time.LocalDate.of(2024, 1, 15)));
  }

  static class MultipartModelPart {
    @com.fasterxml.jackson.annotation.JsonProperty("isEnabled")
    @javax.annotation.Nullable
    public Boolean isEnabled;

    @com.fasterxml.jackson.annotation.JsonProperty("recordedAt")
    @javax.annotation.Nullable
    public java.time.OffsetDateTime recordedAt;
  }

  @Test
  void bhvSerializationWire045MultipartModelPartUsesWirePropertyNamesAndDateTimeFormat() throws Exception {
    MultipartModelPart metadata = new MultipartModelPart();
    metadata.isEnabled = true;
    metadata.recordedAt = java.time.OffsetDateTime.parse("2020-01-02T03:04:05.123Z");

    String part = renderMultipartPart("metadata", metadata);

    assertTrue(
        part.contains("Content-Type: application/json"),
        "model multipart part must declare Content-Type: application/json, got: " + part);
    assertTrue(
        part.contains("\"isEnabled\":true"),
        "model part must use the wire property name isEnabled, got: " + part);
    assertFalse(
        part.contains("is_enabled"),
        "model part must NOT snake_case the wire name to is_enabled, got: " + part);
    assertTrue(
        part.contains("\"recordedAt\":\"2020-01-02T03:04:05.123+00:00\""),
        "model part must use the wire name recordedAt with the canonical date-time string"
            + " (numeric +00:00 offset, never Z), got: "
            + part);
    assertFalse(
        part.contains("recorded_at"),
        "model part must NOT snake_case the wire name to recorded_at, got: " + part);
  }

