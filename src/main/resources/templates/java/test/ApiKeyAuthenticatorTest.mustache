package {{invokerPackage}}.auth;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.Map;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

class ApiKeyAuthenticatorTest {

    @Test
    void bhvAuthApiKey014ValidHeaderKeyPasses() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER);
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("abc123", headers.get("X-API-Key"));
    }

    @Test
    void bhvAuthApiKey016ValidQueryKeyPasses() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "abc123", ApiKeyLocation.QUERY);
        Map<String, String> params = auth.getQueryParams();
        assertEquals("abc123", params.get("api_key"));
    }

    @Test
    void bhvAuthApiKey013ValidCookieKeyPasses() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "session", "abc123", ApiKeyLocation.COOKIE);
        assertEquals(Map.of("session", "abc123"), auth.getCookieParams());
        assertEquals(Map.of(), auth.getAuthHeaders());
        assertEquals(Map.of(), auth.getQueryParams());
    }

    @Test
    void bhvMisc057AnApiKeyConfiguredForOneLocationIsNeverSentAtAnother() {
        ApiKeyAuthenticator header = new ApiKeyAuthenticator(
                "https://api.example.com", "k", "v", ApiKeyLocation.HEADER);
        ApiKeyAuthenticator cookie = new ApiKeyAuthenticator(
                "https://api.example.com", "k", "v", ApiKeyLocation.COOKIE);

        assertEquals(Map.of(), header.getQueryParams());
        assertEquals(Map.of(), header.getCookieParams());
        assertEquals(Map.of(), cookie.getAuthHeaders());
        assertEquals(Map.of(), cookie.getQueryParams());
    }

    @Test
    void bhvAuthApiKey022KeyIsEmittedOnlyAtItsOwnLocation() {
        ApiKeyAuthenticator header = new ApiKeyAuthenticator(
                "https://api.example.com", "k", "v", ApiKeyLocation.HEADER);
        ApiKeyAuthenticator query = new ApiKeyAuthenticator(
                "https://api.example.com", "k", "v", ApiKeyLocation.QUERY);

        assertEquals(Map.of("k", "v"), header.getAuthHeaders());
        assertEquals(Map.of(), header.getQueryParams());
        assertEquals(Map.of(), header.getCookieParams());
        assertEquals(Map.of("k", "v"), query.getQueryParams());
        assertEquals(Map.of(), query.getAuthHeaders());
        assertEquals(Map.of(), query.getCookieParams());
    }

    @Test
    void bhvAuthApiKey008NonAsciiHeaderKeyIsRejectedWithTheExactMessage() {
        IllegalArgumentException ex =
                assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                        "https://api.example.com", "X-API-Key", "café", ApiKeyLocation.HEADER));
        assertEquals(
                "API key for header 'X-API-Key' must contain only printable ASCII characters"
                        + " (RFC 7230 §3.2.6)",
                ex.getMessage());
    }

    @Test
    void bhvAuthApiKey009NonAsciiQueryAndCookieKeysAreAccepted() {
        ApiKeyAuthenticator query = new ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "café", ApiKeyLocation.QUERY);
        ApiKeyAuthenticator cookie = new ApiKeyAuthenticator(
                "https://api.example.com", "session", "café", ApiKeyLocation.COOKIE);

        assertEquals("café", query.getQueryParams().get("api_key"));
        assertEquals("café", cookie.getCookieParams().get("session"));
    }

    @Test
    void bhvAuthApiKey005EmptyKeyHeaderThrowsAtConstruction() {
        IllegalArgumentException ex =
                assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                        "https://api.example.com", "X-API-Key", "", ApiKeyLocation.HEADER));
        String msg = ex.getMessage();
        assertNotNull(msg);
        assertTrue(msg.contains("must not be empty"));
    }

    @Test
    void bhvAuthApiKey006EmptyKeyQueryThrowsAtConstruction() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "", ApiKeyLocation.QUERY));
    }

    @Test
    void bhvAuthApiKey004EmptyKeyCookieThrowsAtConstruction() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "session", "", ApiKeyLocation.COOKIE));
    }

    @Test
    void bhvAuthApiKey017WhitespaceOnlyKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "   ", ApiKeyLocation.HEADER));
    }

    @Test
    void bhvLangjava065NewlineOnlyKeyReportsEmptyNotControlCharacters() {
        for (ApiKeyLocation location : ApiKeyLocation.values()) {
            for (String blank : new String[] {"\n", "\r\n", "\t", "\013", "\f"}) {
                IllegalArgumentException ex =
                        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                                "https://api.example.com", "X-API-Key", blank, location));
                assertEquals("API key value for 'X-API-Key' must not be empty", ex.getMessage());
            }
        }
    }

    @Test
    void bhvAuthApiKey001UnicodeSpaceKeyIsNotBlank() {
        for (String key : new String[] {"\u00a0", "\u2003"}) {
            ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                    "https://api.example.com", "api_key", key, ApiKeyLocation.QUERY);
            assertEquals(key, auth.getQueryParams().get("api_key"));
        }
    }
    @Test
    void bhvAuth006ApiKeyIsSentUnderTheDeclaredHeaderName() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator("https://api.example.com", "X-API-KEY", "key-value", ApiKeyLocation.HEADER);
        assertEquals("key-value", auth.getAuthHeaders().get("X-API-KEY"));
    }

    @Test
    void bhvAuth016ApiKeyStringFormMasksTheKeyAndNamesItsType() {
        String printed = new ApiKeyAuthenticator("https://api.example.com", "X-API-KEY", "s3cr3t-key", ApiKeyLocation.HEADER).toString();
        assertTrue(printed.contains("ApiKeyAuthenticator"));
        assertFalse(printed.contains("s3cr3t-key"));
    }


    @Test
    void bhvAuth009NulOnlyKeyReportsControlCharacters() {
        IllegalArgumentException ex =
                assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                        "https://api.example.com", "X-API-Key", "\0", ApiKeyLocation.QUERY));
        assertEquals(
                "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)",
                ex.getMessage());
    }

    @Test
    void bhvAuthApiKey003CrlfInQueryKeyThrowsAtConstruction() {
        IllegalArgumentException ex =
                assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                        "https://api.example.com", "api_key", "abc\r\n", ApiKeyLocation.QUERY));
        String msg = ex.getMessage();
        assertNotNull(msg);
        assertTrue(msg.contains("forbidden control"));
    }

    @Test
    void bhvAuthApiKey002CrlfInCookieKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "session", "abc\n", ApiKeyLocation.COOKIE));
    }

    @Test
    void bhvAuthApiKey018CrlfInHeaderKeyThrowsAtConstruction() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc\rdef", ApiKeyLocation.HEADER));
    }

    /**
     * The default {@code toString()} must mask the stored API key: the secret
     * value must be absent and a {@code ***} redaction marker present.
     */
    @Test
    @DisplayName("bhvAuthApiKey010 toString() redacts the API key and shows ***")
    void bhvAuthApiKey010RedactsTheAPIKeyInToString() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER);
        String repr = auth.toString();
        assertFalse(repr.contains("abc123"));
        assertTrue(repr.contains("***"));
        assertEquals(
                "ApiKeyAuthenticator(host=https://api.example.com, keyParamName=X-API-Key,"
                        + " apiKey=***, location=HEADER)",
                repr);
    }
    @Test
    void bhvAuthApiKey015ValidQueryKeyIsExposedOnlyInQueryParams() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "abc123", ApiKeyLocation.QUERY);
        assertEquals("abc123", auth.getQueryParams().get("api_key"));
        assertFalse(auth.getAuthHeaders().containsKey("api_key"));
    }

    @Test
    void bhvAuthApiKey011RejectsAKeyOfOnlyAsciiWhitespaceSuchAsAVerticalTab() {
        assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                "https://api.example.com", "api_key", "\013", ApiKeyLocation.QUERY));
    }

    @Test
    void bhvAuthApiKey023CookieKeyAcceptsANonAsciiValue() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "session", "café", ApiKeyLocation.COOKIE);
        assertEquals(Map.of("session", "café"), auth.getCookieParams());
        assertEquals(Map.of(), auth.getAuthHeaders());
    }

    @Test
    void bhvAuthApiKey026DefaultDebugOutputDoesNotLeakTheKey() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER);
        assertFalse(auth.toString().contains("abc123"));
    }

    @Test
    void bhvAuthApiKey012ReprShowsTheNonSecretFieldsAndMasksTheKey() {
        String repr = new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-Key", "abc123", ApiKeyLocation.HEADER).toString();
        assertTrue(repr.contains("host=https://api.example.com"));
        assertTrue(repr.contains("keyParamName=X-API-Key"));
        assertFalse(repr.contains("abc123"));
        assertTrue(repr.contains("***"));
    }

    @Test
    void bhvAuth031ApiKeyHeaderHasTheExactNameAndValueOnTheWire() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "X-API-KEY", "key-value", ApiKeyLocation.HEADER);
        assertEquals(Map.of("X-API-KEY", "key-value"), auth.getAuthHeaders());
        assertEquals(Map.of(), auth.getQueryParams());
        assertEquals(Map.of(), auth.getCookieParams());
    }

    @Test
    void bhvAuth032SessionCookieIsSentAsTheSessionIdCookie() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "SESSION_ID", "session-value", ApiKeyLocation.COOKIE);
        assertEquals(Map.of("SESSION_ID", "session-value"), auth.getCookieParams());
        assertEquals(Map.of(), auth.getAuthHeaders());
    }

    @Test
    void bhvAuth033DebugOutputOfTheAuthenticatorNeverShowsTheSecret() {
        ApiKeyAuthenticator auth = new ApiKeyAuthenticator(
                "https://api.example.com", "SESSION_ID", "s3cr3t-value", ApiKeyLocation.COOKIE);
        assertFalse(auth.toString().contains("s3cr3t-value"));
        assertFalse(String.valueOf(auth).contains("s3cr3t-value"));
    }

    @Test
    void bhvAuth034ApiKeyRejectsAnEmptyOrBlankKeyAtConstruction() {
        for (String blank : new String[] {"", " ", "\t"}) {
            assertThrows(IllegalArgumentException.class, () -> new ApiKeyAuthenticator(
                    "https://api.example.com", "X-API-KEY", blank, ApiKeyLocation.HEADER));
        }
    }

    @Test
    void bhvMisc189TheApiKeyQueryWrapperSendsTheKeyAsTheApiKeyQueryParameter() {
        ApiKeyAuthenticator auth =
                new ApiKeyAuthenticator("http://localhost", "api_key", "secret-key", ApiKeyLocation.QUERY);
        assertEquals("secret-key", auth.getQueryParams().get("api_key"));
    }

    @Test
    void bhvMisc192ACookieMadeOnlyOfLegalOctetsIsSentExactlyAsGiven() {
        String value = "abc!#$%&'()*+-./:<=>?@[]^_`{|}~";
        ApiKeyAuthenticator auth =
                new ApiKeyAuthenticator("http://localhost", "session", value, ApiKeyLocation.COOKIE);
        assertEquals(value, auth.getCookieParams().get("session"));
    }
}
