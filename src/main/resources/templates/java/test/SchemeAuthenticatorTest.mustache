    /** The wrappers of the HTTP Basic security schemes. */
    @Nested
    class Basic {
        private static final String USERNAME_VARIABLE = "{{envVarPrefix}}_ADMIN_BASIC_USERNAME";
        private static final String SECRET_VARIABLE = "{{envVarPrefix}}_ADMIN_BASIC_PASSWORD";

        @Test
        void bhvAuthBasic019WrappersEmitTheSameBasicHeaderAndKeepTheirOwnName() {
            AdminBasicAuthenticator admin =
                    new AdminBasicAuthenticator("https://api.example.com", "alice", "s3cret");
            PetStoreBasicAuthenticator store =
                    new PetStoreBasicAuthenticator("https://api.example.com", "alice", "s3cret");

            assertEquals("Basic YWxpY2U6czNjcmV0", admin.getAuthHeaders().get("Authorization"));
            assertEquals("Basic YWxpY2U6czNjcmV0", store.getAuthHeaders().get("Authorization"));
            assertEquals("https://api.example.com", admin.getHost());
            assertEquals(
                    "AdminBasicAuthenticator(host=https://api.example.com,"
                            + " username=alice, password=***)",
                    admin.toString());
            assertEquals(
                    "PetStoreBasicAuthenticator(host=https://api.example.com,"
                            + " username=alice, password=***)",
                    store.toString());
        }

        @Test
        void bhvAuth036ValidatesTheCredentialsAtConstruction() {
            assertThrows(IllegalArgumentException.class, () ->
                    new AdminBasicAuthenticator("https://api.example.com", "ali:ce", "s3cret"));
        }

        @Test
        void bhvAuthbasic001ItBuildsFromItsEnvironmentVariablesAlone() {
            AdminBasicAuthenticator auth = new AdminBasicAuthenticator(
                    "https://api.example.com", null, null,
                    Map.of(USERNAME_VARIABLE, "alice", SECRET_VARIABLE, "from-env"));
            assertEquals("Basic YWxpY2U6ZnJvbS1lbnY=", auth.getAuthHeaders().get("Authorization"));
        }

        @Test
        void bhvAuth024MixesPassedAndEnvironmentCredentialsPerField() {
            AdminBasicAuthenticator auth = new AdminBasicAuthenticator(
                    "https://api.example.com", "alice", null, Map.of(SECRET_VARIABLE, "from-env"));
            assertEquals("Basic YWxpY2U6ZnJvbS1lbnY=", auth.getAuthHeaders().get("Authorization"));
        }

        @Test
        void bhvAuthBasic013AnExplicitArgumentIsNotOverriddenByTheEnvironment() {
            AdminBasicAuthenticator auth = new AdminBasicAuthenticator(
                    "https://api.example.com", "alice", "from-env",
                    Map.of(USERNAME_VARIABLE, "mallory", SECRET_VARIABLE, "ignored"));
            assertEquals("Basic YWxpY2U6ZnJvbS1lbnY=", auth.getAuthHeaders().get("Authorization"));
        }

        @Test
        void bhvAuthBasic012AnEmptyVariableCountsAsUnset() {
            AdminBasicAuthenticator fromEnvironment = new AdminBasicAuthenticator(
                    "https://api.example.com", "", "",
                    Map.of(USERNAME_VARIABLE, "alice", SECRET_VARIABLE, "from-env"));
            assertEquals("Basic YWxpY2U6ZnJvbS1lbnY=", fromEnvironment.getAuthHeaders().get("Authorization"));

            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new AdminBasicAuthenticator(
                            "https://api.example.com", "alice", null, Map.of(SECRET_VARIABLE, "")));
            assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains(SECRET_VARIABLE), ex.getMessage());
        }

        @Test
        void bhvAuth003EmptyEnvironmentVariablesCountAsNoValue() {
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new AdminBasicAuthenticator("https://api.example.com", null, null,
                            Map.of(USERNAME_VARIABLE, "", SECRET_VARIABLE, "")));
            assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains(USERNAME_VARIABLE), ex.getMessage());
        }

        @Test
        void bhvAuthscheme003MissingCredentialNamesItsVariable() {
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new AdminBasicAuthenticator("https://api.example.com", null, "from-env", Map.of()));
            assertEquals(
                    "The 'username' credential of the 'adminBasic' security scheme is required: "
                            + "pass it or set the " + USERNAME_VARIABLE + " environment variable",
                    ex.getMessage());
        }

        @Test
        void bhvAuthscheme002ExplicitArgumentsNeedNoEnvironment() {
            AdminBasicAuthenticator auth =
                    new AdminBasicAuthenticator("https://api.example.com", "alice", "s3cret", Map.of());
            assertEquals("Basic YWxpY2U6czNjcmV0", auth.getAuthHeaders().get("Authorization"));
        }
        @Test
        void bhvAuthBasic001ReadsBothCredentialsFromTheEnvironmentWhenNonePassed() {
            PetStoreBasicAuthenticator auth = new PetStoreBasicAuthenticator(
                    "https://api.example.com", null, null,
                    Map.of(
                            "SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_USERNAME", "alice",
                            "SWAGGER_PETSTORE_OPEN_API_3_0_PET_STORE_BASIC_PASSWORD", "s3cret"));
            assertEquals("Basic YWxpY2U6czNjcmV0", auth.getAuthHeaders().get("Authorization"));
        }

        @Test
        void bhvAuthBasic003MissingCredentialFailsAtConstruction() {
            assertThrows(IllegalArgumentException.class, () -> new PetStoreBasicAuthenticator(
                    "https://api.example.com", null, null, Map.of()));
        }

        @Test
        void bhvAuthBasic020WrapperNamesItsOwnClassWithThePasswordMasked() {
            String repr = new PetStoreBasicAuthenticator("https://api.example.com", "alice", "s3cret")
                    .toString();
            assertEquals(
                    "PetStoreBasicAuthenticator(host=https://api.example.com, username=alice, password=***)",
                    repr);
        }

        @Test
        void bhvAuthScheme004AdminBasicTreatsAnEmptyVariableAsUnsetAndNamesIt() {
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new AdminBasicAuthenticator("https://api.example.com", null, null,
                            Map.of(USERNAME_VARIABLE, "", SECRET_VARIABLE, "")));
            assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains(USERNAME_VARIABLE), ex.getMessage());
        }

        @Test
        void bhvAuthBasic002WrapperEmitsTheBasicHeaderAndMasksThePassword() {
            PetStoreBasicAuthenticator auth =
                    new PetStoreBasicAuthenticator("https://api.example.com", "alice", "s3cret");
            assertEquals("Basic YWxpY2U6czNjcmV0", auth.getAuthHeaders().get("Authorization"));
            assertFalse(auth.toString().contains("s3cret"));
        }

    }
