    /** The wrappers of the API key security schemes. */
    @Nested
    class ApiKey {
        private static final String API_KEY_VARIABLE = "{{envVarPrefix}}_API_KEY_HEADER_API_KEY";

        @Test
        void bhvLangjava017WrappersEmitTheirKeyAtTheSpecNameAndLocation() {
            String host = "https://api.example.com";
            ApiKeyHeaderAuthenticator header = new ApiKeyHeaderAuthenticator(host, "k1");
            InternalApiKeyAuthenticator internal = new InternalApiKeyAuthenticator(host, "k2");
            ApiKeyQueryAuthenticator query = new ApiKeyQueryAuthenticator(host, "k3");
            SessionCookieAuthenticator cookie = new SessionCookieAuthenticator(host, "k4");

            assertEquals(Map.of("X-API-Key", "k1"), header.getAuthHeaders());
            assertEquals(Map.of("X-Internal-Key", "k2"), internal.getAuthHeaders());
            assertEquals(Map.of("api_key", "k3"), query.getQueryParams());
            assertEquals(Map.of("SESSION_ID", "k4"), cookie.getCookieParams());
            assertEquals(Map.of(), header.getQueryParams());
            assertEquals(Map.of(), internal.getCookieParams());
            assertEquals(Map.of(), query.getAuthHeaders());
            assertEquals(Map.of(), cookie.getAuthHeaders());
            assertEquals(host, cookie.getHost());
        }

        @Test
        void bhvAuthApiKey020WrappersRedactTheKeyAndKeepTheirOwnName() {
            String host = "https://api.example.com";
            assertEquals(
                    "ApiKeyHeaderAuthenticator(host=" + host
                            + ", keyParamName=X-API-Key, apiKey=***, location=HEADER)",
                    new ApiKeyHeaderAuthenticator(host, "k1").toString());
            assertEquals(
                    "InternalApiKeyAuthenticator(host=" + host
                            + ", keyParamName=X-Internal-Key, apiKey=***, location=HEADER)",
                    new InternalApiKeyAuthenticator(host, "k2").toString());
            assertEquals(
                    "ApiKeyQueryAuthenticator(host=" + host
                            + ", keyParamName=api_key, apiKey=***, location=QUERY)",
                    new ApiKeyQueryAuthenticator(host, "k3").toString());
            assertEquals(
                    "SessionCookieAuthenticator(host=" + host
                            + ", keyParamName=SESSION_ID, apiKey=***, location=COOKIE)",
                    new SessionCookieAuthenticator(host, "k4").toString());
        }

        @Test
        void bhvAuthApiKey019WrappersRejectAnEmptyKeyAtConstruction() {
            String host = "https://api.example.com";
            /* An empty key counts as not passed, so with no variable either the credential is missing. */
            for (String message : new String[] {
                    assertThrows(IllegalArgumentException.class, () ->
                            new ApiKeyHeaderAuthenticator(host, "", Map.of())).getMessage(),
                    assertThrows(IllegalArgumentException.class, () ->
                            new ApiKeyQueryAuthenticator(host, "", Map.of())).getMessage(),
                    assertThrows(IllegalArgumentException.class, () ->
                            new SessionCookieAuthenticator(host, "", Map.of())).getMessage()}) {
                assertNotNull(message);
                assertTrue(message.contains("credential of the"), message);
                assertTrue(message.contains("is required"), message);
            }
            /* A blank key is a value, and the base authenticator refuses it. */
            assertEquals("API key value for 'X-Internal-Key' must not be empty",
                    assertThrows(IllegalArgumentException.class, () ->
                            new InternalApiKeyAuthenticator(host, " ")).getMessage());
        }

        @Test
        void bhvLangjava062ItBuildsFromItsEnvironmentVariablesAlone() {
            ApiKeyHeaderAuthenticator auth = new ApiKeyHeaderAuthenticator(
                    "https://api.example.com", null, Map.of(API_KEY_VARIABLE, "env-key"));
            assertEquals("env-key", auth.getAuthHeaders().get("X-API-Key"));
        }

        @Test
        void bhvSerializationObject187AnExplicitArgumentIsNotOverriddenByTheEnvironment() {
            ApiKeyHeaderAuthenticator auth = new ApiKeyHeaderAuthenticator(
                    "https://api.example.com", "explicit", Map.of(API_KEY_VARIABLE, "env-key"));
