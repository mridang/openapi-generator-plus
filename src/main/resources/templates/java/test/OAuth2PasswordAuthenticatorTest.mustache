    @Test
    void keepsTheRfc3986UnreservedSetLiteralInTheBodyAndBasicHeader() {
        // RFC 3986 unreserved '-._~' stays literal, '*!'()' is percent-encoded,
        // a space is '+', in the token body and in the Basic client credentials.
        AtomicReference<String> capturedBody = new AtomicReference<>();
        AtomicReference<Map<String, String>> capturedHeaders = new AtomicReference<>();
        ApiClient client = (method, url, headers, body) -> {
            capturedBody.set(body != null ? body.toString() : "");
            capturedHeaders.set(headers);
            return new ApiHttpResponse(200,
                    "{\"access_token\":\"at\",\"expires_in\":3600}", Map.of());
        };

        OAuth2PasswordAuthenticator bodyAuth = new OAuth2PasswordAuthenticator(
                "https://api.example.com",
                "id-._~*!'()",
                "sec ret",
                "https://auth.example.com/token",
                "testuser",
                "testpass",
                List.of("read"));
        bodyAuth.setApiClient(client);
        bodyAuth.getAuthHeaders();

        String body = java.util.Objects.requireNonNull(capturedBody.get());
        assertTrue(body.contains("client_id=id-._~%2A%21%27%28%29"), body);
        assertTrue(body.contains("client_secret=sec+ret"), body);

        OAuth2PasswordAuthenticator basicAuth = new OAuth2PasswordAuthenticator(
                "https://api.example.com",
                "id-._~*!'()",
                "sec ret",
                "https://auth.example.com/token",
                null,
                "testuser",
                "testpass",
                List.of("read"),
                ClientAuthMethod.BASIC);
        basicAuth.setApiClient(client);
        basicAuth.getAuthHeaders();

        String authHeader = java.util.Objects.requireNonNull(
                java.util.Objects.requireNonNull(capturedHeaders.get()).get("Authorization"));
        String decoded = new String(
                java.util.Base64.getDecoder().decode(authHeader.substring("Basic ".length())),
                java.nio.charset.StandardCharsets.UTF_8);
        assertEquals("id-._~%2A%21%27%28%29:sec+ret", decoded);
    }

    /**
     * The default {@code toString()} must mask both secrets: neither the client
     * secret nor the resource-owner password may appear, and a {@code ***}
     * redaction marker must be present.
     */
    @Test
    @DisplayName("toString() redacts the client secret and password and shows ***")
    void redactsSecret() {
        OAuth2PasswordAuthenticator auth = createAuthenticator();
        String repr = auth.toString();
        assertFalse(repr.contains("my-client-secret"));
        assertFalse(repr.contains("testpass"));
        assertTrue(repr.contains("***"));
        assertEquals(
                "OAuth2PasswordAuthenticator(host=https://api.example.com"
                        + ", clientId=my-client-id, clientSecret=***"
                        + ", tokenUrl=https://auth.example.com/token"
                        + ", refreshUrl=https://auth.example.com/token"
                        + ", username=testuser, password=***, scopes=[read, write]"
                        + ", clientAuthMethod=BODY)",
                repr);
    }
