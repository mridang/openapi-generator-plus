            }
            return new ApiHttpResponse(200,
                    "{\"access_token\":\"tok2\",\"expires_in\":3600}", Map.of());
        };

        LegacyAuthPasswordAuthenticator auth = new LegacyAuthPasswordAuthenticator(
                "https://api.example.com", "my-client-id", "my-client-secret",
                "testuser", "testpass");
        auth.setApiClient(client);
