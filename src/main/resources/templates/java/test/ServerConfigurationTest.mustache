package {{invokerPackage}};

import static org.junit.jupiter.api.Assertions.assertThrows;

import {{invokerPackage}}.errors.{{errorPrefix}}Exception;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertThrowsExactly;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;

class ServerConfigurationTest {

    @Test
    void bhvServers009ResolvesUrlTemplateUsingDefaultVariableValues() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com/v{version}",
                        "primary server",
                        Map.of(
                                "env", new ServerVariable("prod", null, List.of("prod", "staging")),
                                "version", new ServerVariable("1", null, List.of())));

        assertEquals("https://prod.api.example.com/v1", config.getUrl());
    }
    @Test
    void bhvServers028GeneratedServerListCannotBeChangedAfterCreation() {
        org.junit.jupiter.api.Assertions.assertThrows(UnsupportedOperationException.class, () -> Servers.ALL.add(Servers.ALL.get(0)));
    }


    @Test
    void bhvServers001PartialOverrideKeepsTheOtherVariablesDefaults() {
        // "env" is overridden, "version" is left to its default — the resolved
        // URL must mix both.
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com/v{version}",
                        null,
                        Map.of(
                                "env", new ServerVariable("prod", null, List.of("prod", "staging")),
                                "version", new ServerVariable("1", null, List.of())));

        assertEquals(
                "https://staging.api.example.com/v1",
                config.getUrl(Map.of("env", "staging")));
    }

    @Test
    void bhvServers006ExposesRawUrlTemplateAndDescription() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        "primary server",
                        Map.of("env", new ServerVariable("prod", null, List.of())));

        assertEquals("https://{env}.api.example.com", config.getUrlTemplate());
        assertEquals("primary server", config.getDescription());
    }

    @Test
    void bhvServers008RejectsOverrideValueOutsideTheVariableEnum() {
        // server-variable-enum-validation: an override that is not in the
        // variable's enum is rejected at resolution time.
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        null,
                        Map.of(
                                "env",
                                new ServerVariable("prod", null, List.of("prod", "staging"))));

        IllegalArgumentException ex = assertThrowsExactly(
                IllegalArgumentException.class,
                () -> config.getUrl(Map.of("env", "dev")));
        // A server variable outside its enum is a caller mistake, not an SDK error.
        assertFalse(((Object) ex) instanceof {{errorPrefix}}Exception);
        assertEquals(
                "Invalid value 'dev' for server variable 'env'. Allowed values: [prod, staging]",
                ex.getMessage());
    }

    @Test
    void bhvServers004RejectsADefaultValueOutsideTheVariableEnum() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        null,
                        Map.of("env", new ServerVariable("dev", null, List.of("prod"))));

        IllegalArgumentException ex =
                assertThrowsExactly(IllegalArgumentException.class, config::getUrl);
        assertEquals(
                "Invalid value 'dev' for server variable 'env'. Allowed values: [prod]",
                ex.getMessage());
    }

    @Test
    void bhvServers014VariableWithoutAnEnumAcceptsAnyOverride() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        null,
                        Map.of("env", new ServerVariable("prod", null, List.of())));

        assertEquals(
                "https://anything-goes.api.example.com",
                config.getUrl(Map.of("env", "anything-goes")));
    }

    @Test
    void bhvServers011TemplateWithoutVariablesIsReturnedUnchanged() {
        ServerConfiguration config =
                new ServerConfiguration("https://api.example.com/v1", null, Map.of());

        assertEquals("https://api.example.com/v1", config.getUrl());
        assertEquals("https://api.example.com/v1", config.getUrl(Map.of("env", "staging")));
    }

    @Test
    void bhvServers002ReplacesAVariableRepeatedInTheTemplateEverywhere() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{region}.cdn.example.com/{region}/v1",
                        null,
                        Map.of("region", new ServerVariable("eu", null, List.of("eu", "us"))));

        assertEquals("https://eu.cdn.example.com/eu/v1", config.getUrl());
        assertEquals(
                "https://us.cdn.example.com/us/v1", config.getUrl(Map.of("region", "us")));
    }

    @Test
    void bhvServers005DoesNotExpandAPlaceholderThatASubstitutedValueIntroduces() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com/{version}",
                        null,
                        Map.of(
                                "env", new ServerVariable("prod", null, List.of()),
                                "version", new ServerVariable("v1", null, List.of())));

        assertEquals(
                "https://{version}.api.example.com/v2",
                config.getUrl(Map.of("env", "{version}", "version", "v2")));
    }

    @Test
    void bhvServers007LeavesAnUnknownPlaceholderInTheTemplateUntouched() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com/{other}",
                        null,
                        Map.of("env", new ServerVariable("prod", null, List.of())));

        assertEquals("https://prod.api.example.com/{other}", config.getUrl());
    }

    @Test
    void bhvServers025CopiesTheCallersVariablesMapAtConstruction() {
        java.util.Map<String, ServerVariable> source = new java.util.HashMap<>();
        source.put("env", new ServerVariable("prod", null, List.of()));
        ServerConfiguration config =
                new ServerConfiguration("https://{env}.api.example.com", null, source);

        source.put("env", new ServerVariable("other", null, List.of()));
        source.put("extra", new ServerVariable("x", null, List.of()));

        assertEquals("https://prod.api.example.com", config.getUrl());
        assertEquals(1, config.getVariables().size());
    }

    @Test
    void bhvServers026CopiesTheCallersEnumListAtConstruction() {
        java.util.List<String> allowed = new java.util.ArrayList<>(List.of("prod"));
        ServerVariable variable = new ServerVariable("prod", null, allowed);
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com", null, Map.of("env", variable));

        allowed.add("dev");

        assertEquals(List.of("prod"), variable.getEnumValues());
        assertThrowsExactly(
                IllegalArgumentException.class, () -> config.getUrl(Map.of("env", "dev")));
    }

    @Test
    void bhvServers003AcceptsAnOverrideThatIsInTheVariableEnum() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        null,
                        Map.of(
                                "env",
                                new ServerVariable("prod", null, List.of("prod", "staging"))));

        assertEquals(
                "https://staging.api.example.com", config.getUrl(Map.of("env", "staging")));
    }

    @Test
    void bhvServers010SubstitutesVariablesWithTheirDefaultValues() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com/v{version}",
                        null,
                        Map.of(
                                "env", new ServerVariable("staging", null, List.of("prod", "staging")),
                                "version", new ServerVariable("2", null, List.of())));

        assertEquals("https://staging.api.example.com/v2", config.getUrl(Map.of()));
    }

    @Test
    void bhvServers012RejectionNamesTheValueVariableAndAllowedValues() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{region}.cdn.example.com",
                        null,
                        Map.of("region", new ServerVariable("eu", null, List.of("eu", "us"))));

        IllegalArgumentException ex =
                assertThrowsExactly(
                        IllegalArgumentException.class,
                        () -> config.getUrl(Map.of("region", "ap")));
        assertEquals(
                "Invalid value 'ap' for server variable 'region'. Allowed values: [eu, us]",
                ex.getMessage());
    }

    @Test
    void bhvServers015AllowsANullDescription() {
        ServerConfiguration config =
                new ServerConfiguration("https://api.example.com", null, Map.of());

        assertNull(config.getDescription());
        assertEquals("https://api.example.com", config.getUrl());
    }

    @Test
    void bhvServers013TheThirdGlobalServerKeepsItsHostileTextUnchanged() {
        ServerConfiguration server = Servers.SERVER_2;

        assertEquals("https://{tenant}.example.com/api", server.getUrlTemplate());
        assertEquals("Bob's \"sandbox\" & co: $5 #{x} a*/b", server.getDescription());
        ServerVariable tenant = java.util.Objects.requireNonNull(server.getVariables().get("tenant"));
        assertEquals("o'neil", tenant.getDefaultValue());
        assertEquals("Tenant's \"id\"", tenant.getDescription());
        assertEquals(List.of("o'neil", "a&b"), tenant.getEnumValues());
    }

    @Test
    void bhvServers020AServerVariableValueOutsideItsEnumIsRejectedWithItsName() {
        ServerConfiguration server = Servers.SERVER_2;

        IllegalArgumentException ex = assertThrowsExactly(IllegalArgumentException.class,
                () -> server.getUrl(Map.of("tenant", "dev")));
        assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains("'dev' for server variable 'tenant'"));
    }

    @Test
    void bhvServers021ASpecialCharacterDefaultAndEnumValueResolvesRaw() {
        ServerConfiguration server = Servers.SERVER_2;

        assertEquals("https://o'neil.example.com/api", server.getUrl());
        assertEquals("https://a&b.example.com/api", server.getUrl(Map.of("tenant", "a&b")));
    }

    @Test
    void bhvServers023AReplacementPatternInAValueIsSubstitutedLiterally() {
        ServerConfiguration config =
                new ServerConfiguration(
                        "https://{env}.api.example.com",
                        null,
                        Map.of("env", new ServerVariable("api", null, List.of())));

        assertEquals("https://$1$&$$.api.example.com", config.getUrl(Map.of("env", "$1$&$$")));
    }
}
