package {{invokerPackage}};

import {{invokerPackage}}.errors.ApiException;
import {{invokerPackage}}.errors.NetworkException;
import {{invokerPackage}}.errors.SerializationException;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertInstanceOf;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.function.Function;
import org.junit.jupiter.api.Test;

/** The line splitter, the server-sent events parser and the two stream types over canned bytes. */
@SuppressWarnings("NullAway")
class EventStreamTest {

    private static ByteStream bytes(String text) {
        return new ByteStream(
                200,
                Map.of("content-type", "text/event-stream"),
                new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8)));
    }

    private static List<EventStream.RawEvent> parse(String text) throws IOException {
        EventStream.SseParser parser =
                new EventStream.SseParser(
                        new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8)), 1024, null);
        List<EventStream.RawEvent> events = new ArrayList<>();
        for (EventStream.RawEvent event = parser.next(); event != null; event = parser.next()) {
            events.add(event);
        }
        return events;
    }

    private static List<String> lines(String text) {
        try (JsonLinesStream<String> stream =
                new JsonLinesStream<>(bytes(text), line -> line, 1024, "GET", "/items")) {
            List<String> items = new ArrayList<>();
            stream.forEachRemaining(items::add);
            return items;
        }
    }

    /** Opens an event stream whose n-th connection (from 1) is the n-th script entry. */
    private static final class Script implements Function<String, ByteStream> {
        final List<Object> connections;
        final List<String> lastIds = new ArrayList<>();

        Script(Object... connections) {
            this.connections = List.of(connections);
        }

        @Override
        public ByteStream apply(String lastEventId) {
            lastIds.add(lastEventId);
            Object next = connections.get(Math.min(lastIds.size(), connections.size()) - 1);
            if (next instanceof RuntimeException failure) {
                throw failure;
            }
            if (next instanceof ByteStream stream) {
                return stream;
            }
            return bytes((String) next);
        }
    }

    private static ByteStream noContent() {
        return new ByteStream(204, Map.of(), new ByteArrayInputStream(new byte[0]));
    }

    private static StreamOptions fast() {
        return new StreamOptions().reconnectDelay(1);
    }

    private static <T> SseStream<T> sse(Function<String, ByteStream> opener, StreamOptions options) {
        return SseStream.open(opener, null, null, options, false, "GET", "/events");
    }

    private static List<String> dataOf(SseStream<String> stream) {
        List<String> data = new ArrayList<>();
        stream.forEachRemaining(event -> data.add(event.data()));
        return data;
    }

    @Test
    void bhvStreaming002AJsonLinesStreamYieldsOneDecodedItemPerLineAndSkipsBlankLines() {
        assertEquals(List.of("a", "b", "c"), lines("a\n\n  \nb\nc\n"));
    }

    @Test
    void bhvStreaming003AJsonLinesStreamAcceptsCrlfLineEndsAndALastLineWithoutANewline() {
        assertEquals(List.of("a", "b", "c"), lines("a\r\nb\r\nc"));
    }

    @Test
    void bhvStreaming004AJsonLinesLineThatDoesNotDecodeNamesItsLineAndEndsTheStream() {
        JsonLinesStream<Integer> stream =
                new JsonLinesStream<>(
                        bytes("1\n2\nnope\n4\n"),
                        line -> {
                            try {
                                return Integer.parseInt(line);
                            } catch (NumberFormatException failure) {
                                throw new SerializationException("not a number", failure);
                            }
                        },
                        1024,
                        "GET",
                        "/items");
        assertEquals(1, stream.next());
        assertEquals(2, stream.next());
        SerializationException failure = assertThrows(SerializationException.class, stream::next);
        assertTrue(failure.getMessage().contains("Line 3"), failure.getMessage());
        assertFalse(stream.hasNext(), "the stream ended at the bad line");
    }

    @Test
    void bhvStreaming005ALineOrEventLongerThanTheLimitRaisesASerializationErrorAndEndsTheStream() {
        JsonLinesStream<String> lineStream =
                new JsonLinesStream<>(bytes("ok\n" + "x".repeat(50) + "\nlater\n"), line -> line, 10, "GET", "/items");
        assertEquals("ok", lineStream.next());
        assertThrows(SerializationException.class, lineStream::hasNext);
        assertFalse(lineStream.hasNext());

        SseStream<String> events =
                sse(new Script("data: " + "y".repeat(50) + "\n\n"), new StreamOptions().maxEventBytes(10));
        assertThrows(SerializationException.class, events::hasNext);
        assertFalse(events.hasNext());
    }

    @Test
    void bhvSse001AnSseStreamYieldsTheIdEventDataAndRetryFieldsOfEachEventWithMessageAsTheDefault()
            throws IOException {
        List<EventStream.RawEvent> events =
                parse("id: 7\nevent: tick\nretry: 250\ndata: one\n\ndata: two\n\n");
        assertEquals(2, events.size());
        assertEquals(new EventStream.RawEvent("7", "tick", "one", 250L), events.get(0));
        assertEquals("message", events.get(1).event());
        assertEquals("two", events.get(1).data());
        assertEquals("7", events.get(1).id(), "the id persists until another arrives");

        SseStream<String> stream = sse(new Script("id: 7\nevent: tick\nretry: 250\ndata: one\n\n"), fast());
        ServerSentEvent<String> event = stream.next();
        assertEquals("7", event.id());
        assertEquals("tick", event.event());
        assertEquals("one", event.data());
        assertEquals(250L, event.retry());
        assertEquals("one", event.raw());
    }

    @Test
    void bhvSse002AnSseStreamJoinsConsecutiveDataLinesWithANewlineAndSkipsCommentLines()
            throws IOException {
        List<EventStream.RawEvent> events = parse(": a comment\ndata: one\n: another\ndata: two\n\n");
        assertEquals(1, events.size());
        assertEquals("one\ntwo", events.get(0).data());
    }

    @Test
    void bhvSse003AnSseStreamDropsAByteOrderMarkAcceptsEveryLineEndAndRemovesOneSpaceAfterTheColon()
            throws IOException {
        for (String end : List.of("\n", "\r", "\r\n")) {
            List<EventStream.RawEvent> events = parse("﻿data: a" + end + "data:  b" + end + end);
            assertEquals(1, events.size(), "line end " + end.replace("\r", "CR").replace("\n", "LF"));
            assertEquals("a\n b", events.get(0).data());
        }
        assertEquals("x", parse("data:x\n\n").get(0).data(), "no space to remove");
    }

    @Test
    void bhvSse004AnSseEventWithAnEmptyDataBufferIsNotDeliveredButItsIdIsKept() throws IOException {
        EventStream.SseParser parser =
                new EventStream.SseParser(
                        new ByteArrayInputStream("id: 9\n\n".getBytes(StandardCharsets.UTF_8)), 1024, null);
        assertNull(parser.next());
        assertEquals("9", parser.lastEventId());
    }

    @Test
    void bhvSse005AnSseDataPayloadIsDecodedAndAPayloadThatDoesNotDecodeRaisesASerializationErrorAndEndsTheStream() {
        Function<String, Integer> number =
                data -> {
                    try {
                        return Integer.parseInt(data);
                    } catch (NumberFormatException failure) {
                        throw new SerializationException("not a number", failure);
                    }
                };
        SseStream<Integer> stream =
                SseStream.open(
                        new Script("data: 1\n\ndata: oops\n\ndata: 3\n\n"),
                        number, null, fast(), false, "GET", "/events");
        assertEquals(1, stream.next().data());
        assertThrows(SerializationException.class, stream::next);
        assertFalse(stream.hasNext());
    }

    @Test
    void bhvSse008AnSseReconnectWaitsTheServerRetryValueElseTheReconnectDelayDoublingToACap() {
        assertEquals(250L, SseStream.reconnectWaitMillis(3, 1000, 250L, null, 0.0));
        assertEquals(1000L, SseStream.reconnectWaitMillis(1, 1000, null, null, 0.0));
        assertEquals(2000L, SseStream.reconnectWaitMillis(2, 1000, null, null, 0.0));
        assertEquals(4000L, SseStream.reconnectWaitMillis(3, 1000, null, null, 0.0));
        assertEquals(30_000L, SseStream.reconnectWaitMillis(10, 1000, null, null, 0.0));
        assertEquals(750L, SseStream.reconnectWaitMillis(1, 1000, null, null, 1.0), "jitter takes up to 25%");
        assertEquals(5000L, SseStream.reconnectWaitMillis(1, 1000, null, 5000L, 0.0), "Retry-After replaces it");
    }

    @Test
    void bhvSse009AnSseGetStreamStopsAfterFiveFailedReconnectsByDefaultAndRaisesTheLastFailure() {
        Script script = new Script("");
        SseStream<String> stream = sse(script, fast());
        assertThrows(NetworkException.class, stream::hasNext);
        assertEquals(6, script.lastIds.size(), "one request and five reconnects");
    }

    @Test
    void bhvSse010AnSseReconnectCounterResetsAfterAnEventIsReceived() {
        Script script = new Script("data: a\n\n", "data: b\n\n", "data: c\n\n", "");
        SseStream<String> stream = sse(script, new StreamOptions().reconnectDelay(1).maxReconnects(1));
        List<String> seen = new ArrayList<>();
        assertThrows(NetworkException.class, () -> stream.forEachRemaining(event -> seen.add(event.data())));
        assertEquals(List.of("a", "b", "c"), seen, "three events survived a limit of one reconnect");
    }

    @Test
    void bhvSse011AnSseStreamDoesNotReconnectAfterA204A4xxStatusOrAResponseThatIsNotAnEventStream() {
        Script none = new Script(new ByteStream(204, Map.of(), new ByteArrayInputStream(new byte[0])));
        assertEquals(List.of(), dataOf(sse(none, fast())));
        assertEquals(1, none.lastIds.size());

        Script refused = new Script("data: a\n\n", new ApiException(404, "missing", Map.of(), "{}"));
        ApiException failure =
                assertThrows(ApiException.class, () -> dataOf(sse(refused, fast())));
        assertEquals(404, failure.getStatusCode());

        Script wrongType =
                new Script(
                        "data: a\n\n",
                        new ByteStream(
                                200,
                                Map.of("content-type", "text/html"),
                                new ByteArrayInputStream(new byte[0])));
        assertThrows(SerializationException.class, () -> dataOf(sse(wrongType, fast())));
        assertEquals(2, wrongType.lastIds.size(), "asked once more, then refused the answer");
    }

    @Test
    void bhvSse014AnSseRetryFieldThatIsNotDigitsAndAnIdContainingNulAreIgnored() throws IOException {
        EventStream.SseParser parser =
                new EventStream.SseParser(
                        new ByteArrayInputStream(
                                "retry: 12x\nid: a\0b\ndata: x\n\n".getBytes(StandardCharsets.UTF_8)),
                        1024,
                        null);
        EventStream.RawEvent event = parser.next();
        assertEquals("x", event.data());
        assertNull(event.id());
        assertNull(parser.retry());
    }

    @Test
    void bhvSse016AnSseRequestWithABodyIsNotReconnectedUnlessTheCallerTurnsReconnectOn() {
        Script off = new Script("data: a\n\n", "data: b\n\n");
        SseStream<String> noReconnect =
                SseStream.open(off, null, null, fast(), true, "POST", "/events");
        assertEquals(List.of("a"), dataOf(noReconnect));
        assertEquals(1, off.lastIds.size());

        Script on = new Script("data: a\n\n", "data: b\n\n", new ByteStream(204, Map.of(), new ByteArrayInputStream(new byte[0])));
        SseStream<String> reconnect =
                SseStream.open(on, null, null, new StreamOptions().reconnectDelay(1).maxReconnects(2), true, "POST", "/events");
        assertEquals(List.of("a", "b"), dataOf(reconnect));
    }

    @Test
    void bhvSse017AnSseEventWithAnIdAndNoDataIsNotDispatchedButUpdatesTheLastEventIdAndAReconnectResumesFromIt() {
        Script script = new Script("data: a\nid: 1\n\nid: 2\n\n", "data: b\nid: 3\n\n", noContent());
        SseStream<String> stream = sse(script, fast());
        assertEquals(List.of("a", "b"), dataOf(stream));
        assertEquals(List.of("", "2"), script.lastIds.subList(0, 2));
    }

    @Test
    void bhvSse019AnSseEventCutOffByTheEndOfTheConnectionIsDiscarded() throws IOException {
        List<EventStream.RawEvent> events = parse("data: whole\n\ndata: cut off\n");
        assertEquals(1, events.size());
        assertEquals("whole", events.get(0).data());
        assertTrue(parse("data: no newline at all").isEmpty());
    }

    @Test
    void bhvSse021TheConfiguredSseTerminatorEndsTheStreamAndIsNotDelivered() {
        SseStream<String> stream =
                SseStream.open(
                        new Script("data: a\n\ndata: [DONE]\n\ndata: b\n\n"),
                        null, "[DONE]", fast(), false, "GET", "/events");
        assertEquals(List.of("a"), dataOf(stream));
    }

    @Test
    void bhvSse022AnSseEventNamedErrorRaisesTheApiErrorWithTheStatusAndDataAndAnyOtherNameIsAnItem() {
        Script script = new Script("event: update\ndata: fine\n\nevent: error\ndata: {\"why\":\"bad\"}\n\n", "data: again\n\n");
        SseStream<String> stream = sse(script, fast());
        assertEquals("update", stream.next().event());
        ApiException failure = assertThrows(ApiException.class, stream::next);
        assertEquals(200, failure.getStatusCode());
        assertEquals("{\"why\":\"bad\"}", failure.getResponseBody());
        assertEquals(1, script.lastIds.size(), "an error event is not reconnected");
        assertInstanceOf(ApiException.class, failure);
    }

    @Test
    void bhvSse023AnUnknownSseFieldIsIgnored() throws IOException {
        List<EventStream.RawEvent> events = parse("mystery: 1\ndata: x\nanother\n\n");
        assertEquals(1, events.size());
        assertEquals("x", events.get(0).data());
    }
}
