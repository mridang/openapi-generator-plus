    }

    @Nested
    @DisplayName("DiscriminatorAutoInjectionTests")
    class DiscriminatorAutoInjectionTests {

        {{! Gap K — a subtype constructed without the discriminator must still }}
        {{! emit it on serialize because the generated model defaults the field }}
        {{! to its oneOf mapping value (foodType = "dry"/"wet"). }}
        @Test
        @DisplayName("dry subtype serialization includes discriminator without caller setting it")
        void drySubtypeAutoEmitsDiscriminator() {
            {{modelPackage}}.DryFood dry = new {{modelPackage}}.DryFood(2.5);
            String json = serializer.serialize(dry);
            assertTrue(json.contains("\"foodType\":\"dry\""),
                    "serialized JSON must contain auto-injected discriminator, got: " + json);
            assertTrue(json.contains("\"weightKg\":2.5"), "should contain weightKg, got: " + json);
        }

        @Test
        @DisplayName("wet subtype defaults discriminator to its mapping name")
        void wetSubtypeAutoEmitsDiscriminator() {
            {{modelPackage}}.WetFood wet = new {{modelPackage}}.WetFood(350);
            String json = serializer.serialize(wet);
            assertTrue(json.contains("\"foodType\":\"wet\""),
                    "serialized JSON must contain auto-injected discriminator, got: " + json);
        }

        @Test
        @DisplayName("deserializing the oneOf parent routes to the subtype by discriminator")
        void deserializeParentRoutesToSubtype() {
            // A discriminator-tagged payload deserialized against the parent
            // PetFood type must come back as the concrete DryFood subtype via
            // Jackson @JsonSubTypes routing on foodType="dry".
            String json = "{\"foodType\":\"dry\",\"weightKg\":2.5}";
            {{modelPackage}}.PetFood food =
                    java.util.Objects.requireNonNull(
                            serializer.deserialize(
                                    json,
                                    new com.fasterxml.jackson.core.type.TypeReference<
                                            {{modelPackage}}.PetFood>() {}.getType()));
            assertTrue(food instanceof {{modelPackage}}.DryFood,
                    "deserialized PetFood should be a DryFood, got: " + food.getClass());
            assertEquals(2.5, (({{modelPackage}}.DryFood) food).weightKg);
        }

        @Test
        @DisplayName("missing discriminator property throws (Gap AU-residual)")
        void missingDiscriminatorThrows() {
            // Gap AU-residual: a PetFood payload missing the foodType
            // discriminator property ({"weightKg":5.0}) must throw rather than
            // be silently wrapped as a raw dict in a union container. With no
            // foodType, Jackson cannot resolve the @JsonSubTypes mapping and
            // surfaces a SerializationException. (python/php were the divergent
            // SDKs; Java already throws -> this guard is green here.)
            assertThrows(ObjectSerializer.SerializationException.class, () ->
                serializer.deserialize(
                    "{\"weightKg\":5.0}",
                    new com.fasterxml.jackson.core.type.TypeReference<
                            {{modelPackage}}.PetFood>() {}.getType()));
        }
    }

    @Nested
