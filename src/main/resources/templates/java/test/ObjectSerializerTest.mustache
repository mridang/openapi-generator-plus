    /*
     * Byte-array equality across the three shapes a property can take. Java
     * compares arrays by identity, so a model holding bytes would otherwise
     * report two instances carrying the same content as unequal — and would
     * misbehave as a map or set key. The MAP case is the one that regressed:
     * the template once selected a deep-array comparison for it and emitted a
     * Collection call on a Map, which did not compile; the fix that restored
     * compilation then silently fell back to identity for the values.
     *
     * The fixture model carries all three deliberately: a bare byte[], a list
     * of them, and a map of them.
     */
    @Nested
    @DisplayName("generated equality compares array content, not identity")
    class ByteArrayEquality {

        private {{modelPackage}}.BinaryVault vaultWithFreshArrays() {
            java.util.Map<String, byte[]> labels = new java.util.HashMap<>();
            labels.put("first", new byte[] {7, 8});
            return {{modelPackage}}.BinaryVault.builder()
                    .seal(new byte[] {1, 2, 3})
                    .shards(List.of(new byte[] {4, 5}, new byte[] {6}))
                    .labels(labels)
                    .build();
        }

        private java.util.Map<String, byte[]> labelsOf({{modelPackage}}.BinaryVault vault) {
            java.util.Map<String, byte[]> labels = vault.labels;
            assertNotNull(labels, "fixture must populate labels");
            return labels;
        }

        @Test
        @DisplayName("bhvSerializationObject090 instances holding equal content are equal though every array is distinct")
        void bhvSerializationObject090EqualContentDistinctArraysCompareEqual() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right = vaultWithFreshArrays();

            /* Every array in the two models is a separate object, so identity
               comparison would fail here on all three properties. */
            assertNotSame(left.seal, right.seal);
            assertNotSame(labelsOf(left).get("first"), labelsOf(right).get("first"));

            assertEquals(left, right, "models holding identical bytes must compare equal");
            assertEquals(
                    left.hashCode(),
                    right.hashCode(),
                    "models that compare equal must hash equal, or they break as map keys");
        }

        @Test
        @DisplayName("bhvSerializationObject075 a differing byte in the bare array makes them unequal")
        void bhvSerializationObject075DifferingBareArrayCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays().toBuilder().seal(new byte[] {1, 2, 4}).build();

            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("bhvSerializationObject009 a differing byte inside the list makes them unequal")
        void bhvSerializationObject009DifferingListElementCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .shards(List.of(new byte[] {4, 5}, new byte[] {9}))
                            .build();

            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("bhvSerializationObject005 a differing byte inside a map VALUE makes them unequal")
        void bhvSerializationObject005DifferingMapValueCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .labels(java.util.Map.of("first", new byte[] {7, 9}))
                            .build();

            /* Identity comparison of map values would call these equal, since
               the maps have the same keys and Objects.equals stops at the
               array reference. */
            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("a differing map KEY makes them unequal")
        void differingMapKeyCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .labels(java.util.Map.of("second", new byte[] {7, 8}))
                            .build();

            assertNotEquals(left, right);
        }
    }

    @Nested
    @DisplayName("CanonicalSerdeBehaviours")
    class CanonicalSerdeBehaviours {

        // NaN/Infinity on ENCODE must reject with the SDK's SerializationException
        // (RFC 8259 §6 has no such token). Jackson's default QUOTE_NON_NUMERIC_NUMBERS
        // would emit the quoted strings "NaN"/"Infinity"; the serializer rejects them
        // instead, matching python (allow_nan=False), go, node, rust and the rest.
        @Test
        @DisplayName("bhvSerializationObject153 serializing a non-finite double throws SerializationException")
        void bhvSerializationObject153NonFiniteDoubleThrowsOnSerialize() {
            assertThrows(SerializationException.class, () -> serializer.serialize(Double.NaN));
            assertThrows(SerializationException.class,
                    () -> serializer.serialize(Double.POSITIVE_INFINITY));
            assertThrows(SerializationException.class,
                    () -> serializer.serialize(Double.NEGATIVE_INFINITY));
        }

        @Test
        @DisplayName("bhvSerializationObject057 an overflowing float or double literal throws SerializationException")
        void bhvSerializationObject057OverflowingNumberLiteralIsRejected() {
            for (String body : new String[] {"1e400", "-1e400"}) {
                assertThrows(SerializationException.class,
                        () -> serializer.deserialize(body, Double.class), body);
                assertThrows(SerializationException.class,
                        () -> serializer.deserialize(body, double.class), body);
            }
            assertThrows(SerializationException.class,
                    () -> serializer.deserialize("1e40", Float.class));
            assertThrows(SerializationException.class,
                    () -> serializer.deserialize(
                            "[1.5,1e400]",
                            new com.fasterxml.jackson.core.type.TypeReference<List<Double>>() {}.getType()));
            assertEquals(1e308, serializer.<Double>deserialize("1e308", Double.class));
            assertEquals(1.5f, serializer.<Float>deserialize("1.5", Float.class));
        }

        @Test
        @DisplayName("bhvSerializationObject122 a wrong-typed value in a map of integers throws SerializationException")
        void bhvSerializationObject122WrongTypedMapValueThrows() {
            for (String body : new String[] {"{\"a\":2.5}", "{\"a\":\"2\"}", "{\"a\":3000000000}"}) {
                assertThrows(SerializationException.class, () ->
                    serializer.deserialize(
                        body,
                        new com.fasterxml.jackson.core.type.TypeReference<java.util.Map<String, Integer>>() {}.getType()),
                    body);
            }
        }

        // A bare JSON null body decoded to a model type returns null, not a
        // partial object or an error.
        @Test
        @DisplayName("bhvSerializationObject067 a literal null body deserializes to null")
        void bhvSerializationObject067LiteralNullBodyDeserializesToNull() {
            assertNull(serializer.deserialize(
                    "null",
                    new com.fasterxml.jackson.core.type.TypeReference<
                            {{modelPackage}}.Category>() {}.getType()));
        }

        // A format:byte model field (PetPassport.thumbnail) carrying a
        // bad-alphabet base64 string must be rejected: Jackson's byte[] decoder
        // throws rather than silently truncating, and ObjectSerializer surfaces
        // it as the SDK's SerializationException.
        @Test
        @DisplayName("bhvSerializationObject094 invalid base64 in a byte field throws SerializationException")
        void bhvSerializationObject094InvalidBase64ByteFieldThrowsSerializationException() {
            assertThrows(SerializationException.class, () ->
                    serializer.deserialize("{\"thumbnail\":\"!!!!\"}",
                            new com.fasterxml.jackson.core.type.TypeReference<
                                    {{modelPackage}}.PetPassport>() {}.getType()));
        }

        // A payload nested ~600 deep decodes fine; ~1500 deep exceeds the 1000
        // maxNestingDepth cap and is rejected (Jackson StreamReadConstraints,
        // surfaced as the SDK's SerializationException).
        @Test
        @DisplayName("bhvSerializationObject051 deep JSON within the depth cap decodes; past it is rejected")
        void bhvSerializationObject051DeepJsonDepthCap() {
            java.lang.reflect.Type objectType =
                    new com.fasterxml.jackson.core.type.TypeReference<Object>() {}.getType();
            assertNotNull(serializer.deserialize("[".repeat(600) + "]".repeat(600), objectType));
            SerializationException tooDeep = assertThrows(SerializationException.class,
                    () -> serializer.deserialize("[".repeat(1500) + "]".repeat(1500), objectType));
            assertEquals("JSON nesting depth 1001 exceeds limit 1000", tooDeep.getMessage());
        }

        @Test
        @DisplayName("bhvSerializationObject004 malformed JSON reports the canonical deserialize message")
        void bhvSerializationObject004MalformedJsonReportsTheCanonicalMessage() {
            java.lang.reflect.Type objectType =
                    new com.fasterxml.jackson.core.type.TypeReference<Object>() {}.getType();
            SerializationException ex = assertThrows(SerializationException.class,
                    () -> serializer.deserialize("{\"a\":", objectType));
            String message = String.valueOf(ex.getMessage());
            assertTrue(message.startsWith("Failed to deserialize JSON: "), message);
        }

        /* Containers of byte arrays must print their content, not identity. */
        @Test
        @DisplayName("structuralToString dumps byte lists and maps by content")
        void structuralToStringDumpsContainersByContent() {
            assertEquals(
                    "[[1, 2], [3]]",
                    ObjectSerializer.structuralToString(
                            java.util.List.of(new byte[] {1, 2}, new byte[] {3})));
            assertEquals(
                    "{a=[1]}",
                    ObjectSerializer.structuralToString(java.util.Map.of("a", new byte[] {1})));
            assertEquals("null", ObjectSerializer.structuralToString(null));
        }
    }

