        @Test
        @DisplayName("bhvSerializationObject079 format:byte scalar and array fields round-trip through base64")
        void bhvSerializationObject079ByteScalarAndArrayRoundTripThroughBase64() {
            {{modelPackage}}.PetPassport passport = java.util.Objects.requireNonNull(serializer.deserialize(
                "{\"thumbnail\":\"dGVzdA==\",\"scans\":[\"aGk=\"]}", {{modelPackage}}.PetPassport.class));
            assertEquals("test", new String(
                java.util.Objects.requireNonNull(passport.thumbnail), java.nio.charset.StandardCharsets.UTF_8));
            assertTrue(Arrays.equals(new byte[] {0x68, 0x69},
                java.util.Objects.requireNonNull(passport.scans).get(0)));
            String written = serializer.serialize(passport);
            assertTrue(written.contains("\"thumbnail\":\"dGVzdA==\""), written);
            assertTrue(written.contains("\"scans\":[\"aGk=\"]"), written);
        }

