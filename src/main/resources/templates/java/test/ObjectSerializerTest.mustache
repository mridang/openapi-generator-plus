    @Nested
    @DisplayName("DecimalNumberSerializationTests")
    class DecimalNumberSerializationTests {

        {{! Wave B — a `type: number` property with no `format` (Pet.weightKg) is }}
        {{! modeled as BigDecimal for arbitrary-precision fidelity, but it must }}
        {{! serialize as an UNQUOTED JSON number (1.5), not a string ("1.5"), to }}
        {{! honour the spec's `type: number`. Jackson emits BigDecimal as a bare }}
        {{! number by default, so Java is already correct — this guard pins it. }}
        @Test
        @DisplayName("bhvSerializationObject171 type:number BigDecimal field serializes as an unquoted JSON number")
        void bhvSerializationObject171DecimalWeightSerializesAsNumber() {
            {{modelPackage}}.Pet pet =
                    new {{modelPackage}}.Pet("Rex", java.util.Set.of("http://example.com/p.png"))
                            .toBuilder().weightKg(new java.math.BigDecimal("1.5")).build();
            String json = serializer.serialize(pet);
            assertTrue(json.contains("\"weightKg\":1.5"),
                    "weightKg must be an unquoted number, got: " + json);
            assertFalse(json.contains("\"weightKg\":\"1.5\""),
                    "weightKg must not be a quoted string, got: " + json);
        }

        {{! The same field must survive a serialize -> deserialize round-trip as a }}
        {{! numeric BigDecimal, never degrading to a string-typed value. }}
        @Test
        @DisplayName("bhvSerializationObject177 type:number BigDecimal field round-trips as a number")
        void bhvSerializationObject177DecimalWeightRoundTrips() {
            {{modelPackage}}.Pet pet =
                    new {{modelPackage}}.Pet("Rex", java.util.Set.of("http://example.com/p.png"))
                            .toBuilder().weightKg(new java.math.BigDecimal("1.5")).build();
            String json = serializer.serialize(pet);
            {{modelPackage}}.Pet back =
                    java.util.Objects.requireNonNull(
                            serializer.deserialize(
                                    json,
                                    new com.fasterxml.jackson.core.type.TypeReference<
                                            {{modelPackage}}.Pet>() {}.getType()));
            assertEquals(0, new java.math.BigDecimal("1.5").compareTo(back.weightKg),
                    "weightKg must round-trip as numeric 1.5, got: " + back.weightKg);
        }

        @Test
        @DisplayName("models decoded from 1.5 and 1.50 are equal and hash alike")
        void decimalScaleDoesNotAffectModelEquality() {
            String prefix = "{\"name\":\"Rex\",\"photoUrls\":[\"u\"],\"weightKg\":";
            {{modelPackage}}.Pet one = serializer.deserialize(prefix + "1.5}", {{modelPackage}}.Pet.class);
            {{modelPackage}}.Pet two = serializer.deserialize(prefix + "1.50}", {{modelPackage}}.Pet.class);
            assertNotNull(one);
            assertNotNull(two);
            assertEquals(one, two);
            assertEquals(one.hashCode(), two.hashCode());
        }

        @Test
        @DisplayName("models decoded from different decimals stay unequal")
        void differentDecimalsStayUnequal() {
            String prefix = "{\"name\":\"Rex\",\"photoUrls\":[\"u\"],\"weightKg\":";
            {{modelPackage}}.Pet one = serializer.deserialize(prefix + "1.5}", {{modelPackage}}.Pet.class);
            {{modelPackage}}.Pet two = serializer.deserialize(prefix + "1.51}", {{modelPackage}}.Pet.class);
            assertNotEquals(one, two);
        }
    }

