    @Nested
    @DisplayName("DateTimeOffsetPreservationTests")
    class DateTimeOffsetPreservationTests {

        @Test
        @DisplayName("bhvSerializationObject174 UTC datetime serializes containing date-time and offset")
        void bhvSerializationObject174UtcDateTimeSerializesWithOffset() {
            OffsetDateTime dt = OffsetDateTime.parse("2024-01-01T12:30:45+00:00");
            String result = ObjectSerializer.stringify(dt);
            assertEquals("2024-01-01T12:30:45.000+00:00", result);
        }

        @Test
        @DisplayName("bhvSerializationObject107 datetime with +05:30 offset preserves offset in serialized string")
        void bhvSerializationObject107PositivOffsetPreserved() {
            OffsetDateTime dt = OffsetDateTime.parse("2024-01-01T12:30:45+05:30");
            String result = ObjectSerializer.stringify(dt);
            assertTrue(result.contains("+05:30"), "should contain +05:30 offset: " + result);
        }

        @Test
        @DisplayName("bhvSerializationObject149 datetime with -08:00 offset preserves offset in serialized string")
        void bhvSerializationObject149NegativeOffsetPreserved() {
            OffsetDateTime dt = OffsetDateTime.parse("2024-01-01T12:30:45-08:00");
            String result = ObjectSerializer.stringify(dt);
            assertTrue(result.contains("-08:00"), "should contain -08:00 offset: " + result);
        }

        @Test
        @DisplayName("bhvSerializationObject046 date-time serialization preserves sub-second precision")
        void bhvSerializationObject046SubsecondsPreserved() {
            // The decoder (JavaTimeModule) accepts a fractional second, so the
            // parameter-path encoder must emit it too — truncating .123 to whole
            // seconds is a lossy, asymmetric round-trip. Milliseconds (3 digits)
            // is the cross-SDK common denominator, so assert the exact .123.
            OffsetDateTime dt = OffsetDateTime.parse("2020-01-02T03:04:05.123Z");
            String result = ObjectSerializer.stringify(dt);
            assertTrue(result.contains(".123"),
                    "milliseconds must survive serialization: " + result);
            OffsetDateTime parsed = OffsetDateTime.parse(result);
            assertEquals(dt.toInstant(), parsed.toInstant(),
                    "instant should match after lossless round-trip");
        }

        @Test
        @DisplayName("bhvSerializationObject044 date-only serializes as ISO 8601 date without time component")
        void bhvSerializationObject044DateOnlySerializesAsDate() {
            java.time.LocalDate date = java.time.LocalDate.parse("2024-01-01");
            String result = ObjectSerializer.stringify(date);
            assertEquals("2024-01-01", result);
        }

        @Test
        @DisplayName("bhvSerializationObject150 serialized datetime string ends with a numeric offset, never Z")
        void bhvSerializationObject150SerializedDateTimeHasOffset() {
            OffsetDateTime dt = OffsetDateTime.of(2024, 1, 1, 12, 30, 45, 0, ZoneOffset.UTC);
            String result = ObjectSerializer.stringify(dt);
            assertEquals("2024-01-01T12:30:45.000+00:00", result);
        }

        @Test
        @DisplayName("bhvSerializationObject151 JSON body serializes date-time in the canonical offset form, never Z")
        void bhvSerializationObject151BodyDateTimeUsesCanonicalOffsetForm() {
            // The JSON-body path (objectMapper.writeValueAsString) must emit the
            // SAME canonical shape as the parameter path: a fixed three-digit
            // millisecond fraction and a numeric offset, never the "Z" form.
            // JavaTimeModule's default OffsetDateTime serializer renders a UTC
            // whole-second value as "2024-01-01T12:30:45Z" with no fraction, so
            // this asserts the body path is bound to DATE_TIME_FORMATTER instead.
            OffsetDateTime dt = OffsetDateTime.of(2024, 1, 1, 12, 30, 45, 0, ZoneOffset.UTC);
            String json = new ObjectSerializer().serialize(dt);
            assertEquals("\"2024-01-01T12:30:45.000+00:00\"", json);
        }

        @Test
        @DisplayName("bhvSerializationObject064 decoded date-time keeps the offset it carried on the wire")
        void bhvSerializationObject064DecodedDateTimeKeepsOffset() {
            {{modelPackage}}.Order order = serializer.deserialize(
                "{\"shipDate\":\"2024-01-01T10:00:00+05:30\"}", {{modelPackage}}.Order.class);
            assertNotNull(order);
            OffsetDateTime shipDate = order.shipDate;
            assertNotNull(shipDate);
            assertEquals(ZoneOffset.ofHoursMinutes(5, 30), shipDate.getOffset());
            String json = serializer.serialize(order);
            assertTrue(json.contains("\"shipDate\":\"2024-01-01T10:00:00.000+05:30\""),
                "re-encoded offset must survive: " + json);
        }

        @Test
        @DisplayName("numeric date-time is rejected instead of read as epoch seconds")
        void numericDateTimeThrows() {
            assertDateTimeRejected("{\"shipDate\":1700000000}");
        }

        @Test
        @DisplayName("bhvSerializationObject011 boolean date-time is rejected")
        void bhvSerializationObject011BooleanDateTimeThrows() {
            assertDateTimeRejected("{\"shipDate\":true}");
        }

        @Test
        @DisplayName("array date-time is rejected")
        void arrayDateTimeThrows() {
            assertDateTimeRejected("{\"shipDate\":[2023,11,14,22,13,20]}");
        }

        private void assertDateTimeRejected(String json) {
            SerializationException ex = assertThrowsExactly(SerializationException.class, () ->
                serializer.deserialize(json, {{modelPackage}}.Order.class));
            com.fasterxml.jackson.databind.exc.MismatchedInputException cause = assertInstanceOf(
                com.fasterxml.jackson.databind.exc.MismatchedInputException.class, ex.getCause());
            String message = java.util.Objects.requireNonNull(cause.getMessage());
            assertTrue(message.startsWith("Cannot deserialize value of type `java.time.OffsetDateTime`"),
                "unexpected message: " + message);
        }

        @Test
        @DisplayName("bhvSerializationObject164 time stringifies as HH:mm:ss, with .SSS only for a non-zero millisecond part")
        void bhvSerializationObject164TimeStringifiesAsPartialTime() {
            assertEquals("10:30:00", ObjectSerializer.stringify(java.time.LocalTime.of(10, 30)));
            assertEquals("10:30:00.123",
                ObjectSerializer.stringify(java.time.LocalTime.of(10, 30, 0, 123_456_789)));
            assertEquals("10:30:00.999",
                ObjectSerializer.stringify(java.time.LocalTime.of(10, 30, 0, 999_600_000)));
        }

        @Test
        @DisplayName("bhvSerializationObject163 time body property uses the partial-time form and round-trips")
        void bhvSerializationObject163BodyTimeUsesPartialTimeAndRoundTrips() {
            {{modelPackage}}.EdgeCases edge = {{modelPackage}}.EdgeCases.builder().cutoff(java.time.LocalTime.of(10, 30, 0, 123_456_789)).build();
            String json = serializer.serialize(edge);
            assertEquals("{\"cutoff\":\"10:30:00.123\"}", json);
            {{modelPackage}}.EdgeCases decoded = java.util.Objects.requireNonNull(
                serializer.deserialize(json, {{modelPackage}}.EdgeCases.class));
            assertEquals(java.time.LocalTime.of(10, 30, 0, 123_000_000), decoded.cutoff);
            assertEquals("{\"cutoff\":\"10:30:00\"}",
                serializer.serialize(serializer.deserialize(
                    "{\"cutoff\":\"10:30:00\"}", {{modelPackage}}.EdgeCases.class)));
        }

        @Test
        @DisplayName("bhvSerializationObject104 a schema named Result keeps its own name and Error is prefixed")
        void bhvSerializationObject104ResultKeepsNameAndErrorIsPrefixed() {
            {{modelPackage}}.EdgeCases edge = java.util.Objects.requireNonNull(
                serializer.deserialize("{\"outcome\":{\"ok\":true}}", {{modelPackage}}.EdgeCases.class));
            {{modelPackage}}.Result outcome = java.util.Objects.requireNonNull(edge.outcome);
            assertTrue(Boolean.TRUE.equals(outcome.ok));

            {{modelPackage}}.EdgeCases failed = java.util.Objects.requireNonNull(
                serializer.deserialize(
                    serializer.serialize(serializer.deserialize(
                        "{\"lastError\":{\"code\":7,\"message\":\"boom\"}}",
                        {{modelPackage}}.EdgeCases.class)),
                    {{modelPackage}}.EdgeCases.class));
            {{modelPackage}}.ModelError error = assertInstanceOf(
                {{modelPackage}}.ModelError.class, failed.lastError);
            assertEquals(Integer.valueOf(7), error.code);
        }

        @Test
        @DisplayName("bhvSerializationObject058 unevaluatedProperties:false rejects an undeclared key while deserializing")
        void bhvSerializationObject058StrictModelRejectsUnknownKey() {
            SerializationException ex = assertThrowsExactly(SerializationException.class, () ->
                serializer.deserialize(
                    "{\"id\":1,\"name\":\"x\",\"unexpected\":true}", {{modelPackage}}.StrictTag.class));
            StringBuilder chain = new StringBuilder();
            for (Throwable t = ex; t != null; t = t.getCause()) {
                chain.append(t.getMessage()).append('\n');
            }
            String messages = chain.toString();
            assertTrue(messages.contains("unexpected"), "unexpected message: " + messages);
            assertTrue(messages.contains("unevaluatedProperties:false"), "unexpected message: " + messages);

            {{modelPackage}}.StrictTag ok = java.util.Objects.requireNonNull(
                serializer.deserialize("{\"id\":1,\"name\":\"x\"}", {{modelPackage}}.StrictTag.class));
            assertEquals("x", ok.name);
        }

