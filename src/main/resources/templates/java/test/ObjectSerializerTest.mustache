    /*
     * Byte-array equality across the three shapes a property can take. Java
     * compares arrays by identity, so a model holding bytes would otherwise
     * report two instances carrying the same content as unequal — and would
     * misbehave as a map or set key. The MAP case is the one that regressed:
     * the template once selected a deep-array comparison for it and emitted a
     * Collection call on a Map, which did not compile; the fix that restored
     * compilation then silently fell back to identity for the values.
     *
     * The fixture model carries all three deliberately: a bare byte[], a list
     * of them, and a map of them.
     */
    @Nested
    @DisplayName("generated equality compares array content, not identity")
    class ByteArrayEquality {

        private {{modelPackage}}.BinaryVault vaultWithFreshArrays() {
            java.util.Map<String, byte[]> labels = new java.util.HashMap<>();
            labels.put("first", new byte[] {7, 8});
            return {{modelPackage}}.BinaryVault.builder()
                    .seal(new byte[] {1, 2, 3})
                    .shards(List.of(new byte[] {4, 5}, new byte[] {6}))
                    .labels(labels)
                    .build();
        }

        private java.util.Map<String, byte[]> labelsOf({{modelPackage}}.BinaryVault vault) {
            java.util.Map<String, byte[]> labels = vault.labels;
            assertNotNull(labels, "fixture must populate labels");
            return labels;
        }

        @Test
        @DisplayName("bhvSerializationObject090 instances holding equal content are equal though every array is distinct")
        void bhvSerializationObject090EqualContentDistinctArraysCompareEqual() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right = vaultWithFreshArrays();

            /* Every array in the two models is a separate object, so identity
               comparison would fail here on all three properties. */
            assertNotSame(left.seal, right.seal);
            assertNotSame(labelsOf(left).get("first"), labelsOf(right).get("first"));

            assertEquals(left, right, "models holding identical bytes must compare equal");
            assertEquals(
                    left.hashCode(),
                    right.hashCode(),
                    "models that compare equal must hash equal, or they break as map keys");
        }

        @Test
        @DisplayName("bhvSerializationObject075 a differing byte in the bare array makes them unequal")
        void bhvSerializationObject075DifferingBareArrayCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays().toBuilder().seal(new byte[] {1, 2, 4}).build();

            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("bhvSerializationObject009 a differing byte inside the list makes them unequal")
        void bhvSerializationObject009DifferingListElementCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .shards(List.of(new byte[] {4, 5}, new byte[] {9}))
                            .build();

            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("bhvSerializationObject005 a differing byte inside a map VALUE makes them unequal")
        void bhvSerializationObject005DifferingMapValueCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .labels(java.util.Map.of("first", new byte[] {7, 9}))
                            .build();

            /* Identity comparison of map values would call these equal, since
               the maps have the same keys and Objects.equals stops at the
               array reference. */
            assertNotEquals(left, right);
        }

        @Test
        @DisplayName("bhvSerializationObject206 a differing map KEY makes them unequal")
        void bhvSerializationObject206DifferingMapKeyCompareUnequal() {
            {{modelPackage}}.BinaryVault left = vaultWithFreshArrays();
            {{modelPackage}}.BinaryVault right =
                    vaultWithFreshArrays()
                            .toBuilder()
                            .labels(java.util.Map.of("second", new byte[] {7, 8}))
                            .build();

            assertNotEquals(left, right);
        }
    }

