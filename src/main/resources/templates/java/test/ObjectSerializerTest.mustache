    @Nested
    @DisplayName("EnumMemberNameTests")
    class EnumMemberNameTests {

        private <T> T decode(String json, Class<T> type) {
            return serializer.deserialize(json, type);
        }

        private String modelSource(String name) {
            try {
                return java.nio.file.Files.readString(
                        java.nio.file.Path.of(
                                "src/main/java",
                                "{{modelPackage}}".replace('.', '/'),
                                name + ".java"));
            } catch (java.io.IOException e) {
                throw new java.io.UncheckedIOException(e);
            }
        }

        @Test
        @DisplayName("bhvEnums001 a string enum member named by an array exposes the given name and its wire value")
        void bhvEnums001ArrayNamesAStringMember() {
            assertEquals("s", {{modelPackage}}.Tier.SMALL.getValue());
            assertEquals("m", {{modelPackage}}.Tier.MEDIUM.getValue());
            assertEquals("l", {{modelPackage}}.Tier.LARGE.getValue());
            assertEquals({{modelPackage}}.Tier.MEDIUM,
                    decode("{\"tier\":\"m\"}", {{modelPackage}}.Subscription.class).tier);
        }

        @Test
        @DisplayName("bhvEnums002 an integer enum member named by an array exposes the given name and its number")
        void bhvEnums002ArrayNamesAnIntegerMember() {
            assertEquals(1, {{modelPackage}}.Rank.LOW.getValue());
            assertEquals(2, {{modelPackage}}.Rank.MEDIUM.getValue());
            assertEquals(3, {{modelPackage}}.Rank.HIGH.getValue());
            {{modelPackage}}.Subscription decoded =
                    decode("{\"rank\":3}", {{modelPackage}}.Subscription.class);
            assertEquals({{modelPackage}}.Rank.HIGH, decoded.rank);
            assertTrue(serializer.serialize(decoded).contains("\"rank\":3"));
        }

        @Test
        @DisplayName("bhvEnums003 an enum named by an object keyed by wire value names the members it lists")
        void bhvEnums003ObjectNamesTheListedMembers() {
            assertEquals("paused", {{modelPackage}}.Stage.ON_HOLD.getValue());
            assertEquals({{modelPackage}}.Stage.ON_HOLD,
                    decode("{\"rank\":1,\"stage\":\"paused\"}", {{modelPackage}}.Subscription.class).stage);
            assertEquals({{modelPackage}}.Stage.ACTIVE,
                    decode("{\"rank\":1,\"stage\":\"active\"}", {{modelPackage}}.Subscription.class).stage);
        }

        @Test
        @DisplayName("bhvEnums004 a supplied name that is not a legal identifier is cleaned and cased")
        void bhvEnums004SuppliedNameIsCleanedAndCased() {
            assertEquals("paused", {{modelPackage}}.Stage.valueOf("ON_HOLD").getValue());
        }

        @Test
        @DisplayName("bhvEnums005 two supplied names that collide after casing keep distinct names and wires")
        void bhvEnums005CollidingNamesStayDistinct() {
            assertEquals("active", {{modelPackage}}.Stage.valueOf("ACTIVE").getValue());
            assertEquals("live", {{modelPackage}}.Stage.valueOf("ACTIVE2").getValue());
            assertEquals({{modelPackage}}.Stage.valueOf("ACTIVE2"),
                    decode("{\"rank\":1,\"stage\":\"live\"}", {{modelPackage}}.Subscription.class).stage);
        }

        @Test
        @DisplayName("bhvEnums006 an inline property enum takes its member names from its own keys")
        void bhvEnums006InlineEnumTakesItsOwnNames() {
            assertEquals("month", {{modelPackage}}.Subscription.IntervalEnum.MONTHLY.getValue());
            assertEquals("year", {{modelPackage}}.Subscription.IntervalEnum.YEARLY.getValue());
        }

        @Test
        @DisplayName("bhvEnums007 a default on a referenced enum property starts at the member with the supplied name")
        void bhvEnums007DefaultStartsAtTheSuppliedMember() {
            assertEquals({{modelPackage}}.Tier.MEDIUM,
                    new {{modelPackage}}.Subscription({{modelPackage}}.Rank.LOW).tier);
            assertEquals({{modelPackage}}.Tier.MEDIUM,
                    decode("{\"rank\":1}", {{modelPackage}}.Subscription.class).tier);
        }

        @Test
        @DisplayName("bhvEnums008 encoding writes the wire value and decoding rejects a supplied name")
        void bhvEnums008WireValueOnlyOnTheWire() {
            assertEquals("\"m\"", serializer.serialize({{modelPackage}}.Tier.MEDIUM));
            SerializationException error =
                    assertThrows(
                            SerializationException.class,
                            () -> decode("{\"rank\":1,\"tier\":\"Medium\"}", {{modelPackage}}.Subscription.class));
            assertTrue(String.valueOf(error.getMessage()).contains("Medium"), error.getMessage());
        }

        @Test
        @DisplayName("bhvEnums009 a member with a description carries it as the one-line comment directly above it")
        void bhvEnums009DescriptionIsTheCommentAboveTheMember() {
            assertTrue(modelSource("Tier").contains("/** The smallest tier. */\n  SMALL("));
            assertTrue(modelSource("Tier").contains("/** The medium tier. */\n  MEDIUM("));
        }

        @Test
        @DisplayName("bhvEnums010 a member without a description keeps the comment it has today")
        void bhvEnums010UndescribedMemberKeepsItsComment() {
            assertTrue(modelSource("Rank").contains("/** The {@code 2} value. */\n  MEDIUM("));
        }

        @Test
        @DisplayName("bhvEnums011 a description with comment terminators still yields a compiling comment")
        void bhvEnums011HostileDescriptionStaysAComment() {
