        @Test
        @DisplayName("bhvSerializationObject053 deserialize applies schema default for absent field")
        void bhvSerializationObject053DeserializeAppliesSchemaDefaultForAbsentField() {
            // The Order.status property declares `default: placed` in the spec.
            // When the JSON omits status entirely, deserialization must populate
            // it with the schema default (StatusEnum.PLACED) rather than leaving
            // it null. The generated model carries the default as a field
            // initializer, so Jackson never overwrites it when the key is absent.
            String json = "{\"id\":10,\"petId\":198772}";
            {{modelPackage}}.Order order =
                    serializer.deserialize(
                            json,
                            new com.fasterxml.jackson.core.type.TypeReference<
                                    {{modelPackage}}.Order>() {}.getType());
            assertNotNull(order);
            assertEquals({{modelPackage}}.Order.StatusEnum.PLACED, order.status);
        }

        @Test
        @DisplayName("bhvSerializationObject025 applies defaults for absent fields but preserves explicit null")
        void bhvSerializationObject025DeserializeDefaultsAbsentVsExplicitNull() {
            // absent-vs-null contract: a schema `default` fills a field only when
            // the key is ABSENT from the payload. An explicit JSON null is a
            // provided value and is PRESERVED as null, never replaced by the
            // default. Defaults carries retries (default 3, non-enum scalar),
            // mode (default "medium" — not the first enum variant), and
            // label (nullable, default "untitled"). All 12 SDKs converge here.

            // (a) Empty object -> every default is applied.
            {{modelPackage}}.Defaults filled =
                    serializer.deserialize(
                            "{}",
                            new com.fasterxml.jackson.core.type.TypeReference<
                                    {{modelPackage}}.Defaults>() {}.getType());
            assertNotNull(filled);
            assertEquals(3, filled.retries);
            assertEquals({{modelPackage}}.Defaults.ModeEnum.MEDIUM, filled.mode);
            assertEquals("untitled", filled.label);
            assertEquals(
                "it's \"quoted\" \\ back\tslash\nnext $USD #{x} a*/b", filled.greeting);

            // (b) Explicit null on the nullable field is PRESERVED, not defaulted;
            // the supplied retries overrides its default.
            {{modelPackage}}.Defaults preserved =
                    serializer.deserialize(
                            "{\"label\":null,\"retries\":7}",
                            new com.fasterxml.jackson.core.type.TypeReference<
                                    {{modelPackage}}.Defaults>() {}.getType());
            assertNotNull(preserved);
            assertNull(preserved.label);
            assertEquals(7, preserved.retries);
        }

        @Test
        @DisplayName("bhvSerializationObject082 ignores unknown properties in JSON input")
        void bhvSerializationObject082IgnoresUnknownPropertiesInJsonInput() {
            // Gap #14: extras must be discarded on deserialize (FAIL_ON_UNKNOWN_PROPERTIES=false).
            String json =
                    "{\"id\":42,\"name\":\"Dogs\",\"unexpectedField\":\"surprise\","
                            + "\"another\":123}";
            {{modelPackage}}.Category category = assertDoesNotThrow(() ->
                    java.util.Objects.requireNonNull(
                            serializer.deserialize(
                                    json,
                                    new com.fasterxml.jackson.core.type.TypeReference<
                                            {{modelPackage}}.Category>() {}.getType()),
                            "deserialized category must not be null"));
            assertNotNull(category);
            assertEquals(42L, category.id);
            assertEquals("Dogs", category.name);
        }
    }

