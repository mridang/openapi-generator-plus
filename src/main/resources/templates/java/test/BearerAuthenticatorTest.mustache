package {{invokerPackage}}.auth;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.Map;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

class BearerAuthenticatorTest {

    @Test
    void rawTokenIsPrefixedWithBearer() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void alreadyPrefixedTokenIsNotDoubled() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "Bearer xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void lowercaseBearerPrefixIsStripped() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "bearer xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void mixedCaseBearerPrefixIsStripped() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "BeArEr xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void emptyTokenIsRejectedAtConstruction() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new BearerAuthenticator("https://api.example.com", ""));
        assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains("Bearer token must not be empty"));
    }

    // No null-token test: the token parameter is @NonNull, so NullAway
    // rejects passing a literal null at compile time — null can't reach the
    // constructor in well-typed code. The empty + whitespace cases above
    // exercise the runtime guard.

    @Test
    void whitespaceOnlyTokenIsRejectedAtConstruction() {
        assertThrows(IllegalArgumentException.class, () ->
                new BearerAuthenticator("https://api.example.com", "   "));
    }

    @Test
    void newlineOnlyTokenReportsEmptyNotPrintableAscii() {
        for (String blank : new String[] {"\n", "\r\n", "\013", "\f"}) {
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new BearerAuthenticator("https://api.example.com", blank));
            assertEquals("Bearer token must not be empty", ex.getMessage());
        }
    }

    @Test
    void controlCharacterInTokenReportsPrintableAscii() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new BearerAuthenticator("https://api.example.com", "abc\ndef"));
        assertTrue(java.util.Objects.requireNonNull(ex.getMessage())
                .startsWith("Bearer token must contain only printable ASCII characters"));
    }

    @Test
    void nonAsciiTokenIsRejectedWithTheExactMessage() {
        for (String token : new String[] {"töken", "abc\u007fdef", "abc\0def", "abc\rdef"}) {
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new BearerAuthenticator("https://api.example.com", token));
            assertEquals(
                    "Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                    ex.getMessage());
        }
    }

    @Test
    void unicodeSpaceIsNotBlankSoThePrintableAsciiCheckRejectsIt() {
        for (char space : new char[] {(char) 0xA0, (char) 0x2003}) {
            String token = String.valueOf(space);
            IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                    new BearerAuthenticator("https://api.example.com", token));
            assertEquals(
                    "Bearer token must contain only printable ASCII characters (RFC 7230 §3.2.6)",
                    ex.getMessage());
        }
    }

    @Test
    void tokenThatMerelyBeginsWithTheWordBearerIsKeptWhole() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "bearerxyz");
        assertEquals("Bearer bearerxyz", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void doubledBearerPrefixIsStrippedOnlyOnce() {
        BearerAuthenticator auth =
                new BearerAuthenticator("https://api.example.com", "Bearer Bearer xyz");
        assertEquals("Bearer Bearer xyz", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void schemeWrappersEmitTheSameBearerHeaderAndKeepTheirOwnName() {
        PetStoreBearerAuthenticator store =
                new PetStoreBearerAuthenticator("https://api.example.com", "xyz");
        ServiceTokenAuthenticator service =
                new ServiceTokenAuthenticator("https://api.example.com", "Bearer xyz");

        assertEquals("Bearer xyz", store.getAuthHeaders().get("Authorization"));
        assertEquals("Bearer xyz", service.getAuthHeaders().get("Authorization"));
        assertEquals("https://api.example.com", store.getHost());
        assertEquals("PetStoreBearerAuthenticator(host=https://api.example.com, token=***)",
                store.toString());
        assertEquals("ServiceTokenAuthenticator(host=https://api.example.com, token=***)",
                service.toString());
    }

    @Test
    void schemeWrapperValidatesTheTokenAtConstruction() {
        assertThrows(IllegalArgumentException.class, () ->
                new ServiceTokenAuthenticator("https://api.example.com", ""));
    }

    /**
     * The default {@code toString()} must mask the stored token: the secret
     * value must be absent and a {@code ***} redaction marker present.
     */
    @Test
    @DisplayName("toString() redacts the token and shows ***")
    void redactsSecret() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "xyz");
        String repr = auth.toString();
        assertFalse(repr.contains("token=xyz"));
        assertTrue(repr.contains("***"));
        assertEquals("BearerAuthenticator(host=https://api.example.com, token=***)", repr);
    }

    private static final String HOST = "https://api.example.com";
    private static final String TOKEN_VARIABLE = "{{envVarPrefix}}_PET_STORE_BEARER_TOKEN";

    @Test
    void tokenProviderIsCalledForEveryRequest() {
        java.util.concurrent.atomic.AtomicInteger calls = new java.util.concurrent.atomic.AtomicInteger();
        BearerAuthenticator auth =
                new BearerAuthenticator(HOST, null, () -> "rotating-" + calls.incrementAndGet());

        assertEquals("Bearer rotating-1", auth.getAuthHeaders().get("Authorization"));
        assertEquals("Bearer rotating-2", auth.getAuthHeaders().get("Authorization"));
        assertEquals(HOST, auth.getHost());
        assertEquals("BearerAuthenticator(host=" + HOST + ", token=***)", auth.toString());
    }

    @Test
    void tokenProviderResultIsValidatedAtRequestTime() {
        BearerAuthenticator blank = new BearerAuthenticator(HOST, null, () -> "  ");
        IllegalArgumentException empty =
                assertThrows(IllegalArgumentException.class, blank::getAuthHeaders);
        assertEquals("Bearer token must not be empty", empty.getMessage());

        BearerAuthenticator control = new BearerAuthenticator(HOST, null, () -> "abc\ndef");
        assertThrows(IllegalArgumentException.class, control::getAuthHeaders);
    }

    @Test
    void tokenProviderResultKeepsTheBearerPrefixRule() {
        BearerAuthenticator auth = new BearerAuthenticator(HOST, () -> "Bearer xyz");
        assertEquals("Bearer xyz", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void tokenAndTokenProviderTogetherAreRefused() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new BearerAuthenticator(HOST, "xyz", () -> "other"));
        assertEquals("Pass either token or tokenProvider, not both", ex.getMessage());
    }

    @Test
    void neitherATokenNorATokenProviderIsRefused() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new BearerAuthenticator(HOST, null, null));
        assertEquals("Bearer token must not be empty", ex.getMessage());
    }

    @Test
    void schemeWrapperReadsTheTokenFromItsEnvironmentVariable() {
        PetStoreBearerAuthenticator auth =
                new PetStoreBearerAuthenticator(HOST, null, Map.of(TOKEN_VARIABLE, "env-token"));
        assertEquals("Bearer env-token", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void schemeWrapperPrefersTheTokenYouPassToTheEnvironment() {
        PetStoreBearerAuthenticator auth =
                new PetStoreBearerAuthenticator(HOST, "explicit", Map.of(TOKEN_VARIABLE, "env-token"));
        assertEquals("Bearer explicit", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void schemeWrapperTreatsAnEmptyTokenAsNotPassed() {
        PetStoreBearerAuthenticator auth =
                new PetStoreBearerAuthenticator(HOST, "", Map.of(TOKEN_VARIABLE, "env-token"));
        assertEquals("Bearer env-token", auth.getAuthHeaders().get("Authorization"));
    }

    @Test
    void schemeWrapperTreatsAnEmptyEnvironmentVariableAsNotSet() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new PetStoreBearerAuthenticator(HOST, null, Map.of(TOKEN_VARIABLE, "")));
        assertTrue(java.util.Objects.requireNonNull(ex.getMessage()).contains(TOKEN_VARIABLE), ex.getMessage());
    }

    @Test
    void schemeWrapperWithNoTokenAndNoVariableNamesTheVariable() {
        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () ->
                new PetStoreBearerAuthenticator(HOST, null, Map.of()));
        assertEquals(
                "The 'token' credential of the 'petStoreBearer' security scheme is required: "
                        + "pass it or set the " + TOKEN_VARIABLE + " environment variable",
                ex.getMessage());
    }

    @Test
    void schemeWrapperReadsOnlyItsOwnVariable() {
        Map<String, String> environment = Map.of("{{envVarPrefix}}_SERVICE_TOKEN_TOKEN", "service-token");
        assertThrows(IllegalArgumentException.class, () ->
                new PetStoreBearerAuthenticator(HOST, null, environment));
        ServiceTokenAuthenticator service = new ServiceTokenAuthenticator(HOST, null, environment);
        assertEquals("Bearer service-token", service.getAuthHeaders().get("Authorization"));
    }

    @Test
    void schemeWrapperValidatesAnEnvironmentToken() {
        assertThrows(IllegalArgumentException.class, () ->
                new PetStoreBearerAuthenticator(HOST, null, Map.of(TOKEN_VARIABLE, "bad\ntoken")));
    }
}
