package {{invokerPackage}}.auth;

import static org.junit.jupiter.api.Assertions.*;

import java.util.Map;
import org.junit.jupiter.api.Test;

class BearerAuthenticatorTest {

    @Test
    void rawTokenIsPrefixedWithBearer() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void alreadyPrefixedTokenIsNotDoubled() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "Bearer xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void lowercaseBearerPrefixIsStripped() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "bearer xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void mixedCaseBearerPrefixIsStripped() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "BeArEr xyz");
        Map<String, String> headers = auth.getAuthHeaders();
        assertEquals("Bearer xyz", headers.get("Authorization"));
    }

    @Test
    void emptyTokenIsRejected() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "");
        assertThrows(IllegalArgumentException.class, auth::getAuthHeaders);
    }

    @Test
    void nullTokenIsRejected() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", null);
        assertThrows(IllegalArgumentException.class, auth::getAuthHeaders);
    }

    @Test
    void whitespaceOnlyTokenIsRejected() {
        BearerAuthenticator auth = new BearerAuthenticator("https://api.example.com", "   ");
        assertThrows(IllegalArgumentException.class, auth::getAuthHeaders);
    }
}
