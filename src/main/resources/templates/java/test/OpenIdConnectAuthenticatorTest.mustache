    @org.junit.jupiter.params.ParameterizedTest
    @org.junit.jupiter.params.provider.CsvSource(delimiter = '|', value = {
        "Cache-Control|max-age=0|2",
        "cache-control|public, MAX-AGE=0, must-revalidate|2",
        "Cache-Control|max-age=3600|1",
        "Cache-Control|no-store|1",
        "Cache-Control|max-age=99999999999999999999|1",
        "Cache-Control|max-age=9223372036854775807|1",
        "X-Other|max-age=0|1"
    })
    void bhvAuthOidc003DiscoveryIsCachedForTheCacheControlMaxAge(
            String header, String value, int expectedFetches) {
        // The discovery document is cached for the Cache-Control max-age, and
        // for a day when the response carries no usable max-age.
        var getCalls = new java.util.concurrent.atomic.AtomicInteger(0);
        ApiClient client = (method, url, headers, body) -> {
            getCalls.incrementAndGet();
            return new ApiHttpResponse(200, DISCOVERY_RESPONSE, Map.of(header, value));
        };

        OpenIdConnectAuthenticator auth = createAuthenticator();
        auth.setApiClient(client);

        auth.buildAuthorizationUrl(null);
        auth.buildAuthorizationUrl(null);

        assertEquals(expectedFetches, getCalls.get());
    }

