import java.util.HashMap;
import java.util.Map;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

class TransportOptionsTest {

    @Test
    @DisplayName("a caller-supplied HttpClient conflicts with proxy, CA certificate and verifySsl(false)")
    void suppliedHttpClientConflictsWithSdkProxyAndTlsSettings() {
        java.net.http.HttpClient supplied = java.net.http.HttpClient.newHttpClient();
        try {
            org.junit.jupiter.api.Assertions.assertThrows(IllegalArgumentException.class, () ->
                TransportOptions.builder().httpClient(supplied).proxy("http://proxy:3128").build());
            org.junit.jupiter.api.Assertions.assertThrows(IllegalArgumentException.class, () ->
                TransportOptions.builder().httpClient(supplied).caCertPath("/tmp/ca.pem").build());
            org.junit.jupiter.api.Assertions.assertThrows(IllegalArgumentException.class, () ->
                TransportOptions.builder().httpClient(supplied).verifySsl(false).build());
            assertSame(supplied, TransportOptions.builder().httpClient(supplied).build().getHttpClient());
        } finally {
            supplied.close();
        }
    }

    @Test
    @DisplayName("a caller-supplied HttpClient that follows redirects is rejected")
    void suppliedHttpClientThatFollowsRedirectsIsRejected() {
        java.net.http.HttpClient supplied = java.net.http.HttpClient.newBuilder()
                .followRedirects(java.net.http.HttpClient.Redirect.NORMAL)
                .build();
        try {
            org.junit.jupiter.api.Assertions.assertThrows(IllegalArgumentException.class, () ->
                TransportOptions.builder().httpClient(supplied).build());
        } finally {
            supplied.close();
        }
    }

    @Test
    @DisplayName("verifySsl defaults to true")
    void verifySslDefaultsToTrue() {
        TransportOptions opts = TransportOptions.builder().build();
        assertTrue(opts.isVerifySsl());
    }

    @Test
    @DisplayName("caCertPath defaults to null")
    void caCertPathDefaultsToNull() {
        TransportOptions opts = TransportOptions.builder().build();
        assertNull(opts.getCaCertPath());
    }

    @Test
    @DisplayName("proxy defaults to null")
    void proxyDefaultsToNull() {
        TransportOptions opts = TransportOptions.builder().build();
        assertNull(opts.getProxy());
    }

    @Test
    @DisplayName("timeout defaults to 10000 ms (10 seconds)")
    void timeoutDefaultsTo10Seconds() {
        TransportOptions opts = TransportOptions.builder().build();
        assertNotNull(opts.getTimeout());
        assertEquals(10000, opts.getTimeout());
    }

    @Test
    @DisplayName("followRedirects defaults to true")
    void followRedirectsDefaultsToTrue() {
        TransportOptions opts = TransportOptions.builder().build();
        assertTrue(opts.isFollowRedirects());
    }

    @Test
    @DisplayName("maxRedirects defaults to null")
    void maxRedirectsDefaultsToNull() {
        TransportOptions opts = TransportOptions.builder().build();
        assertNull(opts.getMaxRedirects());
    }

    @Test
    @DisplayName("maxRetries defaults to 2 and 0 disables retries")
    void maxRetriesDefaultsToTwo() {
        assertEquals(2, TransportOptions.builder().build().getMaxRetries());
        assertEquals(0, TransportOptions.builder().maxRetries(0).build().getMaxRetries());
        assertEquals(5, TransportOptions.builder().maxRetries(5).build().getMaxRetries());
    }

    @Test
    @DisplayName("a negative maxRetries is rejected")
    void negativeMaxRetriesIsRejected() {
        IllegalArgumentException ex = assertThrowsExactly(
                IllegalArgumentException.class, () -> TransportOptions.builder().maxRetries(-1));
        assertEquals("Invalid maxRetries: must not be negative (got -1)", ex.getMessage());
    }

    @Test
    @DisplayName("userAgent defaults to non-empty string")
    void userAgentDefaultsToNonEmptyString() {
        TransportOptions opts = TransportOptions.builder().build();
        assertNotNull(opts.getUserAgent());
        assertFalse(opts.getUserAgent().isEmpty());
    }

    @Test
    @DisplayName("userAgent defaults to the published artifact name")
    void userAgentDefaultsToThePublishedArtifactName() {
        TransportOptions opts = TransportOptions.builder().build();
        assertEquals("{{artifactId}}/{{artifactVersion}} (java)", opts.getUserAgent());
    }

    @Test
    @DisplayName("defaultHeaders defaults to empty map")
    void defaultHeadersDefaultsToEmpty() {
        TransportOptions opts = TransportOptions.builder().build();
        assertTrue(opts.getDefaultHeaders().isEmpty());
    }

    @Test
    @DisplayName("injectRequestId defaults to false")
    void injectRequestIdDefaultsToFalse() {
        TransportOptions opts = TransportOptions.builder().build();
        assertFalse(opts.isInjectRequestId());
    }

    @Test
    @DisplayName("builder sets all fields")
    void builderSetsAllFields() {
        TransportOptions opts = TransportOptions.builder()
                .verifySsl(false)
                .caCertPath("/path/to/ca.pem")
                .proxy("http://proxy:8080")
                .timeout(5000)
                .followRedirects(false)
                .maxRedirects(3)
                .userAgent("TestAgent/1.0")
                .defaultHeader("X-Custom", "value")
                .injectRequestId(true)
                .build();

        assertFalse(opts.isVerifySsl());
        assertEquals("/path/to/ca.pem", opts.getCaCertPath());
        assertEquals("http://proxy:8080", opts.getProxy());
        assertEquals(5000, opts.getTimeout());
        assertFalse(opts.isFollowRedirects());
        assertEquals(3, opts.getMaxRedirects());
        assertEquals("TestAgent/1.0", opts.getUserAgent());
        assertEquals(Map.of("X-Custom", "value"), opts.getDefaultHeaders());
        assertTrue(opts.isInjectRequestId());
    }

    @Test
    @DisplayName("follow redirects defaults to true with null max redirects")
    void followRedirectsDefaultsToTrueWithNullMaxRedirects() {
        TransportOptions opts = TransportOptions.builder()
                .followRedirects(true)
                .build();

        assertTrue(opts.isFollowRedirects());
        assertNull(opts.getMaxRedirects());
    }

    @org.junit.jupiter.params.ParameterizedTest
    @org.junit.jupiter.params.provider.ValueSource(ints = {-1, 0})
    @DisplayName("a non-positive timeout is rejected with the canonical message")
    void nonPositiveTimeoutIsRejected(int timeout) {
        IllegalArgumentException ex = assertThrowsExactly(
                IllegalArgumentException.class, () -> TransportOptions.builder().timeout(timeout));
        assertEquals(
                "Invalid timeout: must be a positive number of milliseconds (got " + timeout + ")",
                ex.getMessage());
        // Null stays valid: it means no deadline.
        assertNull(TransportOptions.builder().timeout(null).build().getTimeout());
    }

    @Test
    @DisplayName("a negative maxRedirects is rejected")
    void negativeMaxRedirectsIsRejected() {
        IllegalArgumentException ex = assertThrowsExactly(
                IllegalArgumentException.class, () -> TransportOptions.builder().maxRedirects(-1));
        assertEquals("Invalid maxRedirects: must not be negative (got -1)", ex.getMessage());
        assertEquals(0, TransportOptions.builder().maxRedirects(0).build().getMaxRedirects());
    }

    @Test
    @DisplayName("invalid proxy URL throws IllegalArgumentException")
    void invalidProxyUrlThrowsException() {
        IllegalArgumentException ex = assertThrowsExactly(IllegalArgumentException.class, () ->
                TransportOptions.builder().proxy("not a valid url ^%$"));
        // A bad proxy URL is a configuration mistake, not an SDK error.
        assertFalse(((Object) ex) instanceof {{errorPrefix}}Exception);
    }

    @org.junit.jupiter.params.ParameterizedTest
    @org.junit.jupiter.params.provider.CsvSource(delimiter = '|', value = {
        "ftp://proxy.example.com:21|Invalid proxy URL (must use http or https scheme): ftp://proxy.example.com:21",
        "socks5://proxy.example.com:1080|Invalid proxy URL (must use http or https scheme): socks5://proxy.example.com:1080",
        "proxy.example.com:8080|Invalid proxy URL (must use http or https scheme): proxy.example.com:8080",
        "http://|Invalid proxy URL: http://",
        "http://:8080|Invalid proxy URL (missing host): http://:8080",
        "https:///path|Invalid proxy URL (missing host): https:///path",
        "not a valid url ^%$|Invalid proxy URL: not a valid url ^%$",
        "socks5://svc:s3cret@proxy.example.com:1080|Invalid proxy URL (must use http or https scheme): socks5://***@proxy.example.com:1080",
        "http://svc:s3cret@:8080|Invalid proxy URL (missing host): http://***@:8080",
        "http://[::1:3128|Invalid proxy URL: http://[::1:3128"
    })
    @DisplayName("an unusable proxy URL is rejected with the exact message")
    void unusableProxyUrlIsRejectedWithTheExactMessage(String proxy, String message) {
        IllegalArgumentException ex = assertThrowsExactly(IllegalArgumentException.class, () ->
                TransportOptions.builder().proxy(proxy));
        assertEquals(message, ex.getMessage());
    }

    @Test
    @DisplayName("an empty proxy URL is rejected as a missing scheme")
    void emptyProxyUrlIsRejected() {
        IllegalArgumentException ex = assertThrowsExactly(IllegalArgumentException.class, () ->
                TransportOptions.builder().proxy(""));
        assertEquals("Invalid proxy URL (must use http or https scheme): ", ex.getMessage());
    }

    @Test
    @DisplayName("an upper-case http or https proxy scheme is accepted")
    void upperCaseProxySchemeIsAccepted() {
        assertEquals("HTTP://proxy.example.com:8080",
                TransportOptions.builder().proxy("HTTP://proxy.example.com:8080").build().getProxy());
        assertEquals("HTTPS://proxy.example.com:8443",
                TransportOptions.builder().proxy("HTTPS://proxy.example.com:8443").build().getProxy());
    }

    @Test
    @DisplayName("a proxy URL with an IPv6 literal host is accepted and kept verbatim")
    void ipv6LiteralProxyUrlIsAcceptedAndKeptVerbatim() {
        assertEquals("http://[::1]:3128",
                TransportOptions.builder().proxy("http://[::1]:3128").build().getProxy());
        assertEquals("https://[2001:db8::1]:8443/",
                TransportOptions.builder().proxy("https://[2001:db8::1]:8443/").build().getProxy());
    }

    @Test
    @DisplayName("null proxy URL is accepted")
    void nullProxyUrlIsAccepted() {
        TransportOptions opts = TransportOptions.builder().proxy(null).build();
        assertNull(opts.getProxy());
    }

    @Test
    @DisplayName("builder methods return the same builder instance")
    void builderMethodsReturnSameInstance() {
        TransportOptions.Builder builder = TransportOptions.builder();

        assertSame(builder, builder.verifySsl(true));
        assertSame(builder, builder.caCertPath(null));
        assertSame(builder, builder.proxy(null));
        assertSame(builder, builder.timeout(null));
        assertSame(builder, builder.followRedirects(true));
        assertSame(builder, builder.maxRedirects(null));
        assertSame(builder, builder.maxRetries(2));
        assertSame(builder, builder.userAgent(null));
        assertSame(builder, builder.defaultHeader("X-Key", "val"));
        assertSame(builder, builder.defaultHeaders(new HashMap<>()));
        assertSame(builder, builder.injectRequestId(false));
    }

    @Test
    @DisplayName("accumulates headers from defaultHeader calls")
    void accumulatesHeadersFromDefaultHeaderCalls() {
        TransportOptions opts = TransportOptions.builder()
                .defaultHeader("X-First", "one")
                .defaultHeader("X-Second", "two")
                .build();

        assertEquals(2, opts.getDefaultHeaders().size());
        assertEquals("one", opts.getDefaultHeaders().get("X-First"));
        assertEquals("two", opts.getDefaultHeaders().get("X-Second"));
    }

    @Test
    @DisplayName("merges headers from defaultHeaders call")
    void mergesHeadersFromDefaultHeadersCall() {
        TransportOptions opts = TransportOptions.builder()
                .defaultHeader("X-First", "one")
                .defaultHeaders(Map.of("X-Second", "two", "X-Third", "three"))
                .build();

        assertEquals(3, opts.getDefaultHeaders().size());
        assertEquals("one", opts.getDefaultHeaders().get("X-First"));
        assertEquals("two", opts.getDefaultHeaders().get("X-Second"));
        assertEquals("three", opts.getDefaultHeaders().get("X-Third"));
    }

    @Test
    @DisplayName("modifying source map does not affect built options")
    void modifyingSourceMapDoesNotAffectBuiltOptions() {
        Map<String, String> headers = new HashMap<>();
        headers.put("X-Original", "original");

        TransportOptions opts = TransportOptions.builder()
                .defaultHeaders(headers)
                .build();

        headers.put("X-Added", "added");

        assertEquals(1, opts.getDefaultHeaders().size());
        assertEquals("original", opts.getDefaultHeaders().get("X-Original"));
        assertNull(opts.getDefaultHeaders().get("X-Added"));
    }

    @Test
    @DisplayName("builder produces independent instances")
    void builderProducesIndependentInstances() {
        TransportOptions.Builder builder = TransportOptions.builder().verifySsl(false);
        TransportOptions first = builder.build();
        TransportOptions second = builder.build();

        assertEquals(first.isVerifySsl(), second.isVerifySsl());
        assertNotSame(first, second);
    }

    // TimeoutConfigTests

    @Test
    @DisplayName("timeout defaults to 10000 ms (10 seconds)")
    void timeoutDefaultsTo10SecondsInTimeoutGroup() {
        // Default TransportOptions has a 10s timeout; matches cross-language parity.
        TransportOptions opts = TransportOptions.builder().build();
        assertNotNull(opts.getTimeout());
        assertEquals(10000, opts.getTimeout());
    }

    @Test
    @DisplayName("setting timeout to 5000 is accessible")
    void settingTimeoutIsAccessible() {
        TransportOptions opts = TransportOptions.builder().timeout(5000).build();
        assertEquals(5000, opts.getTimeout());
    }

    @Test
    @DisplayName("timeout field is named exactly 'timeout'")
    void timeoutFieldIsNamedTimeout() {
        // Verify via the getter that the field is named 'timeout' (not e.g. 'connectionTimeout').
        TransportOptions opts = TransportOptions.builder().timeout(1000).build();
        assertNotNull(opts.getTimeout());
        assertEquals(1000, opts.getTimeout());
    }

    @Test
    @DisplayName("explicitly setting timeout to null disables timeout")
    void timeoutCanBeExplicitlyDisabled() {
        TransportOptions opts = TransportOptions.builder().timeout(null).build();
        assertNull(opts.getTimeout());
    }

    // ProxyConfigTests

    @Test
    @DisplayName("setting proxy URL is preserved on read-back")
    void proxyUrlIsPreservedOnReadBack() {
        TransportOptions opts = TransportOptions.builder()
                .proxy("http://proxy.example.com:8080")
                .build();
        assertEquals("http://proxy.example.com:8080", opts.getProxy());
    }

    @Test
    @DisplayName("setting proxy is supported on all platforms")
    void settingProxyIsSupportedOnAllPlatforms() {
        // Proxy configuration must not throw on any JVM platform.
        assertDoesNotThrow(() ->
                TransportOptions.builder().proxy("http://proxy.example.com:8080").build());
    }

    // README

    @Test
    @DisplayName("the README names the builder setter that rejects a SOCKS proxy")
    void readmeSocksNoteNamesTheBuilderProxySetter() throws java.io.IOException {
        String readme = java.nio.file.Files.readString(java.nio.file.Path.of("README.md"));
        assertTrue(readme.contains("`TransportOptions.builder().proxy(...)` accepts only `http://` and `https://` URLs."));
        assertFalse(readme.contains("TransportOptions.proxy()"));
    }
}
