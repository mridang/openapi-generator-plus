                    1L, new UploadPetDocumentOptions(new ByteArrayInputStream(payload)));

            assertNotNull(capturedContentType[0]);
            assertThat(capturedContentType[0]).startsWith("multipart/form-data");
            assertThat(capturedContentType[0]).contains("boundary=");

            // The body is a multipart envelope: it carries the part headers.
            assertNotNull(capturedBody[0]);
            String wireText = new String(capturedBody[0], StandardCharsets.ISO_8859_1);
            assertThat(wireText).contains("Content-Disposition: form-data");
            assertThat(wireText).contains("name=\"file\"");
        } finally {
            server.stop(0);
        }
    }

    @Test
    void bhvOperations069TestFindPetsByStatusSerialisesDateParamsWithoutTimeComponent() throws Exception {
        // format:date params (bornAfter query, Report-Date header) are typed
        // LocalDate and must hit the wire as a bare YYYY-MM-DD, never as a
        // date-time (no T00:00:00 / offset suffix).
        String[] capturedUrl = new String[1];
        Map<String, String> capturedHeaders = new HashMap<>();
        ApiClient recording = (method, url, headers, body) -> {
            capturedUrl[0] = url;
            capturedHeaders.putAll(headers);
            return new ApiHttpResponse(200, "[]", Map.of("Content-Type", "application/json"));
        };
        PetApi mockedApi = new PetApi(recording, Configuration.builder()
                .baseUrl("http://localhost")
                .build());

        mockedApi.findPetsByStatus(new FindPetsByStatusOptions()
                .status("available")
                .bornAfter(LocalDate.of(2024, 1, 1))
                .reportDate(LocalDate.of(2024, 1, 1)));

        assertThat(capturedUrl[0]).contains("bornAfter=2024-01-01");
        assertThat(capturedUrl[0]).doesNotContain("bornAfter=2024-01-01T");
        assertThat(capturedUrl[0]).doesNotContain("bornAfter=2024-01-01%");
        String reportDate = capturedHeaders.entrySet().stream()
                .filter(e -> e.getKey().equalsIgnoreCase("Report-Date"))
                .map(Map.Entry::getValue)
                .findFirst()
                .orElse(null);
        assertThat(reportDate).isEqualTo("2024-01-01");
    }

