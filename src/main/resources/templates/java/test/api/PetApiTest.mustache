    /**
     * Captures the request body the SDK hands to the transport, without
     * touching the network, so wire-format assertions can run as fast unit
     * tests.
     */
    private static final class CapturingApiClient implements ApiClient {
        @javax.annotation.Nullable Object capturedBody;
        @javax.annotation.Nullable String capturedUrl;
        @javax.annotation.Nullable java.util.Map<String, String> capturedHeaders;

        @Override
        public {{invokerPackage}}.ApiHttpResponse sendRequest(
                String method,
                String url,
                java.util.Map<String, String> headers,
                @javax.annotation.Nullable Object body) {
            this.capturedBody = body;
            this.capturedUrl = url;
            this.capturedHeaders = headers;
            return new {{invokerPackage}}.ApiHttpResponse(
                    200, "{\"id\":1,\"name\":\"x\",\"photoUrls\":[]}",
                    java.util.Map.of("Content-Type", "application/json"));
        }
    }

    @Test
    void getPetByNameTildeInPathIsNotOverEncoded() throws Exception {
        // RFC 3986 unreserved '~' must survive in a path segment as a literal
        // tilde, never percent-encoded to %7E.
        CapturingApiClient capturing = new CapturingApiClient();
        Configuration config = Configuration.builder().baseUrl("http://localhost").build();
        PetApi petApi = new PetApi(capturing, config);

        petApi.getPetByName("a~b", new GetPetByNameOptions("cats", "corr-1"));

        assertNotNull(capturing.capturedUrl);
        assertThat(capturing.capturedUrl).contains("/pet/byName/a~b");
        assertThat(capturing.capturedUrl).doesNotContain("%7E");
    }

    @Test
    void bhvOperations051GetPetByNameRejectsADotSegmentBeforeDispatch() throws Exception {
        // RFC 3986 section 5.2.4: '.' and '..' are path navigation, so a URL
        // parser could re-route the request. They are rejected client-side.
        CapturingApiClient capturing = new CapturingApiClient();
        Configuration config = Configuration.builder().baseUrl("http://localhost").build();
        PetApi petApi = new PetApi(capturing, config);

        for (String dots : List.of(".", "..")) {
            assertThatThrownBy(() -> petApi.getPetByName(dots, new GetPetByNameOptions("cats", "corr-1")))
                    .isInstanceOf(IllegalArgumentException.class)
                    .hasMessage("Path parameter 'name' must not be '.' or '..'");
        }
        assertThat(capturing.capturedUrl).isNull();

        petApi.getPetByName("a..b", new GetPetByNameOptions("cats", "corr-1"));
        assertThat(capturing.capturedUrl).startsWith("http://localhost/pet/byName/a..b?");
    }

    @Test
