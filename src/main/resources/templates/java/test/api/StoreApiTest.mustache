    @Test
    void bhvOperations101TestGetGroupedCategoriesDeserializesNestedContainer() throws Exception {
        // A nested generic container (array of map of model) must decode its
        // leaves into typed Category instances, not leave them as raw maps.
        StoreApi mockApi = newStoreApiForMock(
                200,
                "application/json",
                "[{\"a\":{\"id\":1,\"name\":\"Dogs\"}},{\"b\":{\"id\":2,\"name\":\"Cats\"}}]");

        List<Map<String, Category>> result = mockApi.getGroupedCategories();
        assertNotNull(result);

        // The leaf is statically typed Category (Map<String, Category>), so a
        // successful nested decode yields a typed instance with populated
        // fields rather than a raw map.
        Category category =
                java.util.Objects.requireNonNull(
                        result.get(0).get("a"), "leaf 'a' must decode to a typed Category");
        assertThat(category.id).isEqualTo(1L);
        assertThat(category.name).isEqualTo("Dogs");
    }

    @Test
    void bhvOperations122TestGetBySwatchSendsTheEnumWireValueInPathQueryAndHeader() throws Exception {
        // A named enum ($ref) parameter must ride the wire as its value
        // ("red"), never as the language's enum constant name ("RED").
        String[] capturedUrl = new String[1];
        Map<String, String> capturedHeaders = new java.util.HashMap<>();
        ApiClient recording = (method, url, headers, body) -> {
            capturedUrl[0] = url;
            capturedHeaders.putAll(headers);
            return new ApiHttpResponse(200, "{\"id\":1,\"name\":\"x\"}",
                    Map.of("Content-Type", "application/json"));
        };
        StoreApi mockedApi = new StoreApi(recording,
                Configuration.builder().baseUrl("http://localhost").build());

        mockedApi.getBySwatch(Swatch.RED,
                new GetBySwatchOptions().querySwatch(Swatch.GREEN).preferredSwatch(Swatch.BLUE));

        assertThat(capturedUrl[0]).isEqualTo("http://localhost/store/by-swatch/red?querySwatch=green");
        assertThat(capturedHeaders).containsEntry("Preferred-Swatch", "blue");
    }

    @Test
    void bhvOperations098TestCreateAccountSendsAndReceivesReadOnlyAndWriteOnlyProperties() throws Exception {
        // readOnly/writeOnly have no wire effect: the writeOnly password is
        // sent, and the readOnly id in the response is decoded.
        Object[] capturedBody = new Object[1];
        ApiClient recording = (method, url, headers, body) -> {
            capturedBody[0] = body;
            return new ApiHttpResponse(200, "{\"id\":7,\"username\":\"u\",\"password\":\"p\"}",
                    Map.of("Content-Type", "application/json"));
        };
        StoreApi mockedApi = new StoreApi(recording,
                Configuration.builder().baseUrl("http://localhost").build());
        {{modelPackage}}.Account account = {{modelPackage}}.Account.builder().username("u").password("p").build();

        {{modelPackage}}.Account result = mockedApi.createAccount(account);

        assertThat(String.valueOf(capturedBody[0])).contains("\"password\":\"p\"");
        assertNotNull(result);
        assertThat(result.id).isEqualTo(7L);
        assertThat(result.password).isEqualTo("p");
    }

