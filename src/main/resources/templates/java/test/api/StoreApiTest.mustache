    @Test
    void bhvOperations110TestGetOrderByIdPicksTheStatusSpecificErrorThroughTheTypedRoutes() throws Exception {
        Object[][] table = {
            {400, {{invokerPackage}}.errors.BadRequestException.class},
            {401, {{invokerPackage}}.errors.UnauthorizedException.class},
            {403, {{invokerPackage}}.errors.ForbiddenException.class},
            {409, {{invokerPackage}}.errors.ConflictException.class},
            {418, {{invokerPackage}}.errors.ClientException.class},
            {422, {{invokerPackage}}.errors.UnprocessableEntityException.class},
            {500, {{invokerPackage}}.errors.InternalServerErrorException.class},
            {502, {{invokerPackage}}.errors.ServerException.class},
        };
        for (Object[] row : table) {
            StoreApi routed = new StoreApi(
                    new DefaultApiClient({{invokerPackage}}.TransportOptions.builder().maxRetries(0).build()),
                    Configuration.builder()
                            .baseUrl(ChasmContainer.getBaseUrl() + "/test/status/" + row[0])
                            .build());
            Class<?> expected = (Class<?>) row[1];
            assertThatThrownBy(() -> routed.getOrderById(1L)).isExactlyInstanceOf(expected);
        }
    }

    @Test
    void bhvOperations120TestReserveStockDecodesTheBodyAsTheSchemaOfTheStatusThatArrived() throws Exception {
        String both =
                "{\"reservationId\":1,\"quantity\":2,\"receiptCode\":\"rcpt-1\","
                        + "\"expiresAt\":\"2030-01-01T00:00:00Z\"}";

        {{modelPackage}}.ReserveStockResponse existing =
                newStoreApiForMock(200, "application/json", both).reserveStock();
        {{modelPackage}}.ReserveStockResponse created =
                newStoreApiForMock(201, "application/json", both).reserveStock();

        assertThat(existing.getActualInstance()).isInstanceOf({{modelPackage}}.Reservation.class);
        assertThat(existing.asReservation()).isPresent();
        assertThat(existing.asReservationReceipt()).isEmpty();
        assertThat(created.getActualInstance()).isInstanceOf({{modelPackage}}.ReservationReceipt.class);
        assertThat(created.isReservationReceipt()).isTrue();
        assertThat(created.asReservation()).isEmpty();
    }

