/** Guards the claims the README makes about the SDK's own API. */
class ReadmeTest {

    private static String readme() throws IOException {
        return Files.readString(Path.of("README.md"));
    }

    private static String flattened() throws IOException {
        return readme().replaceAll("\\s+", " ");
    }

    @Test
    void bhvLangjava038HasTheSharedSectionsInTheSharedOrder() throws IOException {
        String readme = readme();
        int position = -1;
        for (String heading : new String[] {
                "## Installation", "## Usage", "### Raw responses", "### Timeouts",
                "### Automatic retries", "### Expired tokens", "### Request id", "### Cancellation",
                "### Custom HTTP client", "### Testing your code", "## Build", "## Test", "## Caveats", "### Schema constraints",
                "## Not supported", "### Webhooks and callbacks", "### XML bodies and `nodeType`",
                "### Link Objects", "### Mutual TLS security schemes"}) {
            int next = readme.indexOf("\n" + heading + "\n");
            assertTrue(next >= 0, "expected the README to contain the heading " + heading);
            assertTrue(next > position, "expected the heading " + heading + " after the previous one");
            position = next;
        }
    }

    @Test
    void bhvOptions044SocksNoteNamesTheJavaProxySetter() throws IOException {
        String readme = flattened();
        assertTrue(readme.contains(
                "`TransportOptions.builder().proxy(...)` accepts only `http://` and `https://` URLs."));
        assertFalse(readme.contains("TransportOptions.proxy()"));
    }

    @Test
    void bhvLangjava039SchemaConstraintsSectionSaysWhatTheServerValidatesAndThatUniqueItemsAreNotSorted()
            throws IOException {
        String readme = flattened();
        assertTrue(readme.contains("`multipleOf`, `minItems` and `maxItems` are validated by the server."));
        assertTrue(readme.contains("`uniqueItems` arrays are held in a `java.util.Set`"));
        assertTrue(readme.contains("the SDK does not sort them"));
    }

    @Test
    void bhvLangjava040RetriesSectionDocumentsTheOptionAndNoLongerSaysRequestsAreNeverRetried() throws IOException {
        String readme = flattened();
        assertTrue(readme.contains("`TransportOptions.builder().maxRetries(n)`"));
        assertFalse(readme.contains("never retries"));
    }

    @Test
    void bhvLangjava041PerCallOptionsSectionSaysEveryOperationTakesAnOptionsObject() throws IOException {
        String readme = flattened();
        assertTrue(readme.contains("### Per-call options"));
        assertTrue(readme.contains("Every operation takes an optional trailing options object"));
        assertTrue(readme.contains("An options object carries no authenticator"));
    }
