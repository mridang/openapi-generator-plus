    /**
     * Unwrap the body of a body-returning operation, throwing a typed
     * {@link ApiException} when the server returned no decodable body
     * (for example an empty or 204 response). The plain convenience
     * accessor must never hand back a silent {@code null} for a declared
     * non-void return type — callers get a catchable, typed error instead.
     *
     * @param result    the API result whose data should be present
     * @param operation the operation id, for the error message
     * @param <T>       the response body type
     * @return the non-null response body
     * @throws ApiException if the result carries no body
     */
    private static <T> T requireBody(ApiResult<T> result, String operation) {
        T data = result.data();
        if (data == null) {
            throw new ApiException(
                    result.statusCode(),
                    "Expected a response body for " + operation + " but received none",
                    result.headers(),
                    result.rawBody());
        }
        return data;
    }
