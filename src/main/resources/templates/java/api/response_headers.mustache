    private static Boolean parseBoolean(String name, String value) {
        if ("true".equals(value)) {
            return Boolean.TRUE;
        }
        if ("false".equals(value)) {
            return Boolean.FALSE;
        }
        throw invalid(name, "boolean", value);
    }
{{/usesBoolean}}
