/**
 * Unified entry point for all API services.
 *
 * <p>Takes an {@link Authenticator} and optionally {@link TransportOptions},
 * then exposes each API group as a typed property. If the authenticator
 * implements {@link HttpAwareAuthenticator}, the shared {@link ApiClient}
 * is injected so that authentication HTTP calls (token exchange, discovery)
 * use the same transport configuration as regular API calls.
 *
 * <p>Usage:
 * <pre>{@code
 * // Default transport
 * {{clientClassName}} client = new {{clientClassName}}(authenticator);
 *
 * // Custom transport (proxy, timeouts, etc.)
 * TransportOptions transport = TransportOptions.builder()
 *     .proxy("http://proxy:3128")
 *     .timeout(5000)
 *     .build();
 * {{clientClassName}} client = new {{clientClassName}}(authenticator, transport);
 * }</pre>
 */
@SuppressFBWarnings(
    value = {"URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"},
    justification = "generated code")
public final class {{clientClassName}} {

