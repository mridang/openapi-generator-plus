package {{invokerPackage}}.auth.oauth;

import {{invokerPackage}}.ApiClient;
import {{invokerPackage}}.auth.HttpAwareAuthenticator;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.security.SecureRandom;
import java.util.Base64;
import java.util.Collections;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.atomic.AtomicReference;
import javax.annotation.Nullable;

/**
 * Authenticator for the OAuth2 Authorization Code flow.
 *
 * <p>Implements {@link HttpAwareAuthenticator} so that token exchange requests
 * use the shared {@link ApiClient} with the same transport configuration
 * (proxy, TLS, timeouts) as regular API calls.
 *
 * <p>Usage:
 * <ol>
 *   <li>Call {@link #buildAuthorizationUrl(String)} to get the authorization URL; it
 *       carries a fresh PKCE S256 challenge (RFC 7636) and the matching verifier is
 *       kept here</li>
 *   <li>Redirect the user to that URL</li>
 *   <li>After the callback, call {@link #exchangeCode(String)} with the auth code; it
 *       sends the verifier as {@code code_verifier}</li>
 *   <li>Use the authenticator normally — tokens are managed automatically</li>
 * </ol>
 */
public class OAuth2AuthorizationCodeAuthenticator implements HttpAwareAuthenticator {

    private final String             host;
    private final String             clientId;
    private final String             clientSecret;
    private final String             authorizationUrl;
    private final String             tokenUrl;
    private final String             refreshUrl;
    private final String             redirectUri;
    private final List<String>       scopes;
    private final OAuth2TokenManager tokenManager;
    /** The PKCE verifier of the last authorization URL built, until the code exchange uses it. */
    private final AtomicReference<String> pkceVerifier = new AtomicReference<>();
    private static final SecureRandom RANDOM = new SecureRandom();

    /**
     * Create a new authorization code authenticator.
     *
     * @param host             API base URL
     * @param clientId         OAuth2 client ID
     * @param clientSecret     OAuth2 client secret
     * @param authorizationUrl authorization endpoint URL
     * @param tokenUrl         token endpoint URL
     * @param redirectUri      redirect URI registered with the OAuth2 provider
     * @param scopes           requested scopes
     */
    public OAuth2AuthorizationCodeAuthenticator(String host, String clientId,
            String clientSecret, String authorizationUrl, String tokenUrl,
            String redirectUri, List<String> scopes) {
        this(host, clientId, clientSecret, authorizationUrl, tokenUrl, redirectUri, scopes,
                (String) null);
    }

    /**
     * Create a new authorization code authenticator with a refresh URL.
     *
     * @param host             API base URL
     * @param clientId         OAuth2 client ID
     * @param clientSecret     OAuth2 client secret
     * @param authorizationUrl authorization endpoint URL
     * @param tokenUrl         token endpoint URL
     * @param redirectUri      redirect URI registered with the OAuth2 provider
     * @param scopes           requested scopes
     * @param refreshUrl       refresh token endpoint URL (falls back to tokenUrl if null)
     */
    public OAuth2AuthorizationCodeAuthenticator(String host, String clientId,
            String clientSecret, String authorizationUrl, String tokenUrl,
            String redirectUri, List<String> scopes, @Nullable String refreshUrl) {
        this(host, clientId, clientSecret, authorizationUrl, tokenUrl, refreshUrl,
                redirectUri, scopes, new OAuth2TokenManager());
    }

    /**
     * Create an authenticator around an existing token manager, so the session
     * it holds (tokens and the exchanged flag) carries over. OpenID Connect
     * uses this when a rediscovery names new endpoints.
     *
     * @param host             API base URL
     * @param clientId         OAuth2 client ID
     * @param clientSecret     OAuth2 client secret
     * @param authorizationUrl authorization endpoint URL
     * @param tokenUrl         token endpoint URL
     * @param redirectUri      redirect URI registered with the provider
     * @param scopes           requested scopes
     * @param tokenManager     the token manager that owns the session
     */
    OAuth2AuthorizationCodeAuthenticator(String host, String clientId,
            String clientSecret, String authorizationUrl, String tokenUrl,
            String redirectUri, List<String> scopes, OAuth2TokenManager tokenManager) {
        this(host, clientId, clientSecret, authorizationUrl, tokenUrl, null,
                redirectUri, scopes, tokenManager);
    }

    private OAuth2AuthorizationCodeAuthenticator(String host, String clientId,
            String clientSecret, String authorizationUrl, String tokenUrl,
            @Nullable String refreshUrl, String redirectUri, List<String> scopes,
            OAuth2TokenManager tokenManager) {
        this.host             = host;
        this.clientId         = clientId;
        this.clientSecret     = clientSecret;
        this.authorizationUrl = authorizationUrl;
        this.tokenUrl         = tokenUrl;
        this.refreshUrl       = refreshUrl != null ? refreshUrl : tokenUrl;
        this.redirectUri      = redirectUri;
        this.scopes           = List.copyOf(scopes);
        this.tokenManager     = tokenManager;
    }

    /**
     * The token manager that owns this authenticator's session.
     *
     * @return the token manager
     */
    OAuth2TokenManager tokenManager() {
        return tokenManager;
    }

    /**
     * Take over the pending PKCE verifier of the authenticator this one replaces,
     * so an OpenID Connect rediscovery between the authorization URL and the code
     * exchange does not lose it.
     *
     * @param previous the authenticator being replaced
     */
    void adoptPkceVerifierFrom(OAuth2AuthorizationCodeAuthenticator previous) {
        pkceVerifier.set(previous.pkceVerifier.get());
    }

    @Override
    public void setApiClient(ApiClient apiClient) {
        tokenManager.setApiClient(apiClient);
    }

    /**
     * Build the authorization URL to redirect the user to.
     *
     * @param state optional CSRF state parameter
     * @return the authorization URL
     */
    public String buildAuthorizationUrl(@Nullable String state) {
        StringBuilder url = new StringBuilder(authorizationUrl);
        /* RFC 6749 §3.1: the authorization endpoint URI MAY already include
         * a query component (e.g. tenant-scoped Auth0 URLs like
         * https://x.auth0.com/authorize?audience=api). Use '&' as the
         * separator when one is already present so existing params are
         * preserved, '?' otherwise. */
        url.append(authorizationUrl.indexOf('?') >= 0 ? '&' : '?');
        url.append("response_type=code");
        url.append("&client_id=").append(encode(clientId));
        url.append("&redirect_uri=").append(encode(redirectUri));
        if (!scopes.isEmpty()) {
            url.append("&scope=").append(encode(String.join(" ", scopes)));
        }
        if (state != null && !state.isEmpty()) {
            url.append("&state=").append(encode(state));
        }
        /* RFC 7636 / RFC 9700 section 2.1.1: bind the code to this client with a
         * PKCE S256 challenge; the verifier is kept for exchangeCode. */
        String verifier = newPkceVerifier();
        pkceVerifier.set(verifier);
        url.append("&code_challenge=").append(pkceChallenge(verifier));
        url.append("&code_challenge_method=S256");
        return url.toString();
    }

    /**
     * Exchange an authorization code for an access token.
     *
     * @param code the authorization code from the callback
     */
    public void exchangeCode(String code) {
        /* RFC 6749 §4.1.3: the authorization code is a required parameter of
         * the token request. Reject an empty/whitespace code before the POST
         * so the caller sees a clear precondition error rather than a confusing
         * downstream "invalid_grant" from the IdP (or no error at all). */
        if (code == null || code.trim().isEmpty()) {
            throw new IllegalArgumentException("Authorization code must not be empty");
        }
        Map<String, String> params = new LinkedHashMap<>();
        params.put("grant_type", "authorization_code");
        params.put("code", code);
        params.put("client_id", clientId);
        params.put("client_secret", clientSecret);
        params.put("redirect_uri", redirectUri);
        /* RFC 7636 section 4.5: prove the challenge sent with the authorization
         * request. The verifier is single use. */
        String verifier = pkceVerifier.getAndSet(null);
        if (verifier != null) {
            params.put("code_verifier", verifier);
        }
        /* RFC 6749 section 4.1.3: every exchange sends its code. exchange()
         * bypasses the token cache and the refresh grant, replaces the session
         * on success and keeps the previous one on failure. */
        tokenManager.exchange(tokenUrl, params, Collections.emptyMap());
    }

    /**
     * Drop the cached access token so the next request fetches a new one. The
     * refresh token is kept, so the new token comes from the refresh grant
     * when the server issued one.
     */
    @Override
    public void invalidateAccessToken() {
        tokenManager.invalidateAccessToken();
    }

    @Override
    public String getHost() {
        return host;
    }

    @Override
    public Map<String, String> getAuthHeaders() {
        if (!tokenManager.isExchanged()) {
            throw new IllegalStateException("Must call exchangeCode() before making API requests");
        }
        Map<String, String> params = new LinkedHashMap<>();
        params.put("grant_type", "refresh_token");
        /* An OP that issued no refresh_token leaves none to send. Put an empty
         * value rather than null (which would fail to form-encode) so the OP
         * answers with its typed OAuth2ServerException. RFC 6749 section 6:
         * the refresh authenticates the client like the code exchange did. */
        String refreshToken = tokenManager.getRefreshToken();
        params.put("refresh_token", refreshToken != null ? refreshToken : "");
        params.put("client_id", clientId);
        params.put("client_secret", clientSecret);
        String token = tokenManager.getAccessToken(refreshUrl, params);
        return Collections.singletonMap("Authorization", "Bearer " + token);
    }

    /**
     * A fresh PKCE code verifier (RFC 7636 section 4.1): 32 random bytes as
     * unpadded base64url, 43 characters.
     */
    static String newPkceVerifier() {
        byte[] bytes = new byte[32];
        RANDOM.nextBytes(bytes);
        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
    }

    /**
     * The S256 code challenge of a verifier: {@code BASE64URL(SHA256(verifier))}
     * (RFC 7636 section 4.2).
     */
    static String pkceChallenge(String verifier) {
        try {
            byte[] digest =
                    MessageDigest.getInstance("SHA-256").digest(verifier.getBytes(StandardCharsets.US_ASCII));
            return Base64.getUrlEncoder().withoutPadding().encodeToString(digest);
        } catch (NoSuchAlgorithmException e) {
            throw new IllegalStateException("SHA-256 is not available", e);
        }
    }

    private static String encode(String value) {
        /* RFC 3986 query component: a space is %20, not '+'. URLEncoder emits
         * '+' (form rules), so map it back; a literal '+' is already %2B.
         * URLEncoder also keeps '*' literal and escapes '~' to %7E — the reverse
         * of the RFC 3986 unreserved set (A-Za-z0-9-._~) — so normalise both
         * ('*' -> %2A, %7E -> '~') to emit identical bytes across every SDK. */
        return URLEncoder.encode(value, StandardCharsets.UTF_8)
                .replace("+", "%20")
                .replace("*", "%2A")
                .replace("%7E", "~");
    }

    /**
     * Returns a string representation that redacts the client secret so
     * credentials never leak into logs or stack traces (matching the other
     * SDKs).
     *
     * @return a redacted string representation
     */
    @Override
    public String toString() {
        return getClass().getSimpleName() + "(host=" + host
                + ", clientId=" + clientId
                + ", clientSecret=***, authorizationUrl=" + authorizationUrl
                + ", tokenUrl=" + tokenUrl
                + ", refreshUrl=" + refreshUrl
                + ", redirectUri=" + redirectUri
                + ", scopes=" + scopes + ")";
    }
}
