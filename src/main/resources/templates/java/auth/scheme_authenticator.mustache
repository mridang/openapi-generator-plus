import java.util.Map;
import javax.annotation.Nullable;

{{! Composition over inheritance: the three base authenticators }}
{{! (Basic/Bearer/ApiKey) are final and validate credentials eagerly in }}
{{! their constructors. A subclass cannot extend a final class, and a }}
{{! non-final class with a throwing constructor trips SpotBugs }}
{{! CT_CONSTRUCTOR_THROW. So this wrapper is itself final, extends }}
{{! BaseAuthenticator to remain a valid Authenticator for the client, and }}
{{! delegates to a held final instance of the concrete base. The base is }}
{{! constructed here, so eager validation still happens at construction. }}
/**
 * Authenticator for the {@code {{schemeName}}} security scheme.
 *
 * <p>A credential that is {@code null} is read once, when the authenticator is built,
 * from its environment variable. A credential found nowhere raises an
 * {@link IllegalArgumentException}.
 */
public final class {{className}} extends BaseAuthenticator {
    private final {{baseClass}} delegate;

    /**
     * Creates an authenticator for the {@code {{schemeName}}} security scheme.
     *
{{#constructorParams}}
     * @param {{name}} the {{name}} credential{{#hasEnv}}; when {@code null} it is read from the {@code {{envName}}} environment variable{{/hasEnv}}
{{/constructorParams}}
     */
    public {{className}}({{#constructorParams}}{{#hasEnv}}@Nullable {{/hasEnv}}{{type}} {{name}}{{^-last}}, {{/-last}}{{/constructorParams}}) {
        this({{#constructorParams}}{{name}}, {{/constructorParams}}System.getenv());
    }

    /**
     * Creates an authenticator whose every credential is read from its environment variable.
     *
     * @param host the API base URL (never read from the environment)
     */
    public {{className}}(String host) {
        this(host{{#constructorParams}}{{^-first}}, null{{/-first}}{{/constructorParams}}, System.getenv());
    }

    /* Package-private so a test can supply the environment instead of the process one. */
    {{className}}({{#constructorParams}}{{#hasEnv}}@Nullable {{/hasEnv}}{{type}} {{name}}, {{/constructorParams}}Map<String, String> environment) {
        this.delegate = new {{baseClass}}({{#superArgs}}{{{.}}}{{^-last}}, {{/-last}}{{/superArgs}});
    }

    @Override
    public String getHost() {
        return delegate.getHost();
    }

    @Override
    public Map<String, String> getAuthHeaders() {
        return delegate.getAuthHeaders();
    }

    @Override
    public Map<String, String> getQueryParams() {
        return delegate.getQueryParams();
    }

    @Override
    public Map<String, String> getCookieParams() {
        return delegate.getCookieParams();
    }

    /**
     * Returns the delegate's redacted representation under this wrapper's own
     * class name, so the credential never leaks and the type stays visible.
     *
     * @return a redacted string representation
     */
    @Override
    public String toString() {
        String repr = delegate.toString();
        return getClass().getSimpleName() + repr.substring(repr.indexOf('('));
    }
