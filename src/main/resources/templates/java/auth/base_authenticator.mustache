package {{invokerPackage}}.auth;

import java.util.Map;

/**
 * Abstract base class providing default implementations for optional
 * {@link Authenticator} methods. Concrete authenticators should extend this class.
 */
public abstract class BaseAuthenticator implements Authenticator {

    /** Creates a new authenticator. */
    protected BaseAuthenticator() {}

    @Override
    public abstract String getHost();

    @Override
    public abstract Map<String, String> getAuthHeaders();
}
