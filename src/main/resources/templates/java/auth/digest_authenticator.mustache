package {{invokerPackage}}.auth;

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.security.SecureRandom;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.HexFormat;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.function.Supplier;
import javax.annotation.Nullable;

/**
 * Authenticator for HTTP Digest authentication (RFC 7616).
 *
 * <p>It sends nothing until the server answers {@code 401} with a {@code WWW-Authenticate: Digest}
 * challenge; the SDK then answers that challenge and replays the request once. Later requests
 * answer the remembered challenge up front with the nonce count incremented. The algorithms
 * {@code MD5}, {@code MD5-sess}, {@code SHA-256} and {@code SHA-256-sess} are supported with
 * {@code qop=auth} or without a {@code qop}.
 */
public final class DigestAuthenticator extends BaseAuthenticator implements ChallengeAuthenticator {

    private static final SecureRandom RANDOM = new SecureRandom();

    private final String host;
    private final String username;
    private final String password;
    private final Supplier<String> cnonceSource;

    /* The remembered challenge, guarded by this. */
    @Nullable private Challenge challenge;
    private int nonceCount;

    /**
     * Creates an HTTP Digest authenticator.
     *
     * @param host the base URL of the API
     * @param username the Digest username
     * @param password the Digest password
     */
    public DigestAuthenticator(String host, String username, String password) {
        this(host, username, password, DigestAuthenticator::randomCnonce);
    }

    /* Package-private so a test can fix the client nonce. */
    DigestAuthenticator(String host, String username, String password, Supplier<String> cnonceSource) {
        if (username == null || username.isEmpty()) {
            throw new IllegalArgumentException("Digest username must not be empty");
        }
        String secret = password == null ? "" : password;
        if (hasLineBreakOrNul(username) || hasLineBreakOrNul(secret)) {
            throw new IllegalArgumentException(
                    "Digest credentials must not contain a line break or NUL");
        }
        if (username.indexOf('"') >= 0) {
            throw new IllegalArgumentException("Digest username must not contain a double quote");
        }
        this.host = host;
        this.username = username;
        this.password = secret;
        this.cnonceSource = cnonceSource;
    }

    @Override
    public String getHost() {
        return host;
    }

    /**
     * Returns no headers: a Digest answer needs the method and the request target, which the
     * SDK's dispatch passes to {@link #authorization(String, String)}.
     *
     * @return an empty map
     */
    @Override
    public Map<String, String> getAuthHeaders() {
        return Collections.emptyMap();
    }

    @Override
    @Nullable
    public String authorization(String method, String requestTarget) {
        Challenge current;
        int count;
        synchronized (this) {
            current = challenge;
            if (current == null) {
                return null;
            }
            nonceCount++;
            count = nonceCount;
        }
        String nc = String.format(Locale.ROOT, "%08x", count);
        String cnonce = cnonceSource.get();
        String algorithm = current.algorithm == null ? "MD5" : current.algorithm;
        String upper = algorithm.toUpperCase(Locale.ROOT);
        String hashName = upper.startsWith("SHA-256") ? "SHA-256" : "MD5";
        String ha1 = hash(hashName, username + ":" + current.realm + ":" + password);
        if (upper.endsWith("-SESS")) {
            ha1 = hash(hashName, ha1 + ":" + current.nonce + ":" + cnonce);
        }
        String ha2 = hash(hashName, method + ":" + requestTarget);
        String response = current.qop
                ? hash(hashName, ha1 + ":" + current.nonce + ":" + nc + ":" + cnonce + ":auth:" + ha2)
                : hash(hashName, ha1 + ":" + current.nonce + ":" + ha2);
        StringBuilder header = new StringBuilder("Digest ");
        header.append("username=").append(quote(username));
        header.append(", realm=").append(quote(current.realm));
        header.append(", nonce=").append(quote(current.nonce));
        header.append(", uri=").append(quote(requestTarget));
        if (current.algorithm != null) {
            header.append(", algorithm=").append(current.algorithm);
        }
        header.append(", response=").append(quote(response));
        if (current.qop) {
            header.append(", qop=auth, nc=").append(nc).append(", cnonce=").append(quote(cnonce));
        }
        if (current.opaque != null) {
            header.append(", opaque=").append(quote(current.opaque));
        }
        return header.toString();
    }

    @Override
    public boolean acceptChallenge(String wwwAuthenticate) {
        for (Map.Entry<String, Map<String, String>> parsed : parseChallenges(wwwAuthenticate)) {
            if (!"digest".equalsIgnoreCase(parsed.getKey())) {
                continue;
            }
            Map<String, String> params = parsed.getValue();
            String qop = params.get("qop");
            boolean offersAuth = false;
            if (qop != null) {
                for (String option : qop.split(",", -1)) {
                    if ("auth".equalsIgnoreCase(option.trim())) {
                        offersAuth = true;
                    }
                }
                if (!offersAuth) {
                    continue;
                }
            }
            String algorithm = params.get("algorithm");
            if (algorithm != null && !isSupported(algorithm)) {
                continue;
            }
            Challenge accepted = new Challenge(
                    params.getOrDefault("realm", ""),
                    params.getOrDefault("nonce", ""),
                    params.get("opaque"),
                    algorithm,
                    offersAuth);
            synchronized (this) {
                challenge = accepted;
                nonceCount = 0;
            }
            return true;
        }
        return false;
    }

    /**
     * Returns a string representation that redacts the password so credentials
     * never leak into logs or stack traces (matching the other SDKs).
     *
     * @return a redacted string representation
     */
    @Override
    public String toString() {
        return getClass().getSimpleName() + "(host=" + host + ", username=" + username + ", password=***)";
    }

    private static boolean isSupported(String algorithm) {
        String upper = algorithm.toUpperCase(Locale.ROOT);
        return upper.equals("MD5") || upper.equals("MD5-SESS")
                || upper.equals("SHA-256") || upper.equals("SHA-256-SESS");
    }

    private static boolean hasLineBreakOrNul(String value) {
        return value.indexOf('\r') >= 0 || value.indexOf('\n') >= 0 || value.indexOf('\0') >= 0;
    }

    private static String quote(String value) {
        return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }

    private static String hash(String algorithm, String text) {
        try {
            MessageDigest digest = MessageDigest.getInstance(algorithm);
            return HexFormat.of().formatHex(digest.digest(text.getBytes(StandardCharsets.UTF_8)));
        } catch (NoSuchAlgorithmException e) {
            throw new IllegalStateException(algorithm + " is not available", e);
        }
    }

    private static String randomCnonce() {
        byte[] bytes = new byte[16];
        RANDOM.nextBytes(bytes);
        return HexFormat.of().formatHex(bytes);
    }

    /*
     * Splits a WWW-Authenticate value into its challenges: a scheme name followed by
     * name=token or name="quoted" parameters (backslash escapes), separated by commas.
     * Parameter names are lower-cased.
     */
    private static List<Map.Entry<String, Map<String, String>>> parseChallenges(String header) {
        List<Map.Entry<String, Map<String, String>>> challenges = new ArrayList<>();
        Map<String, String> current = null;
        int length = header.length();
        int i = 0;
        while (i < length) {
            char c = header.charAt(i);
            if (c == ',' || Character.isWhitespace(c)) {
                i++;
                continue;
            }
            int start = i;
            while (i < length && !isDelimiter(header.charAt(i))) {
                i++;
            }
            String token = header.substring(start, i);
            int afterToken = i;
            while (i < length && Character.isWhitespace(header.charAt(i))) {
                i++;
            }
            if (token.isEmpty() || i >= length || header.charAt(i) != '=') {
                if (token.isEmpty()) {
                    i = afterToken + 1;
                    continue;
                }
                current = new HashMap<>();
                challenges.add(Map.entry(token, current));
                i = afterToken;
                continue;
            }
            i++;
            while (i < length && Character.isWhitespace(header.charAt(i))) {
                i++;
            }
            StringBuilder value = new StringBuilder();
            if (i < length && header.charAt(i) == '"') {
                i++;
                while (i < length && header.charAt(i) != '"') {
                    if (header.charAt(i) == '\\' && i + 1 < length) {
                        i++;
                    }
                    value.append(header.charAt(i));
                    i++;
                }
                i++;
            } else {
                while (i < length && header.charAt(i) != ',' && !Character.isWhitespace(header.charAt(i))) {
                    value.append(header.charAt(i));
                    i++;
                }
            }
            if (current != null) {
                current.putIfAbsent(token.toLowerCase(Locale.ROOT), value.toString());
            }
        }
        return challenges;
    }

    private static boolean isDelimiter(char c) {
        return c == ',' || c == '=' || c == '"' || Character.isWhitespace(c);
    }

    private static final class Challenge {
        final String realm;
        final String nonce;
        @Nullable final String opaque;
        @Nullable final String algorithm;
        final boolean qop;

        Challenge(String realm, String nonce, @Nullable String opaque, @Nullable String algorithm, boolean qop) {
            this.realm = realm;
            this.nonce = nonce;
            this.opaque = opaque;
            this.algorithm = algorithm;
            this.qop = qop;
        }
    }
}
