<?xml version="1.0"?>
<FindBugsFilter>
  <!-- Generated models/utilities carry @SuppressFBWarnings on a handful of
       intentional patterns (exposed fields, ignored best-effort exceptions).
       SpotBugs flags some of these as unnecessary on certain JDKs via
       US_USELESS_SUPPRESSION_*; that verdict varies by analysis build and is
       not actionable without per-template introspection, so it is filtered. -->
  <Match>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_CLASS"/>
  </Match>
  <Match>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_METHOD"/>
  </Match>
  <!-- DefaultApiClient + OAuth2TokenManager wrap library exceptions in
       RuntimeException at boundary points (configuration error, IO);
       this is intentional and surfaces to caller. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>
  <!-- CRLF in user-controlled strings reaches the SDK only through configured
       headers; we sanitise at construction time. -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
</FindBugsFilter>
