package {{invokerPackage}}.errors;

import java.util.Map;
import javax.annotation.Nullable;

/**
 * Exception for a buffered response body that passed {@code maxResponseBytes} of the
 * {@code TransportOptions}: the bytes on the wire or the decompressed bytes crossed the limit.
 * A response did arrive, so it carries the real status code and headers, but the body was not
 * kept: it is empty. Only the default client raises it, and it is never retried.
 */
public class ResponseTooLargeException extends ApiException {
    @java.io.Serial
    private static final long serialVersionUID = 1L;

    /** The limit in bytes that the body passed. */
    private final long limit;

    /**
     * Creates a new exception.
     *
     * @param statusCode the HTTP status code of the response
     * @param responseHeaders the response headers, names in lower case
     * @param limit the limit in bytes that the body passed
     */
    public ResponseTooLargeException(
            int statusCode, @Nullable Map<String, String> responseHeaders, long limit) {
        this(statusCode, responseHeaders, limit, null, null);
    }

    /**
     * Creates a new exception that records the request whose response was too large.
     *
     * @param statusCode the HTTP status code of the response
     * @param responseHeaders the response headers, names in lower case
     * @param limit the limit in bytes that the body passed
     * @param requestMethod the HTTP method of the request, if known
     * @param requestPath the path or URL of the request, if known; a query string is stripped
     */
    public ResponseTooLargeException(
            int statusCode,
            @Nullable Map<String, String> responseHeaders,
            long limit,
            @Nullable String requestMethod,
            @Nullable String requestPath) {
        super(
                statusCode,
                "Response body exceeds the limit of " + limit + " bytes",
                responseHeaders,
                "",
                null,
                null,
                requestMethod,
                requestPath);
        this.limit = limit;
    }

    /**
     * The limit in bytes that the body passed.
     *
     * @return the {@code maxResponseBytes} the response was read with
     */
    public long getLimit() {
        return limit;
    }

    /**
     * Never retryable: the same request draws the same body, whatever its status.
     *
     * @return {@code false}
     */
    @Override
    public boolean isRetryable() {
        return false;
    }
}
