package {{invokerPackage}}.errors;

import javax.annotation.Nullable;

/**
 * Raised when a paged list cannot be followed safely: the server returned the cursor that was just
 * sent, so asking again would loop forever, or a {@code Link} header pointed to another origin, so
 * following it would send the credentials there. It is not a network error and not an API error:
 * it is a direct child of {@link {{errorPrefix}}Exception}, and the items already delivered are
 * complete and correct. A failed page request raises the SDK error of that failure instead.
 */
public class PaginationException extends {{errorPrefix}}Exception {
    @java.io.Serial
    private static final long serialVersionUID = 1L;

    /** The path of the request whose response could not be followed, without its query. */
    @Nullable private final String requestPath;

    /**
     * Creates a new exception.
     *
     * @param message what made the list impossible to follow; it never holds a query string
     * @param requestPath the path of the request that returned the page, without its query, or {@code null}
     */
    public PaginationException(String message, @Nullable String requestPath) {
        super(message);
        this.requestPath = requestPath;
    }

    /**
     * Returns the path of the request whose response could not be followed.
     *
     * @return the path without its query, or {@code null} when it is not known
     */
    @Nullable
    public String getRequestPath() {
        return requestPath;
    }
}
