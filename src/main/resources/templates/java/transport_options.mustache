package {{invokerPackage}};

import java.util.Collections;
import java.util.HashMap;
import java.util.Map;
import javax.annotation.Nullable;

/**
 * Immutable HTTP transport configuration for {@link DefaultApiClient}.
 *
 * <p>Controls low-level HTTP behavior such as TLS verification, proxy routing,
 * timeouts, redirect handling, and automatic header injection. These settings
 * are independent of API-level concerns (base URL, authentication headers)
 * which belong in {@link Configuration}.
 *
 * <p>This class is immutable and thread-safe. Use {@link #builder()} to create instances:
 * <pre>{@code
 * TransportOptions transport = TransportOptions.builder()
 *     .verifySsl(false)
 *     .proxy("http://proxy.example.com:8080")
 *     .timeout(5000)
 *     .userAgent("MyApp/1.0")
 *     .build();
 * }</pre>
 */
public final class TransportOptions {

    private final boolean         verifySsl;
    @Nullable private final String          caCertPath;
    @Nullable private final String          proxy;
    @Nullable private final Integer         timeout;
    private final boolean         followRedirects;
    @Nullable private final Integer         maxRedirects;
    @Nullable private final String          userAgent;
    private final Map<String, String> defaultHeaders;
    private final boolean         injectRequestId;
    @Nullable private final java.net.http.HttpClient httpClient;
    private final int             maxRetries;
    @Nullable private final Integer         idleTimeout;

    TransportOptions(
            boolean         verifySsl,
            @Nullable String          caCertPath,
            @Nullable String          proxy,
            @Nullable Integer         timeout,
            boolean         followRedirects,
            @Nullable Integer         maxRedirects,
            @Nullable String          userAgent,
            Map<String, String> defaultHeaders,
            boolean         injectRequestId,
            @Nullable java.net.http.HttpClient httpClient,
            int             maxRetries,
            @Nullable Integer         idleTimeout) {
        Builder.validateProxy(proxy);
        this.verifySsl       = verifySsl;
        this.caCertPath      = caCertPath;
        this.proxy           = proxy;
        this.timeout         = timeout;
        this.followRedirects = followRedirects;
        this.maxRedirects    = maxRedirects;
        this.userAgent       = userAgent;
        this.defaultHeaders  = Collections.unmodifiableMap(new HashMap<>(defaultHeaders));
        this.injectRequestId = injectRequestId;
        this.httpClient      = httpClient;
        this.maxRetries      = maxRetries;
        this.idleTimeout     = idleTimeout == null || idleTimeout == 0 ? null : idleTimeout;
    }

    /**
     * Describe these options for a log. The proxy password and the value of every sensitive
     * default header are replaced by {@code ***}, so the text never carries a credential.
     *
     * @return a masked description of the options
     */
    @Override
    public String toString() {
        Map<String, String> headers = new java.util.LinkedHashMap<>();
        for (Map.Entry<String, String> header : defaultHeaders.entrySet()) {
            headers.put(
                    header.getKey(), isSensitiveHeader(header.getKey()) ? "***" : header.getValue());
        }
        return "TransportOptions{verifySsl=" + verifySsl
                + ", caCertPath=" + caCertPath
                + ", proxy=" + (proxy == null ? null : Builder.redactUserInfo(proxy))
                + ", timeout=" + timeout
                + ", followRedirects=" + followRedirects
                + ", maxRedirects=" + maxRedirects
                + ", userAgent=" + userAgent
                + ", defaultHeaders=" + headers
                + ", injectRequestId=" + injectRequestId
                + ", maxRetries=" + maxRetries
                + ", idleTimeout=" + idleTimeout
                + "}";
    }

    /** A header whose value is a credential: the SDK strips it across origins, so it is masked. */
    private static boolean isSensitiveHeader(String name) {
        String lower = name.toLowerCase(java.util.Locale.ROOT);
        return DefaultApiClient.SENSITIVE_HEADER_NAMES.contains(lower)
                || lower.contains("key")
                || lower.contains("token")
                || lower.contains("secret");
    }

    /**
     * Create a new builder for constructing {@link TransportOptions} instances.
     *
     * @return a new builder with sensible defaults
     */
    public static Builder builder() {
        return new Builder();
    }

    /**
     * Whether TLS certificate verification is enabled.
     *
     * @return {@code true} if the client verifies server certificates (default),
     *         {@code false} to accept any certificate
     */
    public boolean isVerifySsl() {
        return verifySsl;
    }

    /**
     * Path to a custom CA certificate bundle for TLS verification.
     *
     * <p>When set together with {@code verifySsl=true}, the client trusts
     * certificates signed by this CA in addition to (or instead of) the
     * system trust store.
     *
     * @return the file path, or {@code null} to use the system default
     */
    @Nullable
    public String getCaCertPath() {
        return caCertPath;
    }

    /**
     * HTTP or HTTPS proxy URL for all outbound requests.
     *
     * <p>Example: {@code "http://proxy.corp.example.com:3128"}.
     *
     * @return the proxy URL, or {@code null} for direct connections
     */
    @Nullable
    public String getProxy() {
        return proxy;
    }

    /**
     * End-to-end request timeout in milliseconds.
     *
     * <p>Covers the entire request lifecycle: connection, TLS handshake,
     * sending the request body, and reading the response. Defaults to
     * 10000 ms (10 seconds) when the builder does not set a value.
     *
     * @return timeout in milliseconds, or {@code null} for no timeout
     */
    @Nullable
    public Integer getTimeout() {
        return timeout;
    }

    /**
     * Whether the client follows HTTP 3xx redirects automatically.
     *
     * @return {@code true} to follow redirects (default), {@code false} to
     *         return the redirect response as-is
     */
    public boolean isFollowRedirects() {
        return followRedirects;
    }

    /**
     * Maximum number of consecutive redirects to follow.
     *
     * <p>Only meaningful when {@link #isFollowRedirects()} is {@code true}.
     * A value of {@code null} uses the HTTP client's built-in default.
     *
     * @return the maximum redirect hops, or {@code null} for the client default
     */
    @Nullable
    public Integer getMaxRedirects() {
        return maxRedirects;
    }

    /**
     * Custom {@code User-Agent} header value.
     *
     * <p>When set, this value is sent as the {@code User-Agent} header on
     * every request unless the caller explicitly provides one.
     *
     * @return the user agent string, or {@code null} to omit
     */
    @Nullable
    public String getUserAgent() {
        return userAgent;
    }

    /**
     * Transport-level default headers included in every request.
     *
     * <p>These headers have the <em>lowest</em> priority: API-level headers
     * from {@link Configuration#getDefaultHeaders()}, operation-specific
     * headers, and authentication headers all take precedence.
     *
     * @return an unmodifiable map of header names to values
     */
    public Map<String, String> getDefaultHeaders() {
        return defaultHeaders;
    }

    /**
     * Whether to auto-inject an {@code X-Request-ID} header with a unique
     * UUID on every request.
     *
     * <p>Useful for distributed tracing and log correlation. The header is
     * only injected if the caller has not already set one.
     *
     * @return {@code true} to inject request IDs, {@code false} otherwise
     */
    public boolean isInjectRequestId() {
        return injectRequestId;
    }

    /**
     * The caller-supplied {@link java.net.http.HttpClient}, if any.
     *
     * <p>When set, the SDK sends every request through this client and never
     * closes it: the caller owns its lifecycle. The SDK defaults for the
     * request timeout, retries, user agent and redirect handling are still
     * applied on top of it.
     *
     * @return the injected client, or {@code null} to let the SDK build its own
     */
    @Nullable
    public java.net.http.HttpClient getHttpClient() {
        return httpClient;
    }

    /**
     * How many times a failed request is retried.
     *
     * <p>A request is retried after a network error that happened before any
     * response arrived, and after an HTTP 408, 409, 429 or 5xx status (501
     * excepted), waiting 0.5 s doubling to 8 s with 25% jitter, or the
     * {@code Retry-After} the server named (capped at 60 s). The retries share
     * the single end-to-end {@link #getTimeout() timeout}, and a request with a
     * stream or multipart body is never retried.
     *
     * @return the retry count; {@code 0} disables retries (default {@code 2})
     */
    public int getMaxRetries() {
        return maxRetries;
    }

    /**
     * The longest a streamed response body may stay silent, in milliseconds.
     *
     * <p>Applies only to a call that returns a stream (a binary operation): the
     * {@link #getTimeout() timeout} stops at the response headers, and this value bounds the
     * gap between two reads of the body. A stalled body raises
     * {@link {{invokerPackage}}.errors.NetworkTimeoutException}. A buffered call is unaffected.
     *
     * @return the idle timeout in milliseconds, or {@code null} when it is disabled
     *         (default {@code 60000})
     */
    @Nullable
    public Integer getIdleTimeout() {
        return idleTimeout;
    }

    /**
     * Builder for creating immutable {@link TransportOptions} instances.
     *
     * <p>All fields have sensible defaults:
     * <ul>
     *   <li>{@code verifySsl} — {@code true}</li>
     *   <li>{@code followRedirects} — {@code true}</li>
     *   <li>{@code injectRequestId} — {@code false}</li>
     *   <li>{@code timeout} — {@code 10000} (10 seconds)</li>
     *   <li>{@code maxRetries} — {@code 2}</li>
     *   <li>{@code idleTimeout} — {@code 60000} (60 seconds)</li>
     *   <li>{@code userAgent} — a package-specific default string</li>
     *   <li>All other fields — {@code null} or empty</li>
     * </ul>
     */
    public static final class Builder {

        private boolean                verifySsl       = true;
        @Nullable private String       caCertPath      = null;
        @Nullable private String       proxy           = null;
        @Nullable private Integer      timeout         = 10000;
        private boolean                followRedirects = true;
        @Nullable private Integer      maxRedirects    = null;
        @Nullable private String       userAgent       = "{{userAgentDefault}}";
        private final Map<String, String> defaultHeaders  = new HashMap<>();
        private boolean                injectRequestId = false;
        @Nullable private java.net.http.HttpClient httpClient = null;
        private int                    maxRetries      = 2;
        @Nullable private Integer      idleTimeout     = 60000;

        Builder() {}

        /**
         * Use a caller-supplied {@link java.net.http.HttpClient} as the transport.
         *
         * <p>The SDK keeps its own wrapper and applies its defaults (request
         * timeout, retries, user agent, redirect policy) on top, but never
         * closes the supplied client. Proxy, TLS verification and CA
         * certificate settings belong to the supplied client, so combining it
         * with {@link #proxy}, {@link #caCertPath} or {@code verifySsl(false)}
         * makes {@link #build()} fail. The supplied client must not follow
         * redirects itself (its redirect policy must be
         * {@link java.net.http.HttpClient.Redirect#NEVER}), because the SDK
         * drives the redirect loop.
         *
         * @param httpClient the client to send requests through, or {@code null} for the default
         * @return this builder
         */
        public Builder httpClient(@Nullable java.net.http.HttpClient httpClient) {
            this.httpClient = httpClient;
            return this;
        }

        /**
         * Enable or disable TLS certificate verification.
         *
         * @param verifySsl {@code true} to verify (default), {@code false} to skip
         * @return this builder
         */
        public Builder verifySsl(boolean verifySsl) {
            this.verifySsl = verifySsl;
            return this;
        }

        /**
         * Set the path to a custom CA certificate bundle.
         *
         * @param caCertPath file path to a PEM-encoded CA certificate, or {@code null}
         * @return this builder
         */
        public Builder caCertPath(@Nullable String caCertPath) {
            this.caCertPath = caCertPath;
            return this;
        }

        /**
         * Render a proxy URL for an error message with any {@code user:password@}
         * userinfo replaced by {@code ***@}, so credentials never reach a log.
         *
         * @param url the proxy URL as supplied
         * @return the URL with its userinfo masked
         */
        private static String redactUserInfo(String url) {
            return url.replaceFirst("^([A-Za-z][A-Za-z0-9+.\\-]*://)[^/?#]*@", "$1***@");
        }

        /**
         * Set the HTTP/HTTPS proxy URL. The URL is checked by {@link #build()}, so a
         * malformed value is reported once, when the options are built.
         *
         * @param proxy proxy URL (e.g. {@code "http://proxy:3128"}), or {@code null}
         * @return this builder
         */
        public Builder proxy(@Nullable String proxy) {
            this.proxy = proxy;
            return this;
        }

        /**
         * Check a proxy URL: it must parse, use http or https, and name a host.
         *
         * @param proxy the proxy URL as supplied, or {@code null} for a direct connection
         * @throws IllegalArgumentException if the proxy URL is not usable
         */
        private static void validateProxy(@Nullable String proxy) {
            if (proxy == null) {
                return;
            }
            java.net.URI uri;
            try {
                uri = java.net.URI.create(proxy);
            } catch (IllegalArgumentException e) {
                throw new IllegalArgumentException("Invalid proxy URL: " + redactUserInfo(proxy), e);
            }
            String scheme = uri.getScheme();
            if (!"http".equalsIgnoreCase(scheme) && !"https".equalsIgnoreCase(scheme)) {
                throw new IllegalArgumentException(
                        "Invalid proxy URL (must use http or https scheme): " + redactUserInfo(proxy));
            }
            if (uri.getHost() == null || uri.getHost().isEmpty()) {
                throw new IllegalArgumentException(
                        "Invalid proxy URL (missing host): " + redactUserInfo(proxy));
            }
        }

        /**
         * Set the end-to-end request timeout in milliseconds.
         *
         * @param timeout timeout in milliseconds (positive), or {@code null} for no timeout
         * @return this builder
         */
        public Builder timeout(@Nullable Integer timeout) {
            if (timeout != null && timeout <= 0) {
                throw new IllegalArgumentException(
                        "Invalid timeout: must be a positive number of milliseconds (got " + timeout + ")");
            }
            this.timeout = timeout;
            return this;
        }

        /**
         * Set the longest a streamed response body may stay silent, in milliseconds.
         *
         * @param idleTimeout the gap in milliseconds (positive), or {@code 0} or {@code null} to
         *                    disable it; the default is {@code 60000}
         * @return this builder
         */
        public Builder idleTimeout(@Nullable Integer idleTimeout) {
            if (idleTimeout != null && idleTimeout < 0) {
                throw new IllegalArgumentException(
                        "Invalid idleTimeout: must not be negative (got " + idleTimeout + ")");
            }
            this.idleTimeout = idleTimeout == null || idleTimeout == 0 ? null : idleTimeout;
            return this;
        }

        /**
         * Enable or disable automatic redirect following.
         *
         * @param followRedirects {@code true} to follow (default), {@code false} to stop
         * @return this builder
         */
        public Builder followRedirects(boolean followRedirects) {
            this.followRedirects = followRedirects;
            return this;
        }

        /**
         * Set the maximum number of redirects to follow.
         *
         * @param maxRedirects maximum redirect hops (not negative), or {@code null} for client default
         * @return this builder
         */
        public Builder maxRedirects(@Nullable Integer maxRedirects) {
            if (maxRedirects != null && maxRedirects < 0) {
                throw new IllegalArgumentException(
                        "Invalid maxRedirects: must not be negative (got " + maxRedirects + ")");
            }
            this.maxRedirects = maxRedirects;
            return this;
        }

        /**
         * Set a custom User-Agent header value.
         *
         * @param userAgent the user agent string, or {@code null} to omit
         * @return this builder
         */
        public Builder userAgent(@Nullable String userAgent) {
            this.userAgent = userAgent;
            return this;
        }

        /**
         * Add a single transport-level default header.
         *
         * @param name  header name
         * @param value header value
         * @return this builder
         */
        public Builder defaultHeader(String name, String value) {
            this.defaultHeaders.put(name, value);
            return this;
        }

        /**
         * Add multiple transport-level default headers.
         *
         * @param headers map of header names to values
         * @return this builder
         */
        public Builder defaultHeaders(Map<String, String> headers) {
            this.defaultHeaders.putAll(headers);
            return this;
        }

        /**
         * Set how many times a failed request is retried.
         *
         * <p>See {@link TransportOptions#getMaxRetries()} for what is retried.
         *
         * @param maxRetries the retry count (not negative); {@code 0} disables retries
         * @return this builder
         * @throws IllegalArgumentException if {@code maxRetries} is negative
         */
        public Builder maxRetries(int maxRetries) {
            if (maxRetries < 0) {
                throw new IllegalArgumentException(
                        "Invalid maxRetries: must not be negative (got " + maxRetries + ")");
            }
            this.maxRetries = maxRetries;
            return this;
        }

        /**
         * Enable or disable automatic {@code X-Request-ID} header injection.
         *
         * @param injectRequestId {@code true} to inject, {@code false} to skip (default)
         * @return this builder
         */
        public Builder injectRequestId(boolean injectRequestId) {
            this.injectRequestId = injectRequestId;
            return this;
        }

        /**
         * Build and return an immutable {@link TransportOptions} instance.
         *
         * @return the configured transport options
         */
        public TransportOptions build() {
            if (httpClient != null) {
                if (proxy != null || caCertPath != null || !verifySsl) {
                    throw new IllegalArgumentException(
                            "A caller-supplied HttpClient owns its own proxy and TLS settings; "
                                    + "do not combine it with proxy, caCertPath or verifySsl(false)");
                }
                if (httpClient.followRedirects() != java.net.http.HttpClient.Redirect.NEVER) {
                    throw new IllegalArgumentException(
                            "A caller-supplied HttpClient must use Redirect.NEVER; "
                                    + "the SDK follows redirects itself");
                }
            }
            return new TransportOptions(
                    verifySsl,
                    caCertPath,
                    proxy,
                    timeout,
                    followRedirects,
                    maxRedirects,
                    userAgent,
                    new HashMap<>(defaultHeaders),
                    injectRequestId,
                    httpClient,
                    maxRetries,
                    idleTimeout);
        }
    }
}
