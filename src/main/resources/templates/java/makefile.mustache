.PHONY: build test lint format analyze docs examples examples-run clean upgrade checkstyle

build:
	mvn compile -q -B

test:
	mvn test -q -B

lint:
	mvn spotless:check checkstyle:check spotbugs:check -q -B

checkstyle:
	mvn checkstyle:check -q -B

format:
	mvn spotless:apply -q -B

analyze:
	mvn compile spotbugs:check -q -B

upgrade:
	mvn rewrite:run -q -B

docs:
	mvn javadoc:javadoc -q -B -DfailOnWarnings=true -Ddoclint=all -DreportOutputDirectory=.out -DdestDir=docs

# src/examples/java is a test source root, so test-compile builds every file under examples.
examples:
	mvn test-compile -q -B

examples-run: examples
	{{envVarPrefix}}_BASE_URL="$(API_BASE_URL)" {{envVarPrefix}}_ACCESS_TOKEN=placeholder mvn exec:java -q -B

clean:
	mvn clean -q -B
