import Foundation

/// The events of a server-sent events response, parsed as they arrive (WHATWG
/// HTML, "Server-sent events"), with automatic reconnecting.
///
/// It is an `AsyncSequence` of ``ServerSentEvent``: iterate it with
/// `for try await`. ``close()`` is idempotent and aborts the connection, also
/// while a read or a wait before a reconnect is in progress, which then ends;
/// call it (`defer { stream.close() }`) when you stop early. It can be read
/// once, by one task at a time.
///
/// When the connection ends, fails or stays silent for the idle timeout, the
/// stream asks again with a fresh request (headers rebuilt, so a refreshed
/// token is the one sent) that carries the last event id in `Last-Event-ID`. It
/// waits the server's `retry` value, else the `Retry-After` of a 429, 502, 503
/// or 504, else the `reconnectDelay` doubling to 30 seconds with jitter, and
/// gives up after `maxReconnects` consecutive failures without an event by
/// raising the last failure. It never reconnects after a `204`, a status other
/// than 408, 429 and 5xx, a response that is not `text/event-stream`, a
/// cancellation or the closing of the client. An event named `error` raises an
/// ``ApiError`` with the response status and the data as its body.
/// ``description`` shows the status code, the events delivered and the last
/// event id, never the data.
public final class SseStream<T: Sendable>: AsyncSequence, @unchecked Sendable {
    public typealias Element = ServerSentEvent<T>

    /// Sends one request with the given last event id (empty for none) and
    /// returns its open body, or throws the typed error of a failed status.
    typealias Opener = @Sendable (String) async throws -> ByteStream

    private static var maxReconnectDelayMillis: Int { 30_000 }

    private let opener: Opener
    private let decode: (@Sendable (String) throws -> T)?
    private let terminator: String?
    private let maxReconnects: Int
    private let reconnectDelay: Int
    private let maxEventBytes: Int
    private let method: String
    private let path: String

    private let lock = NSLock()
    private var current: ByteStream
    private var parser: SseParser
    private var lastId: String
    private var serverRetry: Int?
    private var consecutive = 0
    private var delivered = 0
    private var closed = false
    private var finished = false
    private var waiter: CheckedContinuation<Void, Never>?
    private var timer: Task<Void, Never>?

    private init(
        opener: @escaping Opener, decode: (@Sendable (String) throws -> T)?, terminator: String?,
        options: StreamOptions?, hasBody: Bool, method: String, path: String, first: ByteStream,
        lastEventId: String
    ) {
        self.opener = opener
        self.decode = decode
        self.terminator = terminator
        self.maxReconnects = options?.maxReconnects ?? (hasBody ? 0 : 5)
        self.reconnectDelay = options?.reconnectDelay ?? 1000
        self.maxEventBytes = options?.maxEventBytes ?? 1_048_576
        self.method = method
        self.path = path
        self.current = first
        self.lastId = lastEventId
        self.parser = SseParser(source: first, maxEventBytes: maxEventBytes, lastEventId: lastEventId)
    }

    /// Opens the first connection of an event stream; a failure of that request
    /// is thrown here.
    ///
    /// - Parameters:
    ///   - opener: Sends one request with the given last event id (empty for none).
    ///   - decode: Decodes the `data` field, or nil to hand it over as a string.
    ///   - terminator: A `data` value that ends the stream and is not delivered.
    ///   - options: The stream settings, or nil for the defaults.
    ///   - hasBody: Whether the request has a body, which turns reconnecting off by default.
    ///   - method: The method of the request, named in errors.
    ///   - path: The path of the request, named in errors.
    static func open(
        opener: @escaping Opener, decode: (@Sendable (String) throws -> T)? = nil,
        terminator: String? = nil, options: StreamOptions? = nil, hasBody: Bool = false,
        method: String, path: String
    ) async throws -> SseStream<T> {
        let lastEventId = options?.lastEventId ?? ""
        let first = try await connect(opener, lastEventId, method, path)
        return SseStream<T>(
            opener: opener, decode: decode, terminator: terminator, options: options,
            hasBody: hasBody, method: method, path: path, first: first, lastEventId: lastEventId)
    }

    /// The HTTP status code of the current connection.
    public var statusCode: Int { lock.withLock { current.statusCode } }

    /// The lower-cased headers of the current connection.
    public var headers: [String: String] { lock.withLock { current.headers } }

    /// The last event id seen, which a reconnect sends; empty when none.
    public var lastEventId: String { lock.withLock { lastId } }

    /// Sends the request and checks that the answer is an event stream.
    private static func connect(
        _ opener: Opener, _ lastEventId: String, _ method: String, _ path: String
    ) async throws -> ByteStream {
        let stream = try await opener(lastEventId)
        if stream.statusCode == 204 {
            return stream
        }
        let type = stream.headers["content-type"] ?? ""
        if !type.lowercased().hasPrefix("text/event-stream") {
            stream.close()
            let bare = (type.split(separator: ";").first.map(String.init) ?? type)
                .trimmingCharacters(in: .whitespaces)
            throw SerializationError(
                message: "Unexpected response Content-Type '\(bare)' for \(path): expected text/event-stream",
                statusCode: stream.statusCode, responseHeaders: stream.headers, responseBody: "",
                requestMethod: method, requestPath: path)
        }
        return stream
    }

    public struct AsyncIterator: AsyncIteratorProtocol {
        fileprivate let owner: SseStream<T>

        public mutating func next() async throws -> ServerSentEvent<T>? {
            return try await owner.nextEvent()
        }
    }

    public func makeAsyncIterator() -> AsyncIterator {
        return AsyncIterator(owner: self)
    }

    private var isClosed: Bool { lock.withLock { closed } }

    private func finish() {
        let (last, wake) = lock.withLock { () -> (ByteStream, CheckedContinuation<Void, Never>?) in
            finished = true
            closed = true
            let pending = waiter
            waiter = nil
            timer?.cancel()
            timer = nil
            return (current, pending)
        }
        wake?.resume()
        last.close()
    }

    fileprivate func nextEvent() async throws -> ServerSentEvent<T>? {
        if lock.withLock({ finished }) {
            return nil
        }
        do {
            if let event = try await advance() {
                return event
            }
            finish()
            return nil
        } catch {
            finish()
            throw error
        }
    }

    private func failure(_ message: String, cause: Error?) -> SerializationError {
        let (status, headers) = lock.withLock { (current.statusCode, current.headers) }
        return SerializationError(
            message: message, cause: cause, statusCode: status, responseHeaders: headers,
            responseBody: "", requestMethod: method, requestPath: path)
    }

    private func advance() async throws -> ServerSentEvent<T>? {
        if lock.withLock({ current.statusCode == 204 }) {
            return nil
        }
        while !isClosed {
            var raw: RawEvent?
            var lost: ApiError?
            let reading = lock.withLock { parser }
            do {
                raw = try await reading.next()
            } catch let tooLong as OverLimit {
                throw failure("An event of the stream is too long: \(tooLong.message)", cause: nil)
            } catch let network as NetworkError {
                lost = network
            }
            lock.withLock {
                lastId = reading.lastEventId
                serverRetry = reading.retry
            }
            if let raw = raw {
                lock.withLock { consecutive = 0 }
                return try deliver(raw)
            }
            if isClosed {
                return nil
            }
            if !(try await reconnect(lost)) {
                return nil
            }
        }
        return nil
    }

    private func deliver(_ raw: RawEvent) throws -> ServerSentEvent<T>? {
        let (status, headers) = lock.withLock { (current.statusCode, current.headers) }
        if raw.event == "error" {
            throw ApiError(
                statusCode: status, message: "The server sent an error event", responseBody: raw.data,
                responseHeaders: headers, requestMethod: method, requestPath: path)
        }
        if let end = terminator, end == raw.data {
            return nil
        }
        let value: T
        if let decode = decode {
            do {
                value = try decode(raw.data)
            } catch let broken as SerializationError {
                throw failure("The data of an event does not decode: \(broken.message)", cause: broken)
            } catch {
                throw failure(
                    "The data of an event does not decode: \(error.localizedDescription)", cause: error)
            }
        } else if let text = raw.data as? T {
            value = text
        } else {
            throw failure("An event without a decoder needs a String payload", cause: nil)
        }
        lock.withLock { delivered += 1 }
        return ServerSentEvent<T>(
            id: raw.id, event: raw.event, data: value, retry: raw.retry, raw: raw.data)
    }

    /// Re-establishes the connection after it was lost. `failure` is why it
    /// was lost, or nil when it ended cleanly. Returns true when a new
    /// connection is open and false when the stream ends.
    private func reconnect(_ failure: ApiError?) async throws -> Bool {
        var cause = failure
        while true {
            lock.withLock { current }.close()
            if maxReconnects == 0 {
                if let cause = cause {
                    throw cause
                }
                return false
            }
            let attempt = lock.withLock { consecutive }
            if maxReconnects > 0 && attempt >= maxReconnects {
                if let cause = cause {
                    throw cause
                }
                throw StreamError(
                    statusCode: 0,
                    message: "The event stream ended and was not re-established after \(maxReconnects) reconnects",
                    requestMethod: method, requestPath: path)
            }
            let (number, retry, id) = lock.withLock { () -> (Int, Int?, String) in
                consecutive += 1
                return (consecutive, serverRetry, lastId)
            }
            await pause(
                SseStream.reconnectWaitMillis(
                    attempt: number, base: reconnectDelay, serverRetry: retry,
                    retryAfter: SseStream.retryAfterMillis(of: cause),
                    jitter: Double.random(in: 0..<1)))
            try Task.checkCancellation()
            if isClosed {
                return false
            }
            do {
                let next = try await SseStream.connect(opener, id, method, path)
                let replaced: Bool = lock.withLock {
                    if closed { return false }
                    current = next
                    parser = SseParser(source: next, maxEventBytes: maxEventBytes, lastEventId: id)
                    return true
                }
                if !replaced {
                    next.close()
                    return false
                }
                return next.statusCode != 204
            } catch let network as NetworkError {
                cause = network
            } catch let status as ApiError
                where status.statusCode == 408 || status.statusCode == 429
                || (500...599).contains(status.statusCode)
            {
                cause = status
            }
        }
    }

    private static func retryAfterMillis(of failure: ApiError?) -> Int? {
        guard let failure = failure, !(failure is NetworkError),
            [429, 502, 503, 504].contains(failure.statusCode),
            let headers = failure.responseHeaders,
            let value = headers.first(where: { $0.key.caseInsensitiveCompare("retry-after") == .orderedSame })?.value
        else {
            return nil
        }
        return DefaultApiClient.parseRetryAfter(value).map { Int($0 * 1000) }
    }

    /// How long to wait before reconnect number `attempt` (1 for the first),
    /// in milliseconds: the server's `retry` value, else `Retry-After`, else
    /// `base` doubling to 30 seconds, reduced by up to 25% of jitter.
    ///
    /// - Parameter jitter: A uniform random value in [0, 1).
    static func reconnectWaitMillis(
        attempt: Int, base: Int, serverRetry: Int?, retryAfter: Int?, jitter: Double
    ) -> Int {
        if let serverRetry = serverRetry {
            return serverRetry
        }
        if let retryAfter = retryAfter {
            return retryAfter
        }
        let doubled = Swift.min(maxReconnectDelayMillis, base << Swift.min(Swift.max(attempt - 1, 0), 20))
        return Int(Double(doubled) * (1.0 - 0.25 * jitter))
    }

    /// Waits `millis`; closing the stream or cancelling the task ends the wait.
    private func pause(_ millis: Int) async {
        if millis <= 0 || isClosed {
            return
        }
        await withTaskCancellationHandler {
            await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
                let immediate: Bool = lock.withLock {
                    if closed || Task.isCancelled { return true }
                    waiter = continuation
                    timer = Task { [weak self] in
                        try? await Task.sleep(nanoseconds: UInt64(millis) * 1_000_000)
                        self?.wake()
                    }
                    return false
                }
                if immediate {
                    continuation.resume()
                }
            }
        } onCancel: {
            self.wake()
        }
    }

    private func wake() {
        let pending: CheckedContinuation<Void, Never>? = lock.withLock {
            let held = waiter
            waiter = nil
            timer?.cancel()
            timer = nil
            return held
        }
        pending?.resume()
    }

    /// Closes the stream and aborts the connection; later calls do nothing. A
    /// read or a wait that is in progress ends.
    public func close() {
        finish()
    }
}

extension SseStream: CustomStringConvertible, CustomDebugStringConvertible {
    /// The stream by its status code, the events delivered and the last event
    /// id; the headers and the data are never shown.
    public var description: String {
        let (status, count, id) = lock.withLock { (current.statusCode, delivered, lastId) }
        return "SseStream(statusCode: \(status), eventsDelivered: \(count), lastEventId: \(id))"
    }

    /// The same text as ``description``.
    public var debugDescription: String {
        description
    }
}
