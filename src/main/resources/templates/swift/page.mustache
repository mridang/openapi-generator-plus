{{>api_info}}
import Foundation

/// One page of a paged list: the items it holds, the cursor of the page after
/// it, and the result of the request that returned it.
///
/// `C` is the type of the cursor request parameter, and `Void` for a list that
/// is followed by its `Link` header.
public struct Page<T: Sendable, C: Sendable>: Sendable, CustomStringConvertible, CustomDebugStringConvertible {
    /// The items of this page, in order.
    public let items: [T]

    /// The cursor of the next page, or nil on the last page; always nil for a
    /// list that is followed by its `Link` header.
    public let nextCursor: C?

    /// What the matching `WithHTTPInfo` method returns for this page: the
    /// status, the headers, the raw body and the decoded body (in `data`).
    public let result: ApiResult<any Sendable>

    /// Creates a page.
    public init(items: [T], nextCursor: C?, result: ApiResult<any Sendable>) {
        self.items = items
        self.nextCursor = nextCursor
        self.result = result
    }

    /// Shows the number of items and the status code, never the items, the
    /// cursor or the headers.
    public var description: String {
        return "Page(items: \(items.count), statusCode: \(result.statusCode))"
    }

    public var debugDescription: String {
        description
    }
}
