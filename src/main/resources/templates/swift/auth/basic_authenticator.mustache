import Foundation

/// Authenticator for HTTP Basic authentication.
public class BasicAuthenticator: BaseAuthenticator, @unchecked Sendable {
    private let _host: String
    private let username: String
    private let password: String

    /// Creates an HTTP Basic authenticator.
    ///
    /// Credentials are validated eagerly at construction, so a malformed
    /// credential is reported where it is supplied rather than lazily at
    /// first request.
    ///
    /// - Parameters:
    ///   - host: The base URL of the API.
    ///   - username: The Basic auth user-id.
    ///   - password: The Basic auth password.
    /// - Throws: ``ConfigurationError/invalidArgument(_:)`` when the
    ///   credentials would corrupt the Authorization header.
    public init(host: String, username: String, password: String) throws {
        /* RFC 7617 §2 — user-id MUST NOT contain ':' (it is the field
         * separator) and neither user-id nor password may carry CR/LF/NUL
         * (header-injection / smuggling vectors common when credentials
         * are read from .env files or interactive prompts).
         * A malformed credential is a caller mistake, matching the Bearer
         * authenticator's pattern. */
        for s in username.unicodeScalars {
            if s.value == 0x0D || s.value == 0x0A || s.value == 0x00 {
                throw ConfigurationError.invalidArgument(
                    "Basic auth username must not contain CR, LF, or NUL characters"
                )
            }
            if s.value == 0x3A {
                throw ConfigurationError.invalidArgument(
                    "Basic auth username must not contain ':' (RFC 7617 §2)"
                )
            }
        }
        for s in password.unicodeScalars {
            if s.value == 0x0D || s.value == 0x0A || s.value == 0x00 {
                throw ConfigurationError.invalidArgument(
                    "Basic auth password must not contain CR, LF, or NUL characters"
                )
            }
        }
        self._host = host
        self.username = username
        self.password = password
        super.init()
    }

    /// Returns the base URL of the API.
    override public func host() -> String {
        return _host
    }

    /// Returns the authentication headers to include in every request.
    override public func authHeaders() async -> [String: String] {
        let credentials = "\(username):\(password)"
        let encoded = Data(credentials.utf8).base64EncodedString()
        return ["Authorization": "Basic \(encoded)"]
    }
}

extension BasicAuthenticator: CustomStringConvertible, CustomDebugStringConvertible {
    /// A string representation that redacts the password so credentials never
    /// leak into logs or stack traces (matching the other SDKs).
    public var description: String {
        "\(type(of: self))(host: \(_host), username: \(username), password: ***)"
    }

    /// A debug string representation that redacts the password so credentials
    /// never leak into logs or stack traces (matching the other SDKs).
    public var debugDescription: String {
        description
    }
}
