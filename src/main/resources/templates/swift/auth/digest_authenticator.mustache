import Foundation

/// Authenticator for HTTP Digest authentication (RFC 7616).
///
/// It sends nothing until the server answers 401 with a
/// `WWW-Authenticate: Digest` challenge; the SDK then answers the challenge and
/// replays the request once. Later requests answer the remembered challenge up
/// front, with the nonce count incremented.
public class DigestAuthenticator: BaseAuthenticator, ChallengeAuthenticating, @unchecked Sendable {
    /// The part of a server's Digest challenge an answer needs.
    private struct Challenge {
        let realm: String
        let nonce: String
        let opaque: String?
        let algorithm: String?
        let qop: Bool
    }

    /// What one answer needs: the challenge, the nonce count as 8 hex digits
    /// and the client nonce a test fixed, if any.
    private struct Turn {
        let challenge: Challenge
        let nc: String
        let cnonce: String?
    }

    private let _host: String
    private let username: String
    private let password: String
    private let lock = NSLock()
    private var challenge: Challenge?
    private var nonceCount: UInt32 = 0
    private var fixedCnonce: String?

    /// Creates an HTTP Digest authenticator.
    ///
    /// - Parameters:
    ///   - host: The base URL of the API.
    ///   - username: The Digest user name.
    ///   - password: The Digest password.
    /// - Throws: ``ConfigurationError/invalidArgument(_:)`` when the username
    ///   is empty, either field carries CR, LF or NUL, or the username carries
    ///   a double quote: each would corrupt the Authorization header.
    public init(host: String, username: String, password: String) throws {
        if username.isEmpty {
            throw ConfigurationError.invalidArgument("Digest username must not be empty")
        }
        let forbidden: Set<Unicode.Scalar> = ["\r", "\n", "\0"]
        if username.unicodeScalars.contains(where: forbidden.contains)
            || password.unicodeScalars.contains(where: forbidden.contains)
        {
            throw ConfigurationError.invalidArgument("Digest credentials must not contain a line break or NUL")
        }
        if username.contains("\"") {
            throw ConfigurationError.invalidArgument("Digest username must not contain a double quote")
        }
        self._host = host
        self.username = username
        self.password = password
        super.init()
    }

    /// Returns the base URL of the API.
    override public func host() -> String {
        return _host
    }

    /// Returns no headers: a Digest answer needs the method and the request
    /// target, so the SDK asks for it separately.
    override public func authHeaders() async -> [String: String] {
        return [:]
    }

    /// Answers every challenge with `cnonce` instead of a random client nonce,
    /// so a test can compare an answer with a published vector.
    func fixCnonce(_ cnonce: String) {
        lock.withLock { fixedCnonce = cnonce }
    }

    func authorization(method: String, requestTarget: String) -> String? {
        let turn: Turn? = lock.withLock {
            guard let current = self.challenge else { return nil }
            nonceCount += 1
            let hex = String(nonceCount, radix: 16)
            let nc = String(repeating: "0", count: 8 - hex.count) + hex
            return Turn(challenge: current, nc: nc, cnonce: fixedCnonce)
        }
        guard let turn = turn else { return nil }
        let challenge = turn.challenge
        let nc = turn.nc
        let cnonce = turn.cnonce ?? Self.randomCnonce()
        let upper = (challenge.algorithm ?? "MD5").uppercased()
        let sha256 = upper.hasPrefix("SHA-256")
        let digest = { (text: String) -> String in
            DigestHash.hex(sha256 ? DigestHash.sha256(Array(text.utf8)) : DigestHash.md5(Array(text.utf8)))
        }
        var ha1 = digest("\(username):\(challenge.realm):\(password)")
        if upper.hasSuffix("-SESS") {
            ha1 = digest("\(ha1):\(challenge.nonce):\(cnonce)")
        }
        let ha2 = digest("\(method):\(requestTarget)")
        let response =
            challenge.qop
            ? digest("\(ha1):\(challenge.nonce):\(nc):\(cnonce):auth:\(ha2)")
            : digest("\(ha1):\(challenge.nonce):\(ha2)")
        var header =
            "Digest username=\"\(Self.quote(username))\", realm=\"\(Self.quote(challenge.realm))\""
            + ", nonce=\"\(Self.quote(challenge.nonce))\", uri=\"\(Self.quote(requestTarget))\""
        if let algorithm = challenge.algorithm {
            header += ", algorithm=\(algorithm)"
        }
        header += ", response=\"\(response)\""
        if challenge.qop {
            header += ", qop=auth, nc=\(nc), cnonce=\"\(Self.quote(cnonce))\""
        }
        if let opaque = challenge.opaque {
            header += ", opaque=\"\(Self.quote(opaque))\""
        }
        return header
    }

    func acceptChallenge(_ wwwAuthenticate: String) -> Bool {
        for params in DigestChallengeParser.parse(wwwAuthenticate) {
            let algorithm = params["algorithm"]
            if let algorithm = algorithm,
                !["MD5", "MD5-SESS", "SHA-256", "SHA-256-SESS"].contains(algorithm.uppercased())
            {
                continue
            }
            let qop = params["qop"]
            if let qop = qop,
                !qop.split(separator: ",").contains(where: {
                    $0.trimmingCharacters(in: .whitespaces).lowercased() == "auth"
                })
            {
                continue
            }
            let accepted = Challenge(
                realm: params["realm"] ?? "", nonce: params["nonce"] ?? "", opaque: params["opaque"],
                algorithm: algorithm, qop: qop != nil)
            lock.withLock {
                challenge = accepted
                nonceCount = 0
            }
            return true
        }
        return false
    }

    /// 16 random bytes as 32 lower-case hex digits.
    private static func randomCnonce() -> String {
        var generator = SystemRandomNumberGenerator()
        return DigestHash.hex((0..<16).map { _ in UInt8.random(in: 0...255, using: &generator) })
    }

    /// Escapes a backslash and a double quote for a quoted field.
    private static func quote(_ value: String) -> String {
        return value.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\"")
    }
}

/// Reads the Digest challenges of a `WWW-Authenticate` value.
enum DigestChallengeParser {
    /// The parameters of every Digest challenge in `value`, keyed by lower-case
    /// name, in order. The value may hold several challenges of several
    /// schemes; a parameter is `name=token` or `name="quoted string"` with
    /// backslash escapes.
    static func parse(_ value: String) -> [[String: String]] {
        var cursor = Cursor(chars: Array(value))
        var challenges: [[String: String]] = []
        var inDigest = false
        while cursor.skip({ $0 == " " || $0 == "\t" || $0 == "," }) {
            let token = cursor.read(until: { $0 == " " || $0 == "\t" || $0 == "," || $0 == "=" })
            if cursor.consumeEquals() {
                let param = cursor.readValue()
                if inDigest && !challenges.isEmpty {
                    challenges[challenges.count - 1][token.lowercased()] = param
                }
                continue
            }
            inDigest = token.lowercased() == "digest"
            if inDigest {
                challenges.append([:])
            }
        }
        return challenges
    }

    /// A position in the characters of a header value.
    private struct Cursor {
        let chars: [Character]
        var index = 0

        /// Skips the characters that match and returns whether any are left.
        mutating func skip(_ matches: (Character) -> Bool) -> Bool {
            while index < chars.count && matches(chars[index]) {
                index += 1
            }
            return index < chars.count
        }

        /// Reads up to the first character that matches.
        mutating func read(until stop: (Character) -> Bool) -> String {
            let start = index
            while index < chars.count && !stop(chars[index]) {
                index += 1
            }
            return String(chars[start..<index])
        }

        /// Consumes an `=` after optional blanks; leaves the position alone when
        /// there is none.
        mutating func consumeEquals() -> Bool {
            var next = index
            while next < chars.count && (chars[next] == " " || chars[next] == "\t") {
                next += 1
            }
            guard next < chars.count && chars[next] == "=" else { return false }
            index = next + 1
            _ = skip({ $0 == " " || $0 == "\t" })
            return true
        }

        /// Reads a token, or a quoted string with its backslash escapes removed.
        mutating func readValue() -> String {
            guard index < chars.count && chars[index] == "\"" else {
                return read(until: { $0 == " " || $0 == "\t" || $0 == "," })
            }
            index += 1
            var value = ""
            while index < chars.count && chars[index] != "\"" {
                if chars[index] == "\\" && index + 1 < chars.count {
                    index += 1
                }
                value.append(chars[index])
                index += 1
            }
            index += 1
            return value
        }
    }
}

/// MD5 (RFC 1321) and SHA-256 (FIPS 180-4) for Digest answers; CryptoKit is not
/// available on every platform.
enum DigestHash {
    private static let md5Shifts: [UInt32] = [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ]

    private static let md5Constants: [UInt32] = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ]

    private static let sha256Constants: [UInt32] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]

    /// Lower-case hex digits of the bytes.
    static func hex(_ bytes: [UInt8]) -> String {
        return bytes.map { byte in
            let digits = String(byte, radix: 16)
            return digits.count == 1 ? "0" + digits : digits
        }.joined()
    }

    /// The message padded to whole 64-byte blocks and cut into 32-bit words, the
    /// length and the words in big-endian order for SHA-256 and in
    /// little-endian order for MD5.
    private static func words(_ message: [UInt8], bigEndian: Bool) -> [UInt32] {
        var data = message
        let bitLength = UInt64(message.count) * 8
        data.append(0x80)
        while data.count % 64 != 56 {
            data.append(0)
        }
        let lengthShifts: [UInt64] = bigEndian ? [56, 48, 40, 32, 24, 16, 8, 0] : [0, 8, 16, 24, 32, 40, 48, 56]
        data += lengthShifts.map { UInt8((bitLength >> $0) & 0xff) }
        let byteShifts: [UInt32] = bigEndian ? [24, 16, 8, 0] : [0, 8, 16, 24]
        return stride(from: 0, to: data.count, by: 4).map { offset in
            (0..<4).reduce(UInt32(0)) { word, index in
                word | UInt32(data[offset + index]) << byteShifts[index]
            }
        }
    }

    /// The words of a 32-bit state as bytes, big- or little-endian.
    private static func bytes(_ state: [UInt32], bigEndian: Bool) -> [UInt8] {
        let shifts: [UInt32] = bigEndian ? [24, 16, 8, 0] : [0, 8, 16, 24]
        return state.flatMap { word in shifts.map { UInt8((word >> $0) & 0xff) } }
    }

    /// The MD5 mixing function and message word of round `index`.
    private static func md5Round(_ index: Int, _ b: UInt32, _ c: UInt32, _ d: UInt32) -> (UInt32, Int) {
        switch index {
        case 0..<16:
            return ((b & c) | (~b & d), index)
        case 16..<32:
            return ((d & b) | (~d & c), (5 * index + 1) % 16)
        case 32..<48:
            return (b ^ c ^ d, (3 * index + 5) % 16)
        default:
            return (c ^ (b | ~d), (7 * index) % 16)
        }
    }

    /// MD5 (RFC 1321).
    static func md5(_ message: [UInt8]) -> [UInt8] {
        let blocks = words(message, bigEndian: false)
        var state: [UInt32] = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
        for block in stride(from: 0, to: blocks.count, by: 16) {
            var a = state[0]
            var b = state[1]
            var c = state[2]
            var d = state[3]
            for index in 0..<64 {
                let (mixed, word) = md5Round(index, b, c, d)
                let sum = mixed &+ a &+ md5Constants[index] &+ blocks[block + word]
                a = d
                d = c
                c = b
                b = b &+ ((sum << md5Shifts[index]) | (sum >> (32 - md5Shifts[index])))
            }
            state[0] = state[0] &+ a
            state[1] = state[1] &+ b
            state[2] = state[2] &+ c
            state[3] = state[3] &+ d
        }
        return bytes(state, bigEndian: false)
    }

    /// SHA-256 (FIPS 180-4).
    static func sha256(_ message: [UInt8]) -> [UInt8] {
        let blocks = words(message, bigEndian: true)
        var state: [UInt32] = [
            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
        ]
        func rotr(_ x: UInt32, _ n: UInt32) -> UInt32 { return (x >> n) | (x << (32 - n)) }
        for block in stride(from: 0, to: blocks.count, by: 16) {
            var w = Array(blocks[block..<block + 16]) + [UInt32](repeating: 0, count: 48)
            for i in 16..<64 {
                let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
                let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
                w[i] = w[i - 16] &+ s0 &+ w[i - 7] &+ s1
            }
            var v = state
            for i in 0..<64 {
                let s1 = rotr(v[4], 6) ^ rotr(v[4], 11) ^ rotr(v[4], 25)
                let ch = (v[4] & v[5]) ^ (~v[4] & v[6])
                let t1 = v[7] &+ s1 &+ ch &+ sha256Constants[i] &+ w[i]
                let s0 = rotr(v[0], 2) ^ rotr(v[0], 13) ^ rotr(v[0], 22)
                let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2])
                v = [t1 &+ s0 &+ maj, v[0], v[1], v[2], v[3] &+ t1, v[4], v[5], v[6]]
            }
            state = zip(state, v).map { $0 &+ $1 }
        }
        return bytes(state, bigEndian: true)
    }
}
extension DigestAuthenticator: CustomStringConvertible, CustomDebugStringConvertible {
    /// A string representation that redacts the password so credentials never
    /// leak into logs or stack traces (matching the other SDKs).
    public var description: String {
        "\(type(of: self))(host: \(_host), username: \(username), password: ***)"
    }

    /// A debug string representation that redacts the password so credentials
    /// never leak into logs or stack traces (matching the other SDKs).
    public var debugDescription: String {
        description
    }
}
