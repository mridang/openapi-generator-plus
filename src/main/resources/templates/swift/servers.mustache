{{>api_info}}
import Foundation

/// Generated server configurations from the OpenAPI specification.
///
/// Each constant corresponds to a server entry defined in the spec's
/// `servers` array. Use these constants with
/// ``ConfigurationBuilder/server(_:variables:)`` to select a server:
///
/// ```swift
/// let config = try Configuration.builder()
///     .server(Servers.server0)
///     .build()
/// ```
///
/// For servers with variables, pass overrides:
///
/// ```swift
/// let url = try Servers.server1.url(variables: ["environment": "staging"])
/// ```
public enum Servers {
{{#serverConfigs}}
    /// Server {{serverIndex}}: `{{serverUrl}}`{{#serverDescription}}
    ///
    /// {{#lambda.singleLine}}{{{serverDescription}}}{{/lambda.singleLine}}{{/serverDescription}}
    public static let server{{serverIndex}} = ServerConfiguration(
        urlTemplate: {{#lambda.quotedLiteral}}{{{serverUrl}}}{{/lambda.quotedLiteral}},
        description: {{#lambda.quotedLiteral}}{{#serverDescription}}{{{serverDescription}}}{{/serverDescription}}{{/lambda.quotedLiteral}},
        variables: {{#hasVariables}}[
{{#serverVariables}}            "{{{varName}}}": ServerVariable(
                defaultValue: {{#lambda.quotedLiteral}}{{{varDefault}}}{{/lambda.quotedLiteral}},
                description: {{#lambda.quotedLiteral}}{{#varDescription}}{{{varDescription}}}{{/varDescription}}{{/lambda.quotedLiteral}},
                enumValues: {{#hasEnumValues}}[{{#varEnumValues}}{{#lambda.quotedLiteral}}{{{.}}}{{/lambda.quotedLiteral}}{{^-last}}, {{/-last}}{{/varEnumValues}}]{{/hasEnumValues}}{{^hasEnumValues}}[]{{/hasEnumValues}}
            ){{^-last}},{{/-last}}
{{/serverVariables}}        ]{{/hasVariables}}{{^hasVariables}}[:]{{/hasVariables}},
        name: {{#lambda.quotedLiteral}}{{#serverName}}{{{serverName}}}{{/serverName}}{{/lambda.quotedLiteral}}
    )

{{/serverConfigs}}
    /// All server configurations in declaration order.
    public static let all: [ServerConfiguration] = [
{{#serverConfigs}}        server{{serverIndex}}{{^-last}},{{/-last}}
{{/serverConfigs}}    ]

    /// The server the specification gives the name `name` (OpenAPI 3.2 `name`).
    ///
    /// - Parameter name: The server name.
    /// - Returns: The server with that name.
    /// - Throws: ``ConfigurationError/invalidArgument(_:)`` if no server has that
    ///   name; the message lists the known names.
    public static func byName(_ name: String) throws -> ServerConfiguration {
        if let server = all.first(where: { !$0.name.isEmpty && $0.name == name }) {
            return server
        }
        let known = all.map(\.name).filter { !$0.isEmpty }
        throw ConfigurationError.invalidArgument(
            "Unknown server name '\(name)'. Known names: [\(known.joined(separator: ", "))]")
    }
}
