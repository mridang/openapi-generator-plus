import Foundation

/// Settings of one JSON Lines or server-sent events call, passed last to its
/// `...Stream` method. A setting left `nil` keeps its default. They live here
/// and not in the per-call options, which carry only `timeout`, `maxRetries`
/// and `headers`.
public struct StreamOptions: Sendable, Equatable {
    /// The longest the body may stay silent, in milliseconds, for this call; 0
    /// disables it. The default is the transport's `idleTimeout`.
    public let idleTimeout: Int?

    /// How many times a lost server-sent events connection is re-established
    /// without an event in between; -1 is unlimited and 0 turns reconnecting
    /// off. The default is 5 for a request without a body and 0 for a request
    /// that has a body.
    public let maxReconnects: Int?

    /// The first wait before a reconnect, in milliseconds; it doubles up to 30
    /// seconds and is reduced by up to 25% of jitter. A `retry` value from the
    /// server replaces it. The default is 1000.
    public let reconnectDelay: Int?

    /// The event id the first request resumes from, sent as `Last-Event-ID`.
    public let lastEventId: String?

    /// The longest a JSON Lines line or an event may be, in bytes. The default
    /// is 1 MiB.
    public let maxEventBytes: Int?

    /// Creates options that keep every default that is not named.
    public init(
        idleTimeout: Int? = nil, maxReconnects: Int? = nil, reconnectDelay: Int? = nil,
        lastEventId: String? = nil, maxEventBytes: Int? = nil
    ) {
        self.idleTimeout = idleTimeout
        self.maxReconnects = maxReconnects
        self.reconnectDelay = reconnectDelay
        self.lastEventId = lastEventId
        self.maxEventBytes = maxEventBytes
    }
}

extension StreamOptions: CustomStringConvertible, CustomDebugStringConvertible {
    /// The settings by name; the last event id is left out.
    public var description: String {
        return "StreamOptions(idleTimeout: \(idleTimeout.map(String.init) ?? "nil"), "
            + "maxReconnects: \(maxReconnects.map(String.init) ?? "nil"), "
            + "reconnectDelay: \(reconnectDelay.map(String.init) ?? "nil"), "
            + "maxEventBytes: \(maxEventBytes.map(String.init) ?? "nil"))"
    }

    /// The same text as ``description``.
    public var debugDescription: String {
        description
    }
}
