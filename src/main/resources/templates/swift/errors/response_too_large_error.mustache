import Foundation

/// Error for a buffered response whose body passed
/// ``TransportOptions/maxResponseBytes``, counted as received or once
/// decompressed. The response arrived, so the status code and the lower-cased
/// headers are the real ones; the body is empty because the client stopped
/// reading it and dropped the connection. It is never retried.
public class ResponseTooLargeError: ApiError, @unchecked Sendable {
    /// The limit, in bytes, that the body passed.
    public let limit: Int

    /// Creates the error for a response of `statusCode` whose body passed `limit` bytes.
    public init(
        statusCode: Int,
        limit: Int,
        responseHeaders: [String: String]? = nil,
        requestMethod: String? = nil,
        requestPath: String? = nil
    ) {
        self.limit = limit
        super.init(
            statusCode: statusCode,
            message: "Response body exceeds the limit of \(limit) bytes",
            responseBody: "",
            responseHeaders: responseHeaders,
            requestMethod: requestMethod,
            requestPath: requestPath
        )
    }

    /// Always false: the same request would return the same body again.
    public override var isRetryable: Bool {
        return false
    }
}
