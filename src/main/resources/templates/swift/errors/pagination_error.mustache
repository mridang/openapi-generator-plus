{{>api_info}}
import Foundation

/// Raised when a paged list cannot be followed safely: the server returned the
/// cursor that was just sent, so asking again would loop forever, or a `Link`
/// header pointed to another origin, so following it would send the
/// credentials there. It is not a network error and not an API error: it is a
/// direct child of ``{{errorPrefix}}Error``, and the items already delivered are
/// complete and correct. A failed page request raises the SDK error of that
/// failure instead.
public struct PaginationError: {{errorPrefix}}Error, LocalizedError {
    /// The detail message. It says what made the list impossible to follow and
    /// never holds a query string.
    public let message: String

    /// The path of the request whose response could not be followed, without
    /// its query, or nil when it is not known.
    public let requestPath: String?

    /// Creates an error.
    public init(message: String, requestPath: String? = nil) {
        self.message = message
        self.requestPath = requestPath
    }

    public var errorDescription: String? {
        return message
    }
}
