import Foundation

/// Error for a response body that failed after its headers arrived: the
/// connection was reset, or the body ended before its declared length. It is a
/// ``NetworkError``, so the status code is always 0: the headers had arrived,
/// but the body the caller was promised did not. The underlying transport
/// error is kept as ``ApiError/underlyingError``. An idle stall is a
/// ``NetworkTimeoutError`` and a body that cannot be decoded is a
/// ``SerializationError``, not this.
public class StreamError: NetworkError, @unchecked Sendable {}
