import Foundation

/// Reads the `Link` header of RFC 8288. A value is a comma separated list of
/// links, each an angle-bracketed URI reference followed by `;` parameters
/// whose values are tokens or quoted strings. Commas and semicolons inside the
/// brackets or inside a quoted string do not split anything.
enum LinkHeader {
    /// One link: its URI reference as written and its relation types, lower-cased.
    struct Link: Equatable {
        let target: String
        let relations: [String]
    }

    /// Returns the URI reference of the first link whose relation type is
    /// `next`, exactly as written, or nil when there is no `next` link.
    ///
    /// - Parameter header: The header value, repeated headers joined with a comma.
    static func next(_ header: String?) -> String? {
        guard let header = header else { return nil }
        return parse(header).first { $0.relations.contains("next") }?.target
    }

    /// Parses a header value into its links. A link that is malformed is
    /// skipped, and the parse goes on with the next comma that is outside
    /// brackets and quotes.
    static func parse(_ header: String) -> [Link] {
        let s = Array(header)
        let n = s.count
        var links: [Link] = []
        var i = 0
        func blank(_ at: Int) -> Bool { s[at] == " " || s[at] == "\t" }
        while i < n {
            while i < n && (blank(i) || s[i] == ",") { i += 1 }
            if i >= n { break }
            if s[i] != "<" {
                i = skipToComma(s, i)
                continue
            }
            guard let close = s[(i + 1)...].firstIndex(of: ">") else { break }
            let target = String(s[(i + 1)..<close])
            i = close + 1
            var relations: [String] = []
            while i < n {
                while i < n && blank(i) { i += 1 }
                if i >= n || s[i] == "," { break }
                if s[i] != ";" {
                    i = skipToComma(s, i)
                    break
                }
                i += 1
                while i < n && blank(i) { i += 1 }
                let nameStart = i
                while i < n && !"=;, \t".contains(s[i]) { i += 1 }
                let name = String(s[nameStart..<i]).lowercased()
                var value = ""
                if i < n && s[i] == "=" {
                    i += 1
                    if i < n && s[i] == "\"" {
                        i += 1
                        while i < n && s[i] != "\"" {
                            if s[i] == "\\" && i + 1 < n { i += 1 }
                            value.append(s[i])
                            i += 1
                        }
                        i += 1
                    } else {
                        while i < n && !";, \t".contains(s[i]) {
                            value.append(s[i])
                            i += 1
                        }
                    }
                }
                if name == "rel" && relations.isEmpty {
                    relations = value.split(whereSeparator: { $0 == " " || $0 == "\t" })
                        .map { $0.lowercased() }
                }
            }
            links.append(Link(target: target, relations: relations))
        }
        return links
    }

    /// Skips to the next comma that is outside brackets and quotes, and returns
    /// its index or the end.
    private static func skipToComma(_ s: [Character], _ from: Int) -> Int {
        var quoted = false
        var bracketed = false
        var i = from
        while i < s.count {
            let c = s[i]
            if quoted {
                if c == "\\" {
                    i += 1
                } else if c == "\"" {
                    quoted = false
                }
            } else if c == "\"" {
                quoted = true
            } else if c == "<" {
                bracketed = true
            } else if c == ">" {
                bracketed = false
            } else if c == "," && !bracketed {
                return i
            }
            i += 1
        }
        return s.count
    }
}
