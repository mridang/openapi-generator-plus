import Foundation

/// Parses a protobuf-JSON duration literal into a `Duration`.
///
/// Accepts the `google.protobuf.Duration` JSON grammar
/// `-?\d+(\.\d{1,9})?s`, i.e. a decimal second count suffixed with
/// `s` and an optional fractional part of up to nine digits
/// (nanoseconds). Examples: `3600s`, `1.5s`, `3600.000000001s`,
/// `-1.500s`. The fractional part is right-padded to nine digits to
/// recover nanoseconds; digits finer than a nanosecond are cut off toward zero, never rounded or refused, and the sign is applied to the whole value.
///
/// Throws ``SerializationError`` for malformed input.
public func parseProtobufDuration(_ input: String) throws -> Duration {
    let pattern = "^-?[0-9]+(\\.[0-9]+)?s$"
    guard input.range(of: pattern, options: .regularExpression) != nil else {
        throw SerializationError(message: "invalid protobuf duration: \(input)")
    }
    var body = Substring(input.dropLast())
    let negative = body.first == "-"
    if negative {
        body = body.dropFirst()
    }

    let secsStr: Substring
    var nanos: Int64 = 0
    if let dot = body.firstIndex(of: ".") {
        secsStr = body[body.startIndex..<dot]
        let fracStr = String(body[body.index(after: dot)...])
        let padded = (fracStr + "000000000").prefix(9)
        nanos = Int64(padded) ?? 0
    } else {
        secsStr = body
    }

    /* The protobuf-JSON range is +-315 576 000 000 seconds, bound included. */
    guard let secs = Int64(secsStr), secs < 315_576_000_000 || (secs == 315_576_000_000 && nanos == 0) else {
        throw SerializationError(message: "protobuf duration out of range: \(input)")
    }
    let total = Duration.seconds(secs) + Duration.nanoseconds(nanos)
    return negative ? .zero - total : total
}

/// Formats a `Duration` as a canonical protobuf-JSON duration literal.
///
/// Follows the `google.protobuf.Duration` JSON mapping: a decimal
/// second count suffixed with `s`. Fractional seconds, when present,
/// are emitted with 3, 6, or 9 digits — the smallest of those that
/// preserves every non-zero nanosecond digit (e.g. `3600s`,
/// `1.500s`, `3600.000000001s`). A part finer than a nanosecond is cut
/// off toward zero. Negative durations get a leading `-`. The value is
/// decomposed into whole seconds and an absolute nanosecond remainder so
/// the sign stays coherent.
///
/// Throws ``SerializationError`` when the duration is outside the
/// protobuf-JSON range of plus or minus 315 576 000 000 seconds.
public func formatProtobufDuration(_ duration: Duration) throws -> String {
    /* Checked before taking the components: the whole seconds of a larger
       magnitude may not fit in an Int64. */
    let bound = Duration.seconds(315_576_000_000)
    guard duration <= bound && duration >= .zero - bound else {
        throw SerializationError(message: "cannot encode \(duration) as a protobuf duration: out of range")
    }
    let negative = duration < .zero
    let sign = negative ? "-" : ""
    let magnitude = negative ? .zero - duration : duration
    let (wholeSecs, attoseconds) = magnitude.components
    let nanos = attoseconds / 1_000_000_000
    if nanos == 0 {
        return "\(sign)\(wholeSecs)s"
    }
    var frac = String(format: "%09lld", nanos)
    var len = 9
    while len > 3 && frac[frac.index(frac.startIndex, offsetBy: len - 1)] == "0" {
        len -= 1
    }
    if len <= 3 {
        len = 3
    } else if len <= 6 {
        len = 6
    } else {
        len = 9
    }
    frac = String(frac.prefix(len))
    return "\(sign)\(wholeSecs).\(frac)s"
}
