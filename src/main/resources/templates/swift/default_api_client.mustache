import Foundation
#if canImport(CoreFoundation)
import CoreFoundation
#endif
#if canImport(Security)
import Security
#endif
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif
/* Apple platforms ship an importable `zlib` module in the SDK, so the gzip
   guard below can gunzip a body that still carries the gzip magic bytes with
   no extra Package.swift dependency. Linux Swift ships no importable
   `zlib`/`CZlib` module (only the C headers), so `canImport(zlib)` is false
   there; `decodeGzipBody` handles that fallback. On Linux libcurl has already
   transparently decompressed the body (the magic bytes are gone), so the
   decoder is not needed for normal responses. */
#if canImport(zlib)
import zlib
#endif

/// Default implementation of ``ApiClient`` using `URLSession`.
///
/// Applies transport-level settings from ``TransportOptions``: TLS verification,
/// custom CA certificates, proxy routing, timeouts, redirect handling,
/// `User-Agent` injection, `X-Request-ID` injection, and transport-level
/// default headers.
///
/// Header merge order (lowest to highest priority):
///  1. TransportOptions.defaultHeaders -- transport-level defaults
///  2. Caller-provided headers (from BaseApi -- includes config defaults, auth, operation headers)
///  3. TransportOptions.userAgent -- injected if not already set
///  4. TransportOptions.injectRequestID -- injected if not already set
public final class DefaultApiClient: ApiClient, @unchecked Sendable {
    private let transportOptions: TransportOptions
    private let session: URLSession
    private let sessionDelegate: SessionDelegate?
    /* The close lifecycle: a request is counted in before it starts and out
       when it ends, ``close()`` marks the client closed, and the session the
       SDK built is released when the last request in flight ends. A request
       after ``close()`` surfaces a ``ConfigurationError`` instead of a foreign
       URLSession "session invalidated" exception. */
    private let lifecycle = ClientLifecycle()
    /* False when the caller supplied the session through
       ``TransportOptionsBuilder/session(_:)``: the caller owns its lifecycle,
       so ``close()`` must never invalidate it. */
    private let ownsSession: Bool
    /* The session used for noRedirect requests (OAuth2 token calls). Built
       once, on first use, from the primary session's configuration so it
       shares the proxy, timeouts and stateless settings, and invalidated by
       ``close()`` so it never leaks. */
    private let noRedirectLock = NSLock()
    private var noRedirectSessionStorage: URLSession?
    /* URLSession's connectionProxyDictionary has no key for
     * proxy basic-auth credentials, so userinfo embedded in the proxy
     * URL (`http://user:pass@host:port`) is silently dropped by the
     * platform. Extract it here and answer the proxy's own authentication
     * challenge with it (see ``SessionDelegate``): the credential goes to
     * the proxy only and is never written into a request, so the origin
     * (the API host, the OAuth token endpoint) never sees it. */
    internal let proxyCredential: URLCredential?

    /// Creates a client with default transport settings.
    ///
    /// The default ``TransportOptions`` configure no custom CA certificate,
    /// so this initializer never fails and is non-throwing. It routes through
    /// do/catch rather than force-try, so a future change that makes
    /// construction fallible surfaces a clear message instead of crashing.
    public convenience init() {
        do {
            try self.init(transportOptions: TransportOptions.defaults)
        } catch {
            preconditionFailure("default DefaultApiClient initialization failed: \(error)")
        }
    }

    /// Creates a client with the given transport settings.
    /// If transportOptions is nil, default transport settings are used.
    ///
    /// When ``TransportOptions/caCertPath`` is set, the certificate
    /// is read and parsed eagerly here. If it cannot be read or parsed, this
    /// initializer throws ``ConfigurationError/invalidCACertificate(_:)``
    /// rather than silently falling back to the system trust store — if the
    /// caller explicitly asked for SSL pinning we must not pretend it
    /// succeeded. A proxy on a platform that cannot route through one throws
    /// ``ConfigurationError/invalidProxy(_:)``, and disabling TLS verification
    /// or pinning a CA where URLSession cannot apply either throws
    /// ``ConfigurationError/invalidCACertificate(_:)``.
    public init(transportOptions: TransportOptions?) throws {
        let opts = transportOptions ?? TransportOptions.defaults
        try DefaultApiClient.validateCaCertPath(opts.caCertPath)
        self.transportOptions = opts
        self.proxyCredential = DefaultApiClient.buildProxyCredential(opts.proxy)
        if let supplied = opts.session {
            self.session = supplied
            /* The supplied session carries none of the SDK's redirect rules, so
             * the SDK's own delegate is attached to every task it sends (see
             * `performDataTask`): a cross-origin hop still strips credentials,
             * a non-HTTP(S) Location and an HTTPS to HTTP body replay are still
             * refused, and the hop cap still applies. */
            self.sessionDelegate = SessionDelegate(
                verifySsl: true,
                caCertPath: nil,
                followRedirects: true,
                maxRedirects: nil,
                proxyCredential: nil
            )
            self.ownsSession = false
            return
        }
        let (session, delegate) = try DefaultApiClient.buildSession(opts)
        self.session = session
        self.sessionDelegate = delegate
        self.ownsSession = true
    }

    /// The message for a proxy on a platform whose URLSession cannot use one.
    static let proxyUnsupportedMessage = "Proxy configuration is not supported on this platform"

    /// The message for disabling TLS verification or pinning a CA certificate
    /// on a platform whose URLSession cannot apply either.
    static let tlsOptionsUnsupportedMessage =
        "Disabling TLS verification or pinning a CA certificate is not supported on this platform"

    /// Validates that a user-supplied CA certificate path can be read and
    /// parsed as a DER/PEM certificate, throwing
    /// ``ConfigurationError/invalidCACertificate(_:)`` when it cannot. A nil
    /// path is a no-op (the system trust store is used).
    static func validateCaCertPath(_ caCertPath: String?) throws {
        guard let path = caCertPath else { return }
        let certData: Data
        do {
            certData = try Data(contentsOf: URL(fileURLWithPath: path))
        } catch {
            throw ConfigurationError.invalidCACertificate(
                "failed to read CA certificate from \"\(path)\": \(error.localizedDescription)")
        }
        let certificates = parseCaCertificates(certData)
#if canImport(Security)
        let parsed = !certificates.isEmpty
            && certificates.allSatisfy { SecCertificateCreateWithData(nil, $0 as CFData) != nil }
#else
        let parsed = !certificates.isEmpty
#endif
        guard parsed else {
            throw ConfigurationError.invalidCACertificate(
                "failed to parse CA certificate from \"\(path)\": no PEM blocks found"
            )
        }
    }

    /// Splits the contents of a CA certificate file into DER certificates.
    ///
    /// `SecCertificateCreateWithData` only accepts DER, so a PEM file (the
    /// format every other SDK documents) is unwrapped here: every
    /// `BEGIN CERTIFICATE` block is base64-decoded, so a bundle yields all of
    /// its certificates, not just the first. A file with no PEM armour is
    /// taken to be a single DER certificate (it must start with the ASN.1
    /// SEQUENCE tag). Anything else yields an empty list.
    static func parseCaCertificates(_ data: Data) -> [Data] {
        let begin = "-----BEGIN CERTIFICATE-----"
        let end = "-----END CERTIFICATE-----"
        guard let text = String(data: data, encoding: .utf8), text.contains(begin) else {
            return data.first == 0x30 ? [data] : []
        }
        var certificates: [Data] = []
        var cursor = text.startIndex
        while let open = text.range(of: begin, range: cursor..<text.endIndex),
              let close = text.range(of: end, range: open.upperBound..<text.endIndex) {
            let body = String(text[open.upperBound..<close.lowerBound].filter { !$0.isWhitespace })
            if let der = Data(base64Encoded: body), !der.isEmpty {
                certificates.append(der)
            }
            cursor = close.upperBound
        }
        return certificates
    }

    /// Creates a client with the given transport settings and a pre-built URLSession.
    /// Used primarily for testing with stub URL protocols.
    internal init(transportOptions: TransportOptions? = nil, session: URLSession) {
        let opts = transportOptions ?? TransportOptions.defaults
        self.transportOptions = opts
        self.proxyCredential = DefaultApiClient.buildProxyCredential(opts.proxy)
        self.session = session
        self.sessionDelegate = nil
        self.ownsSession = true
    }

    /// Creates a client whose internal URLSession uses the real
    /// ``SessionDelegate`` (so redirect handling — including redirect
    /// exhaustion, non-HTTP(S) scheme refusal, and HTTPS->HTTP body-replay
    /// refusal — runs) while routing requests through the supplied stub
    /// `URLProtocol` classes. Used by tests that need to exercise the
    /// redirect-refusal path, which a plain stub session (with no delegate)
    /// bypasses.
    internal init(transportOptions: TransportOptions? = nil, protocolClasses: [AnyClass]) {
        let opts = transportOptions ?? TransportOptions.defaults
        self.transportOptions = opts
        self.proxyCredential = DefaultApiClient.buildProxyCredential(opts.proxy)
        let config = URLSessionConfiguration.ephemeral
        config.protocolClasses = protocolClasses
        if let timeout = opts.timeout {
            let seconds = TimeInterval(timeout) / 1000.0
            config.timeoutIntervalForRequest = seconds
            config.timeoutIntervalForResource = seconds
        }
        let delegate = SessionDelegate(
            verifySsl: opts.verifySsl,
            caCertPath: opts.caCertPath,
            followRedirects: opts.followRedirects,
            maxRedirects: opts.maxRedirects,
            proxyCredential: DefaultApiClient.buildProxyCredential(opts.proxy)
        )
        self.session = URLSession(configuration: config, delegate: delegate, delegateQueue: nil)
        self.sessionDelegate = delegate
        self.ownsSession = true
    }

    /// Classifies a URLSession transport failure.
    ///
    /// A request cancelled because its Swift `Task` was cancelled surfaces as
    /// the platform's own `CancellationError`, unwrapped. `.timedOut` becomes
    /// ``NetworkTimeoutError``; any other failure with no HTTP response
    /// (connection refused, DNS, TLS, reset) becomes ``NetworkError``. Both
    /// carry status 0 and keep the `URLError` as ``ApiError/underlyingError``.
    /// The request target in the message is reduced to its path (see
    /// ``transportMessage(_:requestURL:)``).
    static func transportError(_ urlError: URLError, requestURL: URL? = nil) -> Error {
        if urlError.code == .cancelled && Task.isCancelled {
            return CancellationError()
        }
        let message = transportMessage(urlError, requestURL: requestURL)
        if urlError.code == .timedOut {
            return NetworkTimeoutError(
                statusCode: 0,
                message: message,
                underlyingError: urlError
            )
        }
        return NetworkError(
            statusCode: 0,
            message: message,
            underlyingError: urlError
        )
    }

    /// The localized description of a transport failure with the request target
    /// reduced to its path: the scheme, host, port, query and fragment are
    /// replaced by the path, so an error never names where the call was sent.
    static func transportMessage(_ urlError: URLError, requestURL: URL?) -> String {
        let message = urlError.localizedDescription
        guard let url = requestURL ?? urlError.failingURL else {
            return message
        }
        let path = url.path.isEmpty ? "/" : url.path
        var needles: [String] = [url.absoluteString]
        if let host = url.host {
            if let port = url.port {
                needles.append("\(host):\(port)")
            }
            needles.append(host)
        }
        var reduced = message
        for needle in needles.sorted(by: { $0.count > $1.count }) where !needle.isEmpty {
            reduced = reduced.replacingOccurrences(of: needle, with: path)
        }
        return reduced
    }

    /// Builds the credential that answers the proxy's authentication challenge
    /// from the userinfo embedded in the proxy URL, or returns nil when no
    /// credentials are present. Percent-encoded userinfo is decoded first.
    static func buildProxyCredential(_ proxy: URL?) -> URLCredential? {
        guard let proxy = proxy else { return nil }
        guard let user = proxy.user, !user.isEmpty else { return nil }
        let decodedUser = user.removingPercentEncoding ?? user
        let decodedPass = (proxy.password ?? "").removingPercentEncoding ?? (proxy.password ?? "")
        return URLCredential(user: decodedUser, password: decodedPass, persistence: .forSession)
    }

    /// Decides how to answer an authentication challenge. A challenge from the
    /// proxy is answered with the proxy credential, once: a repeated challenge
    /// means the credential was refused and is cancelled rather than retried.
    /// Every other challenge keeps the platform's default handling, so the
    /// credential is never offered to an origin.
    static func proxyChallengeDisposition(
        isProxy: Bool, previousFailureCount: Int, credential: URLCredential?
    ) -> (disposition: URLSession.AuthChallengeDisposition, credential: URLCredential?) {
        guard isProxy, let credential = credential else { return (.performDefaultHandling, nil) }
        if previousFailureCount > 0 { return (.cancelAuthenticationChallenge, nil) }
        return (.useCredential, credential)
    }

    /// Sends an HTTP request with transport-level settings applied, following
    /// redirects per the transport configuration.
    public func sendRequest(method: String, url: String, headers: [String: String], body: Any?) async throws -> ApiHttpResponse {
        return try await sendRequest(
            method: method, url: url, headers: headers, body: body, noRedirect: false)
    }

    /// Sends an HTTP request with transport-level settings applied, refusing
    /// to follow 307/308 redirects when `noRedirect` is true.
    ///
    /// Merges headers according to the priority order documented on the class,
    /// then dispatches via URLSession.
    public func sendRequest(method: String, url: String, headers: [String: String], body: Any?, noRedirect: Bool) async throws -> ApiHttpResponse {
        return try await sendRequest(
            method: method, url: url, headers: headers, body: body, noRedirect: noRedirect,
            refreshHeaders: nil)
    }

    /// Sends a request and retries it per ``TransportOptions/maxRetries``.
    ///
    /// A retry is a fresh request: the headers are rebuilt from `headers`
    /// (and, when `refreshHeaders` is given, merged over with the result of
    /// calling it, so authentication headers are applied again), and the
    /// request id is regenerated. The retry budget never extends the
    /// ``TransportOptions/timeout``, and a `noRedirect` request (the OAuth2
    /// token call) is never retried.
    ///
    /// - Parameters:
    ///   - method: The HTTP method of the request.
    ///   - url: The absolute URL of the request.
    ///   - headers: The request headers, before the defaults are applied.
    ///   - body: The request body, or nil when there is none.
    ///   - noRedirect: When true, redirects are not followed and the request is not retried.
    ///   - refreshHeaders: Rebuilds the headers before each retry, or nil to reuse them.
    ///   - timeout: Per-call timeout in milliseconds that replaces the
    ///     transport's for this call; nil keeps it.
    ///   - callRetries: Per-call retry limit that replaces the transport's for
    ///     this call; 0 turns retries off and nil keeps it.
    ///   - sendDefaultHeaders: When false, ``TransportOptions/defaultHeaders``
    ///     are left off this request, as for a call to another origin (OIDC
    ///     discovery); redirects are still followed.
    public func sendRequest(
        method: String, url: String, headers: [String: String], body: Any?, noRedirect: Bool,
        refreshHeaders: (@Sendable () async throws -> [String: String])?,
        timeout: Int? = nil, maxRetries callRetries: Int? = nil, sendDefaultHeaders: Bool = true
    ) async throws -> ApiHttpResponse {
        /* A line break in a header value would start a header line of its own. */
        for (name, value) in headers where value.unicodeScalars.contains(where: { $0 == "\r" || $0 == "\n" }) {
            throw ConfigurationError.invalidArgument(
                "Header '\(name)' must not contain a carriage return or line feed")
        }
        /* One logical request, retries included, counts as one in flight: a
           retry or a refreshed token after close() still finishes. */
        guard lifecycle.enter() else {
            throw DefaultApiClient.closedError
        }
        defer {
            if lifecycle.leave() {
                releaseTransport()
            }
        }
        let limit = callRetries ?? transportOptions.maxRetries
        let maxRetries = noRedirect || !DefaultApiClient.isReplayable(body) ? 0 : limit
        let callTimeout: TimeInterval? = timeout.map { TimeInterval($0) / 1000.0 }
        if maxRetries == 0 {
            return try await sendOnce(
                method: method, url: url, headers: headers, body: body, noRedirect: noRedirect,
                budget: callTimeout, perCallTimeout: callTimeout,
                sendDefaultHeaders: sendDefaultHeaders)
        }
        let started = Date()
        let total: TimeInterval? = callTimeout ?? transportOptions.timeout.map { TimeInterval($0) / 1000.0 }
        var current = headers
        var attempt = 0
        while true {
            let remaining: TimeInterval? = total.map { $0 - Date().timeIntervalSince(started) }
            var delay: TimeInterval = 0
            var failure: Error?
            var response: ApiHttpResponse?
            do {
                let received = try await sendOnce(
                    method: method, url: url, headers: current, body: body, noRedirect: noRedirect,
                    budget: remaining, perCallTimeout: callTimeout,
                    sendDefaultHeaders: sendDefaultHeaders)
                if attempt >= maxRetries || !DefaultApiClient.isRetryableStatus(received.statusCode) {
                    return received
                }
                response = received
                delay = DefaultApiClient.retryDelay(
                    attempt: attempt, retryAfter: received.headers["retry-after"])
            } catch let error where DefaultApiClient.isRetryableError(error, method: method) {
                if attempt >= maxRetries { throw error }
                failure = error
                delay = DefaultApiClient.retryDelay(attempt: attempt, retryAfter: nil)
            }
            /* The wait must fit in what is left of the one end-to-end budget;
               otherwise the last outcome stands. */
            if let remaining = remaining, delay >= remaining {
                if let response = response { return response }
                throw failure ?? CancellationError()
            }
            try await Task.sleep(nanoseconds: UInt64(delay * 1_000_000_000))
            attempt += 1
            if let refresh = refreshHeaders {
                current = BaseApi.mergeHeaders(current, overriding: try await refresh())
            }
        }
    }

    /// Whether a body can be sent again. Everything this SDK builds is held in
    /// memory; only a stream is consumed by its first send.
    static func isReplayable(_ body: Any?) -> Bool {
        return !(body is InputStream)
    }

    /// Statuses worth retrying: 408, 409, 429 and 500 to 599 except 501.
    static func isRetryableStatus(_ status: Int) -> Bool {
        return status == 408 || status == 409 || status == 429 || (status >= 500 && status <= 599 && status != 501)
    }

    /// Methods that may be sent again after the connection drops before any
    /// response (RFC 9110 section 9.2.2, and QUERY, which is idempotent).
    static let idempotentMethods: Set<String> = ["GET", "HEAD", "OPTIONS", "TRACE", "PUT", "DELETE", "QUERY"]

    /// Transport failures that come from the TLS handshake or the certificate
    /// chain. They would fail the same way again, so they are never retried.
    static let tlsFailureCodes: Set<URLError.Code> = [
        .secureConnectionFailed, .serverCertificateHasBadDate, .serverCertificateUntrusted,
        .serverCertificateHasUnknownRoot, .serverCertificateNotYetValid,
        .clientCertificateRejected, .clientCertificateRequired,
    ]

    /// A network error that happened before any response. A timeout is the
    /// end-to-end budget running out, so it is not retried. A TLS or certificate
    /// failure is not retried. A request whose method is not idempotent is sent
    /// once, because the server may already have acted on it.
    static func isRetryableError(_ error: Error, method: String) -> Bool {
        guard error is NetworkError, !(error is NetworkTimeoutError) else {
            return false
        }
        if let urlError = (error as? ApiError)?.underlyingError as? URLError,
            tlsFailureCodes.contains(urlError.code)
        {
            return false
        }
        return idempotentMethods.contains(method.uppercased())
    }

    /// Seconds to wait before retry number `attempt + 1`: the `Retry-After`
    /// value (delta seconds or an HTTP date, capped at 60 s) when the server
    /// sent a usable one, otherwise 0.5 s doubling up to 8 s with up to 25%
    /// jitter taken off.
    static func retryDelay(
        attempt: Int, retryAfter: String?, now: Date = Date(),
        jitter: Double = Double.random(in: 0..<1)
    ) -> TimeInterval {
        if let header = retryAfter?.trimmingCharacters(in: .whitespaces), !header.isEmpty {
            if let seconds = Double(header), seconds >= 0 {
                return min(seconds, 60)
            }
            let formatter = DateFormatter()
            formatter.locale = Locale(identifier: "en_US_POSIX")
            formatter.timeZone = TimeZone(identifier: "GMT")
            formatter.dateFormat = "EEE, dd MMM yyyy HH:mm:ss zzz"
            if let date = formatter.date(from: header) {
                return min(max(date.timeIntervalSince(now), 0), 60)
            }
        }
        let base = min(0.5 * pow(2.0, Double(min(attempt, 10))), 8.0)
        return base * (1.0 - 0.25 * jitter)
    }

    private func sendOnce(
        method: String, url: String, headers: [String: String], body: Any?, noRedirect: Bool,
        budget: TimeInterval?, perCallTimeout: TimeInterval? = nil, sendDefaultHeaders: Bool = true
    ) async throws -> ApiHttpResponse {
        guard let requestURL = URL(string: url),
              let scheme = requestURL.scheme?.lowercased(),
              scheme == "http" || scheme == "https"
        else {
            throw ConfigurationError.invalidArgument("malformed request URL: \(url)")
        }

        /* The token POST (noRedirect) goes to the identity provider, another
         * origin: the caller's default headers (an API Authorization or key
         * header) are not sent there. */
        var merged = BaseApi.mergeHeaders(
            noRedirect || !sendDefaultHeaders ? [:] : transportOptions.defaultHeaders,
            overriding: headers)
        /* Header names are case-insensitive (RFC 9110 section 5.1): a caller
         * header in any case wins and nothing is injected beside it. */
        func hasHeader(_ name: String) -> Bool {
            merged.keys.contains { $0.caseInsensitiveCompare(name) == .orderedSame }
        }
        if !hasHeader("User-Agent"), let ua = transportOptions.userAgent {
            merged["User-Agent"] = ua
        }
        if !hasHeader("X-Request-ID") && transportOptions.injectRequestID {
            merged["X-Request-ID"] = UUID().uuidString.lowercased()
        }
        /* Advertise only the codings this client can decode: gzip and deflate.
         * An explicit Accept-Encoding stops URLSession from negotiating on its
         * own, which also stops it adding br (and zstd) that the client cannot
         * decode. Gzip bodies still carrying their magic bytes are inflated
         * with zlib on Apple, and libcurl decodes the rest on Linux. A caller's
         * own Accept-Encoding, in any case, is kept and the caller decodes. */
        let advertisedEncoding = "gzip, deflate"
        let callerManagedEncoding = hasHeader("Accept-Encoding")
        if !callerManagedEncoding {
            merged["Accept-Encoding"] = advertisedEncoding
        }

        var request = URLRequest(url: requestURL)
        request.httpMethod = method
        /* A supplied session carries none of the SDK's timeouts (they are set
           on a session the SDK builds itself), so apply the timeout to the
           request. */
        let effectiveTimeout: TimeInterval? =
            budget ?? transportOptions.timeout.map { TimeInterval($0) / 1000.0 }
        if !ownsSession || perCallTimeout != nil, let timeout = effectiveTimeout {
            request.timeoutInterval = timeout
        }

        if let formParts = BaseApi.formFields(body) {
            let boundary = UUID().uuidString
            merged = BaseApi.mergeHeaders(
                merged, overriding: ["Content-Type": "multipart/form-data; boundary=\(boundary)"])
            request.httpBody = try DefaultApiClient.buildMultipartBody(ordered: formParts, boundary: boundary)
        } else if let data = body as? Data {
            request.httpBody = data
        } else if let text = body as? String {
            /* A text body is sent as its UTF-8 bytes, the same on every attempt. */
            request.httpBody = Data(text.utf8)
        } else {
            for name in merged.keys where name.caseInsensitiveCompare("Content-Type") == .orderedSame {
                merged.removeValue(forKey: name)
            }
            /* Some servers / WAFs treat POST/PUT/PATCH with no body and
               no Content-Length as malformed (411 Length Required) or
               behave inconsistently. Attach an empty Data on body-bearing
               verbs so URLSession emits an explicit `Content-Length: 0`,
               matching Kotlin's `ByteArray(0)` and the other 11 SDKs. */
            let upperMethod = method.uppercased()
            if upperMethod == "POST" || upperMethod == "PUT" || upperMethod == "PATCH" {
                request.httpBody = Data()
                merged = BaseApi.mergeHeaders(merged, overriding: ["Content-Length": "0"])
            }
        }

        for (k, v) in merged {
            request.setValue(v, forHTTPHeaderField: k)
        }

        var data: Data
        let response: URLResponse
        /* The URLSessionTask backing this single call. Redirect counting and
           the redirect-refusal error are scoped to THIS task inside the
           shared ``SessionDelegate`` (keyed by the task's taskIdentifier),
           so concurrent requests through the same client never share a
           redirect counter or corrupt each other's refusal error. We hold the
           task here so the post-completion `takeRedirectError(for:)` retrieves
           only this request's recorded refusal. */
        let task: URLSessionTask
        var callDelegate: SessionDelegate?
        do {
            /* When noRedirect is set (used by the OAuth2 token
             * endpoint POST), route through a dedicated, non-following
             * session so no redirect is followed; the first 3xx response
             * is returned to the caller as-is (status, body, headers). The
             * token manager inspects and rejects the 3xx itself, so the
             * credential-bearing body is never silently replayed to the
             * Location target. */
            var activeSession: URLSession = noRedirect
                ? noRedirectSession()
                : session
            /* A per-call timeout reaches a session the SDK built itself through
               a one-off copy of it: the session's own deadlines would otherwise
               cut a longer call short. It is released as soon as the call ends. */
            var callSession: URLSession?
            if ownsSession, !noRedirect, let callTimeout = perCallTimeout {
                let configuration = session.configuration
                configuration.timeoutIntervalForRequest = callTimeout
                configuration.timeoutIntervalForResource = callTimeout
                let delegate = SessionDelegate(
                    verifySsl: transportOptions.verifySsl,
                    caCertPath: transportOptions.caCertPath,
                    followRedirects: transportOptions.followRedirects,
                    maxRedirects: transportOptions.maxRedirects,
                    proxyCredential: proxyCredential
                )
                let created = URLSession(configuration: configuration, delegate: delegate, delegateQueue: nil)
                callSession = created
                callDelegate = delegate
                activeSession = created
            }
            defer { callSession?.finishTasksAndInvalidate() }
            (data, response, task) = try await DefaultApiClient.performDataTask(
                on: activeSession, for: request,
                taskDelegate: (!ownsSession && !noRedirect) ? sessionDelegate : nil,
                deadline: effectiveTimeout)
        } catch let undecodable as UndecodableBody {
            /* The server answered but its body cannot be decoded: an ApiError
               carrying the real status code, never a NetworkError. */
            throw ApiError(
                statusCode: undecodable.response.statusCode,
                message: "Failed to decode response body: \(undecodable.urlError.localizedDescription)",
                responseHeaders: DefaultApiClient.lowercasedHeaders(of: undecodable.response),
                underlyingError: undecodable.urlError
            )
        } catch let urlError as URLError {
            throw DefaultApiClient.transportError(urlError, requestURL: request.url)
        } catch let cancellation as CancellationError {
            throw cancellation
        } catch {
            throw NetworkError(
                statusCode: 0,
                message: error.localizedDescription,
                underlyingError: error
            )
        }

        guard let httpResponse = response as? HTTPURLResponse else {
            throw NetworkError(statusCode: 0, message: "Unexpected non-HTTP response from server")
        }

        /* The redirect delegate cannot throw, so a redirect refusal (too
           many redirects, non-HTTP(S) Location scheme, or HTTPS->HTTP
           body-replay downgrade) is recorded on the delegate KEYED BY THIS
           task and re-raised here as a typed ApiError rather than silently
           returning the last 3xx response. Keying by task means a refusal
           recorded for a concurrent sibling request never surfaces on this
           one. */
        if let refusal = (callDelegate ?? sessionDelegate)?.takeRedirectError(for: task) {
            throw refusal
        }

        /* Response header keys are normalised to lowercase so
           callers can look them up consistently regardless of the casing
           the server used (HTTP header names are case-insensitive per
           RFC 7230 section 3.2, and HTTP/2 mandates lowercase on the wire).
           Repeated header lines (for example multiple Link or Set-Cookie
           headers) are joined with ", " to preserve order per RFC 7230
           section 3.2.2. NSHTTPURLResponse's allHeaderFields collapses
           duplicates so we re-read each header via value(forHTTPHeaderField:),
           which on iOS 13+/macOS 10.15+ returns the multi-value joined form
           with ", " between values. The joined form is not directly
           parseable for Set-Cookie; callers needing structured cookie
           access should use HTTPCookie.cookies(withResponseHeaderFields:for:). */
        let respHeaders = DefaultApiClient.lowercasedHeaders(of: httpResponse)

        /* Defend against a `Content-Encoding` lie WITHOUT mistaking a
           normal, already-decompressed response for one.

           URLSession transparently decompresses an encoding it negotiated, but
           the two platforms differ in what they leave behind. On Apple it strips
           the `Content-Encoding` header after decoding; on Linux,
           swift-corelibs-foundation (libcurl) decompresses the body in place but
           LEAVES the `Content-Encoding` header on the response. So a residual
           `Content-Encoding: gzip` header does NOT imply the body is still
           compressed — on Linux it is the normal case for every gzip response.
           Throwing on the mere presence of the header (the previous heuristic)
           rejected every normal Linux response, which was wrong.

           Instead, mirror node's robust approach: only treat the body as still
           encoded when the BYTES actually begin with the codec's magic number
           (gzip = 0x1F 0x8B). If the magic is present the body really was not
           decoded, so we gunzip it ourselves; a decode failure (advertised gzip
           but the stream is truncated / not real gzip) surfaces as the SDK's
           uniform ApiError rather than silent corrupt passthrough. If the magic
           is absent the body was already decompressed (or is plaintext) and is
           passed through untouched — never throwing on a body that lacks the
           compression signature, which is what fixes the regression.

           A caller who explicitly set `Accept-Encoding` has opted to receive and
           decode the encoded bytes itself, so we leave its body completely
           alone (no magic-byte inspection, no decode). */
        let residualEncoding = (respHeaders["content-encoding"] ?? "")
            .split(separator: ",")
            .last
            .map { $0.trimmingCharacters(in: .whitespaces).lowercased() } ?? ""
        /* Refuse any coding the SDK cannot decode rather than handing the caller
           bytes still in that encoding. Every token of a comma list must be one
           the SDK decodes or the identity coding. A caller-managed encoding is
           left alone, as above. */
        let declaredCodings = (respHeaders["content-encoding"] ?? "")
            .trimmingCharacters(in: .whitespaces)
            .lowercased()
        let decodableCodings: Set<String> = ["", "identity", "gzip", "x-gzip", "deflate"]
        if !callerManagedEncoding,
           declaredCodings.split(separator: ",").contains(where: {
               !decodableCodings.contains($0.trimmingCharacters(in: .whitespaces))
           }) {
            throw ApiError(
                statusCode: httpResponse.statusCode,
                message: "Unsupported Content-Encoding '\(declaredCodings)'",
                responseHeaders: respHeaders,
                underlyingError: nil
            )
        }
        if !callerManagedEncoding,
           residualEncoding == "gzip" || residualEncoding == "x-gzip",
           DefaultApiClient.hasGzipMagic(data) {
            /* The body still carries the gzip magic (0x1F 0x8B), so URLSession
               did NOT decode it. Decode it ourselves; a malformed stream throws. */
            do {
                data = try DefaultApiClient.decodeGzipBody(data)
            } catch {
                throw ApiError(
                    statusCode: httpResponse.statusCode,
                    message: "Failed to decompress \(residualEncoding) response body: "
                        + "\(error.localizedDescription)",
                    responseHeaders: respHeaders,
                    underlyingError: error
                )
            }
        }

        let contentType = respHeaders["content-type"] ?? ""
        let responseBody: String
        if DefaultApiClient.isTextContentType(contentType) {
            responseBody = DefaultApiClient.decodeText(data, contentType: contentType)
        } else {
            responseBody = data.base64EncodedString()
        }

        return ApiHttpResponse(
            statusCode: httpResponse.statusCode,
            body: responseBody,
            headers: respHeaders
        )
    }

    /// Builds a multipart/form-data request body from a dictionary of form fields.
    ///
    /// Each value may be `Data` (sent as a file part), `String`/number/bool (sent as
    /// a text part), `[Any]` (each element is added as a separate part with the same name),
    /// or any other Encodable type (JSON-serialized).
    ///
    /// Throws ``ConfigurationError/invalidArgument(_:)`` if a filename contains CR, LF, or NUL bytes
    /// (which would allow header injection).
    static func buildMultipartBody(_ formParts: [String: Any], boundary: String) throws -> Data {
        return try buildMultipartBody(ordered: OrderedParams<Any>(sorting: formParts), boundary: boundary)
    }

    /// Builds a multipart body from form fields kept in the spec's declaration
    /// order: the parts are written in that order.
    static func buildMultipartBody(ordered formParts: OrderedParams<Any>, boundary: String) throws -> Data {
        var body = Data()
        let crlf = "\r\n"

        for (name, value) in formParts {
            if let list = value as? [Any] {
                for item in list {
                    try appendMultipartField(&body, name: name, value: item, boundary: boundary, crlf: crlf)
                }
            } else {
                try appendMultipartField(&body, name: name, value: value, boundary: boundary, crlf: crlf)
            }
        }

        body.append(Data("--\(boundary)--\(crlf)".utf8))
        return body
    }

    private static func appendMultipartField(_ body: inout Data, name: String, value: Any, boundary: String, crlf: String) throws {
        let separator = "--\(boundary)\(crlf)Content-Disposition: form-data; name="
        let safeName = try sanitizeQuotedHeaderValue(name)

        if let data = value as? Data {
            let disposition = try buildContentDisposition(name: safeName, filename: name)
            let mime = mimeTypeForFilename(name)
            body.append(Data("--\(boundary)\(crlf)\(disposition)\(crlf)Content-Type: \(mime)\(crlf)\(crlf)".utf8))
            body.append(data)
            body.append(Data(crlf.utf8))
        } else if let text = value as? String {
            body.append(Data("\(separator)\"\(safeName)\"\(crlf)\(crlf)\(text)\(crlf)".utf8))
        } else if BaseApi.isMultipartPrimitive(value) {
            /* Every primitive (boolean, number, date-time, uuid, enum) is a
               plain text part with no part Content-Type, its body the
               canonical stringify form (`true`, `3`,
               `2024-01-15T10:30:00.000+00:00`, the enum wire value). */
            let text = ObjectSerializer.stringify(value)
            body.append(Data("\(separator)\"\(safeName)\"\(crlf)\(crlf)\(text)\(crlf)".utf8))
        } else {
            /* Model objects (Codable structs) -- serialize through the SDK's
             * shared, date-strategy-configured encoder rather than
             * JSONSerialization.data(withJSONObject:). A Swift struct is not a
             * valid JSONSerialization top-level object, so that path raises an
             * ObjC NSInvalidArgumentException that `try?` cannot catch. Routing
             * through ObjectSerializer.serialize mirrors BaseApi.appendMultipartField
             * and keeps both multipart builders agreeing on date encoding. */
            if let json = try? ObjectSerializer.serialize(value) {
                body.append(Data("\(separator)\"\(safeName)\"\(crlf)Content-Type: application/json\(crlf)\(crlf)\(json)\(crlf)".utf8))
            }
        }
    }

    /// Validates and escapes a value destined for a quoted multipart header.
    ///
    /// Throws ``ConfigurationError/invalidArgument(_:)`` if the value contains CR, LF, or NUL (header
    /// injection risk); otherwise backslash-escapes `\` and `"`.
    static func sanitizeQuotedHeaderValue(_ value: String) throws -> String {
        for scalar in value.unicodeScalars {
            if scalar == "\r" || scalar == "\n" || scalar.value == 0 {
                throw ConfigurationError.invalidArgument("value contains CR, LF, or NUL characters")
            }
        }
        var escaped = ""
        escaped.reserveCapacity(value.count)
        for ch in value {
            if ch == "\\" || ch == "\"" {
                escaped.append("\\")
            }
            escaped.append(ch)
        }
        return escaped
    }

    /// Builds a `Content-Disposition` header value for a file part.
    ///
    /// Emits an ASCII-safe `filename="..."` (with non-ASCII chars replaced by `_`)
    /// and, when the original filename contains non-ASCII codepoints, an additional
    /// RFC 5987 `filename*=UTF-8''<percent-encoded>` parameter for clients that
    /// support extended encoding.
    /// Builds a `Content-Disposition` header for a file part. Both
    /// `name` and `filename` MUST already have been validated/escaped
    /// via ``sanitizeQuotedHeaderValue`` by the caller.
    static func buildContentDisposition(name: String, filename: String) throws -> String {
        let safeFilename = try sanitizeQuotedHeaderValue(filename)
        let isAscii = filename.unicodeScalars.allSatisfy { $0.isASCII }
        if isAscii {
            return "Content-Disposition: form-data; name=\"\(name)\"; filename=\"\(safeFilename)\""
        }
        var asciiFallback = ""
        for scalar in filename.unicodeScalars {
            if scalar.isASCII {
                asciiFallback.unicodeScalars.append(scalar)
            } else {
                asciiFallback.append("_")
            }
        }
        let asciiSafe = try sanitizeQuotedHeaderValue(asciiFallback)
        var allowed = CharacterSet.alphanumerics
        allowed.insert(charactersIn: "!#$&+-.^_`|~")
        let encoded = filename.addingPercentEncoding(withAllowedCharacters: allowed) ?? asciiSafe
        return "Content-Disposition: form-data; name=\"\(name)\"; filename=\"\(asciiSafe)\"; filename*=UTF-8''\(encoded)"
    }

    /// Returns a MIME type for the file based on its extension, or
    /// `application/octet-stream` if no mapping is known.
    static func mimeTypeForFilename(_ filename: String) -> String {
        guard let dotIndex = filename.lastIndex(of: ".") else {
            return "application/octet-stream"
        }
        let ext = String(filename[filename.index(after: dotIndex)...]).lowercased()
        switch ext {
        case "png": return "image/png"
        case "jpg", "jpeg": return "image/jpeg"
        case "gif": return "image/gif"
        case "webp": return "image/webp"
        case "svg": return "image/svg+xml"
        case "bmp": return "image/bmp"
        case "tiff", "tif": return "image/tiff"
        case "ico": return "image/x-icon"
        case "pdf": return "application/pdf"
        case "json": return "application/json"
        case "xml": return "application/xml"
        case "zip": return "application/zip"
        case "gz", "gzip": return "application/gzip"
        case "tar": return "application/x-tar"
        case "txt": return "text/plain"
        case "csv": return "text/csv"
        case "html", "htm": return "text/html"
        case "css": return "text/css"
        case "js": return "application/javascript"
        case "mp4": return "video/mp4"
        case "mp3": return "audio/mpeg"
        case "wav": return "audio/wav"
        case "ogg": return "audio/ogg"
        case "webm": return "video/webm"
        default: return "application/octet-stream"
        }
    }

    /// Decodes a text body using the Content-Type's charset.
    ///
    /// A bare `utf-16` label is big-endian only when the body carries no
    /// byte-order mark; a leading FF FE (little-endian) or FE FF (big-endian)
    /// mark selects the byte order and is dropped, like the other SDKs.
    /// Foundation returns nil for bytes that are invalid in the declared
    /// charset AND in UTF-8; those decode leniently (U+FFFD for each bad byte)
    /// instead of silently dropping the whole body.
    static func decodeText(_ data: Data, contentType: String?) -> String {
        var encoding = encodingForContentType(contentType)
        var bytes = data
        if charsetLabel(contentType) == "utf-16", data.count >= 2 {
            let first = data[data.startIndex]
            let second = data[data.startIndex + 1]
            if first == 0xFF && second == 0xFE {
                encoding = .utf16LittleEndian
                bytes = data.dropFirst(2)
            } else if first == 0xFE && second == 0xFF {
                bytes = data.dropFirst(2)
            }
        }
        return String(data: bytes, encoding: encoding) ?? String(decoding: data, as: UTF8.self)
    }

    /// The lowercased, unquoted `charset=` value of a Content-Type header, or
    /// nil when there is none.
    static func charsetLabel(_ contentType: String?) -> String? {
        guard let contentType = contentType else {
            return nil
        }
        /* Only a parameter NAMED charset counts: a parameter whose name merely
           ends in charset (xcharset=) is not the charset. The first element is
           the media type, so it is skipped. */
        for parameter in contentType.split(separator: ";").dropFirst() {
            let pair = parameter.split(separator: "=", maxSplits: 1)
            guard pair.count == 2,
                  String(pair[0]).trimmingCharacters(in: .whitespaces).lowercased() == "charset"
            else {
                continue
            }
            var charset = String(pair[1]).trimmingCharacters(in: .whitespaces)
            /* Strip surrounding quotes if present (charset values may be quoted). */
            if charset.hasPrefix("\"") && charset.hasSuffix("\"") && charset.count >= 2 {
                charset = String(charset.dropFirst().dropLast())
            }
            return charset.lowercased()
        }
        return nil
    }

    /// Parses the `charset=` parameter from a Content-Type header and
    /// returns the matching `String.Encoding`. A label outside the table
    /// below is resolved through CoreFoundation's IANA charset registry, so
    /// any charset the platform can convert decodes (iso-8859-15, koi8-r,
    /// gb18030, big5, ...). Falls back to UTF-8 if the charset is missing,
    /// unregistered, or unsupported.
    static func encodingForContentType(_ contentType: String?) -> String.Encoding {
        guard let charset = charsetLabel(contentType) else {
            return .utf8
        }
        switch charset {
        case "utf-8", "utf8": return .utf8
        case "iso-8859-1", "latin1", "latin-1": return .isoLatin1
        case "iso-8859-2", "latin2", "latin-2": return .isoLatin2
        case "us-ascii", "ascii": return .ascii
        /* A bare `utf-16` label (no explicit endianness) with no byte-order
           mark MUST decode as big-endian per RFC 2781. Foundation's `.utf16`
           defaults to the host byte order (little-endian on Apple/Linux) when
           no BOM is present, which disagrees with the IANA/MIME charset
           registration and with the other SDKs. `.utf16BigEndian` still
           honours a leading big-endian BOM, so BOM-carrying bodies remain
           correct while the no-BOM case resolves deterministically. */
        case "utf-16": return .utf16BigEndian
        case "utf-16be": return .utf16BigEndian
        case "utf-16le": return .utf16LittleEndian
        case "utf-32": return .utf32
        case "windows-1250": return .windowsCP1250
        case "windows-1251": return .windowsCP1251
        case "windows-1252", "cp1252", "x-cp1252": return .windowsCP1252
        case "windows-1253": return .windowsCP1253
        case "windows-1254": return .windowsCP1254
        case "shift_jis", "shift-jis": return .shiftJIS
        case "euc-jp": return .japaneseEUC
        case "iso-2022-jp": return .iso2022JP
        default: return registeredEncoding(charset) ?? .utf8
        }
    }

    /// Looks a charset label up in CoreFoundation's IANA registry, which is
    /// present on Linux as well as on the Apple platforms. Returns nil for a
    /// label the registry does not know.
    static func registeredEncoding(_ label: String) -> String.Encoding? {
        let name = unsafeBitCast(NSString(string: label), to: CFString.self)
        let cfEncoding = CFStringConvertIANACharSetNameToEncoding(name)
        guard cfEncoding != kCFStringEncodingInvalidId else {
            return nil
        }
        return String.Encoding(rawValue: UInt(CFStringConvertEncodingToNSStringEncoding(cfEncoding)))
    }

    /// Determines whether the given content type represents text content
    /// that is safe to decode as a UTF-8 string.
    static func isTextContentType(_ contentType: String) -> Bool {
        let mediaType = contentType.split(separator: ";").first?
            .trimmingCharacters(in: .whitespaces).lowercased() ?? ""
        if mediaType.isEmpty { return true }
        if mediaType.hasPrefix("text/") { return true }
        return mediaType == "application/json"
            || mediaType == "application/xml"
            || mediaType == "application/javascript"
            || mediaType.hasSuffix("+json")
            || mediaType.hasSuffix("+xml")
    }

    /// Returns true when `data` begins with the two-byte gzip magic number
    /// (0x1F 0x8B). A body that still carries this signature was NOT
    /// transparently decompressed by URLSession; one that lacks it was either
    /// already decompressed (the normal case — on Linux the
    /// `Content-Encoding` header survives even though the body is plaintext)
    /// or is plaintext to begin with, and must pass through untouched.
    static func hasGzipMagic(_ data: Data) -> Bool {
        return data.count >= 2 && data[data.startIndex] == 0x1F
            && data[data.startIndex + 1] == 0x8B
    }

    /// Decodes a gzip body that was left encoded on the wire (the caller has
    /// already confirmed the gzip magic bytes are present). Returns the
    /// decompressed bytes, or throws when the body is not a valid gzip stream
    /// — the caller of this guard converts that throw into the SDK's uniform
    /// ``ApiError`` rather than handing corrupt, undecoded bytes back.
    ///
    /// On Apple platforms a `zlib` module is available, so we decompress with
    /// it (window bits `MAX_WBITS + 16` selects gzip framing). On Linux there
    /// is no importable `zlib`/`CZlib` module without adding a system-library
    /// Package.swift target, and in practice libcurl has already transparently
    /// decompressed the body (so the magic bytes are gone and this method is
    /// never reached for a normal response). If a body that still carries the
    /// gzip magic does reach here on a platform without a decoder, the bytes
    /// are genuinely undecoded gzip we cannot process, so surfacing an
    /// ``ApiError`` is the correct, non-corrupting outcome.
    static func decodeGzipBody(_ data: Data) throws -> Data {
#if canImport(zlib)
        if data.isEmpty { return data }
        var stream = z_stream()
        /* Use zlibVersion() (a runtime `const char *`) rather than the
           ZLIB_VERSION macro: Swift imports the macro as a `String`, which is
           not directly compatible with inflateInit2_'s `const char *` version
           parameter. window bits MAX_WBITS + 16 selects gzip framing. */
        let initResult = inflateInit2_(
            &stream, MAX_WBITS + 16, zlibVersion(),
            Int32(MemoryLayout<z_stream>.size))
        guard initResult == Z_OK else {
            throw ApiError(message: "zlib inflateInit2 failed (code \(initResult))")
        }
        defer { inflateEnd(&stream) }

        var output = Data()
        let chunkSize = 64 * 1024
        var outBuffer = [UInt8](repeating: 0, count: chunkSize)

        let inflateError: Int32? = data.withUnsafeBytes {
            (inPtr: UnsafeRawBufferPointer) -> Int32? in
            guard let inBase = inPtr.bindMemory(to: UInt8.self).baseAddress else {
                return Z_DATA_ERROR
            }
            stream.next_in = UnsafeMutablePointer(mutating: inBase)
            stream.avail_in = uInt(data.count)

            var status = Z_OK
            repeat {
                status = outBuffer.withUnsafeMutableBufferPointer {
                    (outPtr: inout UnsafeMutableBufferPointer<UInt8>) -> Int32 in
                    stream.next_out = outPtr.baseAddress
                    stream.avail_out = uInt(chunkSize)
                    let s = inflate(&stream, Z_NO_FLUSH)
                    let produced = chunkSize - Int(stream.avail_out)
                    if produced > 0, let outBase = outPtr.baseAddress {
                        output.append(outBase, count: produced)
                    }
                    return s
                }
            } while status == Z_OK
            return status == Z_STREAM_END ? nil : status
        }

        if let code = inflateError {
            throw ApiError(message: "Failed to gunzip response body (zlib code \(code))")
        }
        return output
#else
        /* No gzip decoder available on this platform (Linux ships no
           importable zlib module). A body that still carries the gzip magic is
           genuinely undecoded; do not hand the raw bytes back as the payload. */
        throw ApiError(
            message: "Response body is gzip-encoded but no decoder is available "
                + "on this platform")
#endif
    }

    /// Runs `request` on `session` and returns the body, response, AND the
    /// backing ``URLSessionTask``.
    ///
    /// The async `URLSession.data(for:)` convenience does not expose the task,
    /// but we need the task identity to retrieve THIS request's redirect-refusal
    /// error from the shared ``SessionDelegate`` (which keys redirect state per
    /// task so concurrent requests don't share a redirect counter or error
    /// slot). So we drive a `dataTask` through a checked continuation ourselves,
    /// capturing the task before `resume()`. Cancelling the surrounding Swift
    /// task cancels the URLSession task, preserving structured-concurrency
    /// cancellation semantics. Available on both Apple Foundation and Linux
    /// swift-corelibs-foundation (FoundationNetworking).
    /// A response whose body URLSession could not decode.
    private struct UndecodableBody: Error {
        let response: HTTPURLResponse
        let urlError: URLError
    }

    private static func performDataTask(
        on session: URLSession,
        for request: URLRequest,
        taskDelegate: URLSessionTaskDelegate? = nil,
        deadline: TimeInterval? = nil
    ) async throws -> (Data, URLResponse, URLSessionTask) {
        /* Box the task so the completion handler, the continuation body and
           the cancellation handler refer to the same instance. The lock and
           the `cancelled` flag close the race where the surrounding Swift
           task is cancelled before `dataTask` exists: `onCancel` then runs
           first, finds no task to cancel, and records the cancellation so the
           task is never started. */
        final class TaskBox: @unchecked Sendable {
            private let lock = NSLock()
            private var task: URLSessionTask?
            private var cancelled = false
            private var expired = false

            /// Records the task; returns false when cancellation came first.
            func install(_ newTask: URLSessionTask) -> Bool {
                lock.withLock {
                    task = newTask
                    return !cancelled
                }
            }

            func cancel() {
                let current: URLSessionTask? = lock.withLock {
                    cancelled = true
                    return task
                }
                current?.cancel()
            }

            /// The deadline passed: cancel the task and remember why.
            func expire() {
                let current: URLSessionTask? = lock.withLock {
                    expired = true
                    cancelled = true
                    return task
                }
                current?.cancel()
            }

            var didExpire: Bool {
                lock.withLock { expired }
            }

            var current: URLSessionTask? {
                lock.withLock { task }
            }
        }
        let box = TaskBox()
        /* One end-to-end deadline for the whole call, redirect hops included.
           Darwin's `timeoutIntervalForResource` already behaves that way, but
           Foundation on Linux restarts its timers on every redirect hop, so
           the SDK enforces the budget itself and reports it as a timeout. */
        let timer: Task<Void, Never>? = deadline.map { seconds in
            Task {
                try? await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
                if !Task.isCancelled { box.expire() }
            }
        }
        defer { timer?.cancel() }
        do {
            return try await withTaskCancellationHandler {
                try await withCheckedThrowingContinuation {
                    (continuation: CheckedContinuation<(Data, URLResponse, URLSessionTask), Error>) in
                    let task = session.dataTask(with: request) { data, response, error in
                        if let error = error {
                            /* A body URLSession could not decode arrived with a
                               response; keep that response so the caller can
                               report its real status code. */
                            if let urlError = error as? URLError,
                               urlError.code == .cannotDecodeContentData
                                || urlError.code == .cannotDecodeRawData,
                               let http = (response ?? box.current?.response) as? HTTPURLResponse {
                                continuation.resume(throwing: UndecodableBody(response: http, urlError: urlError))
                                return
                            }
                            continuation.resume(throwing: error)
                            return
                        }
                        guard let data = data, let response = response, let task = box.current else {
                            continuation.resume(throwing: URLError(.badServerResponse))
                            return
                        }
                        continuation.resume(returning: (data, response, task))
                    }
                    /* A caller-supplied session has no SDK delegate of its own, so
                       the SDK's redirect rules ride on the task itself. */
                    if let taskDelegate = taskDelegate {
                        task.delegate = taskDelegate
                    }
                    /* A task that is never resumed never calls its completion
                       handler, so resuming the continuation here is the only
                       resume on this path. */
                    guard box.install(task) else {
                        continuation.resume(throwing: CancellationError())
                        return
                    }
                    task.resume()
                }
            } onCancel: {
                box.cancel()
            }
        } catch let urlError as URLError where urlError.code == .cancelled && box.didExpire {
            throw URLError(.timedOut, userInfo: [NSUnderlyingErrorKey: urlError])
        } catch is CancellationError where box.didExpire {
            throw URLError(.timedOut)
        }
    }

    /* `internal` rather than `private` so the tests can assert that the one
     * `timeout` knob arms BOTH of URLSession's deadlines, and that each of
     * them surfaces as NetworkTimeoutError rather than as a bare
     * NetworkError. */
    static func buildSession(_ opts: TransportOptions) throws -> (URLSession, SessionDelegate?) {
        let config = URLSessionConfiguration.default

        /* Stateless, like the other SDKs: URLSessionConfiguration.default keeps
         * a process-wide cookie jar (replaying every Set-Cookie on later calls,
         * across clients) and answers GETs from URLCache.shared without
         * reaching the server. Neither is wanted in an API client. */
        config.httpCookieStorage = nil
        config.httpShouldSetCookies = false
        config.urlCache = nil
        config.requestCachePolicy = .reloadIgnoringLocalCacheData

        /* URLSession has two deadlines: `timeoutIntervalForRequest` is the
         * idle timer between bytes, `timeoutIntervalForResource` the total
         * budget for the whole transfer. Both are armed from the single
         * `timeout` option, and both expire as `URLError.timedOut`, so an
         * expired deadline is a NetworkTimeoutError whichever timer fired. */
        if let timeout = opts.timeout {
            let seconds = TimeInterval(timeout) / 1000.0
            config.timeoutIntervalForRequest = seconds
            config.timeoutIntervalForResource = seconds
        }

#if os(Linux)
        if opts.proxy != nil {
            throw ConfigurationError.invalidProxy(DefaultApiClient.proxyUnsupportedMessage)
        }
        /* swift-corelibs-foundation never surfaces a server-trust challenge, so
         * the delegate cannot disable verification or pin a CA here. Refuse
         * rather than silently use the system trust store. */
        if !opts.verifySsl || opts.caCertPath != nil {
            throw ConfigurationError.invalidCACertificate(DefaultApiClient.tlsOptionsUnsupportedMessage)
        }
#else
        if let proxy = opts.proxy {
            config.connectionProxyDictionary = proxyConnectionDictionary(proxy)
        } else {
            /* No proxy unless `TransportOptions.proxy` is set: an empty
             * dictionary switches the system proxy settings off. */
            config.connectionProxyDictionary = [:]
        }
#endif

        /* A session delegate is used when SSL verification is disabled, a
         * custom CA certificate is configured, or redirect control is
         * needed. We always need the delegate to strip sensitive
         * headers on cross-origin redirects, so it is created
         * unconditionally when followRedirects is enabled. */
        let needsDelegate = !opts.verifySsl
            || opts.caCertPath != nil
            || !opts.followRedirects
            || opts.maxRedirects != nil
            || opts.followRedirects
        if needsDelegate {
            let delegate = SessionDelegate(
                verifySsl: opts.verifySsl,
                caCertPath: opts.caCertPath,
                followRedirects: opts.followRedirects,
                maxRedirects: opts.maxRedirects,
                proxyCredential: buildProxyCredential(opts.proxy)
            )
            return (URLSession(configuration: config, delegate: delegate, delegateQueue: nil), delegate)
        }

        return (URLSession(configuration: config), nil)
    }

    /// Builds the `connectionProxyDictionary` for a proxy URL. CFNetwork picks
    /// the proxy per TARGET scheme (the HTTP keys cover http:// requests, the
    /// HTTPS keys cover https:// requests), not per the proxy's own scheme, so
    /// both sets are filled in: otherwise an `http://` proxy would be bypassed
    /// by every https:// call.
    static func proxyConnectionDictionary(_ proxy: URL) -> [AnyHashable: Any] {
        let host = proxy.host ?? ""
        let port = proxy.port ?? (proxy.scheme?.lowercased() == "https" ? 443 : 80)
        return [
            "HTTPEnable": true,
            "HTTPProxy": host,
            "HTTPPort": port,
            "HTTPSEnable": true,
            "HTTPSProxy": host,
            "HTTPSPort": port,
        ]
    }

    /// Returns the session that does not follow any HTTP redirect; the 3xx
    /// response is returned to the caller as-is. Used for the OAuth2
    /// token-endpoint POST so a credential-bearing body is never silently
    /// replayed to a Location target — the token manager inspects and rejects
    /// the 3xx itself.
    ///
    /// Built once and reused, from a copy of the primary session's
    /// configuration, so token calls go through the same proxy, timeouts and
    /// stateless settings (and any registered URLProtocol classes) as every
    /// other request, and reuse one connection pool. ``close()`` invalidates
    /// it.
    func noRedirectSession() -> URLSession {
        noRedirectLock.lock()
        defer { noRedirectLock.unlock() }
        if let existing = noRedirectSessionStorage {
            return existing
        }
        let delegate = SessionDelegate(
            verifySsl: transportOptions.verifySsl,
            caCertPath: transportOptions.caCertPath,
            followRedirects: false,
            maxRedirects: 0,
            proxyCredential: proxyCredential
        )
        let created = URLSession(
            configuration: session.configuration, delegate: delegate, delegateQueue: nil)
        noRedirectSessionStorage = created
        return created
    }

    /// Whether the SDK's redirect rules (credential stripping, scheme and
    /// downgrade refusal, hop cap) are applied to this client's requests.
    var appliesRedirectRules: Bool {
        return sessionDelegate != nil
    }

    /// The error a request raises once the client is closed.
    static let closedError = ConfigurationError.invalidState(
        "ApiClient has been closed and can no longer send requests")

    /// Whether ``close()`` has been called.
    var isClosed: Bool {
        return lifecycle.isClosed
    }

    /// Whether the session this client built has been released. It is false
    /// while a request is still in flight after ``close()``, and stays false
    /// for a client built over a caller-supplied session, which is never
    /// released.
    var isTransportReleased: Bool {
        return lifecycle.isReleased && ownsSession
    }

    /// Closes the client. It is graceful and idempotent.
    ///
    /// This marks the client closed at once: a request sent afterwards throws
    /// ``ConfigurationError/invalidState(_:)`` rather than a foreign URLSession
    /// invalidation exception. A request already in flight finishes, retries
    /// and token refreshes included, and the URLSession the SDK built is
    /// released (`finishTasksAndInvalidate()`) when the last of them ends, or
    /// at once when none is running. A second call does nothing. A session
    /// supplied through ``TransportOptionsBuilder/session(_:)`` belongs to the
    /// caller and is left untouched.
    public func close() {
        if lifecycle.close() {
            releaseTransport()
        }
    }

    /// Releases the connection pools and delegate queues this client built.
    private func releaseTransport() {
        if ownsSession {
            session.finishTasksAndInvalidate()
        }
        noRedirectLock.lock()
        noRedirectSessionStorage?.finishTasksAndInvalidate()
        noRedirectLock.unlock()
        lifecycle.markReleased()
    }
}

/// URLSession delegate that handles custom TLS trust evaluation and redirect control.
///
/// When a custom CA certificate path is set, the delegate loads the certificate
/// from disk and evaluates the server trust against it. When SSL verification
/// is disabled, the delegate accepts all server certificates unconditionally.
///
/// When ``followRedirects`` is false, the delegate stops all HTTP 3xx redirects.
/// When ``maxRedirects`` is set, the delegate limits the number of consecutive
/// redirects before stopping. A value of 0 means no redirects are followed.
/* `internal` rather than file-private so `buildSession` — which the tests
 * call to prove both of URLSession's deadlines are armed — can name it in its
 * return type. Nothing here is public. */
final class SessionDelegate: NSObject, URLSessionDelegate, URLSessionTaskDelegate, @unchecked Sendable {
    private let verifySsl: Bool
    private let caCertPath: String?
    private let followRedirects: Bool
    private let maxRedirects: Int?
    /* The SDK's own proxy credential, offered only to the proxy's own
     * authentication challenge (never written into a request, so it never
     * reaches an origin, redirect hops included). */
    private let proxyCredential: URLCredential?
    /* Redirect counting and the redirect-refusal error are scoped PER
       URLSessionTask, not per delegate instance. One ``SessionDelegate`` backs
       a single ``URLSession`` that is shared across every request a client
       makes, so storing the hop count / refusal error on the delegate would
       let two CONCURRENT requests corrupt each other's redirect handling — one
       request's redirects would inflate the other's count, or a refusal from
       one would surface on the other. Keying both by the task's
       ``URLSessionTask/taskIdentifier`` (unique within the session, never
       reused the way a deallocated task's address can be) isolates each
       request; entries are cleared when the
       call side takes the error (or, for the count, when the task completes via
       `didCompleteWithError`). */
    private let redirectCounts = LockedTaskCounters()
    /* Records a redirect-refusal reason (too many redirects, non-HTTP(S)
       Location scheme, HTTPS->HTTP body-replay downgrade) so that
       `sendRequest` can surface it as a typed ``ApiError`` instead of
       silently returning the last 3xx response. The URLSession redirect
       delegate can only stop a redirect by passing `nil` to its completion
       handler — it cannot throw — so the error is stashed (keyed by task) and
       re-raised on the call side once that task completes. */
    private let redirectErrors = LockedTaskErrors()

    init(
        verifySsl: Bool, caCertPath: String?, followRedirects: Bool, maxRedirects: Int?,
        proxyCredential: URLCredential? = nil
    ) {
        self.verifySsl = verifySsl
        self.caCertPath = caCertPath
        self.followRedirects = followRedirects
        self.maxRedirects = maxRedirects
        self.proxyCredential = proxyCredential
        super.init()
    }

    /// Returns and clears the redirect-refusal error recorded for the given
    /// task, if any. Scoped to a single request so a sibling request's refusal
    /// never surfaces on this one.
    func takeRedirectError(for task: URLSessionTask) -> ApiError? {
        /* The call side also drops the hop count here: a task created with a
           completion handler is not guaranteed a `didCompleteWithError`
           callback, and a leaked count would otherwise follow the key. */
        redirectCounts.clear(for: task.taskIdentifier)
        return redirectErrors.take(for: task.taskIdentifier)
    }

    /// Answers the proxy's authentication challenge with the credential taken
    /// from the proxy URL; any other challenge keeps the default handling.
    func urlSession(
        _ session: URLSession,
        task: URLSessionTask,
        didReceive challenge: URLAuthenticationChallenge,
        completionHandler: @escaping (URLSession.AuthChallengeDisposition, URLCredential?) -> Void
    ) {
        let answer = DefaultApiClient.proxyChallengeDisposition(
            isProxy: challenge.protectionSpace.isProxy(),
            previousFailureCount: challenge.previousFailureCount,
            credential: proxyCredential)
        completionHandler(answer.disposition, answer.credential)
    }

#if canImport(Security)
    func urlSession(
        _ session: URLSession,
        didReceive challenge: URLAuthenticationChallenge,
        completionHandler: @escaping (URLSession.AuthChallengeDisposition, URLCredential?) -> Void
    ) {
        guard challenge.protectionSpace.authenticationMethod == NSURLAuthenticationMethodServerTrust,
              let serverTrust = challenge.protectionSpace.serverTrust else {
            completionHandler(.performDefaultHandling, nil)
            return
        }

        /* When SSL verification is disabled, accept any certificate. */
        if !verifySsl {
            completionHandler(.useCredential, URLCredential(trust: serverTrust))
            return
        }

        /* When a custom CA certificate path is configured, load every
         * certificate in the file (PEM or DER) and set them as the only anchors
         * for trust evaluation. */
        if let path = caCertPath {
            guard let certData = try? Data(contentsOf: URL(fileURLWithPath: path)) else {
                completionHandler(.cancelAuthenticationChallenge, nil)
                return
            }
            let certificates = DefaultApiClient.parseCaCertificates(certData).compactMap {
                SecCertificateCreateWithData(nil, $0 as CFData)
            }
            if certificates.isEmpty {
                completionHandler(.cancelAuthenticationChallenge, nil)
                return
            }

            SecTrustSetAnchorCertificates(serverTrust, certificates as CFArray)
            SecTrustSetAnchorCertificatesOnly(serverTrust, true)

            var error: CFError?
            if SecTrustEvaluateWithError(serverTrust, &error) {
                completionHandler(.useCredential, URLCredential(trust: serverTrust))
            } else {
                completionHandler(.cancelAuthenticationChallenge, nil)
            }
            return
        }

        completionHandler(.performDefaultHandling, nil)
    }
#endif

    func urlSession(
        _ session: URLSession,
        task: URLSessionTask,
        willPerformHTTPRedirection response: HTTPURLResponse,
        newRequest request: URLRequest,
        completionHandler: @escaping (URLRequest?) -> Void
    ) {
        if !followRedirects {
            completionHandler(nil)
            return
        }
        /* Cap at the caller-configured limit, falling back to the
           unified 20-hop default across all 12 SDKs. URLSession otherwise
           follows up to its built-in cap of 16, but the explicit cap
           makes the limit observable and consistent across languages. */
        let limit = maxRedirects ?? 20
        let taskKey = task.taskIdentifier
        let count = redirectCounts.increment(for: taskKey)
        if count > limit {
            /* Surface redirect exhaustion as a typed error rather than
               silently returning the last 3xx response. */
            redirectErrors.set(ApiError(
                statusCode: response.statusCode,
                message: DefaultApiClient.tooManyRedirectsMessage(limit: limit),
                responseHeaders: DefaultApiClient.lowercasedHeaders(of: response)
            ), for: taskKey)
            completionHandler(nil)
            return
        }
        /* Refuse non-HTTP(S) redirect schemes (javascript:, file:, data:,
         * etc.). URLSession will hand the proposed request to this delegate
         * with whatever scheme the server returned in Location; a malicious
         * or misconfigured server could otherwise steer the client at a
         * local-file or scripting URL. The refusal is surfaced as a typed
         * error instead of silently returning the 3xx. */
        guard let scheme = request.url?.scheme?.lowercased(),
            scheme == "http" || scheme == "https"
        else {
            redirectErrors.set(ApiError(
                statusCode: response.statusCode,
                message: DefaultApiClient.nonHttpRedirectMessage(
                    next: request.url?.absoluteString ?? "<unknown>"),
                responseHeaders: DefaultApiClient.lowercasedHeaders(of: response)
            ), for: taskKey)
            completionHandler(nil)
            return
        }
        /* URLSession re-sends Authorization / Cookie /
         * Proxy-Authorization across cross-origin 3xx redirects by
         * default, which leaks bearer tokens to attacker-controlled
         * hosts via malicious 302. Strip these headers when the next
         * request's origin (scheme + host + port) differs from the
         * originating request's origin.
         *
         * The strip-set is extended at codegen time with
         * every `type=apiKey, in=header` scheme declared in the
         * OpenAPI spec, so app-specific credential headers
         * (X-API-Key, X-Internal-Token, …) are also stripped on
         * cross-origin hops alongside the RFC-defined three. */
        var redirectRequest = request
        if let originalURL = task.originalRequest?.url,
           let nextURL = request.url,
           !DefaultApiClient.sameOrigin(originalURL, nextURL) {
            let sensitiveNames = (redirectRequest.allHTTPHeaderFields ?? [:]).keys.filter {
                DefaultApiClient.isSensitiveRedirectHeader($0)
            }
            for name in sensitiveNames {
                redirectRequest.setValue(nil, forHTTPHeaderField: name)
            }
        }

        /* Whether this hop sent a real body, read before the follow-up is
         * rewritten below: a 301 or 302 POST-to-GET rewrite drops the body. */
        let currentScheme = task.currentRequest?.url?.scheme?.lowercased()
        let nextScheme = request.url?.scheme?.lowercased()
        let originalBody = task.originalRequest?.httpBody
        let bodySent = !(originalBody ?? Data()).isEmpty || redirectRequest.httpBodyStream != nil

        /* RFC 9110 15.4: set the follow-up method explicitly instead of
         * trusting the platform. A kept method gets its body back, because
         * the platform drops it on any rewrite it applies. */
        let fromMethod = task.currentRequest?.httpMethod ?? task.originalRequest?.httpMethod ?? "GET"
        let toMethod = DefaultApiClient.redirectMethod(status: response.statusCode, method: fromMethod)
        redirectRequest.httpMethod = toMethod
        if toMethod.uppercased() != fromMethod.uppercased() {
            redirectRequest.httpBody = nil
            redirectRequest.httpBodyStream = nil
        } else if redirectRequest.httpBody == nil && redirectRequest.httpBodyStream == nil {
            redirectRequest.httpBody = task.originalRequest?.httpBody
        }

        /* Refuse to replay a request body across an
         * HTTPS -> HTTP transport downgrade. Replaying the body in
         * cleartext after the original was sent over TLS leaks
         * whatever the caller trusted to TLS to protect
         * (credentials, PII, signed tokens). Bodyless follow-ups
         * (303) are unaffected because URLSession clears httpBody for
         * those. A 301 or 302 that would turn a sent POST into a GET is
         * refused too, so the body is neither replayed nor silently dropped
         * across the downgrade. */
        /* Anchor on the CURRENT request (the hop that just received the
         * redirect, whose body would be replayed), not the original request:
         * an http -> https -> http chain downgrades on the final hop even
         * though the first request was already http, which an originalRequest
         * anchor would miss. */
        let downgrade = currentScheme == "https" && nextScheme == "http"
        let legacyRewrite = response.statusCode == 301 || response.statusCode == 302
        if (downgrade && legacyRewrite && bodySent) || DefaultApiClient.refusesBodyReplay(
            currentScheme: currentScheme, nextScheme: nextScheme,
            request: redirectRequest, originalBody: originalBody) {
            /* Surface the downgrade refusal as a typed error rather than
               silently returning the 3xx response. */
            redirectErrors.set(ApiError(
                statusCode: response.statusCode,
                message: DefaultApiClient.bodyReplayMessage(
                    current: task.currentRequest?.url?.absoluteString ?? "<unknown>",
                    next: request.url?.absoluteString ?? "<unknown>"),
                responseHeaders: DefaultApiClient.lowercasedHeaders(of: response)
            ), for: taskKey)
            completionHandler(nil)
            return
        }

        /* When the server returned 303 the spec requires
         * a GET with no body. URLSession coerces the method to GET
         * but does not always strip a stale `Content-Length: N`
         * carried over from the original POST/PUT/PATCH, which
         * leaves a now-empty GET claiming a non-zero body length
         * and causes some servers (NGINX, AWS ALB) to either
         * 400/411 or hang waiting for bytes that will never come. */
        /* Strip the stale body headers whenever the follow-up request
         * carries no body — a 303, or the historical 301/302 POST->GET
         * demotion where URLSession drops the body. Keying on "body is now
         * empty" (not statusCode == 303) matches the canonical predicate the
         * other manual-redirect SDKs use, so Swift no longer leaves a
         * bodyless GET claiming a non-zero Content-Length on 301/302. */
        if redirectRequest.httpBody == nil && redirectRequest.httpBodyStream == nil {
            redirectRequest.setValue(nil, forHTTPHeaderField: "Content-Length")
            redirectRequest.setValue(nil, forHTTPHeaderField: "Content-Type")
        }

        completionHandler(redirectRequest)
    }

    /// Drops this task's per-task redirect hop count once the task finishes.
    ///
    /// The refusal-error slot is cleared by the call side via
    /// `takeRedirectError(for:)`; the hop count has no such reader on the happy
    /// path (a redirect chain that never refuses), so it is pruned here to keep
    /// the per-task counter map from growing for the lifetime of the shared
    /// session.
    func urlSession(
        _ session: URLSession,
        task: URLSessionTask,
        didCompleteWithError error: Error?
    ) {
        redirectCounts.clear(for: task.taskIdentifier)
    }
}

extension DefaultApiClient {
    /// Whether a redirect must be refused because it would replay a request
    /// body over an HTTPS -> HTTP downgrade. Only a REAL body counts: the
    /// explicit empty `Data()` this client attaches to a body-less
    /// POST/PUT/PATCH (to force `Content-Length: 0`) carries nothing to leak,
    /// so such a request follows the redirect like the other SDKs.
    static func refusesBodyReplay(
        currentScheme: String?, nextScheme: String?, request: URLRequest, originalBody: Data?
    ) -> Bool {
        guard currentScheme == "https", nextScheme == "http" else { return false }
        if let body = request.httpBody {
            return !body.isEmpty
        }
        if request.httpBodyStream != nil {
            return originalBody?.isEmpty != true
        }
        return false
    }

    /// Header names that MUST NOT be replayed across a cross-origin
    /// 3xx redirect. The base set is the RFC-defined credential
    /// triple; the trailing entries are app-specific `apiKey-in-header`
    /// scheme names extracted from the OpenAPI spec at codegen time.
    /// Comparisons are case-insensitive — the redirect
    /// handler routes through `URLRequest.setValue(nil, forHTTPHeaderField:)`
    /// which is itself case-insensitive on header names.
    static let sensitiveRedirectHeaders: [String] = [
        "Authorization",
        "Cookie",
        "Proxy-Authorization",{{#apiKeyHeaderNames}}
        "{{#lambda.swiftString}}{{{name}}}{{/lambda.swiftString}}",{{/apiKeyHeaderNames}}
    ]

    /// Whether a header must not leave the origin on a redirect: one named in
    /// ``sensitiveRedirectHeaders``, or any header whose name contains `key`,
    /// `token` or `secret` (the rule the string forms of `Configuration` and
    /// `TransportOptions` use to redact a credential). A default header or a
    /// custom authenticator's header is covered without being listed.
    static func isSensitiveRedirectHeader(_ name: String) -> Bool {
        let lower = name.lowercased()
        if sensitiveRedirectHeaders.contains(where: { $0.lowercased() == lower }) {
            return true
        }
        return lower.contains("key") || lower.contains("token") || lower.contains("secret")
    }

    /// The message for a redirect chain longer than the hop cap.
    static func tooManyRedirectsMessage(limit: Int) -> String {
        return "Too many redirects (exceeded \(limit))"
    }

    /// The message for a redirect whose Location is not an http or https URL.
    static func nonHttpRedirectMessage(next: String) -> String {
        return "Refusing to follow redirect to non-HTTP(S) URL: \(next)"
    }

    /// The message for a redirect that would replay a request body over a
    /// downgrade from HTTPS to HTTP.
    static func bodyReplayMessage(current: String, next: String) -> String {
        return "Refusing to replay request body across HTTPS->HTTP redirect: \(current) -> \(next)"
    }

    /// The method of the follow-up request for a redirect (RFC 9110 15.4):
    /// 301 and 302 turn only POST into GET, 303 turns everything except HEAD
    /// into GET, and 307, 308 and every other status keep the method.
    static func redirectMethod(status: Int, method: String) -> String {
        let upper = method.uppercased()
        switch status {
        case 301, 302:
            return upper == "POST" ? "GET" : method
        case 303:
            return upper == "HEAD" ? method : "GET"
        default:
            return method
        }
    }

    /* Lower-cased response headers, shared by the normal response path, the
       undecodable-body error and the redirect refusals, so every ApiError for
       a response that arrived carries the real headers (nil means no response
       arrived). */
    static func lowercasedHeaders(of httpResponse: HTTPURLResponse) -> [String: String] {
        var headers: [String: String] = [:]
        for key in httpResponse.allHeaderFields.keys {
            guard let k = key as? String else { continue }
            if let joined = httpResponse.value(forHTTPHeaderField: k) {
                headers[k.lowercased()] = joined
            } else if let v = httpResponse.allHeaderFields[key] as? String {
                headers[k.lowercased()] = v
            }
        }
        return headers
    }

    /// Compare two URLs by scheme + host + effective port.
    static func sameOrigin(_ a: URL, _ b: URL) -> Bool {
        guard let sa = a.scheme?.lowercased(),
              let sb = b.scheme?.lowercased(),
              sa == sb else { return false }
        guard let ha = a.host?.lowercased(),
              let hb = b.host?.lowercased(),
              ha == hb else { return false }
        let portA = a.port ?? (sa == "https" ? 443 : 80)
        let portB = b.port ?? (sb == "https" ? 443 : 80)
        return portA == portB
    }
}

/// Thread-safe close lifecycle of a ``DefaultApiClient``: whether it is closed,
/// how many requests are in flight, and whether its transport has been released.
private final class ClientLifecycle: @unchecked Sendable {
    private var closed = false
    private var inFlight = 0
    private var released = false
    private let lock = NSLock()

    var isClosed: Bool {
        lock.withLock { closed }
    }

    var isReleased: Bool {
        lock.withLock { released }
    }

    /// Counts a request in. False, with nothing counted, once the client is closed.
    func enter() -> Bool {
        lock.withLock {
            if closed { return false }
            inFlight += 1
            return true
        }
    }

    /// Counts a request out. True when the client is closed and this was the
    /// last request in flight, so the caller releases the transport.
    func leave() -> Bool {
        lock.withLock {
            inFlight -= 1
            return closed && inFlight == 0
        }
    }

    /// Marks the client closed. True only on the first call and only when no
    /// request is in flight, so the caller releases the transport now; the
    /// last request in flight releases it otherwise.
    func close() -> Bool {
        lock.withLock {
            if closed { return false }
            closed = true
            return inFlight == 0
        }
    }

    func markReleased() {
        lock.withLock { released = true }
    }
}

/// Thread-safe PER-TASK redirect hop counter used by ``SessionDelegate``.
///
/// One ``SessionDelegate`` backs a single ``URLSession`` shared across every
/// request a client makes, so the hop count MUST be scoped to the individual
/// ``URLSessionTask`` (keyed by its ``URLSessionTask/taskIdentifier``) rather than stored as
/// a single shared integer. A shared counter would let two concurrent requests
/// inflate each other's redirect count and trip the limit spuriously. Entries
/// are removed when the task completes (`didCompleteWithError`).
private final class LockedTaskCounters: @unchecked Sendable {
    private var counts: [Int: Int] = [:]
    private let lock = NSLock()

    /// Increments and returns this task's hop count.
    func increment(for key: Int) -> Int {
        lock.withLock {
            let next = (counts[key] ?? 0) + 1
            counts[key] = next
            return next
        }
    }

    /// Drops this task's entry once the task has finished.
    func clear(for key: Int) {
        lock.withLock { counts[key] = nil }
    }
}

/// Thread-safe PER-TASK store for a redirect-refusal ``ApiError`` recorded
/// inside the (non-throwing) URLSession redirect delegate and re-raised on the
/// call side by ``DefaultApiClient/sendRequest(method:url:headers:body:noRedirect:)``.
///
/// Keyed by the ``URLSessionTask``'s ``URLSessionTask/taskIdentifier`` so a refusal recorded
/// for one in-flight request can never surface on a concurrent sibling request
/// sharing the same delegate/session. The call side `take(for:)`s its own
/// task's error, which also removes the entry.
private final class LockedTaskErrors: @unchecked Sendable {
    private var errors: [Int: ApiError] = [:]
    private let lock = NSLock()

    func set(_ error: ApiError, for key: Int) {
        lock.withLock { errors[key] = error }
    }

    /// Returns this task's stored error and clears its slot.
    func take(for key: Int) -> ApiError? {
        lock.withLock {
            let v = errors[key]
            errors[key] = nil
            return v
        }
    }
}
