import Foundation

/// What a ``DefaultApiClient`` hands the ``ByteStream`` that wraps its body: the
/// hooks that keep the transfer from outrunning its reader and that report why it
/// was cut short. A response built by a custom transport has none.
protocol StreamFlowControl: AnyObject, Sendable {
    /// The error that ended the stream from outside (the client was closed, the
    /// body stalled), or nil while it is open or was closed by its reader.
    var abortFailure: Error? { get }
    /// The reader starts waiting for the next chunk.
    func willRead()
    /// The reader took a chunk of `bytes` bytes.
    func didRead(bytes: Int)
}

/// An HTTP response whose body has not been read yet: the status code, the
/// lower-cased headers and the open body. It is what
/// ``ApiClient/sendStreaming(method:url:headers:body:timeout:maxRetries:idleTimeout:)``
/// returns. The caller owns the body and must close it; closing aborts the
/// connection instead of draining it.
///
/// A non-2xx response is returned like any other, with its body open; a caller
/// that does not want it reads a bounded part with
/// ``readBounded(maxBytes:)`` or closes it.
public final class ApiStreamResponse: @unchecked Sendable {
    /// The HTTP status code.
    public let statusCode: Int

    /// The response headers, with lower-cased names.
    public let headers: [String: String]

    /// The open body, decoded when the server compressed it. A failure after
    /// the headers ends the sequence with an error; `nil` from `next()` is the
    /// end of the body.
    public let body: AsyncThrowingStream<Data, Error>

    private let abort: @Sendable () -> Void
    let control: StreamFlowControl?
    private let lock = NSLock()
    private var closed = false

    /// Creates a response.
    ///
    /// - Parameters:
    ///   - statusCode: The HTTP status code.
    ///   - headers: The response headers, lower-cased.
    ///   - body: The open body.
    ///   - close: Aborts the connection; called once, however often ``close()`` is.
    public convenience init(
        statusCode: Int, headers: [String: String], body: AsyncThrowingStream<Data, Error>,
        close: @escaping @Sendable () -> Void
    ) {
        self.init(statusCode: statusCode, headers: headers, body: body, close: close, control: nil)
    }

    init(
        statusCode: Int, headers: [String: String], body: AsyncThrowingStream<Data, Error>,
        close: @escaping @Sendable () -> Void, control: StreamFlowControl?
    ) {
        self.statusCode = statusCode
        self.headers = headers
        self.body = body
        self.abort = close
        self.control = control
    }

    /// Closes the body, which aborts the connection. A second call does nothing.
    public func close() {
        let first: Bool = lock.withLock {
            if closed { return false }
            closed = true
            return true
        }
        if first { abort() }
    }

    /// Whether ``close()`` has been called.
    var isClosed: Bool {
        lock.withLock { closed }
    }

    /// Takes the next chunk of the body through `iterator`, telling the transfer
    /// that the reader is waiting and then that it took the chunk.
    func nextChunk(_ iterator: inout AsyncThrowingStream<Data, Error>.AsyncIterator) async throws
        -> Data?
    {
        if let failure = control?.abortFailure { throw failure }
        control?.willRead()
        let chunk = try await iterator.next()
        control?.didRead(bytes: chunk?.count ?? 0)
        if chunk == nil, let failure = control?.abortFailure { throw failure }
        return chunk
    }

    /// Reads at most `maxBytes` of the body, closes it and returns the result as
    /// a buffered response, so the same typed error as a buffered call can be
    /// raised from it. The body text is decoded for a text content type and is
    /// Base64 text otherwise, as a buffered response is.
    ///
    /// - Parameter maxBytes: The most bytes to read.
    /// - Returns: The buffered response.
    public func readBounded(maxBytes: Int) async -> ApiHttpResponse {
        var collected = Data()
        var iterator = body.makeAsyncIterator()
        while collected.count < maxBytes {
            guard let chunk = try? await nextChunk(&iterator) else { break }
            collected.append(chunk.prefix(maxBytes - collected.count))
        }
        close()
        let contentType = headers["content-type"] ?? ""
        let text =
            DefaultApiClient.isTextContentType(contentType)
            ? DefaultApiClient.decodeText(collected, contentType: contentType)
            : collected.base64EncodedString()
        return ApiHttpResponse(statusCode: statusCode, body: text, headers: headers)
    }
}

extension ApiStreamResponse: CustomStringConvertible, CustomDebugStringConvertible {
    /// The response by its status only; the headers and the body are never shown.
    public var description: String {
        return "ApiStreamResponse(statusCode: \(statusCode))"
    }

    /// The same text as ``description``.
    public var debugDescription: String {
        description
    }
}
