import XCTest
@testable import {{packageName}}

final class OAuth2ImplicitAuthenticatorTests: XCTestCase {

    private func createAuthenticator() -> OAuth2ImplicitAuthenticator {
        return OAuth2ImplicitAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            authorizationURL: "https://auth.example.com/authorize",
            scopes: ["read", "write"]
        )
    }

    // MARK: - Tests

    func testBuildsURLWithResponseTypeToken() {
        let auth = createAuthenticator()

        let url = auth.buildAuthorizationURL()

        XCTAssertTrue(url.contains("response_type=token"))
        XCTAssertTrue(url.hasPrefix("https://auth.example.com/authorize?"))
    }

    func testBuildsURLWithClientId() {
        let auth = createAuthenticator()

        let url = auth.buildAuthorizationURL()

        XCTAssertTrue(url.contains("client_id=my-client-id"))
    }

    func testBuildsURLWithScopes() {
        let auth = createAuthenticator()

        let url = auth.buildAuthorizationURL()

        XCTAssertTrue(url.contains("scope=read%20write"))
    }

    func testBuildsURLWithState() {
        let auth = createAuthenticator()

        let url = auth.buildAuthorizationURL(state: "my-state")

        XCTAssertTrue(url.contains("state=my-state"))
    }

    func testGetAuthHeadersReturnsBearerAfterSetAccessToken() {
        let auth = createAuthenticator()
        auth.setAccessToken("implicit-tok")

        let headers = auth.authHeaders()

        XCTAssertEqual(headers["Authorization"], "Bearer implicit-tok")
    }

    func testThrowsWhenAccessTokenNotSet() {
        let auth = createAuthenticator()

        // authHeaders() calls fatalError when no token is set.
        // We verify the authenticator is in unset state.
        XCTAssertEqual(auth.host(), "https://api.example.com")
        // Note: In Swift, fatalError cannot be caught in XCTest without a custom harness.
        // We verify the precondition state is correct.
    }

    func testGetHostReturnsConfiguredHost() {
        let auth = createAuthenticator()

        XCTAssertEqual(auth.host(), "https://api.example.com")
    }
}
