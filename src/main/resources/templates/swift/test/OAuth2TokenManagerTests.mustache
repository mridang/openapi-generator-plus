    @Test func testExpiresInNegativeSkipsCaching() async throws {
        // D1: a negative expires_in (e.g. -1) must mark the token as
        // immediately stale so the very next call refetches.
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"neg1\",\"expires_in\":-1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"neg2\",\"expires_in\":3600}"))

        let manager = OAuth2TokenManager()
        manager.setApiClient(client)

        let params = ["grant_type": "client_credentials"]
        let tokenURL = "https://auth.example.com/token"

        let first = try await manager.getAccessToken(tokenURL: tokenURL, params: params)
        let second = try await manager.getAccessToken(tokenURL: tokenURL, params: params)

        #expect(first == "neg1")
        #expect(second == "neg2")
    }

    /// Gap 3.2: the token POST MUST be marked noRedirect so the
    /// transport refuses to silently replay the credential-bearing
    /// body to a 307/308 Location target. The mock asserts that the
    /// flag arrives at the ApiClient.
    @Test func testTokenRequestSetsNoRedirect() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok-no-redir\",\"expires_in\":3600}"))

        let manager = OAuth2TokenManager()
        manager.setApiClient(client)

        _ = try await manager.getAccessToken(
            tokenURL: "https://auth.example.com/token",
            params: ["grant_type": "client_credentials"]
        )

        #expect(client.lastNoRedirect == true,
            "OAuth2TokenManager must request noRedirect=true on the token POST")
    }

    /// Gap 3.2: RFC 6749 §3.2 forbids redirects at the token endpoint. The
    /// manager must refuse the whole 300-399 range (302 and 307 both exercised
    /// here, plus 301/303/308) with an OAuth2TokenError rather than replaying
    /// the credential-bearing POST to the redirect target.
    @Test(arguments: [301, 302, 303, 307, 308])
    func testTokenEndpointRedirectIsRejected(status: Int) async {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "", statusCode: status))

        let manager = OAuth2TokenManager()
        manager.setApiClient(client)

        do {
            _ = try await manager.getAccessToken(
                tokenURL: "https://auth.example.com/token",
                params: ["grant_type": "client_credentials", "client_secret": "topsecret"]
            )
            Issue.record("Expected OAuth2TokenError for status \(status)")
        } catch let error as OAuth2TokenError {
            switch error {
            case .redirectRefused:
                break
            default:
                Issue.record("status \(status): expected .redirectRefused, got \(error)")
            }
        } catch {
            Issue.record("status \(status): expected OAuth2TokenError, got \(error)")
        }
    }

