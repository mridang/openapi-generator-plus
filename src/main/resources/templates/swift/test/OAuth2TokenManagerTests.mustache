            ])

        let fields = client.requests[0].body.split(separator: "&").map(String.init).sorted()
        #expect(
            fields == [
                "client_secret=a~b-c.d_e%2Af%21g%27h%28i%29j+k%2Bl%26m%3Dn%2Fo%25p",
