    /// Splits an application/x-www-form-urlencoded body into its decoded fields.
    private func formFields(_ body: String) -> [String: String] {
        var fields: [String: String] = [:]
        for pair in body.split(separator: "&") {
            let parts = pair.split(separator: "=", maxSplits: 1, omittingEmptySubsequences: false)
            let decode = { (s: Substring) -> String in
                s.replacingOccurrences(of: "+", with: " ").removingPercentEncoding ?? String(s)
            }
            fields[decode(parts[0])] = decode(parts.count > 1 ? parts[1] : "")
        }
        return fields
    }

    private let authorizationCodeGrant = [
        "grant_type": "authorization_code",
        "code": "auth-code",
        "client_id": "my-client",
        "client_secret": "my-secret",
    ]

    /* The refresh grant sends the cached refresh token and carries over only
     * the client credentials: the authorization code is single-use and must
     * not travel with it. */
    @Test func testRefreshGrantCarriesRefreshTokenAndClientCredentialsOnly() async throws {
        let client = MockApiClient()
        client.responses.append(
            makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))
        let manager = OAuth2TokenManager()
        manager.setApiClient(client)
        let tokenURL = "https://auth.example.com/token"

        _ = try await manager.getAccessToken(tokenURL: tokenURL, params: authorizationCodeGrant)
        let refreshed = try await manager.getAccessToken(tokenURL: tokenURL, params: authorizationCodeGrant)

        #expect(refreshed == "tok2")
        #expect(client.requests.count == 2)
        #expect(formFields(client.requests[0].body) == authorizationCodeGrant)
        #expect(
            formFields(client.requests[1].body) == [
                "grant_type": "refresh_token",
                "refresh_token": "ref1",
                "client_id": "my-client",
                "client_secret": "my-secret",
            ])
    }

    /* A refresh the server rejects is not fatal: the original grant is run
     * again, and the call only fails if that fails too. */
    @Test func testRejectedRefreshFallsBackToTheOriginalGrant() async throws {
        let client = MockApiClient()
        client.responses.append(
            makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"error\":\"invalid_grant\"}", statusCode: 400))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok3\",\"expires_in\":3600}"))
        let manager = OAuth2TokenManager()
        manager.setApiClient(client)
        let tokenURL = "https://auth.example.com/token"

        _ = try await manager.getAccessToken(tokenURL: tokenURL, params: authorizationCodeGrant)
        let token = try await manager.getAccessToken(tokenURL: tokenURL, params: authorizationCodeGrant)

        #expect(token == "tok3")
        #expect(client.requests.count == 3)
        #expect(formFields(client.requests[1].body)["grant_type"] == "refresh_token")
        #expect(formFields(client.requests[2].body) == authorizationCodeGrant)
    }

