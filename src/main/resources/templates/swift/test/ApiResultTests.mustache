{{>api_info}}
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class ApiResultTests {

    @Test func storesAllFields() {
        let result = ApiResult<String>(
            statusCode: 200,
            data: "payload",
            rawBody: "{\"value\":\"payload\"}",
            headers: ["Content-Type": "application/json"]
        )
        #expect(result.statusCode == 200)
        #expect(result.data == "payload")
        #expect(result.rawBody == "{\"value\":\"payload\"}")
        #expect(result.headers["Content-Type"] == "application/json")
    }

    @Test func dataMayBeNilForNoContent() {
        let result = ApiResult<String>(
            statusCode: 204,
            data: nil,
            rawBody: "",
            headers: [:]
        )
        #expect(result.statusCode == 204)
        #expect(result.data == nil)
        #expect(result.rawBody == "")
        #expect(result.headers.isEmpty)
    }

    @Test func preservesAllHeaders() {
        let result = ApiResult<Int>(
            statusCode: 200,
            data: 42,
            rawBody: "42",
            headers: ["X-Request-Id": "abc", "X-RateLimit-Remaining": "99"]
        )
        #expect(result.headers.count == 2)
        #expect(result.headers["X-Request-Id"] == "abc")
        #expect(result.headers["X-RateLimit-Remaining"] == "99")
    }
}
