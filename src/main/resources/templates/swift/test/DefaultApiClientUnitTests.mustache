        let resp = try await client.sendRequest(
            method: "POST", url: "http://localhost/echo",
            headers: ["Content-Type": "application/json"], body: #"{"key":"value"}"#)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("POST"))
        #expect(resp.body.contains("key"))
    }

    @Test func testReturnsResponseHeaders() async throws {
        let client = makeClient { _ in (self.body("ok"), 200, ["X-Test-Header": "test-value"]) }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/echo", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
        let value = resp.headers.first(where: { $0.key.lowercased() == "x-test-header" })?.value
        #expect(value == "test-value")
    }

