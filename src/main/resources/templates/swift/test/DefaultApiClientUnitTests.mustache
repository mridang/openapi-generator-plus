import XCTest
@testable import {{packageName}}

final class DefaultApiClientUnitTests: XCTestCase {

    func testUserAgentHeader() async throws {
        let transport = TransportOptionsBuilder()
            .userAgent("TestAgent/1.0")
            .build()
        let client = DefaultApiClient(transportOptions: transport)

        // Verify the transport options are applied
        XCTAssertEqual(transport.userAgent, "TestAgent/1.0")
    }

    func testDefaultUserAgent() async throws {
        let transport = TransportOptionsBuilder().build()
        XCTAssertFalse(transport.userAgent.isEmpty, "Expected non-empty default User-Agent")
    }

    func testXRequestIDInjection() async throws {
        let transport = TransportOptionsBuilder()
            .injectRequestID(true)
            .build()
        XCTAssertTrue(transport.injectRequestID)
    }

    func testXRequestIDNotInjectedWhenDisabled() async throws {
        let transport = TransportOptionsBuilder()
            .injectRequestID(false)
            .build()
        XCTAssertFalse(transport.injectRequestID)
    }

    func testDefaultHeaders() async throws {
        let transport = TransportOptionsBuilder()
            .defaultHeader(name: "X-Default", value: "default-value")
            .build()
        XCTAssertEqual(transport.defaultHeaders["X-Default"], "default-value")
    }

    func testCallerHeadersOverrideDefaults() async throws {
        let transport = TransportOptionsBuilder()
            .defaultHeader(name: "X-Default", value: "transport-value")
            .build()

        // In the actual merge logic, caller headers take priority
        var merged: [String: String] = [:]
        for (k, v) in transport.defaultHeaders {
            merged[k] = v
        }
        let callerHeaders = ["X-Default": "caller-value"]
        for (k, v) in callerHeaders {
            merged[k] = v
        }
        XCTAssertEqual(merged["X-Default"], "caller-value")
    }
}
