import XCTest
@testable import {{packageName}}

final class DefaultApiClientUnitTests: XCTestCase {

    // MARK: - Helpers

    private func makeClient(
        transport: TransportOptions? = nil,
        handler: @escaping (URLRequest) -> (Data, Int, [String: String])
    ) -> DefaultApiClient {
        let session = UnitStubURLProtocol.session(handler: handler)
        return DefaultApiClient(transportOptions: transport, session: session)
    }

    private func body(_ s: String = "{}") -> Data {
        Data(s.utf8)
    }

    // MARK: - User-Agent injection

    func testInjectsCustomUserAgent() async throws {
        var capturedUA: String?
        let transport = TransportOptionsBuilder().userAgent("MyApp/1.0").build()
        let client = makeClient(transport: transport) { req in
            capturedUA = req.value(forHTTPHeaderField: "User-Agent")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertEqual(capturedUA, "MyApp/1.0")
    }

    func testInjectsDefaultUserAgentWhenNotExplicitlySet() async throws {
        var capturedUA: String?
        let client = makeClient { req in
            capturedUA = req.value(forHTTPHeaderField: "User-Agent")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertNotNil(capturedUA)
        XCTAssertFalse(capturedUA!.isEmpty)
    }

    // MARK: - X-Request-ID injection

    func testInjectsRequestId() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertNotNil(capturedId)
        let uuidPattern = #"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"#
        XCTAssertNotNil(capturedId?.range(of: uuidPattern, options: .regularExpression))
    }

    func testDoesNotInjectRequestIdWhenDisabled() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(false).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertNil(capturedId)
    }

    func testDoesNotOverrideCallerRequestId() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test",
            headers: ["X-Request-ID": "caller-id"], body: nil)
        XCTAssertEqual(capturedId, "caller-id")
    }

    func testGeneratesUniqueRequestIds() async throws {
        var capturedIds: [String] = []
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            if let id = req.value(forHTTPHeaderField: "X-Request-ID") { capturedIds.append(id) }
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertEqual(capturedIds.count, 2)
        XCTAssertNotEqual(capturedIds[0], capturedIds[1])
    }

    // MARK: - Default headers

    func testIncludesTransportDefaultHeaders() async throws {
        var capturedValue: String?
        let transport = TransportOptionsBuilder().defaultHeader(name: "X-Custom", value: "custom-value").build()
        let client = makeClient(transport: transport) { req in
            capturedValue = req.value(forHTTPHeaderField: "X-Custom")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        XCTAssertEqual(capturedValue, "custom-value")
    }

    func testCallerHeadersOverrideDefaults() async throws {
        var capturedAccept: String?
        let transport = TransportOptionsBuilder().defaultHeader(name: "Accept", value: "text/plain").build()
        let client = makeClient(transport: transport) { req in
            capturedAccept = req.value(forHTTPHeaderField: "Accept")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test",
            headers: ["Accept": "application/json"], body: nil)
        XCTAssertEqual(capturedAccept, "application/json")
    }

    // MARK: - Basic HTTP

    func testSendsGetRequestAndReturnsResponse() async throws {
        let client = makeClient { _ in (self.body(#"{"method":"GET"}"#), 200, [:]) }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/echo", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 200)
        XCTAssertTrue(resp.body.contains("GET"))
    }

    func testSendsPostWithJsonBody() async throws {
        let client = makeClient { _ in (self.body(#"{"method":"POST","body":"key"}"#), 200, [:]) }
        let resp = try await client.sendRequest(
            method: "POST", url: "http://localhost/echo",
            headers: ["Content-Type": "application/json"], body: #"{"key":"value"}"#)
        XCTAssertEqual(resp.statusCode, 200)
        XCTAssertTrue(resp.body.contains("POST"))
        XCTAssertTrue(resp.body.contains("key"))
    }

    func testReturnsResponseHeaders() async throws {
        let client = makeClient { _ in (self.body("ok"), 200, ["X-Test-Header": "test-value"]) }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/echo", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 200)
        let value = resp.headers.first(where: { $0.key.lowercased() == "x-test-header" })?.value
        XCTAssertEqual(value, "test-value")
    }

    func testReturnsNon2xxStatusCode() async throws {
        let client = makeClient { _ in (self.body("not found"), 404, [:]) }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/not-found", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 404)
        XCTAssertEqual(resp.body, "not found")
    }

    func testSendsPutRequest() async throws {
        let client = makeClient { _ in (self.body(#"{"method":"PUT"}"#), 200, [:]) }
        let resp = try await client.sendRequest(method: "PUT", url: "http://localhost/echo", headers: [:], body: "update")
        XCTAssertEqual(resp.statusCode, 200)
        XCTAssertTrue(resp.body.contains("PUT"))
    }

    func testSendsDeleteRequest() async throws {
        let client = makeClient { _ in (self.body(#"{"method":"DELETE"}"#), 200, [:]) }
        let resp = try await client.sendRequest(method: "DELETE", url: "http://localhost/echo", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 200)
        XCTAssertTrue(resp.body.contains("DELETE"))
    }

    func testReturnsJsonBodyForVendorJsonContentType() async throws {
        let client = makeClient { _ in
            (self.body(#"{"format":"vendor"}"#), 200, ["Content-Type": "application/vnd.api+json"])
        }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/vendor-json", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 200)
        XCTAssertTrue(resp.body.contains("vendor"))
    }

    func testJoinsMultiValueResponseHeaders() async throws {
        let client = makeClient { _ in (self.body("ok"), 200, ["X-Custom-Value": "val1, val2"]) }
        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/multi-header", headers: [:], body: nil)
        XCTAssertEqual(resp.statusCode, 200)
        let value = resp.headers.first(where: { $0.key.lowercased() == "x-custom-value" })?.value
        XCTAssertTrue(value?.contains("val1") ?? false)
        XCTAssertTrue(value?.contains("val2") ?? false)
    }
}

// MARK: - URL Protocol stub for unit tests

private final class UnitStubURLProtocol: URLProtocol {
    nonisolated(unsafe) static var handler: ((URLRequest) -> (Data, Int, [String: String]))?

    static func session(handler: @escaping (URLRequest) -> (Data, Int, [String: String])) -> URLSession {
        self.handler = handler
        let config = URLSessionConfiguration.ephemeral
        config.protocolClasses = [UnitStubURLProtocol.self]
        return URLSession(configuration: config)
    }

    override class func canInit(with request: URLRequest) -> Bool { return true }
    override class func canonicalRequest(for request: URLRequest) -> URLRequest { return request }

    override func startLoading() {
        guard let handler = UnitStubURLProtocol.handler else {
            client?.urlProtocolDidFinishLoading(self)
            return
        }
        let (data, statusCode, headers) = handler(request)
        let response = HTTPURLResponse(
            url: request.url!,
            statusCode: statusCode,
            httpVersion: "HTTP/1.1",
            headerFields: headers
        )!
        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
        client?.urlProtocol(self, didLoad: data)
        client?.urlProtocolDidFinishLoading(self)
    }

    override func stopLoading() {}
}
