        let resp = try await client.sendRequest(method: "GET", url: "http://localhost/echo", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("GET"))
    }

    @Test func testSendsPostWithJsonBody() async throws {
