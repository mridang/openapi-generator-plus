#if !os(Linux)
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class DefaultApiClientUnitTests {

    // MARK: - Helpers

    private func makeClient(
        transport: TransportOptions? = nil,
        handler: @escaping (URLRequest) -> (Data, Int, [String: String])
    ) -> DefaultApiClient {
        let session = UnitStubURLProtocol.session(handler: handler)
        return DefaultApiClient(transportOptions: transport, session: session)
    }

    private func body(_ s: String = "{}") -> Data {
        Data(s.utf8)
    }

    // MARK: - User-Agent injection

    @Test func testInjectsCustomUserAgent() async throws {
        var capturedUA: String?
        let transport = TransportOptionsBuilder().userAgent("MyApp/1.0").build()
        let client = makeClient(transport: transport) { req in
            capturedUA = req.value(forHTTPHeaderField: "User-Agent")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedUA == "MyApp/1.0")
    }

    @Test func testInjectsDefaultUserAgentWhenNotExplicitlySet() async throws {
        var capturedUA: String?
        let client = makeClient { req in
            capturedUA = req.value(forHTTPHeaderField: "User-Agent")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedUA != nil)
        #expect(!(capturedUA!.isEmpty))
    }

    // MARK: - X-Request-ID injection

    @Test func testInjectsRequestId() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedId != nil)
        let uuidPattern = #"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"#
        #expect(capturedId?.range(of: uuidPattern, options: .regularExpression) != nil)
    }

    @Test func testDoesNotInjectRequestIdWhenDisabled() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(false).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedId == nil)
    }

    @Test func testDoesNotOverrideCallerRequestId() async throws {
        var capturedId: String?
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            capturedId = req.value(forHTTPHeaderField: "X-Request-ID")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test",
            headers: ["X-Request-ID": "caller-id"], body: nil)
        #expect(capturedId == "caller-id")
    }

    @Test func testGeneratesUniqueRequestIds() async throws {
        var capturedIds: [String] = []
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        let client = makeClient(transport: transport) { req in
            if let id = req.value(forHTTPHeaderField: "X-Request-ID") { capturedIds.append(id) }
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedIds.count == 2)
        #expect(capturedIds[0] != capturedIds[1])
    }

    // MARK: - Default headers

    @Test func testIncludesTransportDefaultHeaders() async throws {
        var capturedValue: String?
        let transport = TransportOptionsBuilder().defaultHeader(name: "X-Custom", value: "custom-value").build()
        let client = makeClient(transport: transport) { req in
            capturedValue = req.value(forHTTPHeaderField: "X-Custom")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test", headers: [:], body: nil)
        #expect(capturedValue == "custom-value")
    }

    @Test func testCallerHeadersOverrideDefaults() async throws {
        var capturedAccept: String?
        let transport = TransportOptionsBuilder().defaultHeader(name: "Accept", value: "text/plain").build()
        let client = makeClient(transport: transport) { req in
            capturedAccept = req.value(forHTTPHeaderField: "Accept")
            return (self.body(), 200, [:])
        }
        _ = try await client.sendRequest(method: "GET", url: "http://localhost/test",
            headers: ["Accept": "application/json"], body: nil)
        #expect(capturedAccept == "application/json")
    }

    // MARK: - Basic HTTP

    @Test func testSendsGetRequestAndReturnsResponse() async throws {
