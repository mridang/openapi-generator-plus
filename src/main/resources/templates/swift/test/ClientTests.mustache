    @Test func testBhvLifecycle008ClosedClientRejectsFurtherRequests() async throws {
        let client = try {{clientClassName}}(authenticator: authenticator)
        client.close()
        client.close()
        let error = await #expect(throws: ConfigurationError.self) {
            _ = try await client.pet.getPetById(petId: 1)
        }
        #expect(error == ConfigurationError.invalidState("ApiClient has been closed and can no longer send requests"))
