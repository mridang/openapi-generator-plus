/* Sets a header and counts how often it is started and finished. */
private final class ClientHook: CallHook, @unchecked Sendable {
    private let lock = NSLock()
    private var started = 0
    private var finished = 0

    var starts: Int { lock.withLock { started } }
    var finishes: Int { lock.withLock { finished } }

    func start(info: CallInfo, headers: inout [String: String]) throws -> (any CallObserver)? {
        lock.withLock { started += 1 }
        headers["X-Hook"] = "from-client"
        return Finisher(hook: self)
    }

    fileprivate func finish() {
        lock.withLock { finished += 1 }
    }

    private struct Finisher: CallObserver {
        let hook: ClientHook

        func finish(_ outcome: CallOutcome) throws {
            hook.finish()
        }
    }
}

/* A credential that records whether the client handed it a transport. */
private final class SchemeTransportProbe: BaseAuthenticator, HttpAwareAuthenticator, @unchecked Sendable {
    private let lock = NSLock()
    private var flag = false

    var received: Bool {
        lock.lock()
        defer { lock.unlock() }
        return flag
    }

    func setApiClient(_ client: ApiClient) {
        lock.lock()
        flag = true
        lock.unlock()
    }

    override func host() -> String { return "https://api.example.com" }
    override func authHeaders() async -> [String: String] { return [:] }
}

/* Answers every request with an empty JSON object and remembers the last one,
 * so a test can read the headers a call actually sent. */
private final class ClientStubProtocol: URLProtocol {
    private static let lock = NSLock()
    nonisolated(unsafe) private static var lastByHost: [String: URLRequest] = [:]

    static func session() -> URLSession {
        let config = URLSessionConfiguration.ephemeral
        config.protocolClasses = [ClientStubProtocol.self]
        return URLSession(configuration: config)
    }

    static func lastRequest(host: String) -> URLRequest? {
        lock.lock()
        defer { lock.unlock() }
        return lastByHost[host]
    }

    override class func canInit(with request: URLRequest) -> Bool { return true }
    override class func canonicalRequest(for request: URLRequest) -> URLRequest { return request }

    override func startLoading() {
        ClientStubProtocol.lock.lock()
        ClientStubProtocol.lastByHost[request.url?.host ?? ""] = request
        ClientStubProtocol.lock.unlock()
        let body = Data("{\"id\":1,\"name\":\"x\",\"photoUrls\":[]}".utf8)
        if let url = request.url,
            let response = HTTPURLResponse(
                url: url, statusCode: 200, httpVersion: "HTTP/1.1",
                headerFields: ["Content-Type": "application/json"])
        {
            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
            client?.urlProtocol(self, didLoad: body)
        }
        client?.urlProtocolDidFinishLoading(self)
    }

    override func stopLoading() {}
}

