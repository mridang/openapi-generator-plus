/* Records whether the session was invalidated, so a test can prove the
 * facade never closes a caller-supplied session. */
private final class InvalidationProbe: NSObject, URLSessionDelegate, @unchecked Sendable {
    private let lock = NSLock()
    private var flag = false

    var invalidated: Bool {
        lock.lock()
        defer { lock.unlock() }
        return flag
    }

    func urlSession(_ session: URLSession, didBecomeInvalidWithError error: Error?) {
        lock.lock()
        flag = true
        lock.unlock()
    }
}

@Suite final class ClientTests {

    private let authenticator: BearerAuthenticator = {
        // Constant host and token are known valid; build in do/catch so a
        // future change surfaces a clear message instead of an opaque force-try
        // crash.
        do {
            return try BearerAuthenticator(host: "{{{basePath}}}", token: "test-token")
        } catch {
            preconditionFailure("test BearerAuthenticator initialization failed: \(error)")
        }
    }()

    @Test func testConstructWithAuthenticatorOnly() throws {
        _ = try {{clientClassName}}(authenticator: authenticator)
    }

    @Test func testConstructWithAuthenticatorAndNilTransportOptions() throws {
        _ = try {{clientClassName}}(authenticator: authenticator, transportOptions: nil)
    }

    @Test func testClosedClientRejectsFurtherRequests() async throws {
        let client = try {{clientClassName}}(authenticator: authenticator)
        client.close()
        client.close()
        await #expect(throws: ConfigurationError.self) {
            _ = try await client.pet.getPetById(petId: 1)
        }
    }

    @Test func testCloseLeavesASuppliedSessionOpen() async throws {
        let probe = InvalidationProbe()
        let session = URLSession(configuration: .ephemeral, delegate: probe, delegateQueue: nil)
        let transport = try TransportOptionsBuilder().session(session).build()
        let client = try {{clientClassName}}(authenticator: authenticator, transportOptions: transport)
        client.close()
        try await Task.sleep(nanoseconds: 200_000_000)
        #expect(!probe.invalidated)
        session.invalidateAndCancel()
    }

    @Test func testConstructWithAuthenticatorAndTransportOptions() throws {
        let transport = try TransportOptionsBuilder().build()

        _ = try {{clientClassName}}(authenticator: authenticator, transportOptions: transport)
    }

    @Test func testApiKeyQueryAcceptsNonAscii() throws {
        // RFC 7230 §3.2.6 — ApiKeyAuthenticator's HEADER location rejects
        // anything outside printable ASCII + TAB (see
        // ApiKeyAuthenticatorTests); the non-header path must NOT validate
        // (it goes through URL-encoding downstream).
        let auth = try ApiKeyAuthenticator(host: "{{{basePath}}}", keyParamName: "api_key", apiKey: "kéy", location: .query)
        #expect(auth.queryParams() == ["api_key": "kéy"])
    }

    /* The token convenience initializer forwards the Bearer authenticator's
     * ConfigurationError.invalidArgument for a token that cannot be sent. */
    @Test(arguments: ["", "   ", "tok\r\nInjected: yes"])
    func testTokenInitializerRejectsInvalidToken(token: String) {
        let error = #expect(throws: ConfigurationError.self) {
            _ = try {{clientClassName}}(host: "{{{basePath}}}", accessToken: token)
        }
        guard case .invalidArgument? = error else {
            Issue.record("expected ConfigurationError.invalidArgument, got \(String(describing: error))")
            return
        }
    }

    @Test func testWithTokenFactoryBuildsAClientAndRejectsInvalidTokens() throws {
        _ = try {{clientClassName}}.withToken(host: "{{{basePath}}}", accessToken: "abc.def-123")
        _ = try {{clientClassName}}.withToken(
            host: "{{{basePath}}}", accessToken: "abc", transportOptions: try TransportOptionsBuilder().build())
        #expect(throws: ConfigurationError.self) {
            _ = try {{clientClassName}}.withToken(host: "{{{basePath}}}", accessToken: "")
        }
    }

    // bearer-no-empty-token-guard (F-A6-G1): the Bearer authenticator must
    // reject an empty or whitespace-only token at construction (it would
    // otherwise emit the literal header `Authorization: Bearer ` and send the
    // request effectively unauthenticated), mirroring the api-key
    // authenticator's existing empty-value guard. The rejection is covered by
    // BearerAuthenticatorTests; this test pins the boundary that MUST still
    // succeed: a non-empty token whose only
    // whitespace is internal/leading is accepted and emitted verbatim, so the
    // guard's `trimmingCharacters(...).isEmpty` check is asserted to be a
    // whitespace-ONLY rejection and not an over-eager "contains whitespace"
    // rejection that would break legitimate tokens.
    @Test func testBearerAcceptsNonEmptyTokenWithGuardInPlace() async throws {
        let auth = try BearerAuthenticator(host: "{{{basePath}}}", token: "abc.def-123")
        let headers = await auth.authHeaders()
        #expect(headers["Authorization"] == "Bearer abc.def-123")
    }

    /* Tests/Spec is where hand-written specs are kept, so the test target must
     * compile and run them; only the fixture data is left out of it. */
    @Test func testSpecDirectoryIsPartOfTheTestTarget() throws {
        let manifest = try String(
            contentsOf: URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
                .appendingPathComponent("Package.swift"),
            encoding: .utf8)
        let exclude = try #require(manifest.range(of: #"exclude: \[[^\]]*\]"#, options: .regularExpression))
        #expect(manifest[exclude].contains("\"Fixtures\""))
        #expect(!manifest[exclude].contains("\"Spec\""))
    }

    @Test func testApiGroupsAreAccessible() throws {
        let client = try {{clientClassName}}(authenticator: authenticator)

