import Foundation
import Testing
@testable import {{packageName}}

@Suite final class OAuth2PasswordAuthenticatorTests {

    // MARK: - Mock ApiClient

    private final class MockApiClient: ApiClient, @unchecked Sendable {
        var responses: [ApiHttpResponse] = []
        var lastMethod: String = ""
        var lastURL: String = ""
        var lastHeaders: [String: String] = [:]
        var lastBody: Data? = nil
        /// The URL of every request received, in order.
        var urls: [String] = []

        /// Satisfies the ApiClient requirement that carries no request options.
        func sendRequest(method: String, url: String, headers: [String: String], body: Any?)
            async throws -> ApiHttpResponse
        {
            try await sendRequest(
                method: method, url: url, headers: headers, body: body, noRedirect: false)
        }

        func sendRequest(method: String, url: String, headers: [String: String], body: Any?, noRedirect: Bool) async throws -> ApiHttpResponse {
            lastMethod = method
            lastURL = url
            urls.append(url)
            lastHeaders = headers
            lastBody = body as? Data
            return responses.removeFirst()
        }
    }

    private func makeResponse(body: String, statusCode: Int = 200) -> ApiHttpResponse {
        return ApiHttpResponse(statusCode: statusCode, body: body, headers: [:])
    }

    private func createAuthenticator() -> OAuth2PasswordAuthenticator {
        return OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            scopes: ["read", "write"]
        )
    }

    // MARK: - Tests

    @Test func testSendsPasswordGrantType() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.contains("grant_type=password"))
    }

    @Test func testSendsUsernameAndPassword() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.contains("username=testuser"))
        #expect(bodyString.contains("password=testpass"))
    }

    @Test func testSendsClientIdAndSecret() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.contains("client_id=my-client-id"))
        #expect(bodyString.contains("client_secret=my-client-secret"))
    }

    @Test func testReturnsAuthorizationBearerHeader() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok-pwd\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        let headers = try await auth.authHeaders()

        #expect(headers["Authorization"] == "Bearer tok-pwd")
    }

    @Test func testUsesRefreshTokenOnSubsequentCalls() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.contains("grant_type=refresh_token"))
        #expect(bodyString.contains("refresh_token=ref1"))
    }

    /* The first grant goes to tokenURL and the refresh grant to refreshURL,
     * which is only observable when the two differ. */
    @Test func testRefreshGrantGoesToRefreshUrlAndFirstGrantToTokenUrl() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            refreshURL: "https://auth.example.com/refresh"
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        _ = try await auth.authHeaders()

        #expect(client.urls == ["https://auth.example.com/token", "https://auth.example.com/refresh"])
    }

    /* Without a refreshURL the refresh grant falls back to tokenURL. */
    @Test func testRefreshGrantFallsBackToTokenUrlWithoutRefreshUrl() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        _ = try await auth.authHeaders()

        #expect(client.urls == ["https://auth.example.com/token", "https://auth.example.com/token"])
    }

    /* The space between scopes is form-encoded as + in the token body. */
    @Test func testScopesAreJoinedWithPlusInTheTokenBody() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.split(separator: "&").contains("scope=read+write"))
    }

    /* RFC 6749 section 2.3.1: only letters, digits and - . _ ~ stay literal
     * in the Basic credentials, and * ! ' ( ) are percent-encoded. */
    @Test func testBasicAuthEncodesTildeAndTheSubDelimitersInCredentials() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"at\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "id~*!'()",
            clientSecret: "sec ret~*!'()",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            clientAuthMethod: .basic
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let authHeader = client.lastHeaders["Authorization"] ?? ""
        let b64 = String(authHeader.dropFirst("Basic ".count))
        let decoded = String(data: Data(base64Encoded: b64) ?? Data(), encoding: .utf8)
        #expect(decoded == "id~%2A%21%27%28%29:sec+ret~%2A%21%27%28%29")
    }

    @Test func testGetHostReturnsConfiguredHost() {
        let auth = createAuthenticator()

        #expect(auth.host() == "https://api.example.com")
    }

    @Test func testBasicAuthUrlEncodesClientIdAndSecret() async throws {
        // Gap R: RFC 6749 §2.3.1 — when using client_secret_basic, both
        // client_id and client_secret MUST be application/x-www-form-
        // urlencoded BEFORE being joined with ':' and base64-encoded.
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"at\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "id+with/special",
            clientSecret: "secret&with=stuff",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            scopes: ["read"],
            clientAuthMethod: .basic
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let authHeader = client.lastHeaders["Authorization"] ?? ""
        #expect(authHeader.hasPrefix("Basic "))
        let b64 = String(authHeader.dropFirst("Basic ".count))
        let decodedData = Data(base64Encoded: b64) ?? Data()
        let decoded = String(data: decodedData, encoding: .utf8) ?? ""
        // Expected: form-urlencoded id ':' form-urlencoded secret
        #expect(decoded == "id%2Bwith%2Fspecial:secret%26with%3Dstuff")
    }

    @Test func redactsSecret() async {
        let auth = createAuthenticator()
        let description = String(describing: auth)
        #expect(!description.contains("my-client-secret"))
        #expect(!description.contains("testpass"))
        #expect(description.contains("***"))
        /* Everything except the two secrets stays visible. */
        #expect(
            description
                == "OAuth2PasswordAuthenticator(host: https://api.example.com, clientID: my-client-id, clientSecret: ***, tokenURL: https://auth.example.com/token, refreshURL: https://auth.example.com/token, username: testuser, password: ***, scopes: [\"read\", \"write\"], clientAuthMethod: body)"
        )
        #expect(String(reflecting: auth) == description)
    }

    /* dump(_:) and Mirror(reflecting:) walk the stored properties, private ones
     * included, so the redacted description is not enough: the reflection
     * must hide the secret too. */
    @Test func dumpDoesNotLeakSecret() async throws {
        let auth = createAuthenticator()
        var dumped = ""
        dump(auth, to: &dumped)
        #expect(!dumped.contains("my-client-secret"), "dump leaked the secret: \(dumped)")
        #expect(!dumped.contains("testpass"), "dump leaked the secret: \(dumped)")
        #expect(Mirror(reflecting: auth).children.isEmpty)
    }

    /* The token body is emitted in the fixed cross-SDK parameter order. */
    @Test func testPasswordGrantBodyUsesFixedParameterOrder() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"expires_in\":3600}"))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(
            bodyString
                == "grant_type=password&username=testuser&password=testpass&client_id=my-client-id&client_secret=my-client-secret&scope=read+write"
        )
    }

    /* RFC 6749 section 6: in body mode the refresh grant carries the client
     * credentials, like the password grant did. */
    @Test func testRefreshInBodyModeCarriesClientCredentials() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            scopes: ["read", "write"],
            refreshURL: "https://auth.example.com/refresh"
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        let headers = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(client.lastURL == "https://auth.example.com/refresh")
        #expect(
            bodyString == "grant_type=refresh_token&refresh_token=ref1&client_id=my-client-id&client_secret=my-client-secret")
        #expect(headers["Authorization"] == "Bearer tok2")
    }

    /* In Basic mode the refresh grant carries the Basic header and no client
     * credentials in the body. */
    @Test func testRefreshInBasicModeCarriesTheBasicHeaderOnly() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok2\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            clientAuthMethod: .basic
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        _ = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        let expected = "Basic " + Data("my-client-id:my-client-secret".utf8).base64EncodedString()
        #expect(bodyString == "grant_type=refresh_token&refresh_token=ref1")
        #expect(client.lastHeaders["Authorization"] == expected)
    }

    /* A rejected refresh re-runs the password grant at the token URL and
     * returns its token. */
    @Test func testRejectedRefreshRerunsThePasswordGrant() async throws {
        let client = MockApiClient()
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok1\",\"refresh_token\":\"ref1\",\"expires_in\":1}"))
        client.responses.append(makeResponse(body: "{\"error\":\"invalid_grant\"}", statusCode: 400))
        client.responses.append(makeResponse(body: "{\"access_token\":\"tok3\",\"expires_in\":3600}"))

        let auth = OAuth2PasswordAuthenticator(
            host: "https://api.example.com",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            tokenURL: "https://auth.example.com/token",
            username: "testuser",
            password: "testpass",
            refreshURL: "https://auth.example.com/refresh"
        )
        auth.setApiClient(client)

        _ = try await auth.authHeaders()
        let headers = try await auth.authHeaders()

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(
            client.urls == [
                "https://auth.example.com/token", "https://auth.example.com/refresh",
                "https://auth.example.com/token",
            ])
        #expect(bodyString.hasPrefix("grant_type=password&"))
        #expect(headers["Authorization"] == "Bearer tok3")
    }
}
