import XCTest
@testable import {{packageName}}

final class StoreApiTests: XCTestCase {

    override func setUp() async throws {
        try await super.setUp()
        if prismUrl.isEmpty {
            try await setUpContainers()
        }
    }

    // MARK: - Helpers

    private func storeApiForIntegration() -> StoreApi {
        let config = ConfigurationBuilder()
            .baseURL(prismUrl)
            .defaultHeader(name: "Authorization", value: "Bearer test-token")
            .build()
        let client = DefaultApiClient()
        return StoreApi(apiClient: client, config: config)
    }

    // MARK: - Integration Tests

    func testPlaceOrder() async throws {
        let api = storeApiForIntegration()

        let order = Order()

        let result = try await api.placeOrder(order: order)
        XCTAssertNotNil(result)
    }

    func testPlaceOrderWithHTTPInfo() async throws {
        let api = storeApiForIntegration()

        let order = Order()

        let result = try await api.placeOrderWithHTTPInfo(order: order)
        XCTAssertGreaterThanOrEqual(result.statusCode, 200)
        XCTAssertLessThan(result.statusCode, 300)
        XCTAssertFalse(result.rawBody.isEmpty)
    }

    func testGetOrderById() async throws {
        let api = storeApiForIntegration()

        let result = try await api.getOrderById(orderId: 1)
        XCTAssertNotNil(result)
    }

    func testGetOrderByIdWithHTTPInfo() async throws {
        let api = storeApiForIntegration()

        let result = try await api.getOrderByIdWithHTTPInfo(orderId: 1)
        XCTAssertEqual(result.statusCode, 200)
        XCTAssertNotNil(result.headers)
    }

    func testDeleteOrder() async throws {
        let api = storeApiForIntegration()

        try await api.deleteOrder(orderId: 1)
    }

    func testGetInventory() async throws {
        let api = storeApiForIntegration()

        let result = try await api.getInventory()
        XCTAssertNotNil(result)
    }

    func testGetInventoryWithHTTPInfo() async throws {
        let api = storeApiForIntegration()

        let result = try await api.getInventoryWithHTTPInfo()
        XCTAssertEqual(result.statusCode, 200)
    }
}
