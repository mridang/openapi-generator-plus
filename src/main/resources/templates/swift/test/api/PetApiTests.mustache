import XCTest
@testable import {{packageName}}

final class PetApiTests: XCTestCase {

    // MARK: - Helpers

    private func prismBaseURL() throws -> String {
        guard let url = ProcessInfo.processInfo.environment["API_BASE_URL"], !url.isEmpty else {
            throw XCTSkip("API_BASE_URL not set; skipping integration test (Prism mock server not available)")
        }
        return url
    }

    private func petApiForIntegration() throws -> PetApi {
        let baseURL = try prismBaseURL()
        let config = ConfigurationBuilder()
            .baseURL(baseURL)
            .defaultHeader(name: "Authorization", value: "Bearer test-token")
            .build()
        let client = DefaultApiClient()
        return PetApi(apiClient: client, config: config)
    }

    private func mockServer(handler: @escaping @Sendable (URLRequest) -> (Data, HTTPURLResponse)) async throws -> (URL, URLSession) {
        // For unit tests, we use URLProtocol mocking pattern
        // Integration tests connect to the real Prism server
        fatalError("Use integration tests with Prism server")
    }

    // MARK: - Integration Tests

    func testAddPet() async throws {
        let api = try petApiForIntegration()
        let auth = TestAuthenticator()

        let pet = Pet(name: "Fido", photoUrls: ["http://example.com/fido.jpg"])

        let result = try await api.addPet(auth: auth, body: pet)
        XCTAssertNotNil(result)
    }

    func testAddPetWithHTTPInfo() async throws {
        let api = try petApiForIntegration()
        let auth = TestAuthenticator()

        let pet = Pet(name: "Buddy", photoUrls: ["http://example.com/buddy.jpg"])

        let result = try await api.addPetWithHTTPInfo(auth: auth, body: pet)
        XCTAssertGreaterThanOrEqual(result.statusCode, 200)
        XCTAssertLessThan(result.statusCode, 300)
        XCTAssertFalse(result.rawBody.isEmpty)
    }

    func testGetPetById() async throws {
        let api = try petApiForIntegration()

        let result = try await api.getPetById(petId: 1)
        XCTAssertNotNil(result)
    }

    func testGetPetByIdWithHTTPInfo() async throws {
        let api = try petApiForIntegration()

        let result = try await api.getPetByIdWithHTTPInfo(petId: 1)
        XCTAssertEqual(result.statusCode, 200)
        XCTAssertNotNil(result.headers)
        XCTAssertFalse(result.rawBody.isEmpty)
    }

    func testUpdatePet() async throws {
        let api = try petApiForIntegration()

        let pet = Pet(name: "UpdatedFido", photoUrls: ["http://example.com/fido-updated.jpg"])

        let result = try await api.updatePet(petId: 1, body: pet)
        XCTAssertNotNil(result)
    }

    func testDeletePet() async throws {
        let api = try petApiForIntegration()
        let auth = TestAuthenticator()

        try await api.deletePet(auth: auth, petId: 1, options: nil)
    }

    func testFindPetsByStatus() async throws {
        let api = try petApiForIntegration()

        let result = try await api.findPetsByStatus()
        XCTAssertNotNil(result)
    }

    func testGetPetPassport() async throws {
        let api = try petApiForIntegration()

        let result = try await api.getPetPassport(petId: 1)
        XCTAssertNotNil(result)
    }
}

/// Test authenticator for integration tests.
private final class TestAuthenticator: BaseAuthenticator, @unchecked Sendable {
    override func host() -> String { return "" }
    override func authHeaders() -> [String: String] {
        return ["Authorization": "Bearer test-token"]
    }
}
