    @Test func testGetPetTag() async throws {
        let api = petApiForIntegration()
        let options = GetPetTagOptions(colors: ["blue", "black"], sizes: ["S", "M"])
        _ = try await api.getPetTag(petId: 5, tagName: "cute", options: options)
