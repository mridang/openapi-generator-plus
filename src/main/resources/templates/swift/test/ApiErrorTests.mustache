{{>api_info}}
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif
import Testing
@testable import {{packageName}}

@Suite final class ApiErrorTests {

    @Test func testBhvErrors004ExposesStatusMessageBodyHeadersErrorBody() {
        let err = ApiError(
            statusCode: 404,
            message: "not found",
            responseBody: #"{"id":7,"name":"missing"}"#,
            responseHeaders: ["content-type": "application/json"],
            errorBody: nil
        )

        #expect(err.statusCode == 404)
        #expect(err.message == "not found")
        #expect(err.responseBody == #"{"id":7,"name":"missing"}"#)
        #expect(err.responseHeaders?["content-type"] == "application/json")
        #expect(err.errorBody == nil)
    }

    @Test func testBhvErrors021NilHeadersAndBodyMarkTransportNoResponse() {
        // apierror-responsebody-headers-nullable-split: nil is distinct from an
        // empty header map / empty body so a pre-response transport failure can
        // be encoded.
        let err = ApiError(
            statusCode: 0,
            message: "connection reset",
            responseBody: nil,
            responseHeaders: nil
        )

        #expect(err.responseHeaders == nil)
        #expect(err.responseBody == nil)
    }

    @Test func testBhvLangswift001ConformsToErrorAndHasDescription() {
        let err = ApiError(statusCode: 500, message: "boom")

        let _: any Error = err
        #expect(err.errorDescription?.isEmpty == false)
    }

    /* A body that starts with a byte-order mark still populates errorBody,
     * as it does on the success path. */
    @Test func testBhvErrors008BomPrefixedErrorBodyPopulatesErrorBody() {
        let err = ApiError.fromResponse(
            statusCode: 404, headers: [:], body: "\u{FEFF}{\"code\":1}")
        #expect((err.errorBody as? [String: Any])?["code"] as? Int == 1)
    }

    /* A top-level scalar error body (JSON fragment) populates errorBody like
     * the other SDKs; a bare null stays absent. */
    @Test func testBhvErrors010FromResponseParsesScalarJsonBody() {
        let text = ApiError.fromResponse(statusCode: 404, headers: [:], body: "\"Not found\"")
        #expect(text.errorBody as? String == "Not found")
        let number = ApiError.fromResponse(statusCode: 404, headers: [:], body: "123")
        #expect((number.errorBody as? NSNumber)?.intValue == 123)
        let flag = ApiError.fromResponse(statusCode: 500, headers: [:], body: "true")
        #expect((flag.errorBody as? NSNumber)?.boolValue == true)
        let null = ApiError.fromResponse(statusCode: 500, headers: [:], body: "null")
        #expect(null.errorBody == nil)
    }

    /* OAuth2TokenError renders its message through localizedDescription
     * instead of Foundation's generic "operation couldn't be completed". */
    @Test func testBhvLangswift002OAuth2TokenErrorLocalizedDescriptionIsTheMessage() {
        let missing: any Error = OAuth2TokenError.missingAccessToken("empty access_token")
        #expect(missing.localizedDescription == "empty access_token")
        let invalid: any Error = OAuth2TokenError.invalidResponse("not a token object")
        #expect(invalid.localizedDescription == "not a token object")
    }

    /* A typed view of an error body that starts with a byte order mark decodes the same as the body without it. */
    @Test func testBhvErrors072GetTypedErrorBodyDecodesTheSameWithAByteOrderMark() throws {
        let json = #"{"id":42,"name":"Dogs"}"#
        let withMark = ApiError(statusCode: 400, message: "bad request", responseBody: "\u{FEFF}" + json)
        let plain = ApiError(statusCode: 400, message: "bad request", responseBody: json)

        let marked = try #require(try withMark.getTypedErrorBody({{packageName}}.Category.self))
        let expected = try #require(try plain.getTypedErrorBody({{packageName}}.Category.self))
        #expect(marked.id == expected.id)
        #expect(marked.name == expected.name)
    }

    @Test func testBhvErrors013GetTypedErrorBodyDeserializesBody() throws {
        let err = ApiError(
            statusCode: 400,
            message: "bad request",
            responseBody: #"{"id":42,"name":"Dogs"}"#
        )

        let typed = try err.getTypedErrorBody({{packageName}}.Category.self)
        #expect(typed != nil)
        #expect(typed?.id == 42)
        #expect(typed?.name == "Dogs")
    }

    @Test func testBhvErrors015GetTypedErrorBodyReturnsNilWhenNoBody() throws {
        let err = ApiError(statusCode: 500, message: "oops", responseBody: nil)

        let typed = try err.getTypedErrorBody({{packageName}}.Category.self)
        #expect(typed == nil)
    }

    @Test func testBhvErrors016GetTypedErrorBodyReturnsNilWhenBodyIsEmptyString() throws {
        let err = ApiError(statusCode: 500, message: "oops", responseBody: "")

        #expect(try err.getTypedErrorBody([String: Int].self) == nil)
    }

    /* A body that does not decode into the requested type is the SDK's
     * SerializationError, not a Foundation decoding error. */
    @Test func testBhvErrors017GetTypedErrorBodyThrowsSerializationErrorWhenBodyDoesNotDecode() {
        let err = ApiError(statusCode: 500, message: "oops", responseBody: "not json at all")

        let error = #expect(throws: SerializationError.self) {
            _ = try err.getTypedErrorBody([String: Int].self)
        }
        #expect(error?.message == "Failed to deserialize JSON")
    }

    /* The rendered message lists the status, the headers and the body, each
     * only when it carries something. */
    @Test func testBhvErrors022ErrorDescriptionRendersEachPartOnlyWhenPresent() {
        let full = ApiError(
            statusCode: 404, message: "not found", responseBody: "{}",
            responseHeaders: ["a": "b"])
        #expect(
            full.errorDescription
                == "not found\nHTTP status code: 404\nResponse headers: {\"a\":\"b\"}\nResponse body: {}"
        )

        let several = ApiError(
            statusCode: 302, message: "moved",
            responseHeaders: ["location": "https://a.example/x", "b": "2", "a": "1"])
        #expect(
            several.errorDescription
                == "moved\nHTTP status code: 302\nResponse headers: "
                + "{\"a\":\"1\",\"b\":\"2\",\"location\":\"https://a.example/x\"}")

        let emptyParts = ApiError(
            statusCode: 500, message: "boom", responseBody: "", responseHeaders: [:])
        #expect(emptyParts.errorDescription == "boom\nHTTP status code: 500")

        let transport = ApiError(statusCode: 0, message: "connection reset")
        #expect(transport.errorDescription == "connection reset")

        #expect(ApiError().errorDescription == "Error message: the server returns an error")
    }

    /* Response headers render as compact JSON with the keys sorted and slashes unescaped. */
    @Test func testBhvErrors050ResponseHeadersRenderAsCompactSortedJsonWithUnescapedSlashes() {
        let err = ApiError(
            statusCode: 500, message: "boom",
            responseHeaders: ["z-link": "https://a.example/x", "a": "1"])
        #expect(
            err.errorDescription
                == "boom\nHTTP status code: 500\nResponse headers: "
                + "{\"a\":\"1\",\"z-link\":\"https://a.example/x\"}")
    }

    /* An empty message falls back to the generic error line, then the status line. */
    @Test func testBhvErrors051AnEmptyMessageFallsBackToTheGenericErrorLine() {
        let err = ApiError(statusCode: 500, message: "")
        #expect(
            err.errorDescription
                == "Error message: the server returns an error\nHTTP status code: 500")
    }

    /* The rendered form caps the body, escapes control characters and masks
     * credential headers; the full body stays on responseBody. */
    @Test func testBhvErrors001ErrorDescriptionCapsTheBodyEscapesControlsAndMasksSecretHeaders() {
        let body = String(repeating: "a", count: 1024) + "tail\nforged: line"
        let err = ApiError(
            statusCode: 502, message: "bad gateway", responseBody: body,
            responseHeaders: [
                "x-request-id": "abc", "set-cookie": "session=1", "X-Api-Key": "k",
                "authorization": "Bearer t",
            ])

        let text = err.errorDescription ?? ""

        #expect(text.contains("\"x-request-id\":\"abc\""))
        #expect(text.contains("\"set-cookie\":\"***\""))
        #expect(text.contains("\"X-Api-Key\":\"***\""))
        #expect(text.contains("\"authorization\":\"***\""))
        #expect(!text.contains("Bearer t"))
        #expect(text.contains(String(repeating: "a", count: 1024) + "... (17 more bytes)"))
        #expect(!text.contains("forged"))
        #expect(err.responseBody == body)
    }

    /* An empty message renders the same default text as a missing one. */
    @Test func testBhvErrors064AnEmptyMessageRendersTheDefaultTextLikeAMissingOne() {
        let empty = ApiError(statusCode: 500, message: "")
        let missing = ApiError(statusCode: 500)
        #expect(empty.errorDescription == missing.errorDescription)
        #expect(empty.errorDescription?.hasPrefix("Error message: the server returns an error") == true)
    }

    /* The rendered body keeps 1 KiB and says how many bytes it left out. */
    @Test func testBhvErrors065TheErrorTextCutsALongBodyAtOneKibAndCountsTheBytesLeftOut() {
        let body = String(repeating: "a", count: 1500)
        let err = ApiError(statusCode: 500, message: "boom", responseBody: body)
        #expect(ApiError.renderedBody(body) == String(repeating: "a", count: 1024) + "... (476 more bytes)")
        #expect(err.responseBody == body)
    }

    @Test func testBhvErrors085ANewlineInTheBodyIsShownEscaped() {
        let err = ApiError(statusCode: 500, message: "boom", responseBody: "one\r\ntwo")
        #expect(err.errorDescription == "boom\nHTTP status code: 500\nResponse body: one\\x0D\\x0Atwo")
    }

    /* A response body nested deeper than the serializer's cap is kept as the
     * raw body but is never handed to the JSON parser. */
    @Test func testBhvErrors009FromResponseDoesNotParseADeeplyNestedBody() {
        func nested(_ depth: Int) -> String {
            String(repeating: "[", count: depth) + String(repeating: "]", count: depth)
        }
        let within = ApiError.fromResponse(statusCode: 500, headers: [:], body: nested(100))
        #expect(within.errorBody != nil)

        let body = nested(1500)
        let tooDeep = ApiError.fromResponse(statusCode: 500, headers: [:], body: body)
        #expect(tooDeep is InternalServerError)
        #expect(tooDeep.errorBody == nil)
        #expect(tooDeep.responseBody == body)
    }

    @Test func testBhvErrors047ApiErrorConformsTo{{errorPrefix}}Error() {
        // Branded root: every SDK-thrown error reaches {{errorPrefix}}Error, so a
        // caller can catch the whole hierarchy with one `as? {{errorPrefix}}Error`.
        let err: any Error = ApiError(statusCode: 500, message: "boom")

        #expect(err is {{errorPrefix}}Error)
        #expect(err as? {{errorPrefix}}Error != nil)
    }

    /* A 404 is a NotFoundError and a 500 an InternalServerError; each is an
     * ApiError of the right family and part of the {{errorPrefix}}Error hierarchy. */
    /* Every error type lives in the Errors folder, and the module exports each one under its own name. */
    @Test func testBhvErrors044EveryErrorTypeLivesInTheErrorsFolderAndTheModuleExportsIt() {
        let names = [
            "{{errorPrefix}}Error", "ApiError", "ClientError", "ServerError", "BadRequestError",
            "UnauthorizedError", "ForbiddenError", "NotFoundError", "ConflictError",
            "UnprocessableEntityError", "TooManyRequestsError", "InternalServerError", "NetworkError",
            "NetworkTimeoutError", "SerializationError", "ConfigurationError", "OAuth2ServerError",
            "OAuth2TokenError", "OAuth2AuthorizationCodeError", "ResponseTooLargeError",
        ]
        let exported: [Any.Type] = [
            {{errorPrefix}}Error.self, ApiError.self, ClientError.self, ServerError.self, BadRequestError.self,
            UnauthorizedError.self, ForbiddenError.self, NotFoundError.self, ConflictError.self,
            UnprocessableEntityError.self, TooManyRequestsError.self, InternalServerError.self, NetworkError.self,
            NetworkTimeoutError.self, SerializationError.self, ConfigurationError.self, OAuth2ServerError.self,
            OAuth2TokenError.self, OAuth2AuthorizationCodeError.self, ResponseTooLargeError.self,
        ]
        #expect(exported.count == names.count)
        let root = URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
        for name in names {
            let file = root.appendingPathComponent("Sources/{{packageName}}/Errors/\(name).swift")
            #expect(FileManager.default.fileExists(atPath: file.path), "\(name) must live in the Errors folder")
        }
    }

    @Test func testBhvErrors006StatusCodesMapToTypedErrorsAndDispatchEveryStatus() async throws {
        do {
            do {
                do {
                    do {
                        do {
                            do {
                                do {
                                    do {
                                        let notFound: any Error = ApiError.fromResponse(
                                            statusCode: 404, headers: [:], body: "")
                                        #expect(notFound is NotFoundError)
                                        #expect(notFound is ClientError)
                                        #expect(!(notFound is ServerError))
                                        #expect(!(notFound is NetworkError))
                                        #expect(notFound is {{errorPrefix}}Error)
                                        #expect((notFound as? ApiError)?.statusCode == 404)

                                        let serverError: any Error = ApiError.fromResponse(
                                            statusCode: 500, headers: [:], body: "")
                                        #expect(serverError is InternalServerError)
                                        #expect(serverError is ServerError)
                                        #expect(!(serverError is ClientError))
                                        #expect(serverError is {{errorPrefix}}Error)
                                        #expect((serverError as? ApiError)?.statusCode == 500)

                                        /* A status outside 400-599 is neither a ClientError nor a ServerError:
                                         * the 5xx arm stops at 599, so 600 is a plain ApiError. */
                                        let outOfRange: any Error = ApiError.fromResponse(
                                            statusCode: 600, headers: [:], body: "")
                                        #expect(!(outOfRange is ServerError))
                                        #expect(!(outOfRange is ClientError))
                                        #expect(outOfRange is ApiError)
                                        #expect((outOfRange as? ApiError)?.statusCode == 600)
                                    }
                                    do {
                                        let mockClient = MockApiClient()
                                        mockClient.responseStatusCode = 400
                                        mockClient.responseBody = "{\"error\":\"bad request\"}"

                                        let config = ConfigurationBuilder().baseURL("https://example.com").build()
                                        let api = PetApi(apiClient: mockClient, config: config)

                                        do {
                                            _ = try await api.getPetById(petId: 1)
                                            Issue.record("Expected error for status 400")
                                        } catch let error as BadRequestError {
                                            #expect(error.statusCode == 400)
                                        }
                                    }
                                }
                                do {
                                    let mockClient = MockApiClient()
                                    mockClient.responseStatusCode = 403

                                    let config = ConfigurationBuilder().baseURL("https://example.com").build()
                                    let api = PetApi(apiClient: mockClient, config: config)

                                    do {
                                        _ = try await api.getPetById(petId: 1)
                                        Issue.record("Expected error for status 403")
                                    } catch is ForbiddenError {
                                        // Expected
                                    }
                                }
                            }
                            do {
                                let mockClient = MockApiClient()
                                mockClient.responseStatusCode = 404

                                let config = ConfigurationBuilder().baseURL("https://example.com").build()
                                let api = PetApi(apiClient: mockClient, config: config)

                                do {
                                    _ = try await api.getPetById(petId: 1)
                                    Issue.record("Expected error for status 404")
                                } catch is NotFoundError {
                                    // Expected
                                }
                            }
                        }
                        do {
                            let mockClient = MockApiClient()
                            mockClient.responseStatusCode = 409

                            let config = ConfigurationBuilder().baseURL("https://example.com").build()
                            let api = PetApi(apiClient: mockClient, config: config)

                            do {
                                _ = try await api.getPetById(petId: 1)
                                Issue.record("Expected error for status 409")
                            } catch is ConflictError {
                                // Expected
                            }
                        }
                    }
                    do {
                        let mockClient = MockApiClient()
                        mockClient.responseStatusCode = 422

                        let config = ConfigurationBuilder().baseURL("https://example.com").build()
                        let api = PetApi(apiClient: mockClient, config: config)

                        do {
                            _ = try await api.getPetById(petId: 1)
                            Issue.record("Expected error for status 422")
                        } catch is UnprocessableEntityError {
                            // Expected
                        }
                    }
                }
                do {
                    let mockClient = MockApiClient()
                    mockClient.responseStatusCode = 429

                    let config = ConfigurationBuilder().baseURL("https://example.com").build()
                    let api = PetApi(apiClient: mockClient, config: config)

                    do {
                        _ = try await api.getPetById(petId: 1)
                        Issue.record("Expected error for status 429")
                    } catch let error as TooManyRequestsError {
                        let family: Error = error
                        #expect(family is ClientError)
                        #expect(error.statusCode == 429)
                    }
                }
            }
            do {
                let mockClient = MockApiClient()
                mockClient.responseStatusCode = 500

                let config = ConfigurationBuilder().baseURL("https://example.com").build()
                let api = PetApi(apiClient: mockClient, config: config)

                do {
                    _ = try await api.getPetById(petId: 1)
                    Issue.record("Expected error for status 500")
                } catch is InternalServerError {
                    // Expected
                }
            }
        }
        do {
            let mockClient = MockApiClient()
            mockClient.responseStatusCode = 502

            let config = ConfigurationBuilder().baseURL("https://example.com").build()
            let api = PetApi(apiClient: mockClient, config: config)

            do {
                _ = try await api.getPetById(petId: 1)
                Issue.record("Expected error for status 502")
            } catch is ServerError {
                // Expected
            }
        }
    }

    /* A named error always reports its own status, whatever it is built
     * from, so the type and the status can never disagree. */
    @Test func testBhvErrors053EachNamedErrorPinsItsOwnHTTPStatusCode() {
        #expect(BadRequestError(message: "x").statusCode == 400)
        #expect(UnauthorizedError(message: "x").statusCode == 401)
        #expect(ForbiddenError(message: "x").statusCode == 403)
        #expect(NotFoundError(message: "x").statusCode == 404)
        #expect(ConflictError(message: "x").statusCode == 409)
        #expect(UnprocessableEntityError(message: "x").statusCode == 422)
        #expect(TooManyRequestsError(message: "x").statusCode == 429)
        #expect(PaymentRequiredError(message: "x").statusCode == 402)
        #expect(MethodNotAllowedError(message: "x").statusCode == 405)
        #expect(RequestTimeoutError(message: "x").statusCode == 408)
        #expect(GoneError(message: "x").statusCode == 410)
        #expect(PayloadTooLargeError(message: "x").statusCode == 413)
        #expect(UnsupportedMediaTypeError(message: "x").statusCode == 415)
        #expect(LockedError(message: "x").statusCode == 423)
        #expect(NotImplementedError(message: "x").statusCode == 501)
        #expect(BadGatewayError(message: "x").statusCode == 502)
        #expect(ServiceUnavailableError(message: "x").statusCode == 503)
        #expect(GatewayTimeoutError(message: "x").statusCode == 504)
        #expect(InternalServerError(message: "x").statusCode == 500)
        #expect(NotFoundError().statusCode == 404)
        let err = NotFoundError(message: "gone", responseBody: "{}", responseHeaders: ["a": "b"])
        #expect(err.message == "gone")
        #expect(err.responseBody == "{}")
        #expect(err.responseHeaders == ["a": "b"])
    }

