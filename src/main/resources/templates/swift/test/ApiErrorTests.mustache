{{>api_info}}
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class ApiErrorTests {

    @Test func testExposesStatusMessageBodyHeadersErrorBody() {
        let err = ApiError(
            statusCode: 404,
            message: "not found",
            responseBody: #"{"id":7,"name":"missing"}"#,
            responseHeaders: ["content-type": "application/json"],
            errorBody: nil
        )

        #expect(err.statusCode == 404)
        #expect(err.message == "not found")
        #expect(err.responseBody == #"{"id":7,"name":"missing"}"#)
        #expect(err.responseHeaders?["content-type"] == "application/json")
        #expect(err.errorBody == nil)
    }

    @Test func testNilHeadersAndBodyMarkTransportNoResponse() {
        // apierror-responsebody-headers-nullable-split: nil is distinct from an
        // empty header map / empty body so a pre-response transport failure can
        // be encoded.
        let err = ApiError(
            statusCode: 0,
            message: "connection reset",
            responseBody: nil,
            responseHeaders: nil
        )

        #expect(err.responseHeaders == nil)
        #expect(err.responseBody == nil)
    }

    @Test func testConformsToErrorAndHasDescription() {
        let err = ApiError(statusCode: 500, message: "boom")

        let _: any Error = err
        #expect(err.errorDescription?.isEmpty == false)
    }

    @Test func testGetTypedErrorBodyDeserializesBody() throws {
        let err = ApiError(
            statusCode: 400,
            message: "bad request",
            responseBody: #"{"id":42,"name":"Dogs"}"#
        )

        let typed = try err.getTypedErrorBody(Category.self)
        #expect(typed != nil)
        #expect(typed?.id == 42)
        #expect(typed?.name == "Dogs")
    }

    @Test func testGetTypedErrorBodyReturnsNilWhenNoBody() throws {
        let err = ApiError(statusCode: 500, message: "oops", responseBody: nil)

        let typed = try err.getTypedErrorBody(Category.self)
        #expect(typed == nil)
    }

    @Test func testGetTypedErrorBodyIgnoresExtraneousFields() throws {
        let err = ApiError(
            statusCode: 422,
            message: "unprocessable",
            responseBody: #"{"id":1,"name":"Cat","extra":"drop-me"}"#
        )

        let typed = try err.getTypedErrorBody(Category.self)
        #expect(typed != nil)
        #expect(typed?.id == 1)
        #expect(typed?.name == "Cat")
    }
}
