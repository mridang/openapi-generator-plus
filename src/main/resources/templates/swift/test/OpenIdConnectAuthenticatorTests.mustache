{{>api_info}}
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class OpenIdConnectAuthenticatorTests {

    // MARK: - Mock ApiClient

    private final class MockApiClient: ApiClient, @unchecked Sendable {
        var responses: [Result<ApiHttpResponse, Error>] = []
        var lastMethod: String = ""
        var lastURL: String = ""
        var lastHeaders: [String: String] = [:]
        var lastBody: Data? = nil
        var getCount: Int = 0

        /// Satisfies the ApiClient requirement that carries no request options.
        func sendRequest(method: String, url: String, headers: [String: String], body: Any?)
            async throws -> ApiHttpResponse
        {
            try await sendRequest(
                method: method, url: url, headers: headers, body: body, noRedirect: false)
        }

        func sendRequest(method: String, url: String, headers: [String: String], body: Any?, noRedirect: Bool) async throws -> ApiHttpResponse {
            lastMethod = method
            lastURL = url
            lastHeaders = headers
            lastBody = body as? Data
            if method == "GET" {
                getCount += 1
            }
            return try responses.removeFirst().get()
        }
    }

    private func makeResponse(body: String, statusCode: Int = 200) -> ApiHttpResponse {
        return ApiHttpResponse(statusCode: statusCode, body: body, headers: [:])
    }

    private func createAuthenticator() -> OpenIdConnectAuthenticator {
        return OpenIdConnectAuthenticator(
            host: "https://api.example.com",
            openIDConnectURL: "https://auth.example.com/.well-known/openid-configuration",
            clientID: "my-client-id",
            clientSecret: "my-client-secret",
            redirectURI: "https://app.example.com/callback",
            scopes: ["openid", "profile"]
        )
    }

    private static let discoveryJSON = """
        {"authorization_endpoint":"https://auth.example.com/authorize","token_endpoint":"https://auth.example.com/token"}
        """

    // MARK: - Tests

    @Test func testBhvAuthoidc002BuildsAuthorizationURLFromDiscovery() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        let url = try await auth.buildAuthorizationURL(state: "my-state")

        #expect(url.hasPrefix("https://auth.example.com/authorize?"))
        #expect(url.contains("response_type=code"))
        #expect(url.contains("client_id=my-client-id"))
        #expect(url.contains("state=my-state"))
    }

    /* D05: openid is always requested, put first, and a case-sensitive
       duplicate is dropped. */
    @Test(arguments: [
        ([String](), "openid"),
        (["profile", "email"], "openid profile email"),
        (["profile", "openid"], "openid profile"),
        (["OpenID", "profile"], "openid OpenID profile"),
    ])
    func testBhvAuthoidc022OpenidScopeIsAlwaysRequested(scopes: [String], expected: String) async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))
        let auth = OpenIdConnectAuthenticator(
            host: "https://api.example.com",
            openIDConnectURL: "https://auth.example.com/.well-known/openid-configuration",
            clientID: "my-client-id",
            clientSecret: "my-secret",
            redirectURI: "https://app.example.com/callback",
            scopes: scopes)
        auth.setApiClient(client)

        let url = try await auth.buildAuthorizationURL()

        let scope = URLComponents(string: url)?.queryItems?.first { $0.name == "scope" }?.value
        #expect(scope == expected)
    }

    private func discoveryWith(issuer: String? = nil, token: String = "https://auth.example.com/token") -> String {
        let issuerField = issuer.map { "\"issuer\":\"\($0)\"," } ?? ""
        return "{\(issuerField)\"authorization_endpoint\":\"https://auth.example.com/authorize\",\"token_endpoint\":\"\(token)\"}"
    }

    /* Discovery 1.0 section 4.3: the issuer must match the discovery URL. */
    @Test func testBhvAuthoidc024DiscoveryRejectsAnIssuerThatDiffersFromTheDiscoveryUrl() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: discoveryWith(issuer: "https://evil.example.com"))))
        let auth = createAuthenticator()
        auth.setApiClient(client)

        let error = await #expect(throws: SerializationError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
        #expect(error?.message == "OIDC discovery issuer 'https://evil.example.com' does not match 'https://auth.example.com'")
    }

    @Test(arguments: ["https://auth.example.com", "https://auth.example.com/"])
    func testBhvAuthoidc004DiscoveryAcceptsAMatchingIssuer(issuer: String) async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: discoveryWith(issuer: issuer))))
        let auth = createAuthenticator()
        auth.setApiClient(client)

        let url = try await auth.buildAuthorizationURL()
        #expect(url.hasPrefix("https://auth.example.com/authorize?"))
    }

    /* The code and the client secret go to the token endpoint, so it must be
       https unless it is a loopback host. */
    @Test(arguments: [
        ("https://auth.example.com/token", true),
        ("http://auth.example.com/token", false),
        ("http://localhost:8080/token", true),
        ("http://127.0.0.1:8080/token", true),
        ("ftp://auth.example.com/token", false),
    ])
    func testBhvAuthoidc005DiscoveryRefusesAClearTextEndpointUnlessLoopback(endpoint: String, accepted: Bool) async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: discoveryWith(token: endpoint))))
        let auth = createAuthenticator()
        auth.setApiClient(client)

        if accepted {
            let url = try await auth.buildAuthorizationURL()
            #expect(url.hasPrefix("https://auth.example.com/authorize?"))
        } else {
            let error = await #expect(throws: SerializationError.self) {
                _ = try await auth.buildAuthorizationURL()
            }
            #expect(error?.message.contains("'token_endpoint' must be an https URL") == true)
        }
    }

    @Test func testBhvAuthoidc010FetchesDiscoveryDocument() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.buildAuthorizationURL()

        #expect(client.lastMethod == "GET")
        #expect(client.lastURL == "https://auth.example.com/.well-known/openid-configuration")
    }

    @Test func testBhvAuthoidc017ObtainsTokenAfterCodeExchange() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))
        client.responses.append(.success(makeResponse(body: "{\"access_token\":\"oidc-tok\",\"expires_in\":3600}")))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        try await auth.exchangeCode("oidc-code")

        let bodyString = String(data: client.lastBody!, encoding: .utf8) ?? ""
        #expect(bodyString.contains("grant_type=authorization_code"))
        #expect(bodyString.contains("code=oidc-code"))
    }

    @Test func testBhvAuthoidc013GetAuthHeadersReturnsBearerAfterExchange() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))
        client.responses.append(.success(makeResponse(body: "{\"access_token\":\"oidc-tok\",\"expires_in\":3600}")))
        client.responses.append(.success(makeResponse(body: "{\"access_token\":\"oidc-tok\",\"expires_in\":3600}")))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        try await auth.exchangeCode("oidc-code")
        let headers = try await auth.authHeaders()

        #expect(headers["Authorization"] == "Bearer oidc-tok")
    }

    @Test func testBhvAuthoidc028ThrowsWhenNoApiClientInjected() async {
        let auth = createAuthenticator()

        let error = await #expect(throws: ConfigurationError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
        guard case .invalidState? = error else {
            Issue.record("expected ConfigurationError.invalidState, got \(String(describing: error))")
            return
        }
    }

    /* OIDC discovery is an HTTP call like any other: a 404 is a NotFoundError,
     * a transport failure passes through as the NetworkError /
     * NetworkTimeoutError it already is, and an unparseable document is a
     * SerializationError. */
    @Test func testBhvAuthoidc006DiscoveryFailuresAreTyped() async {
        let notFound = MockApiClient()
        notFound.responses.append(.success(makeResponse(body: "missing", statusCode: 404)))
        var auth = createAuthenticator()
        auth.setApiClient(notFound)
        await #expect(throws: NotFoundError.self) {
            _ = try await auth.buildAuthorizationURL()
        }

        let refused = MockApiClient()
        refused.responses.append(.failure(NetworkError(statusCode: 0, message: "connection refused")))
        auth = createAuthenticator()
        auth.setApiClient(refused)
        let network = await #expect(throws: NetworkError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
        #expect(network?.statusCode == 0)

        let timedOut = MockApiClient()
        timedOut.responses.append(.failure(NetworkTimeoutError(statusCode: 0, message: "timed out")))
        auth = createAuthenticator()
        auth.setApiClient(timedOut)
        await #expect(throws: NetworkTimeoutError.self) {
            _ = try await auth.authHeaders()
        }

        let malformed = MockApiClient()
        malformed.responses.append(.success(makeResponse(body: "{not json")))
        auth = createAuthenticator()
        auth.setApiClient(malformed)
        await #expect(throws: SerializationError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
    }

    // oauth-oidc-discovery-no-status-check: when the OIDC discovery endpoint
    // returns a non-2xx status (e.g. a 500 HTML error page), the authenticator
    // must throw a status-based error rather than attempt to JSON-decode the
    // body and surface a misleading "invalid JSON" failure.
    @Test func testBhvAuthoidc027DiscoveryNon2xxStatusThrowsBeforeJsonDecode() async {
        let client = MockApiClient()
        // A 500 with an HTML body that is NOT valid discovery JSON.
        client.responses.append(.success(makeResponse(
            body: "<html><body>Internal Server Error</body></html>",
            statusCode: 500)))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        let error = await #expect(throws: InternalServerError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
        #expect(error?.statusCode == 500)
    }

    @Test func testBhvAuthoidc025ThrowsWhenDiscoveryMissingAuthorizationEndpoint() async {
        let client = MockApiClient()
        // Missing authorization_endpoint must throw rather than build a
        // delegate with a null/empty endpoint URL.
        client.responses.append(.success(makeResponse(
            body: "{\"token_endpoint\":\"https://auth.example.com/token\"}")))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        /* An incomplete discovery document is a SerializationError. */
        let error = await #expect(throws: SerializationError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
        #expect(error?.message.contains("OIDC discovery document is missing 'authorization_endpoint'") == true)
    }

    @Test func testBhvAuthoidc026ThrowsWhenDiscoveryMissingTokenEndpoint() async {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(
            body: "{\"authorization_endpoint\":\"https://auth.example.com/authorize\"}")))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        /* An incomplete discovery document is a SerializationError. */
        await #expect(throws: SerializationError.self) {
            _ = try await auth.buildAuthorizationURL()
        }
    }

    @Test func testBhvAuthoidc011FetchesDiscoveryDocumentOnlyOnce() async throws {
        let client = MockApiClient()
        client.responses.append(.success(makeResponse(body: Self.discoveryJSON)))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.buildAuthorizationURL()
        _ = try await auth.buildAuthorizationURL()

        // The cached discovery document must be reused on the second call.
        #expect(client.getCount == 1)
    }

    /* A rediscovery after the cached document expired must keep the code
     * exchange made before it: the session lives in the token manager. */
    @Test func testBhvAuthoidc020RediscoveryAfterExpiryKeepsTheExchangedSession() async throws {
        let client = MockApiClient()
        let expired = ApiHttpResponse(
            statusCode: 200, body: Self.discoveryJSON, headers: ["Cache-Control": "max-age=0"])
        client.responses.append(.success(expired))
        client.responses.append(.success(ApiHttpResponse(
            statusCode: 200,
            body: "{\"access_token\":\"at-1\",\"token_type\":\"Bearer\",\"expires_in\":3600}",
            headers: [:])))
        client.responses.append(.success(expired))

        let auth = createAuthenticator()
        auth.setApiClient(client)

        try await auth.exchangeCode("the-code")
        let headers = try await auth.authHeaders()

        #expect(headers["Authorization"] == "Bearer at-1")
    }

    /* The discovery document is cached for the Cache-Control max-age the
     * server sent, and for a day when it sent none that can be read. */
    @Test(arguments: [
        ("max-age=0", 2),
        ("public, max-age=0, must-revalidate", 2),
        ("public, MAX-AGE=3600", 1),
        ("no-store", 1),
        ("max-age=abc", 1),
        ("max-age=99999999999999999999999", 1),
    ])
    func testDiscoveryIsCachedForTheMaxAgeTheServerSent(cacheControl: String, discoveryRequests: Int) async throws {
        let client = MockApiClient()
        for _ in 0..<2 {
            client.responses.append(.success(ApiHttpResponse(
                statusCode: 200, body: Self.discoveryJSON, headers: ["Cache-Control": cacheControl])))
        }

        let auth = createAuthenticator()
        auth.setApiClient(client)

        _ = try await auth.buildAuthorizationURL()
        _ = try await auth.buildAuthorizationURL()

        #expect(client.getCount == discoveryRequests)
    }

    /* A max-age above one year, including one too long for Int, is clamped
     * to one year rather than caching the discovery document for longer. */
    @Test(arguments: [
        ("max-age=3600", 3600),
        ("max-age=31536000", 31_536_000),
        ("max-age=31536001", 31_536_000),
        ("max-age=9000000000000000000", 31_536_000),
        ("max-age=99999999999999999999999", 31_536_000),
        ("no-store", 86400),
    ])
    func testBhvAuthoidc001DiscoveryMaxAgeIsClampedToOneYear(cacheControl: String, seconds: Int) {
        #expect(OpenIdConnectAuthenticator.parseMaxAge(["Cache-Control": cacheControl]) == seconds)
    }

    @Test func testBhvAuthoidc014GetHostReturnsConfiguredHost() {
        let auth = createAuthenticator()

        #expect(auth.host() == "https://api.example.com")
    }

    @Test func testBhvAuthoidc019RedactsSecret() async {
        let auth = createAuthenticator()
        let description = String(describing: auth)
        #expect(!description.contains("my-client-secret"))
        #expect(description.contains("***"))
    }

    /* dump(_:) and Mirror(reflecting:) walk the stored properties, private ones
     * included, so the redacted description is not enough: the reflection
     * must hide the secret too. */
    @Test func dumpDoesNotLeakSecret() async throws {
        let auth = createAuthenticator()
        var dumped = ""
        dump(auth, to: &dumped)
        #expect(!dumped.contains("my-client-secret"), "dump leaked the secret: \(dumped)")
        #expect(Mirror(reflecting: auth).children.isEmpty)
    }

    // MARK: - Generated scheme wrapper

    /* The openIdConnect securityScheme's wrapper carries the spec's discovery
     * URL and masks the client secret. */
    @Test func testBhvAuthoidc012SchemeWrapperCarriesTheSpecDiscoveryUrl() throws {
        let auth = try SsoAuthAuthenticator(
            host: "https://api.example.com", clientId: "cid", clientSecret: "csecret",
            redirectUri: "https://app.example.com/cb")
        #expect(
            String(describing: auth)
                == "SsoAuthAuthenticator(host: https://api.example.com, openIDConnectURL: https://auth.example.com/.well-known/openid-configuration, clientID: cid, clientSecret: ***, redirectURI: https://app.example.com/cb, scopes: [\"openid\"])"
        )
    }
}
