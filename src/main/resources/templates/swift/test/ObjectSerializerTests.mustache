{{>api_info}}
import XCTest
@testable import {{packageName}}

final class ObjectSerializerTests: XCTestCase {

    func testSerializeMapToJSON() throws {
        let input: [String: Any] = ["name": "Fido", "age": 3]
        let jsonString = try ObjectSerializer.serialize(input)
        XCTAssertFalse(jsonString.isEmpty)

        let data = jsonString.data(using: .utf8)!
        let parsed = try JSONSerialization.jsonObject(with: data) as? [String: Any]
        XCTAssertEqual(parsed?["name"] as? String, "Fido")
    }

    func testDeserializeJSONToStruct() throws {
        struct TestModel: Codable {
            let name: String
            let age: Int
        }

        let json = "{\"name\":\"Fido\",\"age\":3}"
        let result = try ObjectSerializer.deserialize(json, as: TestModel.self)
        XCTAssertEqual(result.name, "Fido")
        XCTAssertEqual(result.age, 3)
    }

    func testDeserializeEmptyDataThrows() {
        struct TestModel: Codable { let name: String }
        XCTAssertThrowsError(try ObjectSerializer.deserialize(Data(), as: TestModel.self))
    }

    func testDeserializeInvalidJSON() {
        struct TestModel: Codable { let name: String }
        XCTAssertThrowsError(try ObjectSerializer.deserialize("not json", as: TestModel.self))
    }

    func testToPathValueString() {
        let result = ObjectSerializer.toPathValue("hello")
        XCTAssertEqual(result, "hello")
    }

    func testToPathValueInt() {
        let result = ObjectSerializer.toPathValue(42)
        XCTAssertEqual(result, "42")
    }

    func testToPathValueBool() {
        XCTAssertEqual(ObjectSerializer.toPathValue(true), "true")
        XCTAssertEqual(ObjectSerializer.toPathValue(false), "false")
    }

    func testToPathValueNil() {
        let result = ObjectSerializer.toPathValue(nil)
        XCTAssertEqual(result, "")
    }

    func testToQueryValueString() {
        let result = ObjectSerializer.toQueryValue("hello")
        XCTAssertEqual(result as? String, "hello")
    }

    func testToQueryValueStringSliceCSV() {
        let result = ObjectSerializer.toQueryValue(["a", "b", "c"], collectionFormat: "csv")
        XCTAssertEqual(result as? String, "a,b,c")
    }

    func testToQueryValueStringSliceSSV() {
        let result = ObjectSerializer.toQueryValue(["a", "b", "c"], collectionFormat: "ssv")
        XCTAssertEqual(result as? String, "a b c")
    }

    func testToQueryValueStringSlicePipes() {
        let result = ObjectSerializer.toQueryValue(["a", "b", "c"], collectionFormat: "pipes")
        XCTAssertEqual(result as? String, "a|b|c")
    }

    func testToQueryValueBoolTrue() {
        let result = ObjectSerializer.toQueryValue(true)
        XCTAssertEqual(result as? String, "true")
    }

    func testToQueryValueBoolFalse() {
        let result = ObjectSerializer.toQueryValue(false)
        XCTAssertEqual(result as? String, "false")
    }

    func testToQueryValueNil() {
        let result = ObjectSerializer.toQueryValue(nil)
        XCTAssertNil(result)
    }

    func testToHeaderValueString() {
        let result = ObjectSerializer.toHeaderValue("hello")
        XCTAssertEqual(result, "hello")
    }

    func testToHeaderValueStringSlice() {
        let result = ObjectSerializer.toHeaderValue(["a", "b", "c"])
        XCTAssertEqual(result, "a,b,c")
    }

    func testToHeaderValueNil() {
        let result = ObjectSerializer.toHeaderValue(nil)
        XCTAssertEqual(result, "")
    }

    func testToFormValueString() {
        let result = ObjectSerializer.toFormValue("hello")
        XCTAssertEqual(result, "hello")
    }

    func testToFormValueInt() {
        let result = ObjectSerializer.toFormValue(123)
        XCTAssertEqual(result, "123")
    }

    func testStringifyString() {
        XCTAssertEqual(ObjectSerializer.stringify("hello"), "hello")
    }

    func testStringifyInt() {
        XCTAssertEqual(ObjectSerializer.stringify(42), "42")
    }

    func testStringifyInt64() {
        XCTAssertEqual(ObjectSerializer.stringify(Int64(9999999999)), "9999999999")
    }

    func testStringifyFloat64() {
        let result = ObjectSerializer.stringify(3.14)
        XCTAssertTrue(result.hasPrefix("3.14"))
    }

    func testStringifyBool() {
        XCTAssertEqual(ObjectSerializer.stringify(true), "true")
        XCTAssertEqual(ObjectSerializer.stringify(false), "false")
    }

    func testStringifyDate() {
        let date = Date(timeIntervalSince1970: 1705315800)
        let result = ObjectSerializer.stringify(date)
        XCTAssertFalse(result.isEmpty)
    }

    func testStringifyNil() {
        XCTAssertEqual(ObjectSerializer.stringify(nil), "")
    }

    func testSerializeIncludesFieldsSetToDefaultValues() throws {
        let category = Category(id: 0, name: "")
        let json = try ObjectSerializer.serialize(category)
        XCTAssertTrue(json.contains("\"id\":0"), "serialized JSON should include id=0, got: \(json)")
        XCTAssertTrue(json.contains("\"name\":\"\""), "serialized JSON should include empty name, got: \(json)")
    }
}
