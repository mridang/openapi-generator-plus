    /* An API key authenticator never shows its key in its default debug output. */
    @Test func testBhvAuthapikey026AuthenticatorDoesNotLeakItsKeyInDebugOutput() throws {
        let auth = try ApiKeyAuthenticator(host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: "default-debug-value", location: .header)
        #expect(!String(reflecting: auth).contains("default-debug-value"))
        #expect(!String(describing: auth).contains("default-debug-value"))
    }

    @Test func testBhvAuthapikey012DescriptionShowsNonSecretFieldsAndMasksTheKey() throws {
        let auth = try ApiKeyAuthenticator(host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: "masked-key-value", location: .header)
        #expect(auth.description.contains("host: https://api.example.com"))
        #expect(auth.description.contains("keyParamName: X-API-Key"))
        #expect(auth.description.contains("location: header"))
        #expect(!auth.description.contains("masked-key-value"))
    }

    @Test func testBhvAuthapikey015ValidQueryKeyIsExposedInQueryParams() throws {
        let auth = try ApiKeyAuthenticator(host: "https://api.example.com", keyParamName: "api_key", apiKey: "abc123", location: .query)
