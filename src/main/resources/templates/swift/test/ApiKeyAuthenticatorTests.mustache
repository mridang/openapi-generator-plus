{{>api_info}}
import Foundation
import Testing
@testable import {{packageName}}

/* API key handling is validated here. Negative scenarios (empty/whitespace
 * key, CR/LF/NUL control characters, non-ASCII in a header key) throw
 * ConfigurationError.invalidArgument from ApiKeyAuthenticator.init. The
 * positive paths lock in the per-location emission contract and the
 * redaction guarantee. */
@Suite final class ApiKeyAuthenticatorTests {

    @Test func validHeaderKeyPasses() async throws {
        let auth = try ApiKeyAuthenticator(
            host: "https://api.example.com",
            keyParamName: "X-API-Key",
            apiKey: "abc123",
            location: .header
        )
        let headers = try await auth.authHeaders()
        #expect(headers["X-API-Key"] == "abc123")
    }

    @Test func validQueryKeyPasses() throws {
        let auth = try ApiKeyAuthenticator(
            host: "https://api.example.com",
            keyParamName: "api_key",
            apiKey: "abc123",
            location: .query
        )
        #expect(auth.queryParams() == ["api_key": "abc123"])
    }

    @Test func validCookieKeyPasses() throws {
        let auth = try ApiKeyAuthenticator(
            host: "https://api.example.com",
            keyParamName: "session",
            apiKey: "abc123",
            location: .cookie
        )
        #expect(auth.cookieParams() == ["session": "abc123"])
    }

    /* authenticator-secret-in-default-string-repr: the default string
     * representation must never expose the stored API key and must show the
     * `***` redaction marker. */
    @Test func redactsSecret() async throws {
        let auth = try ApiKeyAuthenticator(
            host: "https://api.example.com",
            keyParamName: "X-API-Key",
            apiKey: "abc123",
            location: .header
        )
        let description = String(describing: auth)
        #expect(!description.contains("abc123"))
        #expect(description.contains("***"))
        /* Everything except the secret stays visible. */
        #expect(
            description
                == "ApiKeyAuthenticator(host: https://api.example.com, keyParamName: X-API-Key, apiKey: ***, location: header)"
        )
        #expect(String(reflecting: auth) == description)
    }

    /* dump(_:) and Mirror(reflecting:) walk the stored properties, private ones
     * included, so the redacted description is not enough: the reflection
     * must hide the secret too. */
    @Test func dumpDoesNotLeakSecret() async throws {
        let auth = try ApiKeyAuthenticator(host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: "dump-secret-key", location: .header)
        var dumped = ""
        dump(auth, to: &dumped)
        #expect(!dumped.contains("dump-secret-key"), "dump leaked the secret: \(dumped)")
        #expect(Mirror(reflecting: auth).children.isEmpty)
    }

    /* Empty or whitespace-only keys and CR/LF/NUL are rejected at every
     * location, and RFC 7230 §3.2.6 rejects non-ASCII in a header key: each
     * with ConfigurationError.invalidArgument, never a trap. */
    @Test(arguments: [
        ("", ApiKeyLocation.header),
        ("   ", ApiKeyLocation.header),
        ("abc\r\n", ApiKeyLocation.query),
        ("abc\n", ApiKeyLocation.cookie),
        ("kéy", ApiKeyLocation.header),
    ])
    func invalidKeyIsRejectedAtConstruction(apiKey: String, location: ApiKeyLocation) {
        let error = #expect(throws: ConfigurationError.self) {
            _ = try ApiKeyAuthenticator(
                host: "https://api.example.com",
                keyParamName: "X-API-Key",
                apiKey: apiKey,
                location: location
            )
        }
        guard case .invalidArgument? = error else {
            Issue.record("expected ConfigurationError.invalidArgument, got \(String(describing: error))")
            return
        }
    }

    /* Each rejection branch reports its own exact message. */
    @Test(arguments: [
        ("", ApiKeyLocation.header, "API key value for 'X-API-Key' must not be empty"),
        ("  \t", ApiKeyLocation.cookie, "API key value for 'X-API-Key' must not be empty"),
        ("abc\r\n", ApiKeyLocation.query, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"),
        ("a\u{0}b", ApiKeyLocation.cookie, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"),
        ("a\nb", ApiKeyLocation.header, "API key value for 'X-API-Key' contains forbidden control characters (CR/LF/NUL)"),
        ("kéy", ApiKeyLocation.header, "API key for header 'X-API-Key' must contain only printable ASCII characters (RFC 7230 \u{A7}3.2.6)"),
        ("a\u{7F}b", ApiKeyLocation.header, "API key for header 'X-API-Key' must contain only printable ASCII characters (RFC 7230 \u{A7}3.2.6)"),
    ])
    func rejectionMessagesNameTheBranch(apiKey: String, location: ApiKeyLocation, message: String) {
        #expect(throws: ConfigurationError.invalidArgument(message)) {
            _ = try ApiKeyAuthenticator(
                host: "https://api.example.com", keyParamName: "X-API-Key", apiKey: apiKey, location: location)
        }
    }

    /* The printable-ASCII rule is for header values only: a query or cookie
     * value may carry any other character. */
    @Test(arguments: [ApiKeyLocation.query, ApiKeyLocation.cookie])
    func nonAsciiKeyIsAcceptedOutsideTheHeader(location: ApiKeyLocation) throws {
        let auth = try ApiKeyAuthenticator(
            host: "https://api.example.com", keyParamName: "k", apiKey: "kéy", location: location)
        let emitted = location == .query ? auth.queryParams() : auth.cookieParams()
        #expect(emitted == ["k": "kéy"])
    }

    /* The key is emitted at its own location and nowhere else. */
    @Test func keyIsEmittedOnlyAtItsOwnLocation() async throws {
        let cases: [(ApiKeyLocation, [String: String], [String: String], [String: String])] = [
            (.header, ["k": "v"], [:], [:]),
            (.query, [:], ["k": "v"], [:]),
            (.cookie, [:], [:], ["k": "v"]),
        ]
        for (location, header, query, cookie) in cases {
            let auth = try ApiKeyAuthenticator(
                host: "https://api.example.com", keyParamName: "k", apiKey: "v", location: location)
            #expect(await auth.authHeaders() == header, "headers for \(location)")
            #expect(auth.queryParams() == query, "query for \(location)")
            #expect(auth.cookieParams() == cookie, "cookies for \(location)")
        }
    }

    // MARK: - Generated scheme wrappers

    /* Each API-key securityScheme of the spec generates a wrapper that fixes
     * the scheme's key name and location: the key is emitted there and only
     * there, the empty key is still rejected eagerly with the scheme's key
     * name in the message, and the repr names the wrapper and masks the key. */
    @Test(arguments: [
        ("ApiKeyHeader", "X-API-Key", ApiKeyLocation.header),
        ("InternalApiKey", "X-Internal-Key", ApiKeyLocation.header),
        ("ApiKeyQuery", "api_key", ApiKeyLocation.query),
        ("SessionCookie", "SESSION_ID", ApiKeyLocation.cookie),
    ])
    func schemeWrapperEmitsItsKeyAtItsSpecLocation(scheme: String, name: String, location: ApiKeyLocation) async throws {
        let auth = try Self.schemeWrapper(scheme, apiKey: "wrapped-key")
        #expect(await auth.authHeaders() == (location == .header ? [name: "wrapped-key"] : [:]))
        #expect(auth.queryParams() == (location == .query ? [name: "wrapped-key"] : [:]))
        #expect(auth.cookieParams() == (location == .cookie ? [name: "wrapped-key"] : [:]))
        #expect(
            String(describing: auth)
                == "\(scheme)Authenticator(host: https://api.example.com, keyParamName: \(name), apiKey: ***, location: \(location))"
        )
    }

    @Test(arguments: [
        ("ApiKeyHeader", "X-API-Key"),
        ("InternalApiKey", "X-Internal-Key"),
        ("ApiKeyQuery", "api_key"),
        ("SessionCookie", "SESSION_ID"),
    ])
    func schemeWrapperRejectsAnEmptyKeyEagerly(scheme: String, name: String) {
        #expect(throws: ConfigurationError.invalidArgument("API key value for '\(name)' must not be empty")) {
            _ = try Self.schemeWrapper(scheme, apiKey: "")
        }
    }

    private static func schemeWrapper(_ scheme: String, apiKey: String) throws -> ApiKeyAuthenticator {
        let host = "https://api.example.com"
        switch scheme {
        case "ApiKeyHeader": return try ApiKeyHeaderAuthenticator(host: host, apiKey: apiKey)
        case "InternalApiKey": return try InternalApiKeyAuthenticator(host: host, apiKey: apiKey)
        case "ApiKeyQuery": return try ApiKeyQueryAuthenticator(host: host, apiKey: apiKey)
        default: return try SessionCookieAuthenticator(host: host, apiKey: apiKey)
        }
    }
}
