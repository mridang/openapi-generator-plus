import Foundation
import Testing
@testable import {{packageName}}

/* Negative scenarios (CR/LF/NUL/colon) trip `preconditionFailure`,
 * which traps the test process and cannot be exercised under Swift
 * Testing without `exitTest` (Swift 6.1+, not adopted here). The
 * positive path locks in the encoding contract; the validator's
 * trap behavior is documented in BasicAuthenticator.authHeaders. */
@Suite final class BasicAuthenticatorTests {

    @Test func validCredentialsProduceBasicHeader() async {
        let auth = BasicAuthenticator(
            host: "https://api.example.com",
            username: "alice",
            password: "s3cret"
        )
        let headers = await auth.authHeaders()
        #expect(headers["Authorization"] == "Basic YWxpY2U6czNjcmV0")
    }
}
