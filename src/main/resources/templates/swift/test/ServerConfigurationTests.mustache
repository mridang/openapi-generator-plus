{{>api_info}}
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class ServerConfigurationTests {

    @Test func urlWithoutVariablesReturnsTemplateVerbatim() throws {
        let server = ServerConfiguration(urlTemplate: "https://api.example.com/v1")
        #expect(try server.url() == "https://api.example.com/v1")
    }

    @Test func urlUsesDefaultVariableValues() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.api.example.com/v{version}",
            variables: [
                "env": ServerVariable(defaultValue: "prod"),
                "version": ServerVariable(defaultValue: "1"),
            ]
        )
        #expect(try server.url() == "https://prod.api.example.com/v1")
    }

    @Test func urlSubstitutesOverrides() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.api.example.com/v{version}",
            variables: [
                "env": ServerVariable(defaultValue: "prod"),
                "version": ServerVariable(defaultValue: "1"),
            ]
        )
        let resolved = try server.url(variables: ["env": "staging"])
        #expect(resolved == "https://staging.api.example.com/v1")
    }

    @Test func urlAcceptsOverrideInEnumValues() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.api.example.com",
            variables: [
                "env": ServerVariable(defaultValue: "prod", enumValues: ["prod", "staging"]),
            ]
        )
        #expect(try server.url(variables: ["env": "staging"]) == "https://staging.api.example.com")
    }

    @Test func urlRejectsOverrideNotInEnumValues() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.api.example.com",
            variables: [
                "env": ServerVariable(defaultValue: "prod", enumValues: ["prod", "staging"]),
            ]
        )
        #expect(throws: ServerConfigurationError.self) {
            _ = try server.url(variables: ["env": "dev"])
        }
    }

    @Test func urlRejectsDefaultNotInEnumValues() throws {
        // When no override is supplied, the default value is still validated
        // against the enum constraint.
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.api.example.com",
            variables: [
                "env": ServerVariable(defaultValue: "dev", enumValues: ["prod", "staging"]),
            ]
        )
        #expect(throws: ServerConfigurationError.self) {
            _ = try server.url()
        }
    }
}
