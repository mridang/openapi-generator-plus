    @Test func testBhvAuthbearer010{{className}}SendsTheTokenFromTheEnvironmentUnlessOneIsPassed() async throws {
        let fromEnvironment = try {{className}}(host: "https://api.example.com", token: nil, environment: [{{#envVars}}"{{envName}}": "env-token"{{/envVars}}])
        #expect(try await fromEnvironment.authHeaders() == ["Authorization": "Bearer env-token"])
        let explicit = try {{className}}(host: "https://api.example.com", token: "explicit-token", environment: [{{#envVars}}"{{envName}}": "env-token"{{/envVars}}])
        #expect(try await explicit.authHeaders() == ["Authorization": "Bearer explicit-token"])
    }

    @Test func testBhvAuthbearer018{{className}}AnExplicitTokenWinsOverTheEnvironment() async throws {
        let auth = try {{className}}(host: "https://api.example.com", token: "explicit-token", environment: [{{#envVars}}"{{envName}}": "from-environment", {{/envVars}}])
        #expect(try await auth.authHeaders() == ["Authorization": "Bearer explicit-token"])
    }

    /* The variable is read once, when the authenticator is built: a later change to
       the environment does not reach a token that is already held. */
    @Test func testBhvLifecycle025{{className}}ReadsTheEnvironmentOnceWhenBuilt() async throws {
        var environment = [{{#envVars}}"{{envName}}": "first", {{/envVars}}]
        let auth = try {{className}}(host: "https://api.example.com", token: nil, environment: environment)
        environment = [{{#envVars}}"{{envName}}": "second", {{/envVars}}]
        #expect(try await auth.authHeaders() == ["Authorization": "Bearer first"])
    }

{{#isFirstBearerScheme}}
    /* The variable is read once at construction, under the behaviour id of the first bearer scheme. */
    @Test func testBhvAuthbearer025{{className}}ReadsItsVariableOnceAtConstruction() async throws {
        var environment = [{{#envVars}}"{{envName}}": "first", {{/envVars}}]
        let auth = try {{className}}(host: "https://api.example.com", token: nil, environment: environment)
        environment = [{{#envVars}}"{{envName}}": "second", {{/envVars}}]
        #expect(try await auth.authHeaders() == ["Authorization": "Bearer first"])
    }
