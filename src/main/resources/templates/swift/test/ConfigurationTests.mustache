{{>api_info}}
import XCTest
@testable import {{packageName}}

final class ConfigurationTests: XCTestCase {

    func testDefaultValues() {
        let config = Configuration.default()

        XCTAssertEqual(config.baseURL, "{{{basePath}}}")
        XCTAssertTrue(config.defaultHeaders.isEmpty)
    }

    func testBuilderReturnsInstance() {
        let builder = ConfigurationBuilder()
        XCTAssertNotNil(builder)
    }

    func testBuilderSetsBaseURL() {
        let config = ConfigurationBuilder()
            .baseURL("https://custom.example.com")
            .build()

        XCTAssertEqual(config.baseURL, "https://custom.example.com")
    }

    func testBuilderSetsDefaultHeader() {
        let config = ConfigurationBuilder()
            .defaultHeader(name: "X-Custom", value: "value")
            .build()

        XCTAssertEqual(config.defaultHeaders["X-Custom"], "value")
    }

    func testBuilderSetsMultipleDefaultHeaders() {
        let config = ConfigurationBuilder()
            .defaultHeaders([
                "X-First": "one",
                "X-Second": "two"
            ])
            .build()

        XCTAssertEqual(config.defaultHeaders["X-First"], "one")
        XCTAssertEqual(config.defaultHeaders["X-Second"], "two")
    }

    func testBuilderChaining() {
        let config = ConfigurationBuilder()
            .baseURL("https://api.example.com")
            .defaultHeader(name: "Authorization", value: "Bearer token")
            .build()

        XCTAssertEqual(config.baseURL, "https://api.example.com")
        XCTAssertEqual(config.defaultHeaders["Authorization"], "Bearer token")
    }

    func testServerURLResolution() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.example.com/api/{version}",
            description: "Test server",
            variables: [
                "env": ServerVariable(
                    defaultValue: "api",
                    enumValues: ["api", "staging"]
                ),
                "version": ServerVariable(
                    defaultValue: "v3",
                    enumValues: ["v2", "v3"]
                )
            ]
        )

        let config = try ConfigurationBuilder()
            .server(server, variables: ["env": "staging"])
            .build()

        XCTAssertEqual(config.baseURL, "https://staging.example.com/api/v3")
    }

    func testServerURLResolutionWithDefaults() throws {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.example.com/api/{version}",
            description: "Test server",
            variables: [
                "env": ServerVariable(
                    defaultValue: "api",
                    enumValues: ["api", "staging"]
                ),
                "version": ServerVariable(
                    defaultValue: "v3",
                    enumValues: ["v2", "v3"]
                )
            ]
        )

        let config = try ConfigurationBuilder()
            .server(server)
            .build()

        XCTAssertEqual(config.baseURL, "https://api.example.com/api/v3")
    }

    func testBaseURLOverride() {
        let config = ConfigurationBuilder()
            .baseURL("https://original.example.com")
            .baseURL("https://override.example.com")
            .build()

        XCTAssertEqual(config.baseURL, "https://override.example.com")
    }

    func testDefaultHeadersCopyIsolation() {
        let config = ConfigurationBuilder()
            .defaultHeader(name: "X-Test", value: "value")
            .build()

        var headers = config.defaultHeaders
        headers["X-Mutated"] = "should-not-affect-config"

        XCTAssertNil(config.defaultHeaders["X-Mutated"],
            "Modifying returned headers should not affect the configuration")
    }

    func testBuilderAccumulatesMultipleHeaders() {
        let config = ConfigurationBuilder()
            .defaultHeader(name: "X-First", value: "one")
            .defaultHeader(name: "X-Second", value: "two")
            .build()

        XCTAssertEqual(config.defaultHeaders.count, 2)
        XCTAssertEqual(config.defaultHeaders["X-First"], "one")
        XCTAssertEqual(config.defaultHeaders["X-Second"], "two")
    }

    func testBuilderMergesSingleAndBulkHeaders() {
        let config = ConfigurationBuilder()
            .defaultHeader(name: "X-First", value: "one")
            .defaultHeaders(["X-Second": "two"])
            .defaultHeader(name: "X-Third", value: "three")
            .build()

        XCTAssertEqual(config.defaultHeaders.count, 3)
        XCTAssertEqual(config.defaultHeaders["X-First"], "one")
        XCTAssertEqual(config.defaultHeaders["X-Second"], "two")
        XCTAssertEqual(config.defaultHeaders["X-Third"], "three")
    }

    func testInvalidServerVariableEnumValueThrows() {
        let server = ServerConfiguration(
            urlTemplate: "https://{env}.example.com",
            variables: [
                "env": ServerVariable(defaultValue: "api", enumValues: ["api", "staging"])
            ]
        )

        XCTAssertThrowsError(
            try ConfigurationBuilder().server(server, variables: ["env": "invalid"]).build()
        )
    }

    func testBuilderProducesIndependentInstances() {
        let builder = ConfigurationBuilder().baseURL("https://example.com")
        let first = builder.build()
        let second = builder.build()

        XCTAssertEqual(first.baseURL, second.baseURL)
        XCTAssertFalse(first === second as AnyObject,
            "Build() should produce independent instances")
    }
}
