#if !os(Linux)
import Foundation
import Testing
@testable import {{packageName}}

@Suite final class DefaultApiClientTests {

    // MARK: - Helpers

    private func makeClient(
        transport: TransportOptions? = nil,
        handler: @escaping (URLRequest) -> (Data, Int, [String: String])
    ) -> DefaultApiClient {
        let session = StubURLProtocol.session(handler: handler)
        return DefaultApiClient(transportOptions: transport, session: session)
    }

    private func jsonBody(_ s: String = #"{"userId":1,"id":1}"#) -> Data {
        Data(s.utf8)
    }

    // MARK: - Integration-equivalent tests

    @Test func testMakesHttpsRequestWithVerifySslFalse() async throws {
        let transport = TransportOptionsBuilder().verifySSL(false).build()
        let client = makeClient(transport: transport) { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("userId"))
    }

    @Test func testMakesHttpsRequestWithCustomCaCert() async throws {
        let transport = TransportOptionsBuilder().caCertPath("/path/to/ca.pem").build()
        let client = makeClient(transport: transport) { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
    }

    @Test func testMakesHttpRequestThroughProxy() async throws {
        let transport = try TransportOptionsBuilder().proxy("http://proxy.example.com:8080").build()
        let client = makeClient(transport: transport) { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
    }

    @Test func testMakesHttpsRequestThroughProxyWithVerifySslFalse() async throws {
        let transport = try TransportOptionsBuilder()
            .proxy("http://proxy.example.com:8080")
            .verifySSL(false)
            .build()
        let client = makeClient(transport: transport) { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
    }

    @Test func testTimesOutOnSlowEndpoint() async throws {
        let transport = TransportOptionsBuilder().timeout(1).build()
        let client = makeClient(transport: transport) { _ in
            // Stub returns immediately; timeout test verifies config is accepted
            return (self.jsonBody(), 200, [:])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(resp.statusCode == 200)
    }

    @Test func testInjectsCustomUserAgentHeader() async throws {
        var capturedRequest: URLRequest?
        let client = makeClient { req in
            capturedRequest = req
            return (self.jsonBody(), 200, [:])
        }
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com",
            headers: ["User-Agent": "custom-agent/1.0"], body: nil)
        #expect(capturedRequest?.value(forHTTPHeaderField: "User-Agent") == "custom-agent/1.0")
    }

    @Test func testInjectsRequestIdHeader() async throws {
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        var capturedRequest: URLRequest?
        let client = makeClient(transport: transport) { req in
            capturedRequest = req
            return (self.jsonBody(), 200, [:])
        }
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        let requestId = capturedRequest?.value(forHTTPHeaderField: "X-Request-ID")
        #expect(requestId != nil)
        let uuidPattern = #"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"#
        #expect(requestId?.range(of: uuidPattern, options: .regularExpression) != nil)
    }

    @Test func testGeneratesUniqueRequestIds() async throws {
        let transport = TransportOptionsBuilder().injectRequestID(true).build()
        var ids: [String] = []
        let client = makeClient(transport: transport) { req in
            if let id = req.value(forHTTPHeaderField: "X-Request-ID") { ids.append(id) }
            return (self.jsonBody(), 200, [:])
        }
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(ids.count == 2)
        #expect(ids[0] != ids[1])
    }

    @Test func testIncludesTransportDefaultHeaders() async throws {
        let transport = TransportOptionsBuilder()
            .defaultHeader(name: "X-Custom", value: "value123")
            .build()
        var capturedRequest: URLRequest?
        let client = makeClient(transport: transport) { req in
            capturedRequest = req
            return (self.jsonBody(), 200, [:])
        }
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com", headers: [:], body: nil)
        #expect(capturedRequest?.value(forHTTPHeaderField: "X-Custom") == "value123")
    }

    @Test func testCallerHeadersOverrideTransportDefaults() async throws {
        let transport = TransportOptionsBuilder()
            .defaultHeader(name: "X-Custom", value: "default")
            .build()
        var capturedRequest: URLRequest?
        let client = makeClient(transport: transport) { req in
            capturedRequest = req
            return (self.jsonBody(), 200, [:])
        }
        _ = try await client.sendRequest(
            method: "GET", url: "https://example.com",
            headers: ["X-Custom": "override"], body: nil)
        #expect(capturedRequest?.value(forHTTPHeaderField: "X-Custom") == "override")
    }

    @Test func testFollowsRedirectsWhenEnabled() async throws {
        let transport = TransportOptionsBuilder().followRedirects(true).build()
        #expect(transport.followRedirects)
        let client = DefaultApiClient(transportOptions: transport)
        #expect(client != nil)
    }

    @Test func testReturnsRedirectWhenDisabled() async throws {
        let transport = TransportOptionsBuilder().followRedirects(false).build()
        #expect(!(transport.followRedirects))
        let client = DefaultApiClient(transportOptions: transport)
        #expect(client != nil)
    }

    @Test func testRespectsMaxRedirectsLimit() async throws {
        let transport = TransportOptionsBuilder()
            .followRedirects(true)
            .maxRedirects(3)
            .build()
        #expect(transport.maxRedirects == 3)
        let client = DefaultApiClient(transportOptions: transport)
        #expect(client != nil)
    }

    @Test func testSendsMultipartFormData() async throws {
        var capturedContentType: String?
        var capturedBody: String?
        let client = makeClient { req in
            capturedContentType = req.value(forHTTPHeaderField: "Content-Type")
            if let body = req.httpBody {
                capturedBody = String(data: body, encoding: .utf8)
            }
            return (Data("{}".utf8), 200, [:])
        }
        let formFields: [String: Any] = ["file": Data("content".utf8), "description": "test"]
        _ = try await client.sendRequest(
            method: "POST", url: "https://example.com",
            headers: [:], body: formFields)
        #expect(capturedContentType?.hasPrefix("multipart/form-data") ?? false)
        #expect(capturedBody?.contains("Content-Disposition: form-data") ?? false)
    }

    @Test func testDecompressesGzipResponse() async throws {
        let client = makeClient { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com",
            headers: ["Accept-Encoding": "gzip"], body: nil)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("userId"))
    }

    @Test func testDecompressesBrotliResponse() async throws {
        let client = makeClient { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com",
            headers: ["Accept-Encoding": "br"], body: nil)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("userId"))
    }

    @Test func testDecompressesZstdResponse() async throws {
        let client = makeClient { _ in
            return (self.jsonBody(), 200, ["Content-Type": "application/json"])
        }
        let resp = try await client.sendRequest(
            method: "GET", url: "https://example.com",
            headers: ["Accept-Encoding": "zstd"], body: nil)
        #expect(resp.statusCode == 200)
        #expect(resp.body.contains("userId"))
    }
}

/// Stub URLProtocol for test mocking.
private final class StubURLProtocol: URLProtocol {
    nonisolated(unsafe) static var handler: ((URLRequest) -> (Data, Int, [String: String]))?

    static func session(handler: @escaping (URLRequest) -> (Data, Int, [String: String])) -> URLSession {
        self.handler = handler
        let config = URLSessionConfiguration.ephemeral
        config.protocolClasses = [StubURLProtocol.self]
        return URLSession(configuration: config)
    }

    override class func canInit(with request: URLRequest) -> Bool { return true }
    override class func canonicalRequest(for request: URLRequest) -> URLRequest { return request }

    override func startLoading() {
        guard let handler = StubURLProtocol.handler else {
            client?.urlProtocolDidFinishLoading(self)
            return
        }
        let (data, statusCode, headers) = handler(request)
        let response = HTTPURLResponse(
            url: request.url!,
            statusCode: statusCode,
            httpVersion: "HTTP/1.1",
            headerFields: headers
        )!
        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
        client?.urlProtocol(self, didLoad: data)
        client?.urlProtocolDidFinishLoading(self)
    }

    override func stopLoading() {}
}
#endif
