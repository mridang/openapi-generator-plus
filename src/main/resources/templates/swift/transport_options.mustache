import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

/// Immutable HTTP transport configuration for ``DefaultApiClient``.
///
/// Controls low-level HTTP behavior such as TLS verification, proxy routing,
/// timeouts, redirect handling, and automatic header injection. These settings
/// are independent of API-level concerns (base URL, authentication headers)
/// which belong in ``Configuration``.
///
/// This class is immutable and thread-safe. Use ``TransportOptions/builder()``
/// to create instances:
///
/// ```swift
/// let transport = try TransportOptions.builder()
///     .verifySsl(false)
///     .proxy("http://proxy.example.com:8080")
///     .timeout(30000)
///     .userAgent("MyApp/1.0")
///     .build()
/// ```
public final class TransportOptions: Sendable {
    /// Whether TLS certificate verification is enabled.
    ///
    /// True if the client verifies server certificates (default), false to
    /// accept any certificate.
    public let verifySsl: Bool

    /// Path to a custom CA certificate bundle for TLS verification.
    ///
    /// When set together with `verifySsl == true`, the client trusts
    /// certificates signed by this CA in addition to (or instead of) the
    /// system trust store. `nil` uses the system default.
    public let caCertPath: String?

    /// HTTP or HTTPS proxy URL for all outbound requests.
    ///
    /// Example: `"http://proxy.corp.example.com:3128"`. `nil` means direct
    /// connections.
    public let proxy: URL?

    /// End-to-end request timeout in milliseconds.
    ///
    /// Covers the entire request lifecycle: connection, TLS handshake,
    /// sending the request body, and reading the response. Defaults to
    /// 10000 ms (10 seconds) when the builder does not set a value. A `nil`
    /// value means no timeout.
    public let timeout: Int?

    /// Whether the client follows HTTP 3xx redirects automatically.
    ///
    /// True to follow redirects (default), false to return the redirect
    /// response as-is.
    public let followRedirects: Bool

    /// Maximum number of consecutive redirects to follow.
    ///
    /// Only meaningful when ``followRedirects`` is true. A value of `nil` uses
    /// the HTTP client's built-in default. A value of 0 means zero redirects.
    public let maxRedirects: Int?

    /// Custom `User-Agent` header value.
    ///
    /// When set, this value is sent as the `User-Agent` header on every
    /// request unless the caller explicitly provides one. `nil` to omit.
    public let userAgent: String?

    /// Transport-level default headers included in every request.
    ///
    /// These headers have the *lowest* priority: API-level headers from
    /// ``Configuration/defaultHeaders``, operation-specific headers, and
    /// authentication headers all take precedence.
    private let _defaultHeaders: [String: String]

    /// A copy of the transport-level default headers.
    public var defaultHeaders: [String: String] {
        return _defaultHeaders
    }

    /// Whether to auto-inject an `X-Request-ID` header with a unique UUID on
    /// every request.
    ///
    /// Useful for distributed tracing and log correlation. The header is only
    /// injected if the caller has not already set one.
    public let injectRequestID: Bool

    /// A caller-supplied `URLSession` to send requests through, or `nil` to
    /// have the SDK build its own.
    ///
    /// The SDK keeps applying its defaults on top of a supplied session: the
    /// timeout, the `User-Agent`, the default headers and the request id are
    /// set per request. The caller owns the session's lifecycle, so
    /// ``DefaultApiClient/close()`` never invalidates it. A session cannot be
    /// combined with the SDK's own proxy, TLS or redirect settings;
    /// ``TransportOptionsBuilder/build()`` rejects that combination.
    public let session: URLSession?

    /// Maximum number of automatic retries after the first attempt.
    ///
    /// Defaults to 2; 0 disables retries. A request is retried after a network
    /// error that happened before any response arrived, and after a response
    /// with status 408, 409, 429 or 500 to 599 (not 501), waiting 0.5 s
    /// doubling up to 8 s with 25% jitter, or the server's `Retry-After`
    /// (capped at 60 s). The ``timeout`` stays the single end-to-end budget:
    /// retries never extend it. A body that cannot be replayed is never
    /// retried.
    public let maxRetries: Int

    fileprivate init(
        verifySsl: Bool,
        caCertPath: String?,
        proxy: URL?,
        timeout: Int?,
        followRedirects: Bool,
        maxRedirects: Int?,
        userAgent: String?,
        defaultHeaders: [String: String],
        injectRequestID: Bool,
        session: URLSession?,
        maxRetries: Int
    ) {
        self.verifySsl = verifySsl
        self.caCertPath = caCertPath
        self.proxy = proxy
        self.timeout = timeout
        self.followRedirects = followRedirects
        self.maxRedirects = maxRedirects
        self.userAgent = userAgent
        self._defaultHeaders = defaultHeaders
        self.injectRequestID = injectRequestID
        self.session = session
        self.maxRetries = maxRetries
    }

    /// Create a new builder for constructing ``TransportOptions`` instances.
    ///
    /// - Returns: A new builder with sensible defaults.
    public static func builder() -> TransportOptionsBuilder {
        return TransportOptionsBuilder()
    }

    /// The options a builder yields when nothing is set. No proxy is
    /// configured, so there is nothing to validate and no way to fail.
    static var defaults: TransportOptions {
        return TransportOptionsBuilder().assemble(proxy: nil)
    }
}

/// Builder for creating immutable ``TransportOptions`` instances.
///
/// All fields have sensible defaults:
/// - `verifySsl`: `true`
/// - `followRedirects`: `true`
/// - `injectRequestID`: `false`
/// - `timeout`: `10000` (10 seconds)
/// - `maxRetries`: `2`
/// - `userAgent`: a package-specific default string
/// - All other fields: `nil` or empty
public final class TransportOptionsBuilder {
    private var verifySsl: Bool = true
    private var caCertPath: String? = nil
    private var proxy: String? = nil
    private var timeout: Int? = 10000
    private var followRedirects: Bool = true
    private var maxRedirects: Int? = nil
    private var userAgent: String? = "{{userAgentDefault}}"
    private var defaultHeaders: [String: String] = [:]
    private var injectRequestID: Bool = false
    private var session: URLSession? = nil
    private var maxRetries: Int = 2

    public init() {}

    /// Enable or disable TLS certificate verification.
    @discardableResult
    public func verifySsl(_ val: Bool) -> TransportOptionsBuilder {
        self.verifySsl = val
        return self
    }

    /// Set the path to a custom CA certificate bundle.
    @discardableResult
    public func caCertPath(_ val: String?) -> TransportOptionsBuilder {
        self.caCertPath = val
        return self
    }

    /// Set the HTTP/HTTPS proxy URL.
    ///
    /// Only HTTP and HTTPS proxy URLs are supported. The value is validated
    /// when ``build()`` runs, not here, so an invalid URL surfaces at the same
    /// point as every other configuration error.
    @discardableResult
    public func proxy(_ val: String?) -> TransportOptionsBuilder {
        if let val = val, !val.isEmpty {
            self.proxy = val
        } else {
            self.proxy = nil
        }
        return self
    }

    /// Set the end-to-end request timeout in milliseconds (`nil` for no
    /// timeout). A value that is not positive is rejected by ``build()``.
    @discardableResult
    public func timeout(_ val: Int?) -> TransportOptionsBuilder {
        self.timeout = val
        return self
    }

    /// Enable or disable automatic redirect following.
    @discardableResult
    public func followRedirects(_ val: Bool) -> TransportOptionsBuilder {
        self.followRedirects = val
        return self
    }

    /// Set the maximum number of redirects to follow (`nil` for the client default).
    @discardableResult
    public func maxRedirects(_ val: Int?) -> TransportOptionsBuilder {
        self.maxRedirects = val
        return self
    }

    /// Set a custom User-Agent header value (`nil` to omit).
    @discardableResult
    public func userAgent(_ val: String?) -> TransportOptionsBuilder {
        self.userAgent = val
        return self
    }

    /// Add a single transport-level default header.
    @discardableResult
    public func defaultHeader(name: String, value: String) -> TransportOptionsBuilder {
        self.defaultHeaders[name] = value
        return self
    }

    /// Add multiple transport-level default headers.
    @discardableResult
    public func defaultHeaders(_ headers: [String: String]) -> TransportOptionsBuilder {
        for (k, v) in headers {
            self.defaultHeaders[k] = v
        }
        return self
    }

    /// Enable or disable automatic `X-Request-ID` header injection.
    @discardableResult
    public func injectRequestID(_ val: Bool) -> TransportOptionsBuilder {
        self.injectRequestID = val
        return self
    }

    /// Send requests through a caller-supplied `URLSession`.
    ///
    /// The SDK keeps its timeout, `User-Agent`, default headers and request id
    /// on top of the session, and never invalidates it: the caller owns its
    /// lifecycle. Do not combine it with ``proxy(_:)``, ``caCertPath(_:)``,
    /// ``verifySsl(_:)`` set to false, ``followRedirects(_:)`` set to false or
    /// ``maxRedirects(_:)``: those are properties of the session itself, and
    /// ``build()`` rejects the conflict.
    @discardableResult
    public func session(_ val: URLSession?) -> TransportOptionsBuilder {
        self.session = val
        return self
    }

    /// Set the maximum number of automatic retries (0 disables them).
    ///
    /// A negative value is rejected by ``build()``.
    @discardableResult
    public func maxRetries(_ val: Int) -> TransportOptionsBuilder {
        self.maxRetries = val
        return self
    }

    /// Build and return an immutable ``TransportOptions`` instance.
    ///
    /// - Throws: ``ConfigurationError/invalidProxy(_:)`` if the proxy URL is
    ///   not valid or does not use the http or https scheme,
    ///   ``ConfigurationError/invalidTimeout(_:)`` if the timeout is zero or
    ///   negative, ``ConfigurationError/invalidArgument(_:)`` if `maxRetries`
    ///   is negative, and
    ///   ``ConfigurationError/invalidArgument(_:)`` if a supplied session is
    ///   combined with a proxy, a CA certificate, disabled TLS verification
    ///   or a redirect policy.
    public func build() throws -> TransportOptions {
        if let timeout = timeout, timeout <= 0 {
            throw ConfigurationError.invalidTimeout(timeout)
        }
        if maxRetries < 0 {
            throw ConfigurationError.invalidArgument("maxRetries must not be negative: \(maxRetries)")
        }
        if let maxRedirects = maxRedirects, maxRedirects < 0 {
            throw ConfigurationError.invalidArgument("maxRedirects must not be negative: \(maxRedirects)")
        }
        var parsedProxy: URL? = nil
        if let val = proxy {
            /* A string with no scheme at all is "not a valid URL", whether or
               not the platform's parser accepts it (Foundation on Linux
               percent-encodes spaces and parses it as a relative reference). */
            guard let parsed = URL(string: val), parsed.scheme?.isEmpty == false else {
                throw ConfigurationError.invalidProxyURL(val)
            }
            let scheme = parsed.scheme?.lowercased() ?? ""
            guard scheme == "http" || scheme == "https" else {
                throw ConfigurationError.invalidProxyURL(val, reason: "must use http or https scheme")
            }
            guard let host = parsed.host, !host.isEmpty else {
                throw ConfigurationError.invalidProxyURL(val, reason: "missing host")
            }
            parsedProxy = parsed
        }
        if session != nil {
            var conflicts: [String] = []
            if parsedProxy != nil { conflicts.append("proxy") }
            if caCertPath != nil { conflicts.append("caCertPath") }
            if !verifySsl { conflicts.append("verifySsl(false)") }
            if !followRedirects { conflicts.append("followRedirects(false)") }
            if maxRedirects != nil { conflicts.append("maxRedirects") }
            if !conflicts.isEmpty {
                throw ConfigurationError.invalidArgument(
                    "a supplied URLSession conflicts with the SDK's own settings: "
                        + conflicts.joined(separator: ", ")
                        + "; configure them on the session instead")
            }
        }
        return assemble(proxy: parsedProxy)
    }

    fileprivate func assemble(proxy: URL?) -> TransportOptions {
        return TransportOptions(
            verifySsl: verifySsl,
            caCertPath: caCertPath,
            proxy: proxy,
            timeout: timeout,
            followRedirects: followRedirects,
            maxRedirects: maxRedirects,
            userAgent: userAgent,
            defaultHeaders: defaultHeaders,
            injectRequestID: injectRequestID,
            session: session,
            maxRetries: maxRetries
        )
    }
}

extension TransportOptions: CustomStringConvertible, CustomDebugStringConvertible {
    /// The options with the proxy password and every credential-bearing default
    /// header shown as `***`, so `String(describing:)` and `String(reflecting:)`
    /// never print a secret.
    public var description: String {
        var shownProxy = "nil"
        if let proxy = proxy {
            var parts = URLComponents(url: proxy, resolvingAgainstBaseURL: false)
            if parts?.password != nil {
                parts?.password = "***"
            }
            shownProxy = parts?.string ?? proxy.absoluteString
        }
        let headers = ApiError.compactJson(ApiError.maskingSecrets(defaultHeaders))
        return "TransportOptions(proxy: \(shownProxy), defaultHeaders: \(headers))"
    }

    /// The same text as ``description``, so `String(reflecting:)` never shows a secret either.
    public var debugDescription: String {
        description
    }
}
