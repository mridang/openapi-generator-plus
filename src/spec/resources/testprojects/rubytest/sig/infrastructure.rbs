module PetstoreClient
  def self.configure: () { (Configuration::Builder) -> void } -> void
                    | () -> Configuration

  VERSION: String

  class Configuration
    attr_reader base_url: String
    attr_reader default_headers: Hash[String, String]
    attr_reader debug: bool
    attr_reader verify_ssl: bool
    attr_reader ssl_ca_cert: String?
    attr_reader cert_file: String?
    attr_reader key_file: String?
    attr_reader proxy: String?
    attr_reader timeout: Integer?
    attr_reader retries: Integer?
    def initialize: (base_url: String, default_headers: Hash[String, String], debug: bool, verify_ssl: bool, ssl_ca_cert: String?, cert_file: String?, key_file: String?, proxy: String?, timeout: Integer?, retries: Integer?) -> void
    def self.builder: () -> Configuration::Builder
    def self.default: () -> Configuration
    def self.default=: (Configuration) -> Configuration

    class Builder
      def base_url: (String) -> Builder
      def default_header: (String, String) -> Builder
      def default_headers: (Hash[String, String]) -> Builder
      def debug: (bool) -> Builder
      def verify_ssl: (bool) -> Builder
      def ssl_ca_cert: (String?) -> Builder
      def cert_file: (String?) -> Builder
      def key_file: (String?) -> Builder
      def proxy: (String?) -> Builder
      def timeout: (Integer?) -> Builder
      def retries: (Integer?) -> Builder
      def build: () -> Configuration
    end
  end

  class ApiResponse
    attr_reader status_code: Integer
    attr_reader body: String
    attr_reader headers: Hash[String, String]
    def initialize: (status_code: Integer, body: String, headers: Hash[String, String]) -> void
  end

  class ApiError < StandardError
    attr_reader code: Integer?
    attr_reader response_headers: Hash[String, String]?
    attr_reader response_body: String?
    def initialize: (?untyped) -> void
    def message: () -> String
  end

  class ApiClient
    def send_request: (Symbol, String, Hash[String, String], untyped) -> ApiResponse
  end

  class DefaultApiClient < ApiClient
    def initialize: (?Configuration?) -> void
    def send_request: (Symbol, String, Hash[String, String], untyped) -> ApiResponse
    def self.supported_encodings: () -> String
    private
    def decompress_body: (untyped, untyped) -> untyped
    def build_connection: () -> untyped
    def build_multipart_body: (Hash[String, untyped], String) -> String
    def multipart_part: (String, untyped, String) -> String
  end

  class SerializationError < StandardError
    attr_reader cause: Exception?
    def initialize: (String, ?Exception?) -> void
  end

  class SchemaMismatchError < StandardError
  end

  class ObjectSerializer
    DEFAULT_DATETIME_FORMAT: String
    def self.serialize: (untyped) -> String
    def self.deserialize: (untyped, String) -> untyped
    def self.to_path_value: (untyped) -> String
    def self.to_query_value: (untyped, ?Symbol?) -> untyped
    def self.to_header_value: (untyped) -> String
    def self.to_form_value: (untyped) -> String
    def self.convert_to_type: (untyped, String) -> untyped
    def self.find_and_cast_into_type: (untyped, untyped) -> untyped
    def self.sanitize_for_serialization: (untyped) -> untyped
    def self.deserialize_model: (untyped, untyped) -> untyped
  end

  class TraceContextUtil
    def self.inject_trace_context: (Hash[String, String]) -> void
  end

  class HeaderSelector
    JSON_MIME_PATTERN: Regexp
    WEIGHT_PATTERN: Regexp
    HeaderData: untyped
    def select_headers: (Array[String], String, bool) -> Hash[String, String]
    def json_mime?: (String?) -> bool
    def get_next_weight: (Integer, bool) -> Integer
    private
    def select_accept_header: (Array[String]?) -> String?
    def select_json_mime_list: (Array[String]) -> Array[String]
    def get_accept_header_with_adjusted_weight: (Array[String], Array[String]) -> String
    def get_header_and_weight: (String) -> untyped
    def adjust_weight: (Array[untyped], Array[Integer], bool) -> Array[String]
    def build_accept_header: (String, Integer) -> String
  end

  module Auth
    class Authenticator
      def host: () -> String
      def auth_headers: () -> Hash[String, String]
      def query_params: () -> Hash[String, String]
      def cookie_params: () -> Hash[String, String]
    end

    class BasicAuthenticator < Authenticator
      def initialize: (String, String, String) -> void
    end

    class BearerAuthenticator < Authenticator
      def initialize: (String, String) -> void
    end

    class ApiKeyAuthenticator < Authenticator
      def initialize: (String, String, String, Symbol) -> void
    end

    module OAuth
      class OAuth2ClientCredentialsAuthenticator < Authenticator
        def initialize: (String, String, String, String, Array[String]) -> void
      end
      class OAuth2PasswordAuthenticator < Authenticator
        def initialize: (String, String, String, String, String, String, Array[String]) -> void
      end
      class OAuth2AuthorizationCodeAuthenticator < Authenticator
        def initialize: (String, String, String, String, String, String, Array[String]) -> void
        def build_authorization_url: (?String?) -> String
        def exchange_code: (String) -> void
      end
      class OAuth2ImplicitAuthenticator < Authenticator
        def initialize: (String, String, Array[String]) -> void
        def build_authorization_url: (?String?) -> String
        def access_token=: (String) -> void
      end
      class OpenIdConnectAuthenticator < Authenticator
        def initialize: (String, String, String, String, String, Array[String]) -> void
        def build_authorization_url: (?String?) -> String
        def exchange_code: (String) -> void
        private
        def resolve_delegate: () -> OAuth2AuthorizationCodeAuthenticator
      end

      class OAuth2TokenManager
        def initialize: () -> void
        def get_access_token: (String, Hash[String, String]) -> String
        def access_token=: (String) -> void
        private
        def fetch_token: (String, Hash[String, String]) -> void
      end
    end
  end

  class Client
    attr_reader pet: Api::PetApi
    attr_reader store: Api::StoreApi
    def initialize: (Auth::Authenticator) -> void
    def self.with_token: (String, String) -> Client
  end

  module Models
  end

  module Api
    class BaseApi
      attr_reader config: Configuration
      def initialize: (?ApiClient?, ?Configuration) -> void
      def invoke_api: (Symbol, String, Hash[String, untyped], Hash[String, String], untyped, Array[String], String?, String?, Auth::Authenticator?) -> untyped
      def build_collection_param: (Array[untyped], Symbol) -> untyped
      private
      def build_query_string: (Hash[String, untyped]) -> String
      def serialize_body: (untyped, String?) -> untyped
    end
  end
end
