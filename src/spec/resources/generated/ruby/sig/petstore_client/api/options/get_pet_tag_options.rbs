module PetstoreClient
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_accessor types
      # are nullable only for optional parameters.
      class GetPetTagOptions
        attr_accessor colors: Array[String]?
        attr_accessor sizes: Array[String]?
        attr_accessor filter: String?
        def initialize: (?colors: Array[String]?, ?sizes: Array[String]?, ?filter: String?) -> void
      end
    end
  end
end
