module PetstoreClient
  module Api
    module Options
      # All attr_accessor types are nullable and all initialize keyword
      # arguments are optional, even for parameters that are required by the
      # OpenAPI specification.  This is intentional: the API method signatures
      # use `options = Options::XxxOptions.new` as a default value, which
      # calls the constructor with zero arguments.  If any keyword were
      # non-optional, `.new` would raise ArgumentError.  Required-ness is
      # therefore enforced by the remote API server, not the client library.
      class UploadPetCertificateOptions
        attr_accessor file: File?
        def initialize: (?file: File?) -> void
      end
    end
  end
end
