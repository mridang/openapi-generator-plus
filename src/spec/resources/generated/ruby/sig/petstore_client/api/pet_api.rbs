      def upload_pet_certificate: (Integer pet_id, Options::UploadPetCertificateOptions options) -> Models::ApiResponse
      def upload_pet_certificate_with_http_info: (Integer pet_id, Options::UploadPetCertificateOptions options) -> ::PetstoreClient::ApiResult[Models::ApiResponse]
      def upload_pet_document: (Integer pet_id, Options::UploadPetDocumentOptions options) -> Models::ApiResponse
