module PetstoreClient
  module Api
    class PetApi < BaseApi
      def initialize: (?::PetstoreClient::ApiClient? api_client, ?::PetstoreClient::Configuration config) -> void
      def add_pet: (::PetstoreClient::Auth::Authenticator auth, Models::Pet pet) -> untyped
      def add_pet_with_http_info: (::PetstoreClient::Auth::Authenticator auth, Models::Pet pet) -> ::PetstoreClient::ApiResult
      def add_pet_photos: (Integer pet_id, files: Array[File], metadata: Models::PhotoMetadata) -> untyped
      def add_pet_photos_with_http_info: (Integer pet_id, files: Array[File], metadata: Models::PhotoMetadata) -> ::PetstoreClient::ApiResult
      def delete_pet: (::PetstoreClient::Auth::Authenticator auth, Integer pet_id) -> untyped
      def delete_pet_with_http_info: (::PetstoreClient::Auth::Authenticator auth, Integer pet_id) -> ::PetstoreClient::ApiResult
      def download_pet_document: (Integer pet_id, Integer document_id) -> untyped
      def download_pet_document_with_http_info: (Integer pet_id, Integer document_id) -> ::PetstoreClient::ApiResult
      def find_pets_by_status: (?status: String?, ?filter: Hash[String, String]?) -> untyped
      def find_pets_by_status_with_http_info: (?status: String?, ?filter: Hash[String, String]?) -> ::PetstoreClient::ApiResult
      def get_external_pet_info: (Integer pet_id) -> untyped
      def get_external_pet_info_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_multi_server_pet_info: (Integer pet_id) -> untyped
      def get_multi_server_pet_info_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_pet_avatar: (Integer pet_id) -> untyped
      def get_pet_avatar_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_pet_avatar_thumbnail: (Integer pet_id) -> untyped
      def get_pet_avatar_thumbnail_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_pet_by_id: (Integer pet_id) -> untyped
      def get_pet_by_id_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_pet_passport: (Integer pet_id) -> untyped
      def get_pet_passport_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def get_pet_photo: (Integer pet_id, Integer photo_id) -> untyped
      def get_pet_photo_with_http_info: (Integer pet_id, Integer photo_id) -> ::PetstoreClient::ApiResult
      def get_pet_tag: (Integer pet_id, String tag_name, ?colors: Array[String]?, ?sizes: Array[String]?, ?filter: String?) -> untyped
      def get_pet_tag_with_http_info: (Integer pet_id, String tag_name, ?colors: Array[String]?, ?sizes: Array[String]?, ?filter: String?) -> ::PetstoreClient::ApiResult
      def get_staging_pet_info: (Integer pet_id) -> untyped
      def get_staging_pet_info_with_http_info: (Integer pet_id) -> ::PetstoreClient::ApiResult
      def set_pet_avatar: (Integer pet_id, File body) -> untyped
      def set_pet_avatar_with_http_info: (Integer pet_id, File body) -> ::PetstoreClient::ApiResult
      def set_pet_avatar_thumbnail: (Integer pet_id, Models::SetPetAvatarThumbnailRequest set_pet_avatar_thumbnail_request) -> untyped
      def set_pet_avatar_thumbnail_with_http_info: (Integer pet_id, Models::SetPetAvatarThumbnailRequest set_pet_avatar_thumbnail_request) -> ::PetstoreClient::ApiResult
      def update_pet: (Integer pet_id, Models::Pet pet) -> untyped
      def update_pet_with_http_info: (Integer pet_id, Models::Pet pet) -> ::PetstoreClient::ApiResult
      def upload_pet_certificate: (Integer pet_id, file: File) -> untyped
      def upload_pet_certificate_with_http_info: (Integer pet_id, file: File) -> ::PetstoreClient::ApiResult
      def upload_pet_document: (Integer pet_id, file: File, ?document_type: String?, ?notes: String?) -> untyped
      def upload_pet_document_with_http_info: (Integer pet_id, file: File, ?document_type: String?, ?notes: String?) -> ::PetstoreClient::ApiResult
    end
  end
end
