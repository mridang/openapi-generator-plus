      def url: () -> String
    end

    module GetStagingPetInfoServerEnvironment
      STAGING: String
      SANDBOX: String
    end

    module GetStagingPetInfoServerVersion
      V2: String
      V3: String
    end

    class GetStagingPetInfoServerStagingServer < GetStagingPetInfoServer
      def initialize: (environment: String, version: String) -> void
      def url: () -> String
    end
    class PetApi < BaseApi
      def initialize: (?::PetstoreClient::ApiClient? api_client, ?::PetstoreClient::Configuration config, ?::PetstoreClient::Auth::Authenticator? authenticator) -> void
      def add_pet: (Models::Pet pet, ?Options::AddPetOptions? options) -> Models::Pet
      def add_pet_with_http_info: (Models::Pet pet, ?Options::AddPetOptions? options) -> ::PetstoreClient::ApiResult[Models::Pet]
