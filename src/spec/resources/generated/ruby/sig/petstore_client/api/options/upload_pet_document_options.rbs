module PetstoreClient
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_accessor types
      # are nullable only for optional parameters.
      class UploadPetDocumentOptions
        attr_accessor file: File
        attr_accessor document_type: String?
        attr_accessor notes: String?
        def initialize: (file: File, ?document_type: String?, ?notes: String?) -> void
      end
    end
  end
end
