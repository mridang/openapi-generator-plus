module PetstoreClient
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_accessor types
      # are nullable only for optional parameters.
      class DeletePetOptions
        attr_accessor api_key: String?
        attr_accessor auth: ::PetstoreClient::Auth::Authenticator?
        def initialize: (?api_key: String?, ?auth: ::PetstoreClient::Auth::Authenticator?) -> void
      end
    end
  end
end
