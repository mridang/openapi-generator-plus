module PetstoreClient
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class AddPetPhotosOptions
        attr_reader files: Array[File]
        attr_reader metadata: Models::PhotoMetadata
        def initialize: (files: Array[File], metadata: Models::PhotoMetadata) -> void
      end
    end
  end
end
