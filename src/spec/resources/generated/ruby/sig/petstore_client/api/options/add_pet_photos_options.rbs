module PetstoreClient
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_accessor types
      # are nullable only for optional parameters.
      class AddPetPhotosOptions
        attr_accessor files: Array[File]
        attr_accessor metadata: Models::PhotoMetadata
        def initialize: (files: Array[File], metadata: Models::PhotoMetadata) -> void
      end
    end
  end
end
