module PetstoreClient
  module Api
    class StoreApi < BaseApi
      def initialize: (?::PetstoreClient::ApiClient? api_client, ?::PetstoreClient::Configuration config, ?::PetstoreClient::Auth::Authenticator? authenticator) -> void
      def delete_order: (Integer order_id) -> untyped
      def delete_order_with_http_info: (Integer order_id) -> ::PetstoreClient::ApiResult
      def get_inventory: () -> untyped
      def get_inventory_with_http_info: () -> ::PetstoreClient::ApiResult
      def get_order_by_id: (Integer order_id) -> untyped
      def get_order_by_id_with_http_info: (Integer order_id) -> ::PetstoreClient::ApiResult
      def place_order: (Models::Order? order) -> untyped
      def place_order_with_http_info: (Models::Order? order) -> ::PetstoreClient::ApiResult
    end
  end
end
