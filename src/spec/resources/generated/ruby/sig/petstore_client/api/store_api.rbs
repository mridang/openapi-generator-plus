module PetstoreClient
  module Api
    class StoreApi < BaseApi
      def initialize: (?::PetstoreClient::ApiClient? api_client, ?::PetstoreClient::Configuration config) -> void
      def delete_order: (untyped order_id) -> untyped
      def get_inventory: () -> untyped
      def get_order_by_id: (untyped order_id) -> untyped
      def place_order: (untyped? order) -> untyped
    end
  end
end
