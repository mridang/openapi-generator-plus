module PetstoreClient
  module Api
    class StoreApi < BaseApi
      def initialize: (?::PetstoreClient::ApiClient? api_client, ?::PetstoreClient::Configuration config, ?::PetstoreClient::Auth::Authenticator? authenticator) -> void
      def delete_order: (Integer order_id) -> void
      def delete_order_with_http_info: (Integer order_id) -> ::PetstoreClient::ApiResult[nil]
      def get_inventory: () -> Hash[String, Integer]
      def get_inventory_with_http_info: () -> ::PetstoreClient::ApiResult[Hash[String, Integer]]
      def get_order_by_id: (Integer order_id) -> Models::Order
      def get_order_by_id_with_http_info: (Integer order_id) -> ::PetstoreClient::ApiResult[Models::Order]
      def place_order: (Models::Order? order) -> Models::Order
      def place_order_with_http_info: (Models::Order? order) -> ::PetstoreClient::ApiResult[Models::Order]

      private

      def encode_path_segment: (String value) -> String
    end
  end
end
