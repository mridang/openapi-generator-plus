module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class DeletePetOptions
        attr_reader api_key: String?
        attr_reader auth: ::Petstore::Client::Auth::Authenticator?
        def initialize: (?api_key: String?, ?auth: ::Petstore::Client::Auth::Authenticator?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
      end
    end
  end
end
