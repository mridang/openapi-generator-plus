module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class ListPetCatalogOptions
        attr_reader limit: Integer?
        attr_reader cursor: String?
        def initialize: (?limit: Integer?, ?cursor: String?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
        def copy_with: (**untyped) -> ListPetCatalogOptions
      end
    end
  end
end
