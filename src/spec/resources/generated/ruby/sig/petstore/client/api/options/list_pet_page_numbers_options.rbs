module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class ListPetPageNumbersOptions
        attr_reader page: Integer?
        attr_reader per_page: Integer?
        def initialize: (?page: Integer?, ?per_page: Integer?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
        def copy_with: (**untyped) -> ListPetPageNumbersOptions
      end
    end
  end
end
