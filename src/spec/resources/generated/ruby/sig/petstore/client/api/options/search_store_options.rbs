module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class SearchStoreOptions
        attr_reader q: Models::PhotoMetadata?
        attr_reader labels: Set[String]?
        attr_reader at: Tod::TimeOfDay?
        attr_reader x_filter: Hash[String, String]?
        def initialize: (?q: Models::PhotoMetadata?, ?labels: Set[String]?, ?at: Tod::TimeOfDay?, ?x_filter: Hash[String, String]?) -> void
      end
    end
  end
end
