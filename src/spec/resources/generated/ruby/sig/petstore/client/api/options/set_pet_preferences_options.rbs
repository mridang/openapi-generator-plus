module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class SetPetPreferencesOptions
        attr_reader nickname: String
        attr_reader tags: Array[String]?
        attr_reader note: String?
        attr_reader renewal_date: Date?
        attr_reader reminder: Time?
        attr_reader interval_days: Integer?
        attr_reader ratio: Float?
        attr_reader urgent: bool?
        attr_reader snooze: ISO8601::Duration?
        def initialize: (nickname: String, ?tags: Array[String]?, ?note: String?, ?renewal_date: Date?, ?reminder: Time?, ?interval_days: Integer?, ?ratio: Float?, ?urgent: bool?, ?snooze: ISO8601::Duration?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
      end
    end
  end
end
