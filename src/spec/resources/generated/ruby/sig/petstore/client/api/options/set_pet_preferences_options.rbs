module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class SetPetPreferencesOptions
        attr_reader nickname: String
        attr_reader tags: Array[String]?
        attr_reader note: String?
        attr_reader renewal_date: Date?
        def initialize: (nickname: String, ?tags: Array[String]?, ?note: String?, ?renewal_date: Date?) -> void
      end
    end
  end
end
