module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class GetNativeValuesOptions
        attr_reader address4: String?
        attr_reader wait: ISO8601::Duration?
        attr_reader amount: Float?
        attr_reader x_address6: String?
        def initialize: (?address4: String?, ?wait: ISO8601::Duration?, ?amount: Float?, ?x_address6: String?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
      end
    end
  end
end
