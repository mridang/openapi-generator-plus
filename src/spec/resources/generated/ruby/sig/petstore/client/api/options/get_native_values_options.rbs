module Petstore::Client
  module Api
    module Options
      # Required parameters have non-optional keyword arguments;
      # optional parameters default to nil.  The attr_reader types
      # are nullable only for optional parameters.  Instances are
      # frozen after construction, so only readers are exposed.
      class GetNativeValuesOptions
        attr_reader address4: IPAddr?
        attr_reader delay: ISO8601::Duration?
        attr_reader amount: BigDecimal?
        attr_reader x_address6: IPAddr?
        def initialize: (?address4: IPAddr?, ?delay: ISO8601::Duration?, ?amount: BigDecimal?, ?x_address6: IPAddr?, ?timeout: Numeric?, ?headers: Hash[String, String]?, ?max_retries: Integer?) -> void
      end
    end
  end
end
