<?xml version="1.0" encoding="utf-8"?>
<!--
  ILLink trimmer keep-list. The SDK serializes models through reflection
  (System.Text.Json's reflection-based resolver), which the trimmer cannot
  statically analyse. Without this descriptor, `PublishTrimmed` (Release
  Blazor WebAssembly, single-file, etc.) would strip model members and break
  deserialization. preserve="all" keeps every model's constructors, fields,
  properties (and their nested enums/converters, kept by code reference), so
  reflection round-trips intact under trimming. This is the .NET analogue of
  the GraalVM reflect-config.json emitted for the Java client. Embedded into
  the assembly as a LogicalName of ILLink.Descriptors.xml (see the csproj).
-->
<linker>
    <assembly fullname="PetstoreClient">
        <type fullname="PetstoreClient.Models.ApiResponse" preserve="all" />
        <type fullname="PetstoreClient.Models.Category" preserve="all" />
        <type fullname="PetstoreClient.Models.Color" preserve="all" />
        <type fullname="PetstoreClient.Models.DryFood" preserve="all" />
        <type fullname="PetstoreClient.Models.EdgeCases" preserve="all" />
        <type fullname="PetstoreClient.Models.Medication" preserve="all" />
        <type fullname="PetstoreClient.Models.Metadata" preserve="all" />
        <type fullname="PetstoreClient.Models.Order" preserve="all" />
        <type fullname="PetstoreClient.Models.Pet" preserve="all" />
        <type fullname="PetstoreClient.Models.PetFood" preserve="all" />
        <type fullname="PetstoreClient.Models.PetPassport" preserve="all" />
        <type fullname="PetstoreClient.Models.PetTreatment" preserve="all" />
        <type fullname="PetstoreClient.Models.PetWithOwner" preserve="all" />
        <type fullname="PetstoreClient.Models.Photo" preserve="all" />
        <type fullname="PetstoreClient.Models.PhotoMetadata" preserve="all" />
        <type fullname="PetstoreClient.Models.PhotoMetadataLocation" preserve="all" />
        <type fullname="PetstoreClient.Models.SetPetAvatarRequest" preserve="all" />
        <type fullname="PetstoreClient.Models.SetPetAvatarThumbnailRequest" preserve="all" />
        <type fullname="PetstoreClient.Models.StrictTag" preserve="all" />
        <type fullname="PetstoreClient.Models.Surgery" preserve="all" />
        <type fullname="PetstoreClient.Models.Tag" preserve="all" />
        <type fullname="PetstoreClient.Models.WetFood" preserve="all" />
    </assembly>
</linker>
