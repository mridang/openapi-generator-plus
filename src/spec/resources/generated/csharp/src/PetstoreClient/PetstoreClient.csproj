<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>A simplified Pet Store API for integration testing.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Skip NuGet warnings (NU*) as errors: package version drift +
         pruning warnings are environmental, not source bugs. -->
    <!-- NU* = NuGet env warnings (version drift, package pruning).
         IDE0048/0078/0370 = Roslyn style preferences (add parens,
         use pattern matching, remove unnecessary suppression).
         `dotnet format` doesn't autofix these reliably and they're
         taste-level. Real CS* + CA* analyzer rules stay ERROR. -->
    <WarningsNotAsErrors>NU1510;NU1603;NU1701;IDE0046;IDE0048;IDE0078;IDE0370;CA1062</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningLevel>9999</WarningLevel>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- The spec test project is a separate assembly. Expose the SDK's
         `internal` members (the test-only DefaultApiClient(HttpClient[,
         TransportOptions]) seams, the internal serde/transport helpers such as
         ObjectSerializer/ValueSerializer/HeaderSelector/TraceContextUtil) to it
         so existing coverage keeps compiling without those types leaking into
         the public API surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PetstoreClient.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- StyleCop.Analyzers dropped: hundreds of style-only SA violations
         (SA1200 using outside namespace, SA1513 brace blank-line, SA1633
         missing XML file header) that don't reflect real bugs and would
         require a template-wide restyle to satisfy. -->
  </ItemGroup>
</Project>
