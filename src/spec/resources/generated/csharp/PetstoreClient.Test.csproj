<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The test host targets net8.0 (the SDK's floor) but must run wherever
         `dotnet test` is invoked. When only a newer major runtime is installed
         (e.g. a net10-only CI image), roll the net8 test host forward so the
         suite still executes; on a net8 machine it runs on net8 natively. The
         shipped library project carries no RollForward and stays pure net8. -->
        <RollForward>Major</RollForward>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>.out/</CoverletOutput>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="src/**" />
        <ProjectReference Include="src/PetstoreClient/PetstoreClient.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Test/Resources/certs/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="JUnitXml.TestLogger" Version="7.0.2" />
        <PackageReference Include="Testcontainers" Version="4.12.0" />
        <PackageReference Include="coverlet.msbuild" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>
