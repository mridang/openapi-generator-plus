parameters:
  level: 9
  treatPhpDocTypesAsCertain: false
  # The codegen emits \Ds\Vector / \Ds\Set / \Ds\Map and \Uri\Rfc3986\Uri
  # return types without inline generic <T> PHPDoc — the generic inner
  # type lives in CodegenOperation.returnBaseType which the api template
  # would need to compose into a `\Ds\Vector<\Foo\Bar>` PHPDoc tag for
  # every operation. Until that template work lands, accept missing
  # generics globally rather than half-typing them.
  checkGenericClassInNonGenericObjectType: false
  checkMissingIterableValueType: false
  tmpDir: .phpstan
  paths:
    - .
  excludePaths:
    - vendor
    # Pest test files use magic methods (test(), expect(), beforeEach(),
    # etc.) that phpstan cannot analyse without the dedicated
    # pestphp/pest-plugin-phpstan plugin. Skip the test directory until
    # that plugin is wired up.
    - test
